nsupported": 14.769875526428223, "supported": 10.80793571472168}, "readout_s": 3.2900999940466136e-05, "request_id": "sha256:59a90b832290f51de7dd3c4e", "requested_score_position": 846, "response_sha256": "sha256:19a7fc3c43e4d4056e95b65c750422309b37261e42411237491fdb4452099a3d", "response_text": "Sure! Here's an objective overview of Tupelo Junction Cafe based on the provided structured data in JSON format:\n\nTupelo Junction Cafe is a restaurant located in Santa Barbara, CA that serves American (Traditional), American (New), and Southern cuisine. The cafe is open Monday through Sunday from 8:00 am to 2:00 pm and offers outdoor seating, WiFi, and takeout. The cafe has received positive reviews for its food, with one reviewer praising the scrambles, cinnamon apple beignets, and spicy crab bloody Mary. Another reviewer noted that the cafe is accommodating for children and has a casual atmosphere. However, one reviewer expressed disappointment at the high prices, stating that they had never spent $80 on a brunch before. Additionally, there is no kids' menu available. Tupelo Junction Cafe has a rating of 4.0 stars on Yelp and has been praised for its breakfast dishes. However, it appears that the cafe has since closed down according to one review.", "role": "training", "sealed_prompt_sha256": "sha256:bb7483eb0761a2956683e3db8d75b732a1055126cce125430f153274ae5a0ec6", "sealed_prompt_token_count": 847, "sentence_count": 5, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-7aaded429bb96b64c5b1bc2d", "source_sha256": "sha256:f78c0af8cb35fc210068e58a84b2c29d71ed6528ff6b47f6cb38b4eeb6c19ffd", "source_text": "{\"address\":\"1218 State St\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":true,\"lot\":false,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":true,\"WiFi\":\"no\"},\"business_stars\":4.0,\"categories\":\"Restaurants, Breakfast & Brunch, American (Traditional), American (New), Southern\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"17:0-20:0\",\"Monday\":\"8:0-14:0\",\"Saturday\":\"17:0-20:0\",\"Sunday\":\"17:0-20:0\",\"Thursday\":\"17:0-20:0\",\"Tuesday\":\"17:0-20:0\",\"Wednesday\":\"17:0-20:0\"},\"name\":\"Tupelo Junction Cafe\",\"review_info\":[{\"review_date\":\"2019-12-13 18:24:08\",\"review_stars\":4.0,\"review_text\":\"The food was great!  We brought our kids and they were pretty accommodating given that they didn't have a kids' menu.  The scrambles were pretty good, the cinnamon apple beignets were excellent.  The crab bloody Mary was a little watery but still spicy.  I could have rated this 5 stars but we've never spent $80 on a brunch so it's just 4 stars.\"},{\"review_date\":\"2018-01-27 18:12:42\",\"review_stars\":5.0,\"review_text\":\"This place has incredible breakfast. They just moved to Newport Beach California. There are no longer in Santa Barbara :(\"},{\"review_date\":\"2017-11-12 20:02:19\",\"review_stars\":1.0,\"review_text\":\"NOTICE!  It looks like Tupelo Junction has been shuttered for good. With no warning or messaging beyond some vague rumors that they forgot to renew their liquor license, it appears that it's gone.  Their website and listing here on Yelp still show it as active but the sign is down, the windows are covered in brown paper, and they don't answer the phone. R.I.P. Tupelo Junction.  Gonna miss that French toast!\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0015210900000965921, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gp