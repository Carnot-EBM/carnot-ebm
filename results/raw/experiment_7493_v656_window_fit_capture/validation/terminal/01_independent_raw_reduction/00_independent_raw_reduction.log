, 77, 1639, 6184, 416, 220, 17, 25, 16, 25237, 22660, 310, 220, 18, 20, 15, 56498, 321, 2234, 63646, 303, 1844, 321, 5445, 89931, 13, 220, 17, 220, 5797, 37452, 318, 269, 33037, 8, 25522, 440, 264, 29077, 15166, 321, 8981, 4162, 2919, 13, 220, 18, 220, 29831, 11, 1179, 1608, 264, 5129, 21736, 49814, 220, 23, 310, 220, 16, 17, 5365, 19163, 660, 888, 279, 947, 643, 748, 421, 30137, 628, 12092, 2261, 16725, 13, 220, 19, 220, 10454, 303, 264, 18632, 321, 22162, 32298, 440, 5415, 6889, 77, 1639, 6184, 416, 220, 18, 25, 16, 10454, 303, 264, 18632, 321, 22162, 32298, 440, 5415, 13, 220, 17, 220, 15059, 33980, 440, 94269, 11679, 321, 1925, 37452, 5774, 383, 28690, 303, 5956, 314, 22660, 13, 220, 18, 220, 10454, 264, 26912, 10517, 318, 40, 2113, 264, 6365, 314, 23872, 44853, 8, 383, 279, 4570, 28690, 310, 2213, 866, 47749, 587, 793, 13, 220, 19, 220, 50324, 220, 16, 6258, 466, 2980, 6574, 10751, 40473, 694, 24165, 23221, 10751, 8153, 6889, 77, 1639, 2129, 7593, 3147, 4993, 310, 21844, 279, 1786, 37452, 8934, 271, 65498, 24422, 198, 1206, 21844, 279, 1786, 37452, 11, 8364, 279, 22660, 310, 220, 18, 20, 15, 56498, 321, 2234, 63646, 303, 279, 1844, 321, 5445, 89931, 13, 5797, 279, 37452, 25522, 321, 8785, 424, 13, 5272, 264, 21736, 310, 49814, 220, 23, 310, 220, 16, 17, 5365, 19163, 660, 888, 279, 37452, 13, 10454, 279, 37452, 303, 264, 18632, 321, 32298, 22162, 424, 440, 5415, 13, 15059, 33980, 440, 94269, 11679, 321, 1925, 279, 37452, 5774, 383, 279, 22660, 28690, 303, 279, 5956, 314, 279, 22660, 13, 10454, 264, 26912, 10517, 383, 279, 4570, 28690, 310, 2213, 866, 47749, 587, 793, 13, 50324, 364, 220, 16, 6258, 466, 2980, 279, 6574, 10751, 40473, 694, 279, 24165, 23221, 10751, 8153, 13, 271, 55025, 198, 32, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 198, 33, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 17.047571182250977, " B": 14.511232376098633}, "raw_logits_by_option_id": {"contains_unsupported": 14.511232376098633, "supported": 17.047571182250977}, "readout_s": 3.4174000575148966e-05, "request_id": "sha256:a7d21a2f9362693eb0e66774", "requested_score_position": 430, "response_sha256": "sha256:ae67606c7f290b86121038b6e0c3ed768daa69220708c2f0c7a3786ceebfef82", "response_text": "To bake the best potato, heat the oven to 350\u00b0F and position racks in the top and bottom thirds. Wash the potato thoroughly and dry it. Use a fork to poke 8 to 12 deep holes all over the potato. Place the potato in a bowl and lightly coat it with oil. Sprinkle with kosher salt and place the potato directly on the oven rack in the middle of the oven. Place a baking sheet on the lower rack to catch any drippings. Bake for 1 hour or until the skin feels crisp but the flesh beneath feels soft.", "role": "calibration_tuning", "sealed_prompt_sha256": "sha256:6c4567eecb9492e184cdc75f18cbbe1a6e9e4568b156b084aeae9289a0d03740", "sealed_prompt_token_count": 431, "sentence_count": null, "sentence_version": null, "source_group_id": "group-0b17757f52736a704fe80ca5", "source_sha256": "sha256:625f3b23283fe97713f1c50654afd69a244a620a968de2f8fe2da888f4b0bc76", "source_text": "{\"passages\":\"passage 1:1 This allows steam to escape from the baking potato. 2  Bake the potatoes: You can bake the potatoes directly on the oven rack, or you can place them a few inches apart on a foil-lined baking sheet. 3  Bake the potatoes for 50 to 60 minutes.\\n\\npassage 2:1 Heat oven to 350\u00b0F and position racks in top and bottom thirds. 2  Wash potato (or potatoes) thoroughly with a stiff brush and cold running water. 3  Dry, then using a standard fork poke 8 to 12 deep holes all over the spud so that moisture can escape during cooking. 4  Place in a bowl and coat lightly with oil.\\n\\npassage 3:1 Place in a bowl and coat lightly with oil. 2  Sprinkle with kosher salt and place potato directly on rack in middle of oven. 3  Place a baking sheet (I put a piece of aluminum foil) on the lower rack to catch any drippings. 4  Bake 1 hour or until skin feels crisp but flesh beneath feels soft.\\n\\n\",\"question\":\"how to bake the best potato\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0008308979995490517, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 450, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 196, "byte_start": 0, "call_id": "sha256:ca8b0b77c56de3c192869971", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-0b17757f52736a704fe80ca5", "kv_state_id": "reset-epoch-1420", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": -1.2049541473388672, "marked_response": "<<CARNOT_FOCUS_START:0:196>>To bake the best potato, heat the oven to 350\u00b0F and position racks in the top and bottom thirds. Wash the potato thoroughly and dry it. Use a fork to poke 8 to 12 deep holes all over the potato. <<CARNOT_FOCUS_END>>Place the potato in a bowl and lightly coat it with oil. Sprinkle with kosher salt and place the potato directly on the oven rack in the middle of the oven. Place a baking sheet on the lower rack to catch any drippings. Bake for 1 hour or until the skin feels crisp but the flesh beneath feels soft.", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["supported", "contains_unsupported"], "order_remapping": {" A": "supported", " B