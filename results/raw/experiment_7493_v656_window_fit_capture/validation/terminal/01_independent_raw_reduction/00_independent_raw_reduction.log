aled_prompt_sha256": "sha256:76f1dd4715984927914e84ecbeddaa0243d347d847a744ba5d2cc75ee8f0adc2", "sealed_prompt_token_count": 705, "sentence_count": null, "sentence_version": null, "source_group_id": "group-9eb74aebe2d4abc16f7d0aad", "source_sha256": "sha256:010351c545159e7b842a6b6a03a13df25bc13c6f72fb262bb48457c8dd4e07be", "source_text": "{\"address\":\"4865 Calle Real\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":false,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":null,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":\"no\"},\"business_stars\":4.0,\"categories\":\"Restaurants, Fast Food, Burgers\",\"city\":\"Goleta\",\"hours\":{\"Friday\":\"0:0-23:0\",\"Monday\":\"0:0-0:0\",\"Saturday\":\"10:30-1:30\",\"Sunday\":\"10:30-1:0\",\"Thursday\":\"10:30-23:0\",\"Tuesday\":\"10:30-1:0\",\"Wednesday\":\"10:30-1:0\"},\"name\":\"In-N-Out Burger\",\"review_info\":[{\"review_date\":\"2022-01-13 03:29:22\",\"review_stars\":5.0,\"review_text\":\"Not sure if I like admitting it but we are regulars as we live close. Never disappointed 99% of the time the order is right which is more than I can say for other local more expensive burger places\"},{\"review_date\":\"2022-01-06 16:03:10\",\"review_stars\":5.0,\"review_text\":\"My favorite fast food place. So good! Everything is so delicious! 10/10 the burger bun is slightly toasted, the patty is so flavorful and juicy. Fries are crispy.\"},{\"review_date\":\"2021-12-05 16:44:50\",\"review_stars\":5.0,\"review_text\":\"Fries suck. Good burgers and sort of a counter-culture landmark. We always try to get In-N-Out whenever in CA. This is not any good to die for, but it is so rare to find a chain restaurant that comes close to the quality. The double double is the way to go.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0018168899996453547, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 724, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 267, "byte_start": 0, "call_id": "sha256:31389d6b13907f7e5df3ef05", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-9eb74aebe2d4abc16f7d0aad", "kv_state_id": "reset-epoch-1676", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 1.7389822006225588, "marked_response": "<<CARNOT_FOCUS_START:0:267>>In-N-Out Burger is a popular fast food chain located in Goleta, California, known for their high-quality burgers and fries. According to customer reviews, the restaurant consistently serves delicious and flavorful food, with a 99% accuracy rate in fulfilling orders. <<CARNOT_FOCUS_END>>The menu includes classic burgers, fries, and drinks, and the restaurant offers take-out and good-for-groups options. While some customers have noted that the fries can be a bit disappointing, the burgers are widely regarded as exceptional, with a juicy patty and slightly toasted bun. In-N-Out Burger has a casual atmosphere and does not offer outdoor seating or Wi-Fi. The restaurant has a 4.0-star rating and is considered a local favorite, with many customers visiting regularly.", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64",