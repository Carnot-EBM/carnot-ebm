0, 92002, 321, 2393, 1518, 16230, 13, 271, 55025, 198, 32, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 198, 33, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 12.095536231994629, " B": 15.64437198638916}, "raw_logits_by_option_id": {"contains_unsupported": 15.64437198638916, "supported": 12.095536231994629}, "readout_s": 3.589799962355755e-05, "request_id": "sha256:44eec9cf03638778f5a0eb95", "requested_score_position": 995, "response_sha256": "sha256:c44c7c88b723dd76268929cd4462bd9ab2502c3b20adbf570754f189cde0315c", "response_text": "Based on the provided structured data, Rudys is a local Mexican restaurant located in Carpinteria, California. The restaurant has been rated 3 out of 5 stars and has received mixed reviews from customers. While some patrons have enjoyed the food and atmosphere, others have complained about the cleanliness and service.\n\nThe restaurant offers a variety of dishes, including Mexican, breakfast, and brunch options. Customers can choose from tacos, burritos, taquitos, and more, with a focus on fresh ingredients and generous portions. However, some reviewers have noted that the tacos are bland and underseasoned, while others have found the place to be dirty and unclean.\n\nDespite these criticisms, one reviewer has praised the restaurant's guacamole and salsas, describing them as some of the best they've ever had. Additionally, another patron has noted that the service is friendly and attentive, if a bit distracted by their phones at times.\n\nOverall, Rudys seems to be a decent option for those looking for casual, affordable Mexican food in the area. However, customers may want to be aware of the potential issues with cleanliness and service before visiting.", "role": "training", "sealed_prompt_sha256": "sha256:d19608c3e7861602eecdcfa345a9cfa43056d55eb592b79f9236c6e023c456fa", "sealed_prompt_token_count": 996, "sentence_count": 4, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-ac557d7d8fe914a38a2c2694", "source_sha256": "sha256:9110ebfd40be6cfe3b011d801c7faf3f4f84a43f519cb5592f70ae19d288c3a6", "source_text": "{\"address\":\"1001 Casitas Pass Rd\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":false,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":\"no\"},\"business_stars\":3.0,\"categories\":\"Mexican, Restaurants, Breakfast & Brunch\",\"city\":\"Carpinteria\",\"hours\":{\"Friday\":\"8:0-21:0\",\"Monday\":\"8:0-21:0\",\"Saturday\":\"8:0-21:0\",\"Sunday\":\"8:0-21:0\",\"Thursday\":\"8:0-21:0\",\"Tuesday\":\"8:0-21:0\",\"Wednesday\":\"8:0-21:0\"},\"name\":\"Rudys\",\"review_info\":[{\"review_date\":\"2021-09-03 23:29:51\",\"review_stars\":2.0,\"review_text\":\"There's so many better places in Carpinteria to eat. I won't be wasting my money on $6 apiece, flavorless tacos again.\"},{\"review_date\":\"2021-08-27 23:45:54\",\"review_stars\":2.0,\"review_text\":\"Overall the food is fine but the place is dirty, sticky floor, leftovers on the tables, booth seats really dirty. The staff is very busy on their phones showing each other things that make each other laugh. I always feel as if I'm interrupting  and just shouldn't be there. Good thing for me is there are half a dozen other Mexican restaurants in town!\"},{\"review_date\":\"2021-08-08 03:37:01\",\"review_stars\":5.0,\"review_text\":\"I was hesitant ordering from here due to the low rating and poor reviews. However, I'm the type of person that needs to try before bashing a restaurant. I probably tried almost the entire menu with the exception of the burgers. The crispy tacos are good but I would stick to beef the chicken was a bit dry, however still very good full of cheese, salsa, and lettuce in a crispy shell with juicy meat mmmm just yummy. The potato, beef and chicken taquitos were sooo good too. With lots of guac, cheese and salad. The taquitos were my favorite. My husband was hooked on their chille relleno burrito, and let me tell you it didn't disappoint. As for dislikes I would have to say their tacos. The chicken \\\"street taco\\\" was to dry and tasteless under seasoned. As were the beef and carnitas. Just not well prepared they need a little more love. They have the best salsas and best guacamole. The chip salsa was my favorite. The rice and beans are good too. Anyways the place is good I recommend it.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0017957880008907523, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 0, "window_sha256": "sha256:42692bb4ea34e49131939a726f75be034b8a72a39003be919dca3e8174b4a8af", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 997, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 817, "byte_start": 414, "call_id": "sha256:95613a72b37af50067dd1af3", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-ac557d7d8fe914a38a2c2694", "kv_state_id": "reset-epoch-949", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 2.6231470108032227, "marked_response": "Based on the provided structured data, Rudys is a local Mexican restaurant located in Carpinteria, California. The restaurant has been rated 3 out o