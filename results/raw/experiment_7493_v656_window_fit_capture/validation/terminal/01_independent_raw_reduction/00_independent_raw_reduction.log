l the sauce is thickened, then sprinkle with coconut and serve with rice. Yield: 4 servings.", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["supported", "contains_unsupported"], "order_remapping": {" A": "supported", " B": "contains_unsupported"}, "prefill_s": 1.0026818039996215, "probabilities_by_option_id": {"contains_unsupported": 0.9636999608216882, "supported": 0.03630003917831192}, "prompt_sha256": "sha256:64c543e7e163dc8c36d7dae7387309861cd166eaa4d933fdda4d1de654da2ed3", "prompt_token_count": 843, "prompt_token_ids": [1890, 1386, 1761, 364, 279, 4434, 1965, 1608, 1132, 279, 16713, 2450, 13, 271, 41578, 198, 4754, 6184, 1098, 3147, 6184, 416, 220, 16, 25, 1948, 42442, 321, 40135, 21680, 62025, 2149, 856, 13, 220, 16, 220, 1190, 3086, 3658, 18607, 13565, 321, 716, 15204, 13, 220, 17, 220, 25237, 220, 17, 88925, 87983, 5415, 321, 220, 16, 14, 17, 59437, 34308, 5415, 303, 3349, 2397, 5304, 839, 75313, 383, 10728, 26667, 2980, 72791, 286, 3882, 13, 220, 18, 220, 2604, 74446, 310, 75313, 321, 22347, 2149, 856, 2980, 32298, 13477, 290, 13, 10466, 74446, 310, 264, 18632, 13, 2604, 53662, 321, 29634, 310, 75313, 13, 12155, 220, 16, 12, 17, 4276, 11, 52142, 13418, 13, 10466, 53662, 321, 29634, 310, 279, 18632, 440, 74446, 13, 2604, 9376, 5415, 310, 75313, 321, 8364, 2980, 72791, 286, 13, 2604, 27491, 23585, 11, 181610, 509, 2181, 11, 430, 90459, 11, 59344, 11, 321, 12781, 10343, 44499, 310, 75313, 6889, 77, 1639, 6184, 416, 220, 17, 25, 19557, 28154, 19052, 13, 59199, 74446, 11, 577, 18913, 22105, 13, 733, 264, 2526, 18632, 11, 6311, 13380, 267, 1077, 11, 43399, 11, 13477, 12781, 11, 18016, 22105, 11, 27798, 18607, 321, 4442, 74446, 22105, 2980, 10558, 13, 733, 264, 3349, 75313, 11, 8364, 5415, 888, 10728, 26667, 8364, 13, 2604, 55548, 321, 36092, 26, 22347, 2149, 856, 220, 16, 12, 17, 4276, 466, 1066, 2980, 40