_s": 3.217999983462505e-05, "request_id": "sha256:e0fa849ae377b7f92540d386", "requested_score_position": 994, "response_sha256": "sha256:7ce490d9de9fcf5459a5d1f08c83b969334eb2081032129fc8ba4eaa26f98544", "response_text": "\"Anna's Marketplace Bakery\" is a well-regarded establishment located at 7018 Marketplace Dr, Goleta, CA. It specializes in a wide range of food items, including donuts, sandwiches, and other bakery and restaurant offerings. The bakery opens at 6:00 on all days, with varying closing times. They also offer outdoor seating and takeout but do not provide WiFi or reservations. This bakery is known for its quality products, with reviews highlighting the delicious donuts, chocolate croissants, and vegan offerings. One reviewer notes the friendly staff and appreciates the personal touch of being greeted by name. The bakery has an overall rating of 4 stars, indicating high customer satisfaction. However, it is also mentioned that there can be long lines and limited seating.", "role": "training", "sealed_prompt_sha256": "sha256:edf402aeb305441444e977a62a31e6328324c01837fbac9e6c09646f8f1dba01", "sealed_prompt_token_count": 995, "sentence_count": null, "sentence_version": null, "source_group_id": "group-dedbf19a965d64cd8bca80cb", "source_sha256": "sha256:d19c8ee30866586d3eacedfc17f89afe92a8c753c7a44d2e81fd7925bcc7b26f", "source_text": "{\"address\":\"7018 Marketplace Dr\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":false,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":\"no\"},\"business_stars\":4.0,\"categories\":\"Donuts, Restaurants, Bakeries, Food, Sandwiches\",\"city\":\"Goleta\",\"hours\":{\"Friday\":\"6:0-17:30\",\"Monday\":\"0:0-0:0\",\"Saturday\":\"6:0-17:30\",\"Sunday\":\"6:0-16:30\",\"Thursday\":\"6:0-16:0\",\"Tuesday\":\"6:0-17:30\",\"Wednesday\":\"6:0-17:30\"},\"name\":\"Anna's Marketplace Bakery\",\"review_info\":[{\"review_date\":\"2022-01-18 01:20:49\",\"review_stars\":4.0,\"review_text\":\"Donuts are delish, nice and light and fresh. The chocolate croissant was really good as well! They are a little more pricey than some donut shops but have really good flavor.\"},{\"review_date\":\"2022-01-01 18:44:53\",\"review_stars\":5.0,\"review_text\":\"Happy 2022 everyone! This year will surely see me at Anna's quite a few more times. When a friend told me that a bakery close to where I live offers vegan donuts, I was psyched--I'm vegan and it's oddly difficult to find good vegan food, sweets, and drinks in this area. Checking out Anna's Bakery a few days later, I wasn't let down. \\n\\nI've sampled both the vegan glazed donut and the apple fritter, as well as the house coffee, and all were great. The donut is puffy and airy and sweet. The fritter has glorious crunchy, oily edges and a surprisingly doughy interior, complete with apple pieces and a glossy, sugary varnish. (Did you know some 'apple fritters' elsewhere don't even contain apple?) The coffee is hot and black and perfectly balances the candy-like sweetness of the baked goods. \\n\\nThere's always a long line and seating is limited so be prepared. This shop also offers non-vegan donuts (the majority contain milk products, though I'm crossing my fingers for a vegan cake donut in 2022). There is also a menu of savory food. Breads and donuts and cookies are also available to go. That pink box, unmistakably brimming with tasty treats, is sure to being smiles to any gathering... especially if you have vegan friends who are so used to being left out when sweet baked goods appear.\"},{\"review_date\":\"2021-10-27 05:28:12\",\"review_stars\":5.0,\"review_text\":\"SO friendly and donuts are always amazing. All staff, from the cashier to the owner. All lovely people. They always greet with by my name. I love to see how they interact with all customers. I am always happy to give them business as it is very well deserved. Keep up the wonderful work! Anna's has been around for a long time and has always been one of my favorites.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0018498629997338867, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 1014, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 224, "byte_start": 0, "call_id": "sha256:7fff7cecdb026cd52f3c9615", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-dedbf19a965d64cd8bca80cb", "kv_state_id": "reset-epoch-1226", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 1.4840917587280273, "marked_response": "<<CARNOT_FOCUS_START:0:224>>\"Anna's Marketplace Bakery\" is a well-regarded establishment located at 7018 Marketplace Dr, Goleta, CA. It specializes in a wide range of food items, including donuts, sandwiches, and other bakery and restaurant offerings. <<CARNOT_FOCUS_END>>The bakery opens at 6:00 on all days, with varying closing times. They also offer outdoor seating and takeout but do not provide WiFi or reservations. This bakery is known for its quality products, with reviews highlighting the delicious donuts, chocolate croissants, and vegan offerings. One reviewer notes the friendly staff and appreciates the personal touch of being greeted by name. The bakery has an overall rating of 4 sta