sphere. Dishes like shrimp quesadilla, enchilada verde, and chilaquiles are highlighted as favorites. Customers also seem to enjoy the outdoor seating and the friendly staff.", "role": "calibration_tuning", "sealed_prompt_sha256": "sha256:7ff002153e0eb64b52a8795d44b673578cfd83e2b348b5dd027bdf8847cba7ee", "sealed_prompt_token_count": 748, "sentence_count": 3, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-6d929f8ae2d83f347689591b", "source_sha256": "sha256:cb72510133cad7b9972a326aac5fe11003b5ecb64fff640c3b6c75870497688e", "source_text": "{\"address\":\"1816 Cliff Dr\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":false,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":\"no\"},\"business_stars\":3.5,\"categories\":\"Restaurants, Mexican\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"9:0-20:30\",\"Saturday\":\"8:0-20:30\",\"Sunday\":\"8:0-14:0\",\"Thursday\":\"9:0-20:0\",\"Tuesday\":\"9:0-20:0\",\"Wednesday\":\"9:0-20:0\"},\"name\":\"Rose Cafe No 2\",\"review_info\":[{\"review_date\":\"2021-10-07 21:48:38\",\"review_stars\":5.0,\"review_text\":\"Our favorite Mexican restaurant.  Great food,  service and atmosphere.  Favorite dishes are shrimp quesadilla and enchilada verde, but everything is delicious!\"},{\"review_date\":\"2021-10-07 01:36:52\",\"review_stars\":5.0,\"review_text\":\"Hands down the best Mexican food the Santa Barbara. Food and service are always on point!\\n\\nMy husband would eat here every day if we lived there. The enchiladas are amazing, make sure to ask for extra sauce as it's good to dip the chips in.\\n\\nNice to enjoy there outdoor seating and people watching. \\n\\nHave a margarita and enchilada and you will be thankful.\"},{\"review_date\":\"2021-10-03 17:19:58\",\"review_stars\":5.0,\"review_text\":\"Rose caf\u00e9 is one of my favorite spots in town. They have the best chilaquiles I've ever had and enchiladas and everything on the menu is good   You can't go wrong with anything you order on the menu. The margaritas are really good and the staff is super friendly and I love the outdoor dining area.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0013758109998889267, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 2, "window_sha256": "sha256:5025066d0dbb3bd6ff3d3035cfb43fb3e50ce92f3037e0ba49a5c103a1714a6c", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 1027, "archived_pilot_reuse": false, "arm": "whole_response", "attempted": true, "byte_end": null, "byte_start": null, "call_id": "sha256:5500ab56cee7db82c3da1ee6", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-6fc1ab771a049f4c9c790e66", "kv_state_id": "reset-epoch-1597", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 0.2705030441284179, "marked_response": null, "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["supported", "contains_unsupported"], "order_remapping": {" A": "supported", " B": "contains_unsupported"}, "prefill_s": 1.2404226159997052, "probabilities_by_option_id": {"contains_unsupported": 0.5672163973950355, "supported": 0.4327836026049646}, "prompt_sha256": "sha2