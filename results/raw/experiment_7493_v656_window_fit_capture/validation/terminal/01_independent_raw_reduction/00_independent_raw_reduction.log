y are planning to re-open.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0016413839994129376, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 2, "window_sha256": "sha256:65853be27b1e33b673f01008bbe7f944618c9b0a1b8e584abf3820fa1fa7b7f3", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 975, "archived_pilot_reuse": false, "arm": "whole_response", "attempted": true, "byte_end": null, "byte_start": null, "call_id": "sha256:30ef1e1685dd0a72960c3c51", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-183bd5835625c984d7421225", "kv_state_id": "reset-epoch-153", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": 0.6132431030273439, "marked_response": null, "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["contains_unsupported", "supported"], "order_remapping": {" A": "contains_unsupported", " B": "supported"}, "prefill_s": 1.1623329660005766, "probabilities_by_option_id": {"contains_unsupported": 0.6486802423028535, "supported": 0.35131975769714646}, "prompt_sha256": "sha256:e0e6d885bbeccb77ea161c70dab2e7423d9c906f29c46d9d686a524bd8ec4314", "prompt_token_count": 976, "prompt_token_ids": [1890, 1386, 1761, 364, 279, 4434, 1965, 1608, 1132, 279, 16713, 2450, 13, 271, 41578, 198, 4754, 4834, 3147, 17, 18, 15, 458, 21719, 769, 2129, 11987, 21624, 52218, 1772, 21624, 23543, 899, 763, 3721, 1288, 1005, 88, 763, 3721, 1288, 67, 520, 88, 763, 3721, 1288, 92670, 763, 3721, 12