464416504}, "readout_s": 3.469500006758608e-05, "request_id": "sha256:ce2929188f209f58734c54b2", "requested_score_position": 912, "response_sha256": "sha256:146de65887e4b4568ca602cab731f95d630851f2e0e489eb6c5d6d55bade2f3a", "response_text": "La Playa Azul Cafe is a Mexican restaurant located at 914 Santa Barbara St in Santa Barbara, CA. They offer outdoor seating and take reservations. Their menu includes tacos, burritos, and other Mexican dishes, as well as drinks such as margaritas. Reviewers have praised the quality of the food and the friendly service. Some have also noted that the restaurant can get busy during peak hours, but the outdoor seating area provides a peaceful and romantic atmosphere. Overall, La Playa Azul Cafe appears to be a popular and enjoyable dining option for those looking for authentic Mexican cuisine in a relaxed setting.", "role": "training", "sealed_prompt_sha256": "sha256:c4d8a6527db93510e618c2df828645b5f0042ef132537e69aa13e4fe039e4532", "sealed_prompt_token_count": 913, "sentence_count": 2, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-7a7c5676117cb8e03905eec5", "source_sha256": "sha256:cd2367f3445ac6c1086b4162599672f7ab89401a36e8b96326752e5dd9e3a487", "source_text": "{\"address\":\"914 Santa Barbara St\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":null,\"romantic\":null,\"touristy\":false,\"trendy\":null,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":false,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":true,\"WiFi\":\"no\"},\"business_stars\":4.0,\"categories\":\"Mexican, Restaurants\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"11:0-21:0\",\"Saturday\":\"11:0-21:0\",\"Sunday\":\"11:0-20:0\",\"Thursday\":\"11:0-20:0\",\"Tuesday\":\"11:0-20:0\",\"Wednesday\":\"11:0-20:0\"},\"name\":\"La Playa Azul Cafe\",\"review_info\":[{\"review_date\":\"2022-01-08 15:16:07\",\"review_stars\":5.0,\"review_text\":\"I thought this was a tourist trap. \\n\\nWe were pleasantly surprised by this place. We sat outside under the trees while drinking amazing margaritas and having an amazingly delicious taco platter.  \\n\\nThe service was excellent!\\n\\nI will definitely go back here.\"},{\"review_date\":\"2021-11-13 21:20:16\",\"review_stars\":4.0,\"review_text\":\"A quaint, semi-upscale, casual restaurant with outdoor seating. They have an extensive menu, and the best time to go for the best prices would be happy hour, between 3 - 6pm. The food is relatively clean if you order something grilled. The service is a tad slow, because the servers are overworked and busy. I appreciate the hand sanitizer on every table, and along the corridor. They take germs and the pandemic seriously here. I like their wine and alcohol list, and it's a peaceful spot for conversation. Because the restaurant looks quaint, sits up on a hill away from the sidewalk and busy street, and there's little tables in different little spots, it feels kind of romantic. I would come here again for a peaceful and easy afternoon.\"},{\"review_date\":\"2021-11-08 06:47:47\",\"review_stars\":5.0,\"review_text\":\"I have had two very enjoyable dining experiences at this caf\u00e9.  It seems to be the restaurant I always go to when I go up to Santa Barbara for a concert. Both times I was seated reasonably quickly (One time solo dining and the other with a group of friends). The service was quite good both times - which was particularly remarkable on my most recent visit because it was during a very busy Saturday night service. Even though it was busy, it wasn't super loud, IMO. The outdoor seating patio area is very nice and on this most recent visit I sat inside and the atmosphere was very pleasant (and all staff were masked and I felt perfectly fine in that regard).  Most importantly the food is YUM *and* they have several vegetarian friendly options.  I look forward to my next visit.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0017238720001842012, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 1, "window_sha256": "sha256:baeef3c12f7dbca266bb55fd47702fd1752bb2b832d89f92d93f93b136dc4634", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 912, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 617, "byte_start": 468, "call_id": "sha256:54818e77f2675097f4e2698f", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-7a7c5676117cb8e03905eec5", "kv_state_id": "reset-epoch-664", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 2.0128021240234375, "marked_response": "La Playa Azul Cafe is a Mexican restaurant located at 914 Santa Barbara St in Santa Barbara, CA. They offer outdoor seating and take reservations. Their menu includes tacos, burritos, and other Mexican dishes, as well as drinks such as margaritas. Reviewers have praised the quality of the food and the friendly service. Some have also noted that the restaurant can get busy during peak hours, but the outdoor seating area provides a peaceful and romantic atmosphere. <<CARNOT_FOCUS_START:468:617>>Overall, La Playa Azul Cafe appears to be a popular and enjoyable dining option for those looking for authentic Mexican cuisine in a relaxed setting.<<CARNOT_FOCUS_END>>", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_opt