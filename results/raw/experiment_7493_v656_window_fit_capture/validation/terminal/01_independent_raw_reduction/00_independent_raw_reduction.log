467, 494, 6112, 13, 271, 55025, 198, 32, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 198, 33, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 16.030502319335938, " B": 11.728874206542969}, "raw_logits_by_option_id": {"contains_unsupported": 16.030502319335938, "supported": 11.728874206542969}, "readout_s": 3.7260000681271777e-05, "request_id": "sha256:4d6461cd383e6256750c6388", "requested_score_position": 868, "response_sha256": "sha256:7b8fea405cbd7899dc5d306fbd5ab2e9b54fad5d8784c0979c26607f2412bc35", "response_text": "D'Vine is a local business located at 205 W Canon Perdido St in Santa Barbara, CA. It is a deli and restaurant that specializes in sandwiches. The business operates from 8:00 am to 4:00 pm from Monday to Friday, and from 11:00 am to 3:00 pm on Saturdays. \n\nAccording to customer reviews, D'Vine has received mixed feedback. One customer had a negative experience, describing their \"club sandwich\" as a disappointment and overpriced. The sandwich was served cold on wonderbread, which the customer felt was not worth the $10 they spent. However, other customers have praised the establishment for their great sandwiches, salads, and soups. They also mention the friendly staff and the visually appealing shop. One recommended sandwich is \"The Julius\" with cranberry sauce, which is described as a delicious combination on grilled sourdough.\n\nD'Vine offers outdoor seating and takeout services. They also cater to groups. The business does not have Wi-Fi and does not take reservations. The parking options include street parking and a nearby lot. The ambiance of the place is described as casual. Overall, D'Vine has received an average rating of 4.0 stars from customers.", "role": "training", "sealed_prompt_sha256": "sha256:d68073d9604fcf6eb03bf75532d6f05e24d887285c7d7b2e8e5468d30a1fca29", "sealed_prompt_token_count": 869, "sentence_count": null, "sentence_version": null, "source_group_id": "group-60afdf1a1a3e6a5c8addcd08", "source_sha256": "sha256:ac8348219fbb8ca176d08aa14d85f73134349ec0ae5204c30f0dac25e97be608", "source_text": "{\"address\":\"205 W Canon Perdido St\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":\"no\"},\"business_stars\":4.0,\"categories\":\"Sandwiches, Restaurants, Delis\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"8:0-16:0\",\"Monday\":\"8:0-16:0\",\"Saturday\":\"11:0-15:0\",\"Thursday\":\"8:0-16:0\",\"Tuesday\":\"8:0-16:0\",\"Wednesday\":\"8:0-16:0\"},\"name\":\"D'Vine\",\"review_info\":[{\"review_date\":\"2013-05-21 17:54:36\",\"review_stars\":1.0,\"review_text\":\"I had a \\\"club sandwich\\\" at this joke of a deli, which was possibly the biggest waste of 10$ ive ever spent. They brought me out a cold sandwich on wonderbread, something I could have packed myself for lunch in 3rd grade. Ive heard there are other good hot sandwiches on the menu, but from what I saw this place served nothing but overpriced garbage.\"},{\"review_date\":\"2013-03-09 04:36:20\",\"review_stars\":5.0,\"review_text\":\"Great sandwiches, salads, and soups.  The staff are extremely friendly, and its just a really cool looking shop.  Good selection of drinks, chips, and other miscellaneous snacks.  If your going to order a sandwich, get The Julius with cranberry sauce.  Its only everything holy between two pieces of grilled sourdough.\"},{\"review_date\":\"2013-01-09 23:06:10\",\"review_stars\":4.0,\"review_text\":\"They have gluten free bread, but ask for it toasted.  The owner is gluten free, so the staff is better trained than most.  Try the beet salad with the curry crusted walnuts, it is really tasty.  The patio has a nice mountain view.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0015116220001800684, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 888, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 433, "byte_start": 0, "call_id": "sha256:47dff7394d9b5d08b4d0ab22", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-60afdf1a1a3e6a5c8addcd08", "kv_state_id": "reset-epoch-562", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": 3.245206832885742, "marked_response": "<<CARNOT_FOCUS_START:0:433>>D'Vine is a local business located at 205 W Canon Perdido St in Santa Barbara, CA. It is a deli and restaurant that specializes in sandwiches. The business operates from 8:00 am to 4:00 pm from Monday to Friday, and from 11:00 am to 3:00 pm on Saturdays. \n\nAccording to customer reviews, D'Vine has received mixed feedback. One customer had a negative experience, describing their \"club sandwich\" as a disappointment and overpriced. <<CARNOT_FOCUS_END>>The sandwich was served cold on wonderbread, which the customer felt was not worth the $10 they spent. However, other customers have praised the establishment for their great sandwiches, salads, and soups. They also mention the friendly staff and the visually appealing shop. One recommended sandwich is \"The Julius\" with cranberry sauce, which is described as a delicious com