_score_position": 1061, "response_sha256": "sha256:2752c02075377aa931e675819369cf2fc5b30f87beb2b27d32ab2a811a6ebe63", "response_text": "Taco Bell is a popular fast-food chain located in Goleta, CA, offering Tex-Mex cuisine, tacos, breakfast, and brunch. The restaurant is open seven days a week from 7 am to 1 am, with a break from 7 am to 10 am on Sundays. It has a casual atmosphere with outdoor seating and provides free Wi-Fi. The menu includes a variety of options such as burritos, tacos, quesadillas, and salads. Customers can dine in or take advantage of the take-out service.\n\nAccording to customer reviews, Taco Bell is a reliable option for quick and satisfying meals. One reviewer praised the restaurant for its speedy service, accurate orders, and friendly staff. However, another reviewer had a negative experience, claiming that their food contained long black hair and criticizing the restaurant's safety practices. A third reviewer described the staff as passive-aggressive and had issues with their order and customer service.\n\nOverall, Taco Bell seems to be a decent choice for those looking for fast and affordable Tex-Mex food in Goleta. While some customers have had positive experiences, others have encountered issues with the quality of the food and customer service. As with any fast-food establishment, it's important to maintain realistic expectations and inspect your order before consuming it.", "role": "calibration_tuning", "sealed_prompt_sha256": "sha256:6817d67c67e140778819b070167d64ae0146519824801dfd7ec92b253084c8dc", "sealed_prompt_token_count": 1062, "sentence_count": 4, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-d300a0c6336bc110ce4d8e35", "source_sha256": "sha256:bbdccc3b9613387b64c22267eaa8e019a8320769fafd9e3a52526d789875b0ad", "source_text": "{\"address\":\"140 N. Fairview\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":null,\"lot\":true,\"street\":false,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":\"free\"},\"business_stars\":3.0,\"categories\":\"Tex-Mex, Tacos, Restaurants, Fast Food, Breakfast & Brunch, Mexican\",\"city\":\"Goleta\",\"hours\":{\"Friday\":\"7:0-1:0\",\"Monday\":\"7:0-0:0\",\"Saturday\":\"7:0-1:0\",\"Sunday\":\"7:0-0:0\",\"Thursday\":\"7:0-0:0\",\"Tuesday\":\"7:0-0:0\",\"Wednesday\":\"7:0-0:0\"},\"name\":\"Taco Bell\",\"review_info\":[{\"review_date\":\"2021-11-01 18:03:53\",\"review_stars\":5.0,\"review_text\":\"When I want food quickly and service in a hurry; this is my \\\"go to fast food supplier\\\" \\n  I have received the wrong order; once; it was still a good meal. The manager replaced the order; free; the next time I was in; with NO problem. \\nIf you expect instant service at NOON ; forget it. If there are twelve people in line; be patient. \\nDo NOT be rude and ruin everyone else's day.\\nWe will be back again and again and again.\\n  Three of us ate at this Taco Bell yesterday. Walked in one person ahead of us; at 11:45. Ordered; filled our drinks; the order was delivered and 100% correct including extra napkins; before we were able to find a seat. \\n   Way to go Taco Bell!\"},{\"review_date\":\"2021-10-20 16:39:58\",\"review_stars\":1.0,\"review_text\":\"Vile.   We had to throw out food due to long black hair mixed inside a burrito.  It's obvious their safety practices are non existent.   Just go around the corner to Los Arroyos.  Go anywhere else for that matter.  It's disgusting.\"},{\"review_date\":\"2021-06-15 17:33:35\",\"review_stars\":1.0,\"review_text\":\"This Taco Bell is something else. The workers are passive aggressive. I asked if the order was mine and they responded with \\\"They've been calling some name out so it must be yours\\\" with attitude but I didn't want to take some order if I didn't know what the bag contained. I also ordered a drink and that bag didn't have one so.. When I asked for my orange juice I held out my left hand and the guy purposely handed it on the opposite side like he was messing with me. I didn't appreciate this as it was early in the morning. They also passive aggressively told my friends the restroom code when asked and didn't give their drinks with their order as well.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.002958052000394673, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 1, "window_sha256": "sha256:f37498cf7ad3b1e7a9a6f87722a1e96ad068bd62565f89ce26e057f95c4d5e6a", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 1062, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 1287, "byte_start": 910, "call_id": "sha256:d19aaf7db8e9fc2c949c2237", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-d300a0c6336bc110ce4d8e35", "kv_state_id": "reset-epoch-1784", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": 4.754283905029297, "marked_response": "Taco Bell is a popular fast-food chain located in Goleta, CA, offering Tex-Mex cuisine, tacos, breakfast, and brunch. The restaurant is open seven days a week from 7 am to 1 am, with a break from 7 am to 10 am on Sundays. It has a casual atmosphere with outdoor seating and provides free Wi-Fi. The menu includes a variety of options such as burritos, tacos, quesadillas, and salads. Customers can dine in or take advantage of the take-out service.\n\nAccording to customer reviews, Taco Bell is a reliable option for quick and satisfying meals. One reviewer praised the restaurant for its speedy service, accurate orders, and friendly staff. However, another reviewer had a negative experience, claiming that their food contained long black hair and criticizing the restaurant's safety practices. A third reviewer described the staff as passive-aggressive and had issues with their order and customer service.\n\n<<CARNOT_FOCUS_START:910:1287>>Overall, Taco Bell seems to be a decent choice for those looking for fast and affordable Tex-Mex food in Goleta. While some customers have had positive experiences, others have encountered issues with the quality of the food and customer service. As with any fast-food establishment, it's important to maintain realistic expectations and inspect your order before consuming it.<<CARNOT_FOCUS_END>>", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["contains_unsupported", "supported"], "order_remapping": {" A": "contains_unsupported", " B": "supported"}, "prefill_s": 1.2693981190004706, "probabilities_by_option_id": {"contains_unsupported": 0.9914588679513806, "supported": 0.008541132048619423}, "prompt_sha256": "sha256:749b9a74ca586691d6ecaa089910d4bc089afda2a4647bd89114b3d912e58a63", "prompt_token_count": 1063, "prompt_token_ids": [1890, 1386, 1761, 364, 279, 4434, 1965, 1608, 1132, 279, 16713, 2450, 13, 271, 41578, 198, 4754, 4834, 3147, 16, 19, 15, 443, 13, 14168, 1015, 2129, 11987, 21624, 52218, 1772, 21624, 23543, 899, 763, 3721, 1288, 1005, 88, 763, 3721, 1288, 67, 520, 88, 763, 3721, 1288, 92670, 763, 3721, 1288, 390, 3316, 763, 3721, 1288, 433, 7902, 763, 3721, 1288, 49612, 84507, 763, 3721, 1288, 237419, 88, 763, 3721, 1288, 8339, 2174, 763, 3721, 49471, 22020, 91061, 21624, 11816, 416, 763, 2827, 128