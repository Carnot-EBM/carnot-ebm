, 9403, 13, 3648, 5813, 1442, 9444, 421, 279, 18565, 494, 328, 32, 27988, 314, 31674, 1, 557, 279, 10842, 314, 836, 12635, 13, 4213, 11, 975, 8120, 8953, 10207, 883, 279, 6639, 314, 63123, 11, 279, 6758, 276, 43316, 4530, 314, 279, 9488, 11, 321, 279, 6171, 579, 10178, 13727, 314, 19435, 45984, 1483, 9104, 303, 449, 6758, 82529, 4424, 13, 9988, 382, 1048, 9444, 279, 6639, 314, 20557, 505, 506, 55162, 793, 321, 16337, 303, 3583, 2708, 2695, 1928, 13, 4081, 71439, 11120, 599, 18433, 303, 449, 5289, 10412, 314, 220, 17, 9467, 364, 279, 62944, 13, 271, 55025, 198, 32, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 198, 33, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 15.974651336669922, " B": 16.527692794799805}, "raw_logits_by_option_id": {"contains_unsupported": 15.974651336669922, "supported": 16.527692794799805}, "readout_s": 5.584500013355864e-05, "request_id": "sha256:81be4ba9c5a5ccc550200dc7", "requested_score_position": 1069, "response_sha256": "sha256:3d589dae1141bf52743cd67e41b3e712e979d142aa8dae64d132fbc9c8df95ef", "response_text": "\"A Piece of Cake\" is a bakery located in Santa Barbara, CA, categorized under Food, Restaurants, Bakeries, and Desserts. The bakery accepts reservations and is suitable for groups. However, it has a mixed reputation among its customers. Based on reviews, some customers praised the bakery for its exceptional cake flavors and timely delivery. One customer even mentioned that the cake from \"A Piece of Cake\" was the highlight of their wedding. However, other reviews raised concerns about the lack of professionalism, the unsanitary conditions of the kitchen, and the owner's alleged habit of preparing cakes last minute in an unsuitable environment. Reviewers also mentioned the lack of fondant at tastings and difficulty in getting clear cost information. These contrasting experiences have resulted in an average rating of 2 stars for the bakery.", "role": "training", "sealed_prompt_sha256": "sha256:28c46f2b7d548488aa9dff2d6c4ece10a3e82037229531637c72ce7892550430", "sealed_prompt_token_count": 1070, "sentence_count": null, "sentence_version": null, "source_group_id": "group-237af2c550182b54e2840d64", "source_sha256": "sha256:8ecdf43445678125b1ce96c607b5ce1bafba12d5680afc90f3dcfc73993fe8ba", "source_text": "{\"address\":\"\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":null,\"Music\":null,\"OutdoorSeating\":null,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":null,\"WiFi\":null},\"business_stars\":2.0,\"categories\":\"Food, Restaurants, Bakeries, Desserts\",\"city\":\"Santa Barbara\",\"hours\":null,\"name\":\"A Piece of Cake\",\"review_info\":[{\"review_date\":\"2013-07-30 03:43:45\",\"review_stars\":5.0,\"review_text\":\"Having Theresa make our cake was the best decision of our wedding. She drove from Santa Barbara to Camarillo to meet us for the cake tasting. All the samples were amazing so we agreed to have three different flavors for each of the three layers of our cake. \\n\\nOn our wedding day the cake arrived on time and was beautifully decorated with fresh flowers. She even let us borrow one of her cake stands.  My wedding was almost a year ago and I almost forgot to give a feedback of my great experience with \\\"A Piece of Cake\\\". Her cakes are EXCEPTIONALLY AMAZING. People kept talking about it after the wedding. Theresa makes the best cakes my guests and I have ever eaten.\"},{\"review_date\":\"2013-06-05 17:10:53\",\"review_stars\":1.0,\"review_text\":\"A Piece of Cake is not a legitimate business. Teresa makes her cakes from her home which smells of odorous dog and mold. Her home/kitchen is unsanitary and is not rated by any government agency. She prepares her cakes and other \\\"treats\\\" last minute, in a filthy kitchen while her three dogs play nearby. \\n\\nHas anyone ever wondered why you can't get a tasting appointment at her store or in a kitchen? It's because there isn't one. She claims to rent space in a kitchen, however, I suspect this is a lie. I had the misfortune of knowing Teresa for a few months. She would often bore me with tales of unsatisfied customers and I can tell you most, if not all of the poor reviews you've read are worse than the reviewer knows and could describe. Apart from her ruining, or coming close to ruining several events, she doesn't give refunds - rather, she might give you credit so you can purchase some more tainted confections and ruin another event of yours.\\n\\nTeresa is not a professional cake baker, nor is she any sort of a businesswoman. Some of her cakes do appear aesthetically pleasing and may even taste good, however, if you knew what you were getting yourself into when you ordered a cake, you might rethink your decision. I doubt she keeps any sort of records or invoices and if you knew her current state of affairs, it would send up a red flag telling you how well, or not, she runs her cake baking operation. \\n\\nI'm not sure what she charges but if you can put a price on not getting sick by eating her cake or knowing that your wedding cake doesn't has dog hair in it, then it probably wouldn't be worth it for you to buy a cake from \\\"A Piece of Crap\\\" - sorry *cake.\"},{\"review_date\":\"2013-03-30 03:15:59\",\"review_stars\":1.0,\"review_text\":\"I have to agree with the other reviewers: Teresa makes good cake, but needs to work on her professionalism. She was more than 30 minutes late to our appointment and had a really hard time telling us what things cost. She didn't pay attention to what I wanted and kept on pointing me to other ideas. Also, most wedding cakes use fondant and she didn't bring any fondant to our tasting.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.002275928000017302, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 1090, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 343, "byte_start": 0, "call_id": "sha256:4d0c13f2161c50299926bcae", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-237af2c550182b54e2840d64", "kv_state_id": "reset-epoch-186", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": 1.122201919555664, "marked_response": "<<CARNOT_FOCUS_START:0:343>>\"A Piece of Cake\" is a bakery located in Santa Barbara, CA, categorized under Food, Restaurants, Bakeries, and Desserts. The bakery accepts reservations and is suitable for groups. However, it has a mixed reputation among its customers. Based on reviews, some customers praised the bakery for its exceptional cake flavors and timely delivery. <<CARNOT_FOCUS_END>>One customer even mentioned that the cake from \"A Piece of Cake\" was the highlight of their wedding. However, other reviews raised concerns about the lack of professionalism, the unsanitary conditions of the kitchen, and the owner's alleged habit of preparing cakes last minute in an unsuitable environment. Reviewers also mentioned the lack of fondant at tastings and difficulty in getting clear cost information. These contrasting experiences have resulted in an average rating of 2 stars for the bakery.", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 