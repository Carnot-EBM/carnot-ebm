1, 10377, 6112, 310, 7384, 3470, 364, 5402, 466, 430, 17855, 13, 271, 760, 2478, 25224, 494, 220, 16, 17, 25, 15, 15, 5670, 310, 220, 24, 25, 15, 15, 5670, 383, 79831, 13382, 11, 6318, 4717, 13382, 11, 321, 79833, 13382, 11, 440, 11244, 3979, 2980, 220, 16, 16, 25, 15, 15, 5670, 383, 76692, 321, 72653, 13, 1079, 34, 8778, 1730, 93291, 10580, 2372, 1860, 59023, 11, 781, 3160, 9781, 6575, 506, 220, 21, 25, 15, 15, 5670, 13, 561, 17509, 314, 1845, 32204, 321, 15325, 36064, 5529, 264, 10340, 321, 16219, 16078, 364, 14284, 13, 271, 43352, 599, 2047, 6572, 8120, 77797, 279, 34117, 91305, 321, 15873, 12701, 321, 12514, 6381, 13, 8727, 599, 1048, 25524, 279, 73440, 321, 10631, 6775, 314, 279, 7576, 11, 53162, 321, 6683, 13, 47411, 25688, 30782, 4564, 594, 13625, 369, 7309, 10779, 364, 2107, 15855, 20406, 440, 4627, 321, 19077, 4216, 13, 561, 31077, 1142, 30158, 369, 4574, 364, 62938, 321, 628, 27358, 264, 3349, 1809, 13, 21708, 11, 279, 2904, 310, 4300, 303, 4732, 3487, 11039, 310, 279, 18554, 314, 19077, 4216, 506, 279, 20616, 13, 271, 26597, 11, 47411, 25688, 30782, 4564, 594, 13625, 682, 65020, 264, 6235, 16513, 440, 264, 10412, 314, 220, 19, 13, 20, 9467, 13, 12757, 488, 513, 3221, 310, 4517, 264, 8720, 314, 12701, 466, 3357, 264, 4464, 11, 47411, 25688, 5891, 264, 31423, 3039, 440, 1141, 15506, 6381, 11, 11321, 5395, 11, 321, 33266, 91305, 13, 271, 55025, 198, 32, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 198, 33, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 16.01641845703125, " B": 15.782938957214355}, "raw_logits_by_option_id": {"contains_unsupported": 15.782938957214355, "supported": 16.01641845703125}, "readout_s": 3.860299966618186e-05, "request_id": "sha256:d22d42a44a75bde9fec4b9ce", "requested_score_position": 1122, "response_sha256": "sha256:2e1019a3106722fbac56e2fe4485380a2cf55b1b2c98f90365aab5898e66e972", "response_text": "Laplace Wine Bar & Shop is a local business located at 205 Santa Barbara St, Unit B in Santa Barbara, CA. This establishment offers a unique combination of nightlife, shopping, and gifts. They specialize in beer, wine, and spirits, making it a great place for wine enthusiasts. The bar also doubles as a gift shop, allowing customers to purchase items for themselves or as presents.\n\nThe business operates from 12:00 PM to 9:00 PM on Tuesdays, Wednesdays, and Thursdays, with extended hours until 11:00 PM on Fridays and Saturdays. On Sundays, they close slightly earlier at 6:00 PM. The availability of free WiFi and outdoor seating provides a comfortable and convenient atmosphere for guests.\n\nCustomers have left positive reviews praising the welcoming ambiance and superior wine and beer selection. Many have also highlighted the accommodating and helpful nature of the owners, Betty and Paul. Laplace Wine Bar & Shop is highly recommended for both casual visits with friends and hosting events. The spacious back patio is perfect for gatherings and can accommodate a large group. Additionally, the option to bring in outside food adds to the convenience of hosting events at the establishment.\n\nOverall, Laplace Wine Bar & Shop has garnered a solid reputation with a rating of 4.5 stars. Whether you are looking to enjoy a glass of wine or host a party, Laplace offers a memorable experience with its impressive selection, friendly staff, and charming ambiance.", "role": "training", "sealed_prompt_sha256": "sha256:60a697775db769efd6c92befe1885fdf1f9d49aa6245026dd6b61f2e99f76b8b", "sealed_prompt_token_count": 1123, "sentence_count": 5, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-7dbddeadbbfa935c6b92317f", "source_sha256": "sha256:b9f86b18476db50bb9f2533b71a6f5f5d903f7ddd51f78ff7f9ef62389e061f8", "source_text": "{\"address\":\"205 Santa Barbara St, Unit B\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":false,\"street\":false,\"valet\":false,\"validated\":false},\"Music\":false,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":true,\"WiFi\":\"free\"},\"business_stars\":4.5,\"categories\":\"Nightlife, Shopping, Flowers & Gifts, Beer, Wine & Spirits, Gift Shops, Wine Bars, Bars, Food\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"12:0-23:0\",\"Saturday\":\"12:0-23:0\",\"Sunday\":\"12:0-18:0\",\"Thursday\":\"12:0-21:0\",\"Tuesday\":\"12:0-21:0\",\"Wednesday\":\"12:0-21:0\"},\"name\":\"Laplace Wine Bar & Shop\",\"review_info\":[{\"review_date\":\"2018-10-26 05:14:31\",\"review_stars\":5.0,\"review_text\":\"We discovered Laplace walking through the Funk Zone trying to find a location to host a Day After event following our wedding.  We were instantly drawn to the look and feel of the space, hooked by the wines, and completely won over by Betty (owner) and Paul (manager).\\n\\nWe had about 50 people for our event, mostly located in the beautiful back patio with some spillover inside.  They prepared two huge charcuterie boards and allowed us to bring in our own food (leftover desserts from the wedding reception the night before and delicious pizza from Lucky Penny).\\n\\nFrom the minute we first walked into Laplace to the day of our party, Paul and Betty were extremely accommodating and helpful.  I highly recommend Laplace, whether its to grab a couple of glasses of wine with a friend or to host a party for 50.  Thanks, Betty and Paul!\"},{\"review_date\":\"2018-10-19 23:32:00\",\"review_stars\":5.0,\"review_text\":\"Great location in the Funk Zone, take the train in or stop by while in town. This quaint wine bar & shop has such a good vibe, the owner Betty & staff make you feel right at home.\\nSuperior wine & beer selection.\"},{\"review_date\":\"2018-09-06 18:08:58\",\"review_stars\":5.0,\"review_text\":\"Fantastic! Great for a Group Gathering, large or small. We had a large group for an after wedding gathering and rented the patio area. Their beautiful meat and cheese boards were very reasonably priced.  Our guests enjoyed the wine and beer flights and even purchased bottles to drink. Wines from all over the world, (not just one winery) gave everyone many options. Pricing on bottles of wine are very reasonable. Their  meat and cheese boards were beautiful and  reasonably priced.  The staff was amazing and very attentive to everyone. The first time we visited with a small group, we sat at the beautiful bar inside and staff was equally as friendly.  Great place. Will certainly visit again soon.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.002393120999840903, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 0, "window_sha256": "sha256:a0e442626f389f0e7b5874813b41cbf84b4e7b2853adbf748cd0e2b7810b2cab", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 1125, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 1000, "byte_start": 532, "call_id": "sha256:78df646b2710a986b4cdf3c4", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-7dbddeadbbfa935c6b92317f", "kv_state_id": "reset-epoch-695", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": -0.12851619720458987, "marked_response": "Laplace Wine Bar & Shop is a local business located at 205 Santa Barbara St, Unit B in Santa Barbara, CA. This establishment offers a unique combination of nightlif