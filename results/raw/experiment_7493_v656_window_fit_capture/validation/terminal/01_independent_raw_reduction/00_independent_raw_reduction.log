ive.\nDolores hasn\u2019t responded to the concern, and she likely won\u2019t.\nThe Real Housewives of New Jersey is currently on hiatus.", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0015443490001416649, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 2, "window_sha256": "sha256:d05b01a6901b3f26da54b95f963ac561fca70169026217c41c80c1f5195174f5", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 430, "archived_pilot_reuse": false, "arm": "whole_response", "attempted": true, "byte_end": null, "byte_start": null, "call_id": "sha256:6bdc9ca9db889577679ac5ed", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-c597920022b6bbd7955d2e9b", "kv_state_id": "reset-epoch-1739", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 1.4982233047485352, "marked_response": null, "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["supported", "contains_unsupported"], "order_remapping": {" A": "supported", " B": "contains_unsupported"}, "prefill_s": 0.523257957000169, "probabilities_by_option_id": {"contains_unsupported": 0.8173093388709789, "supported": 0.18269066112902105}, "prompt_sha256": "sha256:a7d2b632000ab7f1a570682cc469a6379c0025ca5028aff772b1c8287aba8a88", "prompt_token_count": 431, "prompt_token_ids": [1890, 1386, 1761, 364, 279, 4434, 1965, 1608, 1132, 279, 16713, 2450, 13, 271, 41578, 198, 4754, 6184, 1098, 3147, 6184, 416, 220, 16, 25, 1919, 85715, 628, 5073, 52385, 303, 279, 2982, 314, 279,