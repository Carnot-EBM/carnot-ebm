, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 12.963550567626953, " B": 15.494552612304688}, "raw_logits_by_option_id": {"contains_unsupported": 15.494552612304688, "supported": 12.963550567626953}, "readout_s": 3.201999970769975e-05, "request_id": "sha256:603046704afc6beb39e85968", "requested_score_position": 872, "response_sha256": "sha256:6469e2dc86da24628eda6ff2b29fc5e0d364c3977cea3491f3c2407bac7c668d", "response_text": "Corazon Cocina is a restaurant located in the Public Market in Santa Barbara, California. It offers a variety of cuisines, including Latin American, Mexican, and seafood. The restaurant is open Monday through Sunday from 11am to 9pm, with extended hours on Thursdays until 10pm. \nCustomers have praised the restaurant for its consistently delicious food, friendly service, and outdoor seating options. The restaurant also offers takeout and is suitable for groups. The ambiance is described as trendy and upscale, with ample parking available both on and off-site. Overall, customers highly recommend Corazon Cocina for anyone looking for a satisfying meal in Santa Barbara.", "role": "training", "sealed_prompt_sha256": "sha256:7c3911b12335d7f99003ebea2b4836b47ab7662088683a0acae0ff355918d0b9", "sealed_prompt_token_count": 873, "sentence_count": 2, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-99c7e56ef23ea439de7f1ffb", "source_sha256": "sha256:825b88daeb00ab66386a930b1c1b3a1d91c4476fc9d98083a472f3effee487aa", "source_text": "{\"address\":\"38 W Victoria, Unit 122\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":true,\"divey\":false,\"hipster\":true,\"intimate\":false,\"romantic\":false,\"touristy\":null,\"trendy\":true,\"upscale\":false},\"BusinessParking\":{\"garage\":true,\"lot\":false,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":\"free\"},\"business_stars\":4.5,\"categories\":\"Restaurants, Breakfast & Brunch, Latin American, Mexican, Seafood\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"11:0-21:30\",\"Monday\":\"0:0-0:0\",\"Saturday\":\"11:0-21:30\",\"Sunday\":\"11:0-21:0\",\"Thursday\":\"11:0-21:30\",\"Tuesday\":\"11:0-21:0\",\"Wednesday\":\"11:0-21:0\"},\"name\":\"Corazon Cocina\",\"review_info\":[{\"review_date\":\"2022-01-16 00:26:38\",\"review_stars\":5.0,\"review_text\":\"Most consistently delicious food in all Santa Barbara. \\nI started going there when it first opened and 5 plus years later it has maintained the consistency some how. Owner is doing a great job.\"},{\"review_date\":\"2022-01-11 20:20:46\",\"review_stars\":5.0,\"review_text\":\"We ate at the Corazon Cocina twice recently during our vacation in SB and\\nit was beyond amazing! Tasty food with stellar customer service! We highly recommend this restaurant and will go back anytime soon!\"},{\"review_date\":\"2022-01-09 22:20:28\",\"review_stars\":5.0,\"review_text\":\"This place will forever hold a place in my heart, and stomach. There are many places to choose to eat at the public market, but you are always guaranteed a delicious meal when you eat here.\\n\\nWent here yesterday and ordered the quesa birria. IT WAS SO GOOD. Most restaurants don't know how to master birria, but this place, they know how to cook birria. There was no consume to dip because it's already inside. That means that each bite is juicy and flavorful and just the best. \\n\\nI also ordered the doraditos for my kids and they loved it. Each crunchy rolled up taco came with quesa Fresca on top and lettuce. We ordered the horchata to compliment the meal and it was perfect. Their horchata is made with almond milk and unlike any horchata I've ever had. \\n\\nYou can really tell how much this restaurant values good quality ingredients, and it truly is apparent in the food. Don't miss this place if you're at the public market!\"}],\"state\":\