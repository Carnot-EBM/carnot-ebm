ere heard by the same court, with the same prosecutors. Prosecutors had sought a prison sentence of 18 years for Schaefer and 15 years for Mack. Under Indonesian law, Mack will be allowed to keep her baby with her in prison for two years, after which she can nominate who should take custody. Journalists Fairuz Husaini and Ragil Lestari and CNN's Kathy Quiano contributed to this report.\n", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.00172514299993054, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 2, "window_sha256": "sha256:dac21b129bbfc73025fe3be1eb2b65536228854580b6ec189e5fd846e6971cb0", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 1851, "archived_pilot_reuse": false, "arm": "whole_response", "attempted": true, "byte_end": null, "byte_start": null, "call_id": "sha256:f58db096217287609686e312", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-f356de89e34f75eafd70b083", "kv_state_id": "reset-epoch-1353", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": -0.7093191146850585, "marked_response": null, "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["supported", "contains_unsupported"], "order_remapping": {" A": "supported", " B": "contains_unsupported"}, "prefill_s": 2.2053568729998005, "probabilities_by_option_id": {"contains_unsupported": 0.32974930840784905, "supported": 0.6702506915921509}, "prompt_sha256": "sha256:5027ef6c0b0a11ff719a60eaf42ad44f51b7f9efcae6a90fa3928615