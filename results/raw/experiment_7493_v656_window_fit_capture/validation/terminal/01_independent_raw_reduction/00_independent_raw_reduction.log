580, 2372, 271, 55025, 198, 32, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 198, 33, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 15.57406234741211, " B": 14.861238479614258}, "raw_logits_by_option_id": {"contains_unsupported": 15.57406234741211, "supported": 14.861238479614258}, "readout_s": 3.5246000152255874e-05, "request_id": "sha256:1347c9c7bfdf1d55c0da11ae", "requested_score_position": 765, "response_sha256": "sha256:77fc0deea5a72abe67a9da2508837e67233713eb0063f44aa7fc791f6cd29f36", "response_text": "Red Pepper Chinese Food Express is a restaurant located at 966 Embarcadero Del Mar, Apt C, Isla Vista, CA. It is categorized under Restaurants, Fast Food, and Chinese. The restaurant operates from 11:00 to 21:00 from Monday to Sunday. While there is no information about services like business parking, reservations, outdoor seating, WiFi, takeaway, and group suitability, it holds an average star rating of 3.5. Some customers have had mixed experiences, with one describing their food as dry and flavorless. However, others praised the authenticity of the food, the rotation of dishes, and the affordability, with special mentions of the chow mein and fried rice. The restaurant is particularly popular among college students.", "role": "training", "sealed_prompt_sha256": "sha256:3ebb64b7de90f43c5e96ebad9b1862c57901587548086c86ad007c28b5c7795e", "sealed_prompt_token_count": 766, "sentence_count": 2, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-7b401a190dd4011f137b2194", "source_sha256": "sha256:1d63e5ab387c022d4f3ad45ef728e13331e80af5cd4cb3046e678427084f38a4", "source_text": "{\"address\":\"966 Embarcadero Del Mar, Apt C\",\"attributes\":{\"Ambience\":null,\"BusinessParking\":null,\"Music\":null,\"OutdoorSeating\":null,\"RestaurantsGoodForGroups\":null,\"RestaurantsReservations\":null,\"RestaurantsTakeOut\":null,\"WiFi\":null},\"business_stars\":3.5,\"categories\":\"Restaurants, Fast Food, Chinese\",\"city\":\"Isla Vista\",\"hours\":{\"Friday\":\"11:0-21:0\",\"Monday\":\"11:0-21:0\",\"Saturday\":\"11:0-21:0\",\"Sunday\":\"11:0-21:0\",\"Thursday\":\"11:0-21:0\",\"Tuesday\":\"11:0-21:0\",\"Wednesday\":\"11:0-21:0\"},\"name\":\"Red Pepper Chinese Food Express\",\"review_info\":[{\"review_date\":\"2021-12-09 06:27:06\",\"review_stars\":1.0,\"review_text\":\"Honestly some of the worst food I've ever eaten. I know that sounds like an exaggeration, but it was dry and flavorless (MC), and there were a bunch of bones and non-gelatinzed pieces of fat (SC). One of the few times I've ever had to throw out my dinner instead of just bearing it. I'm not sure what the dishes were called, since there are no name plates, but one looked like mandarin chicken (MC), and the other was referred to as \\\"spicy\\\" chicken (SC.\\n\\nTo whatever credit they may deserve, the chow mein/lo mein (not sure) was actually better than your average fast food counterpart. Take that as you will.\"},{\"review_date\":\"2021-12-02 04:34:48\",\"review_stars\":5.0,\"review_text\":\"Best restaurant in IV if ur looking for Chinese Food. Some dishes are on rotation. You know it's authentic when the chef mainly speaks Mandarin! Also budget friendly and super convenient.\"},{\"review_date\":\"2021-12-02 04:32:32\",\"review_stars\":5.0,\"review_text\":\"For what's in IV, 5/5. Fried rice is dank. Chow mein is dank. Portions are dank. Cha siu questionable, everything else is dank. Would revisit every other day if I were not a poor college kid.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0014046309997866047, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "em