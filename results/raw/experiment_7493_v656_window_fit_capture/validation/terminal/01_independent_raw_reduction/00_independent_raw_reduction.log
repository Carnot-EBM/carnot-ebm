token_count": 627, "sentence_count": 1, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-96e371a93ae2d81f37a9c76e", "source_sha256": "sha256:7d91aa6641e3b156ef5a16fe80a47602e3e99da8d9fff893679312b88853637f", "source_text": "{\"passages\":\"passage 1:In the 1800s, women fought for the rights to vote and be considered equal partners to men. Encompassed in equality, women fought for the right to own property, keep wages and sign a contract. Before the suffrage movement that took place during many decades in the 1800s, women were expected only to have interests in the home, their children and their husbands. They were not allowed to vote, work for a living wage or own their own property. After women were married, they lost all of their rights to be able to speak for themselves and were not even allowed to sign contracts. During this time, not all women wanted to marry, have children and run a home. They wanted to be able to support themselves and gain access to money without a husband. Women wanted to be treated equally to men and these women started the suffrage movement. It was one of the largest civil movements in the United States, and it eventually led to the biggest change in the way politics were decided.\\n\\npassage 2:After the war, woman suffrage endured another setback, when the women\u2019s rights movement found itself divided over the issue of voting rights for black men. Stanton and some other suffrage leaders objected to the proposed 15th Amendment to the U.S. Constitution, which would give black men the right to vote, but failed to extend the same privilege to American women of any skin color.\\n\\npassage 3:Women's suffrage in the United Kingdom. Women's suffrage in the United Kingdom was a movement to give women the right to vote. It finally succeeded through two laws in 1918 and 1928. It became a national movement in the Victorian era. Women were not explicitly banned from voting in Great Britain until the 1832 Reform Act and the 1835 Municipal Corporations Act. In 1872 the fight for women's suffrage became a national movement with the formation of the National Society for Women's Suffrage and later the more influential National Union of Women's Suffrage Societies (NUWSS). As well as in England, women's suffrage movements in Wales and other parts of the\\n\\n\",\"question\":\"what rights did females not have before the suffrage movement\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0013331159998415387, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 2, "window_sha256": "sha256:b8312fbd4007fece7e9214c409f79de5078e4d1796152a0ac341685373e735af", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 839, "archived_pilot_reuse": false, "arm": "whole_response", "attempted": true, "byte_end": null, "byte_start": null, "call_id": "sha256:538a179869b48d526f4ba622", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-9896ede3b89b5e6ef4715b05", "kv_state_id": "reset-epoch-819", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": -4.341465950012207, "marked_response": null, "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["supported", "contains_unsupported"], "order_remapping": {" A": "supported", " B": "contains_unsupported"}, "prefill_s": 1.0025195279995387, "probabilities_by_option_id": {"contains_unsupported": 0.01285015529194659, "supported": 0.9871498447080534}, "prompt_sha256": "sha256:501426fb56117399b064e24ad1f