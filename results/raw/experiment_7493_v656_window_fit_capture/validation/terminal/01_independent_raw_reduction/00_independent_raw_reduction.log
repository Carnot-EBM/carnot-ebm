":true,\"RestaurantsTakeOut\":true,\"WiFi\":\"free\"},\"business_stars\":4.0,\"categories\":\"Restaurants, Mexican\",\"city\":\"Goleta\",\"hours\":{\"Friday\":\"11:0-22:0\",\"Monday\":\"11:0-21:0\",\"Saturday\":\"9:0-21:0\",\"Sunday\":\"9:0-21:0\",\"Thursday\":\"11:0-21:0\",\"Tuesday\":\"11:0-21:0\",\"Wednesday\":\"11:0-21:0\"},\"name\":\"La Hacienda\",\"review_info\":[{\"review_date\":\"2016-05-16 06:05:32\",\"review_stars\":3.0,\"review_text\":\"This place has good mexican food ive tried their sopes and their great last time i went i ordered aguachiles and it was horrible I recommend this place although dont order aguachiles\"},{\"review_date\":\"2016-02-02 22:30:44\",\"review_stars\":4.0,\"review_text\":\"I've enjoyed a good mexican meal and margarita here. The place was hopping on a Saturday evening with Karaoke for the Goleta locals. I brought my daughter and she was able to sing, too. Brian has a great selection of music and it was fun to be out on the patio enjoying a beer while watching people get up and sing. The patio has heaters and good seating. Karaoke was very popular so we had to leave before our next shot at the mic.  I will come back for more!\"},{\"review_date\":\"2016-01-28 03:05:38\",\"review_stars\":5.0,\"review_text\":\"Most authentic Mexican food I've had in SB! The tortillas were handmade & the salsa was to die for. The food was super delicious, and the venue itself was cozy. Definitely coming back and taking my family when they come to visit me. Definitely recommend!\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0013541349999286467, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 2, "window_sha256": "sha256:dcfa5508efe316af47ea191e3b0559ff54a39d25269