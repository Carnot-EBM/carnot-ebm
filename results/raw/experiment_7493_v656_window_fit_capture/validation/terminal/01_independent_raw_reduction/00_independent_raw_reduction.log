 1141, 12594, 51287, 1815, 13, 561, 2734, 4233, 42847, 32569, 13809, 4862, 9687, 264, 10412, 314, 220, 17, 13, 20, 9467, 680, 314, 220, 20, 13, 271, 55025, 198, 32, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 198, 33, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 15.082474708557129, " B": 13.120059967041016}, "raw_logits_by_option_id": {"contains_unsupported": 15.082474708557129, "supported": 13.120059967041016}, "readout_s": 3.197000023646979e-05, "request_id": "sha256:14f3a91a9da9d0e818dd5bba", "requested_score_position": 1345, "response_sha256": "sha256:55447fe45a6aac1f6502d8182df4a48246e61663299c0b11dd2fa091db59ede1", "response_text": "The Grilled Cheese Truck Stop is a restaurant located in Goleta, California, specializing in sandwiches and food truck fare. According to customer reviews, the restaurant has a casual atmosphere with outdoor seating and offers free Wi-Fi. However, reviews also suggest that the restaurant's food is subpar, with long wait times and overpriced menu items. Customers have reported dry, flavorless bread and dried-out meat in their sandwiches. Some reviewers have also noted poor customer service, including slow service and staff who seem disinterested in running the register. One reviewer even questioned whether the restaurant is cursed due to its consistent emptiness. The Grilled Cheese Truck Stop currently holds a rating of 2.5 stars out of 5.", "role": "training", "sealed_prompt_sha256": "sha256:8953fcd1f88b3181a3d64fe89f78c9094106c484a7cda1ff9c959c8c05edfb35", "sealed_prompt_token_count": 1346, "sentence_count": 2, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-0b2b88b825156a503658e638", "source_sha256": "sha256:506f8b06e70779768ac6baca5373c418a880f21b10f4c5581eb6fec0c88dd1d8", "source_text": "{\"address\":\"956 Embarcadero Del Norte, Ste C\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":null,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":\"free\"},\"business_stars\":2.5,\"categories\":\"Restaurants, Food, Sandwiches, Food Trucks\",\"city\":\"Goleta\",\"hours\":{\"Friday\":\"11:0-2:0\",\"Monday\":\"11:0-0:0\",\"Saturday\":\"11:0-2:0\",\"Sunday\":\"11:0-0:0\",\"Thursday\":\"11:0-0:0\",\"Tuesday\":\"11:0-0:0\",\"Wednesday\":\"11:0-0:0\"},\"name\":\"The Grilled Cheese Truck Stop\",\"review_info\":[{\"review_date\":\"2018-09-19 17:21:23\",\"review_stars\":1.0,\"review_text\":\"Oh wow. This place SSSUUUUUCCKKKKEEDDD\\n\\nWhen I was 6, I took a craft singles, put it between two slices of white bread, and popped it in the microwave for 12 seconds.\\n\\nSo tell me, dear chefs, why it takes OVER 25 MINUTES FOR A SANDWHICH AND SOME CHEESE\\n\\nTHERE WASNT EVEN A RUSH\\n\\nI WAS THE ONLY CUSTOMER\\n\\nlol\\nIt's whatever\\nThis place is closed permanently\\nIdk why I'm writing this review\\nIf you're from the past and you're able to read reviews from the future, then take my advice, avoid this place at all costs.\"},{\"review_date\":\"2018-06-13 03:13:03\",\"review_stars\":1.0,\"review_text\":\"Came here a while ago, a few weeks after this place had opened but have been meaning to write this review. This place was/is very empty for a good reason-- although the concept of having a good grilled cheese place sounds enticing, the actual food was extremely underwhelming. I ordered the grilled cheese with mac n' cheese for $9 and was given half a sandwich with the thinnest layer of mac n cheese inside. On the side were 5 tater tots and HALF a pickle (they don't even bother putting a whole pickle!). A majority of us college students in IV can't afford bougie mediocre grilled cheese for $9-$13. Not sure how long this place is going to last here.\"},{\"review_date\":\"2018-06-08 21:10:12\",\"review_stars\":2.0,\"review_text\":\"You win some, you lose some. And just like the game of cornhole I played here, it was a loss.\\n\\nHaving tried the original Grilled Cheese Truck in L.A., I had high expectations for the bright yellow truck stop. Unfortunately, the times I have tried it, those expectations were not met.\\n\\nI had their signature cheesy mac and rib melt, the healthier not-so-classic melt, and a s'mores melt on three separate occasions. Unfortunately for them, the bread they use here is drier than the sand on Isla Vista's beaches. It's as if they pre-toast the bread in the morning and just warm it up in a toaster oven before slapping some cheese on it. The meat, as a result, is dried out by the time it gets to the paper boats their melts are served on.\\n\\nThe best things to order are the sweet potato tater tots, partially because there is no dry bread involved, and partially because you should never say no to tater tots. Prices are high for no discernible quality and sandwiches the size of the regular Wonder Bread loafs at the supermarket.\\n\\nCustomer service here is sorely lacking. It seems to be worse than other student-run restaurants managed in I.V. The sandwiches take unbelievably long considering how carelessly constructed they look. On several occasions, the staff have seemed more likely to hang out in the kitchen or talk to friends who pass by in their cars instead of running the register. But hey, when there's that little business, I don't blame them for seeking other avenues of entertainment.\\n\\nThey have been trying some marketing tactics to get people in there -- a board out front says that their \\\"plain and simple\\\" melt is $2 now from 1-4 p.m., but I don't know many people who are excited for grilled cheese during those hours. A friend of mine walked past the establishment and heard them calling out \\\"the next five people will get $2 off of their sandwiches!\\\" Not many scuttled in after that.\\n\\nIs this place cursed? Probably. I've never seen more than five people eating there in one go, and I pass by it at least once a day. Hope it improves instead of going the way of Santa Ynez Burrito and Kogilicious.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0023957519997566123, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 1, "window_sha256": "sha256:45e77d08ccf88b17291fe68c4402bc5501756030ad3dfcffaafd5b3b1a97b5dc", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 1345, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 748, "byte_start": 441, "call_id": "sha256:c2e1bbaf0baeb23a774d8087", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-0b2b88b825156a503658e638", "kv_state_id": "reset-epoch-060", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": 2.091289520263672, "marked_response": "The Grilled Cheese Truck Stop is a restaurant located in Goleta, California, specializing in sandwiches and food truck fare. According to customer reviews, the restaurant has a casual atmosphere with outdoor seating and offers free Wi-Fi. However, reviews also suggest that the restaurant's food is subpar, with long wait times and overpriced menu items. Customers have reported dry, flavorless bread and dried-out meat in their sandwiches. <<CARNOT_FOCUS_START:441:748>>Some reviewers have also noted poor customer service, including slow service and staff who seem disinterested in running the register. One reviewer even questioned whether the restaurant is cursed due to its consistent emptiness. The Grilled Cheese Truck Stop currently holds a rating of 2.5 stars out of 5.<<CARNOT_FOCUS_END>>", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["contains_unsupported", "supported"], "order_remapping": {" A": "contains_unsupported", " B": "supported"}, "prefill_s": 1.5751362800001516, "probabilities_by_option_id": {"contains_unsupported": 0.8900536791614793, "supported": 0.1099463208385207}, "prompt_sha256": "sha256:e6a42f0ddbf56679e4c10ba3e99176e2792e3815f650467648fd426b2b3116c9", "prompt_token_count": 1346, "prompt_token_ids": [1890, 1386, 1761, 364, 279, 4434, 1965, 1608, 1132, 279, 16713, 2450, 13, 271, 41578, 198, 4754, 4834, 3147, 24, 20, 21, 5570, 2185, 66, 70740, 7086, 79453, 11, 3251, 351, 2129, 11987, 21624, 52218, 1772, 21624, 23543, 899, 763, 3721, 1288, 1005, 88, 763, 3721, 1288, 67, 520, 88, 763, 3721, 1288, 92670, 763, 3721, 1288, 390, 3316, 763, 3721, 1288, 433, 7902, 763, 3721, 1288, 49612, 84507, 763, 3721, 1288, 237419, 88, 763, 3721, 1288, 8339, 2174, 763, 3721, 49471, 22020, 91061, 21624, 11816, 416, 763, 3721, 1288, 8911, 763, 1802, 1288, 26466, 763, 1802, 1288, 6378, 1112, 763, 3721, 1288, 57576, 763, 3721, 49471, 23373, 763, 2827, 1288, 95130, 1460, 1060, 763, 1802, 1288, 12060, 32858, 14773, 2381, 21485, 763, 2827, 1288, 12060, 32858, 1026, 44294, 763, 3721, 1288, 12060, 32858, 17283, 2575, 763, 1802, 1288, 92247, 3147, 10279, 56658, 25316, 1217, 1506, 763, 17, 13, 20, 1288, 15042, 3147, 12060, 32858, 11, 11754, 11, 64481, 287, 11, 11754, 82387, 2129, 8656, 3147, 10533, 46544, 2129, 29393, 21624, 33475, 3147, 16, 16, 25, 15, 12, 17, 25, 15, 2129, 34072, 3147, 16, 16, 25, 15, 12, 15, 25, 15, 2129, 32558, 3147, 16, 16, 25, 15, 12, 17, 