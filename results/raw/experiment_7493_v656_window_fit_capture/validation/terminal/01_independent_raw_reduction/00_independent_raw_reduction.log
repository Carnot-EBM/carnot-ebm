:5fdc3bdb9d84f76f964378edf913cd67fbeb296d7f3d4b5dcb6317a9c3c533fd", "sealed_prompt_token_count": 901, "sentence_count": 3, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-2fcaee78390d52b290c800b0", "source_sha256": "sha256:c8b0d09587f8b2adcfbf012e8aa2080760ee0573513da43434f42f2903f7a088", "source_text": "{\"address\":\"431 State St\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":null,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":null,\"upscale\":false},\"BusinessParking\":{\"garage\":null,\"lot\":false,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":true,\"WiFi\":\"free\"},\"business_stars\":4.0,\"categories\":\"Restaurants, Indian, Himalayan/Nepalese\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"11:30-22:0\",\"Monday\":\"0:0-0:0\",\"Saturday\":\"11:30-22:0\",\"Sunday\":\"11:30-22:0\"},\"name\":\"Himalayan Kitchen\",\"review_info\":[{\"review_date\":\"2022-01-07 06:14:15\",\"review_stars\":5.0,\"review_text\":\"Great food and staff.I absolutely love momos  and thought this would be a good place to have them. We got the veg thupka  and momos. The thupka had just perfect balance between the noodles and vegetables. The food arrived in a very short time.Definitely recommend to go here.\"},{\"review_date\":\"2021-12-27 03:40:06\",\"review_stars\":4.0,\"review_text\":\"By looking in from outside as soon as they opened for dinner, I hesitated to go in. It was early and the restaurant was still had only a few customers. I was staying overnight in the area and I was new to the neighborhood. The food was excellent. One of the dishes we ordered along with chicken vindaloo, Aloo Govi, and naan, was Himalayan special chow meon. From the spicy level of 1-10, we chose 7. It was delicious but a bit too spicy for me to fully enjoy although I can proudly say I can handle spicy food. Maybe next time I will choose 5. The food was amazing with cold beer. The price was very reasonable too. By the time we were leaving, the restaurant was packed with customers.\"},{\"review_date\":\"2021-12-19 00:27:08\",\"review_stars\":5.0,\"review_text\":\"Really flavorful and interesting food. I got the vegetable curry. It was delicious and had a great depth of flavor. It was a bit oily, but not over-the-top. My friend ordered the ming bean noodle dish. It was really good as well, the flavor was a bit more tamed. It had a nice garlicky taste and the vegetables in it were delicious, especially the mushrooms which were perfectly saut\u00e9ed. The pickled vegetables condiment was really nice and reminded me of the super salty pickled lime skin you get with some types of Indian cuisine. Great place - very vegan and vegetarian friendly.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.001626639999813051, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 0, "window_sha256": "sha256:9851e43e4c200d406c2e87c9a98624c20f53a79459058a42f68bd182596f6125", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 902, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 475, "byte_start": 235, "call_id": "sha256:6143da429516ebe28b1a2d54", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-2fcaee78390d52b290c800b0", "kv_state_id": "reset-epoch-1471", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 2.3963985443115234, "marked_response": "Himalayan Kitchen is a Nepalese and Ind