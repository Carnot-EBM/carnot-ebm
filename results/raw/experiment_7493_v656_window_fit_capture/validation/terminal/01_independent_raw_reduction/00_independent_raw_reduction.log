, 11, 6824, 13, 2985, 264, 10412, 314, 220, 19, 13, 20, 9467, 11, 424, 5891, 264, 4752, 17378, 3039, 440, 449, 15325, 30158, 11, 3807, 25244, 11, 321, 78563, 364, 264, 41025, 16078, 13, 1079, 34, 8778, 1730, 93291, 10580, 2372, 760, 10413, 369, 3750, 364, 1141, 1496, 21408, 13565, 321, 11190, 24958, 11, 2583, 8343, 14712, 25726, 1680, 430, 19406, 263, 44854, 321, 168445, 12859, 23702, 13, 561, 8120, 4052, 421, 279, 10413, 579, 3487, 369, 17387, 11, 7695, 279, 3851, 20959, 72, 11, 8881, 64, 401, 57713, 11, 321, 20968, 319, 2526, 46721, 13, 4213, 11, 1010, 57043, 1669, 279, 3526, 379, 15220, 6628, 310, 381, 632, 36208, 470, 13, 561, 2393, 369, 11321, 321, 10727, 11, 321, 279, 10413, 5891, 264, 7792, 314, 2519, 364, 12625, 28564, 321, 45761, 581, 13, 5788, 1010, 57043, 1669, 279, 7336, 310, 381, 264, 2612, 30239, 11, 1379, 7268, 421, 424, 579, 5621, 279, 3117, 364, 264, 3175, 12723, 13, 271, 55025, 198, 32, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 198, 33, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 16.486230850219727, " B": 11.299429893493652}, "raw_logits_by_option_id": {"contains_unsupported": 16.486230850219727, "supported": 11.299429893493652}, "readout_s": 3.7690999306505546e-05, "request_id": "sha256:dde05f81c94f61f41ff3dc8e", "requested_score_position": 1121, "response_sha256": "sha256:c12745a53f1cd1e4820dbf873698d9a3366577c6eb44aacfba22cde8cf007b82", "response_text": "Loquita is a popular Spanish tapas restaurant located in Santa Barbara, California. With a rating of 4.5 stars, it offers a unique dining experience with an outdoor patio, fireplaces, and heaters for a cozy atmosphere. The restaurant is known for its high-quality ingredients and creative dishes, including traditional Spanish favorites such as Jamon tasting and Manchego plates. The reviews suggest that the restaurant's food is delicious, particularly the El Bulli, Baya de Oro, and Datil small bites. However, some reviewers found the Pollo Paella to be unremarkable. The service is friendly and efficient, and the restaurant offers a variety of options for vegetarians and vegans. While some reviewers found the prices to be a bit steep, most agree that it's worth the money for a special occasion.", "role": "training", "sealed_prompt_sha256": "sha256:7871a5e4043bb1fcb9d0768a148443ca2fdada8a5b4ff1197d487aa3414661ed", "sealed_prompt_token_count": 1122, "sentence_count": 3, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-6b1ad4ce4faca0443395bebe", "source_sha256": "sha256:16cdb44be8b4d81ffb134a04f2b6fffc8333c3cac6ae6a4978a3d20d527541ee", "source_text": "{\"address\":\"202 State St\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":true,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":true,\"touristy\":false,\"trendy\":true,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":false,\"street\":true,\"valet\":true,\"validated\":false},\"Music\":false,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":null,\"WiFi\":\"no\"},\"business_stars\":4.5,\"categories\":\"Event Planning & Services, Nightlife, Tapas Bars, Spanish, Modern European, Bars, Cocktail Bars, Seafood, Venues & Event Spaces, Restaurants\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"17:0-22:0\",\"Monday\":\"0:0-0:0\",\"Saturday\":\"17:0-22:0\",\"Sunday\":\"17:0-21:0\",\"Thursday\":\"17:0-21:0\",\"Tuesday\":\"17:0-21:0\",\"Wednesday\":\"17:0-21:0\"},\"name\":\"Loquita\",\"review_info\":[{\"review_date\":\"2022-01-17 17:20:15\",\"review_stars\":4.0,\"review_text\":\"Came to loquita for the first time in SB. It's a very nice Spanish tapas restaurant with and outdoor patio and lots of fireplaces and heaters to keep guests warm at night. We ordered the el bulli, baya de oro and datil as small bites to start off the night. My favorite was the datil and the el bulli was an interesting citrus caviar but I didn't think it was mind blowing. Don't skip out on the Jamon tasting and manchego! The jamon tasting is perfect for 2 people and comes with plenty of meat (iberico, Serrano, and chorizo and pan con tomate). The manchego tasting plate was amazing and came with the best accompaniments! The almonds were out of this world and was cooked with a lavender type glaze on them which paired well with the cheese. Also, try the pulpo and churros to round off your meal. The pulpo was super tender and crisp and the churros were plenty to share. I even got to take the leftovers home for snacking later. Don't get the patatas bravas! I thought it was going to be more like a hash brown from previous photos but we got more smashed potatoes covered in like a hot mayo sauce! Definitely could have skipped on that one. Overall, it's a great dinner spot and was enjoyable on a Sunday night out.\"},{\"review_date\":\"2022-01-16 06:02:30\",\"review_stars\":3.0,\"review_text\":\"Was a nice atmosphere. Appreciated the outdoor dining and they are very thoughtful about having ample heaters to make sure diners are warm. \\n\\nStaff was nice. \\n\\nFood was slightly disappointing:\\n\\nEl bulli: felt like simple tangerine pulp with a micro basil leaf\\nCrudo: seafood is my jam and brininess is delish but the fish in this Crudo tasted fishy and felt like a coarse hunk of fish that wasn't cured at all in acid\\nPollo paella: wasn't bad but wasn't something to write home about\\nChurros: batter seemed very good but was burned with burnt flavor\\nBasque cheesecake: delicious! Light and not too sweet\"},{\"review_date\":\"2022-01-13 03:51:35\",\"review_stars\":4.0,\"review_text\":\"This place has the best food! I thought I knew a good paella until I came here. A bit on the pricey side but well worth it. We shared it with some sangria. The sangria was perfect, but too sweet or too tart. The service was quick and simple. We'd definitely come back here the next time we're in the area.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0023935509998409543, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 0, "window_sha256": "sha256:ffa3552186c467e92747512cab1c5e41e1852286519a8b50e7ffb990e54009ef", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 1123, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 504, "byte_start": 219, "call_id": "sha256:0275488df2f845a3caf4ab58", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-6b1ad4ce4faca0443395bebe", "kv_state_id": "reset-epoch-603", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": 5.388999938964844, "marked_response": "Loquita is a popular Spanish tapas restaurant located in Santa Barbara, California. With a rating of 4.5 stars, it offers a unique dining experience with an outdoor patio, fireplaces, and heaters for a cozy atmosphere. <<CARNOT_FOCUS_START:219:504>>The restaurant is known for its high-quality ingredients and creative dishes, including traditional Spanish favorites such as Jamon tasting and Manchego plates. The reviews suggest that the restaurant's food is delicious, particularly the El Bulli, Baya de Oro, and Datil small bites. <<CARNOT_FOCUS_END>>However, some reviewers found the Pollo Paella to be unremarkable. The service is friendly and efficient, and the restaurant offers a variety of options for vegetarians and vegans. While some reviewers found the prices to be a bit steep, most agree that it's worth the money for a special occasion.", "model_sha256": "sh