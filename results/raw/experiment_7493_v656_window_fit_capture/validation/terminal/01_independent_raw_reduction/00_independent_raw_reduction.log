79, 62944, 3470, 11, 1680, 430, 509, 74960, 160351, 287, 321, 328, 39, 2718, 627, 1, 8021, 11, 864, 513, 1801, 1973, 1594, 75840, 321, 513, 2400, 314, 16666, 13, 271, 760, 16078, 506, 13365, 2185, 25245, 11491, 13793, 369, 7246, 430, 41025, 321, 11321, 13, 561, 2478, 5891, 15325, 36064, 1332, 6112, 628, 4517, 836, 20347, 1345, 4483, 303, 279, 1593, 314, 15521, 30089, 156836, 789, 13, 561, 5395, 369, 11321, 321, 5529, 1603, 2393, 13, 271, 2064, 369, 5621, 25464, 421, 279, 7336, 506, 13365, 2185, 25245, 11491, 13793, 513, 383, 279, 4918, 809, 364, 10482, 11, 321, 279, 11930, 314, 279, 20347, 513, 11697, 2526, 13, 4213, 11, 6112, 14952, 279, 4131, 321, 12293, 314, 279, 10482, 11, 430, 1575, 430, 279, 28196, 2519, 2420, 13, 271, 26597, 11, 13365, 2185, 25245, 11491, 13793, 369, 264, 5243, 2136, 2478, 303, 15521, 30089, 3750, 364, 1141, 8800, 10482, 11, 41025, 16078, 11, 321, 17387, 62944, 3470, 13, 271, 55025, 198, 32, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 198, 33, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 15.758572578430176, " B": 16.046293258666992}, "raw_logits_by_option_id": {"contains_unsupported": 16.046293258666992, "supported": 15.758572578430176}, "readout_s": 3.566699979273835e-05, "request_id": "sha256:a86b84f8687db55e06dfc5d0", "requested_score_position": 1291, "response_sha256": "sha256:fc4ca7804b19b41acc6728b304327c983add912f5d97e8c080909d09aa07730d", "response_text": "Handlebar Coffee Roasters is a local business located at 2720 De La Vina St in Santa Barbara, CA. They offer a variety of services including coffee roasting, bakery items, and a wine bar. The business has received positive reviews from customers, with an average rating of 4.5 stars. \n\nCustomers have praised the quality of the coffee served at Handlebar Coffee Roasters. The coffee is described as strong, delicious, and brewed with the perfect mix of coffee beans to water. The business takes pride in roasting their own beans, which adds to the flavor profile of their coffee. In addition to coffee, customers have enjoyed the bakery items, such as cheddar scones and \"Hippie\" cookies, which are made without preservatives and are full of flavor.\n\nThe atmosphere at Handlebar Coffee Roasters is described as cozy and friendly. The business offers outdoor seating where customers can enjoy their drinks while taking in the view of Santa Barbara presidio. The staff is friendly and provides good service.\n\nIt is worth noting that the prices at Handlebar Coffee Roasters are on the higher end for coffee, and the sizes of the drinks are relatively small. However, customers appreciate the quality and taste of the coffee, as well as the vegan options available.\n\nOverall, Handlebar Coffee Roasters is a popular local business in Santa Barbara known for its excellent coffee, cozy atmosphere, and delicious bakery items.", "role": "training", "sealed_prompt_sha256": "sha256:e27be7b728d154f947a6a930ff7a97526bb51c44ce2f845c63689b0ed99d4a36", "sealed_prompt_token_count": 1292, "sentence_count": null, "sentence_version": null, "source_group_id": "group-8fa7230bcaa4c01d40a20847", "source_sha256": "sha256:1faa3fca42975a6ec7d528541f5537637e37d8deaa8677d84fdae9c3601547a2", "source_text": "{\"address\":\"2720 De La Vina St\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":false,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":null,\"RestaurantsReservations\":null,\"RestaurantsTakeOut\":null,\"WiFi\":\"free\"},\"business_stars\":4.5,\"categories\":\"Bars, Food, Coffee & Tea, Nightlife, Wine Bars, Coffee Roasteries, Bakeries\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"7:0-13:0\",\"Monday\":\"0:0-0:0\",\"Saturday\":\"7:0-13:0\",\"Sunday\":\"7:0-13:0\",\"Thursday\":\"7:0-13:0\",\"Tuesday\":\"7:0-13:0\",\"Wednesday\":\"7:0-13:0\"},\"name\":\"Handlebar Coffee Roasters\",\"review_info\":[{\"review_date\":\"2021-12-24 15:31:44\",\"review_stars\":5.0,\"review_text\":\"If for nothing else, i always visit the Handlebar for it's Terrific Coffee.\\nCoffee that i think changes a bit from based on what is available in the market at any given time.\\nNontheless, the Java served here is strong, delicious and brewed with the perfect mix of coffee beans to water on first class equipment. Other Coffee joints just don't get this.\\nSo we had big cups of Joe, a cheddar scone and a cookie called a Hippie cookie.\\nAm i witnessing a trend, a movement back here in SB to the Hippie Lifestyle? (Noted it in Whole Foods today also) hmmm.\\nIn any event the Coffee today was redolent of dark, stewed cherries and Roasted Pecans as well as perfectly roasted (which is done in house) beans: beans roasted just this side of burnt so as to squeeze out all the flavor the beans posses. Likewise the Cheddar Scone and \\\"Hippie\\\" Cookie are natural items free of any kind of preservative. The scone is slightly crispy and chock full of cheese, onion and herbs. The cookie is crunchy and full of oats,coconut and berries.\\nGreat time at the De la Vina Handlebar today. Btw: they have food pop ops here. In fact, months\\nAgo i had Roman style pizzs here.\\nCheers!\"},{\"review_date\":\"2021-12-24 05:24:24\",\"review_stars\":4.0,\"review_text\":\"I was in SB for the week and wanted to try their coffee since I hear a lot of great things about them and they seemed pretty popular. It wasn't too busy but there were a decent amount of people there. I ordered a vanilla oat latte and the cowboy brownie and it was good! The service was good and everyone was friendly. It is a bit more on the higher end price for coffee and their sizes are small but if you're looking for a cute place that has vegan options and serves good coffee, this is it.\"},{\"review_date\":\"2021-11-29 17:21:40\",\"review_stars\":5.0,\"review_text\":\"This place was fantastic! Hand down the best cafe in Santa Barbara. I am definitely coming  back here next time I'm in Santa Barbara. We heard good reviews for this place so gave it a try & boy it didn't disappoint!  \\nIt was busy morning at the cafe so stood in line for 10 mins & waited for our drinks for 5-7 mins more. Drinks are $3 to $6. And it was worth the wait! Their lattes were amazing and the baked items were delicious. We ordered double lattes & it was just perfect! Airy, foamy & bursting with best espresso flavor. It came in their signature white cups. \\n\\nThis place is very cozy & has a wonderful friendly vibe. They have outdoor seating too where you get a beautiful view of Santa Barbara presidio. \\n\\nWe also ordered cinnamon roll, cookies & almond scone. We loved it all!\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0025803230000747135, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 1311, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 476, "byte_start": 0, "call_id": "sha256:a06dd43e528c3a3332380b4c", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-8fa7230bcaa4c01d40a20847", "kv_state_id": "reset-epoch-764", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 0.7019910812377929, "marked_response": "<<CARNOT_FOCUS_START:0:476>>Handlebar Coffee Roasters is a local business located at 2720 De La Vina St in Santa Barbara, CA. They offer a variety of services including coffee roasting, bakery items, and a wine bar. The business has received positive reviews from customers, with an average rating of 4.5 stars. \n\nCustomers have praised the quality of the coffee served at Handlebar Coffee Roasters. The coffee is described as strong, delicious, and brewed with the perfect mix of coffee beans to water. <<CARNOT_FOCUS_END>>The business takes pride in roasting their own beans, which adds to the flavor profile of their coffee. In addition to coffee, customers have enjoyed the bakery items, such as cheddar scones and \"Hippie\" cookies, which are made without preservatives and are full of flavor.\n\nThe atmosphere at Handlebar Coffee Roasters is described as cozy and friendly. The business offers outdoor seating where customers can enjoy their drinks while taking in the view of Santa Barbara presidio. The staff is friendly and provides good service.\n\nIt is worth noting that the prices at Handlebar Coffee Roasters are on the higher end for coffee, and the sizes of the drinks are relatively small. However, customers appreciate the quality and taste of the coffee, as well as the vegan options available.\n\nOverall, Handlebar Coffee Roasters is a popular local business in Santa Barbara known for its excellent coffee, cozy atmosphere, and delicious bakery items.", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["supported", "contains_unsupported"], "order_remapping": {" A": "supported", " B": "contains_unsupported"}, "prefill_s": 1.5624532109995926, "probabilities_by_option_id": {"contains_unsupported": 0.668629072583861, "supported": 0.33137092741613905}, "prompt_sha256": "sha256:b933deaecc8f6ef51db54aa8ab257be98fd3ae8bba067c4440076e74f2928b60", "prompt_token_count": 1312, "prompt_t