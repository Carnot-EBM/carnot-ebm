a256": "sha256:f7129b63ac5ef53dde96e1c62f58daf1731b872218d0522c1a193b1a139699b0", "response_text": "The Arizona Attorney General's office has been asked to investigate the Arizona Commerce Authority (ACA) for potentially wasting millions of dollars on luxury trips for CEOs to the Super Bowl and Waste Management Open. The ACA claimed the trips were intended to persuade businesses to expand or relocate to Arizona, but auditors found no evidence that the trips created new jobs in the state. The Attorney General's office has begun investigating the matter, looking into whether the gifts violated the state constitution's prohibition on government agencies providing gifts without the expectation of investment.", "role": "training", "sealed_prompt_sha256": "sha256:934240457a8f3a72fec3dbc9d34e94c33e9a1b4338785181ea63bcf65af0a189", "sealed_prompt_token_count": 700, "sentence_count": 1, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-17f05526309dde98a764c76e", "source_sha256": "sha256:4f92f1615a24927bac38bc6d025ee411977c006adad8f39c8f2c962e17a67705", "source_text": "Millions Wasted by Arizona Agency on Luxury CEO Super Bowl Trips; AG Asked to Investigate\nArizona Attorney General Kris Mayes has been asked to investigate the possibility of significant wasted money from a state agency that reportedly spent millions on luxury trips for CEOs to the Super Bowl.\nThe attorney general is being asked to review whether or not the gifts violated the state constitution's prohibition on state agencies giving gifts to businesses, citing the agency's failure to properly ensure the gifts created opportunities for growth in Arizona.\nLuxury Trips to Super Bowl and Waste Management Open Given to CEOs\nAccording to a newly released report, auditors from the state of Arizona are asking Attorney General Kris Mayes to open an investigation into the Arizona Commerce Authority (ACA) after the state agency reportedly gave millions of dollars worth of luxury trips to CEOs, possibly in violation of the state constitution.\nThe ACA reportedly paid for around $2.1 million worth of luxury trips to Super Bowl LVII and the Waste Management Open to CEOs under the guise of attempting to sway the businesses into providing either expansion in Arizona or moving their companies to the state.\nThe CEOs got essentially every expense covered during their trips to the Super Bowl, with luxuries ranging from hotel rooms and transportation to food, alcohol, and high-value seats at the Super Bowl.\nThe ACA has said that the organized CEO forums are designed to lure businesses to the state, as well as provide education to them about the opportunities presented in Arizona.\nHowever, auditors are concerned about whether or not the gifts violate Article 9, Section 7 of the Arizona Constitution, which prohibits the government and government agencies from providing such gifts without the expectation of investment.\nAnd thus far, the ACA has reportedly been unable to provide documentation that the forums created any new jobs in the state.\n\u201cThe ACA\u2019s lack of documentation to show that it verified businesses met job and capital investment requirements before approving tax credits and distributing grant monies increases the risk of fraud and waste of public monies,\u201d auditors said, per AZ Mirror. \u201cSpecifically, businesses could submit fraudulent employment and wage information, thereby making the ACA more susceptible to fraud and waste of public monies.\u201d\nAttorney General Mayes' office says that they have begun investigating the matter.\nAt DailyNewsNow we bring you the latest news from the West Coast and around the country, covering a wide range of topics from politics and campaign news to entertainment and local interest stories. Please feel free to share the story with friends and join the conversation in the comments below!", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.001724640999782423, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 2, "window_sha256": "sha256:206cb5804b2e1347f45923f758a9255c763f107f186d44f113d96890bc45d2d1", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 677, "archived_pilot_reuse": false, "arm": "whole_response", "attempted": true, "byte_end": null, "byte_start": null, "call_id": "sha256:f81d0c69ff364b3fce33af1d", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-17f05526309dde98a764c76e", "kv_state_id": "reset-epoch-145", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": -1.7194652557373045, "marked_response": null, "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["contains_unsupported", "supported"], "order_remapping": {" A": "contains_unsupported", " B": "supported"}, "prefill_s": 0.8242991919996712, "probabilities_by_option_id": {"contains_unsupported": 0.15194005491684706, "supported": 0.8480599450831529}, "prompt_sha256": "sha256:158736650f36ee24341af52a91e608dac8f357fc0a80323a1a25c7e4e68a2d36", "prompt_token_count": 678, "prompt_token_ids": [1890, 1386, 1761, 364, 279, 4434, 1965, 1608, 1132, 279, 16713, 2450, 13, 271, 41578, 198, 11975, 880, 457, 14600, 539, 16441, 15898, 383, 49526, 11808, 7070, 19672, 12006, 1630, 26, 14642, 50891, 310, 31023, 344, 198, 78681, 17863, 3146, 50254, 3114, 287, 682, 978, 4439, 310, 18730, 279, 12665, 314, 4927, 37543, 3117, 494, 264, 1528, 8815, 421, 17296, 7157, 11391, 383, 18765, 21767, 364, 71691, 310, 279, 7070, 19672, 13, 198, 760, 13352, 4437,