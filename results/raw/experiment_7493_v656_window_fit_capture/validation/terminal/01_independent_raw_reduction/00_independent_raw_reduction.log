06, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 13.636821746826172, " B": 16.560104370117188}, "raw_logits_by_option_id": {"contains_unsupported": 16.560104370117188, "supported": 13.636821746826172}, "readout_s": 3.979499979323009e-05, "request_id": "sha256:e1e2913f6fff11135f710297", "requested_score_position": 1101, "response_sha256": "sha256:c12745a53f1cd1e4820dbf873698d9a3366577c6eb44aacfba22cde8cf007b82", "response_text": "Loquita is a popular Spanish tapas restaurant located in Santa Barbara, California. With a rating of 4.5 stars, it offers a unique dining experience with an outdoor patio, fireplaces, and heaters for a cozy atmosphere. The restaurant is known for its high-quality ingredients and creative dishes, including traditional Spanish favorites such as Jamon tasting and Manchego plates. The reviews suggest that the restaurant's food is delicious, particularly the El Bulli, Baya de Oro, and Datil small bites. However, some reviewers found the Pollo Paella to be unremarkable. The service is friendly and efficient, and the restaurant offers a variety of options for vegetarians and vegans. While some reviewers found the prices to be a bit steep, most agree that it's worth the money for a special occasion.", "role": "training", "sealed_prompt_sha256": "sha256:4b870e43a44dea42bc0295cc85cc2e76702ed4f04212f895f55bb8650daf64b0", "sealed_prompt_token_count": 1102, "sentence_count": null, "sentence_version": null, "source_group_id": "group-6b1ad4ce4faca0443395bebe", "source_sha256": "sha256:16cdb44be8b4d81ffb134a04f2b6fffc8333c3cac6ae6a4978a3d20d527541ee", "source_text": "{\"address\":\"202 State St\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":true,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":true,\"touristy\":false,\"trendy\":true,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":false,\"street\":true,\"valet\":true,\"validated\":false},\"Music\":false,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":null,\"WiFi\":\"no\"},\"business_stars\":4.5,\"categories\":\"Event Planning & Services, Nightlife, Tapas Bars, Spanish, Modern European, Bars, Cocktail Bars, Seafood, Venues & Event Spaces, Restaurants\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"17:0-22:0\",\"Monday\":\"0:0-0:0\",\"Saturday\":\"17:0-22:0\",\"Sunday\":\"17:0-21:0\",\"Thursday\":\"17:0-21:0\",\"Tuesday\":\"17:0-21:0\",\"Wednesday\":\"17:0-21:0\"},\"name\":\"Loquita\",\"review_info\":[{\"review_date\":\"2022-01-17 17:20:15\",\"review_stars\":4.0,\"review_text\":\"Came to loquita for the first time in SB. It's a very nice Spanish tapas restaurant with and outdoor patio and lots of fireplaces and heaters to keep guests warm at night. We ordered the el bulli, baya de oro and datil as small bites to start off the night. My favorite was the datil and the el bulli was an interesting citrus caviar but I didn't think it was mind blowing. Don't skip out on the Jamon tasting and manchego! The jamon tasting is perfect for 2 people and comes with plenty of meat (iberico, Serrano, and chorizo and pan con tomate). The manchego tasting plate was amazing and came with the best accompaniments! The almonds were out of this world and was cooked with a lavender type glaze on them which paired well with the cheese. Also, try the pulpo and churros to round off your meal. The pulpo was super tender and crisp and the churros were plenty to share. I even got to take the leftovers home for snacking later. Don't get the patatas bravas! I thought it was going to be more like a hash brown from previous photos but we got more smashed potatoes covered in like a hot mayo sauce! Definitely could have skipped on that one. Overall, it's a great dinner spot and was enjoyable on a Sunday night out.\"},{\"review_date\":\"2022-01-16 06:02:30\",\"review_stars\":3.0,\"review_text\":\"Was a nice atmosphere. Appreciated the outdoor dining and they are very thoughtful about having ample heaters to make sure diners are warm. \\n\\nStaff was nice. \\n\\nFood was slightly disappointing:\\n\\nEl bulli: felt like simple tangerine pulp with a micro basil leaf\\nCrudo: seafood is my jam and brininess is delish but the fish in this Crudo tasted fishy and felt like a coarse hunk of fish that wasn't cured at all in acid\\nPollo paella: wasn't bad but wasn't something to write home about\\nChurros: batter seemed very good but was burned with burnt flavor\\nBasque cheesecake: delicious! Light and not too sweet\"},{\"review_date\":\"2022-01-13 03:51:35\",\"review_stars\":4.0,\"review_text\":\"This place has the best food! I thought I knew a good paella until I came here. A bit on the pricey side but well worth it. We shared it with some sangria. The sangria was perfect, but too sweet or too tart. The service was quick and simple. We'd definitely come back here the next time we're in the area.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0019841410003209603, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 1121, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 219, "byte_start": 0, "call_id": "sha256:b434d7aa09e0af0e832c154d", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-6b1ad4ce4faca0443395bebe", "kv_state_id": "reset-epoch-598", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 3.2388744354248047, "marked_response": "<<CARNOT_FOCUS_START:0:219>>Loquita is a popular Spanish tapas restaurant loca