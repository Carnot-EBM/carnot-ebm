e Texas Senator Ted Cruz, who have strong conservative support. The possibility of a \"SEC primary\" in early March, with several conservative Southern states voting, is seen as a potential disadvantage for establishment favorites like Jeb Bush and Marco Rubio.", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["supported", "contains_unsupported"], "order_remapping": {" A": "supported", " B": "contains_unsupported"}, "prefill_s": 2.0067944639995403, "probabilities_by_option_id": {"contains_unsupported": 0.8807019219542015, "supported": 0.11929807804579855}, "prompt_sha256": "sha256:03a8e5a7af5bacc08af897ea7c19828375bcf10065d289ebce59a66f4ecb1ead", "prompt_token_count": 1674, "prompt_token_ids": [1890, 1386, 1761, 364, 279, 4434, 1965, 1608, 1132, 279, 16713, 2450, 13, 271, 41578, 198, 36870, 318, 53593, 8, 39836, 7864, 4643, 27204, 11, 279, 43986, 1560, 364, 799, 314, 1024, 18798, 310, 5323, 780, 10207, 11, 264, 17567, 11390, 364, 279, 21116, 11, 321, 9078, 12786, 10207, 9896, 1004, 7043, 8151, 2094, 279, 328, 23705, 33722, 1, 1898, 13, 220, 16, 13, 10049, 279, 7867, 430, 496, 26708, 88988, 5533, 12983, 310, 1228, 7864, 280, 7690, 13, 36885, 391, 694, 9077, 11, 4588, 21949, 23652, 13, 11232, 496, 26708, 88988, 369, 23484, 7520, 780, 18248, 314, 21346, 11068, 12933, 3929, 80186, 14597, 7864, 13, 2500, 18608, 668, 551, 615, 30, 27796, 31349, 1137, 15433, 13, 19166, 579, 11546, 1799, 8138, 88, 2640, 496, 26708, 88988, 30696, 1608, 12983, 6589, 430, 264, 3841, 1560, 310, 8597, 780, 9180, 1137, 321, 3296, 10480, 539, 7864, 11, 1040, 1024, 56163, 383, 279, 3296, 314, 3315, 1292, 11222, 10377, 45097, 7106, 310, 6637, 5404, 579, 20421, 13, 328, 11179, 854, 14597, 7864, 3269, 314, 80456, 1024, 37443, 494, 359, 15, 23, 310, 359, 16, 21, 1137, 1024, 4952, 383, 279, 11450, 6, 20421, 421, 567, 13675, 321, 975, 2433, 1137, 11