Most restaurants don't know how to master birria, but this place, they know how to cook birria. There was no consume to dip because it's already inside. That means that each bite is juicy and flavorful and just the best. \\n\\nI also ordered the doraditos for my kids and they loved it. Each crunchy rolled up taco came with quesa Fresca on top and lettuce. We ordered the horchata to compliment the meal and it was perfect. Their horchata is made with almond milk and unlike any horchata I've ever had. \\n\\nYou can really tell how much this restaurant values good quality ingredients, and it truly is apparent in the food. Don't miss this place if you're at the public market!\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.001607643999705033, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 2, "window_sha256": "sha256:b41fc01132419ae096f8f8ea79c71b2f2c2ac22c602973fb3eb4944ca0ba1f42", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 322, "archived_pilot_reuse": false, "arm": "whole_response", "attempted": true, "byte_end": null, "byte_start": null, "call_id": "sha256:0d32761c26f1ff6c9a48d024", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-9b22d901f41bb11b1a8bef20", "kv_state_id": "reset-epoch-843", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": -0.48765563964843756, "marked_response": null, "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["supported", "contain