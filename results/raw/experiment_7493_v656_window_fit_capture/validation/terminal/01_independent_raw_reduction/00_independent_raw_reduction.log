s_by_display_label": {" A": 11.920645713806152, " B": 14.043604850769043}, "raw_logits_by_option_id": {"contains_unsupported": 14.043604850769043, "supported": 11.920645713806152}, "readout_s": 5.4773000556451734e-05, "request_id": "sha256:3fda1b8b69f8f0746a1507df", "requested_score_position": 1232, "response_sha256": "sha256:ce9abd3dfdec22db4723c8318bac42c88cb2d5a74e15cf59fd6c997e993586b5", "response_text": "Based on the provided structured data, here is an objective overview of Lucky Dragon:\n\nLocation: Lucky Dragon is located in Goleta, California, with its address at 6831 Hollister Ave, Ste B.\n\nHours of Operation: The restaurant operates from Tuesday to Sunday, from 17:00 to 20:30, offering a consistent schedule throughout the week.\n\nCategories: Lucky Dragon falls under various categories, including Fast Food, Chinese, Restaurants, and Szechuan.\n\nCustomer Reviews: The restaurant has received positive reviews from customers, with an average rating of 4.2 out of 5 stars. Many reviewers have praised the restaurant's unique and authentic menu, which offers a variety of Sichuan dishes that are different from traditional American-Chinese food. The restaurant's service has also been commended, with reviewers mentioning friendly and helpful staff.\n\nMenu Items: While the menu at Lucky Dragon may seem unusual or different from other Chinese restaurants, reviewers have described the dishes as delicious and flavorful. Some popular items include bullfrog in a spicy sauce, kung pao chicken, long beans, fried rice, mapa tofu, and hot braised beef noodle. Reviewers have also mentioned that the restaurant does not offer hot sauce, but the dishes are already seasoned perfectly.\n\nAtmosphere: The restaurant's atmosphere is casual, making it suitable for a quick takeout or delivery order. However, there is no outdoor seating available.\n\nOverall, Lucky Dragon appears to be a hidden gem for those seeking authentic Sichuan cuisine in the Santa Barbara area. With its diverse menu, friendly service, and convenient hours, this restaurant is definitely worth checking out.", "role": "calibration_tuning", "sealed_prompt_sha256": "sha256:be9c10a7b33ce36c2c901f2d01bdacbb5ef0f2850d53e5363366030fb770dd2d", "sealed_prompt_token_count": 1233, "sentence_count": 5, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-08a0e23c7eee7e6b1262da55", "source_sha256": "sha256:d56add58f3dcf8daf1f9b0c7c8d560375eb663a56d55c5a69592661519ba1c1e", "source_text": "{\"address\":\"6831 Hollister Ave, Ste B\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":false,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":false,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":true,\"WiFi\":\"no\"},\"business_stars\":3.5,\"categories\":\"Fast Food, Chinese, Restaurants, Szechuan\",\"city\":\"Goleta\",\"hours\":{\"Friday\":\"17:0-20:30\",\"Saturday\":\"17:0-20:30\",\"Sunday\":\"17:0-20:30\",\"Thursday\":\"17:0-20:30\",\"Tuesday\":\"17:0-20:30\",\"Wednesday\":\"17:0-20:30\"},\"name\":\"Lucky Dragon\",\"review_info\":[{\"review_date\":\"2020-08-17 01:51:56\",\"review_stars\":5.0,\"review_text\":\"This place is great. VERY obscure/unusual/different/authentic menu. Not American-Chinese food by any stretch. \\nI'm in town visiting and needed delivery. I had no idea what to order. I asked Alex (the owner I believe) to bring me the 2 best dishes on the menu. The ones he's proud of. I'll eat anything and love spicy/hot food. \\nI don't know what I got but it was bullfrog (no joke) in a spicy sauce with tons of fresh veggies. Bullfrog???  I've never eaten that before. It's bony as hell but delicious. \\nHe sent me a second chicken dish that also had some spice with peanuts. It was just as good. \\nNext time I'm back in SB I'm just calling and asking him to bring me something great. It seeems to work. This place is a real find. Caution: it's Szechuan so be prepared for the heat. I say \\\"bring it\\\".\"},{\"review_date\":\"2020-06-08 03:46:54\",\"review_stars\":4.0,\"review_text\":\"We were staying at the Bacara and needed some food.  We ordered from here based on yelp.  When looking at the menu, we realized it wasn't a typcial chinese place.  No orange chicken, no chow mein, etc.  WE opted for the dumpliing in hot sauce, the kung pao chicken, long beans, fried rice, mapa tofu, and hot braised beef noodle.  They don't offer hot sauce (said everything was already seasoned perfectly).  I was a tad skeptical, but they were right.  Things were pretty well flavored.  Good heat through out.  The food was pretty darn good.  I just wished they gave more beef in the beef noodle.  The long beans were nice a crunchy.  The fried rice was really flavorful and not overly salty.  \\nOver all, we had a great meal here. Just wished they gave us rice with the dishes and offer plates for togo orders.\"},{\"review_date\":\"2020-03-27 15:25:09\",\"review_stars\":5.0,\"review_text\":\"I've lived in Chengdu, the capital of Sichuan, and I can say that Lucky Dragon has the most authentic and delicious Sichuan food in Santa Barbara county. Great service too. Really, love them so much.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0020727450000777026, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 2, "window_sha256": "sha256:5c43be0473eb4ffa79d106f2794bd656d29e0578cc94f4902ccb0dcb8b8c86eb", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 1208, "archived_pilot_reu