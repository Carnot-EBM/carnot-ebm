bara.", "role": "training", "sealed_prompt_sha256": "sha256:39a546eb9a1fc6a390f069ce122981a01e03cbdfed4b3d427f5f74a702e2d33f", "sealed_prompt_token_count": 993, "sentence_count": 3, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-749869b78483b77e80fd464a", "source_sha256": "sha256:1548121a0f7db6b0273d57a7f1a09f16983bd52369474828ec553e148872e71b", "source_text": "{\"address\":\"1014 Coast Village Rd\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":true,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":true,\"valet\":true,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":true,\"WiFi\":\"free\"},\"business_stars\":4.5,\"categories\":\"Restaurants, Italian, Pizza\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"16:0-20:30\",\"Monday\":\"0:0-0:0\",\"Saturday\":\"16:0-20:30\",\"Sunday\":\"16:0-20:30\",\"Thursday\":\"16:0-20:30\",\"Tuesday\":\"16:0-20:30\",\"Wednesday\":\"16:0-20:30\"},\"name\":\"Bettina\",\"review_info\":[{\"review_date\":\"2022-01-14 02:46:25\",\"review_stars\":1.0,\"review_text\":\"The hype is over for this place. Local, who used to use this place for everything, and a spot to celebrate girlfriends birthdays. The food was not the issue. The staff is flat, unengaging and silent. You can feel their stuffy awkward energy. As someone who used to be a server myself, I always love being courteous to server staff/tipping well. But man, very hard to do here.\"},{\"review_date\":\"2022-01-10 20:40:01\",\"review_stars\":5.0,\"review_text\":\"Omg I'm a hard core pizza aficionado and this could be my new favorite pizza place in North America. Don't let it's location in the Montecito Country Mart fool you, please make a reservation asap. \\n\\nThe menu is very tight but that's fine. Everyone raves about the carbonara pizza but I hate eggs do we skipped it. We wanted a light lunch to save room for steak dinner so we opted for a bottle of Sancerre, baby gems salad and meat lovers pizza. They all hit perfectly!\\n\\nThe server was terrific. The ambiance felt like a garden getaway and parking was too easy. Please run to this lovely restaurant and grab a matchbox or two for the memories.\"},{\"review_date\":\"2022-01-06 05:51:02\",\"review_stars\":5.0,\"review_text\":\"Decided to check out Bettina during our recent trip to Santa Barbara and boy was it a great experience. The location is random (in the Montecito country mart shopping center) but the inside and the courtyard of the restaurant are charming. And we figured we came to a good spot when we noticed all the locals either dining there or picking up pies. Everything we ordered was delicious! We got the burrata to start, that had this amazing green pistachio/veggie paste on top - it also came with an excellent Focaccia. Broccolini, which was tangy, charred to perfection and just delish.  And two pizzas, the mushroom and pepperoni, which may have been the best I've had. Great little spot in SB, highly recommend.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.001806577000024845, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 2, "window_sha256": "sha256:cdd92fa61015e1ba2f4643e51420d05bd91af1645892a69169497d14bd2fe82b", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 746, "archived_pilot_reuse": false, "arm": "whole_response", "attempted": true, "byte_end": null, "byte_start": null, "call_id": "sha256:69cf8ffcec7a0d6e8694a941", "disposition": "complete", "eligible": true, "erro