8, 33, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 13.97848892211914, " B": 14.514397621154785}, "raw_logits_by_option_id": {"contains_unsupported": 14.514397621154785, "supported": 13.97848892211914}, "readout_s": 3.113899947493337e-05, "request_id": "sha256:0f7b70b9f337ebdaa1a8510e", "requested_score_position": 867, "response_sha256": "sha256:97834b8f46c34e3fe4120075c8af0303bf0b5a8823721693c15d9b1b83e7c1b1", "response_text": "Adama Vegan Comfort Cuisine is a now-closed restaurant located in Santa Barbara, CA, that specialized in vegan and gluten-free comfort food. The restaurant had a retro atmosphere and offered outdoor seating, take-out, and free WiFi. According to customer reviews, the food was delicious and unique, with a highlight being their homemade gelato. One reviewer particularly enjoyed the quiche, which was described as \"sooooo good!\" The restaurant also offered a variety of vegetarian options. However, some customers found the portions to be small and the prices to be high, with one reviewer leaving feeling hungry despite spending over $30. The service was reported to be decent, with one reviewer noting that their waitress was new but helpful. Overall, Adama Vegan Comfort Cuisine appeared to be a cozy and unique dining spot, well-suited for a casual meal or date night.", "role": "calibration_tuning", "sealed_prompt_sha256": "sha256:678fefd117aea78e69b82f8ae1a6d521c46816905ea918faf112dcde69774c23", "sealed_prompt_token_count": 868, "sentence_count": 3, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-c5bf6ad1da309fc4a5c0fed1", "source_sha256": "sha256:23a11b8adeeecd2a2e40c789315c1a9acfe8d61733d87c4fbf3a50a7c2cd025e", "source_text": "{\"address\":\"428 Chapala St\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":false,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":true,\"WiFi\":\"free\"},\"business_stars\":4.0,\"categories\":\"Restaurants, Vegetarian, Vegan\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"17:0-21:0\",\"Monday\":\"17:0-21:0\",\"Saturday\":\"17:0-21:0\",\"Sunday\":\"17:0-21:0\",\"Thursday\":\"17:0-21:0\",\"Tuesday\":\"17:0-21:0\",\"Wednesday\":\"17:0-21:0\"},\"name\":\"Adama Vegan Comfort Cuisine\",\"review_info\":[{\"review_date\":\"2014-12-03 07:05:30\",\"review_stars\":5.0,\"review_text\":\"I was fortunate enough to try this place before they closed permanently. \\n\\nIf I had known, I would have ordered like it was my last meal. \\n\\nI loved stopping by here before a mini road trip to central California. It brought the comforts of home away from home. You just got that vibe the instant you walked in. \\n\\nI loved that they made their own gelato. I had tried the caramelized banana, freaking amazing! \\n\\nI loved that everything on the menu was vegan and gluten-free. I had the quiche which was sooooo good! Where can you find a vegan quiche?!?! \\n\\nI loved that the decor was retro. It would have been the perfect date spot. \\n\\nAdama, it was love at first sight and bite. Please come back! Or open up elsewhere. I heard it was a bad location...\\n\\nThank you for reading this emotional review. I'm so sad.\"},{\"review_date\":\"2014-11-29 03:26:48\",\"review_stars\":5.0,\"review_text\":\"Service wasn't as bad as many of the reviews are saying. The waitress we had seemed pretty new on the job but was really helpful. \\nExpensive food but incredibly tasty and unique.\"},{\"review_date\":\"2014-11-24 06:11:09\",\"review_stars\":3.0,\"review_text\":\"Very small portions at a high price. Be prepared to spend over $30 and leave hungry.\\nFood is not bad...\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0015635749996363302, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 1, "window_sha256": "sha256:375d713d82115c0f9daa2f449247585a64fdeb0bb097ff9410cc994d90433445", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 867, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 872, "byte_start": 640, "call_id": "sha256:cad4322d038c7aca0344643b", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-c5bf6ad1da309fc4a5c0fed1", "kv_state_id": "reset-epoch-1748", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 0.46828651428222645, "marked_response": "Adama Vegan Comfort Cuisine is a now-closed restaurant located in Santa Barbara, CA, that specialized in vegan and gluten-free comfort food. The restaurant had a retro atmosphere and offered outdoor seating, take-out, and free WiFi. According to customer reviews, the food was delicious and unique, with a highlight being their homemade gelato. One reviewer particularly enjoyed the quiche, which was described as \"sooooo good!\" The restaurant also offered a variety of vegetarian options. However, some customers found the portions to be small and the prices to be high, with one reviewer leaving feeling hungry despite spending over $30. <<CARNOT_FOCUS_START:640:872>>The service was reported to be decent, with one reviewer noting that their waitress was new but helpful. Overall, Adama Vegan Comfort Cuisine appeared to be a cozy and unique dining spot, well-suited for a casual meal or date nig