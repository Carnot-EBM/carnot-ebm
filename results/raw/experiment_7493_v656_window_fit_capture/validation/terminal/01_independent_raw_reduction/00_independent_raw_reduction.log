0, 264, 67880, 321, 71411, 16078, 13, 561, 10413, 682, 264, 2943, 321, 264, 4139, 6561, 10412, 321, 5891, 2107, 28557, 321, 15325, 17378, 13, 561, 10413, 5891, 38731, 321, 682, 264, 8250, 1970, 314, 7539, 15855, 13, 561, 4861, 5469, 264, 7792, 314, 10452, 24958, 11, 2583, 63986, 321, 274, 956, 24050, 11, 430, 1575, 430, 55070, 321, 12701, 13, 561, 10413, 369, 3750, 364, 1141, 23595, 4131, 314, 7397, 321, 1141, 7613, 570, 507, 1647, 33847, 13, 1079, 34, 8778, 1730, 93291, 12671, 25, 22, 22, 15, 25, 16, 16, 19, 21, 2372, 43352, 628, 4992, 494, 279, 3626, 46124, 440, 836, 3487, 466, 3278, 364, 3714, 20347, 13, 561, 10413, 1048, 5891, 28196, 321, 43868, 2519, 13, 561, 7336, 513, 383, 279, 4918, 3008, 11, 440, 264, 26770, 10737, 314, 393, 17, 20, 791, 1637, 321, 449, 7613, 570, 507, 14704, 51922, 393, 16, 19, 20, 13, 561, 10413, 5891, 264, 4752, 321, 31423, 17378, 3039, 11, 440, 8800, 2393, 321, 23595, 4131, 314, 3487, 13, 2362, 34, 8778, 1730, 93291, 10580, 2372, 271, 55025, 198, 32, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 198, 33, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 12.14604377746582, " B": 16.496248245239258}, "raw_logits_by_option_id": {"contains_unsupported": 16.496248245239258, "supported": 12.14604377746582}, "readout_s": 3.587700030038832e-05, "request_id": "sha256:f07cba823c38eff319576a7a", "requested_score_position": 1623, "response_sha256": "sha256:0eec7af0ce222e1ae5d2ee4af6ba052ca8a9966b043876380437fd0ca775f97c", "response_text": "Sushi | Bar Montecito is a Michelin-starred restaurant located in Montecito, California. They offer a variety of cuisine, including Japanese and sushi bars, and are open Wednesday through Sunday from 6pm to midnight. Customers can park in the lot or use valet parking. The restaurant offers outdoor seating and takes out orders. The ambiance is intimate and romantic, with a classy and upscale atmosphere. The restaurant has a four and a half star rating and offers both indoor and outdoor dining. The restaurant offers reservations and has a dress code of smart casual. The menu includes a variety of Japanese dishes, including sushi and sashimi, as well as cocktails and wine. The restaurant is known for its exceptional quality of fish and its omakase style cuisine. Customers can choose from the house pairing with their food or opt for individual drinks. The restaurant also offers vegan and vegetarian options. The prices are on the higher side, with a reservation fee of $25 per person and an omakase meal costing $145. The restaurant offers a unique and memorable dining experience, with excellent service and exceptional quality of food.", "role": "training", "sealed_prompt_sha256": "sha256:5d91adbc1f0a2698bfa3c9f7d0a72bbb8af001782e64ef185edaa541180d651a", "sealed_prompt_token_count": 1624, "sentence_count": 4, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-7c7836b624103f81c84f2dcd", "source_sha256": "sha256:29910ec73e9b8bc2d34a1e86ad0e3405953225b7fd92861825e7c11eadf15f0b", "source_text": "{\"address\":\"1295 Coast Village Rd\",\"attributes\":{\"Ambience\":{\"casual\":null,\"classy\":true,\"divey\":false,\"hipster\":null,\"intimate\":true,\"romantic\":null,\"touristy\":null,\"trendy\":null,\"upscale\":true},\"BusinessParking\":{\"garage\":false,\"lot\":false,\"street\":false,\"valet\":true,\"validated\":false},\"Music\":null,\"OutdoorSeating\":null,\"RestaurantsGoodForGroups\":null,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":true,\"WiFi\":\"no\"},\"business_stars\":4.5,\"categories\":\"Restaurants, Nightlife, Whiskey Bars, Japanese, Bars, Sushi Bars\",\"city\":\"Montecito\",\"hours\":{\"Friday\":\"17:0-22:0\",\"Saturday\":\"17:0-22:0\",\"Sunday\":\"18:0-22:0\",\"Thursday\":\"18:0-22:0\",\"Wednesday\":\"18:0-22:0\"},\"name\":\"Sushi | Bar Montecito\",\"review_info\":[{\"review_date\":\"2022-01-17 22:19:41\",\"review_stars\":5.0,\"review_text\":\"Honestly can't imagine a situation where this restaurant doesn't get a 5 star rating. It. Is. Amazing. \\n\\nI had recently heard about this place as it's one of the few restaurants in the area that has a Michelin star. I wanted to go there for my birthday but it was booked up. But lucky for me, there was an opening for an anniversary dinner for me and my hubby the following week. \\n\\nWe arrived outside 15 mins before our reservation, as they requested, and bumped into one of the sushi chefs (though we didn't know it at the time). He saw us poking our heads around looking confused so he asked if we were there for a sushi reservation. We said yes and he graciously walked us into the hotel lobby and pointed out the guy we were supposed to check in with.\\n\\nAfter we checked in with the host, he brought out cute little sake cups and dishes for our complimentary beverage. It was so refreshing and delicious. The host also wished us a happy anniversary, which I thought was so nice. We waited in the area for about 15 mins waiting for the rest of the diners to show up and once everyone did, we were all guided into the quaint little sushi bar.\\n\\nThey have assigned seating once you get inside. Every seat has the guest's name written on a blackboard slab. I was so pleased to see they sat me and my husband front and center in front of the head chef, it was truly a treat! \\n\\nNow, I've only had omakase one other time before this time (at Yoichi's, which I was unfortunately not impressed with) so I'm not super experienced with the whole omakase culinary experience. BUT every piece of food I had there was just phenomenal. For drinks, we did the house pairing with our food. It was fun to do once but certainly wouldn't do it again as it was quite pricey and not sure it made a huge difference to the overall experience of our food.\\n\\nI'm generally not a nigiri or sashimi type of sushi eater. I'll admit it, I generally like sushi rolls with cooked fish, I know that's like blasphemy but most places where I've had a huge hunk of raw fish, the texture of the cold chewy fish sloshing around in my mouth just really grosses me out. I say this because I think it means even more coming from someone like me that their raw fish is just so top notch. Some pieces were so soft and fresh it just melted in my mouth. I'm getting hungry just thinking back on it now. There's been very few places where the meal was so good that I go back in my mind and fantasize about it. That's what photos are for and I normally do take pictures but chose not to this time because it felt a little rude. So I guess I'll just have to relive this experience through my mind only, and trust me, I often do. \\n\\nI can't wait for future special occasions to come up again so I can come back here. It was quite a pricey meal but trust me, it's worth every penny!\"},{\"review_date\":\"2022-01-03 06:25:02\",\"review_stars\":4.0,\"review_text\":\"My boyfriend and I decided to give this place a try since we heard it has one Michelin star. Reservation is $25 deposit per person and the omakase is $145 which consists of 17 courses including dessert.\\n\\nWe arrived on time even though it is recommended to arrive 15 minutes ahead of time. We still end up having to wait for about 10 minutes in the lobby of the Montecito Inn. The hostess asked us if we wanted drinks while we were waiting.\\n\\nThere were no chopsticks. Everyone ate their food with their hands and there was a hot towel to clean your hands. The food was delicious except the rice was a bit mushy. Fish was high quality and fresh. I didn't drink, but everyone else were drinking. As someone here has mentioned, I also felt that their goal was to get people drunk. In the end, the chef asked if anyone wants to try the wagyu or any of the previous nigiris again. \\n\\nOverall, the service was great but expect to pay about $200 per person.\"},{\"review_date\":\"2022-01-01 23:31:19\",\"review_stars\":1.0,\"review_text\":\"My partner and I ate at this restaurant a few months ago and were disappointed. While the food was okay, the service was very poor, and members of the staff shouted the drinks options to patrons. Additionally, the chef made some very crude remarks. It did not feel like a Montecito experience and rather something rough-and-tumble in Los Angeles. Based on my experience and the high price tag ($500 for two people), I would not recommend it.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.00270972599992092, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 2, "window_sha256": "sha256:bc687d4bbbb5e5d8565c16422faff87b9c2cc33173dc3cd59fd9225f336dd639", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 1600, "archived_pilot_reuse": false, "arm": "whole_response", "attempted": true, "byte_end": null, "byte_start": null, "call_id": "sha256:5f116d75af30fae35394cccf", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-7c7836b624103f81c84f2dcd", "kv_state_id": "reset-epoch-689", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": 5.91390323638916, "marked_response": null, "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["contains_unsupported", "supported"], "order_remapping": {" A": "contains_unsupported", " B": "supported"}, "prefill_s": 1.905987438000011, "probabilities_by_option_id": {"contains_unsupported": 0.9973056578774296, "supported": 0.0026943421225702