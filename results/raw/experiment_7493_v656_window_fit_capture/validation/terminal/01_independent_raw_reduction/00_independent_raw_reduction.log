495, 13, 496, 266, 87498, 369, 264, 5243, 5576, 364, 1782, 3221, 364, 34684, 3487, 321, 16845, 39334, 11228, 303, 15521, 30089, 13, 271, 55025, 198, 32, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 198, 33, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 15.584956169128418, " B": 11.463841438293457}, "raw_logits_by_option_id": {"contains_unsupported": 15.584956169128418, "supported": 11.463841438293457}, "readout_s": 3.138899955956731e-05, "request_id": "sha256:65ed294f6af86bbc78f952e8", "requested_score_position": 885, "response_sha256": "sha256:99fc69054e1070530148eaddc5761b23e3f9a00511365ac026b762daa9d4302d", "response_text": "Oat Bakery is a local business located at 5 W Haley St in Santa Barbara, CA. They specialize in bakery items and offer a range of vegan and gluten-free options. Customers have praised the bakery for its assortment of bread, particularly the seed cookie and cinnamon rolls. However, some customers were disappointed that they did not have bagels and vegan cream cheese available for purchase. \n\nThe bakery's hours of operation are as follows: Tuesday to Saturday from 9:00 AM to 2:30 PM. It is closed on Mondays. The business has street parking and a parking lot available for customers. They also accept restaurant reservations and have outdoor seating. The bakery does not provide WiFi and does not offer takeout or group dining options. There is no information available regarding music or ambience.\n\nOverall, Oat Bakery has received positive reviews, with a 5-star rating. Customers have praised the bakery for its delicious and filling bread options, particularly the seeded loaf. Although some items may be on the pricier side, customers have expressed their willingness to return to the bakery if they are in the area again. Oat Bakery is a popular choice for those looking for specialty food and organic baked goods in Santa Barbara.", "role": "calibration_tuning", "sealed_prompt_sha256": "sha256:ab6612a74214da9b1fb25156589d80b98858ed678a02cc57ef9abb66826373f4", "sealed_prompt_token_count": 886, "sentence_count": 6, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-b882e9983a8d609a4d0c2e46", "source_sha256": "sha256:c38305eaa334a05141126d9307a4a3d65652575a903f76fd51a0c0f1effa3fbf", "source_text": "{\"address\":\"5 W Haley St\",\"attributes\":{\"Ambience\":null,\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":null,\"RestaurantsGoodForGroups\":null,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":null,\"WiFi\":\"no\"},\"business_stars\":5.0,\"categories\":\"Bakeries, Vegan, Specialty Food, Food Delivery Services, Food, Coffee & Tea, Gluten-Free, Farmers Market, Restaurants, Organic Stores\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"9:0-14:30\",\"Monday\":\"0:0-0:0\",\"Saturday\":\"9:0-14:30\",\"Thursday\":\"9:0-14:30\",\"Tuesday\":\"9:0-18:0\",\"Wednesday\":\"9:0-14:30\"},\"name\":\"Oat Bakery\",\"review_info\":[{\"review_date\":\"2022-01-19 05:59:11\",\"review_stars\":4.0,\"review_text\":\"Cute bakery with great assortment of bread.  We were hoping they had bagels and vegan cream cheese for our road trip but unfortunately they did not.  We did try the seed cookie which was amazing and very filling. Also loved the cinnamon rolls. \\nThey had an assortment of plant based cream cheeses that I would have loved to try. Unfortunately we were passing though and did not want to buy an entire container and large loaf.\"},{\"review_date\":\"2021-12-30 00:02:07\",\"review_stars\":5.0,\"review_text\":\"We came here at the recommendation of Low Pigeon Coffee Roasters, looking for some bakery items to munch on with our coffees. Unfortunately, it was more bread than sweets, but we still walked away with some hygge buns and the most delicious foccocia bread. I wish we lived in SB just so we could appreciate their other breads because I couldn't justify getting a loaf only to have it sit for days before being able to enjoy it in our kitchen at home.\"},{\"review_date\":\"2021-12-29 04:59:50\",\"review_stars\":5.0,\"review_text\":\"I got Half of a Seeded loaf. No flour. \\n$15. Omg it was yum. Dense and complex. \\nI don't live in the area but if I ever I'm in the area again I am definitely going to get the seeded loaf again.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.001647943000534724, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 1, "window_sha256": "sha256:fdcfd83510c32eaade32de92a5619e3f29cd98fd11f045adb98661dc7b669dfd", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 886, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 1240, "byte_start": 803, "call_id": "sha256:fb72fa3e5176b6706a20f1f0", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-b882e9983a8d609a4d0c2e46", "kv_state_id": "reset-epoch-1730", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": 4.532873153686523, "marked_response": "Oat Bakery is a local business located at 5 W Haley St in Santa Barbara, CA. They specialize in bakery items and offer a range of vegan and gluten-free options. Customers have praised the bakery for its assortment of bread, particularly the seed cookie and cinnamon rolls. However, some customers were disappointed that they did not have bagels and vegan cream cheese available for purchase. \n\nThe bakery's hours of operation are as follows: Tuesday to Saturday from 9:00 AM to 2:30 PM. It is closed on Mondays. The business has street parking and a parking lot available for customers. They also accept restaurant reservations and have outdoor seating. The bakery does not provide WiFi and does not offer takeout or group dining options. There is no information available regarding music or ambience.\n\n<<CARNOT_FOCUS_START:803:1240>>Overall, Oat Bakery has received positive reviews, with a 5-star rating. Customers have praised the bakery for its delicious and filling bread options, particularly the seeded loaf. Although some items may be on the pricier side, customers have expressed their willingness to return to the bakery if they are in the area again. Oat Bakery is a popular choice for those looking for specialty food and organic baked goods in Santa Barbara.<<CARNOT_FOCUS_END>>", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["contains_unsupported", "supported"], "order_remapping": {" A": "contains_unsupported", " B": "supported"}, "prefill_s": 1.050446723999812, "probabilities_by_option_id": {"contains_unsupported": 0.9893645820531457, "supported": 0.010635417946854258}, "prompt_sha256": "sha256:e7bacbc4a2a542ae1eb34623e0ce792a960623e628aba187c1cd5b5a7083cdbe", "prompt_token_count": 887, "prompt_token_ids": [1890, 1386, 1761, 364, 279, 4434, 1965, 1608, 1132, 279, 16713, 2450, 13, 271, 41578, 198, 4754, 4834, 3147, 20, 457, 65428, 769, 2129, 11987, 21624, 52218, 1772, 763, 2827, 1288, 22020, 91061, 21624, 11816, 416, 763, 3721, 1288, 8911, 763, 1802, 1288, 26466, 763, 1802, 1288, 6378, 1112, 763, 3721, 1288, 57576, 763, 3721, 49471, 23373, 763, 2827, 1288, 95130, 1460, 1060, 763, 2827, 1288, 12060, 32858, 14773, 2381, 21485, 763, 2827, 1288, 12060, 32858, 1026, 44294, 763, 1802, 1288, 12060, 32858, 17283, 2575, 763, 2827, 1288, 92247, 3147, 2083, 56658, 