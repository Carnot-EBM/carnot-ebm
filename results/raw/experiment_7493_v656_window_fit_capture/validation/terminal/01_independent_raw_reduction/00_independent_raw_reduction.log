 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 13.970073699951172, " B": 17.203405380249023}, "raw_logits_by_option_id": {"contains_unsupported": 13.970073699951172, "supported": 17.203405380249023}, "readout_s": 5.6646000302862376e-05, "request_id": "sha256:836eaa1a32b23606e7053064", "requested_score_position": 574, "response_sha256": "sha256:801e367e0fe69fe885e48e22c5203df5d8eb3ac33fb0bbf98a5d253fd45372aa", "response_text": "Mahanoy Area High School's football team fell short in a comeback against Marian Catholic Colts, losing 21-13. Despite being 21-0 down, the Golden Bears had several opportunities to level the score but were unable to capitalise. The loss leaves Mahanoy Area with a 1-5 record, while the Colts moved up to 4-2. The Golden Bears will now face Williams Valley at Stauffenberg Field at Viking Stadium in Williamstown next Friday, while Marian faces Shenandoah Valley.", "role": "calibration_tuning", "sealed_prompt_sha256": "sha256:5a1152738f0fd427438ccf4960ceb0047a085340aabb4ddb65a202d67a68c0ba", "sealed_prompt_token_count": 575, "sentence_count": null, "sentence_version": null, "source_group_id": "group-a5415b67218ea84d0c9addd9", "source_sha256": "sha256:c13c024067a8a3b0a269e13d2e3179ac4356d51ffb0e1f1465b6716accf49bf5", "source_text": "HS FOOTBALL: Mahanoy comeback falls short at Marian, Bears fall 21-13\nHOMETOWN \u2013 From being down 21-0, Mahanoy Area had multiple chances to come out of Hometown with a storybook comeback, but could never capitalize.\nThe Golden Bears entered Saturday\u2019s game with a 1-4 record as they visited the 3-2 Marian Catholic Colts.\nThe Colts struck first via a one yard run by senior fullback Jesse Rodino with under 7 minutes left in the first.\nFreshman running back Rory Dixon would find paydirt later in the first on a four yard run, set up by a long pass from senior quarterback Bruce Hopeck to senior receiver Brandon Klitsch.\nAnother short-yardage run by Dixon \u2014 who amassed 100 yards on the ground \u2014 would give the Colts a 21-0 advantage with 7:30 left in the second quarter.\nCue the start of a Golden Bear comeback.\nWith seconds left in the half, junior quarterback Levi Terry found a receiver Austin Green in the endzone to score.\nHalfway through the third quarter, senior running back Colm McGroarty punched it in from a yard out. With a failed point after, the Bears were down 21-7.\nA fumble on the ensuing Marian drive gave the Bears a chance to tie it up, but Marian\u2019s defense kept them at bay for the remainder of the game.\nThe Colts secured the victory 21-13 to move to 4-2 as the Bears fell to 1-5.\nMahanoy Area moved on to face Williams Valley at Stauffenberg Field at Viking Stadium in Williamstown next Friday, while Marian faces Shenandoah Valley.\nFull Photo Gallery\nThe post HS FOOTBALL: Mahanoy comeback falls short at Marian, Bears fall 21-13 appeared first on The Shenandoah Sentinel .", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0012593129995366326, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 594, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 111, "byte_start": 0, "call_id": "sha256:f02e0c8573f4e5f2d08fea5d", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-a5415b67218ea84d0c9addd9", "kv_state_id": "reset-epoch-1696", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": -1.1273441314697266, "marked_response": "<<CARNOT_FOCUS_START:0:111>>Mahanoy Area High School's football team fell short in a comeback against Marian