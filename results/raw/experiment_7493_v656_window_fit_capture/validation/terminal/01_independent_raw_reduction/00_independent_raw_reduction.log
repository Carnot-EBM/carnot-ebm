_logits_by_display_label": {" A": 15.67320442199707, " B": 16.343997955322266}, "raw_logits_by_option_id": {"contains_unsupported": 15.67320442199707, "supported": 16.343997955322266}, "readout_s": 3.803199979302008e-05, "request_id": "sha256:29fab65199e3c76f10dbd636", "requested_score_position": 942, "response_sha256": "sha256:227b3b469f892b7b6d5c3f368c9b2051647ab65f8f9f354ad422572c17a86a54", "response_text": "De La Guerra Dining Commons is a local business located at 1501 Residential Services in Santa Barbara, CA. It operates as a cafeteria and cafe, offering a range of American (New), sandwich, pizza, and Mexican cuisine. The dining commons has specific operating hours, opening from 21:0 to 0:30 on Monday to Thursday, and from 17:0 to 20:0 on Friday, Saturday, and Sunday.\n\nCustomers have left mixed reviews about De La Guerra Dining Commons. One customer expressed dissatisfaction, mentioning long lines and subpar food, except for the hard-boiled eggs. Another customer, however, had a more positive experience, describing the dining commons as clean with a variety of options. They appreciated the quality of food compared to other campus dining halls and praised the kind staff. They also mentioned the premium views of Isla Vista and the UCSB community.\n\nAnother customer highlighted the expansive variety of food options at De La Guerra Dining Commons. They mentioned burgers being available for breakfast, lunch, and dinner but noted that they were sometimes undercooked or even frozen. They also mentioned experiencing diarrhea from the Mexican food. However, they enjoyed the wide variety of meat options, particularly the fish cakes.\n\nOverall, De La Guerra Dining Commons has a rating of 3.0 stars. The provided reviews highlight both positive and negative aspects of the dining experience, allowing potential customers to make an informed decision.", "role": "training", "sealed_prompt_sha256": "sha256:814e64f98875883031fcec39d6da7231a2c592f240ca9190bb0caf84050ce237", "sealed_prompt_token_count": 943, "sentence_count": 4, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-05f22381724a0914a4f0ca7b", "source_sha256": "sha256:4ec8ee623c891bedaa72806036797f67588ad8c49ff8b4d0844f5356a1d391c0", "source_text": "{\"address\":\"1501 Residential Services\",\"attributes\":{\"Ambience\":{\"casual\":null,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":null,\"touristy\":null,\"trendy\":null,\"upscale\":false},\"BusinessParking\":null,\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":false,\"WiFi\":\"free\"},\"business_stars\":3.0,\"categories\":\"Cafeteria, Cafes, American (New), Restaurants, Sandwiches, Pizza, Mexican\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"17:0-20:0\",\"Monday\":\"21:0-0:30\",\"Saturday\":\"17:0-20:0\",\"Sunday\":\"17:0-20:0\",\"Thursday\":\"21:0-0:30\",\"Tuesday\":\"21:0-0:30\",\"Wednesday\":\"21:0-0:30\"},\"name\":\"De La Guerra Dining Commons\",\"review_info\":[{\"review_date\":\"2021-10-13 02:40:32\",\"review_stars\":1.0,\"review_text\":\"its bad. don't go here. long lines for subpar food. the hard boiled eggs are the only things worth getting, otherwise steer clear.\"},{\"review_date\":\"2019-09-04 20:29:00\",\"review_stars\":4.0,\"review_text\":\"Clean with a variety of options. Relative to other campus dining halls, this place is quality. A surprising amount of variety and kind staff. Premium views of Isla Vista and the UCSB community.\"},{\"review_date\":\"2018-11-30 02:25:55\",\"review_stars\":5.0,\"review_text\":\"Helluu it's me again. To start of, De La Guerra or \\\"DLG\\\" for short, has an expansive variety of food options for those eating there. Walking into DLG you are greeted with a list of all the wonderful, edible food they have prepared for that meal. Let's start with the burgers. Burgers are offered at almost every meal: breakfast lunch and dinner. Although you think that burgers are pretty hard to mess up, they are often undercooked, sometimes even frozen. Now let move on to the Mexican. It gives you diarrhea. In edition to these two favorites of mine, they often offer a wide variety of meat. What kind of meat? Well, you never quite know. But my favorite is the fish cakes:) Have fun at DLG!\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0017338379993816488, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 0, "window_sha256": "sha256:0fb75fb74d7e9e3cfdf24ea9dfe2ebbca5f85d16fff25c1a9626fb66366a47c1", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 944, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 957, "byte_start": 441, "call_id": "sha256:fd4e259625ae41b31cb6cd71", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-05f22381724a0914a4f0ca7b", "kv_state_id": "reset-epoch-023", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": -0.8020954132080079, "marked_response": "De La Guerra Dining Commons is a local business located at 1501 Residential Services in Santa Barbara, CA. It operates as a cafeteria and cafe, offering a range of American (New), sandwich, pizza, and Mexican cuisine. The dining commons has specific operating hours, opening from 21:0 to 0:30 on Monday to Thursday, and from 17:0 to 20:0 on Friday, Saturday, and Sunday.\n\nCustomers have left mixed reviews about De La Guerra Dining Commons. <<CARNOT_FOCUS_START:441:957>>One customer expressed dissatisfaction, mentioning long lines and subpar food, except for the hard-