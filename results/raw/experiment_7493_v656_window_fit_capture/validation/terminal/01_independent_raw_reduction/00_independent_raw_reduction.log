24147, 383, 1844, 471, 424, 1048, 3571, 440, 449, 8800, 426, 499, 154782, 13, 5723, 620, 91521, 11, 864, 557, 21205, 88, 11, 1122, 1114, 310, 36785, 321, 1066, 1538, 786, 13, 220, 1541, 1330, 84743, 11, 279, 55445, 321, 23585, 20149, 11, 864, 1189, 599, 978, 279, 1786, 353, 2908, 995, 13, 8252, 2545, 7458, 303, 24446, 11, 7309, 6718, 1149, 92, 27573, 2374, 3147, 4887, 8934, 271, 65498, 24422, 198, 33, 6846, 2141, 369, 264, 10413, 7172, 506, 220, 16, 15, 16, 19, 15522, 23316, 9254, 303, 15521, 30089, 11, 6824, 13, 561, 10413, 16545, 14382, 33847, 321, 44055, 303, 21803, 13, 1049, 369, 1724, 6796, 1472, 7043, 494, 220, 19, 25, 15, 15, 5670, 310, 220, 23, 25, 18, 15, 5670, 13, 561, 10413, 5891, 15325, 36064, 11, 16712, 25458, 11, 1831, 403, 2519, 11, 321, 369, 14037, 364, 5038, 13, 561, 10413, 682, 2943, 321, 264, 4139, 9467, 383, 4923, 321, 682, 3816, 3679, 6572, 8120, 13, 3648, 5813, 10036, 421, 279, 3487, 557, 524, 279, 4125, 694, 279, 5395, 557, 9766, 11, 632, 800, 3982, 11, 321, 995, 264, 6063, 88, 27817, 4649, 13, 12908, 5813, 9939, 279, 21803, 321, 279, 2393, 11, 321, 24986, 279, 3999, 12551, 321, 33266, 91305, 13, 357, 4688, 5813, 35172, 279, 10413, 579, 17387, 3487, 321, 33266, 16078, 13, 26988, 11, 65309, 2141, 7701, 310, 381, 264, 5243, 321, 1575, 31103, 20318, 10413, 303, 15521, 30089, 13, 271, 55025, 198, 32, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 198, 33, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 14.680633544921875, " B": 15.461926460266113}, "raw_logits_by_option_id": {"contains_unsupported": 15.461926460266113, "supported": 14.680633544921875}, "readout_s": 3.6239000110072084e-05, "request_id": "sha256:e849bd18b9bf079b0a2ee9b9", "requested_score_position": 970, "response_sha256": "sha256:ba29c43df7b424c38f67bdca246dc3c0d50eb895098e893503ff574d960821b6", "response_text": "Bettina is a restaurant located at 1014 Coast Village Road in Santa Barbara, California. The restaurant serves Italian cuisine and specializes in pizza. It is open Monday through Sunday from 4:00 PM to 8:30 PM. The restaurant offers outdoor seating, Wi-Fi, takeout options, and is suitable for groups. The restaurant has four and a half stars on Google and has received several positive reviews. One customer noted that the food was not the issue but the staff was flat, unengaging, and had a stuffy awkward energy. Another customer loved the pizza and the service, and appreciated the easy parking and charming ambiance. A third customer praised the restaurant's delicious food and charming atmosphere. Overall, Bettina appears to be a popular and well-regarded restaurant in Santa Barbara.", "role": "training", "sealed_prompt_sha256": "sha256:9eda12f694124dee34f0a1931a2dc43365e6c26773d40337bc95a3712d729d01", "sealed_prompt_token_count": 971, "sentence_count": null, "sentence_version": null, "source_group_id": "group-749869b78483b77e80fd464a", "source_sha256": "sha256:1548121a0f7db6b0273d57a7f1a09f16983bd52369474828ec553e148872e71b", "source_text": "{\"address\":\"1014 Coast Village Rd\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":true,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":true,\"valet\":true,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":true,\"WiFi\":\"free\"},\"business_stars\":4.5,\"categories\":\"Restaurants, Italian, Pizza\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"16:0-20:30\",\"Monday\":\"0:0-0:0\",\"Saturday\":\"16:0-20:30\",\"Sunday\":\"16:0-20:30\",\"Thursday\":\"16:0-20:30\",\"Tuesday\":\"16:0-20:30\",\"Wednesday\":\"16:0-20:30\"},\"name\":\"Bettina\",\"review_info\":[{\"review_date\":\"2022-01-14 02:46:25\",\"review_stars\":1.0,\"review_text\":\"The hype is over for this place. Local, who used to use this place for everything, and a spot to celebrate girlfriends birthdays. The food was not the issue. The staff is flat, unengaging and silent. You can feel their stuffy awkward energy. As someone who used to be a server myself, I always love being courteous to server staff/tipping well. But man, very hard to do here.\"},{\"review_date\":\"2022-01-10 20:40:01\",\"review_stars\":5.0,\"review_text\":\"Omg I'm a hard core pizza aficionado and this could be my new favorite pizza place in North America. Don't let it's location in the Montecito Country Mart fool you, please make a reservation asap. \\n\\nThe menu is very tight but that's fine. Everyone raves about the carbonara pizza but I hate eggs do we skipped it. We wanted a light lunch to save room for steak dinner so we opted for a bottle of Sancerre, baby gems salad and meat lovers pizza. They all hit perfectly!\\n\\nThe server was terrific. The ambiance felt like a garden getaway and parking was too easy. Please run to this lovely restaurant and grab a matchbox or two for the memories.\"},{\"review_date\":\"2022-01-06 05:51:02\",\"review_stars\":5.0,\"review_text\":\"Decided to check out Bettina during our recent trip to Santa Barbara and boy was it a great experience. The location is random (in the Montecito country mart shopping center) but the inside and the courtyard of the restaurant are charming. And we figured we came to a good spot when we noticed all the locals either dining there or picking up pies. Everything we ordered was delicious! We got the burrata to start, that had this amazing green pistachio/veggie paste on top - it also came with an excellent Focaccia. Broccolini, which was tangy, charred to perfection and just delish.  And two pizzas, the mushroom and pepperoni, which may have been the best I've had. Great little spot in SB, highly recommend.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "M