2, 264, 10412, 314, 220, 18, 13, 20, 9467, 13, 11926, 8120, 1420, 9238, 55203, 13, 4188, 6112, 14952, 279, 46193, 2393, 321, 24719, 16632, 314, 78145, 8405, 321, 9464, 12198, 364, 836, 1831, 403, 9861, 13, 4213, 11, 3672, 3057, 93451, 440, 279, 12293, 314, 3529, 24958, 1040, 279, 1262, 14670, 588, 321, 92466, 354, 35243, 13, 271, 55025, 198, 32, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 198, 33, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 16.447772979736328, " B": 15.473138809204102}, "raw_logits_by_option_id": {"contains_unsupported": 15.473138809204102, "supported": 16.447772979736328}, "readout_s": 3.63689996447647e-05, "request_id": "sha256:6052b90fae0ae0213c258964", "requested_score_position": 850, "response_sha256": "sha256:c01b7fad95e58a327e1e44b5f4847f5a281207e0f9e52034c9c16884efdae11b", "response_text": "California Pasta is a local business located at 811 State St, Ste B, Santa Barbara, CA. It specializes in Italian and American (New) cuisines, and also offers catering, food delivery, and event planning services. The restaurant operates from 11 am to 9 pm daily. It also provides outdoor seating and takeout services but does not accommodate groups or offer free WiFi. It maintains a casual ambience and provides street parking. The business has a rating of 3.5 stars. Customer reviews show mixed sentiments. Some customers appreciate the polite service and adequate provision of utensils and condiments for their takeout orders. However, others express dissatisfaction with the taste of certain dishes like the minestrone and Cajun pasta.", "role": "calibration_tuning", "sealed_prompt_sha256": "sha256:8d4b8729fba26b1fc2c859844bfb50d3eb80f642577fdfeac8c1c20dc6e633f2", "sealed_prompt_token_count": 851, "sentence_count": null, "sentence_version": null, "source_group_id": "group-5b280de190059e51dcc5f884", "source_sha256": "sha256:81e4a94755c14081b9cd65fd8fa61a8f869f323e63d1a801976194fbde476552", "source_text": "{\"address\":\"811 State St, Ste B\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":null,\"romantic\":false,\"touristy\":null,\"trendy\":null,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":false,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":false,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":\"no\"},\"business_stars\":3.5,\"categories\":\"Caterers, Italian, Food Delivery Services, American (New), Event Planning & Services, Restaurants, Food\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"11:0-21:0\",\"Monday\":\"11:0-21:0\",\"Saturday\":\"11:0-21:0\",\"Sunday\":\"11:0-21:0\",\"Thursday\":\"11:0-21:0\",\"Tuesday\":\"11:0-21:0\",\"Wednesday\":\"11:0-21:0\"},\"name\":\"California Pasta\",\"review_info\":[{\"review_date\":\"2022-01-04 04:01:42\",\"review_stars\":4.0,\"review_text\":\"New girl working was very nice tonight for our takeout order! Answered phone politely,  gave us appropriate amount of napkins, utensils and condiments. We felt like valued customers! Thanks\"},{\"review_date\":\"2021-12-24 21:48:07\",\"review_stars\":1.0,\"review_text\":\"The minestrone was aweful. I got a bowl of onion and celery and maybe 3 pieces of pasta. I'm going to go try them again next week because I work close by but the minestrone was not good to me. I know it's usually a hit or miss but this was a complete miss and I had to go buy lunch again else where.\"},{\"review_date\":\"2021-11-29 03:38:23\",\"review_stars\":1.0,\"review_text\":\"Very sad to write this review because I used to love this place. I ordered a Cajun pasta and it tasted sour like vinegar, as if they had poured a whole bottle of Tabasco. I double checked and asked to see if it was Cajun sauce and was reassured it was. I asked if I could get something else because it didn't taste like Cajun sauce. The lady went to ask the manager who said I could buy a new meal with a 10% discount off. Not sure who taught them how to fix a meal.... I had barely eaten it. I asked for a side of sauce because they wouldn't take it back. They brought me a side of Alfredo sauce and it tasted worse. It tasted putrid and awful. Will not be returning...\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.00153314599992882, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 870, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 263, "byte_start": 0, "call_id": "sha256:dac3e534cdc55f6814d567f1", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-5b280de190059e51dcc5f884", "kv_state_id": "reset-epoch-1580", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": -0.5553016662597656, "marked_response": "<<CARNOT_FOCUS_START:0:263>>California Pasta is a local business located at 811 State St, Ste B, Santa Barbara, CA. It specializes in Italian and American (New) cuisines, and also offers catering, food delivery, and event planning services. The restaurant operates from 11 am to 9 pm daily. <<CARNOT_FOCUS_END>>It also provides outdoor seating and takeout services but does not accommodate groups or offer free WiFi. It maintains a casual ambience and provides street parking. The business has a rating of 3.5 stars. Customer reviews show mixed sentiments. Some customers appreciate the polite service and adequate provision