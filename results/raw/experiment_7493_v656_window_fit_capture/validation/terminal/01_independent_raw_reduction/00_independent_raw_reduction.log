987698812e-05, "request_id": "sha256:9201c2ac6bfabcfd79c554e7", "requested_score_position": 684, "response_sha256": "sha256:0600b5a4d9c7b191a233769d29906f1b0124dd1b4935615fe1a5ea6eb9a9ec47", "response_text": "Taco's To Go is a popular Mexican restaurant located in Carpinteria, California. With a 4.0-star rating and rave reviews, this casual, divey spot is a must-visit for anyone looking for delicious, easy-to-get Mexican food in the area. Their menu includes a variety of options, including tacos, burritos, and nachos, all made with fresh, flavorful ingredients. Customers love their large portions and affordable prices, with many mentioning that the nachos and torta are standout items on the menu. The owner is known for being friendly and welcoming, adding to the restaurant's cozy atmosphere. While they don't offer reservations or outdoor seating, Taco's To Go is a great option for those looking for quick, tasty Mexican food.", "role": "training", "sealed_prompt_sha256": "sha256:2ef7b4b4fd49bb73f0d749f9af892166d6addc9c88529fb020a8995f067ab142", "sealed_prompt_token_count": 685, "sentence_count": null, "sentence_version": null, "source_group_id": "group-29380660457d2964ae8e9762", "source_sha256": "sha256:dffb99ed9968510c4add1a3b65ae69e2b52ebb3d6604bce4a8edd328c34996f8", "source_text": "{\"address\":\"794 Linden Ave\",\"attributes\":{\"Ambience\":{\"casual\":null,\"classy\":false,\"divey\":true,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":false,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":false,\"RestaurantsGoodForGroups\":false,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":\"no\"},\"business_stars\":4.0,\"categories\":\"Restaurants, Mexican, Food, Beer, Wine & Spirits\",\"city\":\"Carpinteria\",\"hours\":{\"Friday\":\"8:0-22:0\",\"Monday\":\"8:0-21:0\",\"Saturday\":\"8:0-22:0\",\"Sunday\":\"8:0-21:0\",\"Thursday\":\"8:0-21:0\",\"Tuesday\":\"8:0-21:0\",\"Wednesday\":\"8:0-21:0\"},\"name\":\"Taco's To Go\",\"review_info\":[{\"review_date\":\"2021-03-26 15:07:10\",\"review_stars\":5.0,\"review_text\":\"Best nachos in Carp! I usually get the nachos and my husband will get the torta. Large portions and tastes amazing. Must try if you are looking for easy, to-go Mexican food in the area.\"},{\"review_date\":\"2020-10-25 00:11:25\",\"review_stars\":5.0,\"review_text\":\"You can easily miss this place but it is Amazing. Whenever I visit somewhere I have to find good tacos & these are delicious. They are BIG. Not street tacos. The owner was so sweet, asked where I was from, how I was liking Carpinteria, etc. HIGHLY recommend\"},{\"review_date\":\"2020-07-28 21:24:56\",\"review_stars\":5.0,\"review_text\":\"Coming here for three years and still love it! Great drink selection and the steak is always cooked perfectly\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.001377128000058292, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 704, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 234, "byte_start": 0, "call_id": "sha256:8e3e6c8ad6e35752ae93ee64", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-29380660457d2964ae8e9762", "kv_state_id": "reset-epoch-230", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 3.3112945556640625, "marked_response": "<<CARNOT_FOCUS_START:0:234>>Taco's To Go is a popular Mexican restaurant locate