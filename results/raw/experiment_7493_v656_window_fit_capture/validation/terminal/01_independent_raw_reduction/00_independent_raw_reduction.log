98, 10181, 15883, 42485, 579, 2716, 37671, 198, 46093, 42485, 557, 15750, 1083, 780, 2234, 383, 279, 220, 16, 20, 337, 25029, 13, 1216, 9919, 430, 279, 220, 20, 20, 16402, 63265, 314, 279, 3516, 4042, 4526, 314, 38428, 494, 5869, 310, 6324, 220, 17, 15, 17, 18, 13, 198, 24484, 40206, 3125, 24286, 7348, 11129, 551, 1000, 524, 1542, 1495, 364, 18040, 13, 2532, 369, 874, 7783, 32453, 310, 2895, 279, 4526, 9078, 8421, 13, 357, 1844, 42485, 29842, 11, 3212, 13, 19026, 4335, 61224, 11, 423, 10923, 707, 2487, 557, 6725, 18040, 453, 2643, 451, 11, 310, 8418, 303, 279, 4998, 328, 1891, 279, 854, 1602, 1, 2980, 264, 491, 18040, 369, 11543, 13, 271, 65498, 24422, 198, 40087, 12617, 11068, 22409, 15750, 310, 5724, 267, 4526, 28124, 15883, 42485, 11, 852, 557, 6747, 494, 780, 2234, 383, 6324, 220, 18, 11, 220, 17, 15, 17, 18, 11, 440, 264, 6695, 314, 220, 17, 16, 21, 310, 220, 17, 16, 15, 13, 561, 22409, 852, 15750, 310, 5724, 267, 42485, 998, 36145, 9523, 11, 28681, 13841, 273, 636, 276, 11, 3554, 81300, 11564, 46418, 11, 4179, 417, 33230, 11, 28681, 457, 419, 263, 11, 321, 87853, 17672, 8354, 13, 42485, 579, 16162, 557, 4016, 310, 780, 36210, 310, 2485, 321, 6639, 314, 11109, 888, 780, 9524, 11, 3956, 310, 13841, 273, 636, 276, 13, 1216, 9919, 430, 279, 220, 20, 20, 337, 28124, 314, 279, 3516, 4042, 4526, 314, 38428, 494, 5869, 310, 6324, 220, 17, 15, 17, 18, 13, 271, 55025, 198, 32, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 198, 33, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 17.3548526763916, " B": 13.843371391296387}, "raw_logits_by_option_id": {"contains_unsupported": 13.843371391296387, "supported": 17.3548526763916}, "readout_s": 3.557600030035246e-05, "request_id": "sha256:c5ab97fb4f368714a7e75318", "requested_score_position": 801, "response_sha256": "sha256:7203b05dc4733af17e920dc220bf43015006959cd8323847bee2ea1c6012ca46", "response_text": "Six Virginia Democratic representatives voted to oust House Speaker Kevin McCarthy, who was removed from his position on October 3, 2023, with a vote of 216 to 210. The representatives who voted to oust McCarthy were Bobby Scott, Jennifer McClellan, Abigail Spanberger, Don Beyer, Jennifer Wexton, and Gerry Connolly. McCarthy's removal was due to his inability to govern and lack of leadership over his conference, according to McClellan. He served as the 55th Speaker of the United States House of Representatives from January to October 2023.", "role": "calibration_tuning", "sealed_prompt_sha256": "sha256:f80b3b4fe43046d0ce99fd210128d2570cad8989336b572c6dd5521852116cab", "sealed_prompt_token_count": 802, "sentence_count": null, "sentence_version": null, "source_group_id": "group-701b34bea3fd105ff7046c5c", "source_sha256": "sha256:f7baea2bfa508920596066348fab43138beba52cee7b1c2dc5c688959662b44a", "source_text": "Six Virginia Democratic Representatives voted to oust Speaker Kevin McCarthy\nKevin McCarthy is no longer the Speaker of the House. He was the first Speaker of the House to be removed from that position by a House vote. His short term as Speaker of the House came to an end on Tuesday, October 3, 2023, after less than a year in that position.\nThe House voted 216 to 210 to remove McCarthy. Members of his own party along with six Virginia Democrats helped to vote him out.\nReasons to remove McCarthy\nRepresentative Matt Gaetz, R-Florida, introduced the measure to remove McCarthy on Monday night, two days after the Speaker brought a measure to the House floor to avert a shutdown and keep the government open for 45 additional days.\nGaetz asserted that McCarthy reneged on some of the promises he made in January before he was elected to be the Republican Speaker of the House.\nRepresentative Bob Good, R-5th, a Virginia member of McCarthy's own party, joined the delegation's six Democrats to remove McCarthy from his position.\nGood asserted in a floor speech Tuesday that McCarthy was more interested in remaining Speaker of the House than in cutting spending.\nGood said:\n\"The Speaker this past Friday in the Republican conference meeting made it abundantly clear that he was willing to do anything to avoid the temporary discomfort and the pressure of a pause in the 15% of nonessential federal government operations, which would guarantee that we would lose to the Senate Democrats and the White House.\"\nVirginia Democrats who voted to oust McCarthy\nThe six Democratic Representatives in Virginia's delegation who voted to oust McCarthy:\nBobby Scott, D-3rd\nJennifer McClellan, D-4th\nAbigail Spanberger, D-7th\nDon Beyer, D-8th\nJennifer Wexton, D-10th\nGerry Connolly, D-11th\nMcClellan said in a statement:\n\u201cToday is a solemn day for the House of Representatives, as Kevin McCarthy became the first speaker to be removed from his leadership position through a motion to vacate. Since day one of the 118th Congress, McCarthy has shown an inability to govern, a lack of leadership over his conference, and an unwillingness to focus on the issues that matter to the American people.\nAbout Kevin McCarthy's short tenure\nKevin McCarthy was voted into his position on the 15th ballot. He served as the 55thspeaker of the United States House of Representatives from January to October 2023.\nMcCarthy told lawmakers Tuesday evening he would not run again for speaker. There is no obvious successor to lead the House Republican majority. A top McCarthy ally, Rep. Patrick McHenry, R-N.C., was named speaker pro tempore, to serve in the office \"for the time being\" until a new speaker is chosen.", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0015999319994079997, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 821, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 165, "byte_start": 0, "call_id": "sha256:c3659f3b8d9a7d969d819875", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-701b34bea3fd105ff7046c5c", "kv_state_id": "reset-epoch-1606", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": -2.5681324005126953, "marked_response": "<<CARNOT_FOCUS_START:0:165>>Six Virginia Democratic representatives voted to oust House Speaker Kevin McCarthy, who was removed from his position on October 3, 2023, with a vote of 216 to 210. <<CARNOT_FOCUS_END>>The representatives who voted to oust McCarthy were Bobby Scott, Jennifer McClellan, Abigail Spanberger, Don Beyer, Jennifer Wexton, and Gerry Connolly. McCarthy's removal was due to his inability to govern and lack of leadership over his conference, according to McClellan. He served as the 55th Speaker of the United States House of Representatives from January to October 2023.", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["supported", "contains_unsupported"], "order_remapping": {" A": "supported", " B": "contains_unsupported"}, "prefill_s": 0.9897742129996914, "probabilities_by_option_id": {"contains_unsupported": 0.07121773901363017, "supported": 0.9287822609863698}, "prompt_sha256": "sha256:edbe9c3a49b2bafe4519755116d152fcea048f400bd61894c48bcf31943bfc70", "prompt_token_count": 822, "prompt_token_ids": [1890, 1386, 1761, 364, 279, 4434, 1965, 1608, 1132, 279, 16713, 2450, 13, 271, 41578, 198, 40087, 12617, 11068, 38428, 15750, 310, 5724, 267, 28124, 15883, 42485, 198, 46093, 42485, 369