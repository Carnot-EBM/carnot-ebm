14.987284660339355, " B": 14.390220642089844}, "raw_logits_by_option_id": {"contains_unsupported": 14.987284660339355, "supported": 14.390220642089844}, "readout_s": 5.5884999710542616e-05, "request_id": "sha256:186f4d30008a689dd568dc15", "requested_score_position": 997, "response_sha256": "sha256:ee049fa71968c02de85a074b85e75588bd471ccdc8a61a16fb5a8c82a26eceff", "response_text": "Spiritland Bistro is a local restaurant located at 230 E Victoria St in Santa Barbara, CA. The restaurant offers a wide variety of cuisines including Vegetarian, French, Vegan, Seafood, Asian Fusion, Gluten-Free, and American (New). It has received an average rating of 4.0 stars from customers.\n\nThe restaurant is open from 5:30 PM to 9:00 PM on Tuesday to Thursday, and from 5:30 PM to 10:00 PM on Friday and Saturday. On Sundays, it is open from 5:30 PM to 9:00 PM. The availability of outdoor seating and the option for takeout are provided. The restaurant also accepts reservations.\n\nCustomers have praised Spiritland Bistro for its vegan options. One customer mentioned that it was one of the best vegan meals they had ever had, highlighting the restaurant's imagination and the quality of the four-course meal. However, another customer felt underwhelmed by the ambience and thought the food was only okay for the price.\n\nIt is important to note that one customer mentioned that the restaurant is currently closed until further notice.", "role": "training", "sealed_prompt_sha256": "sha256:3e8901ffceb0438c676a19a960c2017509952720eaebac2fb40e3ef4e25e8067", "sealed_prompt_token_count": 998, "sentence_count": 5, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-183bd5835625c984d7421225", "source_sha256": "sha256:b525a747c3fd7b328ec0d10f511f215bcb10bf25fa2200ccf38305e975cad318", "source_text": "{\"address\":\"230 E Victoria St\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":false,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":false,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":true,\"WiFi\":\"no\"},\"business_stars\":4.0,\"categories\":\"Restaurants, Vegetarian, French, Vegan, Seafood, Asian Fusion, Gluten-Free, American (New)\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"17:30-22:0\",\"Saturday\":\"17:30-22:0\",\"Sunday\":\"17:30-21:0\",\"Thursday\":\"17:30-21:0\",\"Tuesday\":\"17:30-21:0\",\"Wednesday\":\"17:30-21:0\"},\"name\":\"Spiritland Bistro\",\"review_info\":[{\"review_date\":\"2012-08-02 01:04:35\",\"review_stars\":5.0,\"review_text\":\"im very honest with these reviews- look at my other ones. i'm not going to make excuses for places but im also not going to forget to appreciate the little things... and this was one of the best vegan meals i have ever had... EVER had... they are not even entirely vegan which is the shocker- as most non vegan places believe a plate full of vegetables is what us vegans eat.. this place was truly imaginative, and provided me with a perfect four course meal..  yes, i, Shirley, said perfect... a rare thing indeed.\\ni really wanted to have this place cater my wedding, the second i realized every bite i had was magical, i was truly obsessed with the idea of them catering my wedding- and now that i'm planning it... they're gone. so sad.\\n\\nwish places like this stayed open.... this and pure luck in silverlake... COME BACK PLEASE!\"},{\"review_date\":\"2012-03-01 05:20:25\",\"review_stars\":2.0,\"review_text\":\"we'd been wanting to try this place for awhile... but when we finally did - underwhelmed.  the ambience would not have been so bad were there some music or lower lighting, but couldn't help but think, \\\"i'm in a small room with 20 other people we don't know\\\".  the food itself was ok, but not a special night out.  for $10 bucks a plate i would have gone back, but for $20 i'll go elsewhere.\"},{\"review_date\":\"2011-12-31 16:54:19\",\"review_stars\":4.0,\"review_text\":\"I called to make reservations for new years eve- this place is closed until further notice FYI. Not sure when they are planning to re-open.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0016839150002851966, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 1, "window_sha256": "sha256:5168ce18fef8bc013b0fa8cf870d08cadc693bcb164c0e3ff44e878404b50eb9", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 998, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 1042, "byte_start": 653, "call_id": "sha256:b03fb1e32c18467ace96e659", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-183bd5835625c984d7421225", "kv_state_id": "reset-epoch-156", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": 0.887375831604004, "marked_response": "Spiritland Bistro is a local restaurant located at 230 E Victoria St in Santa Barbara, CA. The restaurant offers a wide variety of cuisines including Vegetarian, French, Vegan, Seafood, Asian Fusion, Gluten-Free, and American (New). It has received an average rating of 4.0 stars from customers.\n\nThe restaurant is open from 5:30 PM to 9:00 PM on Tuesday to Thursday, and from 5:30 PM to 10:00 PM on Friday and Saturday. On Sundays, it is open from 5:30 PM to 9:00 PM. The availability of outdoor seating and the option for takeout are provided. The restaurant also accepts reservations.\n\nCustomers have pr