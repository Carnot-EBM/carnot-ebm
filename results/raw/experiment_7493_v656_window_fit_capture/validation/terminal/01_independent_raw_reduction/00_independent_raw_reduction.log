036, 421, 279, 10413, 628, 615, 12655, 11, 748, 424, 579, 10779, 310, 615, 678, 1906, 303, 3988, 310, 5471, 264, 1248, 3655, 854, 13, 21708, 11, 1010, 57043, 599, 9444, 421, 279, 10413, 579, 3979, 513, 6973, 11, 694, 279, 3487, 369, 5621, 279, 3655, 13, 26988, 11, 9807, 7671, 369, 264, 2172, 7458, 364, 21803, 31059, 3221, 364, 264, 17387, 321, 12826, 14704, 13, 271, 55025, 198, 32, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 198, 33, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 13.894373893737793, " B": 16.590438842773438}, "raw_logits_by_option_id": {"contains_unsupported": 16.590438842773438, "supported": 13.894373893737793}, "readout_s": 3.653800013125874e-05, "request_id": "sha256:c96b5e2c8a1cb9e6e6dd316a", "requested_score_position": 771, "response_sha256": "sha256:f9d3bfc1c0c3eb5d121a55b5c9e53c7bf29a51f1db824347e036287c124d4acf", "response_text": "Revolver is a popular pizza restaurant located in Santa Barbara, CA, known for its handmade crust and fresh toppings. The restaurant has a casual and trendy atmosphere, with outdoor seating available. They offer take-out and delivery options, and their menu includes a variety of pizzas and salads. The restaurant is well-loved by locals and visitors alike, with many reviewers praising the quality of the food and the friendly service. Some reviewers have noted that the restaurant can get busy, so it's recommended to get your order in early to avoid a long wait time. Additionally, some reviewers have mentioned that the restaurant's hours are limited, but the food is worth the wait. Overall, Revolver is a great spot for pizza lovers looking for a delicious and authentic meal.", "role": "calibration_tuning", "sealed_prompt_sha256": "sha256:d75d8e0a344ec32c01a6ec6a4af6d0e2fc9fea51e49d6ff073e8e830bbd3bc18", "sealed_prompt_token_count": 772, "sentence_count": null, "sentence_version": null, "source_group_id": "group-9d98df2154da09a45fd30bf6", "source_sha256": "sha256:49ba4a52515a53634b42747d116f23b7241eaa4e032bb637a3f66e07ffc2ce27", "source_text": "{\"address\":\"1429 San Andres St\",\"attributes\":{\"Ambience\":{\"casual\":null,\"classy\":null,\"divey\":true,\"hipster\":null,\"intimate\":null,\"romantic\":null,\"touristy\":null,\"trendy\":true,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":false,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":null,\"RestaurantsReservations\":null,\"RestaurantsTakeOut\":true,\"WiFi\":\"free\"},\"business_stars\":4.5,\"categories\":\"Restaurants, Pizza\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"16:0-22:0\",\"Saturday\":\"16:0-22:0\",\"Sunday\":\"16:0-22:0\",\"Thursday\":\"16:0-22:0\",\"Wednesday\":\"16:0-22:0\"},\"name\":\"Revolver\",\"review_info\":[{\"review_date\":\"2022-01-06 20:15:13\",\"review_stars\":5.0,\"review_text\":\"Nothing derails my good intentions of starting a diet like a Revolver Pizza craving! It's absolutely the BEST!! Beautifully handmade crust and fresh toppings. Not fancy just delicious. And the salads are incredible. Best Caesar with real anchovy dressing. Market salad has yummy dill ranch, shaved vegetables on yummy lettuce. I don't love the atmosphere, so we always get it to go. It's super popular so get your order in early! But it's definitely our favorite pizza in SB.\"},{\"review_date\":\"2022-01-01 06:13:46\",\"review_stars\":4.0,\"review_text\":\"Great pizza but limited toppings odd hours and long wait time for food.\\n\\nThey really should open at 11am like any other normal pizza place.\"},{\"review_date\":\"2021-12-20 02:58:37\",\"review_stars\":5.0,\"review_text\":\"Hands down the best dang pizza in all of Santa Barbara. Not even close. Simple menu and from the crisp on the crust and bottom to the tang in the red sauce, SB you have a winner. It's artisan pizza meets NY on the west coast. Proves you don't need to be in the funk zone to have something great and feels like Brooklyn back 20\\nYears ago in the fact that they are hip but hard working and making something great. The Caesar salad had a great dressing and fresh greens to boot.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0021891480000704178, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 791, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 299, "byte_start": 0, "call_id": "sha256:135bb3b159b1528bae35c387", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-9d98df2154da09a45fd30bf6", "kv_state_id": "reset-epoch-1668", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 1.2994203567504883, "marked_response": "<<CARNOT_FOCUS_START:0:299>>Revolver is a popular pizza restaurant located in Santa Barbara, CA, known for its handmade crust and fresh toppings. The restaurant has a casual and trendy atmosphere, with outdoor seating available. They offer take-out and delivery options, and their menu includes a variety of pizzas and salads. <<CARNOT_FOCUS_END>>The restaurant is well-loved by locals and visitors alike, with many reviewers praising the quality of the food and the friendly service. Some reviewers have noted that the restaurant can get busy, so it's recommended to get your order in early to avoid a long wait time. Additionally, some reviewers have mentioned that the restaurant's hours are limited, but the food is worth the wait. Overall, Revolver 