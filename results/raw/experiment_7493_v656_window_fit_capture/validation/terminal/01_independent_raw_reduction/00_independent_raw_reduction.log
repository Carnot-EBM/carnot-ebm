, 11, 28196, 11, 321, 36120, 12217, 2519, 13, 21708, 11, 6112, 599, 10036, 421, 279, 10413, 1503, 524, 6545, 449, 685, 13492, 364, 2397, 1676, 21263, 13671, 11, 864, 369, 264, 5243, 4416, 4082, 1782, 852, 513, 48841, 930, 69195, 505, 466, 10386, 524, 310, 16300, 310, 279, 32274, 4797, 13, 4213, 11, 1010, 6112, 599, 995, 7968, 11120, 440, 279, 10413, 11, 2583, 1248, 3655, 2942, 321, 7604, 5813, 2393, 13, 3648, 5813, 4800, 8996, 264, 6655, 303, 836, 3162, 3884, 11, 864, 557, 36862, 13, 26988, 11, 5805, 46544, 25245, 3422, 321, 13207, 64, 39681, 505, 18767, 7701, 310, 381, 264, 5243, 321, 16219, 2904, 364, 1782, 3221, 364, 5819, 5792, 11, 28196, 11, 321, 36120, 12217, 20329, 11, 430, 1575, 430, 10482, 321, 14799, 13, 271, 55025, 198, 32, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 198, 33, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 13.712203025817871, " B": 15.936677932739258}, "raw_logits_by_option_id": {"contains_unsupported": 15.936677932739258, "supported": 13.712203025817871}, "readout_s": 5.3019000006315764e-05, "request_id": "sha256:ccfe3a923cde4344cb8d4038", "requested_score_position": 1102, "response_sha256": "sha256:f36e8ea834cae71cfb7bc7f55f5956deac8f9d0e8ddb7d8e6aa03a93051341f2", "response_text": "Goleta Coffee Co and Loca Vivant Kitchen is a restaurant located at 177 S Turnpike Rd in Santa Barbara, California. The business offers a variety of services such as breakfast, brunch, lunch, sandwiches, bagels, coffee, tea, and gluten-free options. The restaurant has outdoor seating and free Wi-Fi. The restaurant is open from Monday to Sunday, from 7 am to 5 pm. The business has a rating of 4.0 stars on Google, based on 6 reviews. Customers have praised the restaurant for its friendly service, delicious options, and commitment to providing plant-based, vegan, and gluten-free options. Additionally, customers have noted that the restaurant does not charge an upcharge for non-dairy milk, which is a popular feature among those who are lactose intolerant or prefer not to contribute to the dairy industry. However, some customers have had negative experiences with the restaurant, including long wait times and poor customer service. One customer reported finding a hair in their pastries, which was disappointing. Overall, Goleta Coffee Co and Loca Vivant Kitchen appears to be a popular and convenient option for those looking for plant-based, vegan, and gluten-free meals, as well as coffee and tea.", "role": "training", "sealed_prompt_sha256": "sha256:059bf11ea40ca635690120719e8f270db5df110782156f6775dbd50019b4e4c3", "sealed_prompt_token_count": 1103, "sentence_count": null, "sentence_version": null, "source_group_id": "group-ed91216e725220f112506ebb", "source_sha256": "sha256:569394cfe571cb7883e10c2b094db5fd295dfd447d710b6d6dd52e96a1e1c9f2", "source_text": "{\"address\":\"177 S Turnpike Rd\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":false,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":\"free\"},\"business_stars\":4.0,\"categories\":\"Restaurants, Coffee & Tea, Breakfast & Brunch, Gluten-Free, Food, Sandwiches, Bagels\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"7:0-15:0\",\"Monday\":\"0:0-0:0\",\"Saturday\":\"7:0-15:0\",\"Sunday\":\"7:0-15:0\",\"Thursday\":\"7:0-13:0\",\"Tuesday\":\"7:0-15:0\",\"Wednesday\":\"7:0-15:0\"},\"name\":\"Goleta Coffee Co and Loca Vivant Kitchen\",\"review_info\":[{\"review_date\":\"2022-01-09 17:45:28\",\"review_stars\":5.0,\"review_text\":\"Warm inviting locals cafe.  Especially great if you want plant-based, vegan, gluten-free options. They really aim to please. This place is always a favorite in part because of the commitment to offering many options and no up charge for non-cow pus milk. \\n\\nAlso a thank you shout  out to the staff like Carly. You can appreciate her smile through her eyes. They really know service even though you order and usually pick it up at the counter, but they will bring it to you as well sometimes. \\n\\nThey've got a lot of super food lattes. There's outdoor seating and shade or sun. They leave the doors open so there's good airflow. And there's also wonderful shirts on the wall honoring first responders and celebrating different fire stations.\\n\\nThey have fresh soup of the day and seasonal additions to the menu. We've had about three different types of the avocado toast. Today I had the savory seed one which was delicious and I feel so healthy after indulging in it\"},{\"review_date\":\"2022-01-08 19:28:43\",\"review_stars\":1.0,\"review_text\":\"used to love it here before the menu changed but I stopped in today just for 2 pastries and ended up waiting 8 minutes. Usually no issue with waiting I understand rushes especially in coffee shops but I didn't order coffee so it kind of made me feel like they didn't keep a good track of orders. I had to ask someone about my order and she said \\\"oh they forgot\\\" and directed me to the bakery end. My only issue is that once I asked , they had attitude and quickly handed my order to me & then I found a hair in my pastries. Sooo disappointed in customer service and just baffled in the way they handled forgetting my order.  won't be going back any time soon\"},{\"review_date\":\"2021-12-30 21:23:48\",\"review_stars\":5.0,\"review_text\":\"1. Friendly service.\\n2. Lots of delicious options that are plant-based. Take a look at all the different specialty Taos.\\n3. And no up charge for nondairy milk crate I love that. It's so great that they don't penalize people who are lactose intolerant. Or if you choose not to contribute to the dairy industry.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0019817129996226868, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 1122, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 397, "byte_start": 0, "call_id": "sha256:f1067c6f2adb1a3e47e37590", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-ed91216e725220f112506ebb", "kv_state_id": "reset-epoch-1314", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 2.0134172439575195, "marked_response": "<<CARNOT_FOCUS_START:0:397>>Goleta Coffee Co and Loca Vivant Kitchen is a restaurant located at 177 S Turnpike Rd in Santa Barbara, California. The business offers a variety of services such as breakfast, brunch, lunch, sandwiches, bagels, coffee, tea, and gluten-free options. The restaurant has outdoor seating and free Wi-Fi. The restaurant is open from Monday to Sunday, from 7 am to 5 pm. The business has a rating of 4.<<CARNOT_FOCUS_END>>0 stars on Google, based on 6 reviews. Customers have praised the restaurant for its friendly service, delicious options, and commitment to providing plant-based, vegan, and gluten-free options. Additionally, customers have noted that the restaurant does not charge an upcharge for non-dairy milk, which is a popular feature among those who are lactose intolerant or prefer not to contribute to the dairy industry. However, some customers have had negative experiences with the restaurant, including long wait times and poo