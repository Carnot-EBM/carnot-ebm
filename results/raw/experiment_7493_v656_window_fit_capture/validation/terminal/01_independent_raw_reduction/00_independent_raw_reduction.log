21, 70725, 3498, 998, 18035, 13, 24235, 599, 10036, 421, 279, 3487, 4131, 557, 5289, 11, 321, 421, 1017, 3105, 914, 2714, 310, 381, 866, 7478, 13565, 1429, 303, 836, 24958, 13, 4213, 11, 1010, 6112, 599, 35172, 279, 91305, 321, 2393, 506, 22984, 579, 414, 10140, 11, 21988, 424, 430, 55890, 321, 4101, 13, 26988, 11, 22984, 579, 414, 10140, 7701, 310, 381, 264, 15855, 17378, 2904, 364, 7529, 3221, 364, 264, 3841, 14704, 13, 271, 55025, 198, 32, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 198, 33, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 17.430646896362305, " B": 10.896340370178223}, "raw_logits_by_option_id": {"contains_unsupported": 17.430646896362305, "supported": 10.896340370178223}, "readout_s": 3.5536999348551035e-05, "request_id": "sha256:083d1373f97c6cc3aba9a026", "requested_score_position": 892, "response_sha256": "sha256:679df2d90a9055f5a53f69fe5260fab1adadde0928e95f1bdab66dc354a30ead", "response_text": "Ruby's Diner is a restaurant located at 601 Paseo Nuevo in Santa Barbara, California. They are open for business during regular operating hours, but their specific hours are not available online. Ruby's Diner serves a variety of foods such as burgers, sandwiches, salads, and desserts. They offer takeout services, but they do not provide outdoor seating or Wi-Fi. Customers can park their cars in the street, garage, lot, or valet area, although validated parking options are not available. Ruby's Diner has an average rating of 3.5 stars on Google, based on customer reviews. Some customers have complained about the cleanliness of the restaurant, stating that the floors, tables, counter, and salsa bar were dirty. Others have noted that the food quality was average, and that there didn't seem to be any fresh ingredients used in their dishes. However, some customers have praised the ambiance and service at Ruby's Diner, describing it as trendy and clean. Overall, Ruby's Diner appears to be a casual dining option for individuals looking for a quick meal.", "role": "training", "sealed_prompt_sha256": "sha256:60baeca9f720a8357d9471ca845ad416b55b7dd04ee9e84f0058c03af3b2d7d3", "sealed_prompt_token_count": 893, "sentence_count": null, "sentence_version": null, "source_group_id": "group-177bb8068f895cd4d49db911", "source_sha256": "sha256:72d394a07f0af88f6e0424156ffae29617da7d9e9f57801dcbf1b8f2e8963f1d", "source_text": "{\"address\":\"601 Paseo Nuevo\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":false,\"street\":false,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":null,\"RestaurantsGoodForGroups\":false,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":\"no\"},\"business_stars\":3.5,\"categories\":\"Restaurants\",\"city\":\"Santa Barbara\",\"hours\":null,\"name\":\"Ruby's Diner\",\"review_info\":[{\"review_date\":\"2011-04-14 00:50:08\",\"review_stars\":2.0,\"review_text\":\"Where do the good reviews come from?\\n\\nDirty floors, tables, counter and salsa bar.Yuck.\\nNot sure if anything is fresh other than the cilantro. \\nThe Three Amigo burrito is as big as three friends but the inside is more like shoe letter. Packed with dry chicken and steak that could have been sitting for days. At least simmer in juices so it's softer. This puppy is as dry as the Mexican desert. The shrimp was ok and it was nice the rice was light. Definitely needed drowning from the salsa bar to help it down.\\n\\nNothing impressed me and I don't know what kind of repeat business Rubys gets. It wont be from me.\"},{\"review_date\":\"2008-09-04 16:03:53\",\"review_stars\":3.0,\"review_text\":\"It's a diner.  Our hotel gave us a map with restaurants and things to see and do in Santa Barbara.  I read about this diner.  The map said it was a 1940's diner.  SO OF COURSE WE HAD TO GO!  But, it was not. \\n\\nIt's one of those chain diners with new but vintage looking decor. \\n\\nI had a cheeseburger, Gary had a tuna melt.  The food was average diner food.  Not bad, not fantastic. \\n\\nGary knew I was sad that it wasn't a 1940's diner and he pointed out a sign that said Independently Operated. That made me feel a little better.\"},{\"review_date\":\"2008-07-24 21:58:55\",\"review_stars\":4.0,\"review_text\":\"It's a diner.  Come for a burger, fries, and a shake.  Food isn't too greasy and it's always satisfying.  The place is clean and service isn't bad.  Kind of expensive, but my stomach doesn't complain.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0016031830000429181, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 912, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 365, "byte_start": 0, "call_id": "sha256:e0f5f6a313f786ebb194aeb6", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-177bb8068f895cd4d49db911", "kv_state_id": "reset-epoch-138", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": 6.223475456237793, "marked_response": "<<CARNOT_FOCUS_START:0:365>>Ruby's Diner is a restaurant located at 601 Paseo Nuevo in Santa Barbara, California. They are open for business during regular operating hours, but their specific hours are not available online. Ruby's Diner serves a variety of foods such as burgers, sandwiches, salads, and desserts. They offer takeout services, but they do not provide outdoor seating or Wi-Fi. <<CARNOT_FOCUS_END>>Customers can park their cars in the street, garage, lot, or valet area, although validated parking options are not available. Ruby's Diner has an average rating of 3.5 stars on Google, based on customer reviews. Some customers have complained about the cleanliness of the restaurant, stating that the floors, tables, counter, and salsa bar were dirty. Others have noted that the food quality was average, and that there didn't seem to be any fresh ingredients used in their dishes. However, some customers have praised the ambiance and service at Ruby's Diner, describing it as trendy and clean. Overall, Ruby's Diner appears to be a casual dining option for individuals looking for a quick meal.", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["contains_unsupported", "supported"], "order_remapping": {" A": "contains_unsupported", " B": "supported"}, "prefill_s": 1.0988421149995702, "probabilities_by_option_id": {"contains_unsupported": 0.9980215782293941, "supported": 0.0019784217706058987}, "prompt_sha256": "sha256:62bc4b9a6d3dae61bd260d367e9c8037c6acc69eb7b353ef7555e07d5d056b50", "prompt_token_count": 913, "prompt_token_ids": [1890, 1386, 1761, 364, 279, 4434, 1965, 1608, 1132, 279, 16713, 2450, 13, 271, 41578, 198, 4754, 4834, 3147, 21, 15, 16, 227208, 78, 84731, 2129, 11987, 21624, 52218, 1772, 21624, 23543, 899, 763, 3721, 1288, 1005, 88, 763, 3721, 1288, 67, 520, 88, 763, 3721, 1288, 92670, 763, 3721, 1288, 390, 3316, 763, 3721, 1288, 433, 7902, 763, 3721, 1288, 49612, 84507, 763, 3721, 1288, 237419, 88, 763, 3721, 1288, 8339, 2174, 763, 3721, 49471, 22020, 91061, 21624, 11816, 416, 763, 3721, 1288, 8911, 763, 3721, 1288, 26466, 763, 3721, 1288, 6378, 1112, 763, 3721, 1288, 57576, 