e_count": null, "sentence_version": null, "source_group_id": "group-994dd56cfba6dea8c08fb377", "source_sha256": "sha256:1321ea12c461a3b0eda3efdb129e081cab28213294776668c976aebf3ccb6c18", "source_text": "{\"passages\":\"passage 1:Whip the butter with a whisk until it is fluffy. Slowly pour in 1/2 cup of real maple syrup, whipping the whole time you are pouring. When the syrup is completely mixed in with the butter, stir in 1/4 cup of chopped pecans. Split your baked sweet potatoes in half while they are still hot.\\n\\npassage 2:1 Don't preheat the oven. 2  Prick your sweet potatoes each 2-3 time with a fork, then place them directly on the oven rack in the middle of the oven, above the foil. 3  Turn the oven on to 425. 4  Bake for 45 minutes for sweet potatoes/yams that are 2-3 inches in diameter.\\n\\npassage 3:Sweet potatoes are chock full of beta-carotene, antioxidants, and fiber. They are a great source of manganese and vitamins B6, C, and E. One cup of cubed sweet potatoes is 114 calories, 4 grams of fiber, 2 grams of protein, 27g of carbs, and 6g sugar.\\n\\n\",\"question\":\"how to eat a sweet baked potato\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0008504290008204407, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 419, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 100, "byte_start": 0, "call_id": "sha256:6883f2772bb10bf7f9e43b15", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-994dd56cfba6dea8c08fb377", "kv_state_id": "reset-epoch-828", "label_to_option_id": {" A": "supported", " 