0, 430, 232963, 20575, 13, 9988, 382, 599, 35172, 279, 4131, 314, 279, 3487, 321, 279, 11321, 2393, 13, 4188, 599, 1048, 10036, 421, 279, 10413, 628, 615, 12655, 2261, 15686, 3979, 11, 694, 279, 15325, 36064, 2982, 5529, 264, 24832, 321, 22735, 16078, 13, 26988, 11, 4770, 197561, 190577, 41358, 7701, 310, 381, 264, 5243, 321, 30062, 17378, 2904, 364, 1782, 3221, 364, 12826, 22555, 33847, 303, 264, 29378, 6047, 13, 271, 55025, 198, 32, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 198, 33, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 13.740278244018555, " B": 16.354360580444336}, "raw_logits_by_option_id": {"contains_unsupported": 16.354360580444336, "supported": 13.740278244018555}, "readout_s": 3.409400051168632e-05, "request_id": "sha256:574a457f99b202e455f78826", "requested_score_position": 890, "response_sha256": "sha256:146de65887e4b4568ca602cab731f95d630851f2e0e489eb6c5d6d55bade2f3a", "response_text": "La Playa Azul Cafe is a Mexican restaurant located at 914 Santa Barbara St in Santa Barbara, CA. They offer outdoor seating and take reservations. Their menu includes tacos, burritos, and other Mexican dishes, as well as drinks such as margaritas. Reviewers have praised the quality of the food and the friendly service. Some have also noted that the restaurant can get busy during peak hours, but the outdoor seating area provides a peaceful and romantic atmosphere. Overall, La Playa Azul Cafe appears to be a popular and enjoyable dining option for those looking for authentic Mexican cuisine in a relaxed setting.", "role": "training", "sealed_prompt_sha256": "sha256:e6013005181c92d5e38a1dbf11fb826707e317d661fc1ab6411a563587c02724", "sealed_prompt_token_count": 891, "sentence_count": null, "sentence_version": null, "source_group_id": "group-7a7c5676117cb8e03905eec5", "source_sha256": "sha256:cd2367f3445ac6c1086b4162599672f7ab89401a36e8b96326752e5dd9e3a487", "source_text": "{\"address\":\"914 Santa Barbara St\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":null,\"romantic\":null,\"touristy\":false,\"trendy\":null,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":false,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":true,\"WiFi\":\"no\"},\"business_stars\":4.0,\"categories\":\"Mexican, Restaurants\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"11:0-21:0\",\"Saturday\":\"11:0-21:0\",\"Sunday\":\"11:0-20:0\",\"Thursday\":\"11:0-20:0\",\"Tuesday\":\"11:0-20:0\",\"Wednesday\":\"11:0-20:0\"},\"name\":\"La Playa Azul Cafe\",\"review_info\":[{\"review_date\":\"2022-01-08 15:16:07\",\"review_stars\":5.0,\"review_text\":\"I thought this was a tourist trap. \\n\\nWe were pleasantly surprised by this place. We sat outside under the trees while drinking amazing margaritas and having an amazingly delicious taco platter.  \\n\\nThe service was excellent!\\n\\nI will definitely go back here.\"},{\"review_date\":\"2021-11-13 21:20:16\",\"review_stars\":4.0,\"review_text\":\"A quaint, semi-upscale, casual restaurant with outdoor seating. They have an extensive menu, and the best time to go for the best prices would be happy hour, between 3 - 6pm. The food is relatively clean if you order something grilled. The service is a tad slow, because the servers are overworked and busy. I appreciate the hand sanitizer on every table, and along the corridor. They take germs and the pandemic seriously here. I like their wine and alcohol list, and it's a peaceful spot for conversation. Because the restaurant looks quaint, sits up on a hill away from the sidewalk and busy street, and there's little tables in different little spots, it feels kind of romantic. I would come here again for a peaceful and easy afternoon.\"},{\"review_date\":\"2021-11-08 06:47:47\",\"review_stars\":5.0,\"review_text\":\"I have had two very enjoyable dining experiences at this caf\u00e9.  It seems to be the restaurant I always go to when I go up to Santa Barbara for a concert. Both times I was seated reasonably quickly (One time solo dining and the other with a group of friends). The service was quite good both times - which was particularly remarkable on my most recent visit because it was during a very busy Saturday night service. Even though it was busy, it wasn't super loud, IMO. The outdoor seating patio area is very nice and on this most recent visit I sat inside and the atmosphere was very pleasant (and all staff were masked and I felt perfectly fine in that regard).  Most importantly the food is YUM *and* they have several vegetarian friendly options.  I look forward to my next visit.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0029060040005788323, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 910, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 248, "byte_start": 0, "call_id": "sha256:a17e9f03931dbb1b5c279f17", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-7a7c5676117cb8e03905eec5", "kv_state_id": "reset-epoch-662", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 2.2703990936279297, "marked_response": "<<CARNOT_FOCUS_START:0:248>>La Playa Azul Cafe is a Mexican restaurant located at 914 Santa Barbara St in Santa Barbara, CA. They offe