8f571fc2f13a8bde4103d8f9cdecbf654fcc382c04ae6223126b8", "sealed_prompt_token_count": 915, "sentence_count": 4, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-177bb8068f895cd4d49db911", "source_sha256": "sha256:72d394a07f0af88f6e0424156ffae29617da7d9e9f57801dcbf1b8f2e8963f1d", "source_text": "{\"address\":\"601 Paseo Nuevo\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":false,\"street\":false,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":null,\"RestaurantsGoodForGroups\":false,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":\"no\"},\"business_stars\":3.5,\"categories\":\"Restaurants\",\"city\":\"Santa Barbara\",\"hours\":null,\"name\":\"Ruby's Diner\",\"review_info\":[{\"review_date\":\"2011-04-14 00:50:08\",\"review_stars\":2.0,\"review_text\":\"Where do the good reviews come from?\\n\\nDirty floors, tables, counter and salsa bar.Yuck.\\nNot sure if anything is fresh other than the cilantro. \\nThe Three Amigo burrito is as big as three friends but the inside is more like shoe letter. Packed with dry chicken and steak that could have been sitting for days. At least simmer in juices so it's softer. This puppy is as dry as the Mexican desert. The shrimp was ok and it was nice the rice was light. Definitely needed drowning from the salsa bar to help it down.\\n\\nNothing impressed me and I don't know what kind of repeat business Rubys gets. It wont be from me.\"},{\"review_date\":\"2008-09-04 16:03:53\",\"review_stars\":3.0,\"review_text\":\"It's a diner.  Our hotel gave us a map with restaurants and things to see and do in Santa Barbara.  I read about this diner.  The map said it was a 1940's diner.  SO OF COURSE WE HAD TO GO!  But, it was not. \\n\\nIt's one of those chain diners with new but vintage looking decor. \\n\\nI had a cheeseburger, Gary had a tuna melt.  The food was average diner food.  Not bad, not fantastic. \\n\\nGary knew I was sad that it wasn't a 1940's diner and he pointed out a sign that said Independently Operated. That made me feel a little better.\"},{\"review_date\":\"2008-07-24 21:58:55\",\"review_stars\":4.0,\"review_text\":\"It's a diner.  Come for a burger, fries, and a shake.  Food isn't too greasy and it's always satisfying.  The place is clean and service isn't bad.  Kind of expensive, but my stomach doesn't complain.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.001675188000263006, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 1, "window_sha256": "sha256:3789964f550f9b69235cff7495abc446f088dfbaea3e5319a838c3eb5b6281f7", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 915, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 1062, "byte_start": 718, "call_id": "sha256:2239f8027f3eabf2b1c5fc3c", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-177bb8068f895cd4d49db911", "kv_state_id": "reset-epoch-140", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": 5.755500793457031, "marked_response": "Ruby's Diner is a restaurant located at 601 Paseo Nuevo in Santa Barbara, California. They are open for business during regular operating hours, but their specific hours are not available online. Ruby's Diner serves a variety of foods such as burgers, sandwiches, salads, and desserts. They offer takeout services, but they do not provide outdoor seating or Wi-Fi. Customers can park their cars in the street, garage, lot, or valet area, although validated parking options are not available. Ruby's Diner has an average rating of 3.5 stars on Google, based on customer reviews. Some customers have complained about the cleanliness of the restaurant, stating that the floors, tables, counter, and salsa bar were dirty. <<CARNOT_FOCUS_START:718:1062>>Others have noted that the food quality was average, and that there didn't seem to be any fresh ingredients used in their dishes. However, some customers have praised the ambiance and service at Ruby's Diner, describing it as trendy and clean. Overall, Ruby's Diner appears to be a casual dining option for individuals looking for a quick meal.<<CARNOT_FOCUS_END>>", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["contains_unsupported", "supported"], "order_remapping": {" A": "contains_unsupported", " B": "supported"}, "prefill_s": 1.100817687000017, "probabilities_by_option_id": {"contains_unsupported": 0.9968446666011952, "supported": 0.003155333398804754}, "prompt_sha256": "sha256:ddd1eb3be022614b48dbdc175a814258892daca3e63545d105a2cb30460af1ea", "prompt_token_count": 916, "prompt_token_ids": [1890, 1386, 1761, 364, 279, 4434, 1965, 1608, 1132, 279, 16713, 2450, 13, 271, 41578, 198, 4754, 4834, 3147, 21, 15, 16, 227208, 78, 84731, 2129, 11987, 21624, 52218, 1772, 21624, 23543, 899, 763, 3721, 1288, 1005, 88, 763, 3721, 1288, 67, 520, 88, 763, 3721, 1288, 92670, 763, 3721, 1288, 390, 3316, 763, 3721, 1288, 433, 7902, 763, 3721, 1288, 49612, 84507, 763, 3721, 1288, 237419, 88, 763, 3721, 1288, 8339, 2174, 763, 3721, 49471, 22020, 91061, 21624, 11816, 416, 763, 3721, 1288, 8911, 763, 3721, 1288, 26466, 763, 3721, 1288, 6378, 1112, 763, 3721, 1288, 57576, 763, 3721, 49471, 23373, 763, 2827, 1288, 95130, 1460, 1060, 763, 2827, 1288, 120