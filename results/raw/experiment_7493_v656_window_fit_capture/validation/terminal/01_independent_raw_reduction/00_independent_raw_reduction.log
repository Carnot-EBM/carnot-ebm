, 17, 15, 16, 20, 11, 279, 7309, 12, 89581, 43720, 2353, 1881, 44274, 93976, 321, 90904, 12274, 438, 21817, 303, 15292, 17072, 5312, 1010, 314, 279, 1379, 11064, 13990, 303, 33770, 3712, 11, 440, 23769, 562, 15833, 1602, 5898, 364, 430, 1691, 430, 393, 18, 21, 16, 11, 23, 24, 19, 13, 8020, 883, 220, 16, 11, 15, 15, 15, 13990, 998, 2420, 310, 279, 4437, 569, 11, 440, 279, 2645, 1602, 6507, 1881, 279, 22478, 6, 27128, 11, 279, 11507, 11, 90909, 11, 321, 37321, 13, 7183, 279, 40659, 15833, 11, 31528, 1881, 393, 16, 11, 20, 15, 15, 321, 393, 22, 11, 20, 15, 15, 11, 998, 5898, 680, 303, 264, 4766, 314, 4276, 13, 13853, 1587, 367, 11, 12274, 438, 21817, 579, 63332, 11, 1018, 551, 995, 2496, 3753, 3977, 1040, 424, 13, 271, 55025, 198, 32, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 198, 33, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 13.403532028198242, " B": 14.404285430908203}, "raw_logits_by_option_id": {"contains_unsupported": 14.404285430908203, "supported": 13.403532028198242}, "readout_s": 3.405400002520764e-05, "request_id": "sha256:65a68f59aa12a6b6dfda3923", "requested_score_position": 704, "response_sha256": "sha256:b663297aee25be6ac91df55f476bbde90b4f5318b668c56645144e66933b3121", "response_text": "In 2015, the highly-anticipated boxing match between Floyd Mayweather and Manny Pacquiao in Las Vegas saw some of the most expensive tickets in sporting history, with ringside seats being sold for as much as $361,894. Only about 1,000 tickets were available to the general public, with the rest being split between the fighters' camps, the casino, promoters, and sponsors. Even the cheapest seats, priced between $1,500 and $7,500, were sold out in a matter of minutes. Bob Arum, Pacquiao's promoter, said he had never seen anything like it.", "role": "training", "sealed_prompt_sha256": "sha256:5d4b62c0c0be1123d146b0c77d59b833a2d7d5f9a8e44d2f2a481d60b7e86da2", "sealed_prompt_token_count": 705, "sentence_count": null, "sentence_version": null, "source_group_id": "group-d29301cfbed22953ecd08cc4", "source_sha256": "sha256:4f3b02b6ec6578280e1232a3fc272789922c9b5495eb0ee2060de79ebb1e1138", "source_text": "Are you a boxing fan? Fancy the best seats in the house for Saturday night's showdown in Las Vegas between Floyd Mayweather and Manny Pacquiao? Got a spare $361,894 for a couple of tickets? No? Ah, well then you might have a problem. Yes, while most of the tickets for the highly-anticipated clash have sold out, there are still some floating around on secondary sites with ringside seats going at crazy money. A ticket at ringside will cost you $180,000 -- a knockout price which might have you seeing stars. As of lunchtime Friday, the most expensive seat on sale through the StubHub website, was retailing for a mammoth $128,705 but has since skyrocketed. Tickets were released last Thursday, just eight days before one of the biggest fights in history after legal wrangling between the two camps. However only around 1,000 were available to the general public, the rest of the estimated 16,500 tickets split between the fighters' camps and the casino as well as promoters and sponsors. Not long after some were made available on resale websites at a mark up that could only be dreamed about even by the sharpest financial trader. Those at the lower end of the eye-watering scale -- priced between $1,500 and $7,500 -- were snapped up in a matter of minutes. The cheapest priced ticket being offered on StubHub as of Monday is $4,600 with that seat right at the back of the MGM Grand arena.,. \"We've never seen anything like this in boxing, and I don't think in any sporting event,\" Bob Arum, Pacquiao's promoter, told CNN, . And Arum isn't worried that the steep prices would keep fans away. \"The 1% has so much money, they don't know how to spend it. Whether it's yachts, paintings or tickets to a fight, money means nothing,\" he said. \"There was a craze for tickets and under our agreement with Mayweather Promotions, we felt we were being deprived of our fair share of the tickets (from) the standpoint of number and location. \"It was very, very important to my fighter Manny Pacquiao, to the Philippines people... Manny has friends and family like you can't believe -- that will be in account for 800 or 900 tickets themselves.\"\n", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0021452940000017406, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 724, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 218, "byte_start": 0, "call_id": "sha256:6c1e8af6f00705a3b39a0989", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-d29301cfbed22953ecd08cc4", "kv_state_id": "reset-epoch-1138", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 0.35312175750732405, "marked_response": "<<CARNOT_FOCUS_START:0:218>>In 2015, the highly-anticipated boxing match between Floyd Mayweather and Manny Pacquiao in Las Vegas saw some of the most expensive tickets in sporting history, with ringside seats being sold for as much as $361,894. <<CARNOT_FOCUS_END>>Only about 1,000 tickets were available to the general public, with the rest being split between the fighters' camps, the casino, promoters, and sponsors. Even the cheapest seats, priced between $1,500 and $7,500, were sold out in a matter of minutes. Bob Arum, Pacquiao's promoter, said he had never seen anything like it.", "model_sha256": "sha256