6713, 2450, 13, 198, 33, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 12.096577644348145, " B": 16.19269371032715}, "raw_logits_by_option_id": {"contains_unsupported": 16.19269371032715, "supported": 12.096577644348145}, "readout_s": 3.580800057534361e-05, "request_id": "sha256:d04388dd55fe0e7c4693ea57", "requested_score_position": 617, "response_sha256": "sha256:23556ae477f0048633fcf7bbaad0a7252cf5ed856353343b6f4959ea48939343", "response_text": "Restaurant Mimosa is a moderately rated restaurant located in Santa Barbara, California, offering French and American cuisine. According to customer reviews, the restaurant has a mixed reputation when it comes to food quality, with some reviewers expressing disappointment with their meals, particularly in terms of cooking consistency and flavor. However, many patrons have praised the service, citing friendly and attentive staff. The restaurant also offers outdoor seating and has free Wi-Fi, making it a popular spot for both casual and special occasion dining. Despite some negative feedback, Restaurant Mimosa maintains a 3.5-star rating and has received several positive reviews in recent years.", "role": "training", "sealed_prompt_sha256": "sha256:b3a8bcd48b7c7e6b60d073e5b80880b3c27b7c17a002beff30bb52a29404684b", "sealed_prompt_token_count": 618, "sentence_count": 1, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-43b277da5ea934674295b0ad", "source_sha256": "sha256:1d67b0cc774ceb10849200d8cea553f414efcbfc900193b215561a04885655f3", "source_text": "{\"address\":\"714 State St\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":true,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":false,\"street\":false,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorS