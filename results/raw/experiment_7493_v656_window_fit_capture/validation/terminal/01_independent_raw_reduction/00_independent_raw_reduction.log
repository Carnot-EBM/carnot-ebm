, 11, 424, 369, 1048, 9444, 421, 1017, 628, 381, 1248, 4965, 321, 6973, 36064, 13, 271, 55025, 198, 32, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 198, 33, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 16.044452667236328, " B": 15.213570594787598}, "raw_logits_by_option_id": {"contains_unsupported": 16.044452667236328, "supported": 15.213570594787598}, "readout_s": 3.320199994050199e-05, "request_id": "sha256:5ebe0644fb096a087cb4804f", "requested_score_position": 1016, "response_sha256": "sha256:7ce490d9de9fcf5459a5d1f08c83b969334eb2081032129fc8ba4eaa26f98544", "response_text": "\"Anna's Marketplace Bakery\" is a well-regarded establishment located at 7018 Marketplace Dr, Goleta, CA. It specializes in a wide range of food items, including donuts, sandwiches, and other bakery and restaurant offerings. The bakery opens at 6:00 on all days, with varying closing times. They also offer outdoor seating and takeout but do not provide WiFi or reservations. This bakery is known for its quality products, with reviews highlighting the delicious donuts, chocolate croissants, and vegan offerings. One reviewer notes the friendly staff and appreciates the personal touch of being greeted by name. The bakery has an overall rating of 4 stars, indicating high customer satisfaction. However, it is also mentioned that there can be long lines and limited seating.", "role": "training", "sealed_prompt_sha256": "sha256:a47897a8adbc563c2db13e08ecaf10bd75a82ded88a0a8be7d659c7f48f43683", "sealed_prompt_token_count": 1017, "sentence_count": 3, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-dedbf19a965d64cd8bca80cb", "source_sha256": "sha256:d19c8ee30866586d3eacedfc17f89afe92a8c753c7a44d2e81fd7925bcc7b26f", "source_text": "{\"address\":\"7018 Marketplace Dr\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":false,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":\"no\"},\"business_stars\":4.0,\"categories\":\"Donuts, Restaurants, Bakeries, Food, Sandwiches\",\"city\":\"Goleta\",\"hours\":{\"Friday\":\"6:0-17:30\",\"Monday\":\"0:0-0:0\",\"Saturday\":\"6:0-17:30\",\"Sunday\":\"6:0-16:30\",\"Thursday\":\"6:0-16:0\",\"Tuesday\":\"6:0-17:30\",\"Wednesday\":\"6:0-17:30\"},\"name\":\"Anna's Marketplace Bakery\",\"review_info\":[{\"review_date\":\"2022-01-18 01:20:49\",\"review_stars\":4.0,\"review_text\":\"Donuts are delish, nice and light and fresh. The chocolate croissant was really good as well! They are a little more pricey than some donut shops but have really good flavor.\"},{\"review_date\":\"2022-01-01 18:44:53\",\"review_stars\":5.0,\"review_text\":\"Happy 2022 everyone! This year will surely see me at Anna's quite a few more times. When a friend told me that a bakery close to where I live offers vegan donuts, I was psyched--I'm vegan and it's oddly difficult to find good vegan food, sweets, and drinks in this area. Checking out Anna's Bakery a few days later, I wasn't let down. \\n\\nI've sampled both the vegan glazed donut and the apple fritter, as well as the house coffee, and all were great. The donut is puffy and airy and sweet. The fritter has glorious crunchy, oily edges and a surprisingly doughy interior, complete with apple pieces and a glossy, sugary varnish. (Did you know some 'apple fritters' elsewhere don't even contain apple?) The coffee is hot and black and perfectly balances the candy-like sweetness of the baked goods. \\n\\nThere's always a long line and seating is limited so be prepared. This shop also offers non-vegan donuts (the majority contain milk products, though I'm crossing my fingers for a vegan cake donut in 2022). There is also a menu of savory food. Breads and donuts and cookies are also available to go. That pink box, unmistakably brimming with tasty treats, is sure to being smiles to any gathering... especially if you have vegan friends who are so used to being left out when sweet baked goods appear.\"},{\"review_date\":\"2021-10-27 05:28:12\",\"review_stars\":5.0,\"review_text\":\"SO friendly and donuts are always amazing. All staff, from the cashier to the owner. All lovely people. They always greet with by my name. I love to see how they interact with all customers. I am always happy to give them business as it is very well deserved. Keep up the wonderful work! Anna's has been around for a long time and has always been one of my favorites.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0017653759996392182, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 1, "window_sha256": "sha256:b430adda336cec77dd282972b3d882417e8d7fd265bda2d9c3affea0a5a49fdf", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 1016, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 775, "byte_start": 513, "call_id": "sha256:f7d128d9042018357a83f818", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-dedbf19a965d64cd8bca80cb", "kv_state_id": "reset-epoch-1232", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": -0.02861499786376949, "marked_response": "\"Anna's Marketplace Bakery\" is a well-regarded establishment located at 7018 Marketplace Dr, Goleta, CA. It specializes in a wide range of food items, including donuts, sandwiches, and other bakery and restaurant offerings. The bakery opens at 6:00 on all days, with varying closing times. They also offer outdoor seating and takeout but do not provide WiFi or reservations. This bakery is known for its quality products, with reviews highlighting the delicious donuts, chocolate croissants, and vegan offerings. <<CARNOT_FOCUS_START:513:775>>One reviewer notes the friendly staff and appreciates the personal touch of being greeted by name. The bakery has an overall rating of 4 stars, indicating high customer satisfaction. However, it is also mentioned that there can be long lines and limited seating.<<CARNOT_FOCUS_END>>", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["contains_unsupported", "supported"], "order_remapping": {" A": "contains_unsupported", " B": "supported"}, "prefill_s": 1.1943257100001574, "probabilities_by_option_id": {"contains_unsupported": 0.4928467386290553, "supported": 0.5071532613709446}, "prompt_sha256": "sha256:1c7e627be265c237a7e768ee853c316134f1a02a97b1faca74c2db755eb8077c", "prompt_token_count": 1017, "prompt_token_ids": [1890, 1386, 1761, 364, 279, 4434, 1965, 1608, 1132, 279, 16713, 2450, 13, 271, 41578, 198, 4754, 4834, 3147, 22, 15, 16, 23, 55341, 2832, 2129, 11987, 21624, 52218, 1772, 21624, 23543, 899, 763, 3721, 1288, 1005, 88, 763, 3721, 1288, 67, 520, 88, 763, 3721, 1288, 92670, 763, 3721, 1288, 390, 3316, 763, 3721, 1288, 433, 7902, 763, 3721, 1288, 49612, 84507, 763, 3721, 1288, 237419, 88, 763, 3721, 1288, 8339, 2174, 763, 3721, 49471, 22020, 91061, 21624, 11816, 416, 763, 3721, 1288, 8911, 763, 1802, 1288, 26466, 763, 3721, 1288, 6378, 1112, 763, 3721, 1288, 57576, 763, 3721, 49471, 23373, 763, 2827, 1288, 95130, 1460, 1060, 763, 1802, 1288, 12060, 32858,