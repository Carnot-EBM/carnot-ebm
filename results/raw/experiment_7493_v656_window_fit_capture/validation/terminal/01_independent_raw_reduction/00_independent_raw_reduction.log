he best I've ever had. This coming from a private chef/food fanatic. Charming side note: this place has been here since 1973 and was handed down from father to son.  From what I've read, Patrick's father John was beloved in the community. Well known to Montecito locals but new to this Venturan, I will definitely be back to this hidden gem. Seating is limited but there's a pretty, grassy area in the shopping center that would make for a lovely picnic. Keep up the good work and good works Patrick, of charity and community involvement.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.002090260999466409, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 2, "window_sha256": "sha256:a70d364ddc61ae6e17361f6d91bfb8a20ff0b7639730b73ce26ee39a8324b795", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 970, "archived_pilot_reuse": false, "arm": "whole_response", "attempted": true, "byte_end": null, "byte_start": null, "call_id": "sha256:e849bd18b9bf079b0a2ee9b9", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-749869b78483b77e80fd464a", "kv_state_id": "reset-epoch-629", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 0.7812929153442384, "marked_response": null, "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["supported", "contains_unsupported"], "order_remapping": {" A": "supported", " B": "contains_unsupported"}, "prefill_s": 1.1639664500007711, "probabilities_by_optio