, 198, 33, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 15.405289649963379, " B": 14.33375072479248}, "raw_logits_by_option_id": {"contains_unsupported": 15.405289649963379, "supported": 14.33375072479248}, "readout_s": 4.423299924383173e-05, "request_id": "sha256:d9675d658c46d920d988502e", "requested_score_position": 1076, "response_sha256": "sha256:cd3ae58001b4fa41b4741bc1d9043f2b1c55557ba9ea4fda8d409d3d648d40aa", "response_text": "Dune Coffee Roasters - Storke is a popular coffee shop located in Goleta, CA. According to customer reviews, the coffee shop offers high-quality coffee, including cappuccinos, matcha, iced lattes, and hot lattes, made with strong and flavorful espresso. Customers appreciate the variety of alternative milks available, including Califia Farms. The matcha is particularly popular and is served with honey and cinnamon. The croissants and toasts are also delicious, especially the cinnamon sugar one. The baristas are friendly and welcoming, creating a cozy and relaxing atmosphere. The coffee shop has ample seating, both indoor and outdoor, and provides free WiFi. While some customers have noted that the ambiance is drab and the prices are a bit high, others have praised the excellent quality of the coffee and food. Overall, Dune Coffee Roasters - Storke is a great spot for coffee lovers who value quality and service.", "role": "training", "sealed_prompt_sha256": "sha256:b34a417914321f73f2a5f871a13ac979c8343bedf57e658a6582feb35d738b03", "sealed_prompt_token_count": 1077, "sentence_count": 2, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-16195f5b92ba6e7d59cc71b7", "source_sha256": "sha256:058aff55590c1d562bb11812cfb7683b6d7e60658a1fe3ba815b419d431785c5", "source_text": "{\"address\":\"250 A Storke Rd\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":false,\"divey\":false,\"hipster\":true,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":false,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":\"free\"},\"business_stars\":4.0,\"categories\":\"Food, Restaurants, Cafes, Coffee Roasteries, Coffee & Tea\",\"city\":\"Goleta\",\"hours\":{\"Friday\":\"6:30-16:0\",\"Monday\":\"6:30-16:0\",\"Saturday\":\"7:0-16:0\",\"Sunday\":\"7:0-16:0\",\"Thursday\":\"6:30-16:0\",\"Tuesday\":\"6:30-16:0\",\"Wednesday\":\"6:30-16:0\"},\"name\":\"Dune Coffee Roasters - Storke\",\"review_info\":[{\"review_date\":\"2021-12-08 16:16:40\",\"review_stars\":1.0,\"review_text\":\"Pretentious over priced coffee shop that has lackluster quality, staff, or ambiance. I'm all about paying a premium for a great cup of coffee... but this place is just an overpriced Dunkin' Donuts. Ambiance is drab, coffee is drab... and they charge 20% more for a non-dairy milk. Even the \\\"corporate\\\" Starbucks is ending the extra charge on plant based milks.\\n\\nThey're all about the aesthetic of being \\\"Santa Barbara, and environmentally friendly\\\"... but they're just greenwashing Luddite's. Get with the times - stop charging for plant based milks and invest in some cool attire. Caje is such a better local coffee shop group in the SB area\"},{\"review_date\":\"2021-11-03 21:54:05\",\"review_stars\":5.0,\"review_text\":\"I visit Dune several times a week, and I think the only complaint I can think of is that there are no outlets. Besides that, everything is perfect. \\n\\nThe coffee is excellent - I've tried cappuccinos, matcha, iced lattes, and hot lattes and they're all really wonderful. The quality of alternative milks is really good (they use Califia Farms) and the espresso is always strong and flavorful. I absolutely love their matcha -- I believe it's Mizuba and when you order it with honey and cinnamon it's delightful.\\n\\nI've also tried the croissants and the toasts and they're all super yummy. The cinnamon sugar one is probably my favorite.\\n\\nThe baristas here are some of the kindest people I have ever met. They are so genuine and warm, and I love seeing them when I order.\\n\\nThere is plenty of seating, always great music, WiFi, and just a really relaxing and cozy vibe.\"},{\"review_date\":\"2021-10-02 21:32:09\",\"review_stars\":3.0,\"review_text\":\"I stopped by dune coffee roasters while I was waiting for my clothes to dry at the laundromat. The service was good and quick as there were not too many people when I went. They have a cute little outdoor patio with tables and a good amount of seating inside. I ordered a iced vanilla latte. It tasted good and refreshing, however, I wish it tasted a little sweeter and more vanilla.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0028157420001662103, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 2, "window_sha256": "sha256:09e42ab5a9d6339799d8b7da3bc9c573296c86b1fb30990374133291e87a6c32", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 1507, "archived_pilot_reuse": false, "arm": "whole_response", "attempted": true, "byte_end": null, "byte_start": null, "call_id": "sha256:a4a6a42773cf0fe0876ce6df", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-175df9723ee129130e4411bb", "kv_state_id": "reset-epoch-125", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": -1.569345474243164, "marked_response": null, "model_sha256": 