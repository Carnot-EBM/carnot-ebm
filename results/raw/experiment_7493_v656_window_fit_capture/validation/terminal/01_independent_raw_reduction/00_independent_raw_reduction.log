ea. However, customers may want to be aware of the potential issues with cleanliness and service before visiting.<<CARNOT_FOCUS_END>>", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["contains_unsupported", "supported"], "order_remapping": {" A": "contains_unsupported", " B": "supported"}, "prefill_s": 1.181691542000408, "probabilities_by_option_id": {"contains_unsupported": 0.981184572473079, "supported": 0.018815427526920985}, "prompt_sha256": "sha256:b19dbdd025cf55a02377f53a380cfa536dc2d5d93bbbf5fedbc783741d77181b", "prompt_token_count": 999, "prompt_token_ids": [1890, 1386, 1761, 364, 279, 4434, 1965, 1608, 1132, 279, 16713, 2450, 13, 271, 41578, 198, 4754, 4834, 3147, 16, 15, 15, 16, 10731, 20575, 9675, 26577, 2129, 11987, 21624, 52218, 1772, 21624, 23543, 899, 763, 1802, 1288, 1005, 88, 763, 3721, 1288, 67, 520, 88, 763, 3721, 1288, 92670, 763, 3721, 1288, 390, 3316, 763, 3721, 1288, 433, 7902, 763, 3721, 1288, 49612, 84507, 763, 3721, 1288, 237419, 88, 763, 3721, 1288, 8339, 2174, 763, 3721, 49471, 22020, 91061, 21624, 11816, 416, 763, 3721, 1288, 8911, 763, 1802, 1288, 26466, 763, 3721, 1288, 6378, 1112, 763, 3721, 1288, 57576, 763, 3721, 49471, 23373, 763, 2827, 1288, 95130, 1460, 1060, 763, 1802, 1288, 12060, 32858, 14773, 2381, 21485, 763, 1802, 1288, 12060, 32858, 1026, 44294, 763, 3721, 1288, 12060, 32858, 17283, 2575, 763, 1802, 1288, 92247, 3147, 2083, 56658, 25316, 1217, 1506, 763, 18, 13, 15, 1288, 15042, 3147, 49828, 6845, 11, 56143, 11, 41767, 594, 3135, 3084, 2129, 8656, 3147, 34, 7628, 2173, 667, 2129, 29393, 21624, 33475, 3147, 23, 25, 15, 12, 17, 16, 25, 15, 2129, 34072, 3147, 23, 25, 15, 12, 17, 16, 25, 15, 2129, 32558, 3147, 23, 25, 15, 12, 17, 16, 25, 15, 2129, 34871, 3147, 23, 25, 15, 12, 17, 16, 25, 15, 2129, 36539, 3147, 23, 25, 15, 12, 17, 16, 25, 15, 2129, 38867, 3147, 23, 25, 15