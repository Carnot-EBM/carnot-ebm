, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 12.971921920776367, " B": 16.19930076599121}, "raw_logits_by_option_id": {"contains_unsupported": 16.19930076599121, "supported": 12.971921920776367}, "readout_s": 3.388400000403635e-05, "request_id": "sha256:976fadadcad61493c99bef61", "requested_score_position": 885, "response_sha256": "sha256:99fc69054e1070530148eaddc5761b23e3f9a00511365ac026b762daa9d4302d", "response_text": "Oat Bakery is a local business located at 5 W Haley St in Santa Barbara, CA. They specialize in bakery items and offer a range of vegan and gluten-free options. Customers have praised the bakery for its assortment of bread, particularly the seed cookie and cinnamon rolls. However, some customers were disappointed that they did not have bagels and vegan cream cheese available for purchase. \n\nThe bakery's hours of operation are as follows: Tuesday to Saturday from 9:00 AM to 2:30 PM. It is closed on Mondays. The business has street parking and a parking lot available for customers. They also accept restaurant reservations and have outdoor seating. The bakery does not provide WiFi and does not offer takeout or group dining options. There is no information available regarding music or ambience.\n\nOverall, Oat Bakery has received positive reviews, with a 5-star rating. Customers have praised the bakery for its delicious and filling bread options, particularly the seeded loaf. Although some items may be on the pricier side, customers have expressed their willingness to return to the bakery if they are in the area again. Oat Bakery is a popular choice for those looking for specialty food and organic baked goods in Santa Barbara.", "role": "calibration_tuning", "sealed_prompt_sha256": "sha256:5bfca0b24e782312b13ba30fba8ab42689a45c719c279746e8c5e2f41d4075d4", "sealed_prompt_token_count": 886, "sentence_count": 6, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-b882e9983a8d609a4d0c2e46", "source_sha256": "sha256:c38305eaa334a05141126d9307a4a3d65652575a903f76fd51a0c0f1effa3fbf", "source_text": "{\"address\":\"5 W Haley St\",\"attributes\":{\"Ambience\":null,\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":null,\"RestaurantsGoodForGroups\":null,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":null,\"WiFi\":\"no\"},\"business_stars\":5.0,\"categories\":\"Bakeries, Vegan, Specialty Food, Food Delivery Services, Food, Coffee & Tea, Gluten-Free, Farmers Market, Restaurants, Organic Stores\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"9:0-14:30\",\"Monday\":\"0:0-0:0\",\"Saturday\":\"9:0-14:30\",\"Thursday\":\"9:0-14:30\",\"Tuesday\":\"9:0-18:0\",\"Wednesday\":\"9:0-14:30\"},\"name\":\"Oat Bakery\",\"review_info\":[{\"review_date\":\"2022-01-19 05:59:11\",\"review_stars\":4.0,\"review_text\":\"Cute bakery with great assortment of bread.  We were hoping they had bagels and vegan cream cheese for our road trip but unfortunately they did not.  We did try the seed cookie which was amazing and very filling. Also loved the cinnamon rolls. \\nThey had an assortment of plant based cream cheeses that I would have loved to try. Unfortunately we were passing though and did not want to buy an entire container and large loaf.\"},{\"review_date\":\"2021-12-30 00:02:07\",\"review_stars\":5.0,\"review_text\":\"We came here at the recommendation of Low Pigeon Coffee Roasters, looking for some bakery items to munch on with our coffees. Unfortunately, it was more bread than sweets, but we still walked away with some hygge buns and the most delicious foccocia bread. I wish we lived in SB just so we could appreciate their other breads because I couldn't justify getting a loaf only to have it sit for days before being able to enjoy it in our kitchen at home.\"},{\"review_date\":\"2021-12-29 04:59:50\",\"review_stars\":5.0,\"review_text\":\"I got Half of a Seeded loaf. No flour. \\n$15. Omg it was yum. Dense and complex. \\nI don't live in the area but if I ever I'm in the area again I am definitely going to get the seeded loaf again.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0016399280002588057, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 1, "window_sha256": "sha256:fdcfd83510c32eaade32de92a5619e3f29cd98fd11f045adb98661dc7b669dfd", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 886, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 1240, "byte_start": 803, "call_id": "sha256:9f0f56aca42cf920c1c9aa7a", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-b882e9983a8d609a4d0c2e46", "kv_state_id": "reset-epoch-1726", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 2.545659065246582, "marked_response": "Oat Bakery is a local business located at 5 W Haley St in Santa Barbara, CA. They specialize in bakery items and offer a range of vegan and gluten-free options. Customers have praised the bakery for its assortment of bread, particularly the seed cookie and cinnamon rolls. However, some customers were disappointed that they did not have bagels and vegan cream cheese available for purchase. \n\nThe bakery's hours of operation are as follows: Tuesday to Saturday from 9:00 AM to 2:30 PM. It is closed on Mondays. The business has street parking and a parking lot available for customers. They also accept restaurant reservations and have outdoor seating. The bakery does not provide WiFi and does not offer takeout or group dining options. There is no information available regar