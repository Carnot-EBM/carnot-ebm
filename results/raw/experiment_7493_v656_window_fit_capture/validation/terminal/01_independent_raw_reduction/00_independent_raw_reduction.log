ibration_tuning", "sealed_prompt_sha256": "sha256:e7bacbc4a2a542ae1eb34623e0ce792a960623e628aba187c1cd5b5a7083cdbe", "sealed_prompt_token_count": 887, "sentence_count": 4, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-b882e9983a8d609a4d0c2e46", "source_sha256": "sha256:c38305eaa334a05141126d9307a4a3d65652575a903f76fd51a0c0f1effa3fbf", "source_text": "{\"address\":\"5 W Haley St\",\"attributes\":{\"Ambience\":null,\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":null,\"RestaurantsGoodForGroups\":null,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":null,\"WiFi\":\"no\"},\"business_stars\":5.0,\"categories\":\"Bakeries, Vegan, Specialty Food, Food Delivery Services, Food, Coffee & Tea, Gluten-Free, Farmers Market, Restaurants, Organic Stores\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"9:0-14:30\",\"Monday\":\"0:0-0:0\",\"Saturday\":\"9:0-14:30\",\"Thursday\":\"9:0-14:30\",\"Tuesday\":\"9:0-18:0\",\"Wednesday\":\"9:0-14:30\"},\"name\":\"Oat Bakery\",\"review_info\":[{\"review_date\":\"2022-01-19 05:59:11\",\"review_stars\":4.0,\"review_text\":\"Cute bakery with great assortment of bread.  We were hoping they had bagels and vegan cream cheese for our road trip but unfortunately they did not.  We did try the seed cookie which was amazing and very filling. Also loved the cinnamon rolls. \\nThey had an assortment of plant based cream cheeses that I would have loved to try. Unfortunately we were passing though and did not want to buy an entire container and large loaf.\"},{\"review_date\":\"2021-12-30 00:02:07\",\"review_stars\":5.0,\"review_text\":\"We came here at the recommendation of Low Pigeon Coffee Roasters, looking for some bakery items to munch on with our coffees. Unfortunately, it was more bread than sweets, but we still walked away with some hygge buns and the most delicious foccocia bread. I wish we lived in SB just so we could appreciate their other breads because I couldn't justify getting a loaf only to have it sit for days before being able to enjoy it in our kitchen at home.\"},{\"review_date\":\"2021-12-29 04:59:50\",\"review_stars\":5.0,\"review_text\":\"I got Half of a Seeded loaf. No flour. \\n$15. Omg it was yum. Dense and complex. \\nI don't live in the area but if I ever I'm in the area again I am definitely going to get the seeded loaf again.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0016150309993463452, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 2, "window_sha256": "sha256:1e30249476a466bdcf11cca824bc531d408489df51a9d4ec833a23a4fba78179", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 705, "archived_pilot_reuse": false, "arm": "whole_response", "attempted": true, "byte_end": null, "byte_start": null, "call_id": "sha256:9fe179aa15e8858076b53128", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-c2f7ab1794bd3555df0db212", "kv_state_id": "reset-epoch-1731", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": -0.030921936035156222, "marked_response": null, "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["supported", "contains_unsupported"], "order_remapping": {" A": "supported", " B": "contains_unsupported"}, "prefill_s": 0.855062136000015, "probabilities_by_option_id": {"contains_unsupported": 0.49227013190123337, "supported": 0.5077298680987665}, "prompt_sha256"