56": "sha256:e736f69bb83da36878512a55fafe7f5d7a0d19ba60e98e3541dc4a313bf88b5d", "sealed_prompt_token_count": 780, "sentence_count": null, "sentence_version": null, "source_group_id": "group-010a9223fede82e05e04df44", "source_sha256": "sha256:8a4a400a2e552ecc56e12974ab04c4caec7690ac9f4b8533ba0a47383e48166d", "source_text": "{\"passages\":\"passage 1:Remember, the less you touch your screen the better. Lightly wipe the screen with a dry and clean microfiber cloth. Microfiber is a miracle of modern technology; put it to good use. No paper towels, no kitchen towels, no household rags; only microfiber should touch your screen.ow to Safely Clean Your Screen. Now that we\u2019ve made you terrified of Windex and rags (as, on behalf of your beautiful widescreen monitor, you should be), it\u2019s time to get down to the business of properly cleaning your screens.\\n\\npassage 2:Instructions. Add 1 part isopropyl alcohol and 1 part distilled water to an empty spray bottle. Close the bottle and shake it to combine the ingredients. Turn off the laptop. It&#039;s easier to see the dust and smudges when the screen is dark. Spray a lint-free cloth with the homemade cleaning solution or LCD cleaner.Wipe the laptop screen thoroughly with the cloth to remove any dust or fingerprints. Clean in one direction to prevent streaks.lose the bottle and shake it to combine the ingredients. Turn off the laptop. It&#039;s easier to see the dust and smudges when the screen is dark. Spray a lint-free cloth with the homemade cleaning solution or LCD cleaner.\\n\\npassage 3:1 The microfiber clothes are washable, soft and safe to use on your screens. 2  To clean the edges of your LCD screen use a clean cotton ball or swab. 3  ALWAYS clean your screen powered off! ( 4 I know I said this above, but it is important enough to reiterate.). DO NOT touch your LCD screen, because it will shorten the lifespan of your screen. 2  NEVER use a window or abrasive cleaner on your TV screen as it can cause the screen to yellow and also damage it. 3  If a spot does not come off, do NOT rub harder, because you can kill some of your pixels and ruin your screen.\\n\\n\",\"question\":\"safely clean your computer screen\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0014468129993474577, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 779, "archived_pilot_reuse": false, "arm": "source_derangement_control", "attempted": true, "byte_end": null, "byte_start": null, "call_id": "sha256:f407d9e7e11bfc3acfa4f7aa", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-362c2a7dcdcb2d36fbf8e996", "kv_state_id": "reset-epoch-1488", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": 7.086536407470703, "marked_response": null, "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["contains_unsupported", "supported"], "order_remapping": {" A": "contains_unsupported", " B": "supported"}, "prefill_s": 0.9448671539994393, "probabilities_by_option_id": {"contains_unsupported": 0.999164409875575, "supported": 0.0008355901244250949}, "prompt_sha256": "sha256:a97c1ac84e5bebc5f0e397161b1e6939a58eabe4811cb9ff91e4447c247b6f83", "prompt_token_count": 780, "prompt_token_ids": [1890, 1386, 1761, 364, 279, 4434, 1965, 1608, 1132, 279, 16713, 2450, 13, 271, 41578, 198, 4754, 6184, 1098, 3147, 6184, 416, 220, 16, 25, 27656, 11, 279, 2599, 488, 5615, 678, 4034, 279, 2577, 13, 8394, 391