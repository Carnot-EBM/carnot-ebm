22, 198, 2362, 34, 8778, 1730, 93291, 12671, 25, 15, 25, 18, 19, 19, 2372, 35, 2792, 25245, 11491, 13793, 471, 178838, 432, 369, 264, 5243, 10482, 7808, 7172, 303, 5805, 46544, 11, 8910, 13, 10235, 310, 5813, 8120, 11, 279, 10482, 7808, 5891, 1496, 21408, 10482, 11, 2583, 203479, 14151, 14772, 11, 2353, 64, 11, 220, 7332, 324, 194669, 11, 321, 3882, 324, 194669, 11, 1801, 440, 3619, 321, 90310, 63214, 13, 38277, 14952, 279, 7792, 314, 10242, 7238, 2699, 2420, 11, 2583, 39443, 667, 64757, 13, 1079, 34, 8778, 1730, 93291, 10580, 2372, 760, 2353, 64, 369, 7695, 5243, 321, 369, 9919, 440, 24924, 321, 49180, 13, 561, 13689, 233988, 321, 310, 11420, 513, 1048, 17387, 11, 5142, 279, 49180, 12781, 799, 13, 561, 3498, 25821, 513, 11321, 321, 34117, 11, 6611, 264, 41025, 321, 32729, 16078, 13, 561, 10482, 7808, 682, 40374, 36064, 11, 2107, 28557, 321, 15325, 11, 321, 5529, 1845, 32204, 13, 5788, 1010, 6112, 599, 10036, 421, 279, 91305, 369, 1305, 365, 321, 279, 7336, 513, 264, 2612, 1496, 11, 3672, 599, 35172, 279, 8800, 4131, 314, 279, 10482, 321, 3487, 13, 26988, 11, 414, 2792, 25245, 11491, 13793, 471, 178838, 432, 369, 264, 2172, 7458, 364, 10482, 31059, 852, 869, 4131, 321, 2393, 13, 271, 55025, 198, 32, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 198, 33, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 15.96279525756836, " B": 14.924296379089355}, "raw_logits_by_option_id": {"contains_unsupported": 15.96279525756836, "supported": 14.924296379089355}, "readout_s": 5.7488000493322033e-05, "request_id": "sha256:5beaf0f3b9e540dcb753b7f7", "requested_score_position": 1074, "response_sha256": "sha256:cd3ae58001b4fa41b4741bc1d9043f2b1c55557ba9ea4fda8d409d3d648d40aa", "response_text": "Dune Coffee Roasters - Storke is a popular coffee shop located in Goleta, CA. According to customer reviews, the coffee shop offers high-quality coffee, including cappuccinos, matcha, iced lattes, and hot lattes, made with strong and flavorful espresso. Customers appreciate the variety of alternative milks available, including Califia Farms. The matcha is particularly popular and is served with honey and cinnamon. The croissants and toasts are also delicious, especially the cinnamon sugar one. The baristas are friendly and welcoming, creating a cozy and relaxing atmosphere. The coffee shop has ample seating, both indoor and outdoor, and provides free WiFi. While some customers have noted that the ambiance is drab and the prices are a bit high, others have praised the excellent quality of the coffee and food. Overall, Dune Coffee Roasters - Storke is a great spot for coffee lovers who value quality and service.", "role": "training", "sealed_prompt_sha256": "sha256:b151bf9ab5c74d59cb24667c9b6d4056bb578c0e989d6e3ffe4fc489b0a7c85a", "sealed_prompt_token_count": 1075, "sentence_count": 3, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-16195f5b92ba6e7d59cc71b7", "source_sha256": "sha256:058aff55590c1d562bb11812cfb7683b6d7e60658a1fe3ba815b419d431785c5", "source_text": "{\"address\":\"250 A Storke Rd\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":false,\"divey\":false,\"hipster\":true,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":false,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":\"free\"},\"business_stars\":4.0,\"categories\":\"Food, Restaurants, Cafes, Coffee Roasteries, Coffee & Tea\",\"city\":\"Goleta\",\"hours\":{\"Friday\":\"6:30-16:0\",\"Monday\":\"6:30-16:0\",\"Saturday\":\"7:0-16:0\",\"Sunday\":\"7:0-16:0\",\"Thursday\":\"6:30-16:0\",\"Tuesday\":\"6:30-16:0\",\"Wednesday\":\"6:30-16:0\"},\"name\":\"Dune Coffee Roasters - Storke\",\"review_info\":[{\"review_date\":\"2021-12-08 16:16:40\",\"review_stars\":1.0,\"review_text\":\"Pretentious over priced coffee shop that has lackluster quality, staff, or ambiance. I'm all about paying a premium for a great cup of coffee... but this place is just an overpriced Dunkin' Donuts. Ambiance is drab, coffee is drab... and they charge 20% more for a non-dairy milk. Even the \\\"corporate\\\" Starbucks is ending the extra charge on plant based milks.\\n\\nThey're all about the aesthetic of being \\\"Santa Barbara, and environmentally friendly\\\"... but they're just greenwashing Luddite's. Get with the times - stop charging for plant based milks and invest in some cool attire. Caje is such a better local coffee shop group in the SB area\"},{\"review_date\":\"2021-11-03 21:54:05\",\"review_stars\":5.0,\"review_text\":\"I visit Dune several times a week, and I think the only complaint I can think of is that there are no outlets. Besides that, everything is perfect. \\n\\nThe coffee is excellent - I've tried cappuccinos, matcha, iced lattes, and hot lattes and they're all really wonderful. The quality of alternative milks is really good (they use Califia Farms) and the espresso is always strong and flavorful. I absolutely love their matcha -- I believe it's Mizuba and when you order it with honey and cinnamon it's delightful.\\n\\nI've also tried the croissants and the toasts and they're all super yummy. The cinnamon sugar one is probably my favorite.\\n\\nThe baristas here are some of the kindest people I have ever met. They are so genuine and warm, and I love seeing them when I order.\\n\\nThere is plenty of seating, always great music, WiFi, and just a really relaxing and cozy vibe.\"},{\"review_date\":\"2021-10-02 21:32:09\",\"review_stars\":3.0,\"review_text\":\"I stopped by dune coffee roasters while I was waiting for my clothes to dry at the laundromat. The service was good and quick as there were not too many people when I went. They have a cute little outdoor patio with tables and a good amount of seating inside. I ordered a iced vanilla latte. It tasted good and refreshing, however, I wish it tasted a little sweeter and more vanilla.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.002829848999681417, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 0, "window_sha256": "sha256:4448b7bb25f6909435818c6465f883ba5ff388bbbef4becf32786d0fe6924522", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 1076, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 665, "byte_start": 344, "call_id": "sha256:3210bcd3412b9b1648e47508", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-16195f5b92ba6e7d59cc71b7", "kv_state_id": "reset-epoch-123", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": 1.4818696975708008, "marked_response": "Dune Coffee Roasters - Storke is a popular coffee shop located in Goleta, CA. According to customer reviews, the coffee shop offers high-quality coffee, including cappuccinos, matcha, iced lattes, and hot lattes, made with strong and flavorful espresso. Customers appreciate the variety of alternative milks available, including Califia Farms. <<CARNOT_FOCUS_START:344:665>>The matcha is particularly popular and is served with honey and cinnamon. The croissants and toasts are also delicious, especially the cinnamon sugar one. The baristas are friendly and welcoming, creating a cozy and relaxing atmosphere. The coffee shop has ample seating, both indoor and outdoor, and provides free WiFi. <<CARNOT_FOCUS_END>>While some customers have no