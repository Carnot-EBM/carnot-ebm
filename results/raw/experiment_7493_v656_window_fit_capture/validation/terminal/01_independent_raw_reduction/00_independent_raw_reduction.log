as an accident.", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["supported", "contains_unsupported"], "order_remapping": {" A": "supported", " B": "contains_unsupported"}, "prefill_s": 1.7858281030003127, "probabilities_by_option_id": {"contains_unsupported": 0.38062426698508756, "supported": 0.6193757330149126}, "prompt_sha256": "sha256:6d9fc80ffe44e5f4ed20d5540ab0a525b12bb245a5b294541e1a218a9cef9170", "prompt_token_count": 1505, "prompt_token_ids": [1890, 1386, 1761, 364, 279, 4434, 1965, 1608, 1132, 279, 16713, 2450, 13, 271, 41578, 198, 33387, 71351, 2640, 551, 5055, 424, 11, 1204, 488, 2493, 5596, 1204, 264, 5969, 1362, 56166, 264, 38130, 364, 264, 63221, 5849, 13, 71351, 1137, 279, 72024, 6075, 11, 22087, 11, 19874, 38423, 579, 25233, 12803, 314, 85199, 303, 279, 4397, 314, 264, 47629, 14765, 1137, 3125, 22786, 579, 328, 14917, 1, 1420, 6394, 421, 551, 1429, 310, 1683, 421, 11, 2166, 13, 328, 21002, 18575, 728, 1288, 551, 3125, 279, 1420, 303, 780, 1118, 10771, 2394, 1602, 11102, 303, 279, 5632, 220, 17, 4397, 314, 15768, 20425, 11, 328, 275, 628, 3420, 310, 5316, 1149, 20425, 8209, 1238, 71351, 6349, 1384, 1137, 31315, 11, 551, 2640, 1137, 1238, 7842, 680, 328, 51, 11737, 0, 345, 11737, 8687, 303, 264, 259, 1790, 273, 16508, 383, 264, 4142, 2407, 6053, 13, 71351, 3125, 24576, 421, 551, 8337, 1874, 780, 34428, 364, 279, 63221, 5849, 13, 2500, 3999, 369, 424, 310, 56166, 264, 5849, 364, 264, 345, 11737, 30, 5788, 71351, 369, 506, 279, 3990, 314, 279, 295, 5709, 32927, 888, 20425, 6, 4397, 11, 551, 4290, 914, 279, 1132, 799, 1172, 34472, 13, 561, 22087, 20036, 59225, 6587, 9892, 2272, 975, 9324, 6197, 303, 20425, 6, 4397, 11, 321, 264, 1528, 321, 6562, 8548, 1083, 279, 72024, 6075, 27744, 579, 7988, 579, 6179, 314, 38389, 13, 561, 38423, 579, 4998, 1048, 13325, 4924, 281, 2379, 974, 17821, 421, 70470, 998