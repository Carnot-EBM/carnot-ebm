33, 9464, 3691, 557, 2098, 6217, 321, 29171, 728, 314, 279, 2184, 71364, 3608, 806, 40341, 6574, 488, 615, 440, 1010, 4346, 314, 7502, 33847, 13, 8252, 1925, 471, 1546, 28196, 321, 43868, 11321, 1149, 92, 27573, 2374, 3147, 4887, 8934, 271, 65498, 24422, 198, 39, 2768, 42406, 18767, 369, 264, 35361, 1519, 323, 321, 7502, 10413, 7172, 303, 15521, 30089, 11, 8910, 13, 561, 10413, 5891, 264, 7792, 314, 24958, 2583, 3259, 428, 11, 270, 3001, 6387, 11, 509, 358, 39872, 11, 36555, 278, 2537, 11, 321, 4176, 276, 13, 561, 4861, 1048, 5469, 43868, 321, 28196, 2519, 13, 561, 10413, 682, 264, 41025, 16078, 440, 15325, 36064, 321, 1845, 16712, 25458, 13, 10235, 310, 5813, 8120, 11, 279, 3487, 369, 17387, 321, 90310, 440, 264, 4574, 7915, 314, 46942, 13, 561, 2393, 369, 4778, 321, 11321, 11, 321, 279, 7336, 513, 12891, 13, 561, 10413, 369, 1724, 6796, 1472, 7043, 11, 440, 11244, 3979, 383, 35774, 13, 1737, 44294, 513, 11330, 11, 321, 1831, 403, 369, 2420, 13, 26988, 11, 72770, 42406, 18767, 369, 264, 2172, 7458, 364, 1782, 3221, 364, 12826, 35361, 1519, 323, 321, 7502, 33847, 303, 264, 15855, 321, 34117, 4424, 13, 271, 55025, 198, 32, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 198, 33, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 12.601783752441406, " B": 15.686361312866211}, "raw_logits_by_option_id": {"contains_unsupported": 15.686361312866211, "supported": 12.601783752441406}, "readout_s": 3.593700057535898e-05, "request_id": "sha256:1a91b318f76cf1032d581de0", "requested_score_position": 880, "response_sha256": "sha256:5eff3e328a5c38e56efcf1006eec108b172381e95caea0ec5e47c36fe92d1a72", "response_text": "Himalayan Kitchen is a Nepalese and Indian restaurant located in Santa Barbara, CA. The restaurant offers a variety of dishes including momos, thukpa, chow mein, vindaloo, and naan. The menu also includes vegetarian and vegan options. The restaurant has a cozy atmosphere with outdoor seating and free Wi-Fi. According to customer reviews, the food is delicious and flavorful with a perfect balance of spices. The service is fast and friendly, and the prices are reasonable. The restaurant is open Monday through Sunday, with extended hours on weekends. Reservations are accepted, and takeout is available. Overall, Himalayan Kitchen is a great spot for those looking for authentic Nepalese and Indian cuisine in a casual and welcoming environment.", "role": "calibration_tuning", "sealed_prompt_sha256": "sha256:b4940c17b9685848c6f1b240cdc2c66dd8a7b01e7d7cf83f4ba975e3fb9427f1", "sealed_prompt_token_count": 881, "sentence_count": null, "sentence_version": null, "source_group_id": "group-2fcaee78390d52b290c800b0", "source_sha256": "sha256:c8b0d09587f8b2adcfbf012e8aa2080760ee0573513da43434f42f2903f7a088", "source_text": "{\"address\":\"431 State St\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":null,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":null,\"upscale\":false},\"BusinessParking\":{\"garage\":null,\"lot\":false,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":true,\"WiFi\":\"free\"},\"business_stars\":4.0,\"categories\":\"Restaurants, Indian, Himalayan/Nepalese\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"11:30-22:0\",\"Monday\":\"0:0-0:0\",\"Saturday\":\"11:30-22:0\",\"Sunday\":\"11:30-22:0\"},\"name\":\"Himalayan Kitchen\",\"review_info\":[{\"review_date\":\"2022-01-07 06:14:15\",\"review_stars\":5.0,\"review_text\":\"Great food and staff.I absolutely love momos  and thought this would be a good place to have them. We got the veg thupka  and momos. The thupka had just perfect balance between the noodles and vegetables. The food arrived in a very short time.Definitely recommend to go here.\"},{\"review_date\":\"2021-12-27 03:40:06\",\"review_stars\":4.0,\"review_text\":\"By looking in from outside as soon as they opened for dinner, I hesitated to go in. It was early and the restaurant was still had only a few customers. I was staying overnight in the area and I was new to the neighborhood. The food was excellent. One of the dishes we ordered along with chicken vindaloo, Aloo Govi, and naan, was Himalayan special chow meon. From the spicy level of 1-10, we chose 7. It was delicious but a bit too spicy for me to fully enjoy although I can proudly say I can handle spicy food. Maybe next time I will choose 5. The food was amazing with cold beer. The price was very reasonable too. By the time we were leaving, the restaurant was packed with customers.\"},{\"review_date\":\"2021-12-19 00:27:08\",\"review_stars\":5.0,\"review_text\":\"Really flavorful and interesting food. I got the vegetable curry. It was delicious and had a great depth of flavor. It was a bit oily, but not over-the-top. My friend ordered the ming bean noodle dish. It was really good as well, the flavor was a bit more tamed. It had a nice garlicky taste and the vegetables in it were delicious, especially the mushrooms which were perfectly saut\u00e9ed. The pickled vegetables condiment was really nice and reminded me of the super salty pickled lime skin you get with some types of Indian cuisine. Great place - very vegan and vegetarian friendly.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0022467429998869193, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 900, "archived_pilot_reuse": false, "arm": "focused_window", "attempte