 dining experience with a welcoming atmosphere. Its diverse menu, friendly service, and reasonable prices make it an ideal spot for families, couples, and solo diners alike.", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["contains_unsupported", "supported"], "order_remapping": {" A": "contains_unsupported", " B": "supported"}, "prefill_s": 1.343312137999419, "probabilities_by_option_id": {"contains_unsupported": 0.9665100347280149, "supported": 0.033489965271985084}, "prompt_sha256": "sha256:444069af1602c8aed44f8a02d15f48db031730a0310a5fa93730a77bc3669dd8", "prompt_token_count": 1130, "prompt_token_ids": [1890, 1386, 1761, 364, 279, 4434, 1965, 1608, 1132, 279, 16713, 2450, 13, 271, 41578, 198, 4754, 4834, 3147, 16, 15, 19, 24, 10731, 20575, 9675, 26577, 2129, 11987, 21624, 52218, 1772, 21624, 23543, 899, 763, 1802, 1288, 1005, 88, 763, 3721, 1288, 67, 520, 88, 763, 2827, 1288, 92670, 763, 3721, 1288, 390, 3316, 763, 3721, 1288, 433, 7902, 763, 3721, 1288, 49612, 84507, 763, 3721, 1288, 237419, 88, 763, 3721, 1288, 8339, 2174, 763, 3721, 49471, 22020, 91061, 21624, 11816, 416, 763, 3721, 1288, 8911, 763, 1802, 1288, 26466, 763, 3721, 1288, 6378, 1112, 763, 3721, 1288, 57576, 763, 3721, 49471, 23373, 763, 2827, 1288, 95130, 1460, 1060, 763, 1802, 1288, 12060, 32858, 14773, 2381, 21485, 763, 1802, 1288, 12060, 32858, 1026, 44294, 763, 3721, 1288, 12060, 32858, 17283, 2575, 763, 1802, 1288, 92247, 3147, 10279, 56658, 25316, 1217, 1506, 763, 19, 13, 20, 1288, 15042, 3147, 12060, 32858, 11, 14115, 40835, 11, 41767, 594, 3135, 3084, 11, 3567, 318, 81760, 77039, 8656, 3147, 34, 7628, 2173, 667, 2129, 29393, 21624, 33475, 3147, 22, 25, 15, 12, 16, 19, 25, 15, 2129, 32558, 3147, 22, 25, 15, 12, 16, 19, 25, 15, 2129, 34871, 3147, 22, 25, 15, 12, 16, 19, 25, 15, 2129, 36539, 3147, 22, 25, 15, 12, 16, 19, 25, 15, 2129, 