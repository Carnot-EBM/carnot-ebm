220, 17, 16, 12, 15, 1441, 11, 279, 17278, 34776, 995, 3679, 10175, 310, 2119, 279, 5284, 694, 998, 11550, 310, 6511, 1029, 13, 561, 4557, 10583, 15695, 276, 2181, 11687, 440, 264, 220, 16, 12, 20, 3150, 11, 1345, 279, 50237, 7481, 685, 310, 220, 19, 12, 17, 13, 1079, 34, 8778, 1730, 93291, 10580, 2372, 760, 17278, 34776, 668, 1381, 3460, 13219, 12673, 506, 57802, 1314, 53963, 8338, 506, 62178, 21933, 303, 12021, 41539, 1727, 6394, 11, 1345, 92120, 11947, 55842, 4726, 1413, 12673, 13, 271, 55025, 198, 32, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 198, 33, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 14.596776962280273, " B": 15.276288032531738}, "raw_logits_by_option_id": {"contains_unsupported": 14.596776962280273, "supported": 15.276288032531738}, "readout_s": 5.8229999922332354e-05, "request_id": "sha256:cee012b679b7a6446cfeba30", "requested_score_position": 596, "response_sha256": "sha256:801e367e0fe69fe885e48e22c5203df5d8eb3ac33fb0bbf98a5d253fd45372aa", "response_text": "Mahanoy Area High School's football team fell short in a comeback against Marian Catholic Colts, losing 21-13. Despite being 21-0 down, the Golden Bears had several opportunities to level the score but were unable to capitalise. The loss leaves Mahanoy Area with a 1-5 record, while the Colts moved up to 4-2. The Golden Bears will now face Williams Valley at Stauffenberg Field at Viking Stadium in Williamstown next Friday, while Marian faces Shenandoah Valley.", "role": "calibration_tuning", "sealed_prompt_sha256": "sha256:549086ee4c068ae1dbe49c0b00f3334a3beb8a6c2f4415ea20423c1042cef1b4", "sealed_prompt_token_count": 597, "sentence_count": 2, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-a5415b67218ea84d0c9addd9", "source_sha256": "sha256:c13c024067a8a3b0a269e13d2e3179ac4356d51ffb0e1f1465b6716accf49bf5", "source_text": "HS FOOTBALL: Mahanoy comeback falls short at Marian, Bears fall 21-13\nHOMETOWN \u2013 From being down 21-0, Mahanoy Area had multiple chances to come out of Hometown with a storybook comeback, but could never capitalize.\nThe Golden Bears entered Saturday\u2019s game with a 1-4 record as they visited the 3-2 Marian Catholic Colts.\nThe Colts struck first via a one yard run by senior fullback Jesse Rodino with under 7 minutes left in the first.\nFreshman running back Rory Dixon would find paydirt later in the first on a four yard run, set up by a long pass from senior quarterback Bruce Hopeck to senior receiver Brandon Klitsch.\nAnother short-yardage run by Dixon \u2014 who amassed 100 yards on the ground \u2014 would give the Colts a 21-0 advantage with 7:30 left in the second quarter.\nCue the start of a Golden Bear comeback.\nWith seconds left in the half, junior quarterback Levi Terry found a receiver Austin Green in the endzone to score.\nHalfway through the third quarter, senior running back Colm McGroarty punched it in from a yard out. With a failed point after, the Bears were down 21-7.\nA fumble on the ensuing Marian drive gave the Bears a chance to tie it up, but Marian\u2019s defense kept them at bay for the remainder of the game.\nThe Colts secured the victory 21-13 to move to 4-2 as the Bears fell to 1-5.\nMahanoy Area moved on to face Williams Valley at Stauffenberg Field at Viking Stadium in Williamstown next Friday, while Marian faces Shenandoah Valley.\nFull Photo Gallery\nThe post HS FOOTBALL: Mahanoy comeback falls short at Marian, Bears fall 21-13 appeared first on The Shenandoah Sentinel .", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0012575600003401632, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"},