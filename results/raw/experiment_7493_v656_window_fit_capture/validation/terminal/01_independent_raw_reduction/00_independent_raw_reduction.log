le": "training", "sealed_prompt_sha256": "sha256:43c63c8e467ab873e8094ac972a3df4ad9f59abe6a9d8d0f71a200414b29b6a3", "sealed_prompt_token_count": 913, "sentence_count": null, "sentence_version": null, "source_group_id": "group-44a5b8c1c8c886d70d124107", "source_sha256": "sha256:e4f535ee9a0d23e34e7caa5f4d445d681316f59e6dfae2ae95bdc2525667c914", "source_text": "{\"address\":\"7070 Marketplace Dr\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":false,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":false,\"RestaurantsGoodForGroups\":null,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":null},\"business_stars\":4.0,\"categories\":\"Restaurants, Food, American (New), Beer, Wine & Spirits\",\"city\":\"Goleta\",\"hours\":null,\"name\":\"Bevmo\",\"review_info\":[{\"review_date\":\"2021-06-29 01:27:33\",\"review_stars\":5.0,\"review_text\":\"Can't find a specific type of spirit for that recipe or cocktail? Bevmo probably carries it. \\n\\nI'm consistently in awe over just how much of a selection this place offers. It's very reminiscent of an ABC liquor store on the East coast where you feel as though you're in the king of them all. \\n\\nThis location is typically clean and quiet, with a good number of staff present. They are happy to recommend items for you if you're on your way to an event or are in the market for a gift. \\n\\nI'd recommend acquiring one of their frequent customer cards (which pair with your phone number, too). With the card, you'll be eligible for some awesome discounts. I love their penny wine sale, among other amazing members-only perks!\\n\\nGive this spot a try!\"},{\"review_date\":\"2020-06-13 07:23:57\",\"review_stars\":4.0,\"review_text\":\"Cashier on duty was super vigilant about keeping masks on which could be viewed many ways.  Found the wine selection to be pretty limited, bit they did have a rarer Amarone della Valpolicella wine from Italy.  We eventually won the girl over at the end when my dad tipped her for keeping us COVID safe -- this location was semi #declawed on cold White Claw, but they did have plenty on the back wall.  One of the smallest BEVMO's I've ever visited.\"},{\"review_date\":\"2020-06-13 02:34:04\",\"review_stars\":1.0,\"review_text\":\"Although, the lady in charge was nice and sweet, Adam has horrible service which is why I gave 1 star. Not very helpful at all, questioning the price of the items in the store as if I was lying, boxed my own items because I felt like he didn't want to, I should've just rung myself up to relieve him of his misery\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0023360019995379844, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 932, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 289, "byte_start": 0, "call_id": "sha256:2593d45a5f64c5b9f270a349", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-44a5b8c1c8c886d70d124107", "kv_state_id": "reset-epoch-390", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 4.063987731933594, "marked_response": "<<CARNOT_FOCUS_START:0:289>>Sure! Here's an objective overview of Bevmo based on the provided structured data in JSON format:\n\nBevmo is a Restaurants and Food business located in Goleta, CA, offering a wide selection of Americ