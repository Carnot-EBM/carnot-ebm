uest_id": "sha256:9c78146cccdc760e31b3b3b8", "requested_score_position": 990, "response_sha256": "sha256:ba29c43df7b424c38f67bdca246dc3c0d50eb895098e893503ff574d960821b6", "response_text": "Bettina is a restaurant located at 1014 Coast Village Road in Santa Barbara, California. The restaurant serves Italian cuisine and specializes in pizza. It is open Monday through Sunday from 4:00 PM to 8:30 PM. The restaurant offers outdoor seating, Wi-Fi, takeout options, and is suitable for groups. The restaurant has four and a half stars on Google and has received several positive reviews. One customer noted that the food was not the issue but the staff was flat, unengaging, and had a stuffy awkward energy. Another customer loved the pizza and the service, and appreciated the easy parking and charming ambiance. A third customer praised the restaurant's delicious food and charming atmosphere. Overall, Bettina appears to be a popular and well-regarded restaurant in Santa Barbara.", "role": "training", "sealed_prompt_sha256": "sha256:d58493bc10a4eca2b0b62662b3fc4b85ed329b3c475a1a9f7b6ba0fd5e02abc5", "sealed_prompt_token_count": 991, "sentence_count": 4, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-749869b78483b77e80fd464a", "source_sha256": "sha256:1548121a0f7db6b0273d57a7f1a09f16983bd52369474828ec553e148872e71b", "source_text": "{\"address\":\"1014 Coast Village Rd\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":true,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":true,\"valet\":true,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":true,\"WiFi\":\"free\"},\"business_stars\":4.5,\"categories\":\"Restaurants, Italian, Pizza\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"16:0-20:30\",\"Monday\":\"0:0-0:0\",\"Saturday\":\"16:0-20:30\",\"Sunday\":\"16:0-20:30\",\"Thursday\":\"16:0-20:30\",\"Tuesday\":\"16:0-20:30\",\"Wednesday\":\"16:0-20:30\"},\"name\":\"Bettina\",\"review_info\":[{\"review_date\":\"2022-01-14 02:46:25\",\"review_stars\":1.0,\"review_text\":\"The hype is over for this place. Local, who used to use this place for everything, and a spot to celebrate girlfriends birthdays. The food was not the issue. The staff is flat, unengaging and silent. You can feel their stuffy awkward energy. As someone who used to be a server myself, I always love being courteous to server staff/tipping well. But man, very hard to do here.\"},{\"review_date\":\"2022-01-10 20:40:01\",\"review_stars\":5.0,\"review_text\":\"Omg I'm a hard core pizza aficionado and this could be my new favorite pizza place in North America. Don't let it's location in the Montecito Country Mart fool you, please make a reservation asap. \\n\\nThe menu is very tight but that's fine. Everyone raves about the carbonara pizza but I hate eggs do we skipped it. We wanted a light lunch to save room for steak dinner so we opted for a bottle of Sancerre, baby gems salad and meat lovers pizza. They all hit perfectly!\\n\\nThe server was terrific. The ambiance felt like a garden getaway and parking was too easy. Please run to this lovely restaurant and grab a matchbox or two for the memories.\"},{\"review_date\":\"2022-01-06 05:51:02\",\"review_stars\":5.0,\"review_text\":\"Decided to check out Bettina during our recent trip to Santa Barbara and boy was it a great experience. The location is random (in the Montecito country mart shopping center) but the inside and the courtyard of the restaurant are charming. And we figured we came to a good spot when we noticed all the locals either dining there or picking up pies. Everything we ordered was delicious! We got the burrata to start, that had this amazing green pistachio/veggie paste on top - it also came with an excellent Focaccia. Broccolini, which was tangy, charred to perfection and just delish.  And two pizzas, the mushroom and pepperoni, which may have been the best I've had. Great little spot in SB, highly recommend.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0018056150001939386, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 0, "window_sha256": "sha256:a4f1f2f1f3f3339e6895e0e74c25a281673fdef27ce5d72db6529772cd4a1819", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 992, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 516, "byte_start": 302, "call_id": "sha256:cad29f948c99dcf335507f31", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-749869b78483b77e80fd464a", "kv_state_id": "reset-epoch-631", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 0.9013872146606444, "marked_response": "Bettina is a restaurant located at 1014 Coast Village Road in Santa Barbara, California. The restaurant serves Italian cuisine and specializes in pizza. It is open Monday through Sunday from 4:00 PM to 8:30 PM. The restaurant offers outdoor seating, Wi-Fi, takeout options, and is suitable for groups. <<CARNOT_FOCUS_START:302:516>>The restaurant has four and a half stars on Google and has received several positive reviews. One customer noted that the food was not the issue but the staff was flat, unengaging, and had a stuffy awkward energy. <<CARNOT_FOCUS_END>>Another customer loved the pizza and the service, and appreciated the easy parking and charming ambiance. A third customer praised the restaurant's delicious food and charming atmo