45, 6977, 440, 279, 17465, 314, 279, 4893, 12893, 364, 10652, 579, 57259, 45790, 321, 2843, 279, 777, 30415, 4893, 8872, 314, 10652, 579, 57259, 45790, 40038, 24745, 318, 3794, 54, 1178, 553, 1577, 1575, 430, 303, 9169, 11, 3096, 579, 8229, 45790, 18456, 303, 22218, 321, 975, 5306, 314, 279, 1639, 1639, 2129, 7593, 3147, 12195, 3087, 1467, 26595, 524, 599, 1518, 279, 8229, 45790, 6977, 8934, 271, 65498, 24422, 198, 9923, 279, 8229, 45790, 6977, 11, 3096, 1467, 524, 599, 279, 1245, 310, 6695, 11, 944, 364, 264, 5214, 18489, 11, 466, 1765, 836, 1765, 3234, 13, 9358, 11876, 11, 781, 5384, 660, 836, 3087, 310, 6266, 364, 5402, 321, 998, 524, 5252, 310, 1777, 16577, 13, 2302, 998, 3481, 310, 1132, 599, 11435, 303, 279, 2046, 11, 836, 2748, 11, 321, 836, 58804, 13, 271, 55025, 198, 32, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 198, 33, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 13.490403175354004, " B": 17.27484130859375}, "raw_logits_by_option_id": {"contains_unsupported": 13.490403175354004, "supported": 17.27484130859375}, "readout_s": 3.8160999793035444e-05, "request_id": "sha256:39cce81b0a6a01b056863123", "requested_score_position": 604, "response_sha256": "sha256:1ef989d9c2645b069d759c25d417efed688d705edddd5349bc035131c2c1e4d8", "response_text": "Before the suffrage movement, women did not have the right to vote, work for a living wage, or own their own property. Once married, they lost all their rights to speak for themselves and were not allowed to sign contracts. They were expected to only have interests in the home, their children, and their husbands.", "role": "training", "sealed_prompt_sha256": "sha256:42c2ddbf0bbd98ce3d55d3d9496af0424cb9a04f3e987d205949193868937fb9", "sealed_prompt_token_count": 605, "sentence_count": null, "sentence_version": null, "source_group_id": "group-96e371a93ae2d81f37a9c76e", "source_sha256": "sha256:7d91aa6641e3b156ef5a16fe80a47602e3e99da8d9fff893679312b88853637f", "source_text": "{\"passages\":\"passage 1:In the 1800s, women fought for the rights to vote and be considered equal partners to men. Encompassed in equality, women fought for the right to own property, keep wages and sign a contract. Before the suffrage movement that took place during many decades in the 1800s, women were expected only to have interests in the home, their children and their husbands. They were not allowed to vote, work for a living wage or own their own property. After women were married, they lost all of their rights to be able to speak for themselves and were not even allowed to sign contracts. During this time, not all women wanted to marry, have children and run a home. They wanted to be able to support themselves and gain access to money without a husband. Women wanted to be treated equally to men and these women started the suffrage movement. It was one of the largest civil movements in the United States, and it eventually led to the biggest change in the way politics were decided.\\n\\npassage 2:After the war, woman suffrage endured another setback, when the women\u2019s rights movement found itself divided over the issue of voting rights for black men. Stanton and some other suffrage leaders objected to the proposed 15th Amendment to the U.S. Constitution, which would give black men the right to vote, but failed to extend the same privilege to American women of any skin color.\\n\\npassage 3:Women's suffrage in the United Kingdom. Women's suffrage in the United Kingdom was a movement to give women the right to vote. It finally succeeded through two laws in 1918 and 1928. It became a national movement in the Victorian era. Women were not explicitly banned from voting in Great Britain until the 1832 Reform Act and the 1835 Municipal Corporations Act. In 1872 the fight for women's suffrage became a national movement with the formation of the National Society for Women's Suffrage and later the more influential National Union of Women's Suffrage Societies (NUWSS). As well as in England, women's suffrage movements in Wales and other parts of the\\n\\n\",\"question\":\"what rights did females not have before the suffrage movement\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0013096630000291043, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 624, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 119, "byte_start": 0, "call_id": "sha256:ef87298110070dd603136dc8", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-96e371a93ae2d81f37a9c76e", "kv_state_id": "reset-epoch-816", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": -2.1313867568969727, "marked_response": "<<CARNOT_FOCUS_START:0:119>>Before the suffrage movement, women did not have the right to vote, work for a living wage, or own their own property. <<CARNOT_FOCUS_END>>Once married, they lost all their rights to speak for themselves and were not allowed to sign contracts. They were expected to only have interests in the home, their children, and their husbands.", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["contains_unsupported", "supported"], "order_remapping": {" A": "contains_unsupported", " B": "supported"}, "prefill_s": 0.7551717860005738, "probabilities_by_option_id": {"contains_unsupported": 0