, 25, 20, 17, 16, 25, 16, 15, 17, 21, 2372, 6651, 1048, 24986, 279, 11321, 321, 21630, 518, 16078, 314, 279, 2902, 27760, 321, 1542, 20616, 13, 4558, 1860, 279, 975, 1375, 11, 2361, 5813, 995, 264, 7968, 3039, 13, 2302, 1669, 279, 3487, 310, 381, 10639, 303, 4131, 321, 777, 11064, 13, 2302, 998, 23630, 440, 279, 32407, 25070, 30870, 11, 864, 781, 6273, 557, 70939, 303, 13696, 466, 60269, 13, 561, 211451, 14151, 472, 209608, 557, 1172, 95285, 321, 46399, 16666, 11, 321, 279, 29634, 15530, 557, 25774, 13, 22677, 11, 279, 5813, 10015, 21654, 75073, 1238, 32979, 279, 3487, 506, 2046, 13, 271, 2362, 34, 8778, 1730, 93291, 10580, 2372, 13634, 5813, 995, 264, 6572, 3039, 506, 92463, 6383, 579, 24678, 11, 21988, 279, 3487, 430, 37567, 321, 8343, 3567, 14382, 33847, 506, 264, 2172, 3240, 13, 2302, 13604, 279, 12668, 216996, 66433, 11, 83910, 321, 12668, 44001, 11, 321, 10212, 314, 1262, 14670, 588, 18594, 13, 561, 3655, 382, 998, 70324, 11, 321, 279, 16078, 557, 34117, 321, 55867, 13, 561, 1132, 49667, 781, 9444, 557, 279, 45322, 12293, 314, 279, 2919, 13, 271, 26597, 11, 92463, 6383, 579, 24678, 682, 3816, 449, 5289, 10412, 314, 220, 18, 13, 15, 9467, 13, 5788, 1010, 6112, 599, 995, 6572, 11120, 440, 279, 3487, 321, 16078, 11, 3672, 599, 978, 23630, 440, 279, 4131, 321, 3240, 13, 271, 55025, 198, 32, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 198, 33, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 15.062643051147461, " B": 15.672938346862793}, "raw_logits_by_option_id": {"contains_unsupported": 15.062643051147461, "supported": 15.672938346862793}, "readout_s": 3.4233999940624926e-05, "request_id": "sha256:a0c6e12d5bfa363ef3ad78ea", "requested_score_position": 1211, "response_sha256": "sha256:bdc5faa19de0e91cec37286b5c545c8198cc2a77bf363f1e3df7170ef82572dc", "response_text": "Petrini's Restaurant is a local business located at 5711 Calle Real in Goleta, CA. It is an American (New), Italian, and pizza restaurant. The restaurant is open from 16:30-21:00 from Monday to Sunday, except for Friday when it closes at 21:30. \n\nCustomers have left mixed reviews about Petrini's Restaurant. One customer was pleasantly surprised by the quality of the food, describing it as fresh and delicious. They particularly enjoyed the onion and cheese pizza, as well as the salads, pasta, garlic bread, and wine. They also appreciated the friendly and cordial atmosphere of the family-owned and run establishment. \n\nOn the other hand, another customer had a negative experience. They found the food to be worse in quality and more expensive. They were disappointed with the Chicken Picatta, which they felt was drowning in butter or grease. The fettuccine Alfredo was undercooked and lacked flavor, and the garlic bread was burned. Furthermore, the customer experienced stomach ache after consuming the food at home.\n\nAnother customer had a positive experience at Petrini's Restaurant, describing the food as tasty and traditional American Italian cuisine at a great price. They enjoyed the meat raviolis, spaghetti and meatballs, and cup of minestrone soup. The waiters were attentive, and the atmosphere was welcoming and tidy. The only downside they mentioned was the unpleasant taste of the water.\n\nOverall, Petrini's Restaurant has received an average rating of 3.0 stars. While some customers have had positive experiences with the food and atmosphere, others have been disappointed with the quality and price.", "role": "training", "sealed_prompt_sha256": "sha256:d94489f767cdfb75282c4de6df625d34488a8dad1b663d0740f5a1c63ce4e1fc", "sealed_prompt_token_count": 1212, "sentence_count": 6, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-e889f43867fa9e5b2e0eb3c0", "source_sha256": "sha256:66ad5ec66f78672f4841878bd8a024e89d487da658c0aca42b987150f5088ed5", "source_text": "{\"address\":\"5711 Calle Real\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":false,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":true,\"WiFi\":\"free\"},\"business_stars\":3.0,\"categories\":\"American (New), Italian, Restaurants, Pizza\",\"city\":\"Goleta\",\"hours\":{\"Friday\":\"16:30-21:30\",\"Monday\":\"16:30-21:0\",\"Saturday\":\"16:30-21:0\",\"Sunday\":\"16:30-21:0\",\"Thursday\":\"16:30-21:0\",\"Tuesday\":\"16:30-21:0\",\"Wednesday\":\"16:30-21:0\"},\"name\":\"Petrini's Restaurant\",\"review_info\":[{\"review_date\":\"2016-09-02 07:51:10\",\"review_stars\":5.0,\"review_text\":\"I tend not to expect much from food locations in Strip Malls.  While staying in the Santa Barbara area, I just wanted a good piece of Pizza. We stopped here while on a walk and ordered an onion and cheese pizza, small size.  Neither of us could believe how fresh and great it was! The sauce was a good homemade red with Italian spices and fresh tomato flavor. Just enough good cheese.  We stopped in twice after having such great luck.  Tried the salads, pasta and more pizza, garlic bread and wine.  Family owned and run place that's cordial and homey.   This is the kind of place you find in Chicago and New York. Just a little gem with friendly people and really good Italian food!\"},{\"review_date\":\"2016-08-17 01:35:09\",\"review_stars\":1.0,\"review_text\":\"Well, I tried eating at this Petrini's again, and I'm really sad to report that the food has gotten worse AND more expensive. The Chicken Picatta was drowning in butter, or grease; I'm not sure what that was. The fettuccine Alfredo that came with it was undercooked and had zero taste. We also were served garlic bread that was burned to black. To make things worse, I took the food home because I just could eat it at the restaurant. I was hungry later so I ate it. \\nOh My God.....I couldn't keep it down. I got such a stomach ache from that food. Petrini's , you are a local restaurant and I really try to support local businesses, but you are bad for my health.\"},{\"review_date\":\"2016-07-11 15:51:04\",\"review_stars\":4.0,\"review_text\":\"I have not been in here for many years, but we stopped in the other night and it was tasty traditional american italian food for a great price. The meat raviolis were very tender and delicious and the sauce was spot on. The spaghetti and meatballs (the yard stick for any italian review) were also very good. I also really enjoyed my cup of minestrone soup, really hit the spot. The waiters were very attentive and the place had a very welcoming and tidy atmosphere. \\n\\nThe only downside, the water tasted horrible, I think they need to replace their filter or something.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0020146529996054596, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 1, "window_sha256": "sha256:e421f015d8f731b617d9db89d851c34db38e7fbf9530f5cc3252cae6aefa428a", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 1212, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 1624, "byte_start": 1026, "call_id": "sha256:300ea39f10834ab4b2e34393", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-e889f43867fa9e5b2e0eb3c0", "kv_state_id": "reset-epoch-1288", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": -0.9108905792236328, "marked_response": "Petrini's Restaurant is a local business located at 5711 Calle Real in Goleta, CA. It is an American (New), Italian, and pizza restaurant. The restaurant is open from 16:30-21:00 from Monday to Sunday, except for Friday when it closes at 21:30. \n\nCustomers have left mixed reviews about Petrini's Restaurant. One customer was pleasantly surprised by the quality of the food, describing it as fresh and delicious. They particularly enjoyed the onion and cheese pizza, as well as the salads, pasta, garlic bread, and wine. They also appreciated the friendly and cordial atmosphere of the family-owned and run establishment. \n\nOn the other hand, another customer had a negative experience. They found the food to be worse in quality and more expensive. They were disappointed with the Chicken Picatta, which they felt was drowning in butter or grease. The fettuccine Alfredo was undercooked and lacked flavor, and the garlic bread was burned. Furthermore, the customer experienced stomach ache after consuming the food at home.\n\n<<CARNOT_FOCUS_START:1026:1624>>Another customer had a positive experience at Petrini's Restaurant, describing the food as tasty and traditional American Italian cuisine at a great price. They enjoyed the meat raviolis, spaghetti and meatballs, and cup of minestrone soup. The waiters were attentive, and the atmosphere was welcoming and tidy. The only downside they mentioned was the unpleasant taste of the water.\n\nOverall, Petrini's Restaurant has received an average rating of 3.0 stars. While some customers have had positive experiences with the food and atmosphere, others have been disappointed with the quality and price.<<CARNOT_FOCUS_END>>", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["contains_unsupported", "supported"], "order_remap