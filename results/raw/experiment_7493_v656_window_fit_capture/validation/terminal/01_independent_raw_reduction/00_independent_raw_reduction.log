I go they tell me that things are going to be done at exactly 1pm (which may be over 30 mins away)...its especially frustrating when these should be (and probably are) the money makers for the business. Teriyaki chicken? ITS CHICKEN, why is this not in abundance?? Why does the business run out of it!??! Why is there a 50 cents extra charge for the simplest menu item??! I can't make sense of it, I won't be going back, it is simply absurd.\"},{\"review_date\":\"2012-10-05 21:11:32\",\"review_stars\":3.0,\"review_text\":\"Best place to eat anywhere near UCSB. It's cheap, it tastes awesome, and the service is fast and good. Everything tastes fresh, unlike Panda Express. Too bad it's gone now.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0016346560005331412, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 2, "window_sha256": "sha256:7cd7535bfc9d4690ff181c40f3912822de646dfbf3c9db5105abf8cd2de8b216", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 880, "archived_pilot_reuse": false, "arm": "whole_response", "attempted": true, "byte_end": null, "byte_start": null, "call_id": "sha256:a5fd3c29188321135c4da6a3", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-c06b99ada59f358e728a94e1", "kv_state_id": "reset-epoch-1053", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": 3.473170280456543, "marked_response": null, "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["con