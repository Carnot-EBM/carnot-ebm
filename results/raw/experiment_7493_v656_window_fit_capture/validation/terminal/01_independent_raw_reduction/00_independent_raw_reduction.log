ic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":false,\"street\":false,\"valet\":false,\"validated\":true},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":\"paid\"},\"business_stars\":3.5,\"categories\":\"Fast Food, Caterers, Chinese, Szechuan, Event Planning & Services, Restaurants\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"10:0-17:0\",\"Monday\":\"10:0-17:0\",\"Thursday\":\"10:0-17:0\",\"Tuesday\":\"10:0-17:0\",\"Wednesday\":\"10:0-17:0\"},\"name\":\"Rice Garden\",\"review_info\":[{\"review_date\":\"2013-06-08 01:53:14\",\"review_stars\":3.0,\"review_text\":\"Its a shame, this place used to be so much better last year. They had a much wider variety last year. The curry chicken tasted almost like authentic chinese, and I enjoyed the Spicy Chicken every time. They switched around the menu, but usually they had 2 very good items everyday.\\n\\nNow, its pretty much the same generic items everyday. On top of that, they are almost always sold out, whether because its rush lunch hour, or its after 2 or 3 and they just give up making half the menu.\\n\\nI hear its getting replaced by Yoshinoya. I am glad because I love Yoshinoya.\"},{\"review_date\":\"2013-03-07 21:26:31\",\"review_stars\":1.0,\"review_text\":\"I would say the food was good if I could ever have it. Every time I go to this place they are \\\"out\\\" of what I want, nothing on deck, just simply out. Some times when I go they tell me that things are going to be done at exactly 1pm (which may be over 30 mins away)...its especially frustrating when these should be (and probably are) the money makers for the business. Teriyaki chicken? ITS CHICKEN, why is this not in abundance?? Why does the business run out of it!??! Why is there a 50 cents extra charge for the simplest menu item??! I can't make sense of it, I won't be going back, it is simply absurd.\"},{\"review_date\":\"2012-10-05 21:11:32\",\"review_stars\":3.0,\"review_text\":\"Best place to eat anywhere near UCSB. It's cheap, it tastes awesome, and the service is fast and good. Everything tastes fresh, unlike Panda Express. Too bad it's gone now.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0016731679997974425, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 900, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 229, "byte_start": 0, "call_id": "sha256:55a7b632173322d9c669324b", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-c06b99ada59f358e728a94e1", "kv_state_id": "reset-epoch-1050", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 3.170970916748047, "marked_response": "<<CARNOT_FOCUS_START:0:229>>Rice Garden is a restaurant located in Santa Barbara, California. They offer fast food, catering services, and Chinese cuisine with options in Szechuan and event planning. They have outdoor seating and takeout options available. <<CARNOT_FOCUS_END>>According to their attributes, they do not offer parking options but valet services are available. WiFi is also available for customers who need to stay connected while dining. Their menu consists of a variety of items and is constantly changing. Some customers have reported issues with the restaurant being sold out during peak hours or not having the desired menu items in stock. However, other customers have praised the quality of the food and the fast service. O