A": 12.741716384887695, " B": 16.865028381347656}, "raw_logits_by_option_id": {"contains_unsupported": 16.865028381347656, "supported": 12.741716384887695}, "readout_s": 3.529700006765779e-05, "request_id": "sha256:f8df40c0967365dcf9f667af", "requested_score_position": 912, "response_sha256": "sha256:679df2d90a9055f5a53f69fe5260fab1adadde0928e95f1bdab66dc354a30ead", "response_text": "Ruby's Diner is a restaurant located at 601 Paseo Nuevo in Santa Barbara, California. They are open for business during regular operating hours, but their specific hours are not available online. Ruby's Diner serves a variety of foods such as burgers, sandwiches, salads, and desserts. They offer takeout services, but they do not provide outdoor seating or Wi-Fi. Customers can park their cars in the street, garage, lot, or valet area, although validated parking options are not available. Ruby's Diner has an average rating of 3.5 stars on Google, based on customer reviews. Some customers have complained about the cleanliness of the restaurant, stating that the floors, tables, counter, and salsa bar were dirty. Others have noted that the food quality was average, and that there didn't seem to be any fresh ingredients used in their dishes. However, some customers have praised the ambiance and service at Ruby's Diner, describing it as trendy and clean. Overall, Ruby's Diner appears to be a casual dining option for individuals looking for a quick meal.", "role": "training", "sealed_prompt_sha256": "sha256:d46abf5d840aaeb91ef2c6c1d0105afea602a061957b233feb09d05a9cad0c99", "sealed_prompt_token_count": 913, "sentence_count": 4, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-177bb8068f895cd4d49db911", "source_sha256": "sha256:72d394a07f0af88f6e0424156ffae29617da7d9e9f57801dcbf1b8f2e8963f1d", "source_text": "{\"address\":\"601 Paseo Nuevo\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":false,\"street\":false,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":null,\"RestaurantsGoodForGroups\":false,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":\"no\"},\"business_stars\":3.5,\"categories\":\"Restaurants\",\"city\":\"Santa Barbara\",\"hours\":null,\"name\":\"Ruby's Diner\",\"review_info\":[{\"review_date\":\"2011-04-14 00:50:08\",\"review_stars\":2.0,\"review_text\":\"Where do the good reviews come from?\\n\\nDirty floors, tables, counter and salsa bar.Yuck.\\nNot sure if anything is fresh other than the cilantro. \\nThe Three Amigo burrito is as big as three friends but the inside is more like shoe letter. Packed with dry chicken and steak that could have been sitting for days. At least simmer in juices so it's softer. This puppy is as dry as the Mexican desert. The shrimp was ok and it was nice the rice was light. Definitely needed drowning from the salsa bar to help it down.\\n\\nNothing impressed me and I don't know what kind of repeat business Rubys gets. It wont be from me.\"},{\"review_date\":\"2008-09-04 16:03:53\",\"review_stars\":3.0,\"review_text\":\"It's a diner.  Our hotel gave us a map with restaurants and things to see and do in Santa Barbara.  I read about this diner.  The map said it was a 1940's diner.  SO OF COURSE WE HAD TO GO!  But, it was not. \\n\\nIt's one of those chain diners with new but vintage looking decor. \\n\\nI had a cheeseburger, Gary had a tuna melt.  The food was average diner food.  Not bad, not fantastic. \\n\\nGary knew I was sad that it wasn't a 1940's diner and he pointed out a sign that said Independently Operated. That made me feel a little better.\"},{\"review_date\":\"2008-07-24 21:58:55\",\"review_stars\":4.0,\"review_text\":\"It's a diner.  Come for a burger, fries, and a shake.  Food isn't too greasy and it's always satisfying.  The place is clean and service isn't bad.  Kind of expensive, but my stomach doesn't complain.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0016743569995014695, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 0, "window_sha256": "sha256:74d184e00a350c6d64d8ad07a69b066d6dc3517df306a981d158ac67e898512c", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 914, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 718, "byte_start": 365, "call_id": "sha256:2ee10d4445ed9d4f0a1fc874", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-177bb8068f895cd4d49db911", "kv_state_id": "reset-epoch-135", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 4.420299530029297, "marked_response": "Ruby's Diner is a restaurant located at 601 Paseo Nuevo in Santa Barbara, California. They are open for business during regular operating hours, but their specific hours are not available online. Ruby's Diner serves a variety of foods such as burgers, sandwiches, salads, and desserts. They offer takeout services, but they do not provide outdoor seating or Wi-Fi. <<CARNOT_FOCUS_START:365:718>>Customers can park their cars in the street, garage, lot, or valet area, although validated parking options are not available. Ruby's Diner has an average rating of 3.5 stars on Google, based on customer reviews. Some customers have complained about the cleanliness of the restaurant, stating that the floors, tables, counter, and salsa bar were dirty. <<CARNOT_FOCUS_END>>Others have noted that the food quality was average, and that there didn't seem 