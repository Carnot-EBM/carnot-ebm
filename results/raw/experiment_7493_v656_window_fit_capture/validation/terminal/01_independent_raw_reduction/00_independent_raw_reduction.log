 salted of all. \\n\\nOh yeah, $13.68 for the strami and diet Coke. Really?\\n\\nWon't be back unless I want to jack up my blood pressure.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0014516139999614097, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 2, "window_sha256": "sha256:ff34a060ea7f333047bd48085754c3f8f44a410d2f05ab637fc777ba651dac9c", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 741, "archived_pilot_reuse": false, "arm": "whole_response", "attempted": true, "byte_end": null, "byte_start": null, "call_id": "sha256:c3903a1d75316f31ccc123fd", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-ce8b5eea8e35900c23923947", "kv_state_id": "reset-epoch-1773", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": 4.407336235046387, "marked_response": null, "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["contains_unsupported", "supported"], "order_remapping": {" A": "contains_unsupported", " B": "supported"}, "prefill_s": 0.892225829000381, "probabilities_by_option_id": {"contains_unsupported": 0.987959149044792, "supported": 0.012040850955208036}, "prompt_sha256": "sha256:98337873c82dc5268dcd1329764aaa4caddb51fb8ac185797c6ea134837365d2", "prompt_token_count": 742, "prompt_token_ids": [1890, 1386, 1761, 364, 279, 4434, 1965, 1608, 1132, 279, 16713, 2450, 13, 271, 41578, 198, 4754, 4834, 3147, 17, 17, 21, 326, 9846, 39744, 769, 2129, 11987, 21624, 52218, 17