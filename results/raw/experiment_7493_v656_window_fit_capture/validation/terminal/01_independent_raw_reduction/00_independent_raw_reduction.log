53, 3272, 353, 6661, 264, 1603, 6885, 6628, 2980, 353, 3571, 1532, 13, 357, 2612, 383, 279, 75675, 3008, 694, 1575, 5621, 424, 13, 1165, 5904, 424, 440, 1010, 27323, 4065, 13, 561, 27323, 4065, 557, 4574, 11, 694, 2166, 9922, 466, 2166, 43325, 13, 561, 2393, 557, 3841, 321, 4145, 13, 1165, 4035, 8231, 2445, 1142, 1532, 279, 1727, 854, 567, 2224, 303, 279, 2982, 1149, 92, 27573, 2374, 3147, 4887, 8934, 271, 65498, 24422, 198, 4122, 235840, 369, 264, 5243, 14712, 14795, 299, 10413, 7172, 303, 15521, 30089, 11, 6824, 13, 2985, 264, 10412, 314, 220, 19, 13, 20, 9467, 11, 424, 5891, 264, 4752, 17378, 3039, 440, 449, 15325, 30158, 11, 3807, 25244, 11, 321, 78563, 364, 264, 41025, 16078, 13, 561, 10413, 369, 3750, 364, 1141, 1496, 21408, 13565, 321, 11190, 24958, 11, 2583, 8343, 14712, 25726, 1680, 430, 19406, 263, 44854, 321, 168445, 12859, 23702, 13, 561, 8120, 4052, 421, 279, 10413, 579, 3487, 369, 17387, 11, 7695, 279, 3851, 20959, 72, 11, 8881, 64, 401, 57713, 11, 321, 20968, 319, 2526, 46721, 13, 4213, 11, 1010, 57043, 1669, 279, 3526, 379, 15220, 6628, 310, 381, 632, 36208, 470, 13, 561, 2393, 369, 11321, 321, 10727, 11, 321, 279, 10413, 5891, 264, 7792, 314, 2519, 364, 12625, 28564, 321, 45761, 581, 13, 5788, 1010, 57043, 1669, 279, 7336, 310, 381, 264, 2612, 30239, 11, 1379, 7268, 421, 424, 579, 5621, 279, 3117, 364, 264, 3175, 12723, 13, 271, 55025, 198, 32, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 198, 33, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 16.5590877532959, " B": 10.968389511108398}, "raw_logits_by_option_id": {"contains_unsupported": 16.5590877532959, "supported": 10.968389511108398}, "readout_s": 5.899099960515741e-05, "request_id": "sha256:89a07315f448fa1840180d12", "requested_score_position": 1101, "response_sha256": "sha256:c12745a53f1cd1e4820dbf873698d9a3366577c6eb44aacfba22cde8cf007b82", "response_text": "Loquita is a popular Spanish tapas restaurant located in Santa Barbara, California. With a rating of 4.5 stars, it offers a unique dining experience with an outdoor patio, fireplaces, and heaters for a cozy atmosphere. The restaurant is known for its high-quality ingredients and creative dishes, including traditional Spanish favorites such as Jamon tasting and Manchego plates. The reviews suggest that the restaurant's food is delicious, particularly the El Bulli, Baya de Oro, and Datil small bites. However, some reviewers found the Pollo Paella to be unremarkable. The service is friendly and efficient, and the restaurant offers a variety of options for vegetarians and vegans. While some reviewers found the prices to be a bit steep, most agree that it's worth the money for a special occasion.", "role": "training", "sealed_prompt_sha256": "sha256:a803159ce3d9e790355810421d84d8d32310e9716c218761fc8e6e22ab8ce44c", "sealed_prompt_token_count": 1102, "sentence_count": null, "sentence_version": null, "source_group_id": "group-6b1ad4ce4faca0443395bebe", "source_sha256": "sha256:16cdb44be8b4d81ffb134a04f2b6fffc8333c3cac6ae6a4978a3d20d527541ee", "source_text": "{\"address\":\"202 State St\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":true,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":true,\"touristy\":false,\"trendy\":true,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":false,\"street\":true,\"valet\":true,\"validated\":false},\"Music\":false,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":null,\"WiFi\":\"no\"},\"business_stars\":4.5,\"categories\":\"Event Planning & Services, Nightlife, Tapas Bars, Spanish, Modern European, Bars, Cocktail Bars, Seafood, Venues & Event Spaces, Restaurants\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"17:0-22:0\",\"Monday\":\"0:0-0:0\",\"Saturday\":\"17:0-22:0\",\"Sunday\":\"17:0-21:0\",\"Thursday\":\"17:0-21:0\",\"Tuesday\":\"17:0-21:0\",\"Wednesday\":\"17:0-21:0\"},\"name\":\"Loquita\",\"review_info\":[{\"review_date\":\"2022-01-17 17:20:15\",\"review_stars\":4.0,\"review_text\":\"Came to loquita for the first time in SB. It's a very nice Spanish tapas restaurant with and outdoor patio and lots of fireplaces and heaters to keep guests warm at night. We ordered the el bulli, baya de oro and datil as small bites to start off the night. My favorite was the datil and the el bulli was an interesting citrus caviar but I didn't think it was mind blowing. Don't skip out on the Jamon tasting and manchego! The jamon tasting is perfect for 2 people and comes with plenty of meat (iberico, Serrano, and chorizo and pan con tomate). The manchego tasting plate was amazing and came with the best accompaniments! The almonds were out of this world and was cooked with a lavender type glaze on them which paired well with the cheese. Also, try the pulpo and churros to round off your meal. The pulpo was super tender and crisp and the churros were plenty to share. I even got to take the leftovers home for snacking later. Don't get the patatas bravas! I thought it was going to be more like a hash brown from previous photos but we got more smashed potatoes covered in like a hot mayo sauce! Definitely could have skipped on that one. Overall, it's a great dinner spot and was enjoyable on a Sunday night out.\"},{\"review_date\":\"2022-01-16 06:02:30\",\"review_stars\":3.0,\"review_text\":\"Was a nice atmosphere. Appreciated the outdoor dining and they are very thoughtful about having ample heaters to make sure diners are warm. \\n\\nStaff was nice. \\n\\nFood was slightly disappointing:\\n\\nEl bulli: felt like simple tangerine pulp with a micro basil leaf\\nCrudo: seafood is my jam and brininess is delish but the fish in this Crudo tasted fishy and felt like a coarse hunk of fish that wasn't cured at all in acid\\nPollo paella: wasn't bad but wasn't something to write home about\\nChurros: batter seemed very good but was burned with burnt flavor\\nBasque cheesecake: delicious! Light and not too sweet\"},{\"review_date\":\"2022-01-13 03:51:35\",\"review_stars\":4.0,\"review_text\":\"This place has the best food! I thought I knew a good paella until I came here. A bit on the pricey side but well worth it. We shared it with some sangria. The sangria was perfect, but too sweet or too tart. The service was quick and simple. We'd definitely come back here the next time we're in the area.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0020061929999428685, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 1121, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 219, "byte_start": 0, "call_id": "sha256:dde05f81c94f61f41ff3dc8e", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-6b1ad4ce4faca0443395bebe", "kv_state_id": "reset-epoch-602", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": 5.186800956726074, "marked_response": "<<CARNOT_FOCUS_START:0:219>>Loquita is a popular Spanish tapas restaurant located in Santa Barbara, California. With a rating of 4.5 stars, it offers a unique dining experience with an outdoor patio, fireplaces, and heaters for a cozy atmosphere. <<CARNOT_FOCUS_END>>The restaurant is known for its high-quality ingredients and creative dishes, including traditional Spanish favorites such as Jamon tasting and Manchego plates. The reviews suggest that the restaurant's food is delicious, particularly the El Bulli, Baya de Oro, and Datil small bites. However, some reviewers found the Pollo Paella to be unremarkable. The service is friendly and efficient, and the restaurant offers a variety of options for vegetarians and vegans. While some reviewers found the prices to be a bit steep, most agree that it's worth the money for a special occasion.", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["contains_unsupported", "supported"], "order_remapping": {" A": "contains_unsupported", " B": "supported"}, "prefill_s": 1.3393103790003806, "probabilities_by_option_id": {"contains_unsupported": 0.994441212399059, "supported": 0.005558787600941058}, "prompt_sha256": "sha256:7871a5e4043bb1fcb9d0768a148443ca2fdada8a5b4ff1197d487aa3414661ed", "prompt_token_count": 1122, "prompt_token_ids": [1890, 1386, 1761, 364, 279, 4434, 1965, 1608, 1132, 279, 16713, 2450, 13, 271, 41578, 198, 4754, 4834, 3147, 17, 15, 17, 3130, 769, 2129, 11987, 21624, 52218, 1772, 21624, 23543, 899, 763, 3721, 1288, 1005, 88, 763, 1802, 1288, 67, 520, 88, 763, 3721, 1288, 92670, 763, 3721, 1288, 390, 3316, 763, 3721, 1288, 433, 7902, 763, 1802, 1288, 49612, 84507, 763, 3721, 1288, 237419, 88, 763, 1802, 1288, 8339, 2174, 763, 3721, 49471, 22020, 91061, 21624, 11816, 416, 763, 3721, 1288, 8911, 763, 3721, 1288, 26466, 763, 1802, 1288, 6378, 1112, 763, 1802, 1288, 57576, 763, 3721, 49471, 23373, 763, 3721, 1288, 95130, 1460, 1060, 763, 1802, 1288, 12060, 32858, 14773, 2381, 21485, 763, 1802, 1288, 12060, 32858, 1026, 44294, 763, 1802, 1288, 12060, 32858, 17283, 2575, 763, 2827, 1288, 92247, 3147, 2083, 56658, 25316, 1217, 1506, 763, 19, 13, 20, 1288, 15042, 3147, 1501, 26783, 594, 8049, 11, 12458, 14036, 11, 34939, 299, 54221, 11, 14712, 11, 17722, 7277, 11, 54221, 11, 89521, 54221, 11, 14593, 13515, 11, 17689, 1101, 594, 3539, 65759, 11, 56143, 2129, 8656, 3147, 61017, 30089