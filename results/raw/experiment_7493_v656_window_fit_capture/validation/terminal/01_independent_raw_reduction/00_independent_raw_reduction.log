1911621}, "readout_s": 3.549699977156706e-05, "request_id": "sha256:d828526d41ded91ca3d30383", "requested_score_position": 919, "response_sha256": "sha256:73a21800dcfa2ef7368b349e9e06f0e7edd25d520a9b2a4a094ca146bcb12b73", "response_text": "La Guerrerita Mexican Food is a casual restaurant located in Goleta, California. The business offers a variety of Mexican dishes, including breakfast and brunch options. The restaurant has outdoor seating and allows for reservations. It also offers takeout and caters to groups. The restaurant does not offer Wi-Fi and music, but it has validated parking available. Customers have praised the quality of the food, the attentiveness of the owners, and the unique dishes offered. One customer reported that the Pi\u00f1ata Burrito, which was not on the regular menu, was highly recommended and a new favorite soda was discovered. Another customer noted that there was a mistake in the order, but the overall experience was still enjoyable. Overall, La Guerrerita Mexican Food seems like a popular and well-regarded restaurant in the area.", "role": "training", "sealed_prompt_sha256": "sha256:189d0e37ee150ff9a30cbf5632ecc577a704e5df7daac7958957e1cedb03c1c6", "sealed_prompt_token_count": 920, "sentence_count": 3, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-58ab9a39c1162bbe582bcf2a", "source_sha256": "sha256:af830571e1909fa9e7a989e67b80140c8119c9e3edfd2fd4d2c3f90db1a44992", "source_text": "{\"address\":\"5698 Hollister Ave, Ste A\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":false,\"divey\":null,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":null,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":false,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":true,\"WiFi\":\"no\"},\"business_stars\":4.0,\"categories\":\"Mexican, Res