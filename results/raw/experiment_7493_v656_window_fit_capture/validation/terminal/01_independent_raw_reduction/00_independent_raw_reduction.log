, 24140, 11, 279, 5395, 599, 9047, 777, 4222, 310, 14255, 680, 303, 279, 9488, 466, 2963, 310, 4627, 852, 1440, 539, 303, 836, 9054, 4370, 314, 4162, 279, 4025, 13, 1921, 33076, 11, 948, 1017, 579, 421, 2545, 2478, 11, 353, 1459, 914, 17997, 1070, 364, 10569, 975, 69682, 314, 16031, 6889, 77, 1639, 6651, 599, 978, 4313, 1010, 8233, 24537, 310, 615, 1208, 303, 1017, 1137, 264, 4331, 680, 3929, 2640, 421, 836, 7018, 20139, 321, 4145, 2037, 28052, 369, 393, 17, 1381, 494, 220, 16, 12, 19, 280, 721, 2487, 694, 353, 1459, 914, 1366, 1599, 1208, 852, 513, 11692, 364, 58588, 16657, 2261, 1782, 3979, 13, 357, 4099, 314, 10172, 14428, 3162, 279, 20616, 321, 6408, 1070, 7842, 680, 7018, 1719, 1727, 4097, 1208, 668, 615, 393, 17, 974, 314, 836, 54762, 0, 2037, 2717, 1599, 1100, 20192, 806, 303, 1238, 421, 6889, 77, 1639, 3742, 411, 1925, 60755, 30, 35923, 13, 353, 2908, 2496, 3753, 777, 1056, 4097, 1208, 11834, 1017, 303, 799, 708, 11, 321, 353, 1440, 539, 424, 506, 3140, 2957, 264, 1834, 13, 17228, 424, 33793, 4370, 314, 2019, 279, 1560, 314, 15521, 783, 52581, 12015, 27133, 321, 710, 525, 319, 9340, 1149, 92, 27573, 2374, 3147, 4887, 8934, 271, 65498, 24422, 198, 760, 2734, 4233, 42847, 32569, 13809, 369, 264, 10413, 7172, 303, 5805, 46544, 11, 6824, 11, 55377, 303, 54762, 321, 3487, 10538, 19802, 13, 10235, 310, 5813, 8120, 11, 279, 10413, 682, 264, 15855, 16078, 440, 15325, 36064, 321, 5891, 1845, 16712, 25458, 13, 4213, 11, 8120, 1048, 4052, 421, 279, 10413, 579, 3487, 369, 1146, 1671, 11, 440, 1248, 3655, 2942, 321, 888, 631, 7332, 4861, 3470, 13, 38277, 599, 4800, 8785, 11, 16666, 1657, 15530, 321, 30581, 9502, 12668, 303, 836, 54762, 13, 1079, 34, 8778, 1730, 93291, 12671, 25, 19, 19, 16, 25, 22, 19, 23, 2372, 8114, 57043, 599, 1048, 10036, 7604, 5813, 2393, 11, 2583, 6103, 2393, 321, 5395, 852, 2714, 801, 80812, 303, 4162, 279, 4025, 13, 3648, 53650, 1442, 27418, 3315, 279, 10413, 369, 60755, 4016, 310, 1141, 12594, 51287, 1815, 13, 561, 2734, 4233, 42847, 32569, 13809, 4862, 9687, 264, 10412, 314, 220, 17, 13, 20, 9467, 680, 314, 220, 20, 13, 2362, 34, 8778, 1730, 93291, 10580, 2372, 271, 55025, 198, 32, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 198, 33, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 15.22749137878418, " B": 13.136201858520508}, "raw_logits_by_option_id": {"contains_unsupported": 15.22749137878418, "supported": 13.136201858520508}, "readout_s": 3.8222000512178056e-05, "request_id": "sha256:c2e1bbaf0baeb23a774d8087", "requested_score_position": 1345, "response_sha256": "sha256:55447fe45a6aac1f6502d8182df4a48246e61663299c0b11dd2fa091db59ede1", "response_text": "The Grilled Cheese Truck Stop is a restaurant located in Goleta, California, specializing in sandwiches and food truck fare. According to customer reviews, the restaurant has a casual atmosphere with outdoor seating and offers free Wi-Fi. However, reviews also suggest that the restaurant's food is subpar, with long wait times and overpriced menu items. Customers have reported dry, flavorless bread and dried-out meat in their sandwiches. Some reviewers have also noted poor customer service, including slow service and staff who seem disinterested in running the register. One reviewer even questioned whether the restaurant is cursed due to its consistent emptiness. The Grilled Cheese Truck Stop currently holds a rating of 2.5 stars out of 5.", "role": "training", "sealed_prompt_sha256": "sha256:e6a42f0ddbf56679e4c10ba3e99176e2792e3815f650467648fd426b2b3116c9", "sealed_prompt_token_count": 1346, "sentence_count": 4, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-0b2b88b825156a503658e638", "source_sha256": "sha256:506f8b06e70779768ac6baca5373c418a880f21b10f4c5581eb6fec0c88dd1d8", "source_text": "{\"address\":\"956 Embarcadero Del Norte, Ste C\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":null,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":\"free\"},\"business_stars\":2.5,\"categories\":\"Restaurants, Food, Sandwiches, Food Trucks\",\"city\":\"Goleta\",\"hours\":{\"Friday\":\"11:0-2:0\",\"Monday\":\"11:0-0:0\",\"Saturday\":\"11:0-2:0\",\"Sunday\":\"11:0-0:0\",\"Thursday\":\"11:0-0:0\",\"Tuesday\":\"11:0-0:0\",\"Wednesday\":\"11:0-0:0\"},\"name\":\"The Grilled Cheese Truck Stop\",\"review_info\":[{\"review_date\":\"2018-09-19 17:21:23\",\"review_stars\":1.0,\"review_text\":\"Oh wow. This place SSSUUUUUCCKKKKEEDDD\\n\\nWhen I was 6, I took a craft singles, put it between two slices of white bread, and popped it in the microwave for 12 seconds.\\n\\nSo tell me, dear chefs, why it takes OVER 25 MINUTES FOR A SANDWHICH AND SOME CHEESE\\n\\nTHERE WASNT EVEN A RUSH\\n\\nI WAS THE ONLY CUSTOMER\\n\\nlol\\nIt's whatever\\nThis place is closed permanently\\nIdk why I'm writing this review\\nIf you're from the past and you're able to read reviews from the future, then take my advice, avoid this place at all costs.\"},{\"review_date\":\"2018-06-13 03:13:03\",\"review_stars\":1.0,\"review_text\":\"Came here a while ago, a few weeks after this place had opened but have been meaning to write this review. This place was/is very empty for a good reason-- although the concept of having a good grilled cheese place sounds enticing, the actual food was extremely underwhelming. I ordered the grilled cheese with mac n' cheese for $9 and was given half a sandwich with the thinnest layer of mac n cheese inside. On the side were 5 tater tots and HALF a pickle (they don't even bother putting a whole pickle!). A majority of us college students in IV can't afford bougie mediocre grilled cheese for $9-$13. Not sure how long this place is going to last here.\"},{\"review_date\":\"2018-06-08 21:10:12\",\"review_stars\":2.0,\"review_text\":\"You win some, you lose some. And just like the game of cornhole I played here, it was a loss.\\n\\nHaving tried the original Grilled Cheese Truck in L.A., I had high expectations for the bright yellow truck stop. Unfortunately, the times I have tried it, those expectations were not met.\\n\\nI had their signature cheesy mac and rib melt, the healthier not-so-classic melt, and a s'mores melt on three separate occasions. Unfortunately for them, the bread they use here is drier than the sand on Isla Vista's beaches. It's as if they pre-toast the bread in the morning and just warm it up in a toaster oven before slapping some cheese on it. The meat, as a result, is dried out by the time it gets to the paper boats their melts are served on.\\n\\nThe best things to order are the sweet potato tater tots, partially because there is no dry bread involved, and partially because you should never say no to tater tots. Prices are high for no discernible quality and sandwiches the size of the regular Wonder Bread loafs at the supermarket.\\n\\nCustomer service here is sorely lacking. It seems to be worse than other student-run restaurants managed in I.V. The sandwiches take unbelievably long considering how carelessly constructed they look. On several occasions, the staff have seemed more likely to hang out in the kitchen or talk to friends who pass by in their cars instead of running the register. But hey, when there's that little business, I don't blame them for seeking other avenues of entertainment.\\n\\nThey have been trying some marketing tactics to get people in there -- a board out front says that their \\\"plain and simple\\\" melt is $2 now from 1-4 p.m., but I don't know many people who are excited for grilled cheese during those hours. A friend of mine walked past the establishment and heard them calling out \\\"the next five people will get $2 off of their sandwiches!\\\" Not many scuttled in after that.\\n\\nIs this place cursed? Probably. I've never seen more than five people eating there in one go, and I pass by it at least once a day. Hope it improves instead of going the way of Santa Ynez Burrito and Kogilicious.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0023678600000494043, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 2, "window_sha256": "sha256:df5e4e5207ecd456c44cad7bd392a69e358f25652e4c1684e27f38669bf42788", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 493, "archived_pilot_reuse": false, "arm": "whole_response", "attempted": true, "byte_end": null, "byte_start": null, "call_id": "sha256:63132e305350d030d480f99c", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-0b9fb3708fe5ef63c6465e84", "kv_state_id": "reset-epoch-061", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": -1.593423843383789, "marked_response": null, "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["supported", "contains_unsupported"], "order_remapping": {" A": "supported", " B": "contains_unsupported"}, "prefill_s": 0.5756528769998113, "probabilities_by_option_id": {"contains_unsupported": 0.16890273130170683, "supported": 0.831097268698293}, "prompt_sha256": "sha256:d769dc0760e0ede3dfe1abd35b059a267895532f945c9d85e4152d927e073397", "prompt_token_coun