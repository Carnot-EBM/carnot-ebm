25, 198, 32, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 198, 33, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 14.0671968460083, " B": 16.652368545532227}, "raw_logits_by_option_id": {"contains_unsupported": 16.652368545532227, "supported": 14.0671968460083}, "readout_s": 3.54369994965964e-05, "request_id": "sha256:875bba3ff32cb60f452e0900", "requested_score_position": 897, "response_sha256": "sha256:73a21800dcfa2ef7368b349e9e06f0e7edd25d520a9b2a4a094ca146bcb12b73", "response_text": "La Guerrerita Mexican Food is a casual restaurant located in Goleta, California. The business offers a variety of Mexican dishes, including breakfast and brunch options. The restaurant has outdoor seating and allows for reservations. It also offers takeout and caters to groups. The restaurant does not offer Wi-Fi and music, but it has validated parking available. Customers have praised the quality of the food, the attentiveness of the owners, and the unique dishes offered. One customer reported that the Pi\u00f1ata Burrito, which was not on the regular menu, was highly recommended and a new favorite soda was discovered. Another customer noted that there was a mistake in the order, but the overall experience was still enjoyable. Overall, La Guerrerita Mexican Food seems like a popular and well-regarded restaurant in the area.", "role": "training", "sealed_prompt_sha256": "sha256:4ddbc13cfebbb3cc0a8476e8323a1834ea720d17bdb0ab4f72e400069509d1c0", "sealed_prompt_token_count": 898, "sentence_count": null, "sentence_version": null, "source_group_id": "group-58ab9a39c1162bbe582bcf2a", "source_sha256": "sha256:af830571e1909fa9e7a989e67b80140c8119c9e3edfd2fd4d2c3f90db1a44992", "source_text": "{\"address\":\"5698 Hollister Ave, Ste A\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":false,\"divey\":null,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":null,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":false,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":true,\"WiFi\":\"no\"},\"business_stars\":4.0,\"categories\":\"Mexican, Restaurants, Breakfast & Brunch\",\"city\":\"Goleta\",\"hours\":{\"Friday\":\"7:0-23:0\",\"Monday\":\"7:0-23:0\",\"Saturday\":\"7:0-23:0\",\"Sunday\":\"7:0-23:0\",\"Thursday\":\"7:0-23:0\",\"Tuesday\":\"7:0-23:0\",\"Wednesday\":\"7:0-23:0\"},\"name\":\"La Guerrerita Mexican Food\",\"review_info\":[{\"review_date\":\"2022-01-04 05:26:16\",\"review_stars\":5.0,\"review_text\":\"This was a second choice after we found out the restaurant we were originally heading to closed early. We are so glad our first choice fell through! \\n\\nThe owners were so nice and welcoming, and the food was amazing - we had something from the whiteboard in front - The Pi\u00f1ata Burrito. Not on the regular menu, and if it isn't on the whiteboard when you come, I'm sure they'll make it anyway - highly recommended!!\\n\\nWe showed up near the end of the night, other restaurants were closed or closing, and by that time they were running low on their bottled drinks - again, fate played a hand and she basically brought the few drinks that were left so we could choose, which forced us to try something new - some amazing flavors we wouldn't have thought to order otherwise - we have some new favorite sodas as of tonight!\\n\\nBack at the hotel now, feeling super contented. We'll be back!\"},{\"review_date\":\"2021-12-30 18:39:01\",\"review_stars\":4.0,\"review_text\":\"Ordered Chilequiles with Red Sauce and Al Pastor and Huevos Divorciados to go. Huevos Divorciados was perfect and delicious, but the Chilequiles came with green sauce instead and was missing the al pastor. Everything was delicious but sad about the mistakes in the order. Also green sauce was spicy.\"},{\"review_date\":\"2021-12-19 22:57:03\",\"review_stars\":5.0,\"review_text\":\"Walked In basically because it was across the street from my hotel. Asked the adorable husband and wife owners what was good and got the most amazing dish unlike any Mexican food I've ever had. I'm sure the rest of the menu is just as good - so much obvious love goes into the food.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0021382799995990354, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 917, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 234, "byte_start": 0, "call_id": "sha256:8698acc07477b586e0e76c70", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-58ab9a39c1162bbe582bcf2a", "kv_state_id": "reset-epoch-510", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 2.6913251876831055, "marked_response": "<<CARNOT_FOCUS_START:0:234>>La Guerrerita Mexican Food is a casual restaurant located in Goleta, California. The business offers a variety of Mexican dishes, including breakfast and brunch options. The restaurant has outdoor seating and allows for reservations. <<CARNOT_FOCUS_END>>It also offers takeout and caters to groups. The restaurant does not offer Wi-Fi and music, but it has validated parking available. Customers have praised the quality of the food, the attentiveness of the owners, and the unique dishes offered. One customer reported that the Pi\u00f1ata Burrito, which was not on the regular menu, was h