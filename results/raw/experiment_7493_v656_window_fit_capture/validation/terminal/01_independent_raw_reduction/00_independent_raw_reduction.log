ia. <<CARNOT_FOCUS_START:989:1595>>Kenyan authorities had prior intelligence that a university in Garissa could be attacked but the country's rapid response team was stuck in Nairobi for hours after the massacre, for unknown reasons. The team eventually entered the university complex and ended the siege. However, the government defended the response time and stated that they did everything they could to save lives. The Interior Ministry named Mohamed Mohamud as the organizer of the attack and offered a reward for information on his whereabouts. The attack has intensified concerns about the threat of terrorism in Kenya and the region.<<CARNOT_FOCUS_END>>", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["contains_unsupported", "supported"], "order_remapping": {" A": "contains_unsupported", " B": "supported"}, "prefill_s": 2.09974600500027, "probabilities_by_option_id": {"contains_unsupported": 0.9070212442353919, "supported": 0.09297875576460818}, "prompt_sha256": "sha256:e7c32019f39382d355b58dfde065d1a91d128ec5bb7ee75b1b65a1369eecd573", "prompt_token_count": 1766, "prompt_token_ids": [1890, 1386, 1761, 364, 279, 4434, 1965, 1608, 1132, 279, 16713, 2450, 13, 271, 41578, 198, 45, 80575, 11, 35453, 220, 318, 53593, 8, 6651, 998, 24545, 321, 28891, 11, 19595, 321, 28334, 11, 4627, 321, 12004, 9977, 13, 2302, 998, 4007, 321, 7655, 382, 11, 31924, 836, 43136, 364, 264, 2577, 2199, 13, 1541, 383, 7348, 3603, 11, 13851, 88, 581, 25624, 1070, 430, 23482, 12059, 314, 264, 19138, 3250, 421, 45359, 264, 6777, 321, 2047, 10428, 4593, 47272, 13, 561, 22175, 3727, 440, 11012, 67010, 4082, 264, 13041, 314, 11168, 1518, 57135, 382, 3804, 20413, 321, 7481, 8574, 799, 809, 314, 93190, 579, 65752, 20277, 5367, 13, 10446, 11881, 84681, 220, 16, 19, 22, 47771, 494, 264, 10538, 321, 28599, 37070, 1070, 303, 279, 4751, 13, 380, 3321, 