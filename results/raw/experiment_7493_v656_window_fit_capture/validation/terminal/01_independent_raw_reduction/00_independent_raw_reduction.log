95}, "readout_s": 3.3323000025120564e-05, "request_id": "sha256:eaab735dc9b7bed52aa08e03", "requested_score_position": 481, "response_sha256": "sha256:a7dd0aada96743a953174c799ceea92e1f8e3222051bffcc22d551dcef113b52", "response_text": "A shooting at the US Census Bureau headquarters in Maryland and a subsequent chase and shootout in Washington, DC, have left several people injured, including a security guard, a police officer, and the suspect. The suspect's vehicle was spotted outside the Census Bureau, and a guard was shot while approaching the vehicle. The suspect fled, leading to a chase and multiple shootouts, ending in a crash and shootout on H Street in Washington. The kidnapping victim was found safe.", "role": "training", "sealed_prompt_sha256": "sha256:906e805720ca3b938753a2f3d0abace5227eb17591bdd78968422391a8af5e85", "sealed_prompt_token_count": 482, "sentence_count": 2, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-38f65cf643f8731969a4c4c1", "source_sha256": "sha256:53e03ce05a0d9f066d2e3bf5760b1fb6511eb1997faae041881e7657a41ab39b", "source_text": "Washington (CNN)Washington was rocked late Thursday by shootings -- one at the gates of the U.S. Census Bureau's headquarters and another in a popular area packed with restaurant patrons. The shootings were connected, authorities said. They began with what authorities believe was a domestic kidnapping incident, according to D.C. Police Chief Cathy Lanier. The suspect's vehicle was spotted outside the Census Bureau, which is in Suitland, Maryland. A guard apparently approached the vehicle and saw two people arguing. That guard was then shot at least once in the upper body, said Prince George's County Fire Department spokesman Mark Brady. The guard was in extremely critical condition, according to Brady. The police chief said the suspect then fled the scene. Officers picked up the chase, and the suspect fired gunshots at multiple locations, Lanier said. The chase ended in a crash on Washington's busy H Street. A shootout ensues, Lanier said. An officer and the suspect were wounded, according to the police chief. Both were conscious and talking when they left the scene. \"Right now, we have every reason to believe that the car that we have in this last incident here is the same car involved and the same person involved in the kidnapping,\" she said. Lanier told reporters the kidnapping victim was located and is in good condition. She did not identify the suspect, nor the guard, nor the officer who were injured. Steve Brusk reported from Washington. Dana Ford wrote from Atlanta. CNN's Greg Botelho also contributed to this report.\n", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.001164719999906083, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 2, "window_sha256": "sha256:8bcf0ef841b1a68c10b8d6000ca473c8af3954a20cc261fc6d9cd5dfbf5a0e2f", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 1120, "archived_pilot_reuse": false, "arm": "whole_response", "attempted": true, "byte_end": null, "byte_start": null, "call_id": "sha256:62071cd19b5786eb33bc4753", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-39794fd4bf545ebf1ff524af", "kv_state_id": "reset-epoch-317", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 2.5614099502563477, "marked_response": null, "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["supported", "contains_unsupported"], "order_remapping": {" A": "sup