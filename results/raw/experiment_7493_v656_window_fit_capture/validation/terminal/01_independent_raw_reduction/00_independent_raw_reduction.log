r\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":false,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":\"no\"},\"business_stars\":3.5,\"categories\":\"Restaurants, Mexican\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"9:0-20:30\",\"Saturday\":\"8:0-20:30\",\"Sunday\":\"8:0-14:0\",\"Thursday\":\"9:0-20:0\",\"Tuesday\":\"9:0-20:0\",\"Wednesday\":\"9:0-20:0\"},\"name\":\"Rose Cafe No 2\",\"review_info\":[{\"review_date\":\"2021-10-07 21:48:38\",\"review_stars\":5.0,\"review_text\":\"Our favorite Mexican restaurant.  Great food,  service and atmosphere.  Favorite dishes are shrimp quesadilla and enchilada verde, but everything is delicious!\"},{\"review_date\":\"2021-10-07 01:36:52\",\"review_stars\":5.0,\"review_text\":\"Hands down the best Mexican food the Santa Barbara. Food and service are always on point!\\n\\nMy husband would eat here every day if we lived there. The enchiladas are amazing, make sure to ask for extra sauce as it's good to dip the chips in.\\n\\nNice to enjoy there outdoor seating and people watching. \\n\\nHave a margarita and enchilada and you will be thankful.\"},{\"review_date\":\"2021-10-03 17:19:58\",\"review_stars\":5.0,\"review_text\":\"Rose caf\u00e9 is one of my favorite spots in town. They have the best chilaquiles I've ever had and enchiladas and everything on the menu is good   You can't go wrong with anything you order on the menu. The margaritas are really good and the staff is super friendly and I love the outdoor dining area.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true,