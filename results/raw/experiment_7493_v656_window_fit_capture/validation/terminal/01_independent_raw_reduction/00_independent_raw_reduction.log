ht to mobile telephony, thereby encouraging innovation.", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["contains_unsupported", "supported"], "order_remapping": {" A": "contains_unsupported", " B": "supported"}, "prefill_s": 1.7947909650001748, "probabilities_by_option_id": {"contains_unsupported": 0.23370926037928264, "supported": 0.7662907396207174}, "prompt_sha256": "sha256:0ecd301e392b13b301af26f2a745e133836fc3641f76f457ca975c502b943636", "prompt_token_count": 1521, "prompt_token_ids": [1890, 1386, 1761, 364, 279, 4434, 1965, 1608, 1132, 279, 16713, 2450, 13, 271, 41578, 198, 3702, 22088, 310, 44955, 321, 1865, 12039, 310, 378, 40210, 11, 14175, 786, 645, 570, 27221, 5617, 780, 12401, 2478, 30315, 494, 18211, 13, 561, 44786, 79950, 13187, 69780, 3727, 2526, 440, 264, 2545, 6165, 7808, 421, 8341, 1384, 12655, 1238, 9101, 2812, 506, 220, 16, 20, 13, 4081, 2756, 11, 780, 82551, 5559, 42824, 888, 220, 17, 15, 5656, 321, 551, 579, 978, 2512, 328, 71090, 579, 37257, 45133, 1149, 733, 3200, 220, 17, 15, 16, 18, 645, 570, 27221, 10542, 8177, 440, 279, 4588, 13005, 314, 85691, 5883, 1137, 13853, 23570, 1137, 310, 1151, 449, 8889, 3674, 10419, 383, 9871, 2512, 40937, 82551, 13, 561, 7737, 32604, 8953, 393, 18, 17, 20, 3410, 1472, 264, 4191, 64929, 471, 1575, 3294, 279, 393, 17, 20, 15, 3410, 2100, 13, 1921, 780, 10806, 42824, 7551, 9871, 11, 321, 8964, 1137, 645, 570, 27221, 557, 279, 1118, 11308, 310, 1777, 685, 364, 279, 6429, 310, 5640, 310, 3433, 440, 11528, 3135, 35339, 579, 2724, 11, 10888, 72656, 13, 19166, 579, 55341, 9871, 11938, 310, 645, 570, 27221, 883, 11308, 18204, 11, 71873, 321, 19421, 13, 1473, 18559, 2243, 314, 279, 6906, 10695, 13, 19166, 25, 220, 1394, 513, 4393, 303, 3679, 11308, 5656, 13, 2500, 369, 279, 1428, 2478, 17865, 383, 279, 30701, 30, 14175, 786, 645, 570, 27221, 25, 9785, 1381, 303, 