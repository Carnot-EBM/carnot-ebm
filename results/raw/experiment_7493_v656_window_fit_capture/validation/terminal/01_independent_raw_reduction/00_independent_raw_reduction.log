ition": 726, "response_sha256": "sha256:299355575b0159e2f1b9e906ac9a182b498572a44af570d414bbc1490243a138", "response_text": "In-N-Out Burger is a popular fast food chain located in Goleta, California, known for their high-quality burgers and fries. According to customer reviews, the restaurant consistently serves delicious and flavorful food, with a 99% accuracy rate in fulfilling orders. The menu includes classic burgers, fries, and drinks, and the restaurant offers take-out and good-for-groups options. While some customers have noted that the fries can be a bit disappointing, the burgers are widely regarded as exceptional, with a juicy patty and slightly toasted bun. In-N-Out Burger has a casual atmosphere and does not offer outdoor seating or Wi-Fi. The restaurant has a 4.0-star rating and is considered a local favorite, with many customers visiting regularly.", "role": "calibration_tuning", "sealed_prompt_sha256": "sha256:8e109bbf9587838a158f24372fd0489423e8c67e2c43cf185448908cc0be8d47", "sealed_prompt_token_count": 727, "sentence_count": 2, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-9eb74aebe2d4abc16f7d0aad", "source_sha256": "sha256:010351c545159e7b842a6b6a03a13df25bc13c6f72fb262bb48457c8dd4e07be", "source_text": "{\"address\":\"4865 Calle Real\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":false,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":null,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":\"no\"},\"business_stars\":4.0,\"categories\":\"Restaurants, Fast Food, Burgers\",\"city\":\"Goleta\",\"hours\":{\"Friday\":\"0:0-23:0\",\"Monday\":\"0:0-0:0\",\"Saturday\":\"10:30-1:30\",\"Sunday\":\"10:30-1:0\",\"Thursday\":\"10:30-23:0\",\"Tuesday\":\"10: