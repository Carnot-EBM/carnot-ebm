_label": {" A": 12.358485221862793, " B": 16.1678524017334}, "raw_logits_by_option_id": {"contains_unsupported": 16.1678524017334, "supported": 12.358485221862793}, "readout_s": 3.8361999941116665e-05, "request_id": "sha256:e28f744c82d29abd540d7063", "requested_score_position": 818, "response_sha256": "sha256:ab86d6ec74c297f0895e2fc4fe4b3cfe9c81351487dc54e03c5c3593fc91ddd4", "response_text": "Located in the heart of Santa Barbara, Corner Tap Room is a popular gathering spot that offers a diverse selection of delicious food and drinks. With its cozy atmosphere and friendly staff, this establishment is perfect for a night out with friends or a romantic evening. The menu features a variety of mouth-watering options, including their famous Teriyaki Sliders and tasty flatbreads. Beer enthusiasts will appreciate the extensive selection of craft beers available, while those looking for a lighter option can enjoy a refreshing cocktail or glass of wine. Outdoor seating is also available, providing the perfect spot to relax and enjoy the surrounding scenery.\n\nCorner Tap Room is well-known for its exceptional service, with friendly and attentive staff always ready to assist with any need. The atmosphere is inviting and welcoming, making it an excellent choice for groups or special occasions. While the prices may be a bit steep for some, the quality of the food and drinks more than makes up for it. Overall, Corner Tap Room is an excellent choice for anyone looking for a great dining experience in Santa Barbara.", "role": "training", "sealed_prompt_sha256": "sha256:ae424e558b6baf8a218119240593eb29a4351476c7b58e02ace846577d8dde83", "sealed_prompt_token_count": 819, "sentence_count": 3, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-e93f8befd7a0818b79230bba", "source_sha256": "sha256:b4ac629bcb1d5b8132011942543876956b288f0435d0cbc11e2b17c69fc9429c", "source_text": "{\"address\":\"1905 Cliff Dr\",\"attributes\":{\"Ambience\":null,\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":false,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":null,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":null},\"business_stars\":5.0,\"categories\":\"Restaurants, Gastropubs, Cocktail Bars, Bars, American (New), Nightlife, Beer Bar, American (Traditional)\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"12:0-22:0\",\"Monday\":\"0:0-0:0\",\"Saturday\":\"12:0-22:0\",\"Sunday\":\"10:0-20:0\",\"Thursday\":\"16:0-21:0\",\"Tuesday\":\"16:0-21:0\",\"Wednesday\":\"16:0-21:0\"},\"name\":\"Corner Tap Room\",\"review_info\":[{\"review_date\":\"2021-12-24 20:48:52\",\"review_stars\":5.0,\"review_text\":\"We were looking for a good meal on a rainy night and found the perfect spot at the Corner Tap Room. The food was tremendous, I had the Teriyaki Sliders, and the atmosphere was friendly and inviting. Oh yeah, they have a lot of great beers to choose from\"},{\"review_date\":\"2021-10-30 15:46:13\",\"review_stars\":4.0,\"review_text\":\"Good location on the Mesa. Ambiance was nice outside. Service was great. The meat lovers flatbread was amazing, but I wasn't a big fan of the prosciutto flatbread.  The kids pasta was decent but it tasted very spicy for some reason. The mojito was decent, too. Will probably come back at some point!\"},{\"review_date\":\"2021-10-21 03:56:27\",\"review_stars\":3.0,\"review_text\":\"Corner Tap is a welcome addition to the Mesa.  Staff are friendly and responsive. Should have ordered beer. Wine prices way too high. Paid $16 tonight for glass of Qupe Chardonnay which is pedestrian at best. Cauliflower hot and tasty. Flat bread cold and cheese not toasted. If you go, avoid wine and order one dish at a time!\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "toke