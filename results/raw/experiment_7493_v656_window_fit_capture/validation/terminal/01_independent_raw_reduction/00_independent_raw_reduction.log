4, 279, 17378, 3039, 11, 10377, 4499, 6112, 310, 1236, 449, 15515, 5307, 13, 271, 55025, 198, 32, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 198, 33, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 17.07561683654785, " B": 16.059947967529297}, "raw_logits_by_option_id": {"contains_unsupported": 16.059947967529297, "supported": 17.07561683654785}, "readout_s": 3.4374999813735485e-05, "request_id": "sha256:50909946cd437fb7f920d62e", "requested_score_position": 922, "response_sha256": "sha256:227b3b469f892b7b6d5c3f368c9b2051647ab65f8f9f354ad422572c17a86a54", "response_text": "De La Guerra Dining Commons is a local business located at 1501 Residential Services in Santa Barbara, CA. It operates as a cafeteria and cafe, offering a range of American (New), sandwich, pizza, and Mexican cuisine. The dining commons has specific operating hours, opening from 21:0 to 0:30 on Monday to Thursday, and from 17:0 to 20:0 on Friday, Saturday, and Sunday.\n\nCustomers have left mixed reviews about De La Guerra Dining Commons. One customer expressed dissatisfaction, mentioning long lines and subpar food, except for the hard-boiled eggs. Another customer, however, had a more positive experience, describing the dining commons as clean with a variety of options. They appreciated the quality of food compared to other campus dining halls and praised the kind staff. They also mentioned the premium views of Isla Vista and the UCSB community.\n\nAnother customer highlighted the expansive variety of food options at De La Guerra Dining Commons. They mentioned burgers being available for breakfast, lunch, and dinner but noted that they were sometimes undercooked or even frozen. They also mentioned experiencing diarrhea from the Mexican food. However, they enjoyed the wide variety of meat options, particularly the fish cakes.\n\nOverall, De La Guerra Dining Commons has a rating of 3.0 stars. The provided reviews highlight both positive and negative aspects of the dining experience, allowing potential customers to make an informed decision.", "role": "training", "sealed_prompt_sha256": "sha256:f7bc541ed18471fcf075ffb9736ed782ef08e23bc48e21e65a7a4ed67ece3a5b", "sealed_prompt_token_count": 923, "sentence_count": null, "sentence_version": null, "source_group_id": "group-05f22381724a0914a4f0ca7b", "source_sha256": "sha256:4ec8ee623c891bedaa72806036797f67588ad8c49ff8b4d0844f5356a1d391c0", "source_text": "{\"address\":\"1501 Residential Services\",\"attributes\":{\"Ambience\":{\"casual\":null,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":null,\"touristy\":null,\"trendy\":null,\"upscale\":false},\"BusinessParking\":null,\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":false,\"WiFi\":\"free\"},\"business_stars\":3.0,\"categories\":\"Cafeteria, Cafes, American (New), Restaurants, Sandwiches, Pizza, Mexican\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"17:0-20:0\",\"Monday\":\"21:0-0:30\",\"Saturday\":\"17:0-20:0\",\"Sunday\":\"17:0-20:0\",\"Thursday\":\"21:0-0:30\",\"Tuesday\":\"21:0-0:30\",\"Wednesday\":\"21:0-0:30\"},\"name\":\"De La Guerra Dining Commons\",\"review_info\":[{\"review_date\":\"2021-10-13 02:40:32\",\"review_stars\":1.0,\"review_text\":\"its bad. don't go here. long lines for subpar food. the hard boiled eggs are the only things worth getting, otherwise steer clear.\"},{\"review_date\":\"2019-09-04 20:29:00\",\"review_stars\":4.0,\"review_text\":\"Clean with a variety of options. Relative to other campus dining halls, this place is quality. A surprising amount of variety and kind staff. Premium views of Isla Vista and the UCSB community.\"},{\"review_date\":\"2018-11-30 02:25:55\",\"review_stars\":5.0,\"review_text\":\"Helluu it's me again. To start of, De La Guerra or \\\"DLG\\\" for short, has an expansive variety of food options for those eating there. Walking into DLG you are greeted with a list of all the wonderful, edible food they have prepared for that meal. Let's start with the burgers. Burgers are offered at almost every meal: breakfast lunch and dinner. Although you think that burgers are pretty hard to mess up, they are often undercooked, sometimes even frozen. Now let move on to the Mexican. It gives you diarrhea. In edition to these two favorites of mine, they often offer a wide variety of meat. What kind of meat? Well, you never quite know. But my favorite is the fish cakes:) Have fun at DLG!\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.002387165000072855, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 942, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 441, "byte_start": 0, "call_id": "sha256:188d7fbc8e39f66136bbbc72", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-05f22381724a0914a4f0ca7b", "kv_state_id": "reset-epoch-018", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": -0.6215162277221681, "marked_response": "<<CARNOT_FOCUS_START:0:441>>De La Guerra Dining Commons is a local business located at 1501 Residential Services in Santa Barbara, CA. It operates as a cafeteria and cafe, offering a range of American (New), sandwich, pizza, and Mexican cuisine. The dining commons has specific operating hours, opening from 21:0 to 0:30 on Monday to Thursday, and from 17:0 to 20:0 on Friday, Saturday, and Sunday.\n\nCustomers have left mixed reviews about De La Guerra Dining Commons. <<CARNOT_FOCUS_END>>One customer expressed dissatisfaction, mentioning long lines and subpar food, except for the hard-boiled eggs. Another customer, however, had a more positive experience, describing the dining commons as clean with a variety of options. They appreciated the quality of food compared to other campus dining halls and praised the kind staff. They also mentioned the premium views of Isla Vista and the UCSB community.\n\nAnother customer highlighted the expansive variety of food options at De La Guerra Dining Commons. They mentioned burgers being available for breakfast, lunch, and dinner but noted that they were sometimes undercooked or even frozen. They also mentioned experiencing diarrhea from the Mexican food. However, they enjoyed the wide variety of meat options, particularly the fish cakes.\n\nOverall, De La Guerra Dining Commons has a rating of 3.0 stars. The provided reviews highlight both positive and negative aspects of the dining experience, allowing potential customers to make an informed decision.", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["supported", "contains_unsupported"], "order_remapping": {" A": "supported", " B": "contains_unsupported"}, "prefill_s": 1.0974164889994427, "probabilities_by_option_id": {"contains_unsupported": 0.34943668769396474, "supported": 0.6505633123060353}, "prompt_sha256": "sha256:1411949795b4c837b2ac9eef4ac032950571b5355a626ffd26e03c3acbef27aa", "prompt_token_count": 943, "prompt_token_ids": [1890, 1386, 1761, 364, 279, 4434, 1965, 1608, 1132, 279, 16713, 2450, 13, 271, 41578, 198, 4754, 4834, 3147, 16, 20, 15, 16, 52628, 8049, 2129, 11987, 21624, 52218, 1772, 21624, 23543, 899, 763, 2827, 1288, 1005, 88, 763, 3721, 1288, 67, 520, 88, 763, 3721, 1288, 92670, 763