5], "raw_logits_by_display_label": {" A": 13.321089744567871, " B": 16.487354278564453}, "raw_logits_by_option_id": {"contains_unsupported": 16.487354278564453, "supported": 13.321089744567871}, "readout_s": 3.246100004616892e-05, "request_id": "sha256:2198b64d54ee8f3c56a58814", "requested_score_position": 985, "response_sha256": "sha256:2e3d712fa085c9b243e78aca6b7937670cbbc95fede6388740c6a831aadbe996", "response_text": "Blush Lounge is a popular nightlife spot located in Santa Barbara, California. With a rating of 3.5 stars, it offers a cozy atmosphere and excellent ambiance, making it a great spot for both intimate gatherings and large events. The lounge features a beautiful patio area with fire pits and heaters, perfect for relaxing and socializing. While the food quality has been inconsistent in the past, the management has made efforts to improve it. However, some reviewers have noted poor service, including slow response times and incorrect orders. Despite these issues, Blush Lounge remains a popular spot for locals and visitors alike, thanks to its prime location and extensive wine list.", "role": "training", "sealed_prompt_sha256": "sha256:e7383bd5f14492d96f398bc81331bd3e508a165b109465044bc9bb9a171465b7", "sealed_prompt_token_count": 986, "sentence_count": 3, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-3aa8956c1d85e255eeed18e3", "source_sha256": "sha256:053f4f457391b6c5ca6fb97e41e0bd846ce5491f4945c605d5087144d6e0b138", "source_text": "{\"address\":\"630 State St\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":true,\"upscale\":false},\"BusinessParking\":{\"garage\":true,\"lot\":false,\"street\":false,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":true,\"WiFi\":\"free\"},\"business_stars\":3.5,\"categories\":\"Lounges, Cocktail Bars, Bars, Nightlife, Restaurants, Hookah Bars, American (New)\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"18:0-0:0\",\"Saturday\":\"17:0-0:0\",\"Sunday\":\"12:0-22:0\",\"Thursday\":\"18:0-1:30\",\"Wednesday\":\"18:0-0:0\"},\"name\":\"Blush Lounge\",\"review_info\":[{\"review_date\":\"2018-01-05 22:40:03\",\"review_stars\":5.0,\"review_text\":\"Blush has recently re-opened under new management and I was thrilled with my experience with them. I reached out to them about hosting an event there in November, and was put in contact with Asaf. He was very receptive to all of my ideas and accommodating of my requests. Although they no longer serve food at the restaurant, Asaf worked with me and within my budget constraints to find food options for our event. The bartenders were very friendly, welcoming, and assisted us with setting up a playlist through their sound system, and a slideshow on their TVs. The patio is well decorated and has fire pits and heaters to keep the space warm. I would highly recommend the space if you are looking for a place to host an event, or just to come in for a drink. I (and my friends) will definitely be back!\"},{\"review_date\":\"2017-12-29 07:15:27\",\"review_stars\":2.0,\"review_text\":\"PERMANENTLY CLOSED!!   (an obituary) \\nNo surprise. \\nThis restaurant had inconsistent food quality that ebbed and flowed depending on the chef. They were perhaps at their best (food-wise) when Chef Mossin worked there. When he left, food quality suffered. But this inconsistency could have possibly been overlooked.\\nThat said, they were very consistent when it came to service. For as long as I can remember....it consistently sucked!! At one point they did nearly a complete restart with service, but again it was the management that couldn't keep things together.\\nIt was really such a shame. It looked spectacularly cool on the inside with the brick walls and stellar lighting, coupled with a really nice outdoor bar and patio area, but the shoddy and ineffective management killed what should have been a home run. But this wasn't the only restaurant that they couldn't keep going well. \\nThe locals all knew this, and apparently the Yelpers did too. \\nSo goodbye Blush. Hopefully someone else will take over your awesome facility at a great location and make it work.\"},{\"review_date\":\"2017-05-07 06:02:56\",\"review_stars\":2.0,\"review_text\":\"Ambience is very nice, but thats it. Asked for coffee, the waiter brought cold coffee, no cream or sugar or spoon, when asked for cream, he went and pored milk in a shot glass.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0018857850000131293, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 0, "window_sha256": "sha256:bcc196223da1afbd292543f9d11d848b639bb6354c8e6ba917499aeff268f6bb", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 987, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 443, "byte_start": 229, "call_id": "sha256:a55d03d84b89afeb55b8a7d4", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-3aa8956c1d85e255eeed18e3", "kv_state_id": "reset-epoch-335", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 2.1762571334838867, "marked_response": "Blush Lounge is a popular nightlife spot located in Santa Barbara, California. With a rating of 3.5 stars, it offers a cozy atmosphere and excellent ambiance, making it a great spot for both intimate gatherings and large events. <<CARNOT_FOCUS_START:229:443>>The lounge features a beautiful patio a