2\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":true,\"divey\":false,\"hipster\":true,\"intimate\":false,\"romantic\":false,\"touristy\":null,\"trendy\":true,\"upscale\":false},\"BusinessParking\":{\"garage\":true,\"lot\":false,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":\"free\"},\"business_stars\":4.5,\"categories\":\"Restaurants, Breakfast & Brunch, Latin American, Mexican, Seafood\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"11:0-21:30\",\"Monday\":\"0:0-0:0\",\"Saturday\":\"11:0-21:30\",\"Sunday\":\"11:0-21:0\",\"Thursday\":\"11:0-21:30\",\"Tuesday\":\"11:0-21:0\",\"Wednesday\":\"11:0-21:0\"},\"name\":\"Corazon Cocina\",\"review_info\":[{\"review_date\":\"2022-01-16 00:26:38\",\"review_stars\":5.0,\"review_text\":\"Most consistently delicious food in all Santa Barbara. \\nI started going there when it first opened and 5 plus years later it has maintained the consistency some how. Owner is doing a great job.\"},{\"review_date\":\"2022-01-11 20:20:46\",\"review_stars\":5.0,\"review_text\":\"We ate at the Corazon Cocina twice recently during our vacation in SB and\\nit was beyond amazing! Tasty food with stellar customer service! We highly recommend this restaurant and will go back anytime soon!\"},{\"review_date\":\"2022-01-09 22:20:28\",\"review_stars\":5.0,\"review_text\":\"This place will forever hold a place in my heart, and stomach. There are many places to choose to eat at the public market, but you are always guaranteed a delicious meal when you eat here.\\n\\nWent here yesterday and ordered the quesa birria. IT WAS SO GOOD. Most restaurants don't know how to master birria, but this place, they know how to cook birria. There was no consume to dip because it's already inside. That means that each bite is juicy and flavorful and just the best. \\n\\nI also ordered the doraditos for my kids and they loved it. Each crunchy rolled up taco came with quesa Fresca on top and lettuce. We ordered the horchata to compliment the meal and it was perfect. Their horchata is made with almond milk and unlike any horchata I've ever had. \\n\\nYou can really tell how much this restaurant values good quality ingredients, and it truly is apparent in the food. Don't miss this place if you're at the public market!\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0015997890004655346, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 0, "window_sha256": "sha256:568d9b3a73cd8058863de18bad40b780dbc91150e906b3d86a9088dcfc998add", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 872, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 465, "byte_start": 280, "call_id": "sha256:a504ff3fea76d28b7b5f9783", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-99c7e56ef23ea439de7f1ffb", "kv_state_id": "reset-epoch-841", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": 5.422154426574707, "marked_response": "Corazon Cocina is a restaurant located in the Public Market in Santa Barbara, California. It offers a variety of cuisines, including Latin American, Mexican, and seafood. The restaurant is open Monday through Sunday from 11am to 9pm, with extended hours on Thursdays until 10pm. \n<<CARNOT_FOCUS_START:280:465>>Customers have praised the restaurant for its consistently delicious food, friendly service, and outdoor seating options. The restaurant also offers takeout and is suitable for groups. <<CAR