king\":{\"garage\":false,\"lot\":true,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":\"no\"},\"business_stars\":4.0,\"categories\":\"Sandwiches, Restaurants, Delis\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"8:0-16:0\",\"Monday\":\"8:0-16:0\",\"Saturday\":\"11:0-15:0\",\"Thursday\":\"8:0-16:0\",\"Tuesday\":\"8:0-16:0\",\"Wednesday\":\"8:0-16:0\"},\"name\":\"D'Vine\",\"review_info\":[{\"review_date\":\"2013-05-21 17:54:36\",\"review_stars\":1.0,\"review_text\":\"I had a \\\"club sandwich\\\" at this joke of a deli, which was possibly the biggest waste of 10$ ive ever spent. They brought me out a cold sandwich on wonderbread, something I could have packed myself for lunch in 3rd grade. Ive heard there are other good hot sandwiches on the menu, but from what I saw this place served nothing but overpriced garbage.\"},{\"review_date\":\"2013-03-09 04:36:20\",\"review_stars\":5.0,\"review_text\":\"Great sandwiches, salads, and soups.  The staff are extremely friendly, and its just a really cool looking shop.  Good selection of drinks, chips, and other miscellaneous snacks.  If your going to order a sandwich, get The Julius with cranberry sauce.  Its only everything holy between two pieces of grilled sourdough.\"},{\"review_date\":\"2013-01-09 23:06:10\",\"review_stars\":4.0,\"review_text\":\"They have gluten free bread, but ask for it toasted.  The owner is gluten free, so the staff is better trained than most.  Try the beet salad with the curry crusted walnuts, it is really tasty.  The patio has a nice mountain view.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0015648729995518806, "tokenizer_identity": {"bos_token_id": "2480