1bee01454f87214739d1994c768", "sealed_prompt_token_count": 727, "sentence_count": null, "sentence_version": null, "source_group_id": "group-1f09ea96c68d54b0418296f3", "source_sha256": "sha256:6536f4870b038806cefe4c5507a6c6f59606961724f8bf56d77747065abf35f7", "source_text": "{\"address\":\"115 E Haley St\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":false,\"street\":false,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":null,\"RestaurantsGoodForGroups\":null,\"RestaurantsReservations\":null,\"RestaurantsTakeOut\":null,\"WiFi\":null},\"business_stars\":4.5,\"categories\":\"Mexican, Restaurants\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"7:0-21:0\",\"Monday\":\"7:0-21:0\",\"Saturday\":\"7:0-21:0\",\"Sunday\":\"7:0-21:0\",\"Thursday\":\"7:0-21:0\",\"Tuesday\":\"7:0-21:0\",\"Wednesday\":\"7:0-21:0\"},\"name\":\"El Rincon Alteno\",\"review_info\":[{\"review_date\":\"2021-08-18 17:29:38\",\"review_stars\":5.0,\"review_text\":\"The crispy tacos here are fantastic! That is definitely the item to order here. Service was friendly and fast. They have a great selection of sauces, I enjoyed all of them. Prices and portions are fair, very clean and well run highly recommended for a cheap and satisfying meal in Santa Barbara!\"},{\"review_date\":\"2021-05-24 05:21:23\",\"review_stars\":5.0,\"review_text\":\"We stopped in here after a bad experience on state street and these were THE BEST tacos either of us have ever had! We had to order 2 more. The prices were too cheap and the food was super yum!! Highly recommend\"},{\"review_date\":\"2021-05-23 20:45:23\",\"review_stars\":5.0,\"review_text\":\"Absolutely the best crispy tacos in Santa Barbara! Can't recommend this place enough!! Get over here and order!\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ra