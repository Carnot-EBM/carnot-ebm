349, 4816, 310, 381, 264, 14543, 5576, 364, 1782, 3221, 364, 4778, 321, 16147, 30434, 5084, 325, 3487, 303, 5805, 46544, 13, 5788, 1010, 6112, 599, 995, 6572, 11120, 11, 3672, 599, 22339, 4562, 440, 279, 4131, 314, 279, 3487, 321, 5813, 2393, 13, 1577, 440, 866, 4778, 61322, 20616, 11, 424, 579, 2894, 310, 10000, 24679, 16175, 321, 23331, 678, 1906, 1518, 32979, 424, 13, 271, 55025, 198, 32, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 198, 33, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 16.62360191345215, " B": 11.202836036682129}, "raw_logits_by_option_id": {"contains_unsupported": 16.62360191345215, "supported": 11.202836036682129}, "readout_s": 5.192699973122217e-05, "request_id": "sha256:a33e801e426a0a8f59fdf57c", "requested_score_position": 1039, "response_sha256": "sha256:2752c02075377aa931e675819369cf2fc5b30f87beb2b27d32ab2a811a6ebe63", "response_text": "Taco Bell is a popular fast-food chain located in Goleta, CA, offering Tex-Mex cuisine, tacos, breakfast, and brunch. The restaurant is open seven days a week from 7 am to 1 am, with a break from 7 am to 10 am on Sundays. It has a casual atmosphere with outdoor seating and provides free Wi-Fi. The menu includes a variety of options such as burritos, tacos, quesadillas, and salads. Customers can dine in or take advantage of the take-out service.\n\nAccording to customer reviews, Taco Bell is a reliable option for quick and satisfying meals. One reviewer praised the restaurant for its speedy service, accurate orders, and friendly staff. However, another reviewer had a negative experience, claiming that their food contained long black hair and criticizing the restaurant's safety practices. A third reviewer described the staff as passive-aggressive and had issues with their order and customer service.\n\nOverall, Taco Bell seems to be a decent choice for those looking for fast and affordable Tex-Mex food in Goleta. While some customers have had positive experiences, others have encountered issues with the quality of the food and customer service. As with any fast-food establishment, it's important to maintain realistic expectations and inspect your order before consuming it.", "role": "calibration_tuning", "sealed_prompt_sha256": "sha256:962c91a53e20f7091437f27745ac33297537172c7de7d7dc59d7c12a3a709f7e", "sealed_prompt_token_count": 1040, "sentence_count": null, "sentence_version": null, "source_group_id": "group-d300a0c6336bc110ce4d8e35", "source_sha256": "sha256:bbdccc3b9613387b64c22267eaa8e019a8320769fafd9e3a52526d789875b0ad", "source_text": "{\"address\":\"140 N. Fairview\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":null,\"lot\":true,\"street\":false,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":\"free\"},\"business_stars\":3.0,\"categories\":\"Tex-Mex, Tacos, Restaurants, Fast Food, Breakfast & Brunch, Mexican\",\"city\":\"Goleta\",\"hours\":{\"Friday\":\"7:0-1:0\",\"Monday\":\"7:0-0:0\",\"Saturday\":\"7:0-1:0\",\"Sunday\":\"7:0-0:0\",\"Thursday\":\"7:0-0:0\",\"Tuesday\":\"7:0-0:0\",\"Wednesday\":\"7:0-0:0\"},\"name\":\"Taco Bell\",\"review_info\":[{\"review_date\":\"2021-11-01 18:03:53\",\"review_stars\":5.0,\"review_text\":\"When I want food quickly and service in a hurry; this is my \\\"go to fast food supplier\\\" \\n  I have received the wrong order; once; it was still a good meal. The manager replaced the order; free; the next time I was in; with NO problem. \\nIf you expect instant service at NOON ; forget it. If there are twelve people in line; be patient. \\nDo NOT be rude and ruin everyone else's day.\\nWe will be back again and again and again.\\n  Three of us ate at this Taco Bell yesterday. Walked in one person ahead of us; at 11:45. Ordered; filled our drinks; the order was delivered and 100% correct including extra napkins; before we were able to find a seat. \\n   Way to go Taco Bell!\"},{\"review_date\":\"2021-10-20 16:39:58\",\"review_stars\":1.0,\"review_text\":\"Vile.   We had to throw out food due to long black hair mixed inside a burrito.  It's obvious their safety practices are non existent.   Just go around the corner to Los Arroyos.  Go anywhere else for that matter.  It's disgusting.\"},{\"review_date\":\"2021-06-15 17:33:35\",\"review_stars\":1.0,\"review_text\":\"This Taco Bell is something else. The workers are passive aggressive. I asked if the order was mine and they responded with \\\"They've been calling some name out so it must be yours\\\" with attitude but I didn't want to take some order if I didn't know what the bag contained. I also ordered a drink and that bag didn't have one so.. When I asked for my orange juice I held out my left hand and the guy purposely handed it on the opposite side like he was messing with me. I didn't appreciate this as it was early in the morning. They also passive aggressively told my friends the restroom code when asked and didn't give their drinks with their order as well.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0027935929992963793, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 1059, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 450, "byte_start": 0, "call_id": "sha256:12856be789bfba63344418