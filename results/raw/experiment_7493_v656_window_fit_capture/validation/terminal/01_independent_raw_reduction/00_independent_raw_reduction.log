sha256:123733f6fc0591465bc94d6b762b952dafa72ba113500b60dfbd0d939ae75698", "response_text": "Flavor of India is a Pakistani restaurant located at 3026 State St in Santa Barbara, California. The business offers a variety of cuisines such as Indian, Pakistani, seafood, halal, vegetarian, vegan, and buffet. The restaurant has outdoor seating and offers takeout services. It also has a parking lot and validated parking. Flavor of India takes reservations and is suitable for groups of any size. The restaurant's ambiance is casual, and it offers music. Flavor of India has a rating of 4.0 out of 5.0 stars on Yelp, with most customers praising the food quality and service. However, some customers have had negative experiences with the restaurant, stating that the food quality was poor and that the restaurant should be called a fusion of cuisines rather than Flavors of India. Overall, Flavor of India appears to be a popular local spot for authentic Indian food and excellent service.", "role": "training", "sealed_prompt_sha256": "sha256:0a27b50f4133ec232a8b54ce63fe0c95acc1cfb6fe47d3080fd29702d0f1c121", "sealed_prompt_token_count": 898, "sentence_count": 3, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-c913de7fc0a9f5323e7c8828", "source_sha256": "sha256:6942c36bf9b8c0f198a5bd0dd0d65e9770887b60b11a3475222258ba91f0c55b", "source_text": "{\"address\":\"3026 State St\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":true,\"WiFi\":\"no\"},\"business_stars\":4.0,\"categories\":\"Pakistani, Restaurants, Buffets, Seafood, Halal, Indian, Vegetarian, Vegan, Food, Salad, Desserts\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"16:30-21:30\",\"Monday\":\"16:30-21:30\",\"Saturday\":\"16:30-21:30\",\"Sunday\":\"15:0-21:0\",\"Thursday\":\"16:30-21:30\",\"Tuesday\":\"16:30-21:30\",\"Wednesday\":\"16:30-21:30\"},\"name\":\"Flavor of India\",\"review_info\":[{\"review_date\":\"2022-01-14 22:36:45\",\"review_stars\":4.0,\"review_text\":\"Came for lunch and sat on their nice patio.  We ordered the chicken tikka masala combinations.  The dal was nicely flavored.  Loved the raita!  The matar aloo was very good as well.  Only thing that could have been better was that the chicken was a bit dry.  Our plates came with ample rice and naan.  Nice meal at a great price!\"},{\"review_date\":\"2022-01-07 05:43:14\",\"review_stars\":1.0,\"review_text\":\"Absolutely horrendous food. These guys should really stop calling themselves as Flavors of India as they have the worst chicken biryani that I have ever had. The biryani was more like chicken pullao, and served with no raita and salan. The paneer tika had too much orange color and chewy paneer.\\n\\nWorst part is their claim that these flavors are based  on the demographics. If that's the case they should call is fusion food not, flavors of India. If you ever eat here, remember, Indian food tastes much better!\"},{\"review_date\":\"2022-01-03 20:13:34\",\"review_stars\":5.0,\"review_text\":\"The best in SB!! Definitely give this place your business!! Food is authentic and service is the best. They gave my friends and I free dessert AND I saw that they pay their employees very well. Just an all around good local spot to support.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0015409919997182442, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "win