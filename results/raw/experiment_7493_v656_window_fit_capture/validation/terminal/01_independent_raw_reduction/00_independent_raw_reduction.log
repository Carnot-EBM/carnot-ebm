15666, 25], "raw_logits_by_display_label": {" A": 15.679040908813477, " B": 15.50584602355957}, "raw_logits_by_option_id": {"contains_unsupported": 15.50584602355957, "supported": 15.679040908813477}, "readout_s": 5.508300000656163e-05, "request_id": "sha256:7a58c296516d4bc4b7d88cda", "requested_score_position": 1090, "response_sha256": "sha256:3d589dae1141bf52743cd67e41b3e712e979d142aa8dae64d132fbc9c8df95ef", "response_text": "\"A Piece of Cake\" is a bakery located in Santa Barbara, CA, categorized under Food, Restaurants, Bakeries, and Desserts. The bakery accepts reservations and is suitable for groups. However, it has a mixed reputation among its customers. Based on reviews, some customers praised the bakery for its exceptional cake flavors and timely delivery. One customer even mentioned that the cake from \"A Piece of Cake\" was the highlight of their wedding. However, other reviews raised concerns about the lack of professionalism, the unsanitary conditions of the kitchen, and the owner's alleged habit of preparing cakes last minute in an unsuitable environment. Reviewers also mentioned the lack of fondant at tastings and difficulty in getting clear cost information. These contrasting experiences have resulted in an average rating of 2 stars for the bakery.", "role": "training", "sealed_prompt_sha256": "sha256:80150d69003017f4bbe26eff0749f9b39bdd39c25d66018836e132d4a7c29d86", "sealed_prompt_token_count": 1091, "sentence_count": 4, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-237af2c550182b54e2840d64", "source_sha256": "sha256:8ecdf43445678125b1ce96c607b5ce1bafba12d5680afc90f3dcfc73993fe8ba", "source_text": "{\"address\":\"\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":null,\"Music\":null,\"OutdoorSeating\":null,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":null,\"WiFi\":null},\"business_stars\":2.0,\"categories\":\"Food, Restaurants, Bakeries, Desserts\",\"city\":\"Santa Barbara\",\"hours\":null,\"name\":\"A Piece of Cake\",\"review_info\":[{\"review_date\":\"2013-07-30 03:43:45\",\"review_stars\":5.0,\"review_text\":\"Having Theresa make our cake was the best decision of our wedding. She drove from Santa Barbara to Camarillo to meet us for the cake tasting. All the samples were amazing so we agreed to have three different flavors for each of the three layers of our cake. \\n\\nOn our wedding day the cake arrived on time and was beautifully decorated with fresh flowers. She even let us borrow one of her cake stands.  My wedding was almost a year ago and I almost forgot to give a feedback of my great experience with \\\"A Piece of Cake\\\". Her cakes are EXCEPTIONALLY AMAZING. People kept talking about it after the wedding. Theresa makes the best cakes my guests and I have ever eaten.\"},{\"review_date\":\"2013-06-05 17:10:53\",\"review_stars\":1.0,\"review_text\":\"A Piece of Cake is not a legitimate business. Teresa makes her cakes from her home which smells of odorous dog and mold. Her home/kitchen is unsanitary and is not rated by any government agency. She prepares her cakes and other \\\"treats\\\" last minute, in a filthy kitchen while her three dogs play nearby. \\n\\nHas anyone ever wondered why you can't get a tasting appointment at her store or in a kitchen? It's because there isn't one. She claims to rent space in a kitchen, however, I suspect this is a lie. I had the misfortune of knowing Teresa for a few months. She would often bore me with tales of unsatisfied customers and I can tell you most, if not all of the poor reviews you've read are worse than the reviewer knows and could describe. Apart from her ruining, or coming close to ruining several events, she doesn't give refunds - rather, she might give you credit so you can purchase some more tainted confections and ruin another event of yours.\\n\\nTeresa is not a professional cake baker, nor is she any sort of a businesswoman. Some of her cakes do appear aesthetically pleasing and may even taste good, however, if you knew what you were getting yourself into when you ordered a cake, you might rethink your decision. I doubt she keeps any sort of records or invoices and if you knew her current state of affairs, it would send up a red flag telling you how well, or not, she runs her cake baking operation. \\n\\nI'm not sure what she charges but if you can put a price on not getting sick by eating her cake or knowing that your wedding cake doesn't has dog hair in it, then it probably wouldn't be worth it for you to buy a cake from \\\"A Piece of Crap\\\" - sorry *cake.\"},{\"review_date\":\"2013-03-30 03:15:59\",\"review_stars\":1.0,\"review_text\":\"I have to agree with the other reviewers: Teresa makes good cake, but needs to work on her professionalism. She was more than 30 minutes late to our appointment and had a really hard time telling us what things cost. She didn't pay attention to what I wanted and kept on pointing me to other ideas. Also, most wedding cakes use fondant and she didn't bring any fondant to our tasting.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0030304250003609923, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 0, "window_sha256": "sha256:590905bf7ef277222f7b4839404b2fbaee583e8b886fdc7ebdf0547edd56b7c7", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 1091, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 651, "byte_start": 343, "call_id": "sha256:16a151ee2513f7dd3ac5ccd3", "disposition"