ve goes into the food.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0016857300006449805, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 2, "window_sha256": "sha256:793d14633566f4a98066d80f9caa387fb9acc786f3c1a25db7deb8ae04edff97", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 589, "archived_pilot_reuse": false, "arm": "whole_response", "attempted": true, "byte_end": null, "byte_start": null, "call_id": "sha256:2632b9d7aa552fe94ee8f990", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-59293088a8b5b0487a981298", "kv_state_id": "reset-epoch-517", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 4.131977081298828, "marked_response": null, "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["supported", "contains_unsupported"], "order_remapping": {" A": "supported", " B": "contains_unsupported"}, "prefill_s": 0.7130757150007412, "probabilities_by_option_id": {"contains_unsupported": 0.9842024551037323, "supported": 0.015797544896267612}, "prompt_sha256": "sha256:92a6c19f0d4359fce63d32da45413f9ed5b0ba99277022128e6f4c55e8816829", "prompt_token_count": 590, "prompt_token_ids": [1890, 1386, 1761, 364, 279, 4434, 1965, 1608, 1132, 279, 16713, 2450, 13, 271, 41578, 198, 4754, 6184, 1098, 3147, 6184, 416, 220, 16, 25, 16, 60086, 43973, 22908, 1892, 4081, 22908, 4954, 310, 6601, 383, 8117, 2305, 321, 3166, 279, 24066, 314, 279, 28475, 13, 220, 17, 220, 733, 5089, 31