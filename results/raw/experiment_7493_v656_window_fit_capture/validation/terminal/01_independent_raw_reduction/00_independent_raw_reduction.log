41, 80831, 69909, 2290, 7870, 7860, 369, 264, 10413, 7172, 303, 218020, 33467, 11, 6824, 421, 16545, 8193, 33847, 11, 11352, 55377, 303, 4941, 2542, 13, 10235, 310, 836, 4861, 11, 781, 2915, 264, 7792, 314, 60598, 77534, 11, 170161, 11, 321, 975, 8343, 69909, 2290, 24958, 13, 561, 10413, 682, 264, 10412, 314, 220, 17, 13, 20, 9467, 3018, 383, 5813, 8120, 321, 682, 978, 1724, 2394, 220, 17, 15, 16, 24, 13, 271, 3833, 53650, 35172, 279, 4941, 2542, 11, 26895, 421, 424, 557, 328, 51859, 11, 2098, 1603, 1, 321, 799, 314, 279, 1786, 781, 2908, 995, 4732, 314, 46627, 84321, 13, 4213, 11, 781, 10036, 421, 279, 5817, 557, 10548, 321, 781, 995, 310, 708, 2094, 279, 8858, 310, 2361, 10413, 310, 1925, 836, 1906, 13, 12908, 53650, 1669, 279, 18740, 321, 2393, 310, 381, 36862, 11, 8008, 421, 279, 3487, 557, 888, 631, 7332, 7463, 310, 279, 4131, 13, 357, 4688, 53650, 995, 264, 7695, 7968, 3039, 11, 12459, 421, 279, 3421, 31178, 1070, 680, 314, 279, 10413, 1973, 12314, 680, 660, 314, 836, 11128, 24958, 321, 1973, 9663, 11, 8552, 975, 6112, 1990, 1602, 2945, 13, 271, 26597, 11, 20018, 80831, 69909, 2290, 7870, 7860, 7701, 310, 599, 9238, 8120, 11, 440, 1010, 6112, 20756, 279, 3487, 694, 3672, 8996, 279, 2393, 321, 869, 310, 381, 1146, 1671, 13, 1049, 1189, 381, 5621, 16230, 364, 279, 4941, 2542, 11, 694, 6112, 1220, 381, 7605, 314, 4499, 4562, 440, 279, 2393, 321, 5817, 2528, 13, 271, 55025, 198, 32, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 198, 33, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 12.3732271194458, " B": 16.62054443359375}, "raw_logits_by_option_id": {"contains_unsupported": 16.62054443359375, "supported": 12.3732271194458}, "readout_s": 4.199900013190927e-05, "request_id": "sha256:e437b0afd3b5add5205898ad", "requested_score_position": 1112, "response_sha256": "sha256:3369da50d221cb2cf82835103360ecb2e65b5257e05923ee98fc78c26a781e4e", "response_text": "Sure! Here's an objective overview of Hanamura Cantonese Dim Sum based on the provided structured data:\n\nHanamura Cantonese Dim Sum is a restaurant located in Isla Vista, California that serves Chinese cuisine, specifically specializing in dim sum. According to their menu, they offer a variety of dumplings, bao, and other traditional Cantonese dishes. The restaurant has a rating of 2.5 stars based on customer reviews and has been open since 2019.\n\nOne reviewer praised the dim sum, stating that it was \"really, really good\" and one of the best they've had outside of Chinatown. However, they noted that the door was broken and they had to go around the corner to another restaurant to place their order. Another reviewer found the portions and service to be disappointing, feeling that the food was overpriced compared to the quality. A third reviewer had a particularly negative experience, reporting that the server rushed them out of the restaurant without bringing out all of their ordered dishes and without warning, despite other customers still being present.\n\nOverall, Hanamura Cantonese Dim Sum appears to have mixed reviews, with some customers enjoying the food but others finding the service and value to be subpar. It may be worth visiting for the dim sum, but customers should be aware of potential issues with the service and door access.", "role": "training", "sealed_prompt_sha256": "sha256:d08d49196f7c0c5a2264c82e75d51253d745c111c05d9377cd792773068b3667", "sealed_prompt_token_count": 1113, "sentence_count": null, "sentence_version": null, "source_group_id": "group-95e8dbe64415434f50477184", "source_sha256": "sha256:6e9170b11d19f848cddd7faa7479f6e22598b8daf262cb71916b9a05129a4a43", "source_text": "{\"address\":\"901 Embarcadero Del Mar, Ste 104\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":true,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":false,\"street\":false,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":null,\"RestaurantsGoodForGroups\":null,\"RestaurantsReservations\":null,\"RestaurantsTakeOut\":null,\"WiFi\":null},\"business_stars\":2.5,\"categories\":\"Restaurants, Chinese, Dim Sum, Cantonese\",\"city\":\"Isla Vista\",\"hours\":{\"Friday\":\"9:0-22:0\",\"Monday\":\"16:30-22:0\",\"Saturday\":\"9:0-22:0\",\"Sunday\":\"9:0-22:0\",\"Thursday\":\"9:0-22:0\",\"Tuesday\":\"9:0-22:0\",\"Wednesday\":\"9:0-22:0\"},\"name\":\"Hanamura Cantonese Dim Sum\",\"review_info\":[{\"review_date\":\"2019-08-08 02:03:34\",\"review_stars\":4.0,\"review_text\":\"Dim Sum was really, really good.  Best I have found outside China town.  I would end my comments there, but when we went, the door was broken, so we had to go around the corner to another restaurant that was serving for them and their server was new and obviously untrained.  Hopefully by the time you go, the students will be back and they will have faster service.  But, I have to finish with \\\"The dim sum was awesome.\\\"\"},{\"review_date\":\"2019-06-26 07:19:22\",\"review_stars\":3.0,\"review_text\":\"I was a little skeptical but still excited to try this restaurant since it replaced Sorisso's, but the price and service was not worth the food. The dim sum servings were small and didn't come out hot/fresh and were pricy for their portions. I might be bias because I grew up going to quality dim sum for a great price, but objectively I don't think I'd come back unless they lowered their prices. Not on this college student budget at least !\"},{\"review_date\":\"2019-06-21 00:10:59\",\"review_stars\":1.0,\"review_text\":\"WTH just happened here?\\n\\nWe went in today, were seated and put in our order for 4 types of dim sum. The server brought out half our order and then announced to us that they were closing in FOUR MINUTES! She then proceeded to box up our food and hand us a bill. \\n\\nThere was another person besides our table, and that guy told the server he would be done soon but she started hustling him out too.\\n\\nFor the record the posted hours say they close at 10:00 PM. If some emergency came up, they should have warned us when we first came in. But there was no notice, no warning whatsoever. How can a business be run like that? Still smh.\\n\\nHey, owner, if you're reading this, I'd like an explanation please. You can't build a reputation on shoddy service, no matter how good your food is (it had become cold and soggy by the time we got home to \\\"enjoy\\\" it, so I can only rate you based on that quality and the terrible service we received).\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.002514298000278359, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 1132, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 387, "byte_start": 0, "call_id": "sha256:8c10773cd109a7958bed0677", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-95e8dbe64415434f50477184", "kv_state_id": "reset-epoch-804", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 2.508145332336426, "marked_response": "<<CARNOT_FOCUS_START:0:387>>Sure! Here's an objective overview of Hanamura Cantonese Dim Sum based on the provided structured data:\n\nHanamura Cantonese Dim Sum is a restaurant located in Isla Vista, California that serves Chinese cuisine, specifically specializing in dim sum. According to their menu, they offer a variety of dumplings, bao, and other traditional Cantonese dishes. The restaurant has a rating of 2.<<CARNOT_FOCUS_END>>5 stars based on customer reviews and has been open since 2019.\n\nOne reviewer praised the dim sum, stating that it was \"really, really good\" and one of the best they've had outside of Chinatown. However, they noted that the door was broken and they had to go around the corner to another restaurant to place their order. Another reviewer found the portions and service to be disappointing, feeling that the food was overpriced compared to the quality. A third reviewer had a particularly negative experience, reporting that the server rushed them out of the restaurant without bringing out all of their ordered dishes and without warning, despite other customers still being present.\n\nOverall, Hanamura Cantonese Dim Sum appears to have mixed reviews, with some customers enjoying the food but others finding the service and value to be subpar. It may be worth visiting for the dim sum, but customers should be aware of potential issues with the service and door access.", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["supported", "contains_unsupported"], "order_remapping": {" A": "supported", " B": "contains_unsupported"}, "prefill_s": 1.3463375080000333, "probabilities_by_option_id": {"contains_unsupported": 0.9247108689650138, "supported": 0.07528913103498633}, "prompt_sha256": "sha256:2b5990e7160852b0a9dcabd628f1affe8ab2ce4dfb85ca9820ca9ec5da9cb2c8", "prompt_token_count": 1133, "prompt_token_ids": [1890, 1386, 1761, 364, 279, 4434, 1965, 1608, 1132, 279, 16713, 2450, 13, 271, 41578, 198, 4754, 4834, 3147, 24, 15, 16, 5570, 2185, 66, 70740, 7086, 2783, 11, 3251, 220, 16, 15, 19, 2129, 11987, 21624, 52218, 1772, 21624, 23543, 899, 763, 3721, 1288, 1005, 88, 763, 1802, 1288, 67, 520, 88, 763, 3721, 1288, 92670, 763, 