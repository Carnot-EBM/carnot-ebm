ealed_prompt_token_count": 900, "sentence_count": 2, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-c913de7fc0a9f5323e7c8828", "source_sha256": "sha256:6942c36bf9b8c0f198a5bd0dd0d65e9770887b60b11a3475222258ba91f0c55b", "source_text": "{\"address\":\"3026 State St\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":true,\"WiFi\":\"no\"},\"business_stars\":4.0,\"categories\":\"Pakistani, Restaurants, Buffets, Seafood, Halal, Indian, Vegetarian, Vegan, Food, Salad, Desserts\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"16:30-21:30\",\"Monday\":\"16:30-21:30\",\"Saturday\":\"16:30-21:30\",\"Sunday\":\"15:0-21:0\",\"Thursday\":\"16:30-21:30\",\"Tuesday\":\"16:30-21:30\",\"Wednesday\":\"16:30-21:30\"},\"name\":\"Flavor of India\",\"review_info\":[{\"review_date\":\"2022-01-14 22:36:45\",\"review_stars\":4.0,\"review_text\":\"Came for lunch and sat on their nice patio.  We ordered the chicken tikka masala combinations.  The dal was nicely flavored.  Loved the raita!  The matar aloo was very good as well.  Only thing that could have been better was that the chicken was a bit dry.  Our plates came with ample rice and naan.  Nice meal at a great price!\"},{\"review_date\":\"2022-01-07 05:43:14\",\"review_stars\":1.0,\"review_text\":\"Absolutely horrendous food. These guys should really stop calling themselves as Flavors of India as they have the worst chicken biryani that I have ever had. The biryani was more like chicken pullao, and served with no raita and salan. The paneer tika had too much orange color and chewy paneer.\\n\\nWorst part is their claim that these flavors are based  on the demographics. If that's the case they should call is fusion food not, flavors of India. If you ever eat here, remember, Indian food tastes much better!\"},{\"review_date\":\"2022-01-03 20:13:34\",\"review_stars\":5.0,\"review_text\":\"The best in SB!! Definitely give this place your business!! Food is authentic and service is the best. They gave my friends and I free dessert AND I saw that they pay their employees very well. Just an all around good local spot to support.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0015338599996539415, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 2, "window_sha256": "sha256:27f4128b3c035dc4c2efa639224be2483d4ba7122defd986d261b596b65a018b", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 527, "archived_pilot_reuse": false, "arm": "whole_response", "attempted": true, "byte_end": null, "byte_start": null, "call_id": "sha256:1ed2e859f8913d98ae7411c8", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-cefade69c2f539d57e9d6214", "kv_state_id": "reset-epoch-1097", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": -0.6078977584838868, "marked_response": null, "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["supported", "contains_unsupported"], "order_remapping": {" A": "supported", " B": "contains_unsupported"}, "prefill_s": 0.646211814999333, "probabilities_by_option_id": {"contains_unsupported": 0.3525388966426