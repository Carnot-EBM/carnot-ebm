256": "sha256:cfa3885c9911e616b0a6e69abc5e7c1d57171d251795ed69bc4e2417b348acc1", "response_text": "Empty Bowl Gourmet Noodle Bar is a restaurant located in Santa Barbara, California at 38 W Victoria St, Ste 109. They offer a variety of cuisines including comfort food, Asian fusion, Chinese, tapas/small plates, noodles, Thai, and restaurants. The hours of operation are Monday to Sunday from 11am to 9pm. They offer outdoor seating and free Wi-Fi. The restaurant takes out orders, is good for groups and serves alcohol. The restaurant is rated 4.5 stars and has several reviews online. One customer praised the Northern Thailand Curry Noodle, saying it was perfectly balanced with the right amount of spice. Another customer highly recommended trying the chicken wings and the pan fried pancit noodles. However, one customer found the prices to be high for the portion size and felt the service was average. Overall, based on the provided information, Empty Bowl Gourmet Noodle Bar seems to be a popular spot for Thai food in Santa Barbara.", "role": "training", "sealed_prompt_sha256": "sha256:dba1da070c60041450fbd80d046bc8a574f059c7a4eeeb57f25892b104cd319c", "sealed_prompt_token_count": 1141, "sentence_count": 3, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-39794fd4bf545ebf1ff524af", "source_sha256": "sha256:b304fd4b2016bab2e01721ebc53caa94a6d1c441df66edf341c7c0ec89966924", "source_text": "{\"address\":\"38 W Victoria St, Ste 109\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":true,\"divey\":false,\"hipster\":true,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":true,\"upscale\":false},\"BusinessParking\":{\"garage\":true,\"lot\":false,\"street\":true,\"valet\":false,\"validated\":true},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":\"free\"},\"business_stars\":4.5,\"categories\":\"Comfort Food, Asian Fusion, Chinese, Tapas/Small Plates, Noodles, Thai, Restaurants\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"11:0-21:0\",\"Monday\":\"0:0-0:0\",\"Saturday\":\"11:0-21:0\",\"Sunday\":\"11:0-21:0\",\"Thursday\":\"11:0-21:0\",\"Tuesday\":\"11:0-16:0\",\"Wednesday\":\"11:0-21:0\"},\"name\":\"Empty Bowl Gourmet Noodle Bar\",\"review_info\":[{\"review_date\":\"2022-01-13 06:06:46\",\"review_stars\":5.0,\"review_text\":\"The Empty Bowl is one of my favorite Thai restaurants in town! The curry noodles is my favorite dish. It's creamy but not too rich that you can't eat the whole bowl as a meal. I also love the papaya salad. It is fresh and just the right amount of sourness. I usually order the curry noodles but this time I ordered the hang over noodles and they were extremely spicy for some reason. I had to trade meals with my boyfriend who had curry noodles. This Thai restaurant has more interesting dishes than many of the Thai places in Santa Barbara. I would definitely want to try their chicken wings and their pad see ew.\"},{\"review_date\":\"2022-01-13 04:44:08\",\"review_stars\":5.0,\"review_text\":\"Now before I begin, I want everyone to know this place is outstanding. First off, the public market is such an exquisite place to be if you ever land in Santa Barbara and are not sure on which cuisine you want. Since I was in the food industry for quite some time, my wife has been a huge fan of green star coffee, which is what led us to the public market. After purchasing the coffee from public market, we were drawn to the smell of Empty Bowl. If you aren't sure what to get, you can't go wrong with the Northern Thailand Curry Noodle. The ratio between the rice noodles and crunchy noodles in combination with their coconut curry broth is pure perfection. The chicken absolutely melts off the bone leaving you in a trance. My wife ordered the pan fried pancit noodles and couldn't rave about it enough. We were bummed off the dessert menu because they didn't have anything.. but we enjoyed dessert at rori's ice cream a few steps after leaving empty bowl. 10/10\"},{\"review_date\":\"2022-01-05 20:22:18\",\"review_stars\":4.0,\"review_text\":\"-Food-\\n5/5! Delicious Thai food with a ton of flavor. I ordered Bangkok noodles and they were just the right amount of spices. But I would say pretty pricey! For their average portioned noodle bowls, they were around $18 after tax. \\n\\n-Service-\\nThey were average in preparation time, but they give you a machine that vibrates when your food is ready! It's nice to be able to walk around while the food is getting ready!\\n\\n-Looks-\\nThe restaurant is one of the many within Santa Barbara's public market! There's a ton of cuisine options there, but I only tried this location. \\n\\nThere's plenty of free street parking, so avoid the paid parking lots if you can.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0019632600005934364, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 0, "window_sha256": "sha256:956383db5cdda3b672bf784d47ea8235114bd04d45f348f05f4ddaa29eb0bf7a", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 1142, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 610, "byte_start": 307, "call_id": "sha256:d5baca373e98ae4200d6e2e3", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-39794fd4bf545ebf1ff524af", "kv_state_id": "reset-epoch-323", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": 4.280694007873535, "marked_response": "Empty Bowl Gourmet Noodle Bar is a restaurant located in Santa Barbara, California at 38 W Vi