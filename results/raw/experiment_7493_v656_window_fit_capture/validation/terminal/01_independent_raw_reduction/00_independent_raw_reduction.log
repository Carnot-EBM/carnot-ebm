ess_stars\":4.0,\"categories\":\"Restaurants, Indian, Himalayan/Nepalese\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"11:30-22:0\",\"Monday\":\"0:0-0:0\",\"Saturday\":\"11:30-22:0\",\"Sunday\":\"11:30-22:0\"},\"name\":\"Himalayan Kitchen\",\"review_info\":[{\"review_date\":\"2022-01-07 06:14:15\",\"review_stars\":5.0,\"review_text\":\"Great food and staff.I absolutely love momos  and thought this would be a good place to have them. We got the veg thupka  and momos. The thupka had just perfect balance between the noodles and vegetables. The food arrived in a very short time.Definitely recommend to go here.\"},{\"review_date\":\"2021-12-27 03:40:06\",\"review_stars\":4.0,\"review_text\":\"By looking in from outside as soon as they opened for dinner, I hesitated to go in. It was early and the restaurant was still had only a few customers. I was staying overnight in the area and I was new to the neighborhood. The food was excellent. One of the dishes we ordered along with chicken vindaloo, Aloo Govi, and naan, was Himalayan special chow meon. From the spicy level of 1-10, we chose 7. It was delicious but a bit too spicy for me to fully enjoy although I can proudly say I can handle spicy food. Maybe next time I will choose 5. The food was amazing with cold beer. The price was very reasonable too. By the time we were leaving, the restaurant was packed with customers.\"},{\"review_date\":\"2021-12-19 00:27:08\",\"review_stars\":5.0,\"review_text\":\"Really flavorful and interesting food. I got the vegetable curry. It was delicious and had a great depth of flavor. It was a bit oily, but not over-the-top. My friend ordered the ming bean noodle dish. It was really good as well, the flavor was a bit more tamed. It had a nice garlicky taste and the vegetables in it were delicious, especially the mushrooms which were perfectly saut\u00e9ed. The pickled vegetables condiment was really nice and reminded me of the super salty pickled lime skin you get with some types of Indian cuisine. Great place - very vegan and vegetarian friendly.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.001640005000808742, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 0, "window_sha256": "sha256:9851e43e4c200d406c2e87c9a98624c20f53a79459058a42f68bd182596f6125", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 902, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 475, "byte_start": 235, "call_id": "sha256:1820e36914001ab5b476ae32", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-2fcaee78390d52b290c800b0", "kv_state_id": "reset-epoch-1475", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": 3.4955434799194336, "marked_response": "Himalayan Kitchen is a Nepalese and Indian restaurant located in Santa Barbara, CA. The restaurant offers a variety of dishes including momos, thukpa, chow mein, vindaloo, and naan. The menu also includes vegetarian and vegan options. <<CARNOT_FOCUS_START:235:475>>The restaurant has a cozy atmosphere with outdoor seating and free Wi-Fi. According to customer reviews, the food is delicious and flavorful with a perfect balance of spices. The service is fast and friendly, and the prices are reasonable. <<CARNOT_FOCUS_END>>The restaurant is open Monday through Sunday, with extended hours on weekends. Reservations are accepted, and takeout is available. Overall, Himalayan Kitchen is a great spot for those looking for authentic Nepalese and Indian cuisine in a casual and welcoming environment.", "model_sha256": "sha256:7e78da5d7e3ae28d178121f5864