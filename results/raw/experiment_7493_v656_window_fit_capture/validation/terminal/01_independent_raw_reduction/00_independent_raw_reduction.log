, 25], "raw_logits_by_display_label": {" A": 15.946066856384277, " B": 13.697134971618652}, "raw_logits_by_option_id": {"contains_unsupported": 15.946066856384277, "supported": 13.697134971618652}, "readout_s": 3.7690999306505546e-05, "request_id": "sha256:0faa9ed5fc91b1f935421a0b", "requested_score_position": 1123, "response_sha256": "sha256:bf72649dbb81dfd7a31073b34dfcbc281fb429193dcfbc3ea997392a1598f0bd", "response_text": "Tri Tip Company is a local business located at 214 State St in Santa Barbara, CA. It is categorized as a bar, nightlife, restaurant, barbecue, and American (Traditional) establishment. The business is open from 11:00 AM to 10:00 PM from Monday to Wednesday, and from 11:00 AM to midnight from Thursday to Sunday.\n\nCustomers have left varying reviews about Tri Tip Company. One customer mentioned that they tried three sandwiches before the business closed and found them amazing. They particularly enjoyed the Pho sandwich and the BLT Tri tip, as well as the included bean chili. This customer gave the business a 5-star rating. \n\nHowever, another customer had a negative experience, stating that the Tri tip sandwich they ordered was cold, the meat was chewy, and the bread was stale. They expressed disappointment and felt that the sandwich was not worth the $12 price. This customer gave a 2-star rating.\n\nAnother customer was also disappointed with their visit to Tri Tip Company. They mentioned that the prices had been raised since the menu pictures on Yelp were taken and that the tables were dirty. They found the sliced Tri tip to be lacking flavor, the bread undercooked, and the overall experience underwhelming. They advised the business to perfect their specialty if they are going to name the restaurant after it. This customer also gave a 2-star rating.\n\nBased on the provided information, Tri Tip Company has received mixed reviews. It is known for its sandwiches, particularly the Pho sandwich and the BLT Tri tip. However, some customers have had negative experiences, mentioning issues with the quality of the food and the cleanliness of the establishment.", "role": "calibration_tuning", "sealed_prompt_sha256": "sha256:aac9af722fc57e09121b7351e3dd320f14496e489f96202900800bfa76ae7aa8", "sealed_prompt_token_count": 1124, "sentence_count": 6, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-df78cfa935958ad29f3e2c91", "source_sha256": "sha256:30091a9240e35a7b7aab9d0a3ad05028aba5edb8d72e82173b527dcc37ec6dfa", "source_text": "{\"address\":\"214 State St\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":false,\"divey\":false,\"hipster\":true,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":false,\"valet\":false,\"validated\":false},\"Music\":false,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":true,\"WiFi\":null},\"business_stars\":4.0,\"categories\":\"Bars, Nightlife, Restaurants, Barbeque, American (Traditional)\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"11:0-0:0\",\"Monday\":\"11:0-22:0\",\"Saturday\":\"11:0-0:0\",\"Sunday\":\"11:0-0:0\",\"Thursday\":\"11:0-0:0\",\"Tuesday\":\"11:0-22:0\",\"Wednesday\":\"11:0-22:0\"},\"name\":\"Tri Tip Company\",\"review_info\":[{\"review_date\":\"2015-01-09 00:41:25\",\"review_stars\":5.0,\"review_text\":\"I tried three sandwiches here before they closed. It was amazing! The building was great too. I hope the owner brings something to Santa Barbara because this was 5 stars!\\n\\nPho sandwich was great, BLT Trip tip was amazing. The bean chili they include was great too.\"},{\"review_date\":\"2014-11-30 21:58:53\",\"review_stars\":2.0,\"review_text\":\"Not worth the money.  Tri tip sandwich was cold, meat was chewy, bread was stale. Not happy. Definitely not worth $12 per sandwich. Sadly disappointed :(\"},{\"review_date\":\"2014-11-30 17:33:02\",\"review_stars\":2.0,\"review_text\":\"I really wanted to like you, Tri tip co., seriously. Came here at noon on a Friday. We were the only ones there. Walk in, the guy at the counter asks what we want before we even pick up a menu. First thing I notice is the prices have already been raised from the menu pictures here on yelp by about $2 per sandwich. That's not a good sign considering they've only been opened about 7 weeks. Anyway, I ordered the Santa Maria and my boyfriend ordered the barbecue. We take a seat outside because it was stuffy inside and the tables all needed to be cleaned. We waited a good 20 minutes for our sandwiches to come out... And like I said we were the only ones there. After waiting 20 mins for a sandwich, you're expecting something pretty great. Well we were seriously let down. Thin sliced Tri tip with very little flavor, bread that could have been toasted another full minute, potato chips, and finally some bean liquid with a few beans floating around. Please, please, please, if you're going to specialize in one thing and name your restaurant after it, make sure you have it perfected. Sadly the Tri tip company does not.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0019998839998152107, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 2, "window_sha256": "sha256:5698176ff7ae5eafa77c22643d04e6cb3ebe0cd769ea85eef8feb43d1fe40807", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 659, "archived_pilot_reuse": false, "arm": "whole_response", "attempted": true, "byte_end": null, "byte_start": null, "call_id": "sha256:acb76c52cdabb0ba9fabde85", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label