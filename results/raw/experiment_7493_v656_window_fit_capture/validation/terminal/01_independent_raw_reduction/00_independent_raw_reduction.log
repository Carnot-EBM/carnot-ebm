7, 17, 12, 15, 16, 12, 15, 18, 220, 16, 22, 25, 17, 16, 25, 16, 15, 2129, 18828, 1217, 1506, 763, 20, 13, 15, 1288, 18828, 4185, 3147, 20740, 16976, 32420, 440, 264, 1593, 314, 6824, 579, 231219, 13, 13412, 3726, 18237, 11, 59085, 11, 13689, 62962, 26969, 1076, 2503, 310, 708, 4808, 1149, 92, 27573, 2374, 3147, 4887, 8934, 271, 65498, 24422, 198, 35, 6, 10427, 19559, 579, 87498, 369, 264, 2136, 2478, 7172, 506, 220, 17, 20, 457, 49844, 91797, 769, 303, 15521, 30089, 11, 8910, 13, 1049, 369, 264, 62944, 421, 1048, 16545, 16976, 321, 67454, 11, 9708, 264, 7792, 314, 3162, 3884, 321, 10482, 13, 561, 62944, 682, 3816, 6572, 5813, 8120, 11, 440, 449, 5289, 10412, 314, 220, 18, 13, 20, 9467, 13, 4558, 43352, 599, 35172, 279, 62944, 364, 1141, 7648, 10482, 321, 3162, 3884, 11, 21988, 1070, 430, 328, 403, 314, 411, 1814, 1149, 2302, 599, 1048, 9444, 279, 11321, 321, 70324, 5395, 11, 7695, 37306, 47148, 11, 279, 33826, 3421, 11, 321, 8254, 11, 279, 6436, 11, 852, 56672, 421, 781, 995, 264, 2172, 854, 13, 561, 57043, 12917, 836, 26382, 310, 460, 310, 414, 6, 10427, 19559, 579, 87498, 321, 24986, 279, 2478, 364, 22413, 1680, 7648, 1208, 852, 1801, 836, 10482, 3039, 10794, 13, 271, 760, 62944, 5529, 264, 23050, 16078, 440, 15325, 36064, 11, 10377, 6112, 310, 4517, 836, 16976, 440, 264, 1593, 314, 6824, 579, 231219, 13, 561, 20616, 1503, 524, 2915, 38731, 694, 1503, 599, 1831, 403, 2519, 2420, 13, 1049, 1503, 524, 3300, 32204, 11, 694, 6112, 599, 9444, 279, 6217, 91305, 321, 11321, 16078, 13, 271, 26597, 11, 414, 6, 10427, 19559, 579, 87498, 369, 264, 7309, 10779, 2136, 2478, 303, 15521, 30089, 11, 7984, 17387, 3162, 3884, 11, 10482, 11, 321, 264, 23050, 17378, 3039, 13, 271, 55025, 198, 32, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 198, 33, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 14.305371284484863, " B": 16.791078567504883}, "raw_logits_by_option_id": {"contains_unsupported": 16.791078567504883, "supported": 14.305371284484863}, "readout_s": 3.3603000701987185e-05, "request_id": "sha256:55bbedf2390a432c78cdc0cf", "requested_score_position": 783, "response_sha256": "sha256:075dd5a7367dd9d4cc6d14fd6d536491d1672ff9183110af66297b872bc694d1", "response_text": "D'Angelo's Bakery is a local business located at 25 W Gutierrez St in Santa Barbara, CA. It is a bakery that also serves breakfast and brunch, offering a variety of pastries and coffee. The bakery has received positive customer reviews, with an average rating of 3.5 stars. \n\nCustomers have praised the bakery for its amazing coffee and pastries, describing them as \"out of this world.\" They have also mentioned the friendly and attentive staff, particularly highlighting JP, the Brazilian server, and Alex, the manager, who ensured that they had a great time. The reviewers expressed their excitement to return to D'Angelo's Bakery and appreciated the business for hiring such amazing people who made their coffee experience wonderful.\n\nThe bakery provides a pleasant atmosphere with outdoor seating, allowing customers to enjoy their breakfast with a view of California's Riviera. The establishment does not offer reservations but does have takeout options available. It does not provide WiFi, but customers have mentioned the nice ambiance and friendly atmosphere.\n\nOverall, D'Angelo's Bakery is a highly recommended local business in Santa Barbara, providing delicious pastries, coffee, and a pleasant dining experience.", "role": "training", "sealed_prompt_sha256": "sha256:210f4999b8d116c275db7332ba19eecfeb2cf48af49972c7875044774ce2f558", "sealed_prompt_token_count": 784, "sentence_count": null, "sentence_version": null, "source_group_id": "group-2802fb2bb4d427ba7d1890ac", "source_sha256": "sha256:d195cb30d97fd66878564725bed92d586537b7976521917c05669c766761416e", "source_text": "{\"address\":\"25 W Gutierrez St\",\"attributes\":{\"Ambience\":{\"casual\":true,\"classy\":true,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":true,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":false,\"RestaurantsReservations\":false,\"RestaurantsTakeOut\":null,\"WiFi\":\"no\"},\"business_stars\":3.5,\"categories\":\"Restaurants, Food, Breakfast & Brunch, Bakeries\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"7:0-14:0\",\"Monday\":\"7:0-14:0\",\"Saturday\":\"7:0-14:0\",\"Sunday\":\"7:0-14:0\",\"Thursday\":\"7:0-14:0\",\"Tuesday\":\"7:0-14:0\",\"Wednesday\":\"7:0-14:0\"},\"name\":\"D'Angelo's Bakery\",\"review_info\":[{\"review_date\":\"2022-01-17 21:37:46\",\"review_stars\":5.0,\"review_text\":\"Had the pleasure to have coffee with some friends! We had an amazing time. The coffee and pastries where amazing out of this world!\\nWe were in awe by the awesomeness of JP, our amazing Brazilian server and Alex the manager that were constantly making sure we were having a great time! Can't wait to go back! Thank you D'Angelo for hiring amazing people that can make having coffee a wonderful experience\"},{\"review_date\":\"2022-01-09 21:38:59\",\"review_stars\":5.0,\"review_text\":\"Really nice atmosphere and everyone is super nice. I love the pastries and coffee here! Definitely recommend coming here.\"},{\"review_date\":\"2022-01-03 17:21:10\",\"review_stars\":5.0,\"review_text\":\"Great breakfast outdoors with a view of California's Riviera. Poached eggs, Benedict, croissant sandwich... hard to go wrong.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.001954774000296311, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 803, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 387, "byte_start": 0, "call_id": "sha256:a2cf8264d9622f0934a80259", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-2802fb2bb4d427ba7d1890ac", "kv_state_id": "reset-epoch-214", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 2.5293569564819336, "marked_response": "<<CARNOT_FOCUS_START:0:387>>D'Angelo's Bakery is a local business located at 25 W Gutierrez St in Santa Barbara, CA. It is a bakery that also serves breakfast and brunch, offering a variety of pastries and coffee. The bakery has received positive customer reviews, with an average rating of 3.5 stars. \n\nCustomers have praised the bakery for its amazing coffee and pastries, describing them as \"out of this world.\" <<CARNOT_FOCUS_END>>They have also mentioned the friendly and attentive staff, particularly highlighting JP, the Brazilian server, and Alex, the manager, who ensured that they had a great time. The reviewers expressed their excitement to return to D'Angelo's Bakery and appreciated the business for hiring such amazing people who made their coffee experience wonderful.\n\nThe bakery provides a pleasant atmosphere with outdoor seating, allowing customers to enjoy their breakfast with a view of California's Riviera. The establishment does not offer reservations but does have takeout options available. It does not provide WiFi, but customers have mentioned the nice ambiance and friendly atmosphere.\n\nOverall, D'Angelo's Bakery is a highly recommended local business in Santa Barbara, providing delicious pastries, coffee, and a pleasant dining experience.", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb