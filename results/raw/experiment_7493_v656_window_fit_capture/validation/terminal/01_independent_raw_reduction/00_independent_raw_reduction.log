44, 11068, 8292, 11109, 11, 852, 599, 61521, 5839, 11182, 2272, 35850, 13, 561, 4614, 579, 4643, 668, 1381, 599, 310, 53245, 440, 449, 5138, 8381, 494, 2785, 780, 1765, 4464, 13, 271, 55025, 198, 32, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 198, 33, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 17.350656509399414, " B": 13.725300788879395}, "raw_logits_by_option_id": {"contains_unsupported": 13.725300788879395, "supported": 17.350656509399414}, "readout_s": 3.538700002536643e-05, "request_id": "sha256:c1b347f3ecb895b348901e69", "requested_score_position": 509, "response_sha256": "sha256:fe6560e85c732e9d8bdb9a4e74805057c3ce9b11594c2da06dfcec549f11cda9", "response_text": "House Democrat Dean Phillips is expected to launch his own campaign for the 2024 presidential race, challenging President Joe Biden. Phillips, a critic of Biden's uncontested primary race, will file for candidacy in New Hampshire. Despite being considered a longshot, Phillips's campaign will frustrate Democratic Party leadership, who have discouraged primary challenges against Biden. The president's campaign will now have to contend with an internal challenge from within his own party.", "role": "training", "sealed_prompt_sha256": "sha256:2d14000d9f2cee2329ddb995462b93d3b3f80e2dd247d31339166201ebbd45fc", "sealed_prompt_token_count": 510, "sentence_count": null, "sentence_version": null, "source_group_id": "group-59b18ecfe86a556b2d89e42a", "source_sha256": "sha256:5adc6d0f3b7496f34e62fdc2d10e3272e385452d8b07b9d567fff3b0b1324532", "source_text": "House Democrat to Join 2024 Presidential Race, Challenging Biden\nPresident Joe Biden's campaign for president in 2024 is now facing an unexpected challenge from within the president's own party after it was reported that a former member of the House Democratic leadership would be launching his own campaign for the Oval Office this Friday.\nNow, Biden will have to contend with the campaign of Representative Dean Phillips of Minnesota, who only recently stepped down from his role within the House Democratic leadership, an apparent precursor to his decision to run for the White House.\nBiden Faces Internal Challenge\nHouse Democrat Dean Phillips, a frequent critic of President Joe Biden's mostly uncontested primary race for the Democratic nomination for president, is expected to launch his own campaign for the White House, according to reports.\nThe New Hampshire secretary of state's office says that Phillips is expected to file at 10 a.m. ET tomorrow, which is the deadline for candidates to file in order to appear on the primary ballot in the state.\nExpected to be a longshot in the race, Phillips will have to tackle not only facing an incumbent president, something that has been historically difficult to overcome but also fairly low national name recognition, especially in comparison to Biden.\nNevertheless, the challenge will undoubtedly frustrate the Democratic Party leadership, who have tried to discourage people within the party from running primary campaigns against Biden, believing the president is the party's best chance at retaining the White House in 2024.\nAt DailyNewsNow we bring you the latest news from the West Coast and around the country, covering a wide range of topics from politics and campaign news to entertainment and local interest stories. Please feel free to share the story with friends and join the conversation in the comments below!", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0012982210000700434, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version"