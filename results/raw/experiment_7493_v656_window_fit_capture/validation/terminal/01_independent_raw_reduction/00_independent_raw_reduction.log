 13, 5788, 279, 3487, 4131, 682, 978, 37844, 303, 279, 3162, 11, 279, 6044, 682, 1801, 8601, 310, 7042, 424, 13, 4213, 11, 1010, 57043, 599, 10036, 7604, 2393, 11, 2583, 6103, 1965, 2942, 321, 14673, 9861, 13, 17187, 1439, 4562, 11, 2422, 1080, 47995, 8198, 264, 5243, 7458, 364, 24124, 321, 14811, 25161, 11, 9061, 310, 1141, 9944, 3602, 321, 15895, 12701, 1103, 13, 271, 55025, 198, 32, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 198, 33, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 16.745468139648438, " B": 11.113166809082031}, "raw_logits_by_option_id": {"contains_unsupported": 16.745468139648438, "supported": 11.113166809082031}, "readout_s": 3.493599979265127e-05, "request_id": "sha256:ecd7cac346f7b784387741d9", "requested_score_position": 965, "response_sha256": "sha256:2e3d712fa085c9b243e78aca6b7937670cbbc95fede6388740c6a831aadbe996", "response_text": "Blush Lounge is a popular nightlife spot located in Santa Barbara, California. With a rating of 3.5 stars, it offers a cozy atmosphere and excellent ambiance, making it a great spot for both intimate gatherings and large events. The lounge features a beautiful patio area with fire pits and heaters, perfect for relaxing and socializing. While the food quality has been inconsistent in the past, the management has made efforts to improve it. However, some reviewers have noted poor service, including slow response times and incorrect orders. Despite these issues, Blush Lounge remains a popular spot for locals and visitors alike, thanks to its prime location and extensive wine list.", "role": "training", "sealed_prompt_sha256": "sha256:8a3d3baebfaa1f8f952e5f289db8c07d76f131a233bde0adae8d2defe1e4cdc7", "sealed_prompt_token_count": 966, "sentence_count": null, "sentence_version": null, "source_group_id": "group-3aa8956c1d85e255eeed18e3", "source_sha256": "sha256:053f4f457391b6c5ca6fb97e41e0bd846ce5491f4945c605d5087144d6e0b138", "source_text": "{\"address\":\"630 State St\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":true,\"upscale\":false},\"BusinessParking\":{\"garage\":true,\"lot\":false,\"street\":false,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":true,\"WiFi\":\"free\"},\"business_stars\":3.5,\"categories\":\"Lounges, Cocktail Bars, Bars, Nightlife, Restaurants, Hookah Bars, American (New)\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"18:0-0:0\",\"Saturday\":\"17:0-0:0\",\"Sunday\":\"12:0-22:0\",\"Thursday\":\"18:0-1:30\",\"Wednesday\":\"18:0-0:0\"},\"name\":\"Blush Lounge\",\"review_info\":[{\"review_date\":\"2018-01-05 22:40:03\",\"review_stars\":5.0,\"review_text\":\"Blush has recently re-opened under new management and I was thrilled with my experience with them. I reached out to them about hosting an event there in November, and was put in contact with Asaf. He was very receptive to all of my ideas and accommodating of my requests. Although they no longer serve food at the restaurant, Asaf worked with me and within my budget constraints to find food options for our event. The bartenders were very friendly, welcoming, and assisted us with setting up a playlist through their sound system, and a slideshow on their TVs. The patio is well decorated and has fire pits and heaters to keep the space warm. I would highly recommend the space if you are looking for a place to host an event, or just to come in for a drink. I (and my friends) will definitely be back!\"},{\"review_date\":\"2017-12-29 07:15:27\",\"review_stars\":2.0,\"review_text\":\"PERMANENTLY CLOSED!!   (an obituary) \\nNo surprise. \\nThis restaurant had inconsistent food quality that ebbed and flowed depending on the chef. They were perhaps at their best (food-wise) when Chef Mossin worked there. When he left, food quality suffered. But this inconsistency could have possibly been overlooked.\\nThat said, they were very consistent when it came to service. For as long as I can remember....it consistently sucked!! At one point they did nearly a complete restart with service, but again it was the management that couldn't keep things together.\\nIt was really such a shame. It looked spectacularly cool on the inside with the brick walls and stellar lighting, coupled with a really nice outdoor bar and patio area, but the shoddy and ineffective management killed what should have been a home run. But this wasn't the only restaurant that they couldn't keep going well. \\nThe locals all knew this, and apparently the Yelpers did too. \\nSo goodbye Blush. Hopefully someone else will take over your awesome facility at a great location and make it work.\"},{\"review_date\":\"2017-05-07 06:02:56\",\"review_stars\":2.0,\"review_text\":\"Ambience is very nice, but thats it. Asked for coffee, the waiter brought cold coffee, no cream or sugar or spoon, when asked for cream, he went and pored milk in a shot glass.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.001882057999864628, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": null, "window_sha256": null, "window_version": null}, {"actual_last_evaluated_position": 985, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 229, "byte_start": 0, "call_id": "sha256:a32b04a581cb10b708b5124c", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-3aa8956c1d85e255eeed18e3", "kv_state