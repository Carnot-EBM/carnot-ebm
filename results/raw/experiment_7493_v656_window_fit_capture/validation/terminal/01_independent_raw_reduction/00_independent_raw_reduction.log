 3999, 12551, 321, 33266, 91305, 13, 357, 4688, 5813, 35172, 279, 10413, 579, 17387, 3487, 321, 33266, 16078, 13, 26988, 11, 65309, 2141, 7701, 310, 381, 264, 5243, 321, 1575, 31103, 20318, 10413, 303, 15521, 30089, 13, 271, 55025, 198, 32, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 198, 33, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 14.567712783813477, " B": 13.357492446899414}, "raw_logits_by_option_id": {"contains_unsupported": 14.567712783813477, "supported": 13.357492446899414}, "readout_s": 4.0906000322138425e-05, "request_id": "sha256:366791c417e09e95a25038e5", "requested_score_position": 992, "response_sha256": "sha256:ba29c43df7b424c38f67bdca246dc3c0d50eb895098e893503ff574d960821b6", "response_text": "Bettina is a restaurant located at 1014 Coast Village Road in Santa Barbara, California. The restaurant serves Italian cuisine and specializes in pizza. It is open Monday through Sunday from 4:00 PM to 8:30 PM. The restaurant offers outdoor seating, Wi-Fi, takeout options, and is suitable for groups. The restaurant has four and a half stars on Google and has received several positive reviews. One customer noted that the food was not the issue but the staff was flat, unengaging, and had a stuffy awkward energy. Another customer loved the pizza and the service, and appreciated the easy parking and charming ambiance. A third customer praised the restaurant's delicious food and charming atmosphere. Overall, Bettina appears to be a popular and well-regarded restaurant in Santa Barbara.", "role": "training", "sealed_prompt_sha256": "sha256:39639d4f455275ee24e322b58928a53f9219c743dec841334516531f89327498", "sealed_prompt_token_count": 993, "sentence_count": 2, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-749869b78483b77e80fd464a", "source_sha256": "sha256:1548121a0f7db6b0273d57a7f1a09f16983bd52369474828ec553e148872e71b", "source_text": "{\"address\":\"1014 Coast Village Rd\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":true,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":true,\"street\":true,\"valet\":true,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":true,\"WiFi\":\"free\"},\"business_stars\":4.5,\"categories\":\"Restaurants, Italian, Pizza\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"16:0-20:30\",\"Monday\":\"0:0-0:0\",\"Saturday\":\"16:0-20:30\",\"Sunday\":\"16:0-20:30\",\"Thursday\":\"16:0-20:30\",\"Tuesday\":\"16:0-20:30\",\"Wednesday\":\"16:0-20:30\"},\"name\":\"Bettina\",\"review_info\":[{\"review_date\":\"2022-01-14 02:46:25\",\"review_stars\":1.0,\"review_text\":\"The hype is over for this place. Local, who used to use this place for everything, and a spot to celebrate girlfriends birthdays. The food was not the issue. The staff is flat, unengaging and silent. You can feel their stuffy awkward energy. As someone who used to be a server myself, I always love being courteous to server staff/tipping well. But man, very hard to do here.\"},{\"review_date\":\"2022-01-10 20:40:01\",\"review_stars\":5.0,\"review_text\":\"Omg I'm a hard core pizza aficionado and this could be my new favorite pizza place in North America. Don't let it's location in the Montecito Country Mart fool you, please make a reservation asap. \\n\\nThe menu is very tight but that's fine. Everyone raves about the carbonara pizza but I hate eggs do we skipped it. We wanted a light lunch to save room for steak dinner so we opted for a bottle of Sancerre, baby gems salad and meat lovers pizza. They all hit perfectly!\\n\\nThe server was terrific. The ambiance felt like a garden getaway and parking was too easy. Please run to this lovely restaurant and grab a matchbox or two for the memories.\"},{\"review_date\":\"2022-01-06 05:51:02\",\"review_stars\":5.0,\"review_text\":\"Decided to check out Bettina during our recent trip to Santa Barbara and boy was it a great experience. The location is random (in the Montecito country mart shopping center) but the inside and the courtyard of the restaurant are charming. And we figured we came to a good spot when we noticed all the locals either dining there or picking up pies. Everything we ordered was delicious! We got the burrata to start, that had this amazing green pistachio/veggie paste on top - it also came with an excellent Focaccia. Broccolini, which was tangy, charred to perfection and just delish.  And two pizzas, the mushroom and pepperoni, which may have been the best I've had. Great little spot in SB, highly recommend.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0017728329994497471, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 1, "window_sha256": "sha256:dbb21a662ea08ba5ff9ae4a40bec38f415aa6428d20a24a84e848d99f5d01ae6", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 992, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 791, "byte_start": 516, "call_id": "sha256:95ff561d612e6ee05145998e", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-749869b78483b77e80fd464a", "kv_state_id": "reset-epoch-636", "label_to_option_id": {" A": "contains_unsupported", " B": "supported"}, "log_odds_contains_unsupported": 0.8855762481689454, "marked_response": "Bettina is a restaurant located at 1014 Coast Village Road in Santa Barbara, California. The restaurant serves Italian cuisine and specializes in pizza. It is open Monday through Sunday from 4:00 PM to 8:30 PM. The restaurant offers outdoor seating, Wi-Fi, takeout options, and is suitable for groups. The restaurant has four and a half stars on Google and has received several positive reviews. One customer noted that the food was not the issue but the staff was flat, unengaging, and had a stuffy awkward energy. <<CARNOT_FOCUS_START:516:791>>Another customer loved the pizza and the service, and appreciated the easy parking and charming ambiance. A third customer praised the restaurant's delicious food and charming atmosphere. Overall, Bettina appears to be a popular and well-regarded restaurant in Santa Barbara.<<CARNOT_FOCUS_END>>", "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["contains_unsupported", "supported"], "order_remapping": {" A": "contains_unsupported", " B": "supported"}, "prefill_s": 1.1733034609997048, "probabilities_by_option_id": {"contains_unsupported": 0.7079764225940717, "supported": 0.29202357740592827}, "prompt_sha256": "sha256:39a546eb9a1fc6a390f069ce122981a01e03cbdfed4b3d427f5f74a702e2d33f", "prompt_token_count": 993, "prompt_token_ids": [1890, 1386, 1761, 364, 279, 4434, 1965, 1608, 1132, 279, 16713, 2450, 13, 271, 41578, 198, 4754, 4834, 3147, 16, 15, 16, 19, 15522, 23316, 26577, 2129, 11987, 21624, 52218, 1772, 21624, 23543, 899, 763, 3721, 1288, 1005, 88, 763, 1802, 1288, 67, 520, 88, 763, 3721, 1288, 92670, 763, 3721, 1288, 390, 3316, 763, 3721, 1288, 433, 7902, 763, 3721, 1288, 49612, 84507, 763, 3721, 1288, 237419, 88, 763, 3721, 1288, 8339, 2174, 763, 3721, 49471, 22020, 91061, 21624, 11816, 416, 763, 3721, 1288, 8911, 763, 1802, 1288, 26466, 763, 1802, 1288, 6378, 1112, 763, 1802, 1288, 57576, 763, 3721, 49471, 23373, 763, 2827, 1288, 95130, 1460, 1060