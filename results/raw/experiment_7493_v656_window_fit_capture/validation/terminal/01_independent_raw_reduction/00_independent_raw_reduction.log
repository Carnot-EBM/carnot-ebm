450, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 15.318144798278809, " B": 15.127276420593262}, "raw_logits_by_option_id": {"contains_unsupported": 15.318144798278809, "supported": 15.127276420593262}, "readout_s": 3.6438000279304106e-05, "request_id": "sha256:2bd9fcc98cb8ac62e67a0927", "requested_score_position": 964, "response_sha256": "sha256:ca9335171ef82edec3b77420c37f57bdfb9f4d6e4bdb07a71f25a8ca90e6f6d6", "response_text": "Marbella is a restaurant located at 1111 E Cabrillo Blvd, Santa Barbara, CA. This establishment specializes in tapas, small plates, breakfast & brunch, seafood, and new American cuisine. They operate from 17:00 to 22:00 from Monday to Sunday. They offer outdoor seating and take-out options, and are suitable for group dining. However, they do not have a parking facility and their WiFi service is paid. The ambience is not specified. Marbella has an overall rating of 3.5 stars. The reviews are mixed with some customers praising the great flavor of the food, specifically the pasta, chicken salad and avocado toast. However, there are also negative reviews mentioning cold and small portions, poor service, and high prices. The restaurant seems to have a varying level of customer satisfaction.", "role": "training", "sealed_prompt_sha256": "sha256:7fdd1ceb697af143191f30a52d10ad726d224d22d8e86892e3f504725d785659", "sealed_prompt_token_count": 965, "sentence_count": 3, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-68eda85e3c5bef35dbdfe211", "source_sha256": "sha256:8d37aadf631bce66f5a5159f6541503c435cd8b8598a808c2e94091e60aa3ca4", "source_text": "{\"address\":\"1111 E Cabrillo Blvd\",\"attributes\":{\"Ambience\":{\"casual\":false,\"classy\":false,\"divey\":false,\"hipster\":false,\"intimate\":false,\"romantic\":false,\"touristy\":false,\"trendy\":false,\"upscale\":false},\"BusinessParking\":{\"garage\":false,\"lot\":false,\"street\":false,\"valet\":false,\"validated\":false},\"Music\":null,\"OutdoorSeating\":true,\"RestaurantsGoodForGroups\":true,\"RestaurantsReservations\":true,\"RestaurantsTakeOut\":true,\"WiFi\":\"paid\"},\"business_stars\":3.5,\"categories\":\"Tapas/Small Plates, Restaurants, Breakfast & Brunch, Seafood, American (New)\",\"city\":\"Santa Barbara\",\"hours\":{\"Friday\":\"17:0-22:0\",\"Monday\":\"17:0-22:0\",\"Saturday\":\"17:0-22:0\",\"Sunday\":\"17:0-22:0\",\"Thursday\":\"17:0-22:0\",\"Tuesday\":\"17:0-22:0\",\"Wednesday\":\"17:0-22:0\"},\"name\":\"Marbella\",\"review_info\":[{\"review_date\":\"2020-08-24 02:29:48\",\"review_stars\":5.0,\"review_text\":\"We were tired and hungry.  The manager at Hyatt was kind of enough to serve us a great dinner.  I am fairly happy with the pasta, chicken salad especially the avocado toast.  Great flavor and it's not greasy either.  Everything is seasoned perfectly.  A little spice goes a long way.\"},{\"review_date\":\"2019-07-06 00:29:17\",\"review_stars\":1.0,\"review_text\":\"Methinks not indeed. This place is so gross. The food has small, cold portions. The wait staff is a bunch of bus boys, who speak very poor English. It's as if they've fired their regular wait staff to save money, and then dragooned the dish washer into serving.\\n Don't be penny wise and pound foolish, and this nonsense includes the tip.  One of the buffets was an $18 TERRIBLE hamburger and cold fries. Why? \\nI had a grilled chicken sandwich that was apparently taken out of the ice box minutes before it found its way to my plate. It may have been left over from the previous day. Soooooo gross. The hotel is undergoing a renovation, according to the manger. START WITH THE RESTAURANT.\"},{\"review_date\":\"2019-04-13 23:50:55\",\"review_stars\":1.0,\"review_text\":\"My boyfriend and I wanted a late lunch/ snack. We decided to stay in the hotel to eat at this restaurant.  The vibe and food WASN'T inviting. We just thought, \\\"let's give this place a try.\\\"  SUPER DISAPPOINTED ON THE FOOD AND COST for this HOTEL!! Its pretty dry, tasteless, and expensive. (We ordered Nachos, Brussels sprouts, & Mahi Mahi fish taco). Did i mentioned that it was expensive too? GO ELSE WHERE FOR BETTER FOOD.Service was ok but we were there for food, Not the the service.\"}],\"state\":\"CA\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0017488590001448756, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 2, "window_sha256": "sha256:c29d6cfd921b0ad2da14b65f105a78fddec52f0233b5173ad18aadf099ff2474", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 1101, "archived_pilot_reuse": false, "arm": "whole_response", "attempted": true, "byte_end": null, "byte_start": null, "call_id": "sha256:e1e2913f6fff11135f710297", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-6b1ad4ce4faca0443395bebe", "kv_state_id": "reset-epoch-597", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 2.9232826232910156, "marked_response": null, "model_sha256": "sha256:7e78da5d7e3ae28d178121f58646953305f3e5bd3cb46f4a75584e8b6c6fe169", "native_option_token_ids": {" A": 357, " B": 417}, "normalization": "two_option_softmax_float64", "option_order": ["supported", "contains_unsupported"], "order_remapping": {" A": "supported", " B": "contains_unsupported"}, "prefill_s": 1.3124914179998086, "probabilities_by_option_id": {"contains_unsupported": 0.9489854520759246, "supported": 0.0510145479240755}, "prompt_sha256": "sha256:4b870e43a44dea42bc0295cc85cc2e76702ed4f04212f895f55bb8650daf64b0", "prompt_token_count": 1102, "prompt_token_ids": [1890, 1386, 1761, 364, 279, 4434, 1965, 1608, 1132, 279, 1