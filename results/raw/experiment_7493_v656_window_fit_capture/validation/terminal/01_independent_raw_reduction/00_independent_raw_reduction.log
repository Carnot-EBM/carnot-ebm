2, 5493, 11, 440, 874, 6235, 1829, 13, 30714, 179313, 321, 5875, 428, 628, 2107, 381, 45239, 4022, 466, 26321, 13, 271, 55025, 198, 32, 25, 7021, 1892, 561, 2400, 1965, 369, 7021, 539, 279, 16713, 2450, 13, 198, 33, 25, 5435, 4748, 17675, 1892, 561, 1965, 5435, 39072, 2144, 13, 271, 5423, 1132, 279, 2904, 2306, 13, 198, 15666, 25], "raw_logits_by_display_label": {" A": 12.425028800964355, " B": 14.534146308898926}, "raw_logits_by_option_id": {"contains_unsupported": 14.534146308898926, "supported": 12.425028800964355}, "readout_s": 3.693899998324923e-05, "request_id": "sha256:5a7c89ae41b02ed0440ce65a", "requested_score_position": 470, "response_sha256": "sha256:9705a243ba28e64f914299a98558e71c3d4d7cd0531d34a35739460c060d240c", "response_text": "Based on the given passages, it appears that tobiano is a horse breed with a specific pattern of coloration. Tobianos typically have a large patch of a clearly defined color, usually black or dark brown, on a white coat. They may also have a white stripe down their back and white hair on their legs and tail. Overo, on the other hand, is another horse breed with a different pattern of coloration. Overos are characterized by having a mixture of colors and white areas, with no solid color. Tobianos and Overos can both be predominantly white or colored.", "role": "calibration_tuning", "sealed_prompt_sha256": "sha256:a5cf8d1be54c1e929eb860d7561a17e877bff3d5af67a71dc704fdb9a85692af", "sealed_prompt_token_count": 471, "sentence_count": 2, "sentence_version": "carnot-utf8-sentence-v1", "source_group_id": "group-9b20ae41d00366bbdc6533b2", "source_sha256": "sha256:6ac32a1da34d140c9c718ba1fdee3be1434d21d79c42ffcdff89bee59ad7c543", "source_text": "{\"passages\":\"passage 1:Tobiano is generally a large patch of clearly lined color on a white coat. The white will cross the topline between the wither and the tail. Generally tobiano's have a dark colored face and stockings or socks, though overo's can have them too if they have the sabino gene. Many tobiano colored horses also have dual colored tails.\\n\\npassage 2:Paint horses come in two basic patterns, tobiano and overo.* Both of these patterns can be predominatly white or color. Tobiano:Solid color head with any combination of star, \u2026strip, blaze, snip. Commonly have white hair over the spine somewhere between the withers and dock. Commonly have four legs with some white hair, many times over the knees and hocks. Commonly have two-toned tails.\\n\\npassage 3:A common misconception is that if the white markings cross the center of the back, between the withers and the tail, then it is a tobiano, if not, it\u2019s an overo. This is simply not true. Many minimally marked tobianos do not have white that crosses the back, and many overos (especially splashed white overos) do.\\n\\n\",\"question\":\"difference between tobiano and overo\"}", "source_version": {"corpus": "ragtruth", "license": "MIT", "release_revision": "c103204b9ce28d6bbad859304bf30de72b8ed8fe"}, "state_reset": true, "token_boundary_receipts": {" A": true, " B": true}, "tokenize_s": 0.0010397709993412718, "tokenizer_identity": {"bos_token_id": "248044", "eos_token_id": "248046", "metadata_model": "gpt2", "representation": "embedded_gguf"}, "window_index": 0, "window_sha256": "sha256:92b87bf5d7d2099c5e88d33bbf7ce4124e14b30d267242992feb1bc4a3f0693e", "window_version": "carnot-balanced-contiguous-v1"}, {"actual_last_evaluated_position": 472, "archived_pilot_reuse": false, "arm": "focused_window", "attempted": true, "byte_end": 399, "byte_start": 221, "call_id": "sha256:b0751855a862424a5e9d4b7e", "disposition": "complete", "eligible": true, "error": null, "generated_tokens": 0, "gold_label": null, "group_id": "group-9b20ae41d00366bbdc6533b2", "kv_state_id": "reset-epoch-1661", "label_to_option_id": {" A": "supported", " B": "contains_unsupported"}, "log_odds_contains_unsupported": 1.3451557159423828, "marked_response": "Based on the given passages, it appears that tobiano is a horse bre