0.20.417.762 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.20.417.762 D srv  log_server_r: request:  {"content": "Norfolk, Virginia (CNN)The second mate of the Houston Express probably couldn't believe what he was seeing. ", "add_special": true}
0.20.417.763 D srv  log_server_r: response: {"tokens":[31580,39580,11,12617,318,53593,8,760,2018,28222,314,279,15531,16888,4507,7448,914,4267,1092,551,557,8847,13,220]}
0.20.418.504 D srv          stop: all tasks already finished, no need to cancel
0.20.418.515 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.20.418.516 D srv  log_server_r: request:  {"content": "Hundreds of miles from land there was a small boat nearby. ", "add_special": true}
0.20.418.516 D srv  log_server_r: response: {"tokens":[87505,314,8491,494,4128,1017,557,264,2526,14882,13643,13,220]}
0.20.418.924 D srv          stop: all tasks already finished, no need to cancel
0.20.418.928 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.20.418.928 D srv  log_server_r: request:  {"content": "At first it looked abandoned. ", "add_special": true}
0.20.418.929 D srv  log_server_r: response: {"tokens":[1597,1118,424,6749,22263,13,220]}
0.20.419.271 D srv          stop: all tasks already finished, no need to cancel
0.20.419.274 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.20.419.275 D srv  log_server_r: request:  {"content": "It was in bad shape, listing to one side. ", "add_special": true}
0.20.419.275 D srv  log_server_r: response: {"tokens":[2064,557,303,3743,5893,11,14408,310,799,3008,13,220]}
0.20.419.886 D srv          stop: all tasks already finished, no need to cancel
0.20.419.895 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.20.419.896 D srv  log_server_r: request:  {"content": "The crew of the 1,000-foot long container ship thought it was a yacht that had wrecked. ", "add_special": true}
0.20.419.896 D srv  log_server_r: response: {"tokens":[760,13234,314,279,220,16,11,15,15,15,19858,1248,5303,8026,3272,424,557,264,69489,421,995,34565,290,13,220]}
