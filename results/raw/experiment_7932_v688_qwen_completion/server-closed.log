,\\\"attributes\\\":{\\\"Ambience\\\":{\\\"casual\\\":true,\\\"classy\\\":false,\\\"divey\\\":false,\\\"hipster\\\":false,\\\"intimate\\\":false,\\\"romantic\\\":false,\\\"touristy\\\":false,\\\"trendy\\\":false,\\\"upscale\\\":false},\\\"BusinessParking\\\":{\\\"garage\\\":false,\\\"lot\\\":false,\\\"street\\\":true,\\\"valet\\\":false,\\\"validated\\\":false},\\\"Music\\\":null,\\\"OutdoorSeating\\\":true,\\\"RestaurantsGoodForGroups\\\":false,\\\"RestaurantsReservations\\\":false,\\\"RestaurantsTakeOut\\\":true,\\\"WiFi\\\":\\\"no\\\"},\\\"business_stars\\\":3.5,\\\"categories\\\":\\\"Food Delivery Services, Chicken Wings, Restaurants, Sandwiches, Food, American (New), Barbeque\\\",\\\"city\\\":\\\"Isla Vista\\\",\\\"hours\\\":{\\\"Friday\\\":\\\"11:30-21:30\\\",\\\"Monday\\\":\\\"11:30-21:30\\\",\\\"Saturday\\\":\\\"11:30-21:30\\\",\\\"Sunday\\\":\\\"11:30-21:30\\\",\\\"Thursday\\\":\\\"11:30-21:30\\\",\\\"Tuesday\\\":\\\"11:30-21:30\\\",\\\"Wednesday\\\":\\\"11:30-21:30\\\"},\\\"name\\\":\\\"Kaptain's Firehouse BBQ\\\",\\\"review_info\\\":[{\\\"review_date\\\":\\\"2018-11-08 17:11:36\\\",\\\"review_stars\\\":1.0,\\\"review_text\\\":\\\"I've never in my life been angry enough to yell at a stranger than I was when I ordered from here one day. And I'm super shy and quiet, so that should say a lot about the customer service. Their food was my favorite until I experienced the worst customer service from a girl who worked their. So I was sad because ofc I wouldn't support them again after that. But oh well.\\\"},{\\\"review_date\\\":\\\"2017-12-03 00:13:26\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"animal mac- mac n cheese, pulled pork, bbq sauce, and tater tots. the guy hooked it up F A T so blessed this is so good\\\"},{\\\"review_date\\\":\\\"2017-10-15 14:38:40\\\",\\\"review_stars\\\":3.0,\\\"review_text\\\":\\\"Updating my review to inform readers that I have returned here now at least 4 more times and sometimes my food has been less than great. Also, the last 3 times they didn't have any ribs. I also think that the quality of food you get depends on who's working. I will try again but if they give me stories and crappy food I will not go back ever again.\\\"}],\\\"state\\\":\\\"CA\\\"}\", \"original_answer\": \"Kaptain's Firehouse BBQ, located at 6543 Pardall Rd, Isla Vista, CA, is a local restaurant offering food delivery services.\", \"source_sentence_offsets\": [{\"end_byte\": 985, \"source_sentence_id\": 0, \"start_byte\": 0, \"text_sha256\": \"sha256:03ecb1958376677ace6a657406ef3370c2bcadb1be64465a40f71d35d1874105\"}, {\"end_byte\": 1067, \"source_sentence_id\": 1, \"start_byte\": 985, \"text_sha256\": \"sha256:828e00298ecbe726abf5a71065d439710e9739f31598359145e83d1c84520e27\"}, {\"end_byte\": 1171, \"source_sentence_id\": 2, \"start_byte\": 1067, \"text_sha256\": \"sha256:996ef5761c70b62c75704ab7a14981754beb2a821b053c7bac45da3771607d3b\"}, {\"end_byte\": 1238, \"source_sentence_id\": 3, \"start_byte\": 1171, \"text_sha256\": \"sha256:26d99cfb7349aed9357a504d141da13beaaf32ffb884607e080a9ddc084bad14\"}, {\"end_byte\": 1390, \"source_sentence_id\": 4, \"start_byte\": 1238, \"text_sha256\": \"sha256:3332a51bc813ffa0d74d25344b938643703ea63d13bb50c3457d99edfdafef50\"}, {\"end_byte\": 1654, \"source_sentence_id\": 5, \"start_byte\": 1390, \"text_sha256\": \"sha256:5018b97d09f82cc8c06d36597c01300cc379c52df1581e36c36555e4873e5352\"}, {\"end_byte\": 1704, \"source_sentence_id\": 6, \"start_byte\": 1654, \"text_sha256\": \"sha256:8e2377e052f756a87863731ae73a990428837bb3cf4fd3b51e49ccc557899c8e\"}, {\"end_byte\": 1776, \"source_sentence_id\": 7, \"start_byte\": 1704, \"text_sha256\": \"sha256:2ac5304310515a10e5c1039ea457bfa13a0bcd6f36375a2450de6b49616571a8\"}, {\"end_byte\": 1884, \"source_sentence_id\": 8, \"start_byte\": 1776, \"text_sha256\": \"sha256:3e7f7f395d96469a78fb003e701920c21e37fc6e450aba490bdfbe0ffd5a0e18\"}], \"target_sentence_sha256\": \"sha256:afe2912ccc8aaaeb6756863db53d36212625aaeec57519621dee3e97d0