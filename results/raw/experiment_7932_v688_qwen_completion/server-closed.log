0.20.435.668 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.20.435.670 D srv  log_server_r: request:  {"content": "And he had the strength to make it. ", "add_special": true}
0.20.435.670 D srv  log_server_r: response: {"tokens":[2939,551,995,279,7913,310,1236,424,13,220]}
0.20.436.047 D srv          stop: all tasks already finished, no need to cancel
0.20.436.056 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.20.436.057 D srv  log_server_r: request:  {"content": "\"He's got a very strong constitution and (is strong) not only physically, but spiritually,\" Frank Jordan said. ", "add_special": true}
0.20.436.058 D srv  log_server_r: response: {"tokens":[25485,579,2597,264,1546,3619,15926,321,318,284,3619,8,524,1132,21219,11,694,84726,1288,8995,16586,1018,13,220]}
0.20.436.350 D srv          stop: all tasks already finished, no need to cancel
0.20.436.353 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.20.436.353 D srv  log_server_r: request:  {"content": "\"And he told me on the phone that he was praying the whole time, so I believe that sustained him a great deal.\" Rescue swimmer Kyle McCollum was the first to care for Jordan on the flight back to land. ", "add_special": true}
0.20.436.353 D srv  log_server_r: response: {"tokens":[44385,551,3125,728,383,279,4392,421,551,557,49411,279,4220,854,11,748,353,4267,421,27723,1384,264,2172,3372,1149,42927,15714,1134,29272,13841,935,367,557,279,1118,310,2373,364,16586,383,279,10650,1142,310,4128,13,220]}
