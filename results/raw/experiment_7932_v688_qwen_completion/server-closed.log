0.21.447.394 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.21.447.394 D srv  log_server_r: request:  {"content": "We took action, and the air's a lot better.\" \"There are a whole host of public health impacts that are going to hit home, so we've got to do better in protecting vulnerable Americans,\" Obama continued. ", "add_special": true}
0.21.447.394 D srv  log_server_r: response: {"tokens":[1596,3738,1852,11,321,279,3594,579,264,2609,2577,1149,328,3733,513,264,4220,3357,314,569,2730,24115,421,513,2019,310,4062,2046,11,748,567,2908,2597,310,635,2577,303,21496,18966,8609,1288,6884,8308,13,220]}
