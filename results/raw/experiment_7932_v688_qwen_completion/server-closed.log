0.20.428.979 D srv  log_server_r: request:  {"content": "Records show there were more than a dozen storms off the coast of the Carolinas during the time he was missing. ", "add_special": true}
0.20.428.979 D srv  log_server_r: response: {"tokens":[25051,1420,1017,998,777,1056,264,19781,42046,974,279,13255,314,279,9946,19501,2261,279,854,551,557,7167,13,220]}
