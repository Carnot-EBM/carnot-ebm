0.19.210.915 D srv  log_server_r: request:  {"content": "When the Columbia Journalism School's 12,000-plus-word critique is summed up, it really boils down to this: The mistake could have been avoided if the writer, Sabrina Rubin Erdely, had picked up the phone and made just a few more phone calls to the friends of Jackie who she claimed were with her that night. ", "add_special": true}
0.19.210.917 D srv  log_server_r: response: {"tokens":[4350,279,18229,66234,5833,579,220,16,17,11,15,15,15,22221,36093,41151,369,63452,685,11,424,2098,85895,1441,310,411,25,561,16036,1362,599,978,29784,413,279,6700,11,239032,79100,43211,943,11,995,12405,685,279,4392,321,1801,1066,264,2342,777,4392,6526,310,279,4627,314,49154,852,1292,11324,998,440,1024,421,3603,13,220]}
