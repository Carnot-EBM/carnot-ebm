0.21.451.486 D srv  log_server_r: request:  {"content": "\"Impacts will likely vary by region, the sensitivity of populations, the extent and length of exposure to climate change impacts, and society's ability to adapt to change.\" The World Health Organization estimates climate change will cause an additional 250,000 deaths per year between 2030 and 2050. ", "add_special": true}
0.21.451.486 D srv  log_server_r: response: {"tokens":[6825,1261,11031,668,4222,12904,539,5364,11,279,25598,314,21234,11,279,12450,321,2984,314,13926,310,9682,2222,24115,11,321,7975,579,5548,310,10202,310,2222,1149,561,4196,6070,19773,17009,9682,2222,668,5073,449,4945,220,17,20,15,11,15,15,15,15894,791,1007,1881,220,17,15,18,15,321,220,17,15,20,15,13,220]}
