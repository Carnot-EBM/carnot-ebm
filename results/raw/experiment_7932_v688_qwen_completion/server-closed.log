0.21.446.453 D srv  log_server_r: request:  {"content": "\"I think we've always known -- or at least in the 20th century we've understood -- that environment has an impact on public health,\" the President told CNN's Dr. ", "add_special": true}
0.21.446.453 D srv  log_server_r: response: {"tokens":[6825,1683,567,2908,2590,3750,1137,466,506,3140,303,279,220,17,15,337,9018,567,2908,15513,1137,421,4424,682,449,5253,383,569,2730,1288,279,4642,3125,19166,579,2832,13,220]}
