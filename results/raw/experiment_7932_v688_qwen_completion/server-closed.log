0.22.142.335 D srv  log_server_r: response: {"tokens":[32,2526,1809,10765,440,22317,11,51273,364,279,22351,781,2047,4661,948,781,27968,11,1345,3672,1145,14778,1472,264,25888,3438,17052,303,279,8794,23873,14170,279,32066,3013,13,220]}
0.22.142.952 D srv          stop: all tasks already finished, no need to cancel
0.22.142.960 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.142.961 D srv  log_server_r: request:  {"content": "The Shariya refugee camp opened around six months ago, made up of some 4,000 tents and counting. ", "add_special": true}
0.22.142.961 D srv  log_server_r: response: {"tokens":[760,1369,2692,7509,32066,3013,8660,2094,4590,3818,3998,11,1801,685,314,1010,220,19,11,15,15,15,61230,321,24217,13,220]}
0.22.143.508 D srv          stop: all tasks already finished, no need to cancel
0.22.143.516 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.143.517 D srv  log_server_r: request:  {"content": "Thousands of Yazidis now call this corner of Iraqi Kurdistan home, about 18 miles (30 kilometers) from one of the front lines with ISIS, where one can hear the occasional reverberation in the distance of what we are told are airstrikes. ", "add_special": true}
0.22.143.517 D srv  log_server_r: response: {"tokens":[77381,314,85522,81333,1381,1562,411,8858,314,29248,76243,2046,11,883,220,16,23,8491,318,18,15,39229,8,494,799,314,279,3929,4965,440,21944,11,1332,799,628,6512,279,26957,33973,634,362,303,279,5821,314,1092,567,513,3125,513,76553,13,220]}
0.22.143.982 D srv          stop: all tasks already finished, no need to cancel
0.22.143.986 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.143.987 D srv  log_server_r: request:  {"content": "The vast majority of the camp's occupants are from the town of Sinjar, which is near the border with Syrian Kurdistan, and fled the ISIS assault there back in August. ", "add_special": true}
0.22.143.987 D srv  log_server_r: response: {"tokens":[760,12401,8421,314,279,3013,579,72132,513,494,279,6092,314,17106,18460,11,864,369,3043,279,3755,440,17601,76243,11,321,27968,279,21944,11366,1017,1142,303,5963,13,220]}
0.22.144.325 D srv          stop: all tasks already finished, no need to cancel
0.22.144.334 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.144.335 D srv  log_server_r: request:  {"content": "But not everyone escaped. ", "add_special": true}
0.22.144.336 D srv  log_server_r: response: {"tokens":[3850,524,4858,26880,13,220]}
0.22.144.625 D srv          stop: all tasks already finished, no need to cancel
0.22.144.629 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.144.630 D srv  log_server_r: request:  {"content": "ISIS took thousands of Yazidis captive. ", "add_special": true}
0.22.144.630 D srv  log_server_r: response: {"tokens":[74334,3738,8765,314,85522,81333,57831,13,220]}
0.22.145.166 D srv          stop: all tasks already finished, no need to cancel
0.22.145.171 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.145.171 D srv  log_server_r: request:  {"content": "The fighters separated the young women and girls, some as young as 8 years old, to be sold as slaves, for their \"masters\" to use as concubines. ", "add_special": true}
0.22.145.171 D srv  log_server_r: response: {"tokens":[760,22478,18101,279,3777,3096,321,7331,11,1010,430,3777,430,220,23,1578,2235,11,310,381,5898,430,30621,11,364,836,328,61463,1,310,958,430,3413,386,1489,13,220]}
0.22.145.481 D srv          stop: all tasks already finished, no need to cancel
0.22.145.488 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.145.488 D srv  log_server_r: request:  {"content": "Men faced a choice: Convert to Islam or be shot. ", "add_special": true}
0.22.145.489 D srv  log_server_r: response: {"tokens":[27779,16113,264,5576,25,6943,310,14479,466,381,6349,13,220]}
0.22.147.035 D srv          stop: all tasks already finished, no need to cancel
0.22.147.067 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.147.072 D srv  log_server_r: request:  {"content": "Mahmoud was out running errands when ISIS fighters arrived, taking his wife, Ahlam, their three children -- the youngest of which was just a month old -- and his elderly parents. ", "add_special": true}
0.22.147.073 D srv  log_server_r: response: {"tokens":[44667,76,2856,557,680,4162,1784,2751,948,21944,22478,11136,11,4483,780,7168,11,15885,23027,11,836,2250,2748,1137,279,37257,314,864,557,1066,264,2182,2235,1137,321,780,27878,6357,13,220]}
0.22.148.172 D srv          stop: all tasks already finished, no need to cancel
0.22.148.176 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.148.177 D srv  log_server_r: request:  {"content": "\"They took our phones, jewelry, money,\" Ahlam recalls. ", "add_special": true}
0.22.148.178 D srv  log_server_r: response: {"tokens":[30277,3738,1004,17094,11,29714,11,3117,1288,15885,23027,38799,13,220]}
0.22.148.746 D srv          stop: all tasks already finished, no need to cancel
0.22.148.754 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.148.754 D srv  log_server_r: request:  {"content": "\"They had guns. ", "add_special": true}
0.22.148.754 D srv  log_server_r: response: {"tokens":[30277,995,15881,13,220]}
0.22.149.281 D srv          stop: all tasks already finished, no need to cancel
0.22.149.284 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.149.284 D srv  log_server_r: request:  {"content": "They forced us at gunpoint into big trailer trucks.\" They were taken to a school turned prison in Tal Afar. ", "add_special": true}
0.22.149.285 D srv  log_server_r: response: {"tokens":[6651,9290,586,506,5849,2680,1083,2330,18671,25909,1149,2302,998,4284,310,264,2812,6316,9065,303,17065,12537,277,13,220]}
0.22.149.735 D srv          stop: all tasks already finished, no need to cancel
0.22.149.737 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.149.738 D srv  log_server_r: request:  {"content": "From there, the family was moved from village to village -- and at one stage taken to Mosul. ", "add_special": true}
0.22.149.738 D srv  log_server_r: response: {"tokens":[3702,1017,11,279,2902,557,7481,494,13721,310,13721,1137,321,506,799,6228,4284,310,59729,13,220]}
0.22.150.253 D srv          stop: all tasks already finished, no need to cancel
0.22.150.271 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.150.274 D srv  log_server_r: request:  {"content": "\"They wrote everyone's name down and they asked where we want to work, in the fields, as cleaners or as herders,\" she says. ", "add_special": true}
0.22.150.275 D srv  log_server_r: response: {"tokens":[30277,5947,4858,579,803,1441,321,781,4439,1332,567,1318,310,944,11,303,279,4881,11,430,72317,466,430,1024,11968,1288,1292,2640,13,220]}
0.22.150.904 D srv          stop: all tasks already finished, no need to cancel
0.22.150.914 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.150.915 D srv  log_server_r: request:  {"content": "Ahlam and her family chose to herd goats. ", "add_special": true}
0.22.150.916 D srv  log_server_r: response: {"tokens":[32,17422,308,321,1024,2902,14135,310,56162,68431,13,220]}
0.22.151.449 D srv          stop: all tasks already finished, no need to cancel
0.22.151.455 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.151.456 D srv  log_server_r: request:  {"content": "They were then taken to a Shia village whose residents had fled, where they were part of a group of around 40 living in one house. ", "add_special": true}
0.22.151.456 D srv  log_server_r: response: {"tokens":[6651,998,1179,4284,310,264,74761,13721,6483,10509,995,27968,11,1332,781,998,919,314,264,1809,314,2094,220,19,15,5214,303,799,3626,13,220]}
0.22.151.726 D srv          stop: all tasks already finished, no need to cancel
0.22.151.730 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.151.731 D srv  log_server_r: request:  {"content": "In the home, Ahlam found a cell phone left behind by its former occupants and called her husband. ", "add_special": true}
0.22.151.735 D srv  log_server_r: response: {"tokens":[623,279,2046,11,15885,23027,1669,264,2691,4392,2047,4661,539,1141,4588,72132,321,2512,1024,9677,13,220]}
0.22.152.278 D srv          stop: all tasks already finished, no need to cancel
0.22.152.294 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.152.296 D srv  log_server_r: request:  {"content": "\"I said we are alive but we are prisoners.\" Ahlam's husband, who up until that moment had lost the will to live, thinking his family was dead, says he cried out of happiness despite his pain. ", "add_special": true}
0.22.152.297 D srv  log_server_r: response: {"tokens":[6825,1018,567,513,13282,694,567,513,26268,1149,15885,23027,579,9677,11,852,685,2980,421,4299,995,5384,279,668,310,3756,11,7047,780,2902,557,5418,11,2640,551,36811,680,314,22292,8552,780,6437,13,220]}
0.22.152.899 D srv          stop: all tasks already finished, no need to cancel
0.22.152.906 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.152.908 D srv  log_server_r: request:  {"content": "Ahlam would call when she could, briefly, after midnight, hiding under her bedcovers. ", "add_special": true}
0.22.152.908 D srv  log_server_r: response: {"tokens":[32,17422,308,1000,1562,948,1292,1362,11,25899,11,1238,31266,11,24244,1172,1024,4690,53985,13,220]}
0.22.153.254 D srv          stop: all tasks already finished, no need to cancel
0.22.153.261 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.153.262 D srv  log_server_r: request:  {"content": "If she was caught with a phone, she would be killed. ", "add_special": true}
0.22.153.262 D srv  log_server_r: response: {"tokens":[2592,1292,557,10255,440,264,4392,11,1292,1000,381,7190,13,220]}
0.22.153.516 D srv          stop: all tasks already finished, no need to cancel
0.22.153.521 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.153.522 D srv  log_server_r: request:  {"content": "The village itself was a massive prison, its entrances guarded by ISIS fighters. ", "add_special": true}
0.22.153.522 D srv  log_server_r: response: {"tokens":[760,13721,4924,557,264,10632,9065,11,1141,91310,61030,539,21944,22478,13,220]}
0.22.153.800 D srv          stop: all tasks already finished, no need to cancel
0.22.153.809 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.153.810 D srv  log_server_r: request:  {"content": "She recalls that two men, in their late 40s or 50s, tried to escape. ", "add_special": true}
0.22.153.811 D srv  log_server_r: response: {"tokens":[7691,38799,421,1330,2859,11,303,836,3200,220,19,15,82,466,220,20,15,82,11,6470,310,12092,13,220]}
0.22.154.042 D srv          stop: all tasks already finished, no need to cancel
0.22.154.045 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.154.045 D srv  log_server_r: request:  {"content": "When they were caught, their bones were broken, their bodies tied to the back of a truck and then driven through the streets. ", "add_special": true}
0.22.154.069 D srv  log_server_r: response: {"tokens":[4350,781,998,10255,11,836,24066,998,10548,11,836,12497,16829,310,279,1142,314,264,10538,321,1179,15749,1472,279,13959,13,220]}
0.22.154.309 D srv          stop: all tasks already finished, no need to cancel
0.22.154.317 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.154.317 D srv  log_server_r: request:  {"content": "The Yazidi captives were forced to watch the gruesome spectacle. ", "add_special": true}
0.22.154.317 D srv  log_server_r: response: {"tokens":[760,85522,11927,6225,1821,998,9290,310,3609,279,82961,54892,13,220]}
0.22.154.760 D srv          stop: all tasks already finished, no need to cancel
0.22.154.767 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.154.769 D srv  log_server_r: request:  {"content": "The men's corpses were then tossed into a ditch and an order given not to bury them. ", "add_special": true}
0.22.154.769 D srv  log_server_r: response: {"tokens":[760,2859,579,69666,998,1179,48463,1083,264,47362,321,449,1906,2574,524,310,53485,1070,13,220]}
0.22.155.227 D srv          stop: all tasks already finished, no need to cancel
0.22.155.236 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.155.236 D srv  log_server_r: request:  {"content": "One night, some of the Yazidi men risked their lives to toss dirt onto the bodies, to give those slain what dignity they could. ", "add_special": true}
0.22.155.236 D srv  log_server_r: response: {"tokens":[3833,3603,11,1010,314,279,85522,11927,2859,5048,290,836,6107,310,24387,24482,8366,279,12497,11,310,2873,1782,66841,1092,36579,781,1362,13,220]}
0.22.155.515 D srv          stop: all tasks already finished, no need to cancel
0.22.155.518 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.155.518 D srv  log_server_r: request:  {"content": "Ahlam tells us that about a week before we met, ISIS fighters came by and took away her in-laws and the other elderly people living in the house. ", "add_special": true}
0.22.155.518 D srv  log_server_r: response: {"tokens":[32,17422,308,10426,586,421,883,264,1936,1518,567,2197,11,21944,22478,3571,539,321,3738,3023,1024,303,2759,8371,321,279,975,27878,1208,5214,303,279,3626,13,220]}
0.22.155.833 D srv          stop: all tasks already finished, no need to cancel
0.22.155.841 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.155.841 D srv  log_server_r: request:  {"content": "\"We didn't know where they were taking them, we thought we would be next,\" she remembers. ", "add_special": true}
0.22.155.842 D srv  log_server_r: response: {"tokens":[10397,3105,914,1366,1332,781,998,4483,1070,11,567,3272,567,1000,381,1727,1288,1292,40951,13,220]}
0.22.156.123 D srv          stop: all tasks already finished, no need to cancel
0.22.156.131 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.156.133 D srv  log_server_r: request:  {"content": "So she and the rest of the group realized that they had to try to flee. ", "add_special": true}
0.22.156.133 D srv  log_server_r: response: {"tokens":[4272,1292,321,279,2645,314,279,1809,14607,421,781,995,310,1380,310,26513,13,220]}
0.22.156.418 D srv          stop: all tasks already finished, no need to cancel
0.22.156.428 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.156.430 D srv  log_server_r: request:  {"content": "\"We decided that either we survive or we don't.\" They left at midnight. ", "add_special": true}
0.22.156.430 D srv  log_server_r: response: {"tokens":[10397,6426,421,2892,567,17171,466,567,1459,914,1149,2302,2047,506,31266,13,220]}
0.22.156.661 D srv          stop: all tasks already finished, no need to cancel
0.22.156.664 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.156.665 D srv  log_server_r: request:  {"content": "Ahlam cradled the baby, as her two other children, ages 3 and 4 years old, clutched at her clothes. ", "add_special": true}
0.22.156.666 D srv  log_server_r: response: {"tokens":[32,17422,308,1505,327,806,279,8505,11,430,1024,1330,975,2748,11,16149,220,18,321,220,19,1578,2235,11,1145,330,2320,506,1024,14656,13,220]}
0.22.156.874 D srv          stop: all tasks already finished, no need to cancel
0.22.156.877 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.156.877 D srv  log_server_r: request:  {"content": "She prayed the baby wouldn't cry, that the children could keep walking. ", "add_special": true}
0.22.156.877 D srv  log_server_r: response: {"tokens":[7691,64442,279,8505,8012,914,15268,11,421,279,2748,1362,2426,11107,13,220]}
0.22.157.096 D srv          stop: all tasks already finished, no need to cancel
0.22.157.099 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.157.099 D srv  log_server_r: request:  {"content": "They knew the general direction to take, but not the exact route, and they could only hope it was toward freedom. ", "add_special": true}
0.22.157.099 D srv  log_server_r: response: {"tokens":[6651,6661,279,4437,4944,310,1831,11,694,524,279,4581,5832,11,321,781,1362,1132,3769,424,557,8574,10963,13,220]}
0.22.157.287 D srv          stop: all tasks already finished, no need to cancel
0.22.157.290 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.157.291 D srv  log_server_r: request:  {"content": "\"When the sun started to come up, I thought that's it, we are going to get caught,\" Ahlam says. ", "add_special": true}
0.22.157.291 D srv  log_server_r: response: {"tokens":[37097,279,6797,3727,310,2445,685,11,353,3272,421,579,424,11,567,513,2019,310,615,10255,1288,15885,23027,2640,13,220]}
0.22.157.455 D srv          stop: all tasks already finished, no need to cancel
0.22.157.458 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.157.458 D srv  log_server_r: request:  {"content": "\"And what am I going to do with the kids?  ", "add_special": true}
0.22.157.458 D srv  log_server_r: response: {"tokens":[44385,1092,1044,353,2019,310,635,440,279,6623,30,256]}
0.22.157.672 D srv          stop: all tasks already finished, no need to cancel
0.22.157.675 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.157.675 D srv  log_server_r: request:  {"content": "I can't carry all three of them and run.\" Luckily, Ahlam never had to answer that impossible question. ", "add_special": true}
0.22.157.675 D srv  log_server_r: response: {"tokens":[40,628,914,6564,660,2250,314,1070,321,1542,1149,45916,11,15885,23027,2496,995,310,4087,421,11656,3296,13,220]}
0.22.157.924 D srv          stop: all tasks already finished, no need to cancel
0.22.157.933 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.157.934 D srv  log_server_r: request:  {"content": "The group made it into Iraqi Kurdistan. ", "add_special": true}
0.22.157.935 D srv  log_server_r: response: {"tokens":[760,1809,1801,424,1083,29248,76243,13,220]}
0.22.158.535 D srv          stop: all tasks already finished, no need to cancel
0.22.158.544 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.158.545 D srv  log_server_r: request:  {"content": "The couple can't put into words their emotions when they were reunited. ", "add_special": true}
0.22.158.546 D srv  log_server_r: response: {"tokens":[760,5448,628,914,2113,1083,4105,836,20608,948,781,998,74251,13,220]}
0.22.159.083 D srv          stop: all tasks already finished, no need to cancel
0.22.159.091 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.159.093 D srv  log_server_r: request:  {"content": "Mahmoud, gently caressing his daughter's palm, says he could hardly believe that the woman whose stunning eyes and gentle words he had fallen in love with, and their three children, were by his side again. ", "add_special": true}
0.22.159.093 D srv  log_server_r: response: {"tokens":[44667,76,2856,11,28314,2093,54882,780,9511,579,31381,11,2640,551,1362,19558,4267,421,279,5054,6483,19245,6213,321,21030,4105,551,995,20230,303,2854,440,11,321,836,2250,2748,11,998,539,780,3008,1495,13,220]}
0.22.159.333 D srv          stop: all tasks already finished, no need to cancel
0.22.159.340 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.159.342 D srv  log_server_r: request:  {"content": "It had been eight agonizing months. ", "add_special": true}
0.22.159.342 D srv  log_server_r: response: {"tokens":[2064,995,978,7810,54774,4694,3818,13,220]}
0.22.159.637 D srv          stop: all tasks already finished, no need to cancel
0.22.159.647 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.159.650 D srv  log_server_r: request:  {"content": "But their joy was tainted by fear for Mahmoud's parents. ", "add_special": true}
0.22.159.650 D srv  log_server_r: response: {"tokens":[3850,836,15420,557,81077,539,8415,364,89977,579,6357,13,220]}
0.22.160.164 D srv          stop: all tasks already finished, no need to cancel
0.22.160.171 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.22.160.172 D srv  log_server_r: request:  {"content": "A few days after Mahmoud and Ahlam were reunited, ISIS released 217 captives. ", "add_special": true}
