0.21.448.305 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.21.448.307 D srv  log_server_r: request:  {"content": "\"It's also personal to me because I've cared for many patients over the years who have suffered from asthma and have seen firsthand how frightening it can be to suddenly be wheezing and fighting for every breath,\" Murthy said.  ", "add_special": true}
0.21.448.307 D srv  log_server_r: response: {"tokens":[11734,579,1048,4204,310,728,1521,353,2908,40300,364,1599,6621,888,279,1578,852,599,15777,494,48840,321,599,3753,79722,1204,51838,424,628,381,310,14413,381,14463,9825,286,321,10488,364,1396,11155,1288,14571,25577,1018,13,256]}
