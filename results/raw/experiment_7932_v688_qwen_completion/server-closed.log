0.19.198.141 D srv  log_server_r: request:  {"content": "The school has never expelled a single student for sexual assault -- even when the student admitted to it. ", "add_special": true}
0.19.198.141 D srv  log_server_r: response: {"tokens":[760,2812,682,2496,63995,264,3074,5286,364,7017,11366,1137,1442,948,279,5286,15711,310,424,13,220]}
