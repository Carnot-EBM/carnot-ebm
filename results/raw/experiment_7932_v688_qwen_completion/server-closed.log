0.20.437.238 D srv  log_server_r: request:  {"content": "The rescued sailor knew almost exactly what day it was, remarkable for someone who had been on the water for more than 60 days. ", "add_special": true}
0.20.437.239 D srv  log_server_r: response: {"tokens":[760,42861,89343,6661,4409,6681,1092,1834,424,557,11,22094,364,4184,852,995,978,383,279,2919,364,777,1056,220,21,15,2756,13,220]}
