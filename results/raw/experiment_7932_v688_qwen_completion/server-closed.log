0.20.429.713 D srv  log_server_r: request:  {"content": "but every time the waves would splash into the boat,\" Jordan said.  ", "add_special": true}
0.20.429.717 D srv  log_server_r: response: {"tokens":[7834,1396,854,279,16382,1000,33486,1083,279,14882,1288,16586,1018,13,256]}
