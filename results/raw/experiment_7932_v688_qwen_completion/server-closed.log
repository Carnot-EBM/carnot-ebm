0.20.437.013 D srv  log_server_r: request:  {"content": "\"But for him to be in his current state was pretty amazing.\" Grenz was also surprised by Jordan's condition, physically and mentally. ", "add_special": true}
0.20.437.013 D srv  log_server_r: response: {"tokens":[40042,364,1384,310,381,303,780,1428,1528,557,4859,7648,1149,227892,557,1048,14038,539,16586,579,2876,11,21219,321,32122,13,220]}
