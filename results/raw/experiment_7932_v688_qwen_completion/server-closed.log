0.19.210.384 D srv  log_server_r: request:  {"content": "The attorney who filed the suit, James Marsh, told CNN that UVA medical staff lost or destroyed evidence from the alleged sexual assault victim he's representing, making it impossible for her to move forward and get justice. ", "add_special": true}
0.19.210.384 D srv  log_server_r: response: {"tokens":[760,13352,852,12364,279,7535,11,7555,37770,11,3125,19166,421,533,12452,6255,5395,5384,466,14012,5721,494,279,10178,7017,11366,11397,551,579,13661,11,3154,424,11656,364,1024,310,3166,4487,321,615,11813,13,220]}
