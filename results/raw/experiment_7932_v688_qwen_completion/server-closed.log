0.19.209.958 D srv  log_server_r: request:  {"content": "Department of Education as a result of a civil suit. ", "add_special": true}
0.19.209.959 D srv  log_server_r: response: {"tokens":[25775,314,11332,430,264,1067,314,264,8009,7535,13,220]}
