0.21.451.129 D srv  log_server_r: request:  {"content": "\"These factors include the effectiveness of a community's public health and safety systems to address or prepare for the risk and the behavior, age, gender, and economic status of individuals affected,\" the EPA says on its website. ", "add_special": true}
0.21.451.129 D srv  log_server_r: response: {"tokens":[65494,9085,2830,279,25440,314,264,3809,579,569,2730,321,6925,5757,310,2534,466,10236,364,279,5048,321,279,7465,11,4092,11,9533,11,321,6739,2552,314,7529,11164,1288,279,25323,2640,383,1141,3779,13,220]}
