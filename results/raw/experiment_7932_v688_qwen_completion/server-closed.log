0.20.421.687 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.20.421.687 D srv  log_server_r: request:  {"content": "Thomas Grenz told CNN by phone Friday. ", "add_special": true}
0.20.421.688 D srv  log_server_r: response: {"tokens":[40025,227892,3125,19166,539,4392,6394,13,220]}
0.20.421.968 D srv          stop: all tasks already finished, no need to cancel
0.20.421.970 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.20.421.971 D srv  log_server_r: request:  {"content": "That man, Louis Jordan, 37, had an amazing story. ", "add_special": true}
0.20.421.971 D srv  log_server_r: response: {"tokens":[4639,855,11,11537,16586,11,220,18,22,11,995,449,7648,3255,13,220]}
0.20.422.552 D srv          stop: all tasks already finished, no need to cancel
0.20.422.572 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.20.422.573 D srv  log_server_r: request:  {"content": "He'd been drifting on the 35-foot Pearson sailboat for more than two months since leaving Conway, South Carolina, to fish in the ocean. ", "add_special": true}
0.20.422.574 D srv  log_server_r: response: {"tokens":[1465,4035,978,81344,383,279,220,18,20,19858,56564,28443,36516,364,777,1056,1330,3818,2394,9101,57467,11,4725,12375,11,310,7397,303,279,17415,13,220]}
0.20.423.440 D srv          stop: all tasks already finished, no need to cancel
0.20.423.450 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.20.423.450 D srv  log_server_r: request:  {"content": "Just a few days into his trip, a storm capsized his boat and broke his mast. ", "add_special": true}
0.20.423.451 D srv  log_server_r: response: {"tokens":[9658,264,2342,2756,1083,780,8151,11,264,13071,18009,1452,780,14882,321,14009,780,18137,13,220]}
0.20.424.059 D srv          stop: all tasks already finished, no need to cancel
0.20.424.079 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.20.424.080 D srv  log_server_r: request:  {"content": "One of his shoulders was broken, too, so he couldn't fix the boat right away. ", "add_special": true}
0.20.424.080 D srv  log_server_r: response: {"tokens":[3833,314,780,26043,557,10548,11,2166,11,748,551,7448,914,4884,279,14882,1245,3023,13,220]}
0.20.424.908 D srv          stop: all tasks already finished, no need to cancel
0.20.424.919 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.20.424.920 D srv  log_server_r: request:  {"content": "Eventually he was able to rig a makeshift mast and sail, but he could make little headway against the currents. ", "add_special": true}
0.20.424.920 D srv  log_server_r: response: {"tokens":[65687,551,557,2858,310,12864,264,83109,18137,321,28443,11,694,551,1362,1236,2545,1901,3017,2272,279,57587,13,220]}
0.20.425.284 D srv          stop: all tasks already finished, no need to cancel
0.20.425.288 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.20.425.289 D srv  log_server_r: request:  {"content": "\"It took so long,\" Jordan said.  ", "add_special": true}
0.20.425.289 D srv  log_server_r: response: {"tokens":[11734,3738,748,1248,1288,16586,1018,13,256]}
0.20.425.789 D srv          stop: all tasks already finished, no need to cancel
0.20.425.809 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.20.425.813 D srv  log_server_r: request:  {"content": "\"It moved so slowly.\" The boat capsized two more times before he was rescued, according to Jordan. ", "add_special": true}
0.20.425.813 D srv  log_server_r: response: {"tokens":[11734,7481,748,13569,1149,561,14882,18009,1452,1330,777,2942,1518,551,557,42861,11,3956,310,16586,13,220]}
0.20.426.148 D srv          stop: all tasks already finished, no need to cancel
0.20.426.152 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.20.426.153 D srv  log_server_r: request:  {"content": "His father, Frank Jordan, told CNN's Jim Sciutto that he was expecting his son to look different. ", "add_special": true}
0.20.426.153 D srv  log_server_r: response: {"tokens":[15514,6764,11,8995,16586,11,3125,19166,579,11059,39035,53610,421,551,557,21637,780,4292,310,1353,2086,13,220]}
