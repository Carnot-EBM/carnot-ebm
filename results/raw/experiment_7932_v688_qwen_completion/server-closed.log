0.20.417.192 D srv  log_server_r: request:  {"content": "\"We took him to a rescue boat,\" the container ship captain said. I mean it looked like a brand new sailboat.\" Morris told CNN affiliate WPDE that one day in January he was going to the store and Jordan asked him to bring back some coffee creamer. ", "add_special": true}
0.20.417.193 D srv  log_server_r: response: {"tokens":[10397,3738,1384,310,264,16679,14882,1288,279,5303,8026,23167,1018,13,353,2977,424,6749,1040,264,6529,491,28443,36516,1149,28229,3125,19166,20935,22529,1113,421,799,1834,303,5869,551,557,2019,310,279,3436,321,16586,4439,1384,310,4300,1142,1010,10482,12281,261,13,220]}
