0.20.433.637 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.20.433.637 D srv  log_server_r: request:  {"content": "Frank Jordan said it was obvious when the Jordans met at the hospital Friday morning that his normally low-key and private son had been through an ordeal. ", "add_special": true}
0.20.433.638 D srv  log_server_r: response: {"tokens":[36091,16586,1018,424,557,7783,948,279,77392,581,2197,506,279,8512,6394,6353,421,780,13870,3238,15697,321,843,4292,995,978,1472,449,71176,13,220]}
