def test_calibration_selection_and_no_candidate():
    """SCENARIO-REPORT-8818-PAID-COVERAGE: selection uses private calibration only."""
    cohort = m.cohort(3, "calibration")
    rows = m.score(cohort, m.measure(cohort["inputs"]))
