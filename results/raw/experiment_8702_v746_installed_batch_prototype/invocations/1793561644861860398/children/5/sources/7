def test_validation_keeps_disjoint_roles(tmp_path, monkeypatch):
    """SCENARIO-REPORT-8702-CUSTODY: owned and historical children never share coverage credit."""
    from types import SimpleNamespace
    from carnot.reporting import installed_batch_runner_8702 as r

    raw, scratch = tmp_path / "raw", tmp_path / "scratch"
    raw.mkdir()
    scratch.mkdir()
    original = ["original.py::test_original"]
    nodes = original + [s + "::test_owned" for s in e.TESTS]
    observed = []

    def fake_child(name, argv, logs, **kwargs):
        observed.append((name, argv))
        path = raw / (name + ".txt")
        path.write_text("\n".join(nodes) if name == "collect_once" else "")
        return dict(name=name, passed=True, stdout_path=str(path))

    monkeypatch.setattr(r, "child", fake_child)
    monkeypatch.setattr(r.historical, "overlay", lambda *a: {})
    monkeypatch.setattr(r, "historical_command", lambda *a: ["historical_namespace"])
    monkeypatch.setattr(
        r.retained,
        "retain",
        lambda command, nodes, private, target, sources, role: dict(role=role, nodes=nodes),
    )
    monkeypatch.setattr(
        r.retained, "aggregate", lambda children, expected: dict(passed=True, node_ids=expected)
    )
    monkeypatch.setattr(e, "protocol_added_lines", lambda: {1})
    combined = dict(combined_reference=dict(path=str(raw / "coverage")))
    monkeypatch.setattr(
        r.retained,
        "combine",
        lambda rows, path: (observed.append(("combine_roles", rows)), combined)[1],
    )
    monkeypatch.setattr(
        r,
        "Coverage",
        lambda **kwargs: SimpleNamespace(
            load=lambda: None, analysis2=lambda p: (p, [1], [], [], "")
        ),
    )
    result = r.validate(raw, scratch, [], original)
    assert result["coverage"]["complete"]
    assert not result["original_node_union"]["passed"]
    assert all(c["role"] == "owned" for name, c in observed if name == "unused")
    owned = next(v for k, v in observed if k == "combine_roles")
    assert len(owned) == 2 and all(c["role"] == "owned" for c in owned)
    assert all(
        "--no-cov" in argv and "-n" in argv for name, argv in observed if name.startswith("tests-")
    )


