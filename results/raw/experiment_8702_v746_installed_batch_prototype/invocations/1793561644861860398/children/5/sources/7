def test_replay_operand_and_custody_failures(installed, monkeypatch):
    """SCENARIO-REPORT-8702-CUSTODY: immutable seals, operands and producer receipts are independent gates."""
    from carnot.reporting import installed_batch_runner_8702 as r

    root, scratch, inputs, result = installed
    raw = root / "replay-controls"
    raw.mkdir()
    output = raw / (e.NAME + ".json")
    base = dict(
        raw=str(raw),
        output=str(output),
        invocation_id="replay-controls",
        sources=[],
        inputs=inputs,
        preconditions={},
        measurement=result,
        validation=dict(
            checks=[dict(name="private", passed=True)],
            coverage=dict(complete=True),
            children=[],
            receipts=[],
        ),
        duration_s=1.0,
        started_at_utc="2026-11-01T00:00:00Z",
        ended_at_utc="2026-11-01T00:00:01Z",
        phase_spans=[],
    )
    for mode in ["seal", "operand", "failed_child", "valid_child"]:
        work = deepcopy(base)
        if mode == "operand":
            work["sources"] = [dict(path=str(raw / "missing"), sha256="sha256:" + "0" * 64)]
        if "child" in mode:
            e.atomic_json(raw / "child.json", dict(node_ids=["private::test_child"]))
            work["validation"]["children"] = [e.reference(raw / "child.json")]
            monkeypatch.setattr(
                r.retained, "aggregate", lambda *a: dict(passed=mode == "valid_child")
            )
        e.atomic_json(raw / "seal.json", dict(work, changed=True) if mode == "seal" else work)
        work["seal_reference"] = e.reference(raw / "seal.json")
        e.atomic_json(raw / "work.json", work)
        value = e.build(work, output)
        e.atomic_json(output, value)
        pin = value["primitive_reference"]
        assert not r.replay(output)
        assert r.replay(output, pin) == (mode == "valid_child")
    work["owned_error"] = "deadline"
    e.atomic_json(raw / "work.json", work)
    assert e.build(work, output)["batch_service_ready_score"] == 0


def test_measure_deadline_and_wrong_response_ids(installed, monkeypatch):
    """REQ-VERIFY-8702: exhausted time and wrong response identities retain failed children."""
    from carnot.reporting import installed_batch_measure_8702 as m

    root, scratch, inputs, result = installed
    config = Path(result["config_reference"]["path"])
    command = [
        str(scratch / "environment/bin/python"),
        "-u",
        "-m",
        "carnot.inference.resident_protocol",
    ]
    with pytest.raises(TimeoutError, match="measurement_admission"):
        m.session(command, config, "python", [], scratch, root / "expired", deadline_ns=0)
    with pytest.raises(TimeoutError, match="measurement_prepare"):
        m.measure(root / "late-prepare", scratch, inputs, deadline_ns=0)
    readings = iter([0, 1, 50_000_000_000])
    monkeypatch.setattr(m.time, "monotonic_ns", lambda: next(readings, 50_000_000_000))
    with pytest.raises(TimeoutError, match="measurement_stop"):
        m.session(
            command,
            config,
            "python",
            [dict(operation="infer", row=inputs["requests"][0])],
            scratch,
            root / "stopped",
            deadline_ns=100_000_000_000,
        )
    monkeypatch.undo()
    replies = iter([b'{"status":"ready"}', b'{"request_id":"wrong","config_hash":"wrong"}'])
    monkeypatch.setattr(m.wire, "read_frame", lambda *a: next(replies))
    with pytest.raises(ValueError, match="worker_identity"):
        m.session(
            command,
            config,
            "python",
            [dict(operation="infer", row=inputs["requests"][0])],
            scratch,
            root / "wrong-id",
        )
    assert json.loads((root / "wrong-id/failed_child.json").read_text())["killed"]


