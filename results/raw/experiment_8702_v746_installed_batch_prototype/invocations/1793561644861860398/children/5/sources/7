def test_build_and_sealed_replay(installed, monkeypatch):
    """SCENARIO-REPORT-8702-CUSTODY: measured primitives survive cold replay and reject coordinated edits."""
    from carnot.reporting import installed_batch_runner_8702 as r

    root, scratch, inputs, result = installed
    raw = root / "report"
    raw.mkdir()
    output = root / (e.NAME + ".json")
    work = dict(
        raw=str(raw),
        output=str(output),
        invocation_id="private-test",
        sources=[],
        inputs=inputs,
        preconditions={},
        measurement=result,
        validation=dict(
            checks=[dict(name="private", passed=True)],
            coverage=dict(complete=True),
            children=[],
            receipts=[],
        ),
        duration_s=1.0,
        started_at_utc="2026-11-01T00:00:00Z",
        ended_at_utc="2026-11-01T00:00:01Z",
        phase_spans=[],
    )
    e.atomic_json(raw / "invocation_seal.json", work)
    work["seal_reference"] = e.reference(raw / "invocation_seal.json")
    e.atomic_json(raw / "work.json", work)
    value = e.build(work, output)
    e.atomic_json(output, value)
    assert r.replay(output, value["primitive_reference"])
    value["completed_count"] += 1
    value["reproducibility_checksum"] = e.canonical_hash(value)
    e.atomic_json(output, value)
    assert not r.replay(output, value["primitive_reference"])
    for failed in ["checks", "coverage"]:
        changed = deepcopy(work)
        if failed == "checks":
            changed["validation"]["checks"][0]["passed"] = False
        else:
            changed["validation"]["coverage"]["complete"] = False
        assert e.build(changed, output)["verdict_class"] == "disqualified"
    changed = deepcopy(work)
    changed["inputs"]["gate_check_summary"] = [
        dict(field="external", observed_state="missing_file")
    ]
    assert e.build(changed, output)["verdict_class"] == "blocked"


