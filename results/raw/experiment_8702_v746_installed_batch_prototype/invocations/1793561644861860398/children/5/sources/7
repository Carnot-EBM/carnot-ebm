def test_installed_budget_reset_and_opt_out(installed):
    """REQ-VERIFY-8702: real session budgets count items and reset state on relaunch."""
    from carnot.reporting import installed_batch_measure_8702 as m

    root, scratch, inputs, result = installed
    config = e.load(result["config_reference"])
    config["item_budget"] = 1
    path = root / "one-item.json"
    e.atomic_json(path, config)
    command = [
        str(scratch / "environment/bin/python"),
        "-u",
        "-m",
        "carnot.inference.resident_protocol",
    ]
    row = inputs["requests"][0]
    frames = [
        dict(operation="batch", rows=[row], request_id="first"),
        dict(operation="infer", row=row),
    ]
    for index in range(2):
        trace = m.session(command, path, "python", frames, scratch, root / f"reset-{index}")
        assert trace["actual_exit"] == 0
        assert trace["observations"][0]["response"]["status"] == "ok"
        assert trace["observations"][1]["response"]["error"] == "item_budget"
    config.pop("max_batch_size")
    e.atomic_json(path, config)
    trace = m.session(command, path, "python", frames[:1], scratch, root / "opt-out")
    assert trace["observations"][0]["response"]["error"] == "batch_not_enabled"
    private = [
        str(Path(__import__("sys").executable)),
        "-u",
        str(e.ROOT / "scripts/experiments/resident_worker_8608.py"),
    ]
    config["max_batch_size"] = 16
    e.atomic_json(path, config)
    trace = m.session(private, path, "python", frames[:1], scratch, root / "private-adapter")
    assert trace["observations"][0]["response"]["status"] == "ok"


def test_missing_original_operand_and_assertions(monkeypatch, tmp_path):
    """REQ-REPORT-8702: missing registered extension and corrupted head assertions fail closed."""
    original = Path.is_file
    monkeypatch.setattr(Path, "is_file", lambda p: False if str(p).endswith(".so") else original(p))
    result = e.inputs(e.ROOT)
    assert not result["passed"]
    assert result["gate_check_summary"][0]["observed_state"] == "missing_file"
    monkeypatch.undo()
    original_load = e.load

    def altered(ref):
        if ref["path"].endswith("frozen_heads.json"):
            return dict(heads=dict(spline9=[dict(parameters=[])]))
        return original_load(ref)

    monkeypatch.setattr(e, "load", altered)
    with pytest.raises(ValueError, match="original_assertions"):
        e.inputs(e.ROOT)
    path = tmp_path / "changed.json"
    path.write_text("{}")
    ref = e.reference(path)
    path.write_text("[]")
    with pytest.raises(ValueError, match="changed_bytes"):
        original_load(ref)


