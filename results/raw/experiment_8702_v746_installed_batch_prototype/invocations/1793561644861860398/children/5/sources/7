def test_external_failure_states(tmp_path):
    """REQ-REPORT-8702: absent bytes, fields, zero, flags and changes differ."""
    path = tmp_path / "producer.json"
    pin = dict(path=str(path), sha256="sha256:" + "0" * 64)
    assert e.authenticate(pin, {"ready": 1})["failures"][0]["observed_state"] == "missing_file"
    path.write_text("{}")
    assert e.authenticate(pin, {})["failures"][0]["observed_state"] == "changed_bytes"
    for value, expected, state in [
        ({}, {"ready": 1}, "missing_field"),
        ({"ready": 0}, {"ready": 1}, "observed_zero"),
        ({"flagged_adversarial": True}, {"flagged_adversarial": False}, "observed"),
    ]:
        path.write_text(json.dumps(value))
        row = e.authenticate(e.reference(path), expected)["failures"][0]
        assert row["observed_state"] == state
        assert row["field"] == next(iter(expected))
        assert row["operator"] == "=="
    path.write_text("not JSON")
    assert not e.authenticate(e.reference(path), {})["passed"]


def test_terminal_binding(tmp_path):
    """SCENARIO-REPORT-8702-CUSTODY: accepted sidecars bind exact producer bytes."""
    side = tmp_path / "side.json"
    path = tmp_path / "producer.json"
    side.write_text(json.dumps(dict(primary_sha256="wrong", report=dict(passed=True))))
    path.write_text(json.dumps(dict(terminal_validation_sidecar_path=str(side))))
    assert not e.authenticate(e.reference(path), {}, terminal=True)["passed"]
    side.write_text(
        json.dumps(dict(primary_sha256=e.reference(path)["sha256"], report=dict(passed=True)))
    )
    assert e.authenticate(e.reference(path), {}, terminal=True)["passed"]
    side.unlink()
    assert not e.authenticate(e.reference(path), {}, terminal=True)["passed"]


