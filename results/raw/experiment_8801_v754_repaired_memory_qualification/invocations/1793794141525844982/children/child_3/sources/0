def build(work: Json, validation: Json, output: Path) -> Json:
    """Only reproduced original controls and fresh complete coverage can expose memory readiness."""
    checked = deepcopy(validation)
    qualified = bool(
        work.get("original_failure", {}).get("passed")
        and validation.get("original_coverage", {}).get("complete")
        and validation.get("repaired_coverage", {}).get("complete")
    )
    checked["receipts"] += [dict(name="repaired_original_controls", passed=qualified)]
    value = dict(base_build(work, checked, output))
    verdict = "null" if value["verdict_class"] == "positive" else value["verdict_class"]
    if not work["preconditions"]["projection_fits"]:
        verdict = "blocked"
    for row in value["gate_check_summary"]:
        row["artifact_field"] = row.get("field", row["check"])
    value.update(
        experiment_id=8801,
        honest_verdict=f"complete_{verdict}_v754_repaired_memory_qualification",
        verdict_class=verdict,
        intended_count=13,
        n_samples=0,
        random_seed=7548801,
        original_failure_publication=work.get("original_failure", {}),
        original_owned_statement_coverage=validation.get("original_coverage", {}),
        repaired_owned_statement_coverage=validation.get("repaired_coverage", {}),
        original_family_lookup_rows=work["original_family_lookup_rows"],
        preserved_authority_refs=work["preserved_authority_refs"],
        methodology_note="Administrative qualification only. Historical primaries and quarantine states remain preserved. Thirty reset streams are planned, with nested seeds and arms; no learner, model, GPU probe or game is run. Exact historical fixtures replace mutable default lookups. Optional runtime and ARC absence gates only their branch.",
    )
    value["acceptance_gates"]["repaired_original_validation"] = qualified
    if verdict in {"blocked", "disqualified"}:
        for score in v752_branch_report.SCORES:
            value[score] = 0
    value["cited_upstream_artifacts"] = [
        dict(experiment_id=n, fields_imported=fields, **reference(ROOT / path))
        for n, fields, path in [
            (
                8789,
                ["honest_verdict", "code_config_hashes"],
                "results/experiment_8789_v753_branch_qualification.json",
            ),
            (
                8800,
                ["verdict_class", "scientific_measurement_count"],
                "results/experiment_8800_v753_capstone.json",
            ),
            (8789, ["code_config_hashes"], REPAIR),
        ]
    ]
    value["field_principles"] = dict.fromkeys(
        [*value, "field_principles"],
        "Exact operands and measured execution certify administrative custody only; no scientific benefit or independent generalization is imported.",
    )
    value.pop("reproducibility_checksum")
    value["reproducibility_checksum"] = canonical_hash(value)
    return value


