def gate(path: Path, field: str, observed: Any, expected: Any = True, upstream: str = TASK) -> Json:
    """Name missing operands and exact producers rather than silently coercing absence."""
    value = previous.gate(path, field, observed, expected, upstream)
    value["artifact_field"] = field
    return value


def authority(root: Path) -> Json:
    """Accept an older active queue only while an exact V754 staged queue exists."""
    try:
        text = (root / DESIGN).read_text()
        table, tasks = parse_design(text, milestone=MILESTONE)
        active = yaml.safe_load((root / ACTIVE).read_bytes())
        staged = (
            yaml.safe_load((root / STAGED).read_bytes()) if (root / STAGED).is_file() else active
        )
        state = "active_v754"
        if active["milestone"] == "2026.11.753" and (root / STAGED).is_file():
            active, state = staged, "expected_pre_activation_v753"
        for supplied in [active, staged]:
            for actual, expected in zip(supplied["tasks"], tasks):
                if actual == dict(expected, prompt=previous.encode(expected["prompt"])):
                    actual["prompt"] = expected["prompt"]
        result = compare_contract(
            text, staged, active, milestone=MILESTONE, first_id=8801, count=13
        )
        for i, row in enumerate(result["rows"]):
            row["checks"]["full_object"] = (
                i < min(len(tasks), len(active["tasks"]), len(staged["tasks"]))
                and tasks[i] == active["tasks"][i] == staged["tasks"][i]
            )
            matched = all(row["checks"].values())
            row.update(
                task_object=deepcopy(tasks[i]) if i < len(tasks) else None,
                matched=matched,
                absolute_metric=int(matched),
                metric=int(matched),
                denominator=1,
                cluster_id="administrative_contract",
                arm="custody",
                seed=None,
                status="completed" if matched else "censored",
                censored=not matched,
                excluded=False,
                effective_independent_groups=0,
                cost_s=None,
                missing_reason=None if matched else "authority_mismatch",
            )
        ready = (
            result["passed"]
            and all(r["matched"] for r in result["rows"])
            and digest(tasks) == PIN
            and f"Canonical tasks SHA-256: `{PIN}`" in text
            and "<!-- V754_TASK_CONTRACT_END -->" in text
        )
        return dict(
            ready=bool(ready),
            rows=result["rows"],
            visible_table=table,
            active_state=state,
            references=[
                reference(root / p) for p in [DESIGN, ACTIVE, STAGED] if (root / p).is_file()
            ],
        )
    except (OSError, ValueError, KeyError, TypeError, IndexError, AttributeError):
        return dict(ready=False, rows=[], visible_table=[], references=[], active_state="rejected")


def mutations(source: Path, root: Path) -> list[Json]:
    """Attack complete objects in private trees, including historical dependency and gate drift."""
    root.mkdir(parents=True)
    text = (source / DESIGN).read_text()
    tasks = parse_design(text, milestone=MILESTONE)[1]
    design = root / DESIGN
    design.parent.mkdir(parents=True)
    rows = []
    cases = [(i, field) for i, task in enumerate(tasks) for field in task]
    cases += [
        (0, mode)
        for mode in [
            "valid",
            "order",
            "missing_file",
            "malformed_json",
            "retired_dependency",
            "gate_name",
        ]
    ]
    for i, field in cases:
        changed, body = deepcopy(tasks), text
        if field == "order":
            changed.reverse()
        elif field == "malformed_json":
            body = body.replace('"tasks": [', '"tasks": invalid [', 1)
        elif field == "retired_dependency":
            changed[0]["depends_on"] = ["exp8778-retired"]
        elif field == "gate_name":
            changed[1]["gated_on"][0]["field"] = "forged_readiness"
        elif field not in {"valid", "missing_file"}:
            changed[i].pop(field)
        design.write_text(body)
        active = root / ACTIVE
        active.write_text(json.dumps(dict(milestone=MILESTONE, tasks=changed)))
        if field == "missing_file":
            active.unlink()
        observed = authority(root)["ready"]
        rows.append(
            dict(
                task_id=tasks[i]["id"],
                mutation=field,
                expected=field == "valid",
                observed=observed,
                passed=observed == (field == "valid"),
            )
        )
        if len(rows) % 20 == 0:
            progress("negative_controls", len(rows), len(cases) - len(rows))
    return rows


def protocols(tasks: list[Json]) -> Json:
    """Reuse the prespecified estimand while binding only the new memory task operands."""
    value = previous.protocols([])["memory"]
    value.update(
        task_ids=[8802, 8804, 8809, 8810],
        canonical_tasks_sha256=PIN,
        task_operands=[
            deepcopy(t) for t in tasks if int(t["id"].split("-")[0][3:]) in {8802, 8804, 8809, 8810}
        ],
    )
    return dict(memory=value)


def memory_ready(value: Json) -> bool:
    """Any changed decision or threshold invalidates protocol custody before evaluation."""
    return value == protocols(value.get("task_operands", []))["memory"]


def preflight(raw: Path) -> Json:
    """Charge existing import/custody checks once and authenticate repaired source bytes."""
    result = previous.preflight(raw)
    repair = load(dict(path=str(ROOT / REPAIR), sha256=REPAIR_PIN))
    checks = [
        gate(
            Path(ref["path"]),
            "repaired_source_bytes",
            reference(Path(ref["path"]))["sha256"],
            ref["sha256"],
        )
        for ref in repair["code_config_hashes"]
    ]
    result.update(repair_source_checks=checks, repair_receipt_reference=reference(ROOT / REPAIR))
    result["projection_fits"] = result["projection_fits"] and all(r["passed"] for r in checks)
    return result


def freeze(root: Path, raw: Path, run_date: str) -> Json:
    """Freeze source custody and both independent external readers before child validation."""
    bindings = dict(vars(previous))
    bindings.update(
        ROOT=ROOT,
        OWNED=OWNED,
        TESTS=TESTS,
        NAME=NAME,
        TASK=TASK,
        authority=authority,
        protocols=protocols,
        memory_ready=memory_ready,
        preflight=preflight,
        progress=progress,
    )
    freezer = FunctionType(previous.freeze.__code__, bindings)
    work = dict(freezer(root, raw, run_date))
    refs = []
    for name in ARCHIVES + [
        "results/experiment_8789_v753_branch_qualification.json",
        "results/experiment_8800_v753_capstone.json",
    ]:
        target = raw / "preserved" / name
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes((ROOT / name).read_bytes())
        refs += [reference(ROOT / name), reference(target)]
    work.update(
        preserved_authority_refs=refs,
        original_family_lookup_rows=[
            dict(
                family=v,
                default_design=api.DESIGN,
                passed=api.DESIGN != DESIGN,
                observed="mutable_vNEXT_default",
                resolved_design=ARCHIVES[i],
                resolved_sha256=reference(ROOT / ARCHIVES[i])["sha256"],
            )
            for i, (v, api) in enumerate([(752, previous.old), (753, previous)])
        ],
    )
    work["references"] += refs + [reference(ROOT / REPAIR)]
    return work


