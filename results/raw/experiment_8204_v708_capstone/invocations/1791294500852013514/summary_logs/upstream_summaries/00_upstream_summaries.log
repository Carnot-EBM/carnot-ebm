nge program and additional resources to combat the outbreak. Pence stated that the public health emergency continues and efforts to fight it must continue.","source_segments":[{"index":0,"byte_start":0,"byte_end":13},{"index":1,"byte_start":13,"byte_end":178},{"index":2,"byte_start":178,"byte_end":264},{"index":3,"byte_start":264,"byte_end":360},{"index":4,"byte_start":360,"byte_end":470},{"index":5,"byte_start":470,"byte_end":528},{"index":6,"byte_start":528,"byte_end":572},{"index":7,"byte_start":572,"byte_end":664},{"index":8,"byte_start":664,"byte_end":840},{"index":9,"byte_start":840,"byte_end":1079},{"index":10,"byte_start":1079,"byte_end":1158},{"index":11,"byte_start":1158,"byte_end":1395},{"index":12,"byte_start":1395,"byte_end":1499},{"index":13,"byte_start":1499,"byte_end":1750}],"answer_sentence_indices":[0,1,2,3,4,5],"answer_offsets":[{"index":0,"byte_start":0,"byte_end":13},{"index":1,"byte_start":13,"byte_end":115},{"index":2,"byte_start":115,"byte_end":222},{"index":3,"byte_start":222,"byte_end":313},{"index":4,"byte_start":313,"byte_end":452},{"index":5,"byte_start":452,"byte_end":546}]}', 'request_index': 0, 'sentence_indices': [0, 1, 2, 3, 4, 5], 'token_count_measured': True}, 'response': {'choices': [{'finish_reason': 'stop', 'index': 0, 'message': {'content': '0|E|1.00|[0,1]\n1|E|1.00|[2,3]\n2|E|1.00|[4]\n3|E|1.00|[8,11]\n4|E|1.00|[13]\n5|E|1.00|[]', 'role': 'assistant'}}], 'created': 1791259271, 'id': 'chatcmpl-sFvMQwszUkSia30fyEXWZ1IGYh8t8kuz', 'model': 'unsloth/Qwen3.8-27B-GGUF', 'object': 'chat.completion', 'system_fingerprint': 'b9606-9b4dae81f', 'timings': {'cache_n': 0, 'predicted_ms': 2034.436, 'predicted_n': 84, 'predicted_per_second': 41.28908454234982, 'predicted_per_token_ms': 24.21947619047619, 'prompt_ms': 842.385, 'prompt_n': 918, 'prompt_per_second': 1089.7629943553125, 'prompt_per_token_ms': 0.9176307189542483}, 'usage': {'completion_tokens': 84, 'prompt_tokens': 918, 'prompt_tokens_details': {'cached_tokens': 0}, 'total_tokens'