d out \\"imminently.\\" The Australian government has appealed to Indonesian President Joko Widodo to reconsider his refusal to grant clemency. The Secretary-General of the United Nations, Ban Ki-moon, has also called on Indonesia to reverse their decision to execute the prisoners. Human Rights Watch has urged President Widodo to spare the lives of the prisoners and end capital punishment in Indonesia.","source_segments":[{"index":0,"byte_start":0,"byte_end":184},{"index":1,"byte_start":184,"byte_end":268},{"index":2,"byte_start":268,"byte_end":286},{"index":3,"byte_start":286,"byte_end":409},{"index":4,"byte_start":409,"byte_end":631},{"index":5,"byte_start":631,"byte_end":795},{"index":6,"byte_start":795,"byte_end":948},{"index":7,"byte_start":948,"byte_end":1079},{"index":8,"byte_start":1079,"byte_end":1295},{"index":9,"byte_start":1295,"byte_end":1326},{"index":10,"byte_start":1326,"byte_end":1382},{"index":11,"byte_start":1382,"byte_end":1860},{"index":12,"byte_start":1860,"byte_end":2020},{"index":13,"byte_start":2020,"byte_end":2154},{"index":14,"byte_start":2154,"byte_end":2244},{"index":15,"byte_start":2244,"byte_end":2346},{"index":16,"byte_start":2346,"byte_end":2389},{"index":17,"byte_start":2389,"byte_end":2612},{"index":18,"byte_start":2612,"byte_end":2687},{"index":19,"byte_start":2687,"byte_end":2840},{"index":20,"byte_start":2840,"byte_end":2998},{"index":21,"byte_start":2998,"byte_end":3116},{"index":22,"byte_start":3116,"byte_end":3355},{"index":23,"byte_start":3355,"byte_end":3555},{"index":24,"byte_start":3555,"byte_end":3745},{"index":25,"byte_start":3745,"byte_end":3874},{"index":26,"byte_start":3874,"byte_end":4005}],"answer_sentence_indices":[0,1,2,3,4,5,6],"answer_offsets":[{"index":0,"byte_start":0,"byte_end":104},{"index":1,"byte_start":104,"byte_end":232},{"index":2,"byte_start":232,"byte_end":438},{"index":3,"byte_start":438,"byte_end":612},{"index":4,"byte_start":612,"byte_end":732},{"index":5,"byte_start":732,"byte_end":871},{"index":