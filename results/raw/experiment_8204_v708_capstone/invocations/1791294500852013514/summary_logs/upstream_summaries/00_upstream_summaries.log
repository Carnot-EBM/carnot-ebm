and depression can also be experienced. It\'s important to note that not everyone with Parkinson\'s will experience all of these symptoms.","source_segments":[{"index":0,"byte_start":0,"byte_end":92},{"index":1,"byte_start":92,"byte_end":131},{"index":2,"byte_start":131,"byte_end":358},{"index":3,"byte_start":358,"byte_end":508},{"index":4,"byte_start":508,"byte_end":597},{"index":5,"byte_start":597,"byte_end":665},{"index":6,"byte_start":665,"byte_end":748},{"index":7,"byte_start":748,"byte_end":836},{"index":8,"byte_start":836,"byte_end":934},{"index":9,"byte_start":934,"byte_end":1072},{"index":10,"byte_start":1072,"byte_end":1232},{"index":11,"byte_start":1232,"byte_end":1307},{"index":12,"byte_start":1307,"byte_end":1489},{"index":13,"byte_start":1489,"byte_end":1535},{"index":14,"byte_start":1535,"byte_end":1722},{"index":15,"byte_start":1722,"byte_end":1932},{"index":16,"byte_start":1932,"byte_end":2042}],"answer_sentence_indices":[0,1,2,3,4,5,6],"answer_offsets":[{"index":0,"byte_start":0,"byte_end":68},{"index":1,"byte_start":68,"byte_end":126},{"index":2,"byte_start":126,"byte_end":226},{"index":3,"byte_start":226,"byte_end":343},{"index":4,"byte_start":343,"byte_end":438},{"index":5,"byte_start":438,"byte_end":543},{"index":6,"byte_start":543,"byte_end":639}]}', 'request_index': 0, 'sentence_indices': [0, 1, 2, 3, 4, 5, 6], 'token_count_measured': True}, 'response': {'choices': [{'finish_reason': 'stop', 'index': 0, 'message': {'content': '0|E|0.95|[0,2]\n1|E|0.95|[0]\n2|E|0.95|[3,10]\n3|E|0.95|[4,5]\n4|E|0.95|[5]\n5|E|0.95|[1,2]\n6|E|0.95|[2]', 'role': 'assistant'}}], 'created': 1791259377, 'id': 'chatcmpl-rEq5Fx1etUJMX5rZekoSXh8HCr6MBWUr', 'model': 'unsloth/Qwen3.8-27B-GGUF', 'object': 'chat.completion', 'system_fingerprint': 'b9606-9b4dae81f', 'timings': {'cache_n': 0, 'predicted_ms': 2450.937, 'predicted_n': 100, 'predicted_per_second': 40.80072233598824, 'predicted_per_token_ms': 24.50937, 'prompt_ms': 997.914, 'prompt_n': 1121, 'prompt_per_second': 