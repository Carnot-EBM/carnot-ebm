      "arxiv_id": "2606.25068",
      "method": "ADOWIP",
      "implementation_changes": "Freeze costs, release order and hard update budgets before future adaptation; diagnose decision margins now.",
      "limitations": "Time-series proxy evidence and projected convex assumptions do not establish binary-verification benefit. Counterfactual probe costs can erase benefit.",
      "retirement_conflicts": "Do not revive retired speculative-update or generator-training claims.",
      "status": "adapt_narrow_diagnostic_or_defer_training",
      "source_url": "https://arxiv.org/html/2606.25068v1"
