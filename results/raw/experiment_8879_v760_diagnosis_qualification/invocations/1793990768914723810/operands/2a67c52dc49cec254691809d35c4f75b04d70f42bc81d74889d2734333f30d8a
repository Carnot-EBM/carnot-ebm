@pytest.mark.parametrize(
    "failure", ["", "missing", "field", "rejected", "zero", "owned", "terminal", "budget"]
)
def test_main_census(tmp_path: Path, monkeypatch: pytest.MonkeyPatch, failure: str) -> None:
    """REQ-REPORT-8879: terminal receipts retain scheduled failures and the original primary."""
    data = dict(q.d.empty("fixture"), diagnosis_ready_score=1)
    source = tmp_path / "repair.json"
    atomic_json(source, {})
    manifest = tmp_path / "manifest.json"
    atomic_json(manifest, [])
    health = dict(name="global_python_health", scope="repository_health", passed=False)
    state = dict(
        repair=q.d.reference(source),
        manifest=q.d.reference(manifest),
        preconditions={},
        original_primary_sha256=q.ORIGINAL_PIN,
        retained_health_receipt=health,
        repair_evidence_refs=[],
    )

    def authenticate(raw: Path, path: Path) -> dict[str, Any]:
        if failure in {"missing", "field", "rejected", "zero"}:
            raise {
                "missing": FileNotFoundError("absent"),
                "field": KeyError("authority"),
                "rejected": ValueError("rejected_producer"),
                "zero": PermissionError("observed_zero"),
            }[failure]
        return deepcopy(state)

    monkeypatch.setattr(q, "authenticate", authenticate)
    monkeypatch.setattr(q, "reconstruct", lambda _: deepcopy(data))
    monkeypatch.setattr(
        q,
        "validate",
        lambda *args: dict(
            passed=failure != "owned",
            receipts=[],
            coverage={},
            original_nodeids=["original"],
            original_statement_rows=[dict(executed=True)],
        ),
    )
    monkeypatch.setattr(
        q, "terminal", lambda *args: dict(passed=failure != "terminal", receipts=[])
    )
    if failure == "budget":
        monkeypatch.setattr(q, "BUDGET", -1)
    output = tmp_path / (q.NAME + ".json")
    assert q.main(["--private-output", str(output), "--repair", str(source)]) == 0
    result = json.loads(output.read_bytes())
    expected = (
        "null"
        if not failure
        else "blocked"
        if failure in {"missing", "field", "rejected", "zero"}
        else "disqualified"
    )
    assert result["verdict_class"] == expected
    assert result["diagnosis_ready_score"] == int(not failure)
    assert result["intended_count"] == 28800
    assert result["original_primary_sha256"] == q.ORIGINAL_PIN
    assert result["independent_generalization_score"] == 0
    assert set(result) <= set(result["field_principles"]) | {
        "field_principles",
        "producer_normalizer_receipts",
    }
    assert q.main(["--date", "wrong"]) == 1
    assert q.main(["--replay", str(tmp_path / "absent")]) == 1
    monkeypatch.setattr(q, "replay", lambda _: dict(passed=True))
    assert q.main(["--replay", str(output)]) == 0


