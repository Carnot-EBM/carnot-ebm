def test_snapshot_custody(tmp_path: Path) -> None:
    """REQ-REPORT-8879: copied operands survive disappearance and reject changed bytes."""
    source = tmp_path / "input.json"
    atomic_json(source, {"label": "original"})
    refs = q.snapshot([q.d.reference(source)] * 2, tmp_path / "raw")
    assert len(refs) == 1 and Path(refs[0]["path"]).read_bytes() == source.read_bytes()
    source.write_text("changed")
    with pytest.raises(ValueError, match="operand_hash"):
        q.snapshot([dict(path=str(source), sha256=refs[0]["sha256"])], tmp_path / "bad")
    source.unlink()
    assert q.d.load(refs[0]) == {"label": "original"}


