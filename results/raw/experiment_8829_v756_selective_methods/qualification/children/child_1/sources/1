        field_principles="Each field explains its evidence role; a hash is a transport binding.",
        reproducibility_checksum="Bind the complete reduction, not a scientific correctness assertion.",
    )
    value["reproducibility_checksum"] = canonical_hash(value)
    return value


def replay(path: Path) -> bool:
    """Recompute structures, labels and paid work so rehashing a false result cannot validate it."""
    try:
        value = json.loads(path.read_bytes())
        work, validation = load(value["work_reference"]), load(value["validation_reference"])
        for ref in (
            work["source_artifact_hashes"]
            + work["code_config_hashes"]
            + work["raw_shard_hashes"]
            + validation["raw_references"]
        ):
            if sha256_file(Path(ref["path"])) != ref["sha256"]:
                return False
        if value["required_checks_passed"] and (
            not checker.validation_evidence(validation)
            or not repaired.validation_evidence(work["original_qualification"])
        ):
            return False
        raw = Path(value["work_reference"]["path"]).parent
        cohort = load(reference(raw / "cohort.json"))
        exposed = exposed_structures(work["source_artifact_hashes"])
        if (
            work["preconditions_checked"]["external_ready"]
            and work["preconditions_checked"]["resources"]["passed"]
            and cohort != m.freeze(exposed, work["protocol"]["counts"])
        ):
            return False
        original = load(reference(raw / "original_controls.json"))
        old_cal = m.original.cohort(60, "calibration")
        old_eval = m.original.cohort(240, "evaluation")
        collisions = sorted(
            {w["structure"] for w in old_cal["worlds"]}
            & {w["structure"] for w in old_eval["worlds"]}
        )
        if (
            original["calibration"] != old_cal
            or original["evaluation"] != old_eval
            or original["collisions"] != collisions
            or work["collisions"] != collisions
        ):
            return False
        expected = {
            "cohort.json": cohort,
            "inputs.json": dict(
                rows=cohort["inputs"], certification_units=cohort["certification_units"]
            ),
            "private_labels.json": dict(labels=cohort["labels"]),
            "protocol.json": work["protocol"],
            "selection.json": work["selection"],
        }
        if any(load(reference(raw / name)) != content for name, content in expected.items()):
            return False
        if validate_current_work_receipt(work["current_work_receipt"]):
            return False
        decisions = load(reference(raw / "decisions.json"))
        measured = m.measure([u for u in cohort["inputs"] if u["split"] != "fit"], m.SCHEDULES)
        if m.stable(measured) != m.stable(decisions["rows"]) or decisions[
            "commitment"
        ] != canonical_hash(decisions["rows"]):
            return False
        scored = m.score(decisions["rows"], cohort)
        calibration = [r for r in scored if r["split"] == "calibration"]
        if (
            scored != work["rows"]
            or m.select(calibration) != work["selection"]
            or m.diagnose(calibration) != work["diagnostic_rows"]
            or work["controls"]
            != (
                m.original.controls()
                if work["preconditions_checked"]["external_ready"]
                and work["preconditions_checked"]["resources"]["passed"]
                else []
            )
        ):
            return False
        return bool(
            value
            == sealed_value(
                work,
                validation,
                value["run_date"],
                value["work_reference"],
                value["validation_reference"],
            )
        )
    except (OSError, ValueError, KeyError, TypeError):
        return False


def main(argv: list[str] | None = None) -> int:
    """Private runs retain real science but cannot grant themselves owned qualification."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--date", choices=["20261105"], default="20261105")
    parser.add_argument("--output", type=Path, default=m.ROOT / "results" / (m.NAME + ".json"))
    parser.add_argument("--private-output", action="store_true")
    parser.add_argument("--cold-replay", type=Path)
    args = parser.parse_args(argv)
    if args.cold_replay:
        passed = replay(args.cold_replay)
        m.progress("replay_passed" if passed else "replay_rejected")
        return int(not passed)
    output = args.output.absolute()
    if args.private_output and output.resolve().is_relative_to(m.ROOT):
        parser.error("private outputs must remain outside checkout")
    raw = output.parent / "raw" / m.NAME / "invocations" / str(time.time_ns())
    m.progress("start_no_model_load_before_resource_checks")
    pre = preconditions(raw)
    with TemporaryDirectory(prefix="exp8829-original-") as directory:
        m.progress("before_original_qualification")
        old_validation = (
            unqualified()
            if args.private_output or not pre["external_ready"] or not pre["resources"]["passed"]
            else repaired.validate(raw / "original_validation", Path(directory))
        )
        m.progress("after_original_qualification")
    work = prepare(raw, old_validation)
    atomic_json(raw / "work.json", work)
    with TemporaryDirectory(prefix="exp8829-owned-") as directory:
        m.progress("before_owned_validation")
        validation = (
            unqualified() if args.private_output else validate(raw / "validation", Path(directory))
        )
        m.progress("after_owned_validation")
    atomic_json(raw / "validation.json", validation)
    value = sealed_value(
        work,
        validation,
        args.date,
        reference(raw / "work.json"),
        reference(raw / "validation.json"),
    )
    m.progress("before_terminal_publication")
    publication = publish_primary(output, value, lambda candidate: checker.terminal(candidate, raw))
    atomic_json(raw / "publication_receipt.json", publication)
    m.progress("complete_" + value["verdict_class"], len(value["rows"]), 0)
    return 0
