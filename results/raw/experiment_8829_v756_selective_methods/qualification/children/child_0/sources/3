def test_binomial_boundaries():
    """SCENARIO-VERIFY-8829-BOUNDARIES: independent worlds set the support floor."""
    for n in [0, 60, 124, 125, 180]:
        upper = m.risk_upper(n, 0)
        assert upper == pytest.approx(1 if not n else beta.ppf(1 - 0.01 / 6, 1, n))
        assert upper == pytest.approx(m.numerical_upper(n, 0), abs=1e-12)
        assert (upper <= 0.05) == (n >= 125)
    for n, errors in [(60, 1), (180, 3), (125, 125)]:
        assert m.risk_upper(n, errors) == pytest.approx(m.numerical_upper(n, errors))
    for n, e in [(-1, 0), (1, 2), (1, -1)]:
        with pytest.raises(ValueError):
            m.risk_upper(n, e)


def test_exact_invariants_and_sealed_splits():
    """SCENARIO-REPORT-8829-CONTRACT: names and views cannot create new worlds."""
    edges = [[i, (i + 1) % 8] for i in range(8)] + [[0, 3], [3, 7]]
    assert m.topology(edges) == m.topology([[7 - a, 7 - b] for a, b in edges])
    sealed = m.freeze(set(), dict(fit=2, calibration=3, evaluation=2, canary=1))
    assert len(sealed["worlds"]) == 8
    assert len({w["structure"] for w in sealed["worlds"]}) == 8
    assert len(sealed["inputs"]) == 48
    assert all(m.truth(u["input"]) == sealed["labels"][u["unit_id"]] for u in sealed["inputs"])
    assert all(w["variables"] in [2, 3] and w["vertices"] == 8 for w in sealed["worlds"])
    rejected = m.freeze({w["structure"] for w in sealed["worlds"]}, dict(fit=1))
    assert rejected["worlds"][0]["structure"] not in {w["structure"] for w in sealed["worlds"]}
    with pytest.raises(ValueError, match="input_fields"):
        m.truth(dict(sealed["inputs"][0]["input"], truth="support"))
    with pytest.raises(ValueError, match="independent"):
        from unittest.mock import patch

        with patch.object(m.original, "label", return_value="bad"):
            m.truth(sealed["inputs"][0]["input"])


def test_paid_schedules_and_support():
    """SCENARIO-VERIFY-8829-BOUNDARIES: paid partial work never becomes an answer."""
    c = m.freeze(set(), dict(calibration=3))
    rows = m.measure(c["inputs"], m.SCHEDULES)
    scored = m.score(rows, c)
    assert len(scored) == 54
    assert all(x["primitive_operations"] <= m.CAP for x in scored)
    assert all(x["decision"] == "insufficient" for x in scored if x["truth"] == "insufficient")
    selected = m.select(scored)
    assert selected["schedule"] in m.SCHEDULES or selected["schedule"] is None
    diag = m.diagnose(scored)
    assert len(diag) == 3 * 3 * 6
    assert max(x["accepted_worlds"] for x in diag) <= 3
    with pytest.raises(ValueError, match="replicated"):
        m.diagnose(scored + scored[:1])
    with pytest.raises(ValueError, match="calibration_only"):
        m.select([dict(scored[0], split="evaluation")])
    assert (
        m.select([dict(x, decision="insufficient", metric=0) for x in scored])["schedule"] is None
    )
    for schedule in m.SCHEDULES:
        result = m.schedule(schedule, c["inputs"][0]["input"], 0)
        assert result["decision"] == "insufficient" and result["budget_exhausted"]
    with pytest.raises(ValueError):
        m.schedule("bad", c["inputs"][0]["input"])
    with pytest.raises(ValueError, match="attempt_roster"):
        m.score(rows[:-1], c)


def test_private_cli_and_semantic_replay(tmp_path):
    """SCENARIO-REPORT-8829-CONTRACT: actual CLI survives a foreign working directory."""
    output = tmp_path / (m.NAME + ".json")
    env = dict(os.environ)
    env.pop("PYTHONPATH", None)
    command = [
        sys.executable,
        "-u",
        "-c",
        "import sys,runpy; sys.path[:0]="
        + repr([str(m.ROOT / "python"), str(m.ROOT)])
        + "; from carnot.reporting import selective_methods_8829 as m; "
        "m.COUNTS.update(fit=2,calibration=3,evaluation=2,canary=1); "
        "sys.argv[0]=sys.argv.pop(1); runpy.run_path(sys.argv[0],run_name='__main__')",
        str(m.ROOT / m.CLI),
    ]
    child = subprocess.run(
        command + ["--date", "20261105", "--private-output", "--output", str(output)],
        cwd=tmp_path,
        env=env,
        capture_output=True,
        text=True,
        timeout=600,
    )
    assert child.returncode == 0, child.stdout + child.stderr
    value = json.loads(output.read_bytes())
    assert value["verdict_class"] == "disqualified"
    assert value["independent_count"] == 8
    assert value["selective_protocol_ready_score"] == 0
    assert r.replay(output)
    value["certificate_boundary_rows"][0]["risk_upper"] = 0
    value["reproducibility_checksum"] = canonical_hash(
        {k: v for k, v in value.items() if k != "reproducibility_checksum"}
    )
    atomic_json(output, value)
    assert not r.replay(output)
    assert not r.replay(tmp_path / "absent")


