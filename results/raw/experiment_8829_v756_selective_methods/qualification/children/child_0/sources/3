def test_blocked_and_failed_owned_verdicts(small_work, monkeypatch):
    """SCENARIO-VERIFY-8829-BOUNDARIES: absent authority blocks; internal and owned failures disqualify."""
    raw, work, validation = small_work
    from carnot.reporting.v746_retained_evidence import reference

    good = dict(
        union=dict(passed=True),
        coverage=dict(complete=True),
        receipts=[dict(passed=True)],
        raw_references=[],
    )
    work["original_qualification"] = good
    build = lambda: r.sealed_value(
        work, good, "20261105", reference(raw / "work.json"), reference(raw / "validation.json")
    )
    assert build()["verdict_class"] == "null"
    work["selection"]["schedule"] = "always_joint"
    assert build()["verdict_class"] == "circular_positive"
    work["preconditions_checked"]["external_ready"] = False
    assert build()["verdict_class"] == "blocked"
    work["collisions"] = ["collision"]
    assert build()["verdict_class"] == "disqualified"
    configured = type("Validator", (), {})()
    configured.validate = lambda *args: validation
    monkeypatch.setattr(r, "namespace", lambda *args: configured)
    assert r.validate(raw, raw) == validation
    assert configured.e.OWNED == m.OWNED
    assert len(configured.original.CONSUMERS) == 2


def test_standalone_semantic_tampering(small_work):
    """SCENARIO-VERIFY-8829-BOUNDARIES: rehashed labels, work and reductions cannot become valid."""
    raw, baseline, validation = small_work
    from carnot.reporting.v746_retained_evidence import reference

    files = {p.name: json.loads(p.read_bytes()) for p in raw.glob("*.json")}
    output = raw.parent / (m.NAME + ".json")

    def candidate(change=lambda w, f: None):
        work, operands = deepcopy(baseline), deepcopy(files)
        change(work, operands)
        for name, content in operands.items():
            atomic_json(raw / name, content)
        work["raw_shard_hashes"] = [
            reference(Path(ref["path"])) for ref in work["raw_shard_hashes"]
        ]
        atomic_json(raw / "work.json", work)
        value = r.sealed_value(
            work,
            validation,
            "20261105",
            reference(raw / "work.json"),
            reference(raw / "validation.json"),
        )
        atomic_json(output, value)
        return value

    candidate()
    assert r.replay(output)
    mutations = [
        lambda w, f: w["code_config_hashes"][0].update(sha256="forged"),
        lambda w, f: f["cohort.json"]["worlds"][0].update(structure="forged"),
        lambda w, f: f["original_controls.json"].update(collisions=["forged"]),
        lambda w, f: f["inputs.json"]["rows"][0].update(input_sha256="forged"),
        lambda w, f: w["current_work_receipt"].update(event_sha256="forged"),
        lambda w, f: f["decisions.json"]["rows"][0].update(primitive_operations=999),
        lambda w, f: w["rows"][0].update(metric=999),
    ]
    for change in mutations:
        candidate(change)
        assert not r.replay(output)
    value = candidate()
    value["required_checks_passed"] = True
    atomic_json(output, value)
    assert not r.replay(output)


