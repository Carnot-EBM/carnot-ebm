def test_exhaustion_replication_and_heartbeats(monkeypatch):
    """SCENARIO-VERIFY-8829-BOUNDARIES: exhausted construction and repeated worlds fail explicitly."""
    with monkeypatch.context() as patch:
        patch.setattr(m, "MAX_ATTEMPTS", 0)
        with pytest.raises(ValueError, match="cohort_support_exhausted"):
            m.freeze(set(), dict(fit=1))
    cohort = m.freeze(set(), dict(calibration=1))
    ticks = iter(range(0, 100000, 31))
    with monkeypatch.context() as patch:
        patch.setattr(m.time, "monotonic", lambda: next(ticks))
        rows = m.score(m.measure(cohort["inputs"], m.SCHEDULES), cohort)
    certified = next(x for x in rows if x["certification_unit"])
    with pytest.raises(ValueError, match="replicated_world"):
        m.diagnose(rows + [dict(certified, unit_id="another/variant")])
    artificial = [
        dict(
            certified,
            unit_id=f"calibration/{i}",
            cluster_id=f"calibration/{i:03}",
            truth="support",
            decision="support",
        )
        for i in range(180)
    ]
    assert max(x["accepted_worlds"] for x in m.diagnose(artificial)) == 180
    assert m.stable([dict(wall_time_s=1, decision="support")]) == [dict(decision="support")]


