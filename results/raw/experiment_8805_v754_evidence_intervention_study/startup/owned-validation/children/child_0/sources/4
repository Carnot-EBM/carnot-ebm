def test_private_cli_blocked_and_replay(tmp_path):
    """SCENARIO-VERIFY-8805-TERMINAL: real CLI preserves blocked operands and replay."""
    output = tmp_path / (m.NAME + ".json")
    cli = [sys.executable, str(m.ROOT / m.CLI)]
    for name, args, expected in [
        ("blocked", ["--upstream", str(tmp_path / "absent"), "--output", str(output)], 0),
        ("cold", ["--cold-replay", str(output)], 0),
        ("missing", ["--cold-replay", str(tmp_path / "absent")], 1),
        ("date", ["--date", "20260101"], 2),
        ("input_missing_output", ["--decide-input", str(tmp_path / "none")], 2),
    ]:
        receipt = child(name, cli + args, tmp_path / "logs", expected=expected, deadline=120)
        assert receipt["passed"], Path(receipt["stderr_path"]).read_text()
    value = json.loads(output.read_bytes())
    assert value["verdict_class"] == "blocked" and value["evidence_rows_ready_score"] == 0
    assert value["completed_count"] == 0 and value["intended_count"] == 8640
    assert value["gate_check_summary"] and runner.replay(output)
    value["completed_count"] = 1
    value.pop("reproducibility_checksum")
    value["reproducibility_checksum"] = canonical_hash(value)
    atomic_json(output, value)
    assert not runner.replay(output)


def test_real_input_child_and_build(tmp_path, cohort, monkeypatch):
    """REQ-REPORT-8805: label-free child and owned-failure suppression are executable."""
    inputs, output = tmp_path / "inputs.json", tmp_path / "decisions.json"
    atomic_json(inputs, dict(rows=cohort["inputs"]))
    assert runner.main(["--decide-input", str(inputs), "--decisions", str(output)]) == 0
    decisions = json.loads(output.read_bytes())["rows"]
    for name, value in [
        ("inputs", cohort["inputs"]),
        ("labels", cohort["labels"]),
        ("decisions", decisions),
    ]:
        atomic_json(tmp_path / (name + ".json"), dict(rows=value))
    work = dict(
        raw=str(tmp_path),
        run_date="20261104",
        preconditions_checked=dict(passed=True, diagnostics=[]),
        duration_s=1.0,
        phase_spans=[],
        source_artifact_hashes=[],
        code_config_hashes=[],
        measurement_receipts=[dict(passed=True)],
        raw_shard_hashes=[
            m.reference(tmp_path / (n + ".json")) for n in ["inputs", "labels", "decisions"]
        ],
    )
    invalid = runner.unqualified()
    atomic_json(tmp_path / "work.json", work)
    atomic_json(tmp_path / "validation.json", invalid)
    assert runner.build(work, invalid)["verdict_class"] == "disqualified"
    qualified = dict(
        receipts=[dict(passed=True)],
        union=dict(passed=True),
        coverage=dict(complete=True),
        raw_references=[],
    )
    atomic_json(tmp_path / "validation.json", qualified)
    value = runner.build(work, qualified)
    assert value["verdict_class"] == "disqualified" and value["evidence_rows_ready_score"] == 0
    assert value["completed_count"] == 72 and value["independent_count"] == 1
    atomic_json(tmp_path / "work.json", work)
    atomic_json(tmp_path / "validation.json", qualified)
    runner.seal(tmp_path, value)
    candidate = tmp_path / (m.NAME + ".json")
    atomic_json(candidate, value)
    assert runner.replay(candidate)
    assert runner.terminal(candidate, tmp_path)["passed"]
    changed = deepcopy(value)
    changed["paired_deltas"][0]["values"]["semantic_false_accept_difference"] += 1
    changed.pop("reproducibility_checksum")
    changed["reproducibility_checksum"] = canonical_hash(changed)
    atomic_json(candidate, changed)
    assert not runner.replay(candidate)
    atomic_json(candidate, value)
    with monkeypatch.context() as patch:
        patch.setattr(m, "audit", lambda *_: False)
        assert not runner.replay(candidate)
    Path(value["raw_shard_hashes"][0]["path"]).unlink()
    assert not runner.replay(candidate)


def test_private_full_cli_and_failures(tmp_path, monkeypatch):
    """REQ-VERIFY-8805: private full work stays disqualified without actual validation."""
    output = tmp_path / (m.NAME + ".json")
    assert runner.main(["--private-control", "--output", str(output)]) == 0
    value = json.loads(output.read_bytes())
    assert value["completed_count"] == 8640 and value["verdict_class"] == "disqualified"
    assert value["acceptance_gates"]["complete_schedule"]
    assert runner.replay(output)
    with pytest.raises(SystemExit):
        runner.main(["--private-control"])
    with monkeypatch.context() as patch:
        patch.setattr(
            runner, "preflight", lambda *_: (_ for _ in ()).throw(OSError("missing scratch"))
        )
        assert runner.main(["--output", str(output)]) == 0
        assert json.loads(output.read_bytes())["verdict_class"] == "blocked"


def test_shared_validation_delegation(tmp_path, monkeypatch):
    """REQ-VERIFY-8805: owned files and unchanged historical tests reach the shared collector."""
    from types import SimpleNamespace

    target = SimpleNamespace(validate=lambda raw, private: dict(raw=str(raw), private=str(private)))
    monkeypatch.setattr(runner, "namespace", lambda module, name: target)
    assert runner.validate(tmp_path, tmp_path) == dict(raw=str(tmp_path), private=str(tmp_path))
    assert target.e.OWNED == m.OWNED
    assert target.e.TESTS == m.TESTS + m.up.TESTS + m.up.old.TESTS
