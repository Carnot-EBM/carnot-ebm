def test_sealed_schedule_and_protocol():
    """SCENARIO-REPORT-8805-SEALED-ROWS: preserve the full crossed schedule."""
    admitted = m.authenticate(m.UPSTREAM)
    assert admitted["passed"], admitted
    data = m.cohort(admitted["producer"])
    labels = data["labels"]
    assert len(labels) == 3360
    scheduled = [r for r in labels if r["scope"] == "scheduled"]
    assert len(scheduled) * 3 == 8640
    assert len({r["world_id"] for r in scheduled}) == 120
    assert {r["condition"] for r in scheduled} == set(m.up.CONDITIONS)
    assert {r["token_bin"] for r in scheduled} == {1024, 1536}
    assert all(set(r) == {"unit_id", "input"} for r in data["inputs"])
    assert all(r["unit_id"].startswith("sha256:") for r in data["inputs"])
    p = m.protocol()
    assert p["draws"] == 10000 and p["confidence"] == 0.9875
    assert len(p["families"]) == 4 and p["primitive_limit"] == 200000


def test_measure_score_and_null(cohort):
    """SCENARIO-REPORT-8805-SIMULTANEOUS: low false-accept headroom cannot win."""
    decisions = m.measure(cohort["inputs"])
    assert len(decisions) == len(cohort["inputs"]) * 4
    assert all(0 < r["primitive_operations"] for r in decisions)
    rows = m.score(cohort["labels"], decisions)
    scheduled = [r for r in rows if r["scope"] == "scheduled" and r["arm"] in m.ARMS]
    controls = [r for r in rows if r["scope"] == "valid_alternative" and r["arm"] in m.ARMS]
    summary = m.summarize(scheduled, controls)
    assert not summary["method_benefit"]
    assert len(summary["simultaneous_intervals"]) == 8
    assert all(r["draws"] == 10000 for r in summary["simultaneous_intervals"])
    assert len(summary["per_defect_rows"]) == 21
    assert all(r["denominator"] == 4 for r in summary["per_defect_rows"])
    local = [r for r in scheduled if r["arm"] == "local_record"]
    assert all(r["decision"] == "insufficient" for r in local)
    exact = [r for r in rows if r["arm"] == "unlimited_exact_reference"]
    assert all(r["metric"] == 1 for r in exact)
    assert all(r["primitive_limit"] is None for r in exact)
    assert m.audit(cohort["inputs"], decisions)
    altered = deepcopy(decisions)
    altered[0]["decision"] = "refute"
    assert not m.audit(cohort["inputs"], altered)
    assert not m.audit(cohort["inputs"], decisions[:-1])
    with pytest.raises(ValueError, match="input_fields"):
        m.measure([dict(cohort["inputs"][0], expected="support")])
    with pytest.raises(ValueError, match="input_fields"):
        m.measure([dict(cohort["inputs"][0], input=dict(cohort["inputs"][0]["input"], label=1))])
    assert m.summarize([], [])["paired_deltas"] == []


@pytest.mark.parametrize(
    "value,check",
    [
        (None, "rejected_producer"),
        ({}, "missing_field"),
        ({"evidence_interventions_ready_score": 0}, "observed_zero"),
        ({"evidence_interventions_ready_score": 1}, "rejected_producer"),
    ],
)
def test_authentication_rejections(tmp_path, value, check):
    """SCENARIO-VERIFY-8805-BOUNDARIES: absence and observed zero differ."""
    path = tmp_path / "producer.json"
    atomic_json(path, value)
    result = m.authenticate(path)
    assert not result["passed"]
    assert result["diagnostics"][0]["check"] == check
    assert result["diagnostics"][0]["artifact_field"]


def test_missing_source_and_cohort_drift(tmp_path, monkeypatch):
    """REQ-VERIFY-8805: exact hashes bind raw sources, not just readiness scalars."""
    assert m.authenticate(tmp_path / "absent")["diagnostics"][0]["check"] == "missing_file"
    with monkeypatch.context() as patch:
        patch.setattr(m, "reference", lambda p: dict(path=str(p), sha256="drift"))
        assert not m.authenticate(m.UPSTREAM)["passed"]
    producer = json.loads(m.UPSTREAM.read_bytes())
    producer["cohort_references"]["intervention_inputs"]["sha256"] = "drift"
    with pytest.raises(ValueError):
        m.cohort(producer)
    original_reference = m.reference
    with monkeypatch.context() as patch:
        patch.setattr(
            m,
            "reference",
            lambda p: (
                original_reference(p) if p == m.UPSTREAM else dict(path=str(p), sha256="drift")
            ),
        )
        assert not m.authenticate(m.UPSTREAM)["passed"]
    producer = json.loads(m.UPSTREAM.read_bytes())
    inputs = m.load(producer["cohort_references"]["intervention_inputs"])
    inputs["rows"][0]["unit_id"] = "changed"
    atomic_json(tmp_path / "drift.json", inputs)
    producer["cohort_references"]["intervention_inputs"] = original_reference(
        tmp_path / "drift.json"
    )
    with pytest.raises(ValueError, match="cohort_join"):
        m.cohort(producer)


