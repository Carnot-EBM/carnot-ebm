def contract(root: Path) -> Json:
    """Use the existing full-object and activation checker without changing historical authority."""
    result = q.authority(root)
    if not result["ready"]:
        raise ValueError("v754_full_object_authority")
    tasks = parse_design((root / q.DESIGN).read_text(), milestone=MILESTONE)[1]
    return dict(tasks=tasks, visible_table=result["visible_table"], comparison=result)


def authenticate(path: Path, task_id: str) -> Json:
    """Reuse primary validation and check raw and command custody for producer schema variants."""
    value = load(reference(path))
    validate_primary(value, path)
    if value.get("task_id") != task_id:
        raise ValueError("producer_task_identity")
    refs = [
        r
        for key in ["raw_shard_hashes", "code_config_hashes", "source_artifact_hashes"]
        for r in value.get(key, [])
        if isinstance(r, dict) and r.get("path")
    ]
    receipts = value.get("validation_receipts", [])
    if (
        not refs
        or not receipts
        or not value.get("owned_statement_coverage", {}).get("percent") == 100
    ):
        raise ValueError("producer_validation_missing")
    for receipt in receipts:
        for stream in ["stdout", "stderr"]:
            if stream + "_path" in receipt:
                refs.append(
                    dict(path=receipt[stream + "_path"], sha256=receipt[stream + "_sha256"])
                )
        if receipt.get("scope") != "repository_health" and not receipt["passed"]:
            raise ValueError("producer_owned_validation_failure")
    if any(reference(Path(r["path"]))["sha256"] != r["sha256"] for r in refs):
        raise ValueError("producer_operand_drift")
    return dict(value=value, references=refs)


