def freeze(root: Path, raw: Path, run_date: str) -> Json:
    """Charge shared custody once, then retain exact row reductions without running producers."""
    if q.authority(root)["ready"]:
        work: Json = _shared.freeze(root, raw, run_date)
    else:
        # The pinned checkout contract supplies scheduled identities, never substitute producer evidence.
        started = now()
        authority = contract(ROOT)
        preconditions = _shared.preflight(ROOT, raw)
        preconditions.update(supplied_authority_ready=False, projection_fits=False)
        snapshot(ROOT, raw / "authority")
        snapshot(root, raw / "rejected_supplied_authority")
        refs = [reference(root / p) for p in [q.DESIGN, q.ACTIVE, q.STAGED]]
        work = dict(
            authority,
            slots=[slot(t, root, raw) for t in authority["tasks"][:-1]],
            root=str(root),
            raw=str(raw.absolute()),
            invocation_id=raw.name,
            run_date=run_date,
            started_at_utc=started,
            preconditions=preconditions,
            references=refs,
            sources=[reference(ROOT / p) for p in OWNED + TESTS + CONSUMERS],
            prior_outcomes=[
                dict(
                    task_id=t["id"],
                    prior_task_id=p["experiment_id"],
                    primary_reference=reference(root / "results" / (p["experiment_id"] + ".json")),
                    actual_task_id=None,
                    actual_honest_verdict=None,
                    registered_verdict_matches=False,
                    exact_identity_matches=False,
                )
                for t in authority["tasks"]
                for p in t["prior_failures"]
            ],
        )
        work["comparison"]["ready"] = False
    work["sources"] += [reference(ROOT / p) for p in [__file__, q.__file__]]
    work["references"] += [reference(ROOT / p) for p in q.ARCHIVES]
    reductions = []
    for row in work["slots"]:
        value = load(row["primary_reference"]) if row["primary_reference"]["sha256"] else {}
        reductions.append(
            dict(
                task_id=row["task_id"],
                experiment_id=row["experiment_id"],
                admitted=row["producer_qualified"],
                reference=row["primary_reference"],
                reported_verdict=value.get("verdict_class"),
                reduction=reduce_rows(value.get("rows", [])) if row["producer_qualified"] else {},
                scores={k: v for k, v in value.items() if k.endswith("_score")},
                scientific_denominators={
                    k: value.get(k)
                    for k in [
                        "intended_count",
                        "completed_count",
                        "independent_count",
                        "numerical_training_calls",
                    ]
                },
                verifier_is_oracle=value.get("verifier_is_oracle"),
                exposure_scope=row["exposure_scope"],
            )
        )
    work["reductions"] = reductions
    atomic_json(raw / "work.json", work)
    return work


