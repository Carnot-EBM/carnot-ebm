def slot(task: Json, root: Path, raw: Path) -> Json:
    """Keep alternate scheduler receipts distinct from the declared primary's scientific verdict."""
    row: Json = _base.slot(task, root)
    value = load(row["primary_reference"]) if row["primary_reference"]["sha256"] else {}
    qualified = (
        row["producer_executed"]
        and not row["authentication_errors"]
        and value.get("required_checks_passed") is True
        and not value.get("flagged_adversarial")
        and value.get("verdict_class") != "disqualified"
    )
    row.update(
        producer_qualified=qualified,
        verdict_class=value["verdict_class"] if qualified else row["verdict_class"],
        excluded=bool(value.get("flagged_adversarial")),
        exposure_scope=value.get("exposure_scope", "no admitted measurement"),
    )
    row["disposition"] = "quarantined_evidence" if row["excluded"] else row["verdict_class"]
    progress("source_summary_before", row["experiment_id"] - 8801, 8813 - row["experiment_id"])
    row["summary_references"] = [
        previous.disciplined(p, raw)
        for p in sorted((root / "results").glob(f"experiment_{row['experiment_id']}_*.json"))
    ]
    progress("source_summary_after", row["experiment_id"] - 8800, 8812 - row["experiment_id"])
    row["excluded"] = row["excluded"] or any(
        r["summary_status"] >= 2 for r in row["summary_references"]
    )
    row["producer_qualified"] = row["producer_qualified"] and not row["excluded"]
    row["disposition"] = "quarantined_evidence" if row["excluded"] else row["verdict_class"]
    scheduler_ok = False
    if row["conductor_reference"]:
        receipt = load(row["conductor_reference"])
        scheduler_ok = (
            receipt.get("experiment") == row["experiment_id"]
            and receipt.get("title") == task["title"]
            and receipt.get("blocked_at_layer") == "conductor_pre_gate"
            and receipt.get("honest_verdict") == "blocked_gate_check_failed"
        )
        for recorded in row["conductor_gate_receipts"]:
            ref = dict(path=recorded["artifact_path"], sha256=recorded["artifact_sha256"])
            actual = observe(
                ref, recorded["upstream"], recorded["artifact_field"], recorded["expected"]
            )
            scheduler_ok = (
                scheduler_ok
                and actual["observed"] == recorded["actual"]
                and actual["passed"] == recorded["passed"]
            )
    row["accounted"] = bool(
        row["producer_executed"] or scheduler_ok or row["conductor_disposition_lines"]
    )
    row.update(
        cluster_id="administrative_task_slots",
        seed=None,
        metric=int(row["accounted"]),
        denominator=1,
        missing_reason=None if row["accounted"] else "missing_external_receipt",
    )
    return row


def reduce_rows(rows: list[Json]) -> Json:
    """Recompute arm means from complete rows and count clusters once across sibling seeds."""
    groups: dict[str, list[Json]] = defaultdict(list)
    complete = [r for r in rows if r.get("status") == "completed"]
    for row in complete:
        groups[str(row["arm"])].append(row)
    return dict(
        completed_rows=len(complete),
        scheduled_rows=len(rows),
        independent_clusters=len({r["cluster_id"] for r in complete}),
        arms={
            arm: dict(
                row_count=len(group),
                denominator=sum(r["denominator"] for r in group),
                metric_mean=sum(r["metric"] for r in group) / len(group),
            )
            for arm, group in groups.items()
        },
    )


