tests/python/test_experiment_10010_b2_think_on_pilot.py::test_engine_cannot_reach_answers_in_memory[\nimport gc\nimport numpy as np\ndef engine(grid, action, data=None):\n    g = np.asarray(grid)\n    for obj in gc.get_objects():\n        nxt = getattr(obj, "next_grid", None)\n        if nxt is not None and np.array_equal(np.asarray(obj.grid), g):\n            return nxt\n    return grid\n]
