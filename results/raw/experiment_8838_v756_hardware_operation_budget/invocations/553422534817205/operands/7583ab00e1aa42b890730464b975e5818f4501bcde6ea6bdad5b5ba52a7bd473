def verify_validation(validation: Json) -> None:
    """A passing flag needs the recorded commands, unchanged logs and real coverage."""
    receipts = validation["receipts"]
    for row in receipts:
        if sha256_file(ROOT / row["log_path"]) != row["log_sha256"]:
            raise ValueError("validation_log_drift")
    if validation["passed"]:
        names = {
            "owned_pytest",
            "private_e2e018_021",
            "ruff_check",
            "ruff_format",
            "strict_mypy",
            "spec_coverage",
        }
        if not names.issubset({r["name"] for r in receipts if r["passed"] and r["exit_code"] == 0}):
            raise ValueError("validation_receipt_drift")
        coverage = validation["coverage"]
        report = Path(coverage["path"])
        if sha256_file(report) != coverage["sha256"]:
            raise ValueError("coverage_hash_drift")
        data = json.loads(report.read_bytes())
        if (
            len(data["files"]) != len(OWNED)
            or data["files"] != coverage["files"]
            or any(r["missing_lines"] or r["excluded_lines"] for r in data["files"].values())
        ):
            raise ValueError("coverage_statement_drift")


def replay(path: Path) -> Json:
    """Original pins constrain rows even when someone repairs the artifact checksum."""
    value = json.loads(path.read_bytes())
    present = {(r["original_path"], r["sha256"]) for r in value["source_artifact_hashes"]}
    for branch, ref in value["phase_work"]["evidence"].items():
        name, pin, _, _ = PRODUCERS[branch]
        if (
            ref["original_path"] != str(ROOT / name)
            or ref["sha256"] != pin
            or (ref["original_path"], pin) not in present
            or sha256_file(Path(ref["path"])) != pin
        ):
            raise ValueError("authority_pin_drift")
        producer = json.loads(Path(ref["path"]).read_bytes())
        required = []
        for key in ["source_artifact_hashes", "code_config_hashes", "raw_shard_hashes"]:
            operands = producer[key]
            required.extend(operands.values() if isinstance(operands, dict) else operands)
        if any((r["path"], r["sha256"]) not in present for r in required):
            raise ValueError("operand_manifest_drift")
    for ref in value["source_artifact_hashes"]:
        if sha256_file(Path(ref["path"])) != ref["sha256"]:
            raise ValueError("operand_hash_drift:" + ref["path"])
        original = ref["original_path"]
        pins = {str(ROOT / p): h for p, h in HISTORY.items()}
        pins.update({str(ROOT / p): h for p, h, _, _ in PRODUCERS.values()})
        if original in pins and ref["sha256"] != pins[original]:
            raise ValueError("authority_pin_drift")
    if validate_current_work_receipt(value):
        raise ValueError("current_receipt_drift")
    verify_validation(value["validation_state"])
    expected = build(value["phase_work"], value["validation_state"])
    if value != expected:
        raise ValueError("reduction_drift")
    return dict(passed=True, checked_sha256=sha256_file(path))


def main(argv: list[str] | None = None) -> int:
    """Keep private runs explicit and validate prospective primary bytes atomically."""
    parser = argparse.ArgumentParser()
    parser.add_argument("--date", choices=["20261105"], default="20261105")
    parser.add_argument("--private-output", type=Path)
    parser.add_argument("--replay", "--cold-replay", type=Path)
    args = parser.parse_args(argv)
    if args.replay:
        try:
            print(json.dumps(replay(args.replay)), flush=True)
            return 0
        except (OSError, ValueError, KeyError) as exc:
            print(json.dumps(dict(passed=False, reason=str(exc))), flush=True)
            return 1
    from carnot.reporting.hardware_budget_validation_8838 import qualify, terminal
    from carnot.reporting.primary_publication import publish_primary

    output = (args.private_output or ROOT / "results" / (NAME + ".json")).absolute()
    raw = output.parent / "raw" / NAME / "invocations" / str(time.monotonic_ns())
    work = collect(raw)
    atomic_json(raw / "work.json", work)
    validation = (
        dict(passed=False, receipts=[], coverage=dict(complete=False))
        if args.private_output
        else qualify(raw)
    )
    progress("reduction_before")
    value = build(work, validation)
    progress("publication_before")
    report = publish_primary(
        output, value, lambda p: replay(p) if args.private_output else terminal(p, raw)
    )
    atomic_json(raw / "publication.json", report)
    progress("complete")
    return 0
