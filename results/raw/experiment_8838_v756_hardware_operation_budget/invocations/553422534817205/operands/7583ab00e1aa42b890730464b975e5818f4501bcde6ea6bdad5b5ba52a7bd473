def progress(phase: str) -> None:
    """Flush audit boundaries so validation cannot conceal a stopped process."""
    print(f"[exp8838] phase={phase}", flush=True)


def retain(path: Path, raw: Path, expected: str | None = None) -> Json:
    """Recover only exact old spec bytes; executable drift must remain a failure."""
    data = path.read_bytes()
    digest = sha256_file(path)
    if expected is not None and digest != expected:
        relative = path.relative_to(ROOT).as_posix()
        if not (relative.startswith("openspec/capabilities/") and relative.endswith("/spec.md")):
            raise ValueError("operand_hash_drift:" + str(path))
        progress("original_spec_git_before")
        data = subprocess.check_output(
            ["git", "show", SPEC_COMMIT + ":" + relative], cwd=ROOT, timeout=15
        )
        progress("original_spec_git_after")
    target = raw / "operands" / (expected or digest).split(":")[-1]
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes(data)
    actual = sha256_file(target)
    if expected is not None and actual != expected:
        raise ValueError("operand_hash_drift:" + str(path))
    return dict(path=str(target.absolute()), sha256=actual, original_path=str(path))


def admission(value: Json, branch: str) -> str | None:
    """Readiness and valid row operands are both required for admission."""
    field = PRODUCERS[branch][2]
    if value.get(field) is None:
        return "missing_field"
    if value[field] == 0:
        return "observed_zero"
    rows = value.get("window_rows" if branch == "whole" else "rows", [])
    if (
        value[field] != 1
        or value.get("experiment_id") != PRODUCERS[branch][3]
        or value.get("required_checks_passed") is not True
        or value.get("flagged_adversarial", False) is not False
        or value.get("verdict_class") not in {"positive", "circular_positive", "null"}
        or not str(value.get("honest_verdict", "")).startswith("complete_")
        or not rows
        or any(
            r.get("status") != "completed"
            or not isinstance(r.get("denominator"), int)
            or r["denominator"] <= 0
            for r in rows
        )
    ):
        return "rejected_producer"
    return None


def collect(raw: Path) -> Json:
    """Check resources and each external producer independently before reduction."""
    start = time.monotonic_ns()
    progress("preconditions_before")
    raw.mkdir(parents=True, exist_ok=True, mode=0o700)
    raw.chmod(0o700)
    atomic_json(raw / "writable.json", dict(private=True))
    checks = dict(
        repository_virtualenv=(ROOT / ".venv/bin/python").is_file(),
        private_output_writable=True,
        free_disk_bytes=shutil.disk_usage(raw).free,
        minimum_free_bytes=256 * 1024**2,
        cpu_numerical_dependencies="not used; standard library reader",
    )
    refs, failures = [], []
    internal_failure = False
    for name in [*SOURCES, *HISTORY]:
        path = ROOT / name
        try:
            refs.append(retain(path, raw, HISTORY.get(name)))
        except (OSError, ValueError, subprocess.SubprocessError) as exc:
            failures.append(
                dict(
                    check="required_operand",
                    upstream="board_authority_or_source",
                    artifact_field="sha256",
                    expected=HISTORY.get(name, "readable bytes"),
                    observed=sha256_file(path) if path.is_file() else None,
                    path=str(path),
                    sha256=sha256_file(path) if path.is_file() else None,
                    missing_reason="missing_file"
                    if isinstance(exc, OSError)
                    else "rejected_producer",
                )
            )
            internal_failure |= name in [*OWNED, TEST]
    evidence = {}
    for branch, (name, pin, field, _) in PRODUCERS.items():
        path = ROOT / name
        diagnostic = dict(
            check="producer_admission",
            upstream=branch,
            artifact_field=field,
            expected=1,
            observed=None,
            path=str(path),
            sha256=None,
            expected_sha256=pin,
            missing_reason="missing_file",
        )
        try:
            diagnostic["sha256"] = sha256_file(path)
            diagnostic.update(artifact_field="sha256", expected=pin, observed=diagnostic["sha256"])
            primary = retain(path, raw, pin)
            diagnostic["sha256"] = primary["sha256"]
            value = json.loads(Path(primary["path"]).read_bytes())
            diagnostic.update(
                artifact_field=field,
                expected=1,
                observed=value.get(field),
                missing_reason=admission(value, branch),
            )
            if diagnostic["missing_reason"]:
                failures.append(diagnostic)
                continue
            bound = [primary]
            for key in ["source_artifact_hashes", "code_config_hashes", "raw_shard_hashes"]:
                operands = value[key]
                for operand in operands.values() if isinstance(operands, dict) else operands:
                    observed = (
                        sha256_file(Path(operand["path"]))
                        if Path(operand["path"]).is_file()
                        else None
                    )
                    diagnostic.update(
                        path=operand["path"],
                        artifact_field="sha256",
                        expected=operand["sha256"],
                        observed=observed,
                        sha256=observed,
                    )
                    bound.append(retain(Path(operand["path"]), raw, operand["sha256"]))
            refs.extend(bound)
            evidence[branch] = primary
        except (OSError, ValueError, KeyError, subprocess.SubprocessError) as exc:
            diagnostic.update(
                missing_reason="missing_file" if isinstance(exc, OSError) else "rejected_producer",
                error=str(exc),
            )
            failures.append(diagnostic)
    progress("preconditions_after")
    return dict(
        evidence=evidence,
        refs=refs,
        failures=failures,
        checks=checks,
        started_ns=start,
        ended_ns=time.monotonic_ns(),
        owner_pid=os.getpid(),
        internal_failure=internal_failure,
    )


def reduce(evidence: Json) -> Json:
    """Map paid operations without dividing whole clocks into invented fractions."""
    costs, witnesses, targets = [], [], []
    whole = evidence.get("whole", {})
    for row in whole.get("window_rows", []):
        predictions = [p for s in row["segments"] for p in s["predictions"]]
        releases = [r for s in row["segments"] for r in s["releases"]]
        counts = dict(
            feature_observations=len(predictions),
            primitive_checks=sum(p["primitive_checks"] for p in predictions),
            prediction_normalizations=len(predictions),
            training_normalizations=len(releases),
            dense_gradient_calls=sum(r["optimizer_steps"] for r in releases),
            parameter_commits=sum(r["coefficient_committed"] for r in releases),
            template_writes=sum(r["template_added"] for r in releases),
            feedback_verifier_calls=sum(r["feedback_verifier_calls"] for r in releases),
            store_saves=len(predictions) + len(releases) + len(row["segments"]),
            sampler_calls=0,
        )
        total = row["complete_ns"] / 1e9
        cost = {
            k: row[k] for k in ("unit_id", "cluster_id", "arm", "seed", "status", "denominator")
        }
        cost.update(
            metric=total / row["denominator"],
            missing_reason=None,
            complete_operation_s=total,
            query_count=len(predictions),
            complete_query_s=total / len(predictions),
            operation_counts=counts,
            source_branch="whole",
        )
        costs.append(cost)
        targets.append(
            dict(
                unit_id=row["unit_id"],
                arm=row["arm"],
                complete_operation_s=total,
                target_latency_s=total / 100,
                query_target_latency_s=total / len(predictions) / 100,
                claim="future100x latency requirement; no predicted gain",
            )
        )
    for row in evidence.get("witness", {}).get("rows", []):
        witnesses.append({**row, "source_branch": "witness"})
    boards = []
    host_counts = {
        k: sum(r["operation_counts"][k] for r in costs)
        for k in (costs[0]["operation_counts"] if costs else [])
    }
    witness_counts = {
        k: sum(r["operation_counts"].get(k, 0) for r in witnesses)
        for k in (witnesses[0]["operation_counts"] if witnesses else [])
    }
    for board, boundary in BOARDS.items():
        for operation, (precision, traffic) in OPERATIONS.items():
            boards.append(
                dict(
                    unit_id=board + "/" + operation,
                    cluster_id=board,
                    arm=operation,
                    seed=0,
                    denominator=1,
                    metric=0,
                    status="completed",
                    missing_reason=None,
                    operation_status="blocked" if board == "GateMate" else "host_only",
                    boundary=boundary["boundary"],
                    precision=precision,
                    memory_state_traffic=traffic,
                    host_work=traffic,
                    unknowns=["component time", "wire bytes", "compatible kernel fraction"],
                    measured_board_time_s=None,
                    fabric_supported=False,
                    paid_host_counts=host_counts,
                    paid_witness_counts=witness_counts,
                    count_scope="whole CPU workload inventory; not compatible fabric fractions",
                )
            )
    return dict(
        rows=costs + witnesses + boards,
        board_operation_rows=boards,
        complete_cost_refs=costs,
        paid_witness_rows=witnesses,
        measured_mode_differences=whole.get("paired_cost_intervals", []),
        witness_schedule_benefit_score=evidence.get("witness", {}).get("schedule_benefit_score"),
        target_latency_requirements=targets,
        sampling_call_count=0,
        unsupported_operations=[r["unit_id"] for r in boards],
        unknown_costs=[
            "disjoint compatible component fractions",
            "joins and feature component time",
            "serialization and fsync component time",
            "board startup and transfer",
            "wire precision and bus traffic",
            "NPU and TSU compatible kernels",
        ],
        physical_evidence_state=BOARDS,
    )


