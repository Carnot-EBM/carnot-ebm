    }
    reduced = reduce(evidence)
    checks = work["checks"]
    owned_valid = (
        validation["passed"]
        and validation["coverage"]["complete"]
        and not work.get("internal_failure", False)
    )
    valid = (
        owned_valid
        and checks["repository_virtualenv"]
        and checks["private_output_writable"]
        and checks["free_disk_bytes"] >= checks["minimum_free_bytes"]
    )
    verdict = (
        "disqualified"
        if not owned_valid
        else "blocked"
        if work["failures"] or not valid
        else "null"
