            d.execute(graph, args.arm, args.journal, args.crash)
            return 0
        if args.reduce:
            if args.reduction is None:
                parser.error("reduce requires --reduction")
            atomic_json(args.reduction, reduce_work(json.loads(args.reduce.read_bytes())))
