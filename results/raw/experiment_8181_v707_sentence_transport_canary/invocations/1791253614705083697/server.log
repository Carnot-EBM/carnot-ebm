\\":null},\\\"BusinessParking\\\":{\\\"garage\\\":false,\\\"lot\\\":true,\\\"street\\\":true,\\\"valet\\\":false,\\\"validated\\\":false},\\\"Music\\\":null,\\\"OutdoorSeating\\\":true,\\\"RestaurantsGoodForGroups\\\":true,\\\"RestaurantsReservations\\\":false,\\\"RestaurantsTakeOut\\\":true,\\\"WiFi\\\":\\\"no\\\"},\\\"business_stars\\\":4.5,\\\"categories\\\":\\\"Hot Dogs, Restaurants\\\",\\\"city\\\":\\\"Santa Barbara\\\",\\\"hours\\\":{\\\"Friday\\\":\\\"11:0-21:0\\\",\\\"Monday\\\":\\\"11:0-20:0\\\",\\\"Saturday\\\":\\\"11:0-21:0\\\",\\\"Thursday\\\":\\\"11:0-20:0\\\",\\\"Tuesday\\\":\\\"11:0-20:0\\\",\\\"Wednesday\\\":\\\"11:0-20:0\\\"},\\\"name\\\":\\\"Dave’s Dogs\\\",\\\"review_info\\\":[{\\\"review_date\\\":\\\"2021-12-29 20:27:39\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"Great hot dog! The staff was incredibly friendly and our food was ready quickly. Can't recommend it enough!\\\"},{\\\"review_date\\\":\\\"2021-10-21 03:29:38\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"We stopped by here randomly after a trip to the zoo and we are so glad we did. The staff were so friendly and the food was so good. Our family agreed that this was the best hot dog we have had in a long time.\\\"},{\\\"review_date\\\":\\\"2021-06-27 20:40:21\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"Dave is the best. He continues to work hard to bring great food to his community. Lots of delicious options on the menu but the pizza dog is my go to. Just when he thought it couldn't get better he brought in a great burger and chicken sandwich menu. Stop by and support local business.\\\"}],\\\"state\\\":\\\"CA\\\"}\",\"answer\":\"Dave's Dogs is a local business located at 900 N Milpas St in Santa Barbara, CA. It is a restaurant that specializes in serving hot dogs. The business has received positive reviews from customers, with an average rating of 4.5 stars. \\n\\nCustomers have praised the friendly staff and quick service at Dave's Dogs. They have also mentioned that the food is of high quality and delicious. One customer mentioned that it was the best hot dog they have had in a long time. Another customer appreciated the owner, Dave, for his dedication in bringing great food to the community. \\n\\nThe restaurant offers outdoor seating and takeout options. It is suitable for groups and has a casual and trendy ambience. The business does not provide WiFi. \\n\\nDave's Dogs operates from 11:00 AM to 8:00 PM from Monday to Thursday, and from 11:00 AM to 9:00 PM on Fridays and Saturdays. The parking options include street parking and a parking lot. \\n\\nOverall, Dave's Dogs is a highly recommended local business in Santa Barbara, known for its friendly staff, delicious hot dogs, and a variety of menu options.\",\"source_segments\":[{\"index\":0,\"byte_start\":0,\"byte_end\":768},{\"index\":1,\"byte_start\":768,\"byte_end\":834},{\"index\":2,\"byte_start\":834,\"byte_end\":1013},{\"index\":3,\"byte_start\":1013,\"byte_end\":1066},{\"index\":4,\"byte_start\":1066,\"byte_end\":1234},{\"index\":5,\"byte_start\":1234,\"byte_end\":1298},{\"index\":6,\"byte_start\":1298,\"byte_end\":1367},{\"index\":7,\"byte_start\":1367,\"byte_end\":1467},{\"index\":8,\"byte_start\":1467,\"byte_end\":1519}],\"answer_sentence_indices\":[8,9,10,11,12],\"answer_offsets\":[{\"index\":0,\"byte_start\":0,\"byte_end\":81},{\"index\":1,\"byte_start\":81,\"byte_end\":138},{\"index\":2,\"byte_start\":138,\"byte_end\":236},{\"index\":3,\"byte_start\":236,\"byte_end\":312},{\"index\":4,\"byte_start\":312,\"byte_end\":385},{\"index\":5,\"byte_start\":385,\"byte_end\":467},{\"index\":6,\"byte_start\":467,\"byte_end\":575},{\"index\":7,\"byte_start\":575,\"byte_end\":634},{\"index\":8,\"byte_start\":634,\"byte_end\":698},{\"index\":9,\"byte_start\":698,\"byte_end\":736},{\"index\":10,\"byte_start\":736,\"byte_end\":862},{\"index\":11,\"byte_start\":862,\"byte_end\":926},{\"index\":12,\"byte_start\":926,\"byte_end\":1084}]}<|im_end|>\n<|im_start|>assistant\n<thin