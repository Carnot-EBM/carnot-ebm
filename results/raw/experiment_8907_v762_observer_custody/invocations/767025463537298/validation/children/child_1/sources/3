@pytest.mark.parametrize("kind", ["spec", "code", "clock", "missing", "producer"])
def test_retained_mutations(tmp_path, monkeypatch, kind):
    """REQ-REPORT-8907: rehashed false bytes cannot replace a sealed operand."""
    bundle = m.load(m.BUNDLE)
    slot = next(s for s in bundle["slots"] if s["experiment_id"] == 8894)
    if kind == "producer":
        ref = slot["snapshots"][0]
    else:
        ref = next(
            r
            for r in slot["snapshots"]
            if (
                r["path"].endswith("/spec.md")
                if kind == "spec"
                else r["path"].endswith("/buffered_clock_methods_8894.py")
                if kind == "code"
                else "/cold-" in r["path"]
            )
        )
    changed = tmp_path / Path(ref["path"]).name
    if kind != "missing":
        content = Path(ref["path"]).read_bytes()
        if kind in {"producer", "clock"}:
            value = m.load(ref)
            if kind == "producer":
                value["experiment_id"] = 8899
            else:
                value["rows"][0]["end_ns"] += 1
                value["reproducibility_checksum"] = canonical_hash(value)
            atomic_json(changed, value)
        else:
            changed.write_bytes(content + b"\n# mutation\n")
    original = m.retained_path

    def resolve(operand, index):
        return changed if operand["sha256"] == ref["sha256"] else original(operand, index)

    monkeypatch.setattr(m, "retained_path", resolve)
    with pytest.raises((OSError, ValueError)):
        m.qualify(execute=False)


def test_current_code_mutation(tmp_path, monkeypatch):
    """REQ-REPORT-8907: custody does not grandfather changed observer algorithms."""
    original = m.sha256_file
    monkeypatch.setattr(
        m,
        "sha256_file",
        lambda p: "sha256:changed" if p == m.ROOT / m.OBSERVER else original(p),
    )
    with pytest.raises(ValueError, match="equivalence"):
        m.qualify(execute=False)


