def test_main_failure_routes_and_parser(tmp_path, monkeypatch):
    """REQ-REPORT-8907: external absence blocks while failed owned work disqualifies."""
    from types import SimpleNamespace
    from carnot.reporting import observer_custody_runner_8907 as runtime
    from carnot.reporting.selective_runner_8816 import unqualified

    for argv in [["--date", "20261108"], ["--private-output", str(m.ROOT / "bad.json")]]:
        with pytest.raises(SystemExit) as exc:
            runtime.main(argv)
        assert exc.value.code == 2
    assert runtime.main(["--cold-replay", str(tmp_path / "absent.json")]) == 1
    monkeypatch.setattr(
        runtime, "namespace", lambda *a: SimpleNamespace(validate=lambda *a: unqualified())
    )
    assert not runtime.validate(tmp_path, tmp_path)["coverage"]["complete"]
    monkeypatch.setattr(runtime, "terminal", lambda *a: dict(passed=True))
    for error, verdict in [
        (FileNotFoundError("operand"), "blocked"),
        (
            m.CustodyError(
                dict(
                    check="missing_file",
                    path="/missing/retained",
                    expected=m.PIN,
                    observed=None,
                    upstream="exp8894-buffered-clock-methods",
                    artifact_field="retained_operand.sha256",
                    hash=None,
                )
            ),
            "blocked",
        ),
        (ValueError("owned_replay:control"), "disqualified"),
    ]:

        def failed(**kwargs):
            raise error

        monkeypatch.setattr(m, "qualify", failed)
        output = tmp_path / verdict / (m.NAME + ".json")
        assert runtime.main(["--output", str(output)]) == 0
        value = m.load(m.reference(output))
        assert value["verdict_class"] == verdict
        assert value["retained_evidence_ready_score"] == 0
        assert value["gate_check_summary"]
        assert m.replay(output)["passed"]


