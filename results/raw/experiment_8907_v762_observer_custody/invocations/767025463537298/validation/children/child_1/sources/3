def test_private_cli_and_rehashed_rejection(tmp_path):
    """SCENARIO-REPORT-8907-CONTRACT: actual child executes outside checkout."""
    output = tmp_path / (m.NAME + ".json")
    env = dict(os.environ)
    env.pop("PYTHONPATH", None)
    command = [sys.executable, "-u", str(m.ROOT / m.CLI)]
    child = subprocess.run(
        command + ["--private-output", str(output)],
        cwd=tmp_path,
        env=env,
        capture_output=True,
        text=True,
        timeout=180,
    )
    assert child.returncode == 0, child.stdout + child.stderr
    value = m.load(m.reference(output))
    assert value["retained_evidence_ready_score"] == 0
    assert value["completed_count"] == 6
    assert value["cold_replay_receipt"]["fresh_installed_control_executed"]
    assert any("/fresh_control/retained_workers/" in r["path"] for r in value["raw_shard_hashes"])
    child = subprocess.run(
        command + ["--cold-replay", str(output)],
        cwd=tmp_path,
        env=env,
        capture_output=True,
        text=True,
        timeout=180,
    )
    assert child.returncode == 0, child.stdout + child.stderr
    bad = deepcopy(value)
    bad["retained_evidence_ready_score"] = 1
    bad["reproducibility_checksum"] = canonical_hash(
        {k: v for k, v in bad.items() if k != "reproducibility_checksum"}
    )
    atomic_json(output, bad)
    assert not m.replay(output)["passed"]


@pytest.mark.parametrize("kind", ["missing_field", "observed_zero", "rejected_producer"])
def test_producer_gate_diagnostics(kind):
    """REQ-REPORT-8907: preserve zero, absent fields and invalid producer distinctions."""
    value = dict(
        observer_ready_score=1,
        experiment_id=8894,
        task_id="exp8894-buffered-clock-methods",
        required_checks_passed=True,
        verdict_class="circular_positive",
