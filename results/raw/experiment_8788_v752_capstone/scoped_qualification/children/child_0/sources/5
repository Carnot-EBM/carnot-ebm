"""REQ-VERIFY-8788: preserve original V751 assertions without invoking its controller."""

from copy import deepcopy
from datetime import datetime, UTC
import importlib.util
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys

import yaml

from carnot.reporting.current_work_receipt import atomic_json, sha256_file
from carnot.reporting.roadmap_contract import parse_design

ROOT = Path(__file__).resolve().parents[2]


def configure(root):
    """Use private byte copies for historical reads while retaining original field assertions."""
    from carnot.reporting import v751_capstone as old
    from carnot.reporting import v746_capstone_inputs as io
    from carnot.reporting import hardware_operation_inputs_8707 as auth

    store = root / "immutable_inputs"
    store.mkdir(exist_ok=True)
    original_reference = io.reference

    def copied(ref):
        source = Path(ref.get("snapshot_reference", ref)["path"])
        target = store / ref["sha256"][7:]
        if not target.is_file():
            shutil.copyfile(source, target)
            target.chmod(0o444)
        assert sha256_file(target) == ref["sha256"]
        return target

    def private_load(ref):
        if ref.get("sha256") is None:
            raise FileNotFoundError("absent fixture operand")
        return json.loads(copied(ref).read_bytes())

    def private_verify(ref):
        if ref.get("sha256") is None:
            raise FileNotFoundError("absent fixture operand")
        copied(ref)

    def private_sidecar(primary, sidecar):
        return private_load(original_reference(sidecar))

    io.load, io.verify = private_load, private_verify
    old.e.load, old.e.verify = private_load, private_verify
    auth.load, auth.read_bound_sidecar = private_load, private_sidecar
    old.e.ROOT = root
    old.e.CLI = str(root / "archive_cli.py")
    base_slot = old.slot
    old.slot = lambda task, raw, lines, root=root: base_slot(task, raw, lines, root)
    return old


def archive_main(root, argv=None):
    """Rebuild a fixture with a fresh pytest proof; no historical main function runs."""
    import argparse

    old = configure(root)
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", type=Path)
    parser.add_argument("--date", default="20261103")
    parser.add_argument("--private-control", action="store_true")
    parser.add_argument("--failed-child", action="store_true")
    parser.add_argument("--cold-replay", type=Path)
    args = parser.parse_args(argv)
    if args.cold_replay:
        try:
            value = json.loads(args.cold_replay.read_bytes())
            work = old.e.load(value["primitive_reference"])
            raw = Path(work["raw"])
            seal = json.loads((raw / "fixture_seal.json").read_bytes())
            if seal != value["primitive_reference"]:
                return 1
            receipts = json.loads((raw / "fixture_checks.json").read_bytes())
            return int(old.build(work, receipts, Path(value["publication_output"])) != value)
        except (OSError, ValueError, KeyError, TypeError, AssertionError):
            return 1
    if args.output is None or args.date != "20261103":
        return 1
    raw = args.output.parent / ("raw_" + args.output.stem)
    raw.mkdir(parents=True, exist_ok=True)
    work = json.loads((root / "sealed_work.json").read_bytes())
    work.update(raw=str(raw), authority_root=str(root), private_control=True)
    source = raw / "test_fixture_proof.py"
    source.write_text(
        "def test_fixture():\n    assert " + ("False" if args.failed_child else "True") + "\n"
    )
    proof = subprocess.run(
        [
            sys.executable,
            "-m",
            "pytest",
            "-c",
            "/dev/null",
            "-o",
            "addopts=",
            "--no-cov",
            "-q",
            str(source),
        ],
        capture_output=True,
        text=True,
        timeout=60,
    )
    receipts = [dict(passed=proof.returncode == 0, argv=proof.args, actual_exit=proof.returncode)]
    work["ended_at_utc"] = datetime.now(UTC).isoformat()
    atomic_json(raw / "measurement.json", work)
    atomic_json(raw / "fixture_seal.json", old.e.reference(raw / "measurement.json"))
    (raw / "fixture_checks.json").write_text(json.dumps(receipts))
    value = old.build(work, receipts, args.output)
    atomic_json(args.output, value)
    return int(args.failed_child)


def test_original_capstone_family(tmp_path):
    """SCENARIO-VERIFY-8788-REPLAY: execute the original failing nodes and retain their outcomes."""
    root = tmp_path / "v751"
    root.mkdir()
    primary = json.loads((ROOT / "results/experiment_8775_v751_capstone.json").read_bytes())
    primitive = Path(primary["primitive_reference"]["path"])
    assert sha256_file(primitive) == primary["primitive_reference"]["sha256"]
    work = json.loads(primitive.read_bytes())
    atomic_json(root / "sealed_work.json", work)
    design = root / "openspec/change-proposals/research-roadmap-vNEXT.md"
    design.parent.mkdir(parents=True)
    text = (
        ROOT / "openspec/change-proposals/research-roadmap-v751-preserved-20261103.md"
    ).read_text()
    design.write_text(text)
    tasks = parse_design(text, milestone="2026.11.751")[1]
    for name in ["research-roadmap.yaml", "research-roadmap-next.yaml"]:
        (root / name).write_text(yaml.safe_dump(dict(milestone="2026.11.751", tasks=tasks)))
    (root / "results").mkdir()
    for task in tasks[:-1]:
        for source in (ROOT / "results").glob(
            "experiment_" + task["id"].split("-")[0][3:] + "_*.json"
        ):
            shutil.copyfile(source, root / "results" / source.name)
    source_test = ROOT / "tests/python/test_v751_capstone_8775.py"
    suite = tmp_path / source_test.name
    shutil.copyfile(source_test, suite)
    assert sha256_file(suite) == sha256_file(source_test)
    helper = Path(__file__).resolve()
    prelude = f"import sys\nsys.path[:0] = {[str(ROOT / 'python'), str(ROOT), str(helper.parent)]!r}\nfrom pathlib import Path\n"
    (root / "archive_cli.py").write_text(
        prelude
        + "from test_v752_capstone_archive_8788 import archive_main\n"
        + f"raise SystemExit(archive_main(Path({str(root)!r})))\n"
    )
    (tmp_path / "conftest.py").write_text(
        prelude
        + "from test_v752_capstone_archive_8788 import configure\n"
        + f"configure(Path({str(root)!r}))\n"
    )
    command = [
        sys.executable,
        "-m",
        "pytest",
        "-n0",
        "-o",
        "addopts=",
        "--no-cov",
        "-q",
        str(suite),
        "--junitxml=" + str(tmp_path / "original-family-junit.xml"),
    ]
    result = subprocess.run(
        command,
        capture_output=True,
        text=True,
        timeout=180,
        env=dict(os.environ, PYTHONPATH=f"{ROOT / 'python'}:{ROOT}"),
    )
    (tmp_path / "original-family.stdout").write_text(result.stdout)
    (tmp_path / "original-family.stderr").write_text(result.stderr)
    atomic_json(
        tmp_path / "original-family-receipt.json",
        dict(
            argv=command,
            actual_exit=result.returncode,
            original_test_sha256=sha256_file(source_test),
            copied_test_sha256=sha256_file(suite),
            stdout_sha256=sha256_file(tmp_path / "original-family.stdout"),
            stderr_sha256=sha256_file(tmp_path / "original-family.stderr"),
        ),
    )
    assert result.returncode == 0, result.stdout + result.stderr
