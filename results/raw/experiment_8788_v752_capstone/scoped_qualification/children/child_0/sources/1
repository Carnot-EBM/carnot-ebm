def replay(path: Path) -> bool:
    """Independent seals reject repaired envelopes and recomputation rejects invented totals."""
    try:
        value = c.load(c.reference(path))
        work = c.load(value["primitive_reference"])
        raw = Path(work["raw"])
        if (raw / "work.json").read_bytes() != (raw / "frozen_inputs.json").read_bytes():
            return False
        seal = c.load(c.reference(raw / "independent_seal.json"))
        if seal != dict(
            primitive_reference=value["primitive_reference"],
            validation_reference=value["validation_reference"],
        ):
            return False
        validation = c.load(value["validation_reference"])
        if any(
            c.reference(Path(r["path"]))["sha256"] != r["sha256"]
            for r in work["references"] + work["sources"]
        ):
            return False
        if c.contract(raw / "authority")["tasks"] != work["tasks"]:
            return False
        return build(work, validation, Path(value["publication_output"])) == value
    except (OSError, ValueError, KeyError, TypeError, IndexError):
        return False
