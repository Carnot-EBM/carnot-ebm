def reconstruct(value: Json) -> Json:
    """Recompute admitted science from its primitive rows without invoking a producer CLI."""
    if not value:
        return {}
    work = c.load(value["primitive_reference"])
    rebuilt: Json = {}
    if "frozen_reference" in work and "decisions_reference" in work:
        from carnot.reporting import evidence_set_evaluation_8779 as evidence

        frozen = c.load(work["frozen_reference"])
        decisions = c.load(work["decisions_reference"])["rows"]
        rows = evidence.score(frozen["inputs"], frozen["labels"], decisions)
        rebuilt = dict(evidence.summarize(rows), rows=rows)
    elif "window_rows" in work:
        from carnot.reporting import durable_cost_components_8784 as durable

        rebuilt = durable.reduce(work["window_rows"])
        for row in rebuilt["component_cost_rows"]:
            row["admitted"] = bool(value["component_cost_ready_score"])
    for key, actual in rebuilt.items():
        if key in value and actual != value[key]:
            raise ValueError("primitive_reduction_drift:" + key)
    return rebuilt


def build(work: Json, validation: Json, output: Path) -> Json:
    """Completed accounting can stay blocked; owned validation failure always disqualifies."""
    checked = (
        bool(validation["receipts"])
        and all(r["passed"] for r in validation["receipts"])
        and validation["coverage"]["complete"]
        and validation["union"]["passed"]
    )
    rows = deepcopy(work["slots"])
    by_id = {t["id"]: t for t in work["tasks"]}
    gates, admissions = [], []
    values = {}
    for row in rows:
        ref = row["primary_reference"]
        value = c.load(ref) if ref["sha256"] and row["producer_executed"] else {}
        values[row["experiment_id"]] = value
        admissions.append(
            dict(
                task_id=row["task_id"],
                reference=ref,
                admitted=row["producer_qualified"],
                reasons=row["authentication_errors"],
            )
        )
        for gate in by_id[row["task_id"]]["gated_on"]:
            upstream = next(r for r in rows if r["task_id"] == gate["upstream"])
            observed = c.observe(
                upstream["primary_reference"],
                gate["upstream"],
                gate["artifact_field"],
                gate["value"],
            )
            gates.append(
                dict(
                    observed,
                    consumer_task_id=row["task_id"],
                    producer_qualified=upstream["producer_qualified"],
                    passed=observed["passed"] and upstream["producer_qualified"],
                )
            )
        for recorded in row["conductor_gate_receipts"]:
            ref = dict(path=recorded["artifact_path"], sha256=recorded["artifact_sha256"])
            actual = c.observe(
                ref, recorded["upstream"], recorded["artifact_field"], recorded["expected"]
            )
            gates.append(
                dict(
                    actual,
                    consumer_task_id=row["task_id"],
                    check="conductor_receipt_matches_operand",
                    expected=[recorded["actual"], recorded["passed"]],
                    observed=[actual["observed"], actual["passed"]],
                    passed=[actual["observed"], actual["passed"]]
                    == [recorded["actual"], recorded["passed"]],
                )
            )
    for row in rows:
        if row["authentication_errors"]:
            gates.append(
                dict(
                    row["primary_reference"],
                    upstream=row["task_id"],
                    check="producer_admission",
                    field="exact_task_identity_and_terminal_validation",
                    operator="==",
                    expected=True,
                    observed="rejected_producer",
                    operand_state="rejected_producer",
                    passed=False,
                )
            )
    branches = {}
    for name, (number, fields) in BRANCHES.items():
        row = next(r for r in rows if r["experiment_id"] == number)
        value = values[number]
        rebuilt = reconstruct(value) if row["producer_qualified"] else {}
        branches[name] = dict(
            primitive_reconstruction=rebuilt,
            measured=row["producer_qualified"],
            verdict_class=row["verdict_class"],
            primary_reference=row["primary_reference"],
            independent_count=row["independent_count"],
            verifier_is_oracle=bool(
                value.get("verifier_is_oracle") or value.get("oracle_dependent_benchmark")
            ),
            exposure_scope=value.get("exposure_scope", "no admitted measurement"),
            independent_generalization_score=0,
            accounting={
                k: value.get(k) if row["producer_qualified"] else None
                for k in [
                    "intended_count",
                    "completed_count",
                    "failed_count",
                    "censored_count",
                    "excluded_count",
                    "independent_count",
                ]
            },
            raw_rows=value.get("rows", []) if row["producer_qualified"] else [],
            natural_model_headline_admitted=False,
            metrics={k: value.get(k) if row["producer_qualified"] else None for k in fields},
            field_provenance={k: dict(row["primary_reference"], field=k) for k in fields},
        )
    # Missing comparisons stay missing even when all scheduling slots are accounted for.
    verdict = (
        "disqualified"
        if not checked
        else "blocked"
        if any(not b["measured"] for b in branches.values())
        else "null"
    )
    self_row = dict(
        task_id=c.TASK,
        experiment_id=8788,
        unit_id=c.TASK,
        arm="scheduled_task",
        status="completed",
        absolute_metric=int(checked),
