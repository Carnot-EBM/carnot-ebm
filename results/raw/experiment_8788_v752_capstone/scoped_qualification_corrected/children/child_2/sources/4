def test_typed_gates_and_ambiguous_primary(tmp_path):
    """REQ-REPORT-8788: a Boolean is not an integer receipt; duplicate primaries lose custody."""
    path = tmp_path / "typed.json"
    c.atomic_json(path, dict(ready=True))
    assert not c.observe(c.reference(path), "exp1-x", "ready", 1)["passed"]
    root = fixture_root(tmp_path / "fixture")
    task = c.contract(root)["tasks"][1]
    shutil.copyfile(root / task["deliverable"], root / "results/experiment_8777_duplicate.json")
    row = c.slot(task, root)
    assert "ambiguous_primary" in row["authentication_errors"]
    assert not row["producer_qualified"]
    work = c.freeze(root, tmp_path / "raw_rejected", "20261104")
    work["publication_gates"] = dict(gates={}, paper_ready=False, unmet_gates=["G1"])
    validation = dict(
        receipts=[dict(passed=True)],
        coverage=dict(complete=True),
        union=dict(passed=True),
        ended_at_utc=c.now(),
    )
    c.atomic_json(Path(work["raw"]) / "validation.json", validation)
    value = c.build(work, validation, tmp_path / (c.NAME + ".json"))
    assert any(g["observed"] == "rejected_producer" for g in value["gate_check_summary"])
    edge = next(
        g
        for g in value["gate_edge_rows"]
        if g.get("consumer_task_id") == "exp8779-evidence-set-evaluation"
    )
    assert edge["observed"] == 1 and not edge["passed"]
