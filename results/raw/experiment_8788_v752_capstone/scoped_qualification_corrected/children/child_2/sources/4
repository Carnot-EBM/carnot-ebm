def fixture_root(root):
    """REQ-REPORT-8788: build synthetic operands wholly in private scratch."""
    for name in [c.DESIGN, "research-roadmap.yaml"]:
        target = root / name
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(c.ROOT / name, target)
    tasks = c.contract(root)["tasks"]
    for i in [0, 1, 3, 7, 8, 11]:
        task = tasks[i]
        path = root / task["deliverable"]
        raw = path.parent / "raw" / path.stem
        c.atomic_json(raw / "primitive.json", dict(fixture=True))
        receipts = [dict(passed=i != 0)]
        c.atomic_json(raw / "validation.json", dict(receipts=receipts))
        verdict = (
            "disqualified"
            if i == 0
            else "null"
            if i == 8
            else "blocked"
            if i == 11
            else "circular_positive"
        )
        value = dict(
            task_id=task["id"],
            experiment_id=8776 + i,
            honest_verdict="complete_" + verdict + "_fixture",
            verdict_class=verdict,
            required_checks_passed=i != 0,
            flagged_adversarial=False,
            primitive_reference=c.reference(raw / "primitive.json"),
            validation_reference=c.reference(raw / "validation.json"),
            validation_receipts=receipts,
            independent_count=120 if i == 3 else 0,
            verifier_is_oracle=True,
            exposure_scope="constructed private fixture",
            memory_protocol_ready_score=0,
            runtime_repair_ready_score=0,
            arc_new_outcomes_available_score=0,
            evidence_methods_ready_score=1,
            durable_producer_ready_score=1,
        )
        c.atomic_json(path, value)
        ref = c.reference(path)
        c.atomic_json(
            raw / "validators" / (ref["sha256"][7:] + ".json"),
            dict(
                primary_path=str(path.absolute()),
                primary_sha256=ref["sha256"],
                report=dict(passed=True),
            ),
        )
    receipt_path = root / "results/experiment_8778_delayed_memory_prototype.json"
    upstream = root / tasks[0]["deliverable"]
    c.atomic_json(
        receipt_path,
        dict(
            blocked_at_layer="conductor_pre_gate",
            gates_evaluated=[
                dict(
                    upstream=tasks[0]["id"],
                    artifact_path=str(upstream),
                    artifact_sha256=c.reference(upstream)["sha256"],
                    artifact_field="memory_protocol_ready_score",
                    expected=1,
                    actual=0,
                    passed=False,
                )
            ],
        ),
    )
    return root


def cli(*args):
    """SCENARIO-VERIFY-8788-REPLAY: exercise the actual script from outside the checkout."""
    env = dict(os.environ)
    env.pop("PYTHONPATH", None)
    return subprocess.run(
        [sys.executable, "-u", str(c.ROOT / c.CLI), *map(str, args)],
        cwd="/var/tmp",
        env=env,
        capture_output=True,
        text=True,
        timeout=90,
    )


def test_operand_states(tmp_path):
    """SCENARIO-REPORT-8788-ACCOUNTING: absence, zero and identity differ."""
    path = tmp_path / "source.json"
    assert c.observe(c.reference(path), "exp1-x", "ready", 1)["operand_state"] == "missing_file"
    c.atomic_json(path, {"ready": 0})
    ref = c.reference(path)
    assert c.observe(ref, "exp1-x", "ready", 1)["observed"] == 0
    assert c.observe(ref, "exp1-x", "absent", 1)["operand_state"] == "missing_field"
    path.write_text("{}")
    with pytest.raises(ValueError):
        c.load(ref)


def test_rows_and_replay(tmp_path):
    """SCENARIO-VERIFY-8788-REPLAY: private evidence cannot fabricate producer verdicts."""
    root = fixture_root(tmp_path / "fixture")
    raw = tmp_path / "raw"
    work = c.freeze(root, raw, "20261104")
    work["publication_gates"] = dict(
        gates={g: dict(pass_=True) for g in []},
        paper_ready=False,
        unmet_gates=["G1", "G2", "G3", "G4"],
    )
    validation = dict(
        receipts=[dict(passed=True)],
        coverage=dict(complete=True),
        union=dict(passed=True),
        ended_at_utc=c.now(),
    )
    c.atomic_json(raw / "validation.json", validation)
    value = c.build(work, validation, tmp_path / (c.NAME + ".json"))
    assert value["intended_count"] == len(value["rows"]) == 13
    assert value["rows"][2]["honest_verdict"] is None
    assert value["rows"][2]["scheduler_outcome"] == "conductor_pre_gate"
    assert value["verdict_class"] == "blocked"
    assert value["MODEL_SPECS"] == []
    assert value["independent_generalization_score"] == 0
    assert len(value["retirement_recommendations"]) == sum(
        len(t["prior_failures"]) for t in work["tasks"]
    )
    failed = c.build(
        work, dict(validation, receipts=[dict(passed=False)]), tmp_path / (c.NAME + ".json")
    )
    assert failed["verdict_class"] == "disqualified"
    assert failed["reconciliation_ready_score"] == 0
    changed = deepcopy(value)
    changed["full_task_objects"][0]["title"] = "forged"
    assert changed["full_task_objects"] != work["tasks"]


