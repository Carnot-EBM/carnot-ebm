def test_validation_and_production_path(tmp_path, monkeypatch):
    """REQ-VERIFY-8788: real bounded validation plumbing and production orchestration execute."""
    from carnot.reporting import v752_capstone_runner as runner

    suite = tmp_path / "test_small.py"
    suite.write_text(
        '"""REQ-VERIFY-8788: private validation plumbing."""\n\nfrom pathlib import Path\n\n\ndef test_ok(tmp_path: Path) -> None:\n    (tmp_path / "original-family-proof.txt").write_text("private evidence")\n    assert True\n'
    )
    raw = tmp_path / "validation"
    raw.mkdir()
    with monkeypatch.context() as patch:
        patch.setattr(c, "TESTS", [suite.name])
        patch.setattr(c, "ROOT", tmp_path)
        patch.setattr(c, "CONSUMERS", [])
        patch.setattr(c, "OWNED", [str(suite)])
        real_validation_child = runner.child

        def fixture_child(name, argv, logs, **limits):
            argv = [
                str(suite) + arg[len(suite.name) :] if arg.startswith(suite.name) else arg
                for arg in argv
            ]
            return real_validation_child(name, argv, logs, **limits)

        patch.setattr(runner, "child", fixture_child)
        validation = runner.validate(raw)
    assert validation["union"]["passed"]
    assert validation["coverage"]["complete"]
    assert all(r["passed"] for r in validation["receipts"])
    root = fixture_root(tmp_path / "fixture")
    output = tmp_path / "production_path" / (c.NAME + ".json")
    real_child = runner.child

    def bounded_health(name, argv, logs, **limits):
        if name == "full_python_suite":
            return real_child(
                name,
                [sys.executable, "-c", 'print("private repository health fixture")'],
                logs,
                **limits,
            )
        return real_child(name, argv, logs, **limits)

    monkeypatch.setattr(runner, "child", bounded_health)
    monkeypatch.setattr(runner, "validate", lambda raw: validation)
    assert runner.main(["--root", str(root), "--output", str(output)]) == 0
    assert c.replay(output)
    value = json.loads(output.read_bytes())
    assert value["verdict_class"] == "blocked"
    assert value["reconciliation_ready_score"] == 1


def test_raw_receipt_and_history_branches(tmp_path):
    """REQ-REPORT-8788: raw substitutions, owned receipt drift and prior identities stay explicit."""
    root = fixture_root(tmp_path / "fixture")
    tasks = c.contract(root)["tasks"]
    path = root / tasks[1]["deliverable"]
    value = c.load(c.reference(path))

    def replace_primary(updated):
        c.atomic_json(path, updated)
        side = (
            path.parent
            / "raw"
            / path.stem
            / "validators"
            / (c.reference(path)["sha256"][7:] + ".json")
        )
        c.atomic_json(
            side,
            dict(
                primary_path=str(path.absolute()),
                primary_sha256=c.reference(path)["sha256"],
                report=dict(passed=True),
            ),
        )

    operand = tmp_path / "operand.json"
    c.atomic_json(operand, dict(fixture=True))
    replace_primary(dict(value, raw_shard_hashes=[c.reference(operand)]))
    assert c.authenticate(path, tasks[1]["id"])
    replace_primary(dict(value, raw_shard_hashes=[dict(path=str(operand), sha256="sha256:forged")]))
    with pytest.raises(ValueError, match="producer_raw_shard_drift"):
        c.authenticate(path, tasks[1]["id"])
    validation_path = Path(value["validation_reference"]["path"])
    c.atomic_json(validation_path, dict(receipts=[]))
    replace_primary(dict(value, validation_reference=c.reference(validation_path)))
    with pytest.raises(ValueError, match="producer_validation_drift"):
        c.authenticate(path, tasks[1]["id"])
    receipts = [dict(passed=False)]
    c.atomic_json(validation_path, dict(receipts=receipts))
    replace_primary(
        dict(value, validation_reference=c.reference(validation_path), validation_receipts=receipts)
    )
    with pytest.raises(ValueError, match="producer_owned_validation_failure"):
        c.authenticate(path, tasks[1]["id"])
    historical = root / "results/experiment_8775_historical.json"
    c.atomic_json(
        historical,
        dict(
            task_id="exp8775-capstone",
            honest_verdict="complete_disqualified_v751_capstone",
            verdict_class="disqualified",
            historical_quarantines=["private quarantine"],
        ),
    )
    log = root / "ops/conductor-log.md"
    log.parent.mkdir(parents=True)
    log.write_text("| date | " + tasks[4]["title"][:48] + " | GATE_BLOCK | upstream retired |\n")
    work = c.freeze(root, tmp_path / "raw", "20261104")
    assert work["historical"]["historical_quarantines"] == ["private quarantine"]
    assert work["slots"][4]["scheduler_outcome"] == "conductor_cascade_skip"
    assert any(p["exact_identity_matches"] for p in work["prior_outcomes"])


