def test_cli_replay_and_attacks(private, tmp_path):
    """SCENARIO-VERIFY-8788-REPLAY: hashes alone cannot repair invented aggregates."""
    root, output, value = private
    assert cli("--cold-replay", output).returncode == 0
    for field in ["rows", "receipts", "authority", "primitive", "missing", "source", "contract"]:
        changed = deepcopy(value)
        if field == "rows":
            changed["rows"][0]["producer_qualified"] = True
        elif field == "receipts":
            changed["validation_receipts"][0]["passed"] = False
        elif field == "authority":
            changed["full_task_objects"][0]["prompt"] += "forged"
        elif field in ["primitive", "missing"]:
            target = tmp_path / "forged_work.json"
            if field == "primitive":
                c.atomic_json(target, dict(c.load(value["primitive_reference"]), run_date="forged"))
            changed["primitive_reference"] = c.reference(target)
        else:
            work = c.load(value["primitive_reference"])
            if field == "source":
                work["references"].append(
                    dict(path=str(tmp_path / "absent"), sha256="sha256:forged")
                )
            else:
                work["tasks"] = []
            target = tmp_path / ("work_" + field + ".json")
            c.atomic_json(target, work)
            changed["primitive_reference"] = c.reference(target)
            raw = Path(work["raw"])
            original = (raw / "independent_seal.json").read_bytes()
            c.atomic_json(
                raw / "independent_seal.json",
                dict(
                    primitive_reference=changed["primitive_reference"],
                    validation_reference=changed["validation_reference"],
                ),
            )
        changed["reproducibility_checksum"] = c.digest(changed)
        candidate = tmp_path / "candidate.json"
        c.atomic_json(candidate, changed)
        assert not c.replay(candidate), field
        if field in ["source", "contract"]:
            (raw / "independent_seal.json").write_bytes(original)
    failed = tmp_path / "failed" / (c.NAME + ".json")
    result = cli("--root", root, "--output", failed, "--private-control", "--failed-child")
    assert result.returncode == 1, result.stdout + result.stderr
    assert json.loads(failed.read_bytes())["validation_receipts"][0]["actual_exit"] == 1
    assert cli("--private-control").returncode == 2
    assert cli("--date", "123").returncode == 2
    assert cli("--cold-replay", tmp_path / "missing.json").returncode == 1


def test_authentication_and_contract(tmp_path):
