4.29.915.455 D srv  log_server_r: request:  {"content": "Former Australia cricket captain and legendary broadcaster Richie Benaud has died at the age of 84. ", "add_special": true}
4.29.915.456 D srv  log_server_r: response: {"tokens":[29834,8071,34806,23167,321,26814,57861,95549,417,6933,643,682,8209,506,279,4092,314,220,23,19,13,220]}
4.29.915.905 D srv          stop: all tasks already finished, no need to cancel
4.29.915.911 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
4.29.915.912 D srv  log_server_r: request:  {"content": "Benaud, whose witty one-liners from the commentary box resonated far beyond Australia's shores, said last year he was being treated for skin cancer. ", "add_special": true}
4.29.915.912 D srv  log_server_r: response: {"tokens":[33,6933,643,11,6483,79784,799,2759,38384,494,279,29611,3618,27264,639,2944,7551,8071,579,60068,11,1018,1483,1007,551,557,1602,11421,364,6574,9108,13,220]}
4.29.916.445 D srv          stop: all tasks already finished, no need to cancel
4.29.916.448 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
4.29.916.449 D srv  log_server_r: request:  {"content": "\"After Don Bradman, there has been no Australian player more famous than Richie Benaud,\" Cricket Australia said on its website. ", "add_special": true}
4.29.916.449 D srv  log_server_r: response: {"tokens":[95018,4179,16541,1461,11,1017,682,978,874,12982,2693,777,10919,1056,95549,417,6933,643,1288,55975,8071,1018,383,1141,3779,13,220]}
4.29.917.314 D srv          stop: all tasks already finished, no need to cancel
4.29.917.322 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
4.29.917.324 D srv  log_server_r: request:  {"content": "\"Benaud stood at the top of the game throughout his rich life, first as a record-breaking leg-spinner and captain, and then as cricket's most famous -- and most impersonated -- broadcaster.\" A veteran of 64 Test matches, Benaud was inducted into the Sport Australia Hall of Fame in 1985. ", "add_special": true}
4.29.917.324 D srv  log_server_r: response: {"tokens":[61442,6933,643,14217,506,279,1844,314,279,1746,6600,780,8807,2199,11,1118,430,264,3150,52483,2392,67736,321,23167,11,321,1179,430,34806,579,1379,10919,1137,321,1379,57732,639,1137,57861,1149,357,20186,314,220,21,19,3284,8798,11,417,6933,643,557,303,52108,1083,279,17666,8071,10607,314,37247,303,220,16,24,23,20,13,220]}
4.29.917.728 D srv          stop: all tasks already finished, no need to cancel
4.29.917.730 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
4.29.917.730 D srv  log_server_r: request:  {"content": "While many regarded his voice as the soundtrack to an Australian summer, Benaud was equally revered by the cricketing public on the other side of the world where he spent more than four decades with the BBC taking the game into millions of British living rooms. ", "add_special": true}
4.29.917.730 D srv  log_server_r: response: {"tokens":[7732,1599,25519,780,7497,430,279,43405,310,449,12982,7094,11,417,6933,643,557,17763,81739,539,279,34806,286,569,383,279,975,3008,314,279,1814,1332,551,7157,777,1056,2943,10476,440,279,17557,4483,279,1746,1083,11391,314,7607,5214,11683,13,220]}
4.29.918.129 D srv          stop: all tasks already finished, no need to cancel
4.29.918.137 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
4.29.918.139 D srv  log_server_r: request:  {"content": "But whether you were sitting in Sydney or in South London, there were plenty of \"marvelous\" Richie moments from the box to savor:. ", "add_special": true}
4.29.918.139 D srv  log_server_r: response: {"tokens":[3850,3315,488,998,11362,303,20620,466,303,4725,6924,11,1017,998,10933,314,328,5437,861,757,1,95549,13543,494,279,3618,310,274,3185,16478,220]}
