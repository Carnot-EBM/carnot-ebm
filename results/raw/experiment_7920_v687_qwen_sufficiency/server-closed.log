0.46.766.435 D srv  log_server_r: response: {"tokens":[6651,4035,1562,424,264,328,13458,3039,1149,24235,3125,19166,421,1017,998,244965,1313,440,41324,778,364,1602,328,19237,88,1,321,364,1608,2321,12,19237,10654,13,220]}
0.46.766.600 D srv          stop: all tasks already finished, no need to cancel
0.46.766.602 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.766.602 D srv  log_server_r: request:  {"content": "That some judged who could come in based on the sluttiness of a woman's outfit. ", "add_special": true}
0.46.766.602 D srv  log_server_r: response: {"tokens":[4639,1010,42912,852,1362,2445,303,3018,383,279,1678,20192,1815,314,264,5054,579,26421,13,220]}
0.46.766.797 D srv          stop: all tasks already finished, no need to cancel
0.46.766.800 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.766.800 D srv  log_server_r: request:  {"content": "And if a woman did report her rape, some women complained that the internal process didn't seem worth it if their abuser wouldn't be kicked out of school. ", "add_special": true}
0.46.766.800 D srv  log_server_r: response: {"tokens":[2939,413,264,5054,1467,1830,1024,16289,11,1010,3096,32845,421,279,5138,1817,3105,914,2714,5621,424,413,836,650,846,8012,914,381,26248,680,314,2812,13,220]}
0.46.768.418 D srv          stop: all tasks already finished, no need to cancel
0.46.768.444 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.768.448 D srv  log_server_r: request:  {"content": "Rolling Stone had a line in its original story: \"UVA's emphasis on honor is so pronounced that since 1998, 183 people have been expelled for honor-code violations such as cheating on exams. ", "add_special": true}
0.46.768.448 D srv  log_server_r: response: {"tokens":[31287,286,13892,995,264,1500,303,1141,3889,3255,25,328,52,12452,579,23877,383,15210,369,748,36274,421,2394,220,16,24,24,23,11,220,16,23,18,1208,599,978,63995,364,15210,24459,25709,1680,430,40345,383,38371,13,220]}
0.46.769.593 D srv          stop: all tasks already finished, no need to cancel
0.46.769.595 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.769.596 D srv  log_server_r: request:  {"content": "And yet paradoxically, not a single student at UVA has ever been expelled for sexual assault.\" After the article published, UVA admitted this and instituted a zero-tolerance policy on sexual assault going forward -- although that policy was never defined, so it's unclear what it means. ", "add_special": true}
0.46.769.596 D srv  log_server_r: response: {"tokens":[2939,3482,49491,2586,11,524,264,3074,5286,506,533,12452,682,3397,978,63995,364,7017,11366,1149,4486,279,4400,4501,11,533,12452,15711,411,321,77242,264,6942,2308,30622,4687,383,7017,11366,2019,4487,1137,7643,421,4687,557,2496,4364,11,748,424,579,23644,1092,424,3254,13,220]}
0.46.769.981 D srv          stop: all tasks already finished, no need to cancel
0.46.769.990 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.769.993 D srv  log_server_r: request:  {"content": "When the story was deleted from Rolling Stone's website, that was lost. ", "add_special": true}
0.46.769.993 D srv  log_server_r: response: {"tokens":[4350,279,3255,557,10739,494,43451,13892,579,3779,11,421,557,5384,13,220]}
0.46.770.623 D srv          stop: all tasks already finished, no need to cancel
0.46.770.626 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.770.626 D srv  log_server_r: request:  {"content": "\"You lose a lot of other people's voices who were in that article,\" said Sarah Roderick, a survivor and UVA student, \"and a lot of good things that could have come about. ", "add_special": true}
0.46.770.626 D srv  log_server_r: response: {"tokens":[20946,8779,264,2609,314,975,1208,579,22589,852,998,303,421,4400,1288,1018,19822,423,4175,839,11,264,47026,321,533,12452,5286,11,328,429,264,2609,314,1603,2433,421,1362,599,2445,883,13,220]}
0.46.771.057 D srv          stop: all tasks already finished, no need to cancel
0.46.771.066 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.771.067 D srv  log_server_r: request:  {"content": "Fixing problems with administration here and on our campus\" -- and, she added, across the nationo. ", "add_special": true}
0.46.771.068 D srv  log_server_r: response: {"tokens":[25128,286,5154,440,8305,1532,321,383,1004,14873,1,1137,321,11,1292,3568,11,3808,279,6777,78,13,220]}
0.46.771.411 D srv          stop: all tasks already finished, no need to cancel
0.46.771.422 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.771.424 D srv  log_server_r: request:  {"content": "Along with the O'Melveny & Myers investigation, there's also an open Title IX investigation into UVA by the U.S. ", "add_special": true}
0.46.771.424 D srv  log_server_r: response: {"tokens":[48134,440,279,496,26708,300,1002,88,594,48536,8548,11,1017,579,1048,449,1724,10552,38397,8548,1083,533,12452,539,279,533,782,13,220]}
0.46.771.598 D srv          stop: all tasks already finished, no need to cancel
0.46.771.601 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.771.601 D srv  log_server_r: request:  {"content": "Department of Education as a result of a civil suit. ", "add_special": true}
0.46.771.602 D srv  log_server_r: response: {"tokens":[25775,314,11332,430,264,1067,314,264,8009,7535,13,220]}
0.46.771.838 D srv          stop: all tasks already finished, no need to cancel
0.46.771.841 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.771.842 D srv  log_server_r: request:  {"content": "The attorney who filed the suit, James Marsh, told CNN that UVA medical staff lost or destroyed evidence from the alleged sexual assault victim he's representing, making it impossible for her to move forward and get justice. ", "add_special": true}
0.46.771.842 D srv  log_server_r: response: {"tokens":[760,13352,852,12364,279,7535,11,7555,37770,11,3125,19166,421,533,12452,6255,5395,5384,466,14012,5721,494,279,10178,7017,11366,11397,551,579,13661,11,3154,424,11656,364,1024,310,3166,4487,321,615,11813,13,220]}
0.46.772.626 D srv          stop: all tasks already finished, no need to cancel
0.46.772.637 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.772.643 D srv  log_server_r: request:  {"content": "When the Columbia Journalism School's 12,000-plus-word critique is summed up, it really boils down to this: The mistake could have been avoided if the writer, Sabrina Rubin Erdely, had picked up the phone and made just a few more phone calls to the friends of Jackie who she claimed were with her that night. ", "add_special": true}
0.46.772.647 D srv  log_server_r: response: {"tokens":[4350,279,18229,66234,5833,579,220,16,17,11,15,15,15,22221,36093,41151,369,63452,685,11,424,2098,85895,1441,310,411,25,561,16036,1362,599,978,29784,413,279,6700,11,239032,79100,43211,943,11,995,12405,685,279,4392,321,1801,1066,264,2342,777,4392,6526,310,279,4627,314,49154,852,1292,11324,998,440,1024,421,3603,13,220]}
0.46.773.523 D srv          stop: all tasks already finished, no need to cancel
0.46.773.525 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.773.525 D srv  log_server_r: request:  {"content": "They'd later tell other media outlets, including CNN, that they remembered a very different story. ", "add_special": true}
0.46.773.526 D srv  log_server_r: response: {"tokens":[6651,4035,2843,3184,975,3561,26216,11,2583,19166,11,421,781,25624,264,1546,2086,3255,13,220]}
0.46.773.853 D srv          stop: all tasks already finished, no need to cancel
0.46.773.861 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.773.863 D srv  log_server_r: request:  {"content": "Rolling Stone says their account would have been a red flag. ", "add_special": true}
0.46.773.864 D srv  log_server_r: response: {"tokens":[31287,286,13892,2640,836,2605,1000,599,978,264,2438,5016,13,220]}
0.46.774.313 D srv          stop: all tasks already finished, no need to cancel
0.46.774.316 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.774.316 D srv  log_server_r: request:  {"content": "And all three say they would have talked if they'd been called. ", "add_special": true}
0.46.774.317 D srv  log_server_r: response: {"tokens":[2939,660,2250,1910,781,1000,599,14466,413,781,4035,978,2512,13,220]}
0.46.774.849 D srv          stop: all tasks already finished, no need to cancel
0.46.774.858 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.774.861 D srv  log_server_r: request:  {"content": "Ryan Duffin, one of the trio, said he felt deceived by Jackie, but he also pointed out that Erdely's mistake in fact-checking was about one single incident, and the fallout has caused a much bigger issue to be lost. ", "add_special": true}
0.46.774.862 D srv  log_server_r: response: {"tokens":[46832,414,1314,258,11,799,314,279,32837,11,1018,551,6273,94410,539,49154,11,694,551,1048,13874,680,421,43211,943,579,16036,303,2029,15464,286,557,883,799,3074,10142,11,321,279,61985,682,8613,264,1691,10917,4125,310,381,5384,13,220]}
0.46.775.161 D srv          stop: all tasks already finished, no need to cancel
0.46.775.169 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.775.170 D srv  log_server_r: request:  {"content": "\"Had she gotten in direct contact with us, it probably wouldn't have been printed, at least in that way,\" he said. ", "add_special": true}
0.46.775.171 D srv  log_server_r: response: {"tokens":[44022,327,1292,16521,303,2050,3522,440,586,11,424,4507,8012,914,599,978,16218,11,506,3140,303,421,1560,1288,551,1018,13,220]}
0.46.775.382 D srv          stop: all tasks already finished, no need to cancel
0.46.775.384 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.775.384 D srv  log_server_r: request:  {"content": "\"A lot of the article was still based in truth, but the focal point would have been different.\" It might have been less dramatic, but it would have probably focused on some of the other UVA students who shared much more common stories of acquaintance rape on campus. ", "add_special": true}
0.46.775.385 D srv  log_server_r: response: {"tokens":[28180,2609,314,279,4400,557,1990,3018,303,7793,11,694,279,39742,1406,1000,599,978,2086,1149,1049,2493,599,978,2599,21100,11,694,424,1000,599,4507,10419,383,1010,314,279,975,533,12452,4007,852,5904,1691,777,4047,7112,314,78504,16289,383,14873,13,220]}
0.46.775.537 D srv          stop: all tasks already finished, no need to cancel
0.46.775.539 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.775.539 D srv  log_server_r: request:  {"content": "\"I think my problem with it was that this reporter wanted to sensationalize an experience that's not very common,\" Roderick said. ", "add_special": true}
0.46.775.540 D srv  log_server_r: response: {"tokens":[6825,1683,821,3377,440,424,557,421,411,18387,4674,310,65128,537,449,3039,421,579,524,1546,4047,1288,423,4175,839,1018,13,220]}
