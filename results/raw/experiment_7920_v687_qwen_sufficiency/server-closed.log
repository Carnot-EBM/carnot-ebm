2.04.978.824 D srv  log_server_r: request:  {"content": "Frank Jordan addressed the skepticism about his son's appearance, saying the boat stayed afloat and upright most of the time. ", "add_special": true}
2.04.978.824 D srv  log_server_r: response: {"tokens":[36091,16586,19457,279,63901,883,780,4292,579,10771,11,5315,279,14882,19013,264,3524,321,46966,1379,314,279,854,13,220]}
