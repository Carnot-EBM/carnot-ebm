2.04.978.356 D srv  log_server_r: request:  {"content": "CNN affiliate WAVY in Norfolk, Virginia, reported that he was able to walk from the helicopter into Sentara Norfolk General Hospital about 7:30 p.m. ", "add_special": true}
2.04.978.357 D srv  log_server_r: response: {"tokens":[53593,20935,85288,56,303,56708,11,12617,11,4800,421,551,557,2858,310,4088,494,279,33866,1083,22636,4897,56708,3146,14639,883,220,22,25,18,15,280,721,13,220]}
