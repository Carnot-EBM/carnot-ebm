2.04.980.210 D srv  log_server_r: request:  {"content": "\"And he told me on the phone that he was praying the whole time, so I believe that sustained him a great deal.\" Rescue swimmer Kyle McCollum was the first to care for Jordan on the flight back to land. ", "add_special": true}
2.04.980.210 D srv  log_server_r: response: {"tokens":[44385,551,3125,728,383,279,4392,421,551,557,49411,279,4220,854,11,748,353,4267,421,27723,1384,264,2172,3372,1149,42927,15714,1134,29272,13841,935,367,557,279,1118,310,2373,364,16586,383,279,10650,1142,310,4128,13,220]}
