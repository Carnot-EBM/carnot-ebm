0.46.775.635 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.775.635 D srv  log_server_r: request:  {"content": "\"... ", "add_special": true}
0.46.775.635 D srv  log_server_r: response: {"tokens":[50799,220]}
0.46.775.804 D srv          stop: all tasks already finished, no need to cancel
0.46.775.807 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.775.808 D srv  log_server_r: request:  {"content": "And I wonder if it would have been different if (it dealt) with someone with a less horrific story -- something that happens to more people. ", "add_special": true}
0.46.775.808 D srv  log_server_r: response: {"tokens":[2939,353,5596,413,424,1000,599,978,2086,413,318,275,25104,8,440,4184,440,264,2599,44680,3255,1137,2414,421,8311,310,777,1208,13,220]}
0.46.775.926 D srv          stop: all tasks already finished, no need to cancel
0.46.775.928 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.775.928 D srv  log_server_r: request:  {"content": "I think this discredits what a lot of survivors go through. ", "add_special": true}
0.46.775.928 D srv  log_server_r: response: {"tokens":[40,1683,411,801,53899,1092,264,2609,314,30557,708,1472,13,220]}
0.46.776.075 D srv          stop: all tasks already finished, no need to cancel
0.46.776.078 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.776.079 D srv  log_server_r: request:  {"content": "Something this physically horrific is not what everyone goes through. ", "add_special": true}
0.46.776.079 D srv  log_server_r: response: {"tokens":[22367,411,21219,44680,369,524,1092,4858,5601,1472,13,220]}
0.46.776.382 D srv          stop: all tasks already finished, no need to cancel
0.46.776.384 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.776.385 D srv  log_server_r: request:  {"content": "Now it's like, 'If I wasn't assaulted by more than one man then my story is not as worthy of attention.' It's frustrating that this is how rape is portrayed on college campuses because this is not the norm.\" Before the report came out, Abraham Axler, the student body president, said that some good had come from the article because it forced UVA to institute new policies and to open up a conversation on a topic that needed to be discussed nationwide. ", "add_special": true}
0.46.776.386 D srv  log_server_r: response: {"tokens":[6820,424,579,1040,11,359,2592,353,5532,914,44054,539,777,1056,799,855,1179,821,3255,369,524,430,26408,314,6326,3058,1049,579,33466,421,411,369,1204,16289,369,43288,383,7524,50162,1521,411,369,524,279,7230,1149,12851,279,1830,3571,680,11,35185,24372,1482,11,279,5286,2407,4614,11,1018,421,1010,1603,995,2445,494,279,4400,1521,424,9290,533,12452,310,42251,491,9883,321,310,1724,685,264,10125,383,264,8282,421,4221,310,381,13675,27048,13,220]}
0.46.776.527 D srv          stop: all tasks already finished, no need to cancel
0.46.776.529 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.776.529 D srv  log_server_r: request:  {"content": "But some survivors and advocates are afraid the retraction set back their progress. ", "add_special": true}
0.46.776.529 D srv  log_server_r: response: {"tokens":[3850,1010,30557,321,26440,513,16087,279,311,25580,716,1142,836,4936,13,220]}
0.46.776.646 D srv          stop: all tasks already finished, no need to cancel
0.46.776.647 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.776.648 D srv  log_server_r: request:  {"content": "\"I do feel like there's a possibility people will be afraid to come forward. ", "add_special": true}
0.46.776.648 D srv  log_server_r: response: {"tokens":[6825,635,2579,1040,1017,579,264,12665,1208,668,381,16087,310,2445,4487,13,220]}
0.46.777.810 D srv          stop: all tasks already finished, no need to cancel
0.46.777.846 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.777.851 D srv  log_server_r: request:  {"content": "If you come forward and share your story, if you don't have the date right, every detail down, you'll think, 'I'm going to be accused of being a liar. ", "add_special": true}
0.46.777.852 D srv  log_server_r: response: {"tokens":[2592,488,2445,4487,321,4191,678,3255,11,413,488,1459,914,599,279,2321,1245,11,1396,7472,1441,11,488,3172,1683,11,359,40,2688,2019,310,381,12803,314,1602,264,70158,13,220]}
0.46.778.951 D srv          stop: all tasks already finished, no need to cancel
0.46.778.954 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.778.954 D srv  log_server_r: request:  {"content": "It's easier for me to keep it to myself,'\" Roderick said. ", "add_special": true}
0.46.778.954 D srv  log_server_r: response: {"tokens":[2064,579,8397,364,728,310,2426,424,310,6818,47247,423,4175,839,1018,13,220]}
0.46.779.495 D srv          stop: all tasks already finished, no need to cancel
0.46.779.502 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.779.505 D srv  log_server_r: request:  {"content": "\"There are very serious and unresolved questions about the university's performance,\" said Steve Coll, dean of the Columbia School of Journalism. ", "add_special": true}
0.46.779.505 D srv  log_server_r: response: {"tokens":[24104,513,1546,5812,321,77397,4602,883,279,11759,579,4906,1288,1018,13413,12535,11,70387,314,279,18229,5833,314,66234,13,220]}
0.46.779.974 D srv          stop: all tasks already finished, no need to cancel
0.46.779.978 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
0.46.779.978 D srv  log_server_r: request:  {"content": "\"Rolling Stone teed that subject up. ", "add_special": true}
0.46.779.978 D srv  log_server_r: response: {"tokens":[1,31287,286,13892,979,290,421,3704,685,13,220]}
0.46.780.289 D srv          stop: all tasks already finished, no need to cancel
