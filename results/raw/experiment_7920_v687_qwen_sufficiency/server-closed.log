2.04.980.020 D srv  log_server_r: request:  {"content": "\"He's got a very strong constitution and (is strong) not only physically, but spiritually,\" Frank Jordan said. ", "add_special": true}
2.04.980.020 D srv  log_server_r: response: {"tokens":[25485,579,2597,264,1546,3619,15926,321,318,284,3619,8,524,1132,21219,11,694,84726,1288,8995,16586,1018,13,220]}
