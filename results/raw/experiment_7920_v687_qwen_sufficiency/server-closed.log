3.42.546.267 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
3.42.546.267 D srv  log_server_r: request:  {"content": "Sanjay Gupta. ", "add_special": true}
3.42.546.267 D srv  log_server_r: response: {"tokens":[22987,67665,71193,13,220]}
3.42.546.482 D srv          stop: all tasks already finished, no need to cancel
3.42.546.484 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
3.42.546.485 D srv  log_server_r: request:  {"content": "\"I remember when I first went to college in Los Angeles in 1979, the air was so bad that you couldn't go running outside,\" Obama said. ", "add_special": true}
3.42.546.485 D srv  log_server_r: response: {"tokens":[6825,5909,948,353,1118,3804,310,7524,303,9368,11563,303,220,16,24,22,24,11,279,3594,557,748,3743,421,488,7448,914,708,4162,4732,1288,6884,1018,13,220]}
3.42.546.689 D srv          stop: all tasks already finished, no need to cancel
3.42.546.694 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
3.42.546.694 D srv  log_server_r: request:  {"content": "\"You'd have air quality alerts, and people who had respiratory problems or were vulnerable had to stay inside. ", "add_special": true}
3.42.546.695 D srv  log_server_r: response: {"tokens":[20946,4035,599,3594,4131,28293,11,321,1208,852,995,40157,5154,466,998,18966,995,310,4565,4613,13,220]}
3.42.546.912 D srv          stop: all tasks already finished, no need to cancel
3.42.546.914 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
3.42.546.914 D srv  log_server_r: request:  {"content": "We took action, and the air's a lot better.\" \"There are a whole host of public health impacts that are going to hit home, so we've got to do better in protecting vulnerable Americans,\" Obama continued. ", "add_special": true}
3.42.546.914 D srv  log_server_r: response: {"tokens":[1596,3738,1852,11,321,279,3594,579,264,2609,2577,1149,328,3733,513,264,4220,3357,314,569,2730,24115,421,513,2019,310,4062,2046,11,748,567,2908,2597,310,635,2577,303,21496,18966,8609,1288,6884,8308,13,220]}
3.42.547.303 D srv          stop: all tasks already finished, no need to cancel
3.42.547.305 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
3.42.547.305 D srv  log_server_r: request:  {"content": "\"Ultimately, though, all of our families are going to be vulnerable. ", "add_special": true}
3.42.547.308 D srv  log_server_r: response: {"tokens":[1,64007,11,3384,11,660,314,1004,8259,513,2019,310,381,18966,13,220]}
3.42.547.548 D srv          stop: all tasks already finished, no need to cancel
3.42.547.550 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
3.42.547.551 D srv  log_server_r: request:  {"content": "You can't cordon yourself off from air or climate.\" Murthy revealed to the group that asthma is a personal issue for him, as a favorite uncle died from a severe attack when he was younger. ", "add_special": true}
3.42.547.551 D srv  log_server_r: response: {"tokens":[2523,628,914,272,20850,5941,974,494,3594,466,9682,1149,14571,25577,10144,310,279,1809,421,48840,369,264,4204,4125,364,1384,11,430,264,6714,36252,8209,494,264,14938,3250,948,551,557,14229,13,220]}
3.42.547.819 D srv          stop: all tasks already finished, no need to cancel
3.42.547.824 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
3.42.547.825 D srv  log_server_r: request:  {"content": "\"It's also personal to me because I've cared for many patients over the years who have suffered from asthma and have seen firsthand how frightening it can be to suddenly be wheezing and fighting for every breath,\" Murthy said.  ", "add_special": true}
3.42.547.825 D srv  log_server_r: response: {"tokens":[11734,579,1048,4204,310,728,1521,353,2908,40300,364,1599,6621,888,279,1578,852,599,15777,494,48840,321,599,3753,79722,1204,51838,424,628,381,310,14413,381,14463,9825,286,321,10488,364,1396,11155,1288,14571,25577,1018,13,256]}
