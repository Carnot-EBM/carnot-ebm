ence\\\":{\\\"casual\\\":true,\\\"classy\\\":false,\\\"divey\\\":null,\\\"hipster\\\":false,\\\"intimate\\\":false,\\\"romantic\\\":false,\\\"touristy\\\":false,\\\"trendy\\\":false,\\\"upscale\\\":false},\\\"BusinessParking\\\":{\\\"garage\\\":false,\\\"lot\\\":null,\\\"street\\\":true,\\\"valet\\\":false,\\\"validated\\\":false},\\\"Music\\\":null,\\\"OutdoorSeating\\\":null,\\\"RestaurantsGoodForGroups\\\":true,\\\"RestaurantsReservations\\\":false,\\\"RestaurantsTakeOut\\\":true,\\\"WiFi\\\":\\\"no\\\"},\\\"business_stars\\\":3.5,\\\"categories\\\":\\\"Ethnic Food, Specialty Food, Local Flavor, Mexican, Restaurants, Food, Breakfast & Brunch, Fast Food, Juice Bars & Smoothies\\\",\\\"city\\\":\\\"Isla Vista\\\",\\\"hours\\\":{\\\"Friday\\\":\\\"7:0-0:0\\\",\\\"Monday\\\":\\\"7:0-0:0\\\",\\\"Saturday\\\":\\\"7:0-0:0\\\",\\\"Sunday\\\":\\\"7:0-0:0\\\",\\\"Thursday\\\":\\\"7:0-0:0\\\",\\\"Tuesday\\\":\\\"7:0-0:0\\\",\\\"Wednesday\\\":\\\"7:0-0:0\\\"},\\\"name\\\":\\\"Super Cucas\\\",\\\"review_info\\\":[{\\\"review_date\\\":\\\"2021-11-03 21:59:35\\\",\\\"review_stars\\\":4.0,\\\"review_text\\\":\\\"Super Cucas is really tasty and the portion sizes are so generous. They're also open late which is always great when you're in a college town. I love that they have a menu that offers every style of meat veganized (including soy pastor!) \\\\n\\\\nI'd love to try the vegan fries with meat (asada fries) and the breakfast burritos on my next visit. The portions are huge so I would recommend splitting or saving for 2 meals.\\\"},{\\\"review_date\\\":\\\"2021-11-02 17:48:00\\\",\\\"review_stars\\\":1.0,\\\"review_text\\\":\\\"Literally experienced the worst costumer service. A man yelled at me because I told him I was allergic to beans which I noticed were on tacos and asked if they can re-make them.\\\"},{\\\"review_date\\\":\\\"2021-10-17 19:12:17\\\",\\\"review_stars\\\":2.0,\\\"review_text\\\":\\\"Decent food, but they always mess up our order. Super disappointing when we pick up food then get home and realize they gave us the completely wrong thing, especially when it's covered in cheese and my boyfriend can't eat dairy!!!! Not the best customer service either\\\"}],\\\"state\\\":\\\"CA\\\"}\", \"original_answer\": \"Super Cucas, located at 6527 Madrid Rd, Isla Vista, CA, is a local Mexican restaurant known for its generous portion sizes and late opening hours.\", \"source_sentence_offsets\": [{\"end_byte\": 931, \"source_sentence_id\": 0, \"start_byte\": 0, \"text_sha256\": \"sha256:e2a2349e2db44c00f6597383751d795cd1a94c4f112e059bf839b2e0f2401fd5\"}, {\"end_byte\": 1007, \"source_sentence_id\": 1, \"start_byte\": 931, \"text_sha256\": \"sha256:35a1d7c7a043e28661915e5a07ebba5166c9a1c3ef6eb82c6c2718d0546995ee\"}, {\"end_byte\": 1207, \"source_sentence_id\": 2, \"start_byte\": 1007, \"text_sha256\": \"sha256:de9fd84e37dceb15cc482e911f9124a53dc2365933d770242d087e04176c02b0\"}, {\"end_byte\": 1406, \"source_sentence_id\": 3, \"start_byte\": 1207, \"text_sha256\": \"sha256:d23bc60cf3cebb03d6d55b616d40dac2b00da84508d1fe876c29f898c7ab4510\"}, {\"end_byte\": 1655, \"source_sentence_id\": 4, \"start_byte\": 1406, \"text_sha256\": \"sha256:49726275524d93c467c870044da9ba9bdd7ef48e7845bcf1371da219527a4107\"}, {\"end_byte\": 1839, \"source_sentence_id\": 5, \"start_byte\": 1655, \"text_sha256\": \"sha256:04a820676236ab6ef4c8b2f1059d2899e9afe442bc0a4d42123ecff98efc60c5\"}, {\"end_byte\": 1892, \"source_sentence_id\": 6, \"start_byte\": 1839, \"text_sha256\": \"sha256:b897d2077b27a6bc68db57c10580dae88b6af8b5d9e9ea4e9814f47ddecc1694\"}], \"target_sentence_sha256\": \"sha256:5218c372113bb70f25b343c71be286636b45c8087cb3f0a59e8f23733129e47c\", \"visible_source_sentence_ids\": [0, 1, 2, 3, 4, 5, 6]}<|im_end|>\n<|im_start|>assistant\n<think>\n\n</think>\n\n","generated":""}
