2.04.977.875 D srv  log_server_r: request:  {"content": "The fish weren't cooperating, but after a while Jordan learned they were attracted to his laundry, which he would put out to sea for a rinse. ", "add_special": true}
2.04.977.875 D srv  log_server_r: response: {"tokens":[760,7397,14290,914,78679,11,694,1238,264,1345,16586,9218,781,998,27117,310,780,32960,11,864,551,1000,2113,680,310,9117,364,264,70751,13,220]}
