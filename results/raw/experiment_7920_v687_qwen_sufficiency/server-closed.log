e\\\":{\\\"casual\\\":true,\\\"classy\\\":false,\\\"divey\\\":false,\\\"hipster\\\":false,\\\"intimate\\\":false,\\\"romantic\\\":false,\\\"touristy\\\":false,\\\"trendy\\\":true,\\\"upscale\\\":false},\\\"BusinessParking\\\":{\\\"garage\\\":false,\\\"lot\\\":false,\\\"street\\\":true,\\\"valet\\\":false,\\\"validated\\\":false},\\\"Music\\\":null,\\\"OutdoorSeating\\\":true,\\\"RestaurantsGoodForGroups\\\":true,\\\"RestaurantsReservations\\\":false,\\\"RestaurantsTakeOut\\\":true,\\\"WiFi\\\":\\\"no\\\"},\\\"business_stars\\\":3.5,\\\"categories\\\":\\\"Restaurants, Mexican\\\",\\\"city\\\":\\\"Santa Barbara\\\",\\\"hours\\\":null,\\\"name\\\":\\\"El Taco Tequila Taqueria\\\",\\\"review_info\\\":[{\\\"review_date\\\":\\\"2013-12-06 03:03:14\\\",\\\"review_stars\\\":2.0,\\\"review_text\\\":\\\"On Thursday night I went to this place after a concert. A few friends and I wanted a bite and a drink. We ordered with a young woman who quickly told us they did not accommodate gluten free customers, even if you wanted a taco or tostada without the bread. Fine. I'll work around that I understand. We waited 20 minutes for our food, granted there was only one guy in the kitchen. We finally got our tacos and were missing one chicken taco and our guacamole. We ask the chef for the rest of our order and he says they are closing the kitchen. I go to the woman and tell her that we didn't get all our food and she tells me I'm lying. I point to the plates on our table to show her we didn't. I ask for our money back and she declines. We end up getting into a fight about one chicken taco and guac. \\\\n\\\\nI have worked in restaurants before and I would never scold a customer over a $3 taco. I even offed to pay for it and she wouldn't let me. Really terrible customer service. The chef did make us some guac bc I think he felt bad that we were hungry and upset. By that point we had eaten what we were served and didn't have anything to put it on.\\\\n\\\\nThat being said the food we get was yummy. Too bad our experience ended on such a bad note.\\\"},{\\\"review_date\\\":\\\"2013-03-28 15:50:04\\\",\\\"review_stars\\\":1.0,\\\"review_text\\\":\\\"We both got food poisoning here - that lasted a whole day. We narrowed it down to either the chips & salsa, the queso app, or the carnitas tacos since that's the only thing BOTH of us ate. The food seemed great, but it seems to be all about pushing the drinks for $$ and food safety was left to the sidelines.\\\"},{\\\"review_date\\\":\\\"2012-11-03 03:56:19\\\",\\\"review_stars\\\":4.0,\\\"review_text\\\":\\\"Great food. WOnderful atmosphere. Great Happy hour two for one Margaritas. I love the decor too. Beautiful Bar. Amazing flan!\\\"}],\\\"state\\\":\\\"CA\\\"}\", \"original_answer\": \"El Taco Tequila Taqueria is a popular Mexican restaurant located in the heart of Santa Barbara, CA.\", \"source_sentence_offsets\": [{\"end_byte\": 693, \"source_sentence_id\": 0, \"start_byte\": 0, \"text_sha256\": \"sha256:b270dd08e5708d8c67b7ecc3ec70b66e21f151b3bae3dd7e43549bd71a02febf\"}, {\"end_byte\": 740, \"source_sentence_id\": 1, \"start_byte\": 693, \"text_sha256\": \"sha256:358fddc4f8a15e5c84dc361d868dca67309213d956025429bd126443bda44942\"}, {\"end_byte\": 894, \"source_sentence_id\": 2, \"start_byte\": 740, \"text_sha256\": \"sha256:6c13a94471252c893415a08d639383506f99458dad668645fe1ee8c2c3e00ed2\"}, {\"end_byte\": 900, \"source_sentence_id\": 3, \"start_byte\": 894, \"text_sha256\": \"sha256:5a6e693a71920aa2976a2046d5596a2a06e6d71bd82eceaedafe2060b18fc37b\"}, {\"end_byte\": 936, \"source_sentence_id\": 4, \"start_byte\": 900, \"text_sha256\": \"sha256:a3dd15b59b669f7075ba07a2d0f7c71889c1d7337d62e84048869107114534af\"}, {\"end_byte\": 1018, \"source_sentence_id\": 5, \"start_byte\": 936, \"text_sha256\": \"sha256:8fed5f8a25c4c6a7462b8026ffe8b8522772522e081506aadf1d7bbfecbf241b\"}, {\"end_byte\": 1096, \"source_sentence_id\": 6, \"start_byte\": 1018, \"text_sha256\": \"sha256:f7647b5da9ac4f26c1046c813d4679248d4