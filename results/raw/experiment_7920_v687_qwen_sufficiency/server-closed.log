3.42.542.698 D srv  log_server_r: request:  {"content": "Debates on climate change can break down fairly fast. ", "add_special": true}
3.42.542.698 D srv  log_server_r: response: {"tokens":[229844,942,383,9682,2222,628,1387,1441,13733,4778,13,220]}
3.42.543.125 D srv          stop: all tasks already finished, no need to cancel
3.42.543.132 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
3.42.543.132 D srv  log_server_r: request:  {"content": "There are those who believe that mankind's activities are changing the planet's climate, and those who don't. ", "add_special": true}
3.42.543.132 D srv  log_server_r: response: {"tokens":[3733,513,1782,852,4267,421,40879,579,7253,513,9722,279,11247,579,9682,11,321,1782,852,1459,914,13,220]}
3.42.543.862 D srv          stop: all tasks already finished, no need to cancel
3.42.543.865 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
3.42.543.865 D srv  log_server_r: request:  {"content": "But a new way to talk about climate change is emerging, which shifts focus from impersonal discussions about greenhouse gas emissions and power plants to a very personal one: your health. ", "add_special": true}
3.42.543.865 D srv  log_server_r: response: {"tokens":[3850,264,491,1560,310,2963,883,9682,2222,369,22482,11,864,27700,5077,494,57732,278,19716,883,35341,6605,19530,321,2279,10462,310,264,1546,4204,799,25,678,2730,13,220]}
3.42.544.562 D srv          stop: all tasks already finished, no need to cancel
3.42.544.568 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
3.42.544.569 D srv  log_server_r: request:  {"content": "It's easy to brush aside debates involving major international corporations, but who wouldn't stop to think -- and perhaps do something -- about their own health, or the health of their children? ", "add_special": true}
3.42.544.569 D srv  log_server_r: response: {"tokens":[2064,579,3999,310,15166,15204,35329,15394,3478,6286,23579,11,694,852,8012,914,2842,310,1683,1137,321,8106,635,2414,1137,883,836,1765,2730,11,466,279,2730,314,836,2748,30,220]}
3.42.545.155 D srv          stop: all tasks already finished, no need to cancel
3.42.545.158 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
3.42.545.159 D srv  log_server_r: request:  {"content": "This new way of talking about climate change -- and linking it to public health issues -- was part of a roundtable discussion Tuesday at Howard University's College of Medicine. ", "add_special": true}
3.42.545.178 D srv  log_server_r: response: {"tokens":[1919,491,1560,314,7169,883,9682,2222,1137,321,29697,424,310,569,2730,4562,1137,557,919,314,264,4625,1938,9915,7348,506,19265,3694,579,8853,314,18076,13,220]}
3.42.545.420 D srv          stop: all tasks already finished, no need to cancel
3.42.545.422 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
3.42.545.422 D srv  log_server_r: request:  {"content": "President Barack Obama joined U.S. ", "add_special": true}
3.42.545.422 D srv  log_server_r: response: {"tokens":[25302,22804,6884,10542,533,782,13,220]}
3.42.545.632 D srv          stop: all tasks already finished, no need to cancel
