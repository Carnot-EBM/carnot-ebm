4.29.919.129 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
4.29.919.130 D srv  log_server_r: request:  {"content": "It is simply a carpet of humanity.\" \"Captaincy is 90% luck and 10% skill. ", "add_special": true}
4.29.919.131 D srv  log_server_r: response: {"tokens":[2064,369,4777,264,26950,314,21265,1149,328,59001,10807,369,220,24,15,4,14583,321,220,16,15,4,9653,13,220]}
4.29.919.608 D srv          stop: all tasks already finished, no need to cancel
4.29.919.615 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
4.29.919.617 D srv  log_server_r: request:  {"content": "But don't try it without that 10%.\" News of his passing quickly generated a wave of condolences, including from Australian Prime Minister Tony Abbott. ", "add_special": true}
4.29.919.617 D srv  log_server_r: response: {"tokens":[3850,1459,914,1380,424,1973,421,220,16,15,4,1149,5230,314,780,11946,5964,7658,264,11717,314,76477,11,2583,494,12982,12159,9206,17974,40733,13,220]}
4.29.919.807 D srv          stop: all tasks already finished, no need to cancel
4.29.919.812 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
4.29.919.813 D srv  log_server_r: request:  {"content": "\"To most Australians Richie Benaud was cricket. ", "add_special": true}
4.29.919.813 D srv  log_server_r: response: {"tokens":[62921,1379,53964,95549,417,6933,643,557,34806,13,220]}
4.29.919.993 D srv          stop: all tasks already finished, no need to cancel
4.29.919.995 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
4.29.919.995 D srv  log_server_r: request:  {"content": "He personified its traditions and its values,\" Abbott said in a written statement Friday. ", "add_special": true}
4.29.919.996 D srv  log_server_r: response: {"tokens":[1465,1637,1806,1141,29893,321,1141,2663,1288,40733,1018,303,264,5158,4952,6394,13,220]}
4.29.920.172 D srv          stop: all tasks already finished, no need to cancel
4.29.920.175 I srv  log_server_r: done request: POST /tokenize 127.0.0.1 200
4.29.920.175 D srv  log_server_r: request:  {"content": "\"While many Australians only know Richard Benaud as the voice of cricket, we should not forget that in his day he was a cricketer with few equals. ", "add_special": true}
4.29.920.177 D srv  log_server_r: response: {"tokens":[91587,1599,53964,1132,1366,11528,417,6933,643,430,279,7497,314,34806,11,567,1220,524,10351,421,303,780,1834,551,557,264,1505,839,1356,440,2342,16327,13,220]}
