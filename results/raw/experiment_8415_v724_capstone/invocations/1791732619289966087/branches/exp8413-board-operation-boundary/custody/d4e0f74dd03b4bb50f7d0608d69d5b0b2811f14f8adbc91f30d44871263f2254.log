dex\":0,\"byte_start\":0,\"byte_end\":220},{\"index\":1,\"byte_start\":220,\"byte_end\":353},{\"index\":2,\"byte_start\":353,\"byte_end\":430},{\"index\":3,\"byte_start\":430,\"byte_end\":523},{\"index\":4,\"byte_start\":523,\"byte_end\":609},{\"index\":5,\"byte_start\":609,\"byte_end\":734},{\"index\":6,\"byte_start\":734,\"byte_end\":854},{\"index\":7,\"byte_start\":854,\"byte_end\":1011}]}"}], "add_generation_prompt": true, "chat_template_kwargs": {"enable_thinking": false}}
