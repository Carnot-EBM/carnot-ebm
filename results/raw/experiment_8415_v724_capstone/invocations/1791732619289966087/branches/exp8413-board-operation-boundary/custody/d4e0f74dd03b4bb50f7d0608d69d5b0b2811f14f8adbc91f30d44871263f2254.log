"post_sampling_probs":false,"backend_sampling":false,"lora":[]},"next_token":[{"has_next_token":false,"has_new_line":false,"n_remain":174,"n_decoded":82}],"prompt":"<|im_start|>user\n{\"instruction\":\"For each requested answer sentence emit index|E/C/B|p_unsupported with two decimals|[zero to two source segment indices]. One record per line in input order; no other text. Relations and addresses are predictions.\",\"source\":\"{\\\"address\\\":\\\"119 Harbor Way\\\",\\\"attributes\\\":{\\\"Ambience\\\":{\\\"casual\\\":true,\\\"classy\\\":true,\\\"divey\\\":false,\\\"hipster\\\":false,\\\"intimate\\\":false,\\\"romantic\\\":false,\\\"touristy\\\":false,\\\"trendy\\\":false,\\\"upscale\\\":false},\\\"BusinessParking\\\":{\\\"garage\\\":false,\\\"lot\\\":true,\\\"street\\\":false,\\\"valet\\\":false,\\\"validated\\\":false},\\\"Music\\\":null,\\\"OutdoorSeating\\\":true,\\\"RestaurantsGoodForGroups\\\":true,\\\"RestaurantsReservations\\\":false,\\\"RestaurantsTakeOut\\\":true,\\\"WiFi\\\":\\\"free\\\"},\\\"business_stars\\\":4.0,\\\"categories\\\":\\\"Cocktail Bars, Fish & Chips, Nightlife, Seafood, Restaurants, Bars\\\",\\\"city\\\":\\\"Santa Barbara\\\",\\\"hours\\\":{\\\"Friday\\\":\\\"11:0-16:0\\\",\\\"Monday\\\":\\\"0:0-0:0\\\",\\\"Saturday\\\":\\\"11:0-16:0\\\",\\\"Sunday\\\":\\\"11:0-22:0\\\",\\\"Thursday\\\":\\\"11:0-22:0\\\",\\\"Tuesday\\\":\\\"11:0-22:0\\\",\\\"Wednesday\\\":\\\"11:0-22:0\\\"},\\\"name\\\":\\\"Brophy Bros - Santa Barbara\\\",\\\"review_info\\\":[{\\\"review_date\\\":\\\"2022-01-17 20:14:55\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"This place is AMAZING. Great service. Drinks are strong. Just the way I like them. The Hot Sampler is good for 2.\\\"},{\\\"review_date\\\":\\\"2022-01-16 22:13:42\\\",\\\"review_stars\\\":1.0,\\\"review_text\\\":\\\"Can't order to-go in person\\\\nCan't order oysters/uni online\\\\nCan't bring dogs to their outdoor patio.\\\\nLines are pretty packed\\\\n\\\\nBut most importantly the waitress wasted my time by telling me their sister restaurant \\\\\\\"on-the-ally\\\\\\\" had their oysters and does take out, but they do not carry any of the seafood there.\\\\n\\\\nIm sure the food tastes great, too bad the accessibility is poor.\\\"},{\\\"review_date\\\":\\\"2022-01-15 23:57:51\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"My go-to seafood spot in Santa Barbara - casual, fresh seafood, friendly service, beautiful views of the Marina where you can literally watch the boats come in with seafood! Parking is difficult but folks are usually coming and going so we've always managed to score a spot. Check in with the hostess downstairs and if it's a typical beautiful day, try to get a table outside otherwise they also have indoor and bar seating too. My favorites are:\\\\n- Cold combo app: Nice variety, perfect to share and savor\\\\n- Clam chowder: Amazing!\\\\n- Fish and chips: Large, freshly fried fish and plentiful fries\\\\nThey also have cioppino here (a rare find) and a simple kids' menu but our kids and I dig the opportunity to eat seafood here\\\\nAlso a great place to wander around after lunch since the beach is right there ... and when we were last there they had sand hills that look perfect for sand sledding!\\\"}],\\\"state\\\":\\\"CA\\\"}\",\"answer\":\"Brophy Bros - Santa Barbara is a popular seafood restaurant located in the heart of Santa Barbara's marina area. With a 4.0-star rating and a reputation for serving fresh, delicious seafood, this establishment is a must-visit for anyone looking for a casual, oceanfront dining experience. The restaurant offers a variety of seafood options, including fish and chips, clam chowder, and a cold combo appetizer, all of which are highly recommended by reviewers. The outdoor patio seating offers beautiful views of the marina, making it a great spot to enjoy a meal while taking in the sights and sounds of the water. While parking can be challenging, the restaurant is worth the effort, and visitors can always check in with the hostess downstairs to see if there are any available tables. Additionally, Brophy Bros - Santa Barbara offers takeout and delivery options for those looking to enjoy their seafood at home or on the go. Overall, this local business is a great choice for anyone looking for fresh, delicious seafood in a casual, oceanfront setting.\",\"source_segments\":[{\"index\":0,\"byte_start\":0,\"byte_end\":863},{\"index\":1,\"byte_start\":863,\"byte_end\":878},{\"index\":2,\"byte_start\":878,\"byte_end\":897},{\"index\":3,\"byte_start\":897,\"byte_end\":923},{\"index\":4,\"byte_start\":923,\"byte_end\":1661},{\"index\":5,\"byte_start\":1661,\"byte_end\":1762},{\"index\":6,\"byte_start\":1762,\"byte_end\":1916},{\"index\":7,\"byte_start\":1916,\"byte_end\":2296},{\"index\":8,\"byte_start\":2296,\"byte_end\":2397}],\"answer_sentence_indices\":[0,1,2,3,4,5,6],\"answer_offsets\":[{\"index\":0,\"byte_start\":0,\"byte_end\":113},{\"index\":1,\"byte_start\":113,\"byte_end\":289},{\"index\":2,\"byte_start\":289,\"byte_end\":459},{\"index\":3,\"byte_start\":459,\"byte_end\":614},{\"index\":4,\"byte_start\":614,\"byte_end\":787},{\"index\":5,\"byte_start\":787,\"byte_end\":928},{\"index\":6,\"byte_start\":928,\"byte_end\":1055}]}<|im_end|>\n<|im_start|>assistant\n<think>\n\n</think>\n\n","generated":""}
