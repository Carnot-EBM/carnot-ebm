"],"speculative.types":"none","timings_per_token":false,"post_sampling_probs":false,"backend_sampling":false,"lora":[]},"next_token":[{"has_next_token":false,"has_new_line":false,"n_remain":168,"n_decoded":88}],"prompt":"<|im_start|>user\n{\"instruction\":\"For each requested answer sentence emit index|E/C/B|p_unsupported with two decimals|[zero to two source segment indices]. One record per line in input order; no other text. Relations and addresses are predictions.\",\"source\":\"{\\\"address\\\":\\\"6530 Seville Rd\\\",\\\"attributes\\\":{\\\"Ambience\\\":{\\\"casual\\\":true,\\\"classy\\\":false,\\\"divey\\\":false,\\\"hipster\\\":false,\\\"intimate\\\":false,\\\"romantic\\\":false,\\\"touristy\\\":false,\\\"trendy\\\":true,\\\"upscale\\\":false},\\\"BusinessParking\\\":{\\\"garage\\\":false,\\\"lot\\\":false,\\\"street\\\":true,\\\"valet\\\":false,\\\"validated\\\":false},\\\"Music\\\":null,\\\"OutdoorSeating\\\":false,\\\"RestaurantsGoodForGroups\\\":true,\\\"RestaurantsReservations\\\":false,\\\"RestaurantsTakeOut\\\":true,\\\"WiFi\\\":\\\"no\\\"},\\\"business_stars\\\":4.0,\\\"categories\\\":\\\"Restaurants, Sandwiches, Vegan, Delis, Gluten-Free\\\",\\\"city\\\":\\\"Goleta\\\",\\\"hours\\\":{\\\"Friday\\\":\\\"11:0-15:0\\\",\\\"Monday\\\":\\\"0:0-0:0\\\",\\\"Saturday\\\":\\\"11:0-15:0\\\",\\\"Sunday\\\":\\\"11:0-15:0\\\",\\\"Thursday\\\":\\\"11:0-15:0\\\",\\\"Tuesday\\\":\\\"11:0-15:0\\\",\\\"Wednesday\\\":\\\"11:0-15:0\\\"},\\\"name\\\":\\\"Ike's Place\\\",\\\"review_info\\\":[{\\\"review_date\\\":\\\"2019-03-17 20:00:00\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"Visiting town from LA and this was the closest vegan place to the campus that was open. We weren't especially excited about it on the way because the menu was just sandwiches. \\\\nWe got three different sandwiches and every single one was epically delicious. We all got vegetarian and vegan sandwiches and were so impressed that we tried eachothers sandwiches and every one loved all three 