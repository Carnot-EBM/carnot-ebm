9.29.262.315 D srv  log_server_r: request:  {"messages": [{"role": "user", "content": "{\"instruction\":\"For each requested answer sentence emit index|E/C/B|p_unsupported with two decimals|[zero to two source segment indices]. One record per line in input order; no other text. Relations and addresses are predictions.\",\"source\":\"{\\\"address\\\":\\\"5112 Hollister Ave\\\",\\\"attributes\\\":{\\\"Ambience\\\":{\\\"casual\\\":true,\\\"classy\\\":false,\\\"divey\\\":null,\\\"hipster\\\":false,\\\"intimate\\\":false,\\\"romantic\\\":false,\\\"touristy\\\":false,\\\"trendy\\\":false,\\\"upscale\\\":false},\\\"BusinessParking\\\":{\\\"garage\\\":false,\\\"lot\\\":true,\\\"street\\\":false,\\\"valet\\\":false,\\\"validated\\\":false},\\\"Music\\\":null,\\\"OutdoorSeating\\\":true,\\\"RestaurantsGoodForGroups\\\":true,\\\"RestaurantsReservations\\\":false,\\\"RestaurantsTakeOut\\\":true,\\\"WiFi\\\":\\\"no\\\"},\\\"business_stars\\\":3.0,\\\"categories\\\":\\\"Restaurants, Barbeque\\\",\\\"city\\\":\\\"Santa Barbara\\\",\\\"hours\\\":{\\\"Friday\\\":\\\"11:0-20:0\\\",\\\"Monday\\\":\\\"11:0-20:0\\\",\\\"Saturday\\\":\\\"11:0-20:0\\\",\\\"Sunday\\\":\\\"11:0-20:0\\\",\\\"Thursday\\\":\\\"11:0-20:0\\\",\\\"Tuesday\\\":\\\"11:0-20:0\\\",\\\"Wednesday\\\":\\\"11:0-20:0\\\"},\\\"name\\\":\\\"Woody's BBQ\\\",\\\"review_info\\\":[{\\\"review_date\\\":\\\"2021-10-13 19:50:19\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"Closed, after 39 years!  RIP Woody's. Bodacious!\\\\n\\\\nAlways a fun eclectic atmosphere and great energy and bountiful comfort food . I'll miss Woody's. And I'm vegetarian! Yummy fries. \\\\n\\\\nA lot of history. I used to go to the location on Montecito Street. They were always at festivals, too. \\\\n\\\\nDo you remember when the Goleta location was Flapper Alley? The old logo is still on the windows. \\\\n\\\\nThe owners are opening a new restaurant at the old Timbers location\\\"},{\\\"review_date\\\":\\\"2021-10-10 19:53:31\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"Been coming here more than a decade, found out it's closing down. Offerings are slim, but swing by and get it while you can!\\\"},{\\\"review_date\\\":\\\"2021-08-26 19:47:15\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"We need last minute small catering (15 people) planned for a corporate summer event and found Woody's here on yelp. I was a little hesitant because some of the reviews, but I am so glad we went with Woody's. Kim was extremely helpful in planning our event even with only 2 days lead time. She was efficient, friendly, and made sure we had what was needed for our small event. Food was delivered timely and it was hot and delicious. The tri-tip and ribs were a hit and there was tons of food provided (and leftovers) for what we chose. I would definitely choose Woody's for both a casual get together or another corporate event.\\\"}],\\\"state\\\":\\\"CA\\\"}\",\"answer\":\"Woody's BBQ is a popular restaurant located in Santa Barbara, California, known for its delicious barbecue and eclectic atmosphere. With a rating of 3.0 stars, the business offers a range of dining experiences, including outdoor seating and takeout options. While some customers have expressed disappointment with the lack of parking and WiFi, many have praised the quality of the food and the friendly service. The business has a loyal customer base, with many reviewers mentioning their fondness for the place and the nostalgia it evokes. Despite its closure after 39 years, Woody's will be remembered as a beloved local institution.\",\"source_segments\":[{\"index\":0,\"byte_start\":0,\"byte_end\":808},{\"index\":1,\"byte_start\":808,\"byte_end\":821},{\"index\":2,\"byte_start\":821,\"byte_end\":914},{\"index\":3,\"byte_start\":914,\"byte_end\":933},{\"index\":4,\"byte_start\":933,\"byte_end\":953},{\"index\":5,\"byte_start\":953,\"byte_end\":966},{\"index\":6,\"byte_start\":966,\"byte_end\":988},{\"index\":7,\"byte_start\":988,\"byte_end\":1038},{\"index\":8,\"byte_start\":1038,\"byte_end\":1074},{\"index\":9,\"byte_start\":1074,\"byte_end\":1138},{\"index\":10,\"byte_start\":1138,\"byte_end\":1176},{\"index\":11,\"byte_start\":1176,\"byte_end\":1387},{\"index\":12,\"byte_start\":1387,\"byte_end\":1635},{\"index\":13,\"byte_start\":1635,\"byte_end\":1727},{\"index\":14,\"byte_start\":1727,\"byte_end\":1808},{\"index\":15,\"byte_start\":1808,\"byte_end\":1895},{\"index\":16,\"byte_start\":1895,\"byte_end\":1951},{\"index\":17,\"byte_start\":1951,\"byte_end\":2054},{\"index\":18,\"byte_start\":2054,\"byte_end\":2163}],\"answer_sentence_indices\":[0,1,2,3,4],\"answer_offsets\":[{\"index\":0,\"byte_start\":0,\"byte_end\":132},{\"index\":1,\"byte_start\":132,\"byte_end\":258},{\"index\":2,\"byte_start\":258,\"byte_end\":412},{\"index\":3,\"byte_start\":412,\"byte_end\":541},{\"index\":4,\"byte_start\":541,\"byte_end\":635}]}"}], "add_generation_prompt": true, "chat_template_kwargs": {"enable_thinking": false}}
