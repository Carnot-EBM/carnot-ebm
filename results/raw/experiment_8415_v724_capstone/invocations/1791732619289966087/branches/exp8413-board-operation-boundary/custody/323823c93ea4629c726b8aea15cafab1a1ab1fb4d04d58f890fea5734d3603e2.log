ntent":false,"generation_prompt":"<|im_start|>assistant\n<think>\n\n</think>\n\n","samplers":["penalties","dry","top_n_sigma","top_k","typ_p","top_p","min_p","xtc","temperature"],"speculative.types":"none","timings_per_token":false,"post_sampling_probs":false,"backend_sampling":false,"lora":[]},"next_token":[{"has_next_token":false,"has_new_line":false,"n_remain":167,"n_decoded":89}],"prompt":"<|im_start|>user\n{\"instruction\":\"For each requested answer sentence emit index|E/C/B|p_unsupported with two decimals|[zero to two source segment indices]. One record per line in input order; no other text. Relations and addresses are predictions.\",\"source\":\"{\\\"address\\\":\\\"413 State St\\\",\\\"attributes\\\":{\\\"Ambience\\\":{\\\"casual\\\":false,\\\"classy\\\":false,\\\"divey\\\":false,\\\"hipster\\\":true,\\\"intimate\\\":false,\\\"romantic\\\":false,\\\"touristy\\\":false,\\\"trendy\\\":false,\\\"upscale\\\":false},\\\"BusinessParking\\\":{\\\"garage\\\":false,\\\"lot\\\":false,\\\"street\\\":false,\\\"valet\\\":false,\\\"validated\\\":false},\\\"Music\\\":null,\\\"OutdoorSeating\\\":false,\\\"RestaurantsGoodForGroups\\\":true,\\\"RestaurantsReservations\\\":true,\\\"RestaurantsTakeOut\\\":true,\\\"WiFi\\\":\\\"free\\\"},\\\"business_stars\\\":5.0,\\\"categories\\\":\\\"American (New), Restaurants, Burgers\\\",\\\"city\\\":\\\"Santa Barbara\\\",\\\"hours\\\":null,\\\"name\\\":\\\"Momma Donna\\\",\\\"review_info\\\":[{\\\"review_date\\\":\\\"2012-03-20 01:38:19\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"This is now Pace Food and Drink.  They've cleaned it up and are serving one of the best burgers I've ever had.  Avocados, caramelized onions, and bacon with freshly ground meat and a homemade bun.  Frickin' awesome!\\\"},{\\\"review_date\\\":\\\"2011-12-17 07:19:21\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"By far the best burger in S.B. . . . and this town has a lot of great burgers. Need I say more?\\\\n\\\\nYet, there is so much more.  The place is just very comfortable and welcoming, the cook (at least every time I've been there) is a youngish, personable creative genius.  But above all, the burgers are THE BEST IN SANTA BARBARA. Have I mentioned that?\\\"},{\\\"review_date\\\":\\\"2011-12-12 23:44:51\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"As the duchess of this fine establishment (don't argue with me. see the little crown? above this review? yeah. beat it.)... i think its my duty that i provide my favorites to the public. \\\\n\\\\nI'm here every weekend.  Not only because the food is amazing, but because the people that work here are amazing.  Where else can you go where you'll be WELCOMED into a restaurant with open arms? probably a lot of places. forget that I started off updating my review with that question. \\\\n\\\\nbut really though, the friendliness and the warm atmosphere is enough to get people coming back. you feel like you become a part of that small family. \\\\n\\\\nMy brother isn't 21 yet and he never understood why people went to bars. I never go to bars to have a conversation with a bartender (unless its in hawaii and i'm already hammered. then the bartender is my best friend.) but I guess the way that its portrayed in movies where someone goes to the bar and chats up a storm with the bartender is how he thought it was supposed to be.  He still didn't understand until he came in one night with me after work to grub and he instantly felt the hospitality and the warmth of these employees.  please note: this place doesn't have a fully stocked bar. He's just not 21 and thinks that any place that serves beer over a bar-like structure is a bar. Haha, so young and so very innocent. \\\\n\\\\nenough of that. my favorites:\\\\n\\\\npb and j burger. the first time I tried it, I was blacked out and I don't remember what it tasted like at all. I had it this past Saturday night and holy shiiiiiiii-, it was so good. And again, i hate savory and sweet. Maybe my taste buds are slowly changing? Because there have been a lot of these combinations that I'm starting to like... \\\\n\\\\nmacaroni and cheese with mushrooms and caramelized bacon. \\\\n\\\\ngrilled cheese with tomato and arugula. the green makes me feel a little bit better about neglecting my vegetables.\\\\n\\\\nraspberry shock top beer.\\\"}],\\\"state\\\":\\\"CA\\\"}\",\"answer\":\"Momma Donna is a locally loved restaurant in Santa Barbara, California, known for its delicious American cuisine, particularly their exceptional burgers. According to customer reviews, the restaurant has a cozy and welcoming atmosphere, with friendly and personable staff who make guests feel like part of the family. The menu features a variety of mouth-watering options, including their famous PB & J Burger, which is made with freshly ground meat, avocado, caramelized onions, and bacon, served on a homemade bun. Other popular dishes include macaroni and cheese with mushrooms and caramelized bacon, as well as grilled cheese with tomato and arugula. Additionally, Momma Donna offers a great selection of craft beers, including the highly recommended Raspberry Shock Top Beer. Customers rave about the quality of the food and the warm hospitality, making Momma Donna a must-visit spot for anyone looking for a casual, comfortable dining experience in Santa Barbara.\",\"source_segments\":[{\"index\":0,\"byte_start\":0,\"byte_end\":678},{\"index\":1,\"byte_start\":678,\"byte_end\":756},{\"index\":2,\"byte_start\":756,\"byte_end\":842},{\"index\":3,\"byte_start\":842,\"byte_end\":964},{\"index\":4,\"byte_start\":964,\"byte_end\":966},{\"index\":5,\"byte_start\":966,\"byte_end\":968},{\"index\":6,\"byte_start\":968,\"byte_end\":970},{\"index\":7,\"byte_start\":970,\"byte_end\":1012},{\"index\":8,\"byte_start\":1012,\"byte_end\":1061},{\"index\":9,\"byte_start\":1061,\"byte_end\":1202},{\"index\":10,\"byte_start\":1202,\"byte_end\":1260},{\"index\":11,\"byte_start\":1260,\"byte_end\":1420},{\"index\":12,\"byte_start\":