n":false,"post_sampling_probs":false,"backend_sampling":false,"lora":[]},"next_token":[{"has_next_token":false,"has_new_line":false,"n_remain":179,"n_decoded":77}],"prompt":"<|im_start|>user\n{\"instruction\":\"For each requested answer sentence emit index|E/C/B|p_unsupported with two decimals|[zero to two source segment indices]. One record per line in input order; no other text. Relations and addresses are predictions.\",\"source\":\"{\\\"address\\\":\\\"3102 State St\\\",\\\"attributes\\\":{\\\"Ambience\\\":{\\\"casual\\\":false,\\\"classy\\\":false,\\\"divey\\\":false,\\\"hipster\\\":false,\\\"intimate\\\":false,\\\"romantic\\\":false,\\\"touristy\\\":false,\\\"trendy\\\":false,\\\"upscale\\\":false},\\\"BusinessParking\\\":{\\\"garage\\\":false,\\\"lot\\\":true,\\\"street\\\":false,\\\"valet\\\":false,\\\"validated\\\":false},\\\"Music\\\":null,\\\"OutdoorSeating\\\":true,\\\"RestaurantsGoodForGroups\\\":false,\\\"RestaurantsReservations\\\":false,\\\"RestaurantsTakeOut\\\":true,\\\"WiFi\\\":\\\"no\\\"},\\\"business_stars\\\":4.5,\\\"categories\\\":\\\"Restaurants, Gas Stations, Delis, Automotive, Greek\\\",\\\"city\\\":\\\"Santa Barbara\\\",\\\"hours\\\":{\\\"Friday\\\":\\\"10:0-17:0\\\",\\\"Monday\\\":\\\"10:0-17:0\\\",\\\"Saturday\\\":\\\"10:0-17:0\\\",\\\"Thursday\\\":\\\"10:0-17:0\\\",\\\"Tuesday\\\":\\\"10:0-17:0\\\",\\\"Wednesday\\\":\\\"10:0-17:0\\\"},\\\"name\\\":\\\"Yanni's Greek & American Deli\\\",\\\"review_info\\\":[{\\\"review_date\\\":\\\"2021-09-11 16:13:55\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"Always super quick on Door Dash. Eat here and get some grub. Add extra sauce on the Gyro and go with the lamb.\\\"},{\\\"review_date\\\":\\\"2021-02-08 23:48:43\\\",\\\"review_stars\\\":1.0,\\\"review_text\\\":\\\"Doesn't exist. Was looking forward to a gyro but business just doesn't exist anymore. Please update online sites to reflect this.\\\"},{\\\"review_date\\\":\\\"2021-01-06 00:44:40\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"We're doing a staycation for our anniversary and didn't want to wander far. Got gas across the street and saw this place. Delicious gyros! I got mine without tzatziki sauce (allergies) and it was still fulfilling. I did taste a bit from my husband's and it was so good! Owner was great and glad to share a few laughs for a bit given our days of late.\\\"}],\\\"state\\\":\\\"CA\\\"}\",\"answer\":\"\\\"Yanni's Greek & American Deli\\\" is a local business located at 3102 State St, Santa Barbara, CA. It operates from 10:00 am to 5:00 pm from Monday to Saturday. This establishment is categorized under Restaurants, Gas Stations, Delis, Automotive, and Greek. The deli offers a variety of amenities such as outdoor seating, a parking lot, and takeout services. However, they do not provide WiFi, music, or a restaurant reservation service. The business has an average rating of 4.5 stars. Customer reviews are mixed, with some praising the quick delivery service and delicious gyros, while one review reports that the business was closed.\",\"source_segments\":[{\"index\":0,\"byte_start\":0,\"byte_end\":841},{\"index\":1,\"byte_start\":841,\"byte_end\":869},{\"index\":2,\"byte_start\":869,\"byte_end\":1007},{\"index\":3,\"byte_start\":1007,\"byte_end\":1078},{\"index\":4,\"byte_start\":1078,\"byte_end\":1271},{\"index\":5,\"byte_start\":1271,\"byte_end\":1317},{\"index\":6,\"byte_start\":1317,\"byte_end\":1334},{\"index\":7,\"byte_start\":1334,\"byte_end\":1409},{\"index\":8,\"byte_start\":1409,\"byte_end\":1465},{\"index\":9,\"byte_start\":1465,\"byte_end\":1562}],\"answer_sentence_indices\":[0,1,2,3,4,5,6],\"answer_offsets\":[{\"index\":0,\"byte_start\":0,\"byte_end\":97},{\"index\":1,\"byte_start\":97,\"byte_end\":159},{\"index\":2,\"byte_start\":159,\"byte_end\":256},{\"index\":3,\"byte_start\":256,\"byte_end\":357},{\"index\":4,\"byte_start\":357,\"byte_end\":436},{\"index\":5,\"byte_start\":436,\"byte_end\":485},{\"index\":6,\"byte_start\":485,\"byte_end\":634}]}<|im_end|