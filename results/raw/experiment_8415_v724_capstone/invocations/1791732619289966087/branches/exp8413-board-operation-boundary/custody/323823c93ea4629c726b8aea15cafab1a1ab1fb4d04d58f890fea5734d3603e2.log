te_start\":165,\"byte_end\":298},{\"index\":2,\"byte_start\":298,\"byte_end\":405},{\"index\":3,\"byte_start\":405,\"byte_end\":570},{\"index\":4,\"byte_start\":570,\"byte_end\":713},{\"index\":5,\"byte_start\":713,\"byte_end\":873},{\"index\":6,\"byte_start\":873,\"byte_end\":989},{\"index\":7,\"byte_start\":989,\"byte_end\":1158},{\"index\":8,\"byte_start\":1158,\"byte_end\":1326},{\"index\":9,\"byte_start\":1326,\"byte_end\":1459}]}"}], "add_generation_prompt": true, "chat_template_kwargs": {"enable_thinking": false}}
