yte_end\":1094},{\"index\":7,\"byte_start\":1094,\"byte_end\":1225},{\"index\":8,\"byte_start\":1225,\"byte_end\":1472},{\"index\":9,\"byte_start\":1472,\"byte_end\":1543},{\"index\":10,\"byte_start\":1543,\"byte_end\":1798},{\"index\":11,\"byte_start\":1798,\"byte_end\":1907},{\"index\":12,\"byte_start\":1907,\"byte_end\":2057}]}"}], "add_generation_prompt": true, "chat_template_kwargs": {"enable_thinking": false}}
