":"none","timings_per_token":false,"post_sampling_probs":false,"backend_sampling":false,"lora":[]},"next_token":[{"has_next_token":false,"has_new_line":false,"n_remain":179,"n_decoded":77}],"prompt":"<|im_start|>user\n{\"instruction\":\"For each requested answer sentence emit index|E/C/B|p_unsupported with two decimals|[zero to two source segment indices]. One record per line in input order; no other text. Relations and addresses are predictions.\",\"source\":\"{\\\"address\\\":\\\"38 W Victoria St\\\",\\\"attributes\\\":{\\\"Ambience\\\":{\\\"casual\\\":false,\\\"classy\\\":false,\\\"divey\\\":false,\\\"hipster\\\":false,\\\"intimate\\\":false,\\\"romantic\\\":false,\\\"touristy\\\":false,\\\"trendy\\\":false,\\\"upscale\\\":false},\\\"BusinessParking\\\":{\\\"garage\\\":false,\\\"lot\\\":false,\\\"street\\\":false,\\\"valet\\\":false,\\\"validated\\\":false},\\\"Music\\\":null,\\\"OutdoorSeating\\\":false,\\\"RestaurantsGoodForGroups\\\":null,\\\"RestaurantsReservations\\\":false,\\\"RestaurantsTakeOut\\\":true,\\\"WiFi\\\":\\\"free\\\"},\\\"business_stars\\\":3.5,\\\"categories\\\":\\\"Restaurants, Barbeque, Soul Food\\\",\\\"city\\\":\\\"Santa Barbara\\\",\\\"hours\\\":{\\\"Friday\\\":\\\"11:0-22:0\\\",\\\"Monday\\\":\\\"11:0-21:0\\\",\\\"Saturday\\\":\\\"11:0-22:0\\\",\\\"Sunday\\\":\\\"11:0-21:0\\\",\\\"Thursday\\\":\\\"11:0-21:0\\\",\\\"Tuesday\\\":\\\"11:0-21:0\\\",\\\"Wednesday\\\":\\\"11:0-21:0\\\"},\\\"name\\\":\\\"Soul Cal Smokehouse\\\",\\\"review_info\\\":[{\\\"review_date\\\":\\\"2019-10-31 00:04:54\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"This place just closed. Too bad - it had great brisket. They always had customers.\\\\nRent too high?\\\"},{\\\"review_date\\\":\\\"2019-10-15 04:14:30\\\",\\\"review_stars\\\":4.0,\\\"review_text\\\":\\\"My friend and I were walking past all the restaurants in the Public Market trying to figure out what to get. Two things made me decide on Soul Cal Smokehouse--the AXXESS deal for buy one food item get the second free, and the AMAZINNGGGGG smell of the meat smoking. Wow oh WOW did it smell amazing and then taste even better. \\\\n\\\\nMy friend and I both got the Pulled Pork sandwich with 1 side of fries. Fries had a garlic and pepper kick to it and we could not stop eating them...despite being full from eating the entire sandwich. Pulled pork was so fresh and JUICY with a rich smokey (I mean has to right?) flavor, topped with coleslaw (which I think had a pickled cucumber  in it?).\\\"},{\\\"review_date\\\":\\\"2019-10-15 00:39:25\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"Omg! The brisket... with the pickles!   Amazing!!!\\\\nJust so happy right now! Thanks Clark!\\\"}],\\\"state\\\":\\\"CA\\\"}\",\"answer\":\"Based on the provided structured data, here is an objective overview of Soul Cal Smokehouse:\\n\\nSoul Cal Smokehouse is a local restaurant located in Santa Barbara, California, serving up delicious barbecue and soul food dishes. With a rating of 3.5 stars, the business offers a cozy atmosphere and good value for money. The restaurant is open seven days a week, with varying hours for each day. Although there is no dedicated parking lot or valet service available, street parking is available nearby. WiFi is available for customers, and takeout is also offered. The business has received positive reviews for its smoked meats, particularly the brisket and pulled pork, which are smoked to perfection and paired with tasty sides like garlic and pepper fries. Some reviewers have noted that the restaurant can be a bit pricey, but overall, Soul Cal Smokehouse appears to be a popular destination for locals and visitors alike.\",\"source_segments\":[{\"index\":0,\"byte_start\":0,\"byte_end\":830},{\"index\":1,\"byte_start\":830,\"byte_end\":862},{\"index\":2,\"byte_start\":862,\"byte_end\":1087},{\"index\":3,\"byte_start\":1087,\"byte_end\":1244},{\"index\":4,\"byte_start\":1244,\"byte_end\":1304},{\"index\":5,\"byte_start\":1304,\"byte_end\":1380},{\"index\":6,\"byte_start\":1380,\"byte_end\":1509},{\"index\":7,\"byte_start\":1509,\"byte_end\":1586},{\"index\":8,\"byte_start\":1586,\"byte_end\":1741},{\"index\":9,\"byte_start\":1741,\"byte_end\":1756},{\"index\":10,\"byte_start\":1756,\"byte_end\":1776},{\"index\":11,\"byte_start\":1776,\"byte_end\":1813},{\"index\":12,\"byte_start\":1813,\"byte_end\":1843}],\"answer_sentence_indices\":[0,1,2,3,4,5,6],\"answer_offsets\":[{\"index\":0,\"byte_start\":0,\"byte_end\":226},{\"index\":1,\"byte_start\":226,\"byte_end\":318},{\"index\":2,\"byte_start\":318,\"byte_end\":393},{\"index\":3,\"byte_start\":393,\"byte_end\":500},{\"index\":4,\"byte_start\":500,\"byte_end\":562},{\"index\":5,\"byte_start\":562,\"byte_end\":758},{\"index\":6,\"byte_start\":758,\"byte_end\":924}]}<|im_end|>\n<|im_start|>assistant\n<think>\n\n</think>\n\n","generated":""}
