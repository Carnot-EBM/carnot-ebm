sampling":false,"lora":[]},"next_token":[{"has_next_token":false,"has_new_line":false,"n_remain":190,"n_decoded":66}],"prompt":"<|im_start|>user\n{\"instruction\":\"For each requested answer sentence emit index|E/C/B|p_unsupported with two decimals|[zero to two source segment indices]. One record per line in input order; no other text. Relations and addresses are predictions.\",\"source\":\"{\\\"address\\\":\\\"93 Castilian Dr\\\",\\\"attributes\\\":{\\\"Ambience\\\":null,\\\"BusinessParking\\\":{\\\"garage\\\":false,\\\"lot\\\":true,\\\"street\\\":false,\\\"valet\\\":false,\\\"validated\\\":false},\\\"Music\\\":null,\\\"OutdoorSeating\\\":null,\\\"RestaurantsGoodForGroups\\\":null,\\\"RestaurantsReservations\\\":null,\\\"RestaurantsTakeOut\\\":false,\\\"WiFi\\\":null},\\\"business_stars\\\":5.0,\\\"categories\\\":\\\"Arts & Entertainment, Wine Tasting Room, Bars, Wineries, Distilleries, Food, Cocktail Bars, Nightlife, Venues & Event Spaces, Beer, Wine & Spirits, Event Planning & Services\\\",\\\"city\\\":\\\"Goleta\\\",\\\"hours\\\":{\\\"Friday\\\":\\\"11:0-18:0\\\",\\\"Monday\\\":\\\"0:0-0:0\\\",\\\"Saturday\\\":\\\"11:0-18:0\\\",\\\"Sunday\\\":\\\"11:0-17:0\\\",\\\"Thursday\\\":\\\"11:0-17:0\\\",\\\"Wednesday\\\":\\\"11:0-17:0\\\"},\\\"name\\\":\\\"Goleta Red Distilling Company\\\",\\\"review_info\\\":[{\\\"review_date\\\":\\\"2021-05-28 14:46:47\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"We love this craft distillery!  All the spirits are delicious. Rum, Vodka, Agave...I especially love the Goodland Gin. The tasting room is right next to where Michael distills his stuff.\\\"},{\\\"review_date\\\":\\\"2021-05-02 02:37:40\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"This was a delightful surprise on our drive through. Some quite unique spirits and one of the best gins I've had. My wife can't stand gin, but insisted we buy a bottle. Definitely worth stopping by.\\\"},{\\\"review_date\\\":\\\"2021-04-15 05:15:08\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"Such a wonderful distillery/tasting room! Michael, the owner, is so friendly, knowledgeable and welcoming. We tried 5 different spirits and they were all great!! We especially liked the gin and brought a bottle home. I hope you support this amazing local business!! Highly recommended!!\\\"}],\\\"state\\\":\\\"CA\\\"}\",\"answer\":\"Goleta Red Distilling Company, located at 93 Castilian Dr in Goleta, CA, is a highly-rated local business known for its wide range of offerings. Its categories include Arts & Entertainment, Wine Tasting Room, Bars, Wineries, Distilleries, Food, Cocktail Bars, Nightlife, Venues & Event Spaces, Beer, Wine & Spirits, and Event Planning & Services. Open from Wednesday to Sunday, the company provides ample parking space but does not offer reservations, outdoor seating, Wi-Fi, live music, or takeout. The company has been highly praised in customer reviews for their tasty spirits, especially the gin. Customers have also lauded the owner, Michael, for his friendliness and knowledge. The distillery has a 5-star rating, reflecting its high-quality offerings and excellent customer service.\",\"source_segments\":[{\"index\":0,\"byte_start\":0,\"byte_end\":814},{\"index\":1,\"byte_start\":814,\"byte_end\":845},{\"index\":2,\"byte_start\":845,\"byte_end\":901},{\"index\":3,\"byte_start\":901,\"byte_end\":1095},{\"index\":4,\"byte_start\":1095,\"byte_end\":1156},{\"index\":5,\"byte_start\":1156,\"byte_end\":1211},{\"index\":6,\"byte_start\":1211,\"byte_end\":1356},{\"index\":7,\"byte_start\":1356,\"byte_end\":1421},{\"index\":8,\"byte_start\":1421,\"byte_end\":1476},{\"index\":9,\"byte_start\":1476,\"byte_end\":1531},{\"index\":10,\"byte_start\":1531,\"byte_end\":1580},{\"index\":11,\"byte_start\":1580,\"byte_end\":1617}],\"answer_sentence_indices\":[0,1,2,3,4,5],\"answer_offsets\":[{\"index\":0,\"byte_start\":0,\"byte_end\":145},{\"index\":1,\"byte_start\":145,\"byte_end\":347},{\"index\":2,\"byte_start\":347,\"byte_end\":500},{\"index