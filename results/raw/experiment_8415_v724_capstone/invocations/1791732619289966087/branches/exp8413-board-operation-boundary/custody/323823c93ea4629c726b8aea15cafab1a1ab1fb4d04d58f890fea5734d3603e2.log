yp_p","top_p","min_p","xtc","temperature"],"speculative.types":"none","timings_per_token":false,"post_sampling_probs":false,"backend_sampling":false,"lora":[]},"next_token":[{"has_next_token":false,"has_new_line":false,"n_remain":168,"n_decoded":88}],"prompt":"<|im_start|>user\n{\"instruction\":\"For each requested answer sentence emit index|E/C/B|p_unsupported with two decimals|[zero to two source segment indices]. One record per line in input order; no other text. Relations and addresses are predictions.\",\"source\":\"{\\\"address\\\":\\\"1 State St\\\",\\\"attributes\\\":{\\\"Ambience\\\":null,\\\"BusinessParking\\\":{\\\"garage\\\":null,\\\"lot\\\":false,\\\"street\\\":true,\\\"valet\\\":false,\\\"validated\\\":false},\\\"Music\\\":null,\\\"OutdoorSeating\\\":true,\\\"RestaurantsGoodForGroups\\\":null,\\\"RestaurantsReservations\\\":null,\\\"RestaurantsTakeOut\\\":null,\\\"WiFi\\\":\\\"free\\\"},\\\"business_stars\\\":5.0,\\\"categories\\\":\\\"Food, Bakeries, Restaurants, Patisserie/Cake Shop, Cafes, Coffee & Tea\\\",\\\"city\\\":\\\"Santa Barbara\\\",\\\"hours\\\":{\\\"Friday\\\":\\\"7:30-13:30\\\",\\\"Monday\\\":\\\"0:0-0:0\\\",\\\"Saturday\\\":\\\"7:30-13:30\\\",\\\"Sunday\\\":\\\"7:30-13:30\\\",\\\"Thursday\\\":\\\"7:30-13:30\\\",\\\"Tuesday\\\":\\\"7:30-13:30\\\",\\\"Wednesday\\\":\\\"7:30-13:30\\\"},\\\"name\\\":\\\"Jeannine’s American Bakery & Restaurant\\\",\\\"review_info\\\":[{\\\"review_date\\\":\\\"2022-01-19 17:31:21\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"Very nice place for breakfast close to Stearns Wharf. And if you like French toast, try the Kahula Banana! Wow! Amazing. \\\\n\\\\nService is excellent! Order at the bakery counter and your order will be served at your table. Indoor and outdoor seating. Good coffee too!\\\\n\\\\nThis is the breakfast place!\\\"},{\\\"review_date\\\":\\\"2022-01-19 03:51:07\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"Awesome location and great food. Customer service is top notch   and food comes out quick.\\\"},{\\\"review_date\\\":\\\"2022-01-15 17:48:18\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"I ordered the espresso chocolate chip scone and it was perfect! The breakfast looked delicious. The service was quick and great. Would recommend! Lovely seating looking out to the beach.\\\"}],\\\"state\\\":\\\"CA\\\"}\",\"answer\":\"Jeannine’s American Bakery & Restaurant is located on 1 State Street in Santa Barbara, California. It belongs to several categories including Food, Bakeries, Restaurants, Patisserie/Cake Shop, Cafes, and Coffee & Tea. The business operates from Monday to Sunday with hours varying slightly each day. Customers can park their vehicles on the street or in a nearby lot, but valet parking is not available. There are no reservations required for this restaurant, and both indoor and outdoor seating options are available. WiFi is free, and takeout is also offered. \\n\\nThe restaurant has received positive reviews from its customers. One customer praised the Kahula Banana French toast as \\\"amazing\\\" and noted that the service was excellent. Another customer commended the location and the food quality, while a third customer appreciated the fast service and the lovely seating area. Overall, Jeannine’s American Bakery & Restaurant seems like a popular spot for breakfast with good food, service, and ambiance.\",\"source_segments\":[{\"index\":0,\"byte_start\":0,\"byte_end\":775},{\"index\":1,\"byte_start\":775,\"byte_end\":828},{\"index\":2,\"byte_start\":828,\"byte_end\":833},{\"index\":3,\"byte_start\":833,\"byte_end\":842},{\"index\":4,\"byte_start\":842,\"byte_end\":868},{\"index\":5,\"byte_start\":868,\"byte_end\":941},{\"index\":6,\"byte_start\":941,\"byte_end\":969},{\"index\":7,\"byte_start\":969,\"byte_end\":1124},{\"index\":8,\"byte_start\":1124,\"byte_end\":1319},{\"index\":9,\"byte_start\":1319,\"byte_end\":1351},{\"index\":10,\"byte_start\":1351,\"byte_end\":1384},{\"index\":11,\"byte_start\":1384,\"byte_end\":1401