4.12.519.152 D srv  log_server_r: request:  {"messages": [{"role": "user", "content": "{\"instruction\":\"For each requested answer sentence emit index|E/C/B|p_unsupported with two decimals|[zero to two source segment indices]. One record per line in input order; no other text. Relations and addresses are predictions.\",\"source\":\"{\\\"address\\\":\\\"6530 Seville Rd, Ste 103\\\",\\\"attributes\\\":{\\\"Ambience\\\":{\\\"casual\\\":false,\\\"classy\\\":false,\\\"divey\\\":false,\\\"hipster\\\":false,\\\"intimate\\\":false,\\\"romantic\\\":false,\\\"touristy\\\":false,\\\"trendy\\\":false,\\\"upscale\\\":false},\\\"BusinessParking\\\":{\\\"garage\\\":false,\\\"lot\\\":false,\\\"street\\\":true,\\\"valet\\\":false,\\\"validated\\\":false},\\\"Music\\\":null,\\\"OutdoorSeating\\\":null,\\\"RestaurantsGoodForGroups\\\":true,\\\"RestaurantsReservations\\\":false,\\\"RestaurantsTakeOut\\\":true,\\\"WiFi\\\":\\\"free\\\"},\\\"business_stars\\\":4.0,\\\"categories\\\":\\\"Comfort Food, Bubble Tea, Restaurants, Tea Rooms, Asian Fusion, Coffee & Tea, Food\\\",\\\"city\\\":\\\"Isla Vista\\\",\\\"hours\\\":{\\\"Friday\\\":\\\"13:0-18:0\\\",\\\"Monday\\\":\\\"0:0-0:0\\\",\\\"Saturday\\\":\\\"13:0-18:0\\\",\\\"Sunday\\\":\\\"12:0-21:0\\\",\\\"Thursday\\\":\\\"12:0-21:0\\\",\\\"Tuesday\\\":\\\"12:0-21:0\\\",\\\"Wednesday\\\":\\\"12:0-21:0\\\"},\\\"name\\\":\\\"Mojo Asian Fusion Caf\u00e9\\\",\\\"review_info\\\":[{\\\"review_date\\\":\\\"2021-12-10 02:22:47\\\",\\\"review_stars\\\":2.0,\\\"review_text\\\":\\\"Terrible food but good drinks. Wasn't able to try any of the tapas because their fryer was broken but I got the chicken teriyaki and honey bbq pork rice bowls with cloudy jasmine milk tea and Hokkaido milk tea with cheese foam. The chicken teriyaki was super dry even though it was dark meat and the honey bbq pork was super fatty with not much flavor. The rice was mushy and gross, you can tell a lot about how good an Asian restaurant is by how good their rice is. And in this case, both the entree and the rice was awful. However, if you're just going for drinks, it's not bad! But I won't be returning especially since Kaiju is MUCH better.\\\"},{\\\"review_date\\\":\\\"2021-08-25 01:21:52\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"Love love love Mojo! Get the popcorn chicken, IT IS A MUST. The customer service is also always great. Justin and Boxi have never failed to make you feel welcome and are always ready with recommendations!\\\"},{\\\"review_date\\\":\\\"2021-08-12 05:32:12\\\",\\\"review_stars\\\":4.0,\\\"review_text\\\":\\\"Let me start off by saying this was my first boba place, I didn't like boba at first but after my girlfriend converting me into a boba diva I went back to discover that it's actually not all that bad. I always get the jasmine milk tea which is good the boba is only ok, but the wonder Is in the chicken dear god it had me seeing colors like in ratatouille.\\\"}],\\\"state\\\":\\\"CA\\\"}\",\"answer\":\"Mojo Asian Fusion Caf\u00e9 is a popular eatery located in the heart of Isla Vista, CA, offering a diverse menu of comfort food, bubble tea, and Asian fusion dishes. With a cozy and inviting atmosphere, the caf\u00e9 is well-known for its delicious popcorn chicken and exceptional customer service. The menu offers a variety of options, including rice bowls, noodles, and soups, as well as a range of teas and coffee. While some customers have reported mixed experiences with the food, the caf\u00e9 consistently receives high praise for its tasty drinks and friendly staff. With a 4.0-star rating and positive reviews, Mojo Asian Fusion Caf\u00e9 is a great spot for anyone looking for a casual and relaxed dining experience.\",\"source_segments\":[{\"index\":0,\"byte_start\":0,\"byte_end\":892},{\"index\":1,\"byte_start\":892,\"byte_end\":1089},{\"index\":2,\"byte_start\":1089,\"byte_end\":1214},{\"index\":3,\"byte_start\":1214,\"byte_end\":1328},{\"index\":4,\"byte_start\":1328,\"byte_end\":1386},{\"index\":5,\"byte_start\":1386,\"byte_end\":1442},{\"index\":6,\"byte_start\":1442,\"byte_end\":1600},{\"index\":7,\"byte_start\":1600,\"byte_end\":1639},{\"index\":8,\"byte_start\":1639,\"byte_end\":1682},{\"index\":9,\"byte_start\":1682,\"byte_end\":2058},{\"index\":10,\"byte_start\":2058,\"byte_end\":2230}],\"answer_sentence_indices\":[0,1,2,3,4],\"answer_offsets\":[{\"index\":0,\"byte_start\":0,\"byte_end\":162},{\"index\":1,\"byte_start\":162,\"byte_end\":291},{\"index\":2,\"byte_start\":291,\"byte_end\":410},{\"index\":3,\"byte_start\":410,\"byte_end\":563},{\"index\":4,\"byte_start\":563,\"byte_end\":710}]}"}], "add_generation_prompt": true, "chat_template_kwargs": {"enable_thinking": false}}
4.12.519.152 D srv  log_server_r: response: {"prompt":"<|im_start|>user\n{\"instruction\":\"For each requested answer sentence emit index|E/C/B|p_unsupported with two decimals|[zero to two source segment indices]. One record per line in input order; no other text. Relations and addresses are predictions.\",\"source\":\"{\\\"address\\\":\\\"6530 Seville Rd, Ste 103\\\",\\\"attributes\\\":{\\\"Ambience\\\":{\\\"casual\\\":false,\\\"classy\\\":false,\\\"divey\\\":false,\\\"hipster\\\":false,\\\"intimate\\\":false,\\\"romantic\\\":false,\\\"touristy\\\":false,\\\"trendy\\\":false,\\\"upscale\\\":false},\\\"BusinessParking\\\":{\\\"garage\\\":false,\\\"lot\\\":false,\\\"street\\\":true,\\\"valet\\\":false,\\\"validated\\\":false},\\\"Music\\\":null,\\\"OutdoorSeating\\\":null,\\\"RestaurantsGoodForGroups\\\":true,\\\"RestaurantsReservations\\\":false,\\\"RestaurantsTakeOut\\\":true,\\\"WiFi\\\":\\\"free\\\"},\\\"business_stars\\\":4.0,\\\"categories\\\":\\\"Comfort Food, Bubble Tea, Restaurants, Tea Rooms, Asian Fusion, Coffee & Tea, Food\\\",\\\"city\\\":\\\"Isla Vista\\\",\\\"hours\\\":{\\\"Friday\\\":\\\"13:0-18:0\\\",\\\"Monday\\\":\\\"0:0-0:0\\\",\\\"Saturday\\\":\\\"13:0-18:0\\\",\\\"Sunday\\\":\\\"12:0-21:0\\\",\\\"Thursday\\\":\\\"12:0-21:0\\\",\\\"Tuesday\\\":\\\"12:0-21:0\\\",\\\"Wednesday\\\":\\\"12:0-21:0\\\"},\\\"name\\\":\\\"Mojo Asian Fusion Café\\\",\\\"review_info\\\":[{\\\"review_date\\\":\\\"2021-12-10 02:22:47\\\",\\\"review_stars\\\":2.0,\\\"review_text\\\":\\\"Terrible food but good drinks. Wasn't able to try any of the tapas because their fryer was broken but I got the chicken teriyaki and honey bbq pork rice bowls with cloudy jasmine milk tea and Hokkaido milk tea with cheese foam. The chicken teriyaki was super dry even though it was dark meat and the honey bbq pork was super fatty with not much flavor. The rice was mushy and gross, you can tell a lot about how good an Asian restaurant is by how good their rice is. And in this case, both the entree and the rice was awful. However, if you're just going for drinks, it's not bad! But I won't be returning especially since Kaiju is MUCH better.\\\"},{\\\"review_date\\\":\\\"2021-08-25 01:21:52\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"Love love love Mojo! Get the popcorn chicken, IT IS A MUST. The customer service is also always great. Justin and Boxi have never failed to make you feel welcome and are always ready with recommendations!\\\"},{\\\"review_date\\\":\\\"2021-08-12 05:32:12\\\",\\\"review_stars\\\":4.0,\\\"review_text\\\":\\\"Let me start off by saying this was my first boba place, I didn't like boba at first but after my girlfriend converting me into a boba diva I went back to discover that it's actually not all that bad. I always get the jasmine milk tea which is good the boba is only ok, but the wonder Is in the chicken dear god it had me seeing colors like in ratatouille.\\\"}],\\\"state\\\":\\\"CA\\\"}\",\"answer\":\"Mojo Asian Fusion Café is a popular eatery located in the heart of Isla Vista, CA, offering a diverse menu of comfort food, bubble tea, and Asian fusion dishes. With a cozy and inviting atmosphere, the café is well-known for its delicious popcorn chicken and exceptional customer service. The menu offers a variety of options, including rice bowls, noodles, and soups, as well as a range of teas and coffee. While some customers have reported mixed experiences with the food, the café consistently receives high praise for its tasty drinks and friendly staff. With a 4.0-star rating and positive reviews, Mojo Asian Fusion Café is a great spot for anyone looking for a casual and relaxed dining experience.\",\"source_segments\":[{\"index\":0,\"byte_start\":0,\"byte_end\":892},{\"index\":1,\"byte_start\":892,\"byte_end\":1089},{\"index\":2,\"byte_start\":1089,\"byte_end\":1214},{\"index\":3,\"byte_start\":1214,\"byte_end\":1328},{\"index\":4,\"byte_start\":1328,\"byte_end\":1386},{\"index\":5,\"byte_start\":1386,\"byte_end\":1442},{\"index\":6,\"byte_start\":1442,\"byte_end\":1600},{\"index\":7,\"byte_start\":1600,\"byte_end\":1639},{\"index\":8,\"byte_start\":1639,\"byte_end\":1682},{\"index\":9,\"byte_start\":1682,\"byte_end\":2058},{\"index\":10,\"byte_start\":2058,\"byte_end\":2230}],\"answer_sentence_indices\":[0,1,2,3,4],\"answer_offsets\":[{\"index\":0,\"byte_start\":0,\"byte_end\":162},{\"index\":1,\"byte_start\":162,\"byte_end\":291},{\"index\":2,\"byte_start\":291,\"byte_end\":410},{\"index\":3,\"byte_start\":410,\"byte_end\":563},{\"index\":4,\"byte_start\":563,\"byte_end\":710}]}<|im_end|>\n<|im_start|>assistant\n<think>\n\n</think>\n\n"}
