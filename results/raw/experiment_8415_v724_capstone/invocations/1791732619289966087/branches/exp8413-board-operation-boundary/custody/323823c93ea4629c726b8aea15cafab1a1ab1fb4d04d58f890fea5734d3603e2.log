s":["penalties","dry","top_n_sigma","top_k","typ_p","top_p","min_p","xtc","temperature"],"speculative.types":"none","timings_per_token":false,"post_sampling_probs":false,"backend_sampling":false,"lora":[]},"next_token":[{"has_next_token":false,"has_new_line":false,"n_remain":165,"n_decoded":91}],"prompt":"<|im_start|>user\n{\"instruction\":\"For each requested answer sentence emit index|E/C/B|p_unsupported with two decimals|[zero to two source segment indices]. One record per line in input order; no other text. Relations and addresses are predictions.\",\"source\":\"{\\\"address\\\":\\\"1332 Santa Barbara St\\\",\\\"attributes\\\":{\\\"Ambience\\\":null,\\\"BusinessParking\\\":{\\\"garage\\\":false,\\\"lot\\\":false,\\\"street\\\":true,\\\"valet\\\":false,\\\"validated\\\":false},\\\"Music\\\":null,\\\"OutdoorSeating\\\":false,\\\"RestaurantsGoodForGroups\\\":null,\\\"RestaurantsReservations\\\":null,\\\"RestaurantsTakeOut\\\":null,\\\"WiFi\\\":null},\\\"business_stars\\\":5.0,\\\"categories\\\":\\\"Matchmakers, Professional Services, Local Flavor, Nightlife, Life Coach\\\",\\\"city\\\":\\\"Santa Barbara\\\",\\\"hours\\\":{\\\"Friday\\\":\\\"9:0-17:0\\\",\\\"Monday\\\":\\\"0:0-0:0\\\",\\\"Thursday\\\":\\\"9:0-17:0\\\",\\\"Tuesday\\\":\\\"9:0-17:0\\\",\\\"Wednesday\\\":\\\"9:0-17:0\\\"},\\\"name\\\":\\\"Amador Matchmaking\\\",\\\"review_info\\\":[{\\\"review_date\\\":\\\"2020-02-22 17:04:15\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"I've known lisa since shortly after she moved to Santa Barbara to start her match making business. I believe she is successful because she cares about her community locally and further afield. She brongs her heart not only to her work, but to all her relationships. When you meet her, you will see that she sees you as a human being with unique and important wants and needs. Her great comment to serve is un-matched! Go for it!\\\"},{\\\"review_date\\\":\\\"2020-01-27 18:42:30\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"If you find yourself single like I am and you're committed to finding someone special, I hope this review will be valuable. I want to recommend the perfect person to help you. Her name is Lisa Amador. She is an experienced matchmaker with all the skills and contacts to change your status from lonely to lively. I have tried online dating services. If you are particular about whom you wish to spend time with and if your time is valuable to you, just forget about them. Here's why: Lisa will only take you as a client after at least one consultation to get to know you, your personality and priorities. She will charge you a very fair amount for that meeting. She will then check your background (with your permission), create a confidential profile to share with candidates, then set up in-person dates. Lisa's integrity and professionalism is unquestioned. Her dedication to and enthusiasm for seeking out a match for you is inspirational. Importantly, the candidates she recommends will be vetted as well. That is the critical difference. You will meet people already matched with you in many ways. You can be confident they are not \\\\\\\"players,\\\\\\\" gold-diggers or users. They are genuine people like you looking for companionship and commitment. That is such a refreshing head start in this challenging process. If you are serious about your search, you need Lisa to have your back. I can no longer imagine doing this without her assistance. If you wonder why you would pay good money for a matchmaker, I did, too. I quickly realized that working with Lisa means you are investing in yourself, believing in yourself and knowing you are worth it. I love it that the other person is making that same investment. What's more important than your joy and happiness? If you are ready; if you want to stop dreaming and start meeting great potential lifemates, start with a consultation with Lisa. I'm very happy I did and I recommend her without reservation.\\\"},{\\\"review_date\\\":\\\"2018-02-20 15:31:07\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"Lisa's energy is contagious and it is obvious she is very good at her job. I really appreciated her sincerity and how enjoyable she made the process. Lisa is committed to her clients and has been a pleasure to get to know.\\\"}],\\\"state\\\":\\\"CA\\\"}\",\"answer\":\"Amador Matchmaking is a professional matchmaking service located in Santa Barbara, CA, owned by Lisa Amador. The business offers a personalized approach to helping individuals find their perfect match, focusing on building genuine connections and fostering long-term relationships. Lisa takes the time to get to know each client through a consultation process, creating a tailored matchmaking experience. Her dedication to integrity and professionalism is evident in her thorough background checks and careful selection of compatible matches. Clients appreciate her enthusiasm and commitment to their search for a partner, as well as her ability to create a safe and trustworthy environment for them to explore their romantic options. With a 5-star rating and glowing reviews, Amador Matchmaking stands out as a top choice for those seeking a reliable and effective matchmaking service in the area.\",\"source_segments\":[{\"index\":0,\"byte_start\":0,\"byte_end\":755},{\"index\":1,\"byte_start\":755,\"byte_end\":849},{\"index\":2,\"byte_start\":849,\"byte_end\":922},{\"index\":3,\"byte_start\":922,\"byte_end\":1032},{\"index\":4,\"byte_start\":1032,\"byte_end\":1074},{\"index\":5,\"byte_start\":1074,\"byte_end\":1282},{\"index\":6,\"byte_start\":1282,\"byte_end\":1334},{\"index\":7,\"byte_start\":1334,\"byte_end\":1359},{\"index\":8,\"byte_start\":1359,\"byte_end\":1470},{\"index\":9,\"byte_start\":1470,\"byte_end\":1507},{\"index\":10,\"byte_start\":1507,\"byte_end\":1629},{\"index\":11,\"byte_start\":1629,\"byte_end\":1762},{\"index\":12,\"byte_start\":1762,\"byte_end\":1819},{\"index\":13,\"byte_start\":1819,\"byte_end\":1964},{\"index\":14,\"byte_start\":1964,\"byte_end\":2018},{\"index\":15,\"byte_start\":2018,\"byte_end\":2101},{\"index\":16,\"byte_start\":2101,\"byte_end\":2168},{\"index\":17,\"byte_start\":2168,\"byte_end\":2201},{\"index\":18,\"byte_start\":2201,\"byte_end\":2261},{\"index\":19,\"byte_start\":2261,\"byte_end\":2331},{\"index\":20,\"byte_start\":2331,\"byte_end\":2406},{\"index\":21,\"byte_start\":2406,\"byte_end\":2472},{\"index\":22,\"byte_start\":2472,\"byte_end\":2543},{\"index\":23,\"byte_start\":2543,\"byte_end\":2602},{\"index\":24,\"byte_start\":2602,\"byte_end\":2675},{\"index\":25,\"byte_start\":2675,\"byte_end\":2806},{\"index\":26,\"byte_start\":2806,\"byte_end\":2870},{\"index\":27,\"byte_start\":2870,\"byte_end\":2921},{\"index\":28,\"byte_start\":2921,\"byte_end\":3050},{\"index\":29,\"byte_start\":3050,\"byte_end\":3260},{\"index\":30,\"byte_start\":3260,\"byte_end\":3335},{\"index\":31,\"byte_start\":3335,\"byte_end\":3424}],\"answer_sentence_indices\":[0,1,2,3,4,5],\"answer_offsets\":[{\"index\":0,\"byte_start\":0,\"byte_end\":109},{\"index\":1,\"byte_start\":109,\"byte_end\":282},{\"index\":2,\"byte_start\":282,\"byte_end\":405},{\"index\":3,\"byte_start\":405,\"byte_end\":543},{\"index\":4,\"byte_start\":543,\"byte_end\":735},{\"index\":5,\"byte_start\":735,\"byte_end\":898}]}<|im_end|>\n<|im_start|>assistant\n<think>\n\n</think>\n\n","generated":""}
