"top_p","min_p","xtc","temperature"],"speculative.types":"none","timings_per_token":false,"post_sampling_probs":false,"backend_sampling":false,"lora":[]},"next_token":[{"has_next_token":false,"has_new_line":false,"n_remain":168,"n_decoded":88}],"prompt":"<|im_start|>user\n{\"instruction\":\"For each requested answer sentence emit index|E/C/B|p_unsupported with two decimals|[zero to two source segment indices]. One record per line in input order; no other text. Relations and addresses are predictions.\",\"source\":\"{\\\"address\\\":\\\"30 E Victoria St\\\",\\\"attributes\\\":{\\\"Ambience\\\":{\\\"casual\\\":null,\\\"classy\\\":null,\\\"divey\\\":false,\\\"hipster\\\":false,\\\"intimate\\\":null,\\\"romantic\\\":null,\\\"touristy\\\":false,\\\"trendy\\\":false,\\\"upscale\\\":false},\\\"BusinessParking\\\":{\\\"garage\\\":null,\\\"lot\\\":false,\\\"street\\\":true,\\\"valet\\\":false,\\\"validated\\\":false},\\\"Music\\\":null,\\\"OutdoorSeating\\\":null,\\\"RestaurantsGoodForGroups\\\":true,\\\"RestaurantsReservations\\\":true,\\\"RestaurantsTakeOut\\\":true,\\\"WiFi\\\":\\\"no\\\"},\\\"business_stars\\\":4.0,\\\"categories\\\":\\\"Italian, Restaurants\\\",\\\"city\\\":\\\"Santa Barbara\\\",\\\"hours\\\":{\\\"Friday\\\":\\\"17:0-22:0\\\",\\\"Saturday\\\":\\\"17:0-22:0\\\",\\\"Sunday\\\":\\\"17:0-21:0\\\",\\\"Thursday\\\":\\\"17:0-21:0\\\",\\\"Tuesday\\\":\\\"17:0-21:0\\\",\\\"Wednesday\\\":\\\"17:0-21:0\\\"},\\\"name\\\":\\\"Trattoria Vittoria\\\",\\\"review_info\\\":[{\\\"review_date\\\":\\\"2022-01-09 04:55:39\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"Great italian food. came here on a whim and thorough enjoyed it. will return next time i'm visiting santa barbara.\\\"},{\\\"review_date\\\":\\\"2021-12-11 08:50:25\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"Their homemade pasta dishes, lasagna, tortellini and ravioli with a heavenly tomato sauce was definitely one of the most delicious dishes I've tried (and then I've been to Italy). The servers where so funny and genuine, too. We'll be back in SB when we get the chance!\\\"},{\\\"review_date\\\":\\\"2021-12-08 17:23:35\\\",\\\"review_stars\\\":4.0,\\\"review_text\\\":\\\"We had an early dinner here. It filled up fast so if you can make reservations you should. \\\\n\\\\nWe had an awesome dinner. Atmosphere was perfect.  Wine was delicious and the service was great. \\\\n\\\\nNext time I will come early and have a drink at the bar. Looked like a fun crowd. Enjoy!\\\"}],\\\"state\\\":\\\"CA\\\"}\",\"answer\":\"Trattoria Vittoria is an Italian restaurant located at 30 E Victoria St in Santa Barbara, CA. The restaurant offers a variety of Italian dishes and is known for its great food. Customers have praised the homemade pasta dishes, including lasagna, tortellini, and ravioli, which are served with a heavenly tomato sauce. The servers at Trattoria Vittoria are described as funny and genuine, providing excellent service.\\n\\nThe restaurant is open from 5:00 PM to 9:00 PM on Tuesdays, Wednesdays, and Thursdays, and from 5:00 PM to 10:00 PM on Fridays and Saturdays. On Sundays, it is open from 5:00 PM to 9:00 PM. Trattoria Vittoria accepts reservations and is good for groups. Takeout is also available for those who prefer to enjoy their meals at home.\\n\\nIn terms of amenities, the restaurant does not offer valet parking or a garage, but street parking is available. The atmosphere is described as perfect and the wine selection is delicious. The restaurant does not offer WiFi, but customers have mentioned that the ambiance is enjoyable.\\n\\nOverall, Trattoria Vittoria has received positive reviews from customers, with an average rating of 4.0 stars. Visitors have praised the quality of the food, service, and atmosphere. It is a recommended spot for Italian cuisine in Santa Barbara.\",\"source_segments\":[{\"index\":0,\"byte_start\":0,\"byte_end\":782},{\"index\":1,\"byte_start\":782,\"byte_end\":827},{\"index\":2,\"byte_start\":827,\"byte_end\":1130},{\"index\":3,\"byte_start\":1130,\"byte_end\":1175},{\"index\":4,\"byte_start\":1175,\"byte_end\":1321},{\"index\":5,\"byte_start\":1321,\"byte_end\":1383},{\"index\":6,\"byte_start\":1383,\"byte_end\":1413},{\"index\":7,\"byte_start\":1413,\"byte_end\":1438},{\"index\":8,\"byte_start\":1438,\"byte_end\":1484},{\"index\":9,\"byte_start\":1484,\"byte_end\":1545},{\"index\":10,\"byte_start\":1545,\"byte_end\":1570},{\"index\":11,\"byte_start\":1570,\"byte_end\":1593}],\"answer_sentence_indices\":[0,1,2,3,4,5,6,7],\"answer_offsets\":[{\"index\":0,\"byte_start\":0,\"byte_end\":94},{\"index\":1,\"byte_start\":94,\"byte_end\":177},{\"index\":2,\"byte_start\":177,\"byte_end\":318},{\"index\":3,\"byte_start\":318,\"byte_end\":418},{\"index\":4,\"byte_start\":418,\"byte_end\":560},{\"index\":5,\"byte_start\":560,\"byte_end\":608},{\"index\":6,\"byte_start\":608,\"byte_end\":672},{\"index\":7,\"byte_start\":672,\"byte_end\":750},{\"index\":8,\"byte_start\":750,\"byte_end\":863},{\"index\":9,\"byte_start\":863,\"byte_end\":939},{\"index\":10,\"byte_start\":939,\"byte_end\":1037},{\"index\":11,\"byte_start\":1037,\"byte_end\":1148},{\"index\":12,\"byte_start\":1148,\"byte_end\":1220},{\"index\":13,\"byte_start\":1220,\"byte_end\":1282}]}<|im_end|>\n<|im_start|>assistant\n<think>\n\n</think>\n\n","generated":""}
