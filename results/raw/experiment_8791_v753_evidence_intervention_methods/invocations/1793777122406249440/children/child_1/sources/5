def test_readiness_diagnostics_and_source_drift(tmp_path, monkeypatch):
    """REQ-VERIFY-8791: missing fields, zero, foreign identity and changed source remain distinct."""
    for producer, check in [
        ({}, "missing_field"),
        ({"evidence_methods_ready_score": 0}, "observed_zero"),
        ({"evidence_methods_ready_score": 1, "task_id": "alias"}, "rejected_producer"),
    ]:
        path = tmp_path / "producer.json"
        atomic_json(path, producer)
        result = m.authenticate(path, m.UPSTREAM_ROWS)
        assert result["diagnostics"][0]["check"] == check
    real_reference = m.reference
    selected = m.ROOT / m.original.OWNED[0]

    def changed_reference(path):
        value = real_reference(path)
        return dict(value, sha256="changed") if path == selected else value

    monkeypatch.setattr(m, "reference", changed_reference)
    result = m.authenticate(m.UPSTREAM_METHOD, m.UPSTREAM_ROWS)
    assert (
        not result["passed"] and result["diagnostics"][0]["diagnostic"] == "historical_source_drift"
    )


def test_replay_reconstructs_despite_repaired_seals(private_artifact, tmp_path, monkeypatch):
    """SCENARIO-VERIFY-8791-REPLAY: repaired hashes cannot authenticate corrupt oracle labels."""
    value = json.loads(private_artifact.read_bytes())
    work = load(value["primitive_reference"])
    with monkeypatch.context() as patch:
        patch.setattr(report, "audit_validation", lambda _: False)
        assert not report.replay(private_artifact)
    with monkeypatch.context() as patch:
        patch.setattr(m, "authenticate", lambda *args: dict(passed=False))
        assert not report.replay(private_artifact)
    real_reference = report.reference
    with monkeypatch.context() as patch:
        patch.setattr(
            report, "reference", lambda path: dict(real_reference(path), sha256="changed")
        )
        assert not report.replay(private_artifact)
    frozen_path = Path(work["frozen_reference"]["path"])
    frozen = load(work["frozen_reference"])
    frozen["fixtures"][0]["expected"] = "refute"
    atomic_json(frozen_path, frozen)
    work["frozen_reference"] = reference(frozen_path)
    work["shards"] = [reference(Path(r["path"])) for r in work["shards"]]
    work_path = Path(value["primitive_reference"]["path"])
    atomic_json(work_path, work)
    value["primitive_reference"] = reference(work_path)
    seal_path = work_path.parent / "independent_seal.json"
    atomic_json(seal_path, {k: value[k] for k in ["primitive_reference", "validation_reference"]})
    atomic_json(private_artifact, value)
    assert not report.replay(private_artifact)
