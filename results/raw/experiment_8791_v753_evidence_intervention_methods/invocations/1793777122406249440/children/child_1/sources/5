def test_authentication_and_diagnostics(tmp_path):
    """REQ-VERIFY-8791: exact producer bytes cannot be replaced with aliases or zero gates."""
    assert m.authenticate(m.UPSTREAM_METHOD, m.UPSTREAM_ROWS)["passed"]
    for target in [tmp_path / "absent", tmp_path / "altered.json"]:
        if target.name == "altered.json":
            atomic_json(target, dict(experiment_id=8777, evidence_methods_ready_score=0))
        result = m.authenticate(target, m.UPSTREAM_ROWS)
        assert not result["passed"]
        assert {
            "upstream",
            "path",
            "sha256",
            "check",
            "field",
            "operator",
            "expected",
            "observed",
        } <= result["diagnostics"][0].keys()
    assert not m.authenticate(m.UPSTREAM_METHOD, tmp_path / "absent")["passed"]


def test_roster_and_balanced_projection():
    """REQ-REPORT-8791: reserved graphs never become measured independent worlds."""
    manifest = c.roster()
    assert len(manifest["worlds"]) == 120
    assert {r["edge_count"] for r in manifest["worlds"]} == {11, 12, 13}
    assert manifest["disjoint"] and manifest["reserved_learning_edge_counts"] == [8, 9, 10]
    fixtures = c.fixtures()
    assert len(fixtures) == 24
    assert c.audit(fixtures)
    assert len({r["world_id"] for r in fixtures}) == 1
    assert {r["condition"] for r in fixtures} == set(c.CONDITIONS)
    for r in fixtures:
        assert set(r["input"]) == {"facts", "query"}
        assert c.tokens(r["input"]) == r["token_bin"]
    for bin_size in c.BINS:
        group = [r for r in fixtures if r["token_bin"] == bin_size]
        assert sum(r["expected"] == "support" for r in group) == 6
    for field, value in [("expected", "refute"), ("token_bin", 7), ("condition", "hidden")]:
        bad = deepcopy(fixtures)
        bad[0][field] = value
        assert not c.audit(bad)
    with pytest.raises(ValueError, match="padding"):
        c.pad(fixtures[0]["input"], 1)


def test_semantics_metamorphisms_and_real_costs():
    """SCENARIO-REPORT-8791-INTERVENTIONS: absence is unknown and alternatives are accepted."""
    rows = m.measure([r["input"] for r in c.fixtures()])
    assert len(rows) == 72
    assert m.audit(c.fixtures(), rows)
    for i, fixture in enumerate(c.fixtures()):
        row = rows[i * 3 + 2]
        assert row["decision"] == fixture["expected"]
        assert row["primitive_operations"] > row["evaluator_invocations"]
        assert row["predicate_inspections"] > 0
        renamed = c.rename(fixture["input"])
        assert m.strong(renamed) == row["decision"]
    for payload, expected in c.counterexamples():
        assert m.strong(payload) == expected
    assert m.strong(dict(facts=[], query=[["a", "r", "b"]])) == "insufficient"
    assert m.strong(dict(facts=[["a", "r", "b", False]], query=[["a", "r", "b"]])) == "refute"
    long = dict(facts=[], query=[["a", str(i), "b"] for i in range(6)])
    assert m.evaluate("local_record", long)[1] == 5
    with pytest.raises(ValueError, match="arm"):
        m.evaluate("bad", long)
    for field in ["label", "condition", "world_id"]:
        with pytest.raises(ValueError, match="input_fields"):
            m.measure([dict(long, **{field: "leaked"})])
    bad = deepcopy(rows)
    bad[0]["decision"] = "invented"
    assert not m.audit(c.fixtures(), bad)
    assert not m.audit(c.fixtures(), rows[:-1])


