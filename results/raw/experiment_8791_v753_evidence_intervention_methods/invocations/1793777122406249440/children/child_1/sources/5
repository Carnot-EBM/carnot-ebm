def test_cli_terminal_and_rehashed_attacks(private_artifact, tmp_path):
    """SCENARIO-VERIFY-8791-REPLAY: fresh replay rejects rewritten reductions and primitive seals."""
    value = json.loads(private_artifact.read_bytes())
    assert (
        value["verdict_class"] == "disqualified"
        and value["evidence_interventions_ready_score"] == 0
    )
    assert report.replay(private_artifact)
    replay = child(
        "cold8791",
        [sys.executable, m.CLI, "--cold-replay", str(private_artifact)],
        tmp_path / "cold",
        deadline=60,
    )
    assert replay["passed"]
    bad = deepcopy(value)
    bad["rows"][0]["decision"] = "tampered"
    bad.pop("reproducibility_checksum")
    bad["reproducibility_checksum"] = canonical_hash(bad)
    altered = tmp_path / "tamper.json"
    atomic_json(altered, bad)
    assert not report.replay(altered)
    assert not report.replay(tmp_path / "absent")
    work_path = Path(value["primitive_reference"]["path"])
    work = load(value["primitive_reference"])
    work["run_date"] = "forged"
    atomic_json(work_path, work)
    value["primitive_reference"] = reference(work_path)
    atomic_json(altered, value)
    assert not report.replay(altered)


