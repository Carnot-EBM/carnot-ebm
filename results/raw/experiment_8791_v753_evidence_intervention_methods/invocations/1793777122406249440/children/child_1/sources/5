def test_missing_dependency_blocks_and_failed_child_disqualifies(tmp_path, monkeypatch):
    """REQ-VERIFY-8791: external failure never starts decisions; failed owned work cannot block."""
    monkeypatch.setattr(
        runner.validator, "validate", lambda raw, private: runner.previous.private_validation(raw)
    )
    real_pre = runner.preconditions

    def absent(private):
        raise OSError("private scratch unavailable")

    monkeypatch.setattr(runner, "preconditions", absent)
    output = tmp_path / "blocked" / (m.NAME + ".json")
    assert runner.main(["--output", str(output)]) == 0
    assert json.loads(output.read_bytes())["verdict_class"] == "blocked"
    monkeypatch.setattr(runner, "preconditions", real_pre)

    def failed_child(*args, **kwargs):
        return dict(passed=False)

    monkeypatch.setattr(runner, "child", failed_child)
    output = tmp_path / "failed" / (m.NAME + ".json")
    assert runner.main(["--output", str(output)]) == 0
    assert json.loads(output.read_bytes())["verdict_class"] == "disqualified"


