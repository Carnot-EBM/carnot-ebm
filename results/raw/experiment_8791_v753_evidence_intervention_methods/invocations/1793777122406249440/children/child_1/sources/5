def test_normal_entry_and_blocked_entry(tmp_path, monkeypatch):
    """REQ-VERIFY-8791: failed owned checks disqualify, while external absence blocks."""
    monkeypatch.setattr(
        runner.validator,
        "validate",
        runner.previous.private_validation_adapter
        if hasattr(runner.previous, "private_validation_adapter")
        else lambda raw, private: runner.previous.private_validation(raw),
    )
    output = tmp_path / (m.NAME + ".json")
    assert runner.main(["--output", str(output)]) == 0
    value = json.loads(output.read_bytes())
    work, validation = load(value["primitive_reference"]), load(value["validation_reference"])
    qualified = deepcopy(validation)
    qualified.update(
        receipts=[dict(passed=True)], union=dict(passed=True), coverage=dict(complete=True)
    )
    assert report.build(work, qualified, output)["evidence_interventions_ready_score"] == 1
    blocked = tmp_path / "blocked" / output.name
    assert (
        runner.main(["--output", str(blocked), "--upstream-method", str(tmp_path / "absent")]) == 0
    )
    blocked_value = json.loads(blocked.read_bytes())
    assert blocked_value["verdict_class"] == "blocked" and blocked_value["completed_count"] == 0
    assert report.replay(blocked)
    bad_validation = deepcopy(validation)
    bad_validation["receipts"] = []
    assert report.build(work, bad_validation, output)["verdict_class"] == "disqualified"


