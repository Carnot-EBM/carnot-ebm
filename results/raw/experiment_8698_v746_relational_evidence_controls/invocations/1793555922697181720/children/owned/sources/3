def test_replay_seals_and_sources(tmp_path, monkeypatch):
    """SCENARIO-REPORT-8698-CUSTODY: source, seal, corpus and contract edits each fail."""
    output = tmp_path / (e.NAME + ".json")
    r.run(output, private=True)
    value = json.loads(output.read_bytes())
    path = Path(value["primitive_reference"]["path"])
    original = path.read_bytes()
    pristine = json.loads(original)
    for change in ["source", "seal", "corpus", "contract"]:
        work = deepcopy(pristine)
        if change == "source":
            work["sources"][0]["sha256"] = "bad"
        if change == "corpus":
            work["corpus"]["rows"][0]["actual_truth"] = 0
        if change == "contract":
            work["contract"]["ready"] = False
        if change == "seal":
            work["duration_s"] += 1
        if change != "seal":
            seal = tmp_path / ("seal-" + change + ".json")
            atomic_json(seal, {k: v for k, v in work.items() if k != "seal_reference"})
            work["seal_reference"] = e.reference(seal)
        atomic_json(path, work)
        candidate = dict(value, primitive_reference=e.reference(path))
        candidate["reproducibility_checksum"] = e.checksum(candidate)
        atomic_json(output, candidate)
        assert not r.replay(output)
    path.write_bytes(original)
    monkeypatch.setattr(r.time, "monotonic_ns", iter([0, 3601 * 10**9]).__next__)
    with pytest.raises(ValueError, match="measurement_cap"):
        r.run(tmp_path / "cap" / output.name, private=True)


