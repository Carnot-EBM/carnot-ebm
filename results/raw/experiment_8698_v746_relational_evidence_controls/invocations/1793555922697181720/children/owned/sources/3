def test_failed_retention_and_resources(tmp_path, monkeypatch):
    """SCENARIO-REPORT-8698-CUSTODY: incomplete owned evidence cannot qualify a producer."""
    original = r.shared.preconditions
    monkeypatch.setattr(
        r.shared, "preconditions", lambda path: dict(original(path), free_memory_kib=0)
    )
    output = tmp_path / (e.NAME + ".json")
    r.run(output, private=True)
    work = e.load(json.loads(output.read_bytes())["primitive_reference"])
    assert not work["inputs"]["passed"]
    monkeypatch.setattr(r.shared, "preconditions", original)
    collection = tmp_path / "collection.stdout"
    collection.write_text("\n".join([e.TESTS[0] + "::test_all_worlds", *r.CONSUMERS]))
    err = tmp_path / "stderr"
    err.write_text("")
    receipt = dict(
        name="failed",
        stdout_path=str(collection),
        stderr_path=str(err),
        stdout_sha256=e.reference(collection)["sha256"],
        stderr_sha256=e.reference(err)["sha256"],
        passed=True,
        normal_exit=True,
        timed_out=False,
        actual_exit=0,
        expected_exit=0,
    )
    monkeypatch.setattr(r, "child", lambda *args, **kwargs: receipt)
    raw, scratch = tmp_path / "failed", tmp_path / "failed-scratch"
    scratch.mkdir()
    result = r.validate(raw, scratch, [])
    assert not result["coverage"]["complete"]
    assert not result["custody"]["passed"]
    work.update(
        private_control=False,
        validation=dict(
            receipts=[dict(passed=False)],
            coverage=dict(complete=False),
            custody=dict(passed=False),
            raw_shard_hashes=[],
        ),
    )
    seal = tmp_path / "empty-seal.json"
    atomic_json(seal, {k: v for k, v in work.items() if k != "seal_reference"})
    work["seal_reference"] = e.reference(seal)
    atomic_json(Path(work["raw"]) / "work.json", work)
    atomic_json(output, e.build(work, output))
    assert r.replay(output)


def test_public_failed_owned_child(tmp_path, monkeypatch):
    """SCENARIO-REPORT-8698-CUSTODY: a real failed child yields terminal disqualification."""
    receipt = child(
        "owned_failure", [sys.executable, "-c", "raise SystemExit(7)"], tmp_path / "failure"
    )
    assert not receipt["passed"] and receipt["actual_exit"] == 7
    validation = dict(
        receipts=[receipt],
        coverage=dict(complete=False),
        custody=dict(passed=False),
        raw_shard_hashes=[],
    )
    monkeypatch.setattr(r, "validate", lambda *args: validation)
    output = tmp_path / (e.NAME + ".json")
    assert r.run(output) == 0
    value = json.loads(output.read_bytes())
    assert value["verdict_class"] == "disqualified"
    assert value["flagged_adversarial"]
    assert value["corpus_ready_score"] == 0
    assert r.replay(output)
