def test_private_cli_and_replay(tmp_path):
    """SCENARIO-REPORT-8698-CUSTODY: actual children publish and reject rehashed mutations."""
    output = tmp_path / (e.NAME + ".json")
    args = [sys.executable, "-u", e.CLI]
    assert child("private", args + ["--private-output", str(output)], tmp_path / "logs")["passed"]
    assert r.replay(output)
    original = output.read_bytes()
    value = json.loads(original)
    value["rows"][0]["actual_truth"] = 0
    value["reproducibility_checksum"] = e.checksum(value)
    atomic_json(output, value)
    assert child("rejected", args + ["--cold-replay", str(output)], tmp_path / "logs", expected=1)[
        "passed"
    ]
    output.write_bytes(original)
    value = json.loads(original)
    primitive = Path(value["primitive_reference"]["path"])
    saved = primitive.read_bytes()
    work = json.loads(saved)
    work["corpus"]["rows"][0]["actual_truth"] = 0
    atomic_json(primitive, work)
    value["primitive_reference"] = e.reference(primitive)
    value["reproducibility_checksum"] = e.checksum(value)
    atomic_json(output, value)
    assert not r.replay(output)
    primitive.write_bytes(saved)
    output.write_bytes(original)
    primitive.unlink()
    assert not r.replay(output)
    assert r.main(["--date", "nonsense"]) == 2
    assert r.main(["--date", "20261031"]) == 2
    assert r.main(["--private-output", str(e.ROOT / "results/forbidden.json")]) == 2


def test_build_verdicts(tmp_path):
    """SCENARIO-REPORT-8698-CUSTODY: owned failures disqualify; external absence blocks."""
    output = tmp_path / (e.NAME + ".json")
    assert r.run(output, private=True) == 0
    value = json.loads(output.read_bytes())
    work = e.load(value["primitive_reference"])
    work["private_control"] = False
    assert e.build(work, output)["verdict_class"] == "disqualified"
    work["validation"] = dict(
        receipts=[dict(passed=True)],
        coverage=dict(complete=True),
        custody=dict(passed=True),
        raw_shard_hashes=[],
    )
    assert e.build(work, output)["corpus_ready_score"] == 1
    work["inputs"]["passed"] = False
    assert e.build(work, output)["verdict_class"] == "blocked"
    work["corpus"]["ready"] = False
    assert not e.build(work, output)["acceptance_gates"]["all_truth_views_and_spans"]


