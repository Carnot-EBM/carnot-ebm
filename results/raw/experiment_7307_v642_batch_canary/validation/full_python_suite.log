    def test_experiment_2736(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
        # SANDBOX THE SCRIPT'S WRITES -- see the long rationale in
        # tests/python/test_experiment_3611.py, which has the identical defect.
