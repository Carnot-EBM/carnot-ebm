,\"children\":\"$L14\"}]}],null]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}],\"p\":false,\"v\":null}},\"m\":\"$undefined\",\"G\":[\"$15\",[]],\"S\":true,\"r\":\"$undefined\",\"s\":\"$undefined\",\"a\":\"$undefined\",\"l\":\"$undefined\",\"p\":\"$undefined\",\"d\":\"$undefined\",\"b\":\"w__xKyqARyvwsVeaNHcvi\"}\n5:C\nb:[\"$\",\"div\",null,{\"className\":\"min-h-screen bg-white\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BlogPosting\\\",\\\"@id\\\":\\\"https://blueguardrails.com/en/blog/ragtruth-plus-plus-enhanced-hallucination-detection-benchmark#article\\\",\\\"headline\\\":\\\"RAGTruth++: Enhanced hallucination detection benchmark\\\",\\\"description\\\":\\\"RAGTruth++: Enhanced hallucination benchmark with 10x more annotations through automated detection and human review. Download the free dataset for AI application testing.\\\",\\\"datePublished\\\":\\\"2025-11-20\\\",\\\"inLanguage\\\":\\\"en\\\",\\\"author\\\":[{\\\"@type\\\":\\\"Person\\\",\\\"name\\\":\\\"Miriam Kümmel\\\"}],\\\"publisher\\\":{\\\"@id\\\":\\\"https://blueguardrails.com/#organization\\\"},\\\"mainEntityOfPage\\\":\\\"https://blueguardrails.com/en/blog/ragtruth-plus-plus-enhanced-hallucination-detection-benchmark\\\",\\\"image\\\":\\\"https://blueguardrails.com/api/og?type=blog\u0026slug=ragtruth-plus-plus-enhanced-hallucination-detection-benchmark\u0026locale=en\\\"}\"}}],[\"$\",\"article\",null,{\"lang\":\"en\",\"className\":\"container mx-auto px-4 py-12 max-w-4xl\",\"children\":[[\"$\",\"header\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-4 text-sm text-gray-600 mb-6\",\"children\":[[[\"$\",\"span\",null,{\"className\":\"font-medium\",\"children\":\"Miriam Kümmel\"}],[\"$\",\"span\",null,{\"children\":\"•\"}]],[\"$\",\"time\",null,{\"dateTime\":\"2025-11-20\",\"className\":\"text-gray-500\",\"children\":\"2025-11-20\"}],[\"$\",\"span\",null,{\"children\":\"•\"}],[\"$\",\"span\",null,{\"className\":\"text-gray-500\",\"children\":\"12 min read\"}]]}],[\"$\",\"h1\",null,{\"className\":\"text-4xl md:text-5xl lg:text-6xl font-bold mb-6 text-gray-900 leading-tight\",\"children\":\"RAGTruth++: Enhanced hallucination detection benchmark\"}],[\"$\",\"p\",null,{\"className\":\"font-heading text-xl font-medium leading-snug text-gray-700 md:text-2xl\",\"children\":\"We enhanced the RAGTruth benchmark by finding 10x more hallucinations through automated detection and human review.\"}]]}],[\"$\",\"div\",null,{\"className\":\"mb-12 text-gray-700\",\"children\":[[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":[\"$\",\"strong\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"TL;DR:\"}]}],\"\\n\",[\"$\",\"ul\",null,{\"className\":\"list-disc list-outside mb-6 space-y-2 text-gray-700 ml-6 text-xl\",\"children\":[\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":[\"We significantly improved \",[\"$\",\"a\",null,{\"href\":\"https://github.com/ParticleMedia/RAGTruth\",\"className\":\"text-blue-600 hover:text-blue-800 underline transition-colors\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"RAGTruth\"}],\", a popular hallucination benchmark, uncovering 10x more hallucinations than the original annotations (86 to 865)\"]}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":\"Combined automated detection with systematic human review using our custom annotation tool Labelground\"}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":\"Two annotators independently reviewed all 408 datapoints\"}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":\"RAGTruth++ is now publicly available\"}],\"\\n\"]}],\"\\n\",[\"$\",\"h2\",null,{\"id\":\"introduction\",\"className\":\"text-3xl font-semibold mb-4 mt-12 text-gray-900\",\"children\":\"Introduction\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"Hallucination detection and mitigation is one of the core challenges in building reliable AI systems. When LLMs generate content that isn't grounded in the provided context, they undermine trust and create real risks for organizations deploying these systems.\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":[\"At Blue Guardrails, we wanted to evaluate our own hallucination detection methods. To do this, we started using \",\"$L16\",\" (published in 2024 by ParticleMedia), and while looking into it, we realized quite a few of the hallucinations were not caught. The dataset had gaps that would make it hard to properly benchmark detection methods.\"]}],\"\\n\",\"$L17\",\"\\n\",\"$L18\",\"\\n\",\"$L19\",\"\\n\",\"$L1a\",\"\\n\",\"$L1b\",\"\\n\",\"$L1c\",\"\\n\",\"$L1d\",\"\\n\",\"$L1e\",\"\\n\",\"$L1f\",\"\\n\",\"$L20\",\"\\n\",\"$L21\",\"\\n\",\"$L22\",\"\\n\",\"$L23\",\"\\n\",\"$L24\",\"\\n\",\"$L25\",\"\\n\",\"$L26\",\"\\n\",\"$L27\",\"\\n\",\"$L28\",\"\\n\",\"$L29\",\"\\n\",\"$L2a\",\"\\n\",\"$L2b\",\"\\n\",\"$L2c\",\"\\n\",\"$L2d\",\"\\n\",\"$L2e\",\"\\n\",\"$L2f\",\"\\n\",\"$L30\",\"\\n\",\"$L31\",\"\\n\",\"$L32\",\"\\n\",\"$L33\",\"\\n\",\"$L34\",\"\\n\",\"$L35\",\"\\n\",\"$L36\",\"\\n\",\"$L37\",\"\\n\",\"$L38\",\"\\n\",\"$L39\",\"\\n\",\"$L3a\",\"\\n\",\"$L3b\",\"\\n\",\"$L3c\",\"\\n\",\"$L3d\",\"\\n\",\"$L3e\",\"\\n\",\"$L3f\",\"\\n\",\"$L40\",\"\\n\",\"$L41\",\"\\n\",\"$L42\",\"\\n\",\"$L43\",\"\\n\",\"$L44\",\"\\n\",\"$L45\",\"\\n\",\"$L46\",\"\\n\",\"$L47\",\"\\n\",\"$L48\",\"\\n\",\"$L49\",\"\\n\",\"$L4a\",\"\\n\",\"$L4b\",\"\\n\",\"$L4c\",\"\\n\",\"$L4d\",\"\\n\",\"$L4e\",\"\\n\",\"$L4f\",\"\\n\",\"$L50\",\"\\n\",\"$L51\",\"\\n\",\"$L52\",\"\\n\",\"$L53\",\"\\n\",\"$L54\",\"\\n\",\"$L55\",\"\\n\",\"$L56\",\"\\n\",\"$L57\",\"\\n\",\"$L58\",\"\\n\",\"$L59\",\"\\n\",\"$L5a\"]}],\"$L5b\",\"$L5c\"]}],\"$L5d\",\"$L5e\"]}]\n65:\"/_next/static/chunks/2xejmvvwioq8y.js\"\n66:\"/_next/static/chunks/3w2z-ztk2e6n4.js\"\n67:\"/_next/static/chunks/3eshax9d5v8th.js\"\n68:\"/_next/static/chunks/0ygfzpyu8gn_-.js\"\n69:\"/_next/static/chunks/0er9dc_qscrpf.js\"\n6a:\"/_next/static/chunks/19v33ac8f1cd6.js\"\n6b:I[5500,[\"$65\",\"$66\",\"$67\",\"$68\",\"$69\",\"$6a\"],\"Image\"]\n16:[\"$\",\"a\",null,{\"href\":\"https://github.com/ParticleMedia/RAGTruth\",\"className\":\"text-blue-600 hover:text-blue-800 underline transition-colors\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"RAGTruth\"}]\n17:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":[\"This led us to create \",[\"$\",\"strong\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"RAGTruth++\"}],\": an enhanced version of the RAGTruth benchmark dataset with more complete hallucination annotations. By combining automated detection with human review, we increased the number of identified hallucinations from 86 to 865: a tenfold improvement that makes this benchmark more useful for evaluating hallucination detection methods.\"]}]\n18:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"Better benchmarks enable better hallucination detection, which is critical for building trustworthy AI systems.\"}]\n19:[\"$\",\"h2\",null,{\"id\":\"the-original-ragtruth-dataset\",\"className\":\"text-3xl font-semibold mb-4 mt-12 text-gray-900\",\"children\":\"The Original RAGTruth Dataset\"}]\n1a:[\"$\",\"h3\",null,{\"id\":\"dataset-overview\",\"className\":\"text-2xl font-semibold mb-3 mt-8 text-gray-800\",\"children\":\"Dataset Overview\"}]\n1b:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"The original RAGTruth test set consists of 1,800 datapoints. For our enhancement project, we focused on 408 datapoints (a random selection of summary and QA tasks in the original RAGTruth benchmark dataset).\"}]\n1c:[\"$\",\"h3\",null,{\"id\":\"datapoint-structure\",\"className\":\"text-2xl font-semibold mb-3 mt-8 text-gray-800\",\"children\":\"Datapoint Structure\"}]\n1d:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"Each datapoint in RAGTruth contains, among other data:\"}]\n1e:[\"$\",\"ol\",null,{\"className\":\"list-decimal list-outside mb-6 space-y-2 text-gray-700 ml-6 text-xl\",\"children\":[\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":\"The task type\"}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":\"The model used to generate the answer\"}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":\"The source of the query within the prompt\"}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":\"The prompt\"}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":\"The LLM's response\"}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":\"The labels (annotations) of hallucination instances\"}],\"\\n\"]}]\n1f:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"Here's an example datapoint:\"}]\n20:[\"$\",\"figure\",null,{\"data-rehype-pretty-code-figure\":\"\",\"children\":[\"$\",\"pre\",null,{\"className\":\"my-6 p-4 rounded-lg overflow-x-auto text-sm\",\"style\":{\"backgroundColor\":\"#24292e\",\"color\":\"#e1e4e8\"},\"tabIndex\":\"0\",\"data-language\":\"json\",\"data-theme\":\"github-dark\",\"children\":[\"$\",\"code\",null,{\"className\":\"$undefined\",\"data-language\":\"json\",\"data-theme\":\"github-dark\",\"style\":{\"display\":\"grid\"},\"children\":[[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"color\":\"#E1E4E8\"},\"children\":\"task_type: \"}],[\"$\",\"span\",null,{\"style\":{\"color\":\"#9ECBFF\"},\"children\":\"\\\"Summary\\\"\"}]]}],\"\\n\",[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"color\":\"#E1E4E8\"},\"children\":\"model: \"}],[\"$\",\"span\",null,{\"style\":{\"color\":\"#9ECBFF\"},\"children\":\"\\\"llama-2-7b-chat\\\"\"}]]}],\"\\n\",[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"color\":\"#E1E4E8\"},\"children\":\"source: \"}],[\"$\",\"span\",null,{\"style\":{\"color\":\"#9ECBFF\"},\"children\":\"\\\"CNN/DM\\\"\"}]]}],\"\\n\",[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":\" \"}],\"\\n\",[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"color\":\"#E1E4E8\"},\"children\":\"prompt: \"}],[\"$\",\"span\",null,{\"style\":{\"color\":\"#9ECBFF\"},\"children\":\"\\\"Summarize the following news within 116 words:\"}]]}],\"\\n\",[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[\"$\",\"span\",null,{\"style\":{\"color\":\"#9ECBFF\"},\"children\":\"Seventy years ago, Anne Frank died of typhus in a Nazi concentration camp at the age of 15. Just two weeks after her supposed death on March 31, 1945, the Bergen-Belsen concentration camp where she had been imprisoned was liberated -- timing that showed how close the Jewish diarist had been to surviving the Holocaust. But new research released by the Anne Frank House shows that Anne and her older sister, Margot Frank, died at least a month earlier than previously thought [...]\\\"\"}]}],\"\\n\",[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":\" \"}],\"\\n\",[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"color\":\"#E1E4E8\"},\"children\":\"response: \"}],[\"$\",\"span\",null,{\"style\":{\"color\":\"#9ECBFF\"},\"children\":\"\\\"Here is a summary of the article in 115 words or less:\"}]]}],\"\\n\",[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[\"$\",\"span\",null,{\"style\":{\"color\":\"#9ECBFF\"},\"children\":\"Anne Frank died of typhus in a Nazi concentration camp at age 15, two weeks after her supposed death on March 31, 1945. New research suggests that she and her sister Margot likely died at least a month earlier, contradicting previous estimates. The sisters were sent to the Bergen-Belsen camp in Germany after being arrested in Amsterdam in 1944. They endured harsh conditions, including lack of lighting, water, and sanitation, and were exposed to typhus due to poor hygiene. Witnesses reported that Anne and Margot exhibited symptoms before February 7, leading researchers to conclude that they likely died before March. Despite this, Anne's diary remains a powerful symbol of hope and resilience.\\\"\"}]}],\"\\n\",[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":\" \"}],\"\\n\",[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[\"$\",\"span\",null,{\"style\":{\"color\":\"#E1E4E8\"},\"children\":\"annotations: [\"}]}],\"\\n\",[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[\"$\",\"span\",null,{\"style\":{\"color\":\"#E1E4E8\"},\"children\":\"  {\"}]}],\"\\n\",[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"color\":\"#79B8FF\"},\"children\":\"    \\\"start\\\"\"}],[\"$\",\"span\",null,{\"style\":{\"color\":\"#E1E4E8\"},\"children\":\": \"}],[\"$\",\"span\",null,{\"style\":{\"color\":\"#79B8FF\"},\"children\":\"693\"}],[\"$\",\"span\",null,{\"style\":{\"color\":\"#E1E4E8\"},\"children\":\",\"}]]}],\"\\n\",[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"color\":\"#79B8FF\"},\"children\":\"    \\\"end\\\"\"}],[\"$\",\"span\",null,{\"style\":{\"color\":\"#E1E4E8\"},\"children\":\": \"}],[\"$\",\"span\",null,{\"style\":{\"color\":\"#79B8FF\"},\"children\":\"754\"}],[\"$\",\"span\",null,{\"style\":{\"color\":\"#E1E4E8\"},\"children\":\",\"}]]}],\"\\n\",[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"color\":\"#79B8FF\"},\"children\":\"    \\\"text\\\"\"}],[\"$\",\"span\",null,{\"style\":{\"color\":\"#E1E4E8\"},\"children\":\": \"}],[\"$\",\"span\",null,{\"style\":{\"color\":\"#9ECBFF\"},\"children\":\"\\\"Anne's diary remains a powerful symbol of hope and resilience\\\"\"}],[\"$\",\"span\",null,{\"style\":{\"color\":\"#E1E4E8\"},\"children\":\",\"}]]}],\"\\n\",[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"color\":\"#79B8FF\"},\"children\":\"    \\\"meta\\\"\"}],[\"$\",\"span\",null,{\"style\":{\"color\":\"#E1E4E8\"},\"children\":\": \"}],[\"$\",\"span\",null,{\"style\":{\"color\":\"#9ECBFF\"},\"children\":\"\\\"LOW INTRODUCTION OF NEW INFORMATION\"}],\"$L5f\",\"$L60\",\"$L61\"]}],\"\\n\",\"$L62\",\"\\n\",\"$L63\",\"\\n\",\"$L64\"]}]}]}]\n21:[\"$\",\"h3\",null,{\"id\":\"ragtruth-dataset-characteristics\",\"className\":\"text-2xl font-semibold mb-3 mt-8 text-gray-800\",\"children\":\"RAGTruth Dataset Characteristics\"}]\n22:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":[\"$\",\"strong\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"Task Distribution\"}]}]\n23:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"The 408 datapoints we worked with consisted of:\"}]\n24:[\"$\",\"ul\",null,{\"className\":\"list-disc list-outside mb-6 space-y-2 text-gray-700 ml-6 text-xl\",\"children\":[\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":\"174 Summary tasks (like the example above)\"}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":\"234 QA tasks (e.g., \\\"Briefly answer the following question: how to boil potatoes for easy peeling. Bear in mind that your response should be strictly based on the following three passages...\\\")\"}],\"\\n\"]}]\n25:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":[\"$\",\"$L6b\",null,{\"src\":\"/blog-assets/summary_qa_donut.png\",\"alt\":\"Task distribution chart showing Summary and QA tasks\",\"width\":800,\"height\":620,\"className\":\"my-6 rounded-lg max-w-full h-auto\",\"sizes\":\"(max-width: 896px) 100vw, 800px\",\"unoptimized\":false}]}]\n26:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":[\"$\",\"strong\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"Model Distribution\"}]}]\n27:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"The models used to generate responses were equally distributed (68 datapoints each):\"}]\n28:[\"$\",\"ul\",null,{\"className\":\"list-disc list-outside mb-6 space-y-2 text-gray-700 ml-6 text-xl\",\"children\":[\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":\"llama-2-70b-chat\"}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":\"llama-2-13b-chat\"}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":\"llama-2-7b-chat\"}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":\"mistral-7B-instruct\"}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":\"gpt-3.5-turbo-0613\"}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":\"gpt-4-0613\"}],\"\\n\"]}]\n29:[\"$\",\"h3\",null,{\"id\":\"original-annotation-statistics\",\"className\":\"text-2xl font-semibold mb-3 mt-8 text-gray-800\",\"children\":\"Original Annotation Statistics\"}]\n2a:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"The original RAGTruth annotators identified a total of 86 hallucinations in the 408 datapoints we examined. This translates to:\"}]\n2b:[\"$\",\"ul\",null,{\"className\":\"list-disc list-outside mb-6 space-y-2 text-gray-700 ml-6 text-xl\",\"children\":[\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"Average hallucinations per response:\"}],\" 0.21\"]}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"Hallucination rate\"}],\" (proportion of datapoints with at least one hallucination)\",[\"$\",\"strong\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\":\"}],\" 15.9%\"]}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"Hallucination-free responses:\"}],\" 84.1%\"]}],\"\\n\"]}]\n2c:[\"$\",\"h2\",null,{\"id\":\"labelground-our-annotation-tool\",\"className\":\"text-3xl font-semibold mb-4 mt-12 text-gray-900\",\"children\":\"Labelground: Our Annotation Tool\"}]\n2d:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"To work on this and similar datasets, we decided to build a tool that enables us to efficiently review, alter, and complete span-level annotations.\"}]\n2e:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":[\"$\",\"strong\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"Key Features:\"}]}]\n2f:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"Labelground provides a split-view interface where the prompt and context are displayed on the left side, and the LLM's response is displayed on the right. All annotations are highlighted in the text.\"}]\n30:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":[\"$\",\"$L6b\",null,{\"src\":\"/blog-assets/Labelground_screenshot1.png\",\"alt\":\"Labelground interface showing split-view annotation\",\"width\":800,\"height\":548,\"className\":\"my-6 rounded-lg max-w-full h-auto\",\"sizes\":\"(max-width: 896px) 100vw, 800px\",\"unoptimized\":false}]}]\n31:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"For each annotation, you can:\"}]\n32:[\"$\",\"ul\",null,{\"className\":\"list-disc list-outside mb-6 space-y-2 text-gray-700 ml-6 text-xl\",\"children\":[\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":\"Approve it (confirm it's a hallucination)\"}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":\"Reject it\"}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":\"Mark it as \\\"Disputed\\\" and return to it later\"}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":\"Adjust the text span or classification\"}],\"\\n\"]}]\n33:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"You can also mark any text span and create a new annotation at any time.\"}]\n34:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":[\"$\",\"$L6b\",null,{\"src\":\"/blog-assets/Labelground_screenshot2.png\",\"alt\":\"Annotation actions in Labelground\",\"width\":800,\"height\":501,\"className\":\"my-6 rounded-lg max-w-full h-auto\",\"sizes\":\"(max-width: 896px) 100vw, 800px\",\"unoptimized\":false}]}]\n35:[\"$\",\"h2\",null,{\"id\":\"the-annotation-process\",\"className\":\"text-3xl font-semibold mb-4 mt-12 text-gray-900\",\"children\":\"The Annotation Process\"}]\n36:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"With Labelground built, we began the process of creating RAGTruth++. This involved three main phases: automatic detection, independent human annotation, and consensus building.\"}]\n37:[\"$\",\"h3\",null,{\"id\":\"phase-1-automatic-hallucination-detection\",\"className\":\"text-2xl font-semibold mb-3 mt-8 text-gray-800\",\"children\":\"Phase 1: Automatic Hallucination Detection\"}]\n38:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"Before beginning human annotation, we ran our automated Blue Guardrails detection method on all 408 datapoints. This method scans the prompts and generated responses and identifies spans with a high likelihood of being a hallucination, creating a set of predicted annotations.\"}]\n39:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"The dataset was then loaded into Labelground with two types of annotations for human review:\"}]\n3a:[\"$\",\"ol\",null,{\"className\":\"list-decimal list-outside mb-6 space-y-2 text-gray-700 ml-6 text-xl\",\"children\":[\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":\"Original RAGTruth human annotations\"}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":\"Blue Guardrails automatic predictions\"}],\"\\n\"]}]\n3b:[\"$\",\"h3\",null,{\"id\":\"phase-2-independent-human-annotation\",\"className\":\"text-2xl font-semibold mb-3 mt-8 text-gray-800\",\"children\":\"Phase 2: Independent Human Annotation\"}]\n3c:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"Two human annotators (Mathis and Miriam from Blue Guardrails) independently reviewed every annotation and prediction. For each one, we either confirmed it, rejected it, or adjusted the span or its label. Additionally, we added any missing annotations we discovered during review.\"}]\n3d:[\"$\",\"h3\",null,{\"id\":\"phase-3-adjudication-and-consensus\",\"className\":\"text-2xl font-semibold mb-3 mt-8 text-gray-800\",\"children\":\"Phase 3: Adjudication and Consensus\"}]\n3e:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"Inter-annotator agreement:\"}],\" The two annotators achieved an F1 score of 0.78, indicating substantial agreement.\"]}]\n3f:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"Conflict resolution:\"}],\" For the 310 spans where our initial annotations disagreed, we met to discuss each case. Through this adjudication process, we reached consensus on all disputed spans.\"]}]\n40:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"Final gold standard:\"}],\" This systematic process resulted in our final RAGTruth++ annotations.\"]}]\n41:[\"$\",\"h2\",null,{\"id\":\"introducing-ragtruth\",\"className\":\"text-3xl font-semibold mb-4 mt-12 text-gray-900\",\"children\":\"Introducing RAGTruth++\"}]\n42:[\"$\",\"h3\",null,{\"id\":\"comparative-overview\",\"className\":\"text-2xl font-semibold mb-3 mt-8 text-gray-800\",\"children\":\"Comparative Overview\"}]\n43:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":[\"The table below shows a dramatic increase in detected hallucinations between RAGTruth and RAGTruth++. While the dataset size remained constant at 408 datapoints, the total number of annotated hallucinations increased from 86 to \",[\"$\",\"strong\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"865\"}],\" (a 1005.8% increase). This translates to an average of \",[\"$\",\"strong\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"2.12 hallucinations per response\"}],\" in RAGTruth++ compared to just 0.21 in the original dataset, with the \",[\"$\",\"strong\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"hallucination rate\"}],\" jumping from 15.90% to \",[\"$\",\"strong\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"74.75%\"}],\".\"]}]\n44:[\"$\",\"div\",null,{\"className\":\"my-6 overflow-x-auto\",\"children\":[\"$\",\"table\",null,{\"className\":\"min-w-full divide-y divide-gray-300 border border-gray-300\",\"children\":[[\"$\",\"thead\",null,{\"className\":\"bg-gray-50\",\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",null,{\"className\":\"px-4 py-3 text-left text-sm font-semibold text-gray-900\",\"children\":\"Metric\"}],[\"$\",\"th\",null,{\"className\":\"px-4 py-3 text-left text-sm font-semibold text-gray-900\",\"children\":\"RAGTruth\"}],[\"$\",\"th\",null,{\"className\":\"px-4 py-3 text-left text-sm font-semibold text-gray-900\",\"children\":\"RAGTruth++\"}],[\"$\",\"th\",null,{\"className\":\"px-4 py-3 text-left text-sm font-semibold text-gray-900\",\"children\":\"Increase\"}]]}]}],[\"$\",\"tbody\",null,{\"className\":\"divide-y divide-gray-200 bg-white\",\"children\":[[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-sm text-gray-700 whitespace-nowrap\",\"children\":\"Total number of datapoints\"}],[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-sm text-gray-700 whitespace-nowrap\",\"children\":\"408\"}],[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-sm text-gray-700 whitespace-nowrap\",\"children\":\"408\"}],[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-sm text-gray-700 whitespace-nowrap\",\"children\":\"-\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-sm text-gray-700 whitespace-nowrap\",\"children\":\"Total hallucinations annotated\"}],[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-sm text-gray-700 whitespace-nowrap\",\"children\":\"86\"}],[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-sm text-gray-700 whitespace-nowrap\",\"children\":\"865\"}],[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-sm text-gray-700 whitespace-nowrap\",\"children\":\"+ 1005.8%\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-sm text-gray-700 whitespace-nowrap\",\"children\":\"Average hallucinations per response\"}],[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-sm text-gray-700 whitespace-nowrap\",\"children\":\"0.21\"}],[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-sm text-gray-700 whitespace-nowrap\",\"children\":\"2.12\"}],[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-sm text-gray-700 whitespace-nowrap\",\"children\":\"+ 1009.5%\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-sm text-gray-700 whitespace-nowrap\",\"children\":\"Hallucination rate\"}],[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-sm text-gray-700 whitespace-nowrap\",\"children\":\"15.90%\"}],[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-sm text-gray-700 whitespace-nowrap\",\"children\":\"74.75%\"}],[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-sm text-gray-700 whitespace-nowrap\",\"children\":\"+ 470.1%\"}]]}]]}]]}]}]\n45:[\"$\",\"h3\",null,{\"id\":\"hallucination-frequency-by-model\",\"className\":\"text-2xl font-semibold mb-3 mt-8 text-gray-800\",\"children\":\"Hallucination Frequency by Model\"}]\n46:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"The increase in detected hallucinations was consistent across all models, with each showing significant gaps in the original annotations:\"}]\n47:[\"$\",\"ul\",null,{\"className\":\"list-disc list-outside mb-6 space-y-2 text-gray-700 ml-6 text-xl\",\"children\":[\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"llama-2-7b-chat:\"}],\" 27 to 227 hallucinations\"]}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"llama-2-13b-chat:\"}],\" 13 to 194 hallucinations\"]}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"llama-2-70b-chat:\"}],\" 10 to 153 hallucinations\"]}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"mistral-7B-instruct:\"}],\" 35 to 142 hallucinations\"]}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"gpt-4-0613:\"}],\" 0 to 83 hallucinations\"]}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"text-gray-700 leading-relaxed text-xl\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"gpt-3.5-turbo-0613:\"}],\" 1 to 66 hallucinations\"]}],\"\\n\"]}]\n48:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"The smaller open-source models (llama-2-7b-chat and llama-2-13b-chat) had the highest absolute numbers of hallucinations in RAGTruth++, while gpt-4 and gpt-3.5-turbo had the fewest. Notably, gpt-4 went from zero annotated hallucinations in the original dataset to 83 in RAGTruth++, revealing that even the best-performing model had missed issues.\"}]\n49:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":[\"$\",\"$L6b\",null,{\"src\":\"/blog-assets/visualization_barbell.svg\",\"alt\":\"Barbell chart showing hallucination comparison across models\",\"width\":800,\"height\":400,\"className\":\"my-6 rounded-lg max-w-full h-auto\",\"sizes\":\"(max-width: 896px) 100vw, 800px\",\"unoptimized\":false}]}]\n4a:[\"$\",\"h2\",null,{\"id\":\"conclusion\",\"className\":\"text-3xl font-semibold mb-4 mt-12 text-gray-900\",\"children\":\"Conclusion\"}]\n4b:[\"$\",\"h3\",null,{\"id\":\"limitations\",\"className\":\"text-2xl font-semibold mb-3 mt-8 text-gray-800\",\"children\":\"Limitations\"}]\n4c:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":[\"The RAGTruth++ dataset has some limitations: First, 408 datapoints is rather small for a benchmarking dataset. Also, as outlined in our \",[\"$\",\"a\",null,{\"href\":\"https://blueguardrails.com/en/blog/why-hallucination-benchmarks-miss-the-mark\",\"className\":\"text-blue-600 hover:text-blue-800 underline transition-colors\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"previous blog post\"}],\", the tasks posed to the LLMs are very easy and do not reflect realistic challenges.\"]}]\n4d:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"As is natural in the AI field, the models used to generate these responses are largely outdated at this point, and most modern LLMs would likely make slightly fewer and different types of mistakes.\"}]\n4e:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"Additionally, the density of hallucinations is very high: 74.75% of all datapoints contain at least one hallucination. Depending on which detection method you're benchmarking, this class imbalance could lead to an effect called base rate fallacy: a model can appear to perform well simply by predicting true positives every time.\"}]\n4f:[\"$\",\"h3\",null,{\"id\":\"the-value-of-ragtruth\",\"className\":\"text-2xl font-semibold mb-3 mt-8 text-gray-800\",\"children\":\"The Value of RAGTruth++\"}]\n50:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"Despite these limitations, we managed to enhance a popular high-quality benchmark dataset by making it more complete and reducing the number of false negatives.\"}]\n51:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"The process of reviewing thousands of annotations has sharpened our ability to spot subtle hallucinations which is exactly the skill needed when auditing real-world AI applications.\"}]\n52:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"RAGTruth++ addresses a real gap in the available benchmarks. While the original RAGTruth provided a foundation, the inaccurately low hallucination rate (15.9%) meant that many detection methods could achieve high scores without actually being effective.\"}]\n53:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"The systematic annotation process we developed (combining automated detection, independent human review, and adjudication) can be applied to other datasets. We built Labelground specifically to make this workflow efficient and repeatable.\"}]\n54:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"To tackle hallucinations seriously, high-quality benchmarks are necessary. We found a reliable, effective, efficient way of benchmarking hallucination detection approaches, and we're making it available to the community.\"}]\n55:[\"$\",\"h3\",null,{\"id\":\"get-ragtruth\",\"className\":\"text-2xl font-semibold mb-3 mt-8 text-gray-800\",\"children\":\"Get RAGTruth++\"}]\n56:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":\"Feel free to use RAGTruth++ and let us know how it works for you.\"}]\n57:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"Download:\"}],\" Available on \",[\"$\",\"a\",null,{\"href\":\"https://huggingface.co/datasets/blue-guardrails/ragtruth-plus-plus\",\"className\":\"text-blue-600 hover:text-blue-800 underline transition-colors\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"HuggingFace\"}],\".\"]}]\n58:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"Learn more:\"}],\" Watch Mathis' \",[\"$\",\"a\",null,{\"href\":\"https://youtu.be/7R7U0s2S1ro\",\"className\":\"text-blue-600 hover:text-blue-800 underline transition-colors\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"video\"}],\" for more in-depth information on how RAGTruth++ was created.\"]}]\n59:[\"$\",\"hr\",null,{\"className\":\"my-8 border-t border-gray-300\"}]\n5a:[\"$\",\"p\",null,{\"className\":\"mb-4 text-inherit leading-relaxed text-xl\",\"children\":[\"$\",\"em\",null,{\"className\":\"italic text-gray-700\",\"children\":\"This work was conducted by Miriam and Mathis, founders of Blue Guardrails, as part of our mission to help teams build AI responsibly.\"}]}]\n5c:[\"$\",\"div\",null,{\"className\":\"border-t border-gray-200 pt-8 mt-12\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-start gap-4 \",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex-shrink-0\",\"children\":[\"$\",\"$L6b\",null,{\"src\":\"/authors/miriam-kuemmel.jpg\",\"alt\":\"Miriam Kümmel\",\"width\":64,\"height\":64,\"className\":\"rounded-full object-cover\"}]}],[\"$\",\"div\",null,{\"className\":\"flex-1\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-semibold text-gray-900\",\"children\":\"Miriam Kümmel\"}],[\"$\",\"div\",null,{\"className\":\"text-sm text-gray-600 mt-1\",\"children\":\"Co-Founder at Blue Guardrails\"}]]}]]}]}]\n5f:[\"$\",\"span\",null,{\"style\":{\"color\":\"#79B8FF\"},\"children\":\"\\\\n\"}]\n60:[\"$\",\"span\",null,{\"style\":{\"color\":\"#9ECBFF\"},\"children\":\"This specific detail about Anne's diary was not mentioned in the source content.\\\"\"}]\n61:[\"$\",\"span\",null,{\"style\":{\"color\":\"#E1E4E8\"},\"children\":\",\"}]\n62:[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"color\":\"#79B8FF\"},\"children\":\"    \\\"label_type\\\"\"}],[\"$\",\"span\",null,{\"style\":{\"color\":\"#E1E4E8\"},\"children\":\": \"}],[\"$\",\"span\",null,{\"style\":{\"color\":\"#9ECBFF\"},\"children\":\"\\\"Subtle Baseless Info\\\"\"}]]}]\n63:[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[\"$\",\"span\",null,{\"style\":{\"color\":\"#E1E4E8\"},\"children\":\"  }\"}]}]\n64:[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[\"$\",\"span\",null,{\"style\":{\"color\":\"#E1E4E8\"},\"children\":\"]\"}]}]\n11:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n6c:I[25718,[\"$65\",\"$66\",\"$67\",\"$68\",\"$69\",\"$6a\"],\"default\"]\n75:I[94227,[\"$65\",\"$66\",\"$67\",\"$68\",\"$69\",\"$6a\"],\"default\"]\n5e:[\"$\",\"footer\",null,{\"className\":\"bg-brand py-12 text-white md:py-16\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-[1350px] px-4 sm:px-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12 sm:gap-12 sm:mb-16\",\"children\":[[\"$\",\"div\",null,{\"className\":\"lg:pr-24\",\"children\":[\"$\",\"h2\",null,{\"className\":\"mb-6 text-[2.125rem] font-bold leading-tight text-white md:text-[3.5rem] lg:text-[4.5rem]\",\"children\":\"Create reliable AI agents\"}]}],[\"$\",\"div\",null,{\"className\":\"flex flex-col justify-center\",\"children\":[[\"$\",\"p\",null,{\"className\":\"mb-8 text-lg leading-relaxed text-white/85\",\"children\":\"Monitor, evaluate, steer, and continuously optimize your AI agents with one reliability layer built for production.\"}],[\"$\",\