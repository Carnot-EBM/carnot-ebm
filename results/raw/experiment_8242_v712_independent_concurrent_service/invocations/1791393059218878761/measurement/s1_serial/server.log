.\\n7. Remove from heat and let stand until the pressure indicator shows no pressure.\\n\\nNote that the exact cooking time may vary depending on the type of beans and their age, so it's best to check them periodically to ensure they're tender but not mushy.\", \"source_segments\": [{\"index\": 0, \"byte_start\": 0, \"byte_end\": 37}, {\"index\": 1, \"byte_start\": 37, \"byte_end\": 99}, {\"index\": 2, \"byte_start\": 99, \"byte_end\": 165}, {\"index\": 3, \"byte_start\": 165, \"byte_end\": 216}, {\"index\": 4, \"byte_start\": 216, \"byte_end\": 286}, {\"index\": 5, \"byte_start\": 286, \"byte_end\": 362}, {\"index\": 6, \"byte_start\": 362, \"byte_end\": 483}, {\"index\": 7, \"byte_start\": 483, \"byte_end\": 523}, {\"index\": 8, \"byte_start\": 523, \"byte_end\": 676}, {\"index\": 9, \"byte_start\": 676, \"byte_end\": 820}, {\"index\": 10, \"byte_start\": 820, \"byte_end\": 862}, {\"index\": 11, \"byte_start\": 862, \"byte_end\": 924}, {\"index\": 12, \"byte_start\": 924, \"byte_end\": 989}, {\"index\": 13, \"byte_start\": 989, \"byte_end\": 1101}], \"answer_sentence_indices\": [0], \"answer_offsets\": [{\"index\": 0, \"byte_start\": 0, \"byte_end\": 122}]}", "role": "user"}], "add_generation_prompt": true, "chat_template_kwargs": {"enable_thinking": false}}
