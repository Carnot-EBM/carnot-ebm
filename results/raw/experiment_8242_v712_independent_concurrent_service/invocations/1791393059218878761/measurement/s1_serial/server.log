\\"hipster\\\":false,\\\"intimate\\\":false,\\\"romantic\\\":false,\\\"touristy\\\":false,\\\"trendy\\\":false,\\\"upscale\\\":false},\\\"BusinessParking\\\":{\\\"garage\\\":false,\\\"lot\\\":true,\\\"street\\\":false,\\\"valet\\\":false,\\\"validated\\\":false},\\\"Music\\\":null,\\\"OutdoorSeating\\\":false,\\\"RestaurantsGoodForGroups\\\":true,\\\"RestaurantsReservations\\\":false,\\\"RestaurantsTakeOut\\\":true,\\\"WiFi\\\":\\\"no\\\"},\\\"business_stars\\\":4.0,\\\"categories\\\":\\\"Pizza, Restaurants\\\",\\\"city\\\":\\\"Santa Barbara\\\",\\\"hours\\\":{\\\"Friday\\\":\\\"12:0-21:0\\\",\\\"Monday\\\":\\\"12:0-21:0\\\",\\\"Saturday\\\":\\\"12:0-21:0\\\",\\\"Sunday\\\":\\\"12:0-21:0\\\",\\\"Thursday\\\":\\\"12:0-21:0\\\",\\\"Tuesday\\\":\\\"12:0-21:0\\\",\\\"Wednesday\\\":\\\"12:0-21:0\\\"},\\\"name\\\":\\\"Nicky D's Wood fired Pizza\\\",\\\"review_info\\\":[{\\\"review_date\\\":\\\"2018-07-21 17:37:28\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"Excellent wood fired pizza. I ordered the Pesto Pizza with Ramano & Mozzarella Cheeses, Spinach, Artichoke, Chicken, Basil and Tomato. Perfect!\\\"},{\\\"review_date\\\":\\\"2018-06-03 02:28:58\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"The best pizza money can buy IN Santa Barbara hands down .. I met Nicky D he is always there on weekends great guy to talk 2 ..\\\"},{\\\"review_date\\\":\\\"2018-05-12 03:42:57\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"We just ate dinner here tonight! I Yelped pizza's nearby since we are from San Diego and I am so glad we found this place!!! It was sooooo good! Really good cheese and great flavor!\\\"}],\\\"state\\\":\\\"CA\\\"}\", \"answer\": \"\\\"Nicky D's Wood fired Pizza\\\" is a highly-rated local business located at 2840 De La Vina St, Santa Barbara, CA. The restaurant specializes in serving pizza and is open every day from 12:00 to 21:00. They do not offer WiFi or outdoor seating, but they do provide parking lots for customers. They also offer take-out options and are suitable for groups. The restaurant's atmosphere is casual. Customers have praised the quality of their wood-fired pizza, with specific mention of the Pesto Pizza with Ramano & Mozzarella Cheeses, Spinach, Artichoke, Chicken, Basil, and Tomato. Customers have also mentioned the friendly service provided by the owner, Nicky D, who is often present at the restaurant, especially on weekends.\", \"source_segments\": [{\"index\": 0, \"byte_start\": 0, \"byte_end\": 825}, {\"index\": 1, \"byte_start\": 825, \"byte_end\": 932}, {\"index\": 2, \"byte_start\": 932, \"byte_end\": 1074}, {\"index\": 3, \"byte_start\": 1074, \"byte_end\": 1248}, {\"index\": 4, \"byte_start\": 1248, \"byte_end\": 1340}, {\"index\": 5, \"byte_start\": 1340, \"byte_end\": 1360}, {\"index\": 6, \"byte_start\": 1360, \"byte_end\": 1413}], \"answer_sentence_indices\": [0], \"answer_offsets\": [{\"index\": 0, \"byte_start\": 0, \"byte_end\": 112}]}<|im_end|>\n<|im_start|>assistant\n<think>\n\n</think>\n\n","has_new_line":false,"truncated":false,"stop_type":"eos","stopping_word":"","tokens_cached":927,"timings":{"cache_n":0,"prompt_n":917,"prompt_ms":838.295,"prompt_per_token_ms":0.9141712104689204,"prompt_per_second":1093.8869968209283,"predicted_n":11,"predicted_ms":262.838,"predicted_per_token_ms":23.89436363636364,"predicted_per_second":41.85087392233999}}


