\":{\\\"Ambience\\\":{\\\"casual\\\":true,\\\"classy\\\":false,\\\"divey\\\":false,\\\"hipster\\\":false,\\\"intimate\\\":false,\\\"romantic\\\":false,\\\"touristy\\\":false,\\\"trendy\\\":false,\\\"upscale\\\":false},\\\"BusinessParking\\\":{\\\"garage\\\":false,\\\"lot\\\":true,\\\"street\\\":false,\\\"valet\\\":false,\\\"validated\\\":false},\\\"Music\\\":null,\\\"OutdoorSeating\\\":true,\\\"RestaurantsGoodForGroups\\\":true,\\\"RestaurantsReservations\\\":false,\\\"RestaurantsTakeOut\\\":true,\\\"WiFi\\\":\\\"no\\\"},\\\"business_stars\\\":4.0,\\\"categories\\\":\\\"Sandwiches, Restaurants, Salad, Hot Dogs, Delis\\\",\\\"city\\\":\\\"Santa Barbara\\\",\\\"hours\\\":{\\\"Friday\\\":\\\"10:0-17:30\\\",\\\"Monday\\\":\\\"10:0-17:30\\\",\\\"Saturday\\\":\\\"10:0-16:30\\\",\\\"Sunday\\\":\\\"11:0-16:30\\\",\\\"Thursday\\\":\\\"10:0-17:30\\\",\\\"Tuesday\\\":\\\"10:0-17:30\\\",\\\"Wednesday\\\":\\\"10:0-17:30\\\"},\\\"name\\\":\\\"Plaza Deli\\\",\\\"review_info\\\":[{\\\"review_date\\\":\\\"2021-12-01 00:23:49\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"The deli veggie sandwich is really good!! I get this everyday for lunch. It's a fat sandwich! So fresh so good. Larry and Jonathon are super nice! Always a good lunch at the plaza deli. Recommend 10/10 go here!\\\"},{\\\"review_date\\\":\\\"2021-11-27 23:08:31\\\",\\\"review_stars\\\":5.0,\\\"review_text\\\":\\\"We stopped to grab a quick bite on our road trip home.  The Plaza Deli didn't disappoint and I know first hand why all the great reviews.   The Turkey/Cheese/ Avocado sandwich and Italian sub were loaded with meats and very very good.  They carried a load of great sodas - birch beer you don't find often.  The owner couldn't be any nicer, chatting it up with us and giving our dog Frankie water and biscuits.  Highly recommend supporting this local business .\\\"},{\\\"review_date\\\":\\\"2021-10-30 15:45:45\\\",\\\"review_stars\\\":3.0,\\\"review_text\\\":\\\"I've been going to Plaza Deli since I was child in the 90's. The place has always been a good place to go for a quality sandwich at a fair price. But, we have noticed lately the quality of ingredients/preparation isn't up to the same standards and the customer service has been hit or miss. I realize Covid has been hard on us all and businesses but it still feels like something changed with the vibe and quality. After a couple sub-par experiences we may try it again. We hope this is just been a hiccup.\\\"}],\\\"state\\\":\\\"CA\\\"}\", \"answer\": \"Plaza Deli is a casual dining restaurant located at 140 S Hope Ave, Santa Barbara, CA. This establishment is known for its sandwiches, salads, hot dogs, and deli items. Open throughout the week, it offers outdoor seating and is suitable for groups. Though it doesn't offer Wi-Fi or music, it does provide parking in their lot and take-out options. The overall business rating stands at 4.0 stars. Various reviews highlight the quality and quantity of their food, particularly the deli veggie sandwich, turkey/cheese/avocado sandwich, and Italian sub. The staff, including Larry and Jonathan, are appreciated for their friendly demeanor. Some customers have expressed their concerns about recent changes in the quality of food and customer service. They remain hopeful, however, that these are temporary issues and will revisit the place.\", \"source_segments\": [{\"index\": 0, \"byte_start\": 0, \"byte_end\": 854}, {\"index\": 1, \"byte_start\": 854, \"byte_end\": 885}, {\"index\": 2, \"byte_start\": 885, \"byte_end\": 906}, {\"index\": 3, \"byte_start\": 906, \"byte_end\": 924}, {\"index\": 4, \"byte_start\": 924, \"byte_end\": 959}, {\"index\": 5, \"byte_start\": 959, \"byte_end\": 998}, {\"index\": 6, \"byte_start\": 998, \"byte_end\": 1152}, {\"index\": 7, \"byte_start\": 1152, \"byte_end\": 1236}, {\"index\": 8, \"byte_start\": 1236, \"byte_end\": 1332}, {\"index\": 9, \"byte_start\": 1332, \"byte_end\": 1403}, {\"index\": 10, \"byte_start\": 1403, \"byte_end\": 1507}, {\"index\": 11, \"byte_start\": 1507, \"byte_end\": 1691}, {\"index\": 12, \"byte_start\": 1691, \"byte_end\": 1776}, {\"index\": 13, \"byte_start\": 1776, \"byte_end\": 1921}, {\"index\": 14, \"byte_start\": 1921, \"byte_end\": 2045}, {\"index\": 15, \"byte_start\": 2045, \"byte_end\": 2101}, {\"index\": 16, \"byte_start\": 2101, \"byte_end\": 2153}], \"answer_sentence_indices\": [0], \"answer_offsets\": [{\"index\": 0, \"byte_start\": 0, \"byte_end\": 87}]}<|im_end|>\n<|im_start|>assistant\n<think>\n\n</think>\n\n","has_new_line":false,"truncated":false,"stop_type":"eos","stopping_word":"","tokens_cached":1371,"timings":{"cache_n":0,"prompt_n":1357,"prompt_ms":1137.956,"prompt_per_token_ms":0.8385821665438467,"prompt_per_second":1192.4889890294528,"predicted_n":15,"predicted_ms":379.027,"predicted_per_token_ms":25.268466666666665,"predicted_per_second":39.575017083215705}}


