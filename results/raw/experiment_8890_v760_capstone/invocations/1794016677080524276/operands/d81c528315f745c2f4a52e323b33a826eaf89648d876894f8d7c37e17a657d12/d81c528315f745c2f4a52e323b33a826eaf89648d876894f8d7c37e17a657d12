<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex159.m1" class="ltx_Math" alttext="\displaystyle\qquad\leq n\log\left(\frac{\eta_{T}}{\eta_{0}}+\frac{\beta G^{2}T}{n\eta_{0}}\right)+\sigma_{\tau}n\log\left(\frac{\eta_{\tau}}{\eta_{0}}+\frac{\beta G^{2}\tau}{n\eta_{0}}\right)+2\beta G^{2}\sum_{t=\tau+1}^{T}\frac{|m_{t}|}{\eta_{t}}\;," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="2.278em">≤</mo><mrow><mrow><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>η</mi><mi>T</mi></msub><msub><mi>η</mi><mn>0</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mn>0</mn></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>σ</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>η</mi><mi>τ</mi></msub><msub><mi>η</mi><mn>0</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mn>0</mn></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>T</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">|</mo></mrow><msub><mi>η</mi><mi>t</mi></msub></mfrac></mstyle></mrow></mrow></mrow></mrow><mo lspace="0.280em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\leq n\log\left(\frac{\eta_{T}}{\eta_{0}}+\frac{\beta G^{2}T}{n\eta_{0}}\right)+\sigma_{\tau}n\log\left(\frac{\eta_{\tau}}{\eta_{0}}+\frac{\beta G^{2}\tau}{n\eta_{0}}\right)+2\beta G^{2}\sum_{t=\tau+1}^{T}\frac{|m_{t}|}{\eta_{t}}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p34.3" class="ltx_p"><span id="A3.p34.3.1" class="ltx_text">which proves the claim.
∎</span></p>
