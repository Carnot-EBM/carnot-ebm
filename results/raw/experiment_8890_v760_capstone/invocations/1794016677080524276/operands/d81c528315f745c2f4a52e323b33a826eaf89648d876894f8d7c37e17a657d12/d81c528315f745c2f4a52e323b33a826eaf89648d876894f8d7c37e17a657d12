<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E28.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{t=1}^{T}a_{t}\left[\overline{H}_{t}(u)-\min_{x\in\mathcal{X}}\overline{H}_{t}(x)-U_{t}(u)+\min_{x\in\mathcal{X}}U_{t}(x)\right]." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>a</mi><mi>t</mi></msub><mrow><mo>[</mo><msub><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><munder><mi>min</mi><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow></munder><msub><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>U</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><munder><mi>min</mi><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow></munder><msub><mi>U</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{t=1}^{T}a_{t}\left[\overline{H}_{t}(u)-\min_{x\in\mathcal{X}}\overline{H}_{t}(x)-U_{t}(u)+\min_{x\in\mathcal{X}}U_{t}(x)\right].</annotation></semantics></math></td>
