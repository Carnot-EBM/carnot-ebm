<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex146.m1" class="ltx_Math" alttext="\sum_{t=1}^{T}\sum_{\tau\in\mathcal{F}_{t}}a_{\tau,t}\left[\Gamma_{u}(\overline{H}_{\tau})-\Gamma_{u}(U_{\tau})\right]\leq\Phi_{1}-\Phi_{T+1}+\frac{(\eta_{T}-\eta_{0})D^{2}}{2}\;." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><munder><mo lspace="0.167em" movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>t</mi></msub></mrow></munder><mrow><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi mathvariant="normal">Γ</mi><mi>u</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mi>τ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi mathvariant="normal">Γ</mi><mi>u</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>U</mi><mi>τ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><msub><mi mathvariant="normal">Φ</mi><mn>1</mn></msub><mo>−</mo><msub><mi mathvariant="normal">Φ</mi><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>η</mi><mi>T</mi></msub><mo>−</mo><msub><mi>η</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\sum_{t=1}^{T}\sum_{\tau\in\mathcal{F}_{t}}a_{\tau,t}\left[\Gamma_{u}(\overline{H}_{\tau})-\Gamma_{u}(U_{\tau})\right]\leq\Phi_{1}-\Phi_{T+1}+\frac{(\eta_{T}-\eta_{0})D^{2}}{2}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p25.2" class="ltx_p"><span id="A3.p25.2.1" class="ltx_text">Since <math id="A3.p25.m2" class="ltx_Math" alttext="m_{1}=m_{T+1}=\emptyset" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mn>1</mn></msub><mo>=</mo><msub><mi>m</mi><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">m_{1}=m_{T+1}=\emptyset</annotation></semantics></math>, we have
<math id="A3.p25.m3" class="ltx_Math" alttext="\Phi_{T+1}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Φ</mi><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Phi_{T+1}\geq 0</annotation></semantics></math>, while
<math id="A3.p25.m4" class="ltx_Math" alttext="\Phi_{1}=\Gamma_{u}(F_{1})=\frac{\eta_{1}}{2}\|u-x_{1}\|_{2}^{2}\leq\frac{\eta_{1}D^{2}}{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Φ</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mi mathvariant="normal">Γ</mi><mi>u</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><msub><mi>η</mi><mn>1</mn></msub><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>u</mi><mo>−</mo><msub><mi>x</mi><mn>1</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>≤</mo><mfrac><mrow><msub><mi>η</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">\Phi_{1}=\Gamma_{u}(F_{1})=\frac{\eta_{1}}{2}\|u-x_{1}\|_{2}^{2}\leq\frac{\eta_{1}D^{2}}{2}</annotation></semantics></math>.
Using <math id="A3.p25.m5" class="ltx_Math" alttext="\eta_{0}=\eta_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mn>0</mn></msub><mo>=</mo><msub><mi>η</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\eta_{0}=\eta_{1}</annotation></semantics></math>, we therefore obtain</span></p>
<table id="A3.Ex147" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex147.m1" class="ltx_Math" alttext="\sum_{t=1}^{T}\sum_{\tau\in\mathcal{F}_{t}}a_{\tau,t}\left[\Gamma_{u}(\overline{H}_{\tau})-\Gamma_{u}(U_{\tau})\right]\leq\frac{\eta_{T}D^{2}}{2}\;." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><munder><mo lspace="0.167em" movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>t</mi></msub></mrow></munder><mrow><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi mathvariant="normal">Γ</mi><mi>u</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mi>τ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi mathvariant="normal">Γ</mi><mi>u</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>U</mi><mi>τ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mfrac><mrow><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\sum_{t=1}^{T}\sum_{\tau\in\mathcal{F}_{t}}a_{\tau,t}\left[\Gamma_{u}(\overline{H}_{\tau})-\Gamma_{u}(U_{\tau})\right]\leq\frac{\eta_{T}D^{2}}{2}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.p26" class="ltx_para">
<p id="A3.p26.1" class="ltx_p"><span id="A3.p26.1.1" class="ltx_text">Finally, since <math id="A3.p26.m1" class="ltx_Math" alttext="\tau\in\mathcal{F}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\tau\in\mathcal{F}_{t}</annotation></semantics></math> if and only if
<math id="A3.p26.m2" class="ltx_Math" alttext="t=\tau+d_{\tau}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><mi>τ</mi><mo>+</mo><msub><mi>d</mi><mi>τ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">t=\tau+d_{\tau}</annotation></semantics></math>, reindexing the sum yields</span></p>
<table id="A3.Ex148" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex148.m1" class="ltx_Math" alttext="\sum_{t=1}^{T}a_{t,t+d_{t}}\left[\overline{H}_{t}(u)-\min_{x\in\mathcal{X}}\overline{H}_{t}(x)-U_{t}(u)+\min_{x\in\mathcal{X}}U_{t}(x)\right]\leq\frac{\eta_{T}D^{2}}{2}\;," display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><msub><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><munder><mi>min</mi><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>U</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><munder><mi>min</mi><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mi>U</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>≤</mo><mfrac><mrow><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mrow><mo lspace="0.280em">,</mo></mrow><annotation encoding="application/x-tex">\sum_{t=1}^{T}a_{t,t+d_{t}}\left[\overline{H}_{t}(u)-\min_{x\in\mathcal{X}}\overline{H}_{t}(x)-U_{t}(u)+\min_{x\in\mathcal{X}}U_{t}(x)\right]\leq\frac{\eta_{T}D^{2}}{2}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p26.2" class="ltx_p"><span id="A3.p26.2.1" class="ltx_text">which proves the claim.
∎</span></p>
</div>
</div>
<div id="A3.p27" class="ltx_para">
<p id="A3.p27.1" class="ltx_p">The following lemma controls the cumulative logarithmic stability term by combining a global log-determinant bound with a localized overlap bound. For every <math id="A3.p27.m1" class="ltx_Math" alttext="\tau\in\{0,\ldots,T\}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in\{0,\ldots,T\}</annotation></semantics></math>, it yields a decomposition into a prefix term depending on <math id="A3.p27.m2" class="ltx_Math" alttext="\sigma_{\tau}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>τ</mi></msub><annotation encoding="application/x-tex">\sigma_{\tau}</annotation></semantics></math> and a suffix term depending on <math id="A3.p27.m3" class="ltx_Math" alttext="\sum_{t=\tau+1}^{T}\left|m_{t}\right|/\eta_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>T</mi></msubsup><mrow><mo lspace="0em">|</mo><msub><mi>m</mi><mi>t</mi></msub><mo>|</mo></mrow></mrow><mo>/</mo><msub><mi>η</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\sum_{t=\tau+1}^{T}\left|m_{t}\right|/\eta_{t}</annotation></semantics></math>.</p>
</div>
<div id="Thmlemma8" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma8.2" class="ltx_text ltx_font_bold">Lemma 8</span></span><span id="Thmlemma8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma8.p1" class="ltx_para">
<p id="Thmlemma8.p1.1" class="ltx_p"><span id="Thmlemma8.p1.1.1" class="ltx_text ltx_font_italic">Under the same assumptions as <a href="#A3.Thmtheorem1" title="Theorem C.1. ‣ Appendix C Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">C.1</span></a>, for every
<math id="Thmlemma8.p1.m1" class="ltx_Math" alttext="\tau\in\{0,\ldots,T\}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in\{0,\ldots,T\}</annotation></semantics></math>,</span></p>
<table id="A3.EGx74" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex149"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex149.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{T}\log\left(1+\frac{\beta}{a_{t,t+d_{t}}}\lVert g_{t}\rVert_{(\nabla^{2}\overline{H}_{t})^{-1}}^{2}\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>β</mi><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo fence="true" rspace="0em">∥</mo><msub><mi>g</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mo rspace="0.167em">∇</mo><mn>2</mn></msup><msub><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{T}\log\left(1+\frac{\beta}{a_{t,t+d_{t}}}\lVert g_{t}\rVert_{(\nabla^{2}\overline{H}_{t})^{-1}}^{2}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex149.m2" class="ltx_Math" alttext="\displaystyle\leq n\log\left(\frac{\eta_{T}}{\eta_{0}}+\frac{\beta G^{2}T}{n\eta_{0}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>η</mi><mi>T</mi></msub><msub><mi>η</mi><mn>0</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mn>0</mn></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq n\log\left(\frac{\eta_{T}}{\eta_{0}}+\frac{\beta G^{2}T}{n\eta_{0}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E41.m1" class="ltx_Math" alttext="\displaystyle\quad+\sigma_{\tau}n\log\left(\frac{\eta_{\tau}}{\eta_{0}}+\frac{\beta G^{2}\tau}{n\eta_{0}}\right)+2\beta G^{2}\sum_{t=\tau+1}^{T}\frac{|m_{t}|}{\eta_{t}}\;." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><msub><mi>σ</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>η</mi><mi>τ</mi></msub><msub><mi>η</mi><mn>0</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mn>0</mn></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>T</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">|</mo></mrow><msub><mi>η</mi><mi>t</mi></msub></mfrac></mstyle></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sigma_{\tau}n\log\left(\frac{\eta_{\tau}}{\eta_{0}}+\frac{\beta G^{2}\tau}{n\eta_{0}}\right)+2\beta G^{2}\sum_{t=\tau+1}^{T}\frac{|m_{t}|}{\eta_{t}}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(41)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.6" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.p28" class="ltx_para">
<p id="A3.p28.1" class="ltx_p"><span id="A3.p28.1.1" class="ltx_text">By <a href="#Thmlemma2" title="Lemma 2. ‣ A.3 Auxiliary Results for Algorithm ‣ Appendix A Omitted Details from ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">2</span></a>, <math id="A3.p28.m1" class="ltx_Math" alttext="a_{t,t+d_{t}}=1/\chi_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow></msub><mo>=</mo><mrow><mn>1</mn><mo>/</mo><msub><mi>χ</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">a_{t,t+d_{t}}=1/\chi_{t}</annotation></semantics></math>. Therefore,</span></p>
<table id="A3.EGx75" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex150"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex150.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{T}\log\left(1+\frac{\beta}{a_{t,t+d_{t}}}\lVert g_{t}\rVert_{(\nabla^{2}\overline{H}_{t})^{-1}}^{2}\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>β</mi><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo fence="true" rspace="0em">∥</mo><msub><mi>g</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mo rspace="0.167em">∇</mo><mn>2</mn></msup><msub><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{T}\log\left(1+\frac{\beta}{a_{t,t+d_{t}}}\lVert g_{t}\rVert_{(\nabla^{2}\overline{H}_{t})^{-1}}^{2}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex150.m2" class="ltx_Math" alttext="\displaystyle=\sum_{t=1}^{T}a_{t,t+d_{t}}\log\left(1+\frac{\beta}{a_{t,t+d_{t}}}\lVert g_{t}\rVert_{(\nabla^{2}\overline{H}_{t})^{-1}}^{2}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>β</mi><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo fence="true" rspace="0em">∥</mo><msub><mi>g</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mo rspace="0.167em">∇</mo><mn>2</mn></msup><msub><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{t=1}^{T}a_{t,t+d_{t}}\log\left(1+\frac{\beta}{a_{t,t+d_{t}}}\lVert g_{t}\rVert_{(\nabla^{2}\overline{H}_{t})^{-1}}^{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E42.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{t=1}^{T}(\chi_{t}-1)a_{t,t+d_{t}}\log\left(1+\frac{\beta}{a_{t,t+d_{t}}}\lVert g_{t}\rVert_{(\nabla^{2}\overline{H}_{t})^{-1}}^{2}\right)." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mo stretchy="false">(</mo><msub><mi>χ</mi><mi>t</mi></msub><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow></msub><mi>log</mi><mrow><mo>(</mo><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>β</mi><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow></msub></mfrac></mstyle><msubsup><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><msub><mi>g</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mo rspace="0.167em">∇</mo><mn>2</mn></msup><msub><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mn>2</mn></msubsup><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{t=1}^{T}(\chi_{t}-1)a_{t,t+d_{t}}\log\left(1+\frac{\beta}{a_{t,t+d_{t}}}\lVert g_{t}\rVert_{(\nabla^{2}\overline{H}_{t})^{-1}}^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(42)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p29" class="ltx_para">
<p id="A3.p29.1" class="ltx_p"><span id="A3.p29.1.1" class="ltx_text">We first control the first term in <a href="#A3.E42" title="In Proof. ‣ Appendix C Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">42</span></a>. Applying
<a href="#Thmlemma9" title="Lemma 9. ‣ Appendix C Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">9</span></a> with <math id="A3.p29.m1" class="ltx_Math" alttext="\tau=T" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>=</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">\tau=T</annotation></semantics></math> gives</span></p>
<table id="A3.EGx76" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E43.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{T}a_{t,t+d_{t}}\log\left(1+\frac{\beta}{a_{t,t+d_{t}}}\lVert g_{t}\rVert_{(\nabla^{2}\overline{H}_{t})^{-1}}^{2}\right)\leq\log\frac{\det\left(\eta_{T}I+\beta\sum_{t=1}^{T}g_{t}g_{t}^{\top}\right)}{\det(\eta_{0}I)}\;." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>β</mi><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo fence="true" rspace="0em">∥</mo><msub><mi>g</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mo rspace="0.167em">∇</mo><mn>2</mn></msup><msub><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mo rspace="0em">det</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><msub><mi>g</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>g</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mrow><mo rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>η</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{T}a_{t,t+d_{t}}\log\left(1+\frac{\beta}{a_{t,t+d_{t}}}\lVert g_{t}\rVert_{(\nabla^{2}\overline{H}_{t})^{-1}}^{2}\right)\leq\log\frac{\det\left(\eta_{T}I+\beta\sum_{t=1}^{T}g_{t}g_{t}^{\top}\right)}{\det(\eta_{0}I)}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(43)</span></td></tr></tbody>
</table>
<p id="A3.p29.2" class="ltx_p"><span id="A3.p29.2.1" class="ltx_text">We will also use the corresponding prefix bound from
<a href="#Thmlemma9" title="Lemma 9. ‣ Appendix C Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">9</span></a> for arbitrary
<math id="A3.p29.m2" class="ltx_Math" alttext="\tau\in\{0,\ldots,T\}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in\{0,\ldots,T\}</annotation></semantics></math>.</span></p>
</div>
<div id="A3.p30" class="ltx_para">
<p id="A3.p30.1" class="ltx_p"><span id="A3.p30.1.1" class="ltx_text">We next control the second term in
<a href="#A3.E42" title="In Proof. ‣ Appendix C Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">42</span></a>. For convenience, define</span></p>
<table id="A3.Ex151" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex151.m1" class="ltx_Math" alttext="b_{t}\coloneq a_{t,t+d_{t}}\log\left(1+\frac{\beta}{a_{t,t+d_{t}}}\lVert g_{t}\rVert_{(\nabla^{2}\overline{H}_{t})^{-1}}^{2}\right)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>b</mi><mi>t</mi></msub><mo>≔</mo><mrow><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mfrac><mi>β</mi><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo fence="true" rspace="0em">∥</mo><msub><mi>g</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mo rspace="0.167em">∇</mo><mn>2</mn></msup><msub><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">b_{t}\coloneq a_{t,t+d_{t}}\log\left(1+\frac{\beta}{a_{t,t+d_{t}}}\lVert g_{t}\rVert_{(\nabla^{2}\overline{H}_{t})^{-1}}^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p30.2" class="ltx_p"><span id="A3.p30.2.1" class="ltx_text">Since
<math id="A3.p30.m1" class="ltx_Math" alttext="\nabla^{2}\overline{H}_{t}\succeq\eta_{t+d_{t}}I" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mo>∇</mo><mn>2</mn></msup><msub><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mi>t</mi></msub></mrow><mo>⪰</mo><mrow><msub><mi>η</mi><mrow><mi>t</mi><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><annotation encoding="application/x-tex">\nabla^{2}\overline{H}_{t}\succeq\eta_{t+d_{t}}I</annotation></semantics></math>,
<math id="A3.p30.m2" class="ltx_Math" alttext="\lVert g_{t}\rVert_{2}\leq G" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo fence="true" rspace="0em">∥</mo><msub><mi>g</mi><mi>t</mi></msub><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub><mo>≤</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">\lVert g_{t}\rVert_{2}\leq G</annotation></semantics></math>, and
<math id="A3.p30.m3" class="ltx_Math" alttext="\log(1+x)\leq x" display="inline" intent=":literal"><semantics><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>x</mi></mrow><annotation encoding="application/x-tex">\log(1+x)\leq x</annotation></semantics></math>, we have</span></p>
<table id="A3.E44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E44.m1" class="ltx_Math" alttext="b_{t}\leq\frac{\beta G^{2}}{\eta_{t+d_{t}}}\;." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>b</mi><mi>t</mi></msub><mo>≤</mo><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow><msub><mi>η</mi><mrow><mi>t</mi><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></msub></mfrac></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">b_{t}\leq\frac{\beta G^{2}}{\eta_{t+d_{t}}}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(44)</span></td></tr></tbody>
</table>
<p id="A3.p30.3" class="ltx_p"><span id="A3.p30.3.1" class="ltx_text">Thus, it remains to control
<math id="A3.p30.m4" class="ltx_Math" alttext="\sum_{t=1}^{T}(\chi_{t}-1)b_{t}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mrow><mo lspace="0em" stretchy="false">(</mo><mrow><msub><mi>χ</mi><mi>t</mi></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\sum_{t=1}^{T}(\chi_{t}-1)b_{t}</annotation></semantics></math>. We now bound the factors <math id="A3.p30.m5" class="ltx_Math" alttext="\chi_{t}-1" display="inline" intent=":literal"><semantics><mrow><msub><mi>χ</mi><mi>t</mi></msub><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\chi_{t}-1</annotation></semantics></math>. Fix
<math id="A3.p30.m6" class="ltx_Math" alttext="\tau\in\{0,\ldots,T\}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in\{0,\ldots,T\}</annotation></semantics></math>. For <math id="A3.p30.m7" class="ltx_Math" alttext="t\leq\tau" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">t\leq\tau</annotation></semantics></math> and <math id="A3.p30.m8" class="ltx_Math" alttext="s\in I_{t}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><msub><mi>I</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">s\in I_{t}</annotation></semantics></math>, if
<math id="A3.p30.m9" class="ltx_Math" alttext="s\leq\tau" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>≤</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">s\leq\tau</annotation></semantics></math>, then <math id="A3.p30.m10" class="ltx_Math" alttext="|m_{s}|\leq\sigma_{\tau}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>m</mi><mi>s</mi></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><msub><mi>σ</mi><mi>τ</mi></msub></mrow><annotation encoding="application/x-tex">|m_{s}|\leq\sigma_{\tau}</annotation></semantics></math>. If <math id="A3.p30.m11" class="ltx_Math" alttext="s&gt;\tau" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>&gt;</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">s&gt;\tau</annotation></semantics></math>, every
observation missing at round <math id="A3.p30.m12" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> was either already missing at round
<math id="A3.p30.m13" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>, or was generated during one of the rounds
<math id="A3.p30.m14" class="ltx_Math" alttext="\tau,\ldots,s-1" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\tau,\ldots,s-1</annotation></semantics></math>. Hence, in either case,
<math id="A3.p30.m15" class="ltx_Math" alttext="|m_{s}|\leq\sigma_{\tau}+(s-\tau)_{+}\leq\sigma_{\tau}+(t+d_{t}-\tau)_{+}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>m</mi><mi>s</mi></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><msub><mi>σ</mi><mi>τ</mi></msub><mo>+</mo><msub><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo></msub></mrow><mo>≤</mo><mrow><msub><mi>σ</mi><mi>τ</mi></msub><mo>+</mo><msub><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>t</mi><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo></msub></mrow></mrow><annotation encoding="application/x-tex">|m_{s}|\leq\sigma_{\tau}+(s-\tau)_{+}\leq\sigma_{\tau}+(t+d_{t}-\tau)_{+}</annotation></semantics></math>. Taking the maximum over
<math id="A3.p30.m16" class="ltx_Math" alttext="s\in I_{t}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><msub><mi>I</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">s\in I_{t}</annotation></semantics></math> gives</span></p>
<table id="A3.E45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E45.m1" class="ltx_Math" alttext="\chi_{t}-1\leq\sigma_{\tau}+\left|\{j&gt;\tau:t&lt;j\leq t+d_{t}\}\right|." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>χ</mi><mi>t</mi></msub><mo>−</mo><mn>1</mn></mrow><mo>≤</mo><mrow><msub><mi>σ</mi><mi>τ</mi></msub><mo>+</mo><mrow><mo>|</mo><mrow><mo stretchy="false">{</mo><mrow><mi>j</mi><mo>&gt;</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>t</mi><mo>&lt;</mo><mi>j</mi><mo>≤</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow><mo stretchy="false">}</mo></mrow><mo>|</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\chi_{t}-1\leq\sigma_{\tau}+\left|\{j&gt;\tau:t&lt;j\leq t+d_{t}\}\right|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(45)</span></td></tr></tbody>
</table>
<p id="A3.p30.4" class="ltx_p"><span id="A3.p30.4.1" class="ltx_text">For <math id="A3.p30.m17" class="ltx_Math" alttext="t&gt;\tau" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&gt;</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">t&gt;\tau</annotation></semantics></math>, every observation missing at <math id="A3.p30.m18" class="ltx_Math" alttext="s\in I_{t}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><msub><mi>I</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">s\in I_{t}</annotation></semantics></math> was either
already missing at round <math id="A3.p30.m19" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, or was generated during one of the
rounds <math id="A3.p30.m20" class="ltx_Math" alttext="t,\ldots,s-1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t,\ldots,s-1</annotation></semantics></math>. Thus
<math id="A3.p30.m21" class="ltx_Math" alttext="|m_{s}|\leq|m_{t}|+(s-t)\leq|m_{t}|+d_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>m</mi><mi>s</mi></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">|m_{s}|\leq|m_{t}|+(s-t)\leq|m_{t}|+d_{t}</annotation></semantics></math>, and therefore</span></p>
<table id="A3.E46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E46.m1" class="ltx_Math" alttext="\chi_{t}-1\leq|m_{t}|+d_{t}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>χ</mi><mi>t</mi></msub><mo>−</mo><mn>1</mn></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\chi_{t}-1\leq|m_{t}|+d_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(46)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p31" class="ltx_para">
<p id="A3.p31.1" class="ltx_p"><span id="A3.p31.1.1" class="ltx_text">Let
<math id="A3.p31.m1" class="ltx_math_unparsed" alttext="\mathcal{P}_{\tau}\coloneq\{(i,j)\in[T]^{2}:i&lt;j,\ j&gt;\tau,\ i+d_{i}\geq j\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>τ</mi></msub><mo>≔</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mi>T</mi><mo rspace="0.278em" stretchy="false">]</mo></mrow><mn>2</mn></msup><mo rspace="0.278em">:</mo><mi>i</mi><mo>&lt;</mo><mi>j</mi><mo rspace="0.667em">,</mo><mi>j</mi><mo>&gt;</mo><mi>τ</mi><mo rspace="0.667em">,</mo><mi>i</mi><mo>+</mo><msub><mi>d</mi><mi>i</mi></msub><mo>≥</mo><mi>j</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{P}_{\tau}\coloneq\{(i,j)\in[T]^{2}:i&lt;j,\ j&gt;\tau,\ i+d_{i}\geq j\}</annotation></semantics></math>.
Using <a href="#A3.E45" title="In Proof. ‣ Appendix C Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equations</span> <span class="ltx_text ltx_ref_tag">45</span></a> and <a href="#A3.E46" title="Equation 46 ‣ Proof. ‣ Appendix C Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">46</span></a>, we obtain</span></p>
<table id="A3.EGx77" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex152"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex152.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{T}(\chi_{t}-1)b_{t}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>χ</mi><mi>t</mi></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{T}(\chi_{t}-1)b_{t}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex152.m2" class="ltx_Math" alttext="\displaystyle\leq\sigma_{\tau}\sum_{t=1}^{\tau}b_{t}+\sum_{i=1}^{\tau}\left|\{j&gt;\tau:i&lt;j\leq i+d_{i}\}\right|b_{i}+\sum_{i=\tau+1}^{T}d_{i}b_{i}+\sum_{j=\tau+1}^{T}|m_{j}|b_{j}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msub><mi>σ</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>τ</mi></munderover></mstyle><msub><mi>b</mi><mi>t</mi></msub></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>τ</mi></munderover></mstyle><mrow><mrow><mo>|</mo><mrow><mo stretchy="false">{</mo><mrow><mi>j</mi><mo>&gt;</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>i</mi><mo>&lt;</mo><mi>j</mi><mo>≤</mo><mrow><mi>i</mi><mo>+</mo><msub><mi>d</mi><mi>i</mi></msub></mrow></mrow><mo stretchy="false">}</mo></mrow><mo>|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>i</mi></msub></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>i</mi></msub></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>T</mi></munderover></mstyle><mrow><mrow><mo stretchy="false">|</mo><msub><mi>m</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>j</mi></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sigma_{\tau}\sum_{t=1}^{\tau}b_{t}+\sum_{i=1}^{\tau}\left|\{j&gt;\tau:i&lt;j\leq i+d_{i}\}\right|b_{i}+\sum_{i=\tau+1}^{T}d_{i}b_{i}+\sum_{j=\tau+1}^{T}|m_{j}|b_{j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E47.m1" class="ltx_Math" alttext="\displaystyle=\sigma_{\tau}\sum_{t=1}^{\tau}b_{t}+\sum_{(i,j)\in\mathcal{P}_{\tau}}(b_{i}+b_{j})\;." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>σ</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>τ</mi></munderover></mstyle><msub><mi>b</mi><mi>t</mi></msub></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>τ</mi></msub></mrow></munder></mstyle><mrow><mo stretchy="false">(</mo><mrow><msub><mi>b</mi><mi>i</mi></msub><mo>+</mo><msub><mi>b</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sigma_{\tau}\sum_{t=1}^{\tau}b_{t}+\sum_{(i,j)\in\mathcal{P}_{\tau}}(b_{i}+b_{j})\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(47)</span></td></tr></tbody>
</table>
<p id="A3.p31.2" class="ltx_p"><span id="A3.p31.2.1" class="ltx_text">The two sums</span></p>
<table id="A3.Ex153" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex153.m1" class="ltx_Math" alttext="\sum_{i=1}^{\tau}\left|\{j&gt;\tau:i&lt;j\leq i+d_{i}\}\right|b_{i}\quad\text{and}\quad\sum_{i=\tau+1}^{T}d_{i}b_{i}" display="block" intent=":literal"><semantics><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>τ</mi></munderover><mrow><mrow><mo lspace="0em">|</mo><mrow><mo stretchy="false">{</mo><mrow><mi>j</mi><mo>&gt;</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>i</mi><mo>&lt;</mo><mi>j</mi><mo>≤</mo><mrow><mi>i</mi><mo>+</mo><msub><mi>d</mi><mi>i</mi></msub></mrow></mrow><mo stretchy="false">}</mo></mrow><mo>|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>i</mi></msub></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>T</mi></munderover><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{\tau}\left|\{j&gt;\tau:i&lt;j\leq i+d_{i}\}\right|b_{i}\quad\text{and}\quad\sum_{i=\tau+1}^{T}d_{i}b_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p31.3" class="ltx_p"><span id="A3.p31.3.1" class="ltx_text">together equal
<math id="A3.p31.m2" class="ltx_Math" alttext="\sum_{(i,j)\in\mathcal{P}_{\tau}}b_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∑</mo><mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>τ</mi></msub></mrow></msub><msub><mi>b</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\sum_{(i,j)\in\mathcal{P}_{\tau}}b_{i}</annotation></semantics></math>, since they count the pairs
in <math id="A3.p31.m3" class="ltx_Math" alttext="\mathcal{P}_{\tau}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>τ</mi></msub><annotation encoding="application/x-tex">\mathcal{P}_{\tau}</annotation></semantics></math> according to their smaller endpoint <math id="A3.p31.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.
Moreover, since
<math id="A3.p31.m5" class="ltx_Math" alttext="|m_{j}|=|\{i&lt;j:i+d_{i}\geq j\}|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>m</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mo stretchy="false">|</mo><mrow><mo stretchy="false">{</mo><mrow><mi>i</mi><mo>&lt;</mo><mi>j</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>i</mi><mo>+</mo><msub><mi>d</mi><mi>i</mi></msub></mrow><mo>≥</mo><mi>j</mi></mrow><mo stretchy="false">}</mo></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">|m_{j}|=|\{i&lt;j:i+d_{i}\geq j\}|</annotation></semantics></math>, the sum
<math id="A3.p31.m6" class="ltx_Math" alttext="\sum_{j=\tau+1}^{T}|m_{j}|b_{j}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>T</mi></msubsup><mrow><mrow><mo lspace="0em" stretchy="false">|</mo><msub><mi>m</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\sum_{j=\tau+1}^{T}|m_{j}|b_{j}</annotation></semantics></math> equals
<math id="A3.p31.m7" class="ltx_Math" alttext="\sum_{(i,j)\in\mathcal{P}_{\tau}}b_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∑</mo><mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>τ</mi></msub></mrow></msub><msub><mi>b</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\sum_{(i,j)\in\mathcal{P}_{\tau}}b_{j}</annotation></semantics></math>.
Hence, the three sums combine to
<math id="A3.p31.m8" class="ltx_Math" alttext="\sum_{(i,j)\in\mathcal{P}_{\tau}}(b_{i}+b_{j})" display="inline" intent=":literal"><semantics><mrow><msub><mo>∑</mo><mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>τ</mi></msub></mrow></msub><mrow><mo lspace="0em" stretchy="false">(</mo><mrow><msub><mi>b</mi><mi>i</mi></msub><mo>+</mo><msub><mi>b</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sum_{(i,j)\in\mathcal{P}_{\tau}}(b_{i}+b_{j})</annotation></semantics></math>.</span></p>
</div>
<div id="A3.p32" class="ltx_para">
<p id="A3.p32.1" class="ltx_p"><span id="A3.p32.1.1" class="ltx_text">For every <math id="A3.p32.m1" class="ltx_Math" alttext="(i,j)\in\mathcal{P}_{\tau}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>τ</mi></msub></mrow><annotation encoding="application/x-tex">(i,j)\in\mathcal{P}_{\tau}</annotation></semantics></math>, we have <math id="A3.p32.m2" class="ltx_Math" alttext="i+d_{i}\geq j" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>+</mo><msub><mi>d</mi><mi>i</mi></msub></mrow><mo>≥</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i+d_{i}\geq j</annotation></semantics></math>.
Since <math id="A3.p32.m3" class="ltx_Math" alttext="(\eta_{t})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>η</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\eta_{t})</annotation></semantics></math> is non-decreasing,
<a href="#A3.E44" title="In Proof. ‣ Appendix C Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">44</span></a> gives
<math id="A3.p32.m4" class="ltx_Math" alttext="b_{i}+b_{j}\leq\beta G^{2}/\eta_{i+d_{i}}+\beta G^{2}/\eta_{j+d_{j}}\leq 2\beta G^{2}/\eta_{j}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>b</mi><mi>i</mi></msub><mo>+</mo><msub><mi>b</mi><mi>j</mi></msub></mrow><mo>≤</mo><mrow><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow><mo>/</mo><msub><mi>η</mi><mrow><mi>i</mi><mo>+</mo><msub><mi>d</mi><mi>i</mi></msub></mrow></msub></mrow><mo>+</mo><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow><mo>/</mo><msub><mi>η</mi><mrow><mi>j</mi><mo>+</mo><msub><mi>d</mi><mi>j</mi></msub></mrow></msub></mrow></mrow><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup></mrow><mo>/</mo><msub><mi>η</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">b_{i}+b_{j}\leq\beta G^{2}/\eta_{i+d_{i}}+\beta G^{2}/\eta_{j+d_{j}}\leq 2\beta G^{2}/\eta_{j}</annotation></semantics></math>.
Moreover, for each <math id="A3.p32.m5" class="ltx_Math" alttext="j&gt;\tau" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>&gt;</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">j&gt;\tau</annotation></semantics></math>, there are exactly
<math id="A3.p32.m6" class="ltx_Math" alttext="|m_{j}|=|\{i&lt;j:i+d_{i}\geq j\}|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>m</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mo stretchy="false">|</mo><mrow><mo stretchy="false">{</mo><mrow><mi>i</mi><mo>&lt;</mo><mi>j</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>i</mi><mo>+</mo><msub><mi>d</mi><mi>i</mi></msub></mrow><mo>≥</mo><mi>j</mi></mrow><mo stretchy="false">}</mo></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">|m_{j}|=|\{i&lt;j:i+d_{i}\geq j\}|</annotation></semantics></math> pairs in <math id="A3.p32.m7" class="ltx_Math" alttext="\mathcal{P}_{\tau}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>τ</mi></msub><annotation encoding="application/x-tex">\mathcal{P}_{\tau}</annotation></semantics></math> with
larger endpoint <math id="A3.p32.m8" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>. Hence</span></p>
<table id="A3.Ex154" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex154.m1" class="ltx_Math" alttext="\sum_{(i,j)\in\mathcal{P}_{\tau}}(b_{i}+b_{j})\leq 2\beta G^{2}\sum_{j=\tau+1}^{T}\frac{|m_{j}|}{\eta_{j}}\;." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>τ</mi></msub></mrow></munder><mrow><mo lspace="0em" stretchy="false">(</mo><mrow><msub><mi>b</mi><mi>i</mi></msub><mo>+</mo><msub><mi>b</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>T</mi></munderover><mfrac><mrow><mo stretchy="false">|</mo><msub><mi>m</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><msub><mi>η</mi><mi>j</mi></msub></mfrac></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\sum_{(i,j)\in\mathcal{P}_{\tau}}(b_{i}+b_{j})\leq 2\beta G^{2}\sum_{j=\tau+1}^{T}\frac{|m_{j}|}{\eta_{j}}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p32.2" class="ltx_p"><span id="A3.p32.2.1" class="ltx_text">Substituting this bound and the definition of <math id="A3.p32.m9" class="ltx_Math" alttext="b_{t}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>t</mi></msub><annotation encoding="application/x-tex">b_{t}</annotation></semantics></math> into
<a href="#A3.E47" title="In Proof. ‣ Appendix C Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">47</span></a> yields</span></p>
<table id="A3.EGx78" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex155"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex155.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{T}(\chi_{t}-1)a_{t,t+d_{t}}\log\left(1+\frac{\beta}{a_{t,t+d_{t}}}\lVert g_{t}\rVert_{(\nabla^{2}\overline{H}_{t})^{-1}}^{2}\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>χ</mi><mi>t</mi></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>β</mi><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo fence="true" rspace="0em">∥</mo><msub><mi>g</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mo rspace="0.167em">∇</mo><mn>2</mn></msup><msub><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{T}(\chi_{t}-1)a_{t,t+d_{t}}\log\left(1+\frac{\beta}{a_{t,t+d_{t}}}\lVert g_{t}\rVert_{(\nabla^{2}\overline{H}_{t})^{-1}}^{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E48.m1" class="ltx_Math" alttext="\displaystyle\qquad\leq\sigma_{\tau}\sum_{t=1}^{\tau}a_{t,t+d_{t}}\log\left(1+\frac{\beta}{a_{t,t+d_{t}}}\lVert g_{t}\rVert_{(\nabla^{2}\overline{H}_{t})^{-1}}^{2}\right)+2\beta G^{2}\sum_{t=\tau+1}^{T}\frac{|m_{t}|}{\eta_{t}}\;." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="2.278em">≤</mo><mrow><mrow><msub><mi>σ</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>τ</mi></munderover></mstyle><mrow><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>β</mi><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo fence="true" rspace="0em">∥</mo><msub><mi>g</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mo rspace="0.167em">∇</mo><mn>2</mn></msup><msub><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>T</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">|</mo></mrow><msub><mi>η</mi><mi>t</mi></msub></mfrac></mstyle></mrow></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\leq\sigma_{\tau}\sum_{t=1}^{\tau}a_{t,t+d_{t}}\log\left(1+\frac{\beta}{a_{t,t+d_{t}}}\lVert g_{t}\rVert_{(\nabla^{2}\overline{H}_{t})^{-1}}^{2}\right)+2\beta G^{2}\sum_{t=\tau+1}^{T}\frac{|m_{t}|}{\eta_{t}}\;.</annotation></semantics></math></td>
