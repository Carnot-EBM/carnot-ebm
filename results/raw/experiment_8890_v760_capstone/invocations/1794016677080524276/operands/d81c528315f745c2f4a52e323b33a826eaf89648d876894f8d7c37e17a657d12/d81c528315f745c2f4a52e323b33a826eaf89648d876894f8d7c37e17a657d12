msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">a_{r,r+d_{r}}\log\left(1+\frac{\beta}{a_{r,r+d_{r}}}\lVert g_{r}\rVert_{(\nabla^{2}\overline{H}_{r})^{-1}}^{2}\right)\leq a_{r,\tau}\log\left(1+\frac{\beta}{a_{r,\tau}}\left\lVert g_{r}\right\rVert_{\left(\nabla^{2}H_{r}+(\eta_{\tau}-\eta_{r-1})I\right)^{-1}}^{2}\right).</annotation></semantics></math></td>
