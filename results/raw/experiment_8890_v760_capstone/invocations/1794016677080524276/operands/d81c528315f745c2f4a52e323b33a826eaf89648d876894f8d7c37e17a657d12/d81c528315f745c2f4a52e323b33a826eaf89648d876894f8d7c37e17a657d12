<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p10" class="ltx_para">
<p id="A3.p10.1" class="ltx_p"><span id="A3.p10.1.1" class="ltx_text">Now suppose that the reverse inequality holds, and define</span></p>
<table id="A3.Ex124" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex124.m1" class="ltx_Math" alttext="\tau^{\star}\coloneq\max\left(\{0\}\cup\left\{t\in[T]:\frac{\sigma_{t}n}{2\beta D^{2}}\log\left(1+t+\frac{\beta GDt}{n}\right)\leq\frac{G}{D}\sqrt{1+\sum_{s=1}^{t}|m_{s}|}\right\}\right)," display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>τ</mi><mo>⋆</mo></msup><mo>≔</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow><mo>∪</mo><mrow><mo>{</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo rspace="0.278em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mrow><mfrac><mrow><msub><mi>σ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mn>2</mn></msup></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi><mo>+</mo><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mi>n</mi></mfrac></mrow><mo>)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mfrac><mi>G</mi><mi>D</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover><mrow><mo stretchy="false">|</mo><msub><mi>m</mi><mi>s</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow></msqrt></mrow></mrow><mo>}</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\tau^{\star}\coloneq\max\left(\{0\}\cup\left\{t\in[T]:\frac{\sigma_{t}n}{2\beta D^{2}}\log\left(1+t+\frac{\beta GDt}{n}\right)\leq\frac{G}{D}\sqrt{1+\sum_{s=1}^{t}|m_{s}|}\right\}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p10.2" class="ltx_p"><span id="A3.p10.2.1" class="ltx_text">with the convention <math id="A3.p10.m1" class="ltx_Math" alttext="\sigma_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\sigma_{0}=0</annotation></semantics></math>.
By the definition of <math id="A3.p10.m2" class="ltx_Math" alttext="\tau^{\star}" display="inline" intent=":literal"><semantics><msup><mi>τ</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\tau^{\star}</annotation></semantics></math>, for every <math id="A3.p10.m3" class="ltx_Math" alttext="t&gt;\tau^{\star}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&gt;</mo><msup><mi>τ</mi><mo>⋆</mo></msup></mrow><annotation encoding="application/x-tex">t&gt;\tau^{\star}</annotation></semantics></math>,
<math id="A3.p10.m4" class="ltx_Math" alttext="\eta_{t}\geq\frac{G}{D}\sqrt{1+\sum_{s=1}^{t}|m_{s}|}" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>t</mi></msub><mo>≥</mo><mrow><mfrac><mi>G</mi><mi>D</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo rspace="0.055em">+</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></msubsup><mrow><mo stretchy="false">|</mo><msub><mi>m</mi><mi>s</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\eta_{t}\geq\frac{G}{D}\sqrt{1+\sum_{s=1}^{t}|m_{s}|}</annotation></semantics></math>.</span></p>
</div>
<div id="A3.p11" class="ltx_para">
<p id="A3.p11.1" class="ltx_p"><span id="A3.p11.1.1" class="ltx_text">For the prefix term of <a href="#A3.E32" title="In Proof. ‣ Appendix C Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">32</span></a>, by the definition of <math id="A3.p11.m1" class="ltx_Math" alttext="\tau^{\star}" display="inline" intent=":literal"><semantics><msup><mi>τ</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\tau^{\star}</annotation></semantics></math> and
<a href="#A3.E31" title="In Proof. ‣ Appendix C Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">31</span></a>,</span></p>
<table id="A3.EGx67" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E34.m1" class="ltx_Math" alttext="\displaystyle\frac{\sigma_{\tau^{\star}}n}{2\beta}\log\left(\frac{\eta_{\tau^{\star}}}{\eta_{0}}+\frac{\beta G^{2}\tau^{\star}}{n\eta_{0}}\right)\leq\frac{\sigma_{\tau^{\star}}n}{2\beta}\log\left(1+\tau^{\star}+\frac{\beta GD\tau^{\star}}{n}\right)\leq GD\sqrt{1+\sum_{s=1}^{\tau^{\star}}|m_{s}|}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>σ</mi><msup><mi>τ</mi><mo>⋆</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>η</mi><msup><mi>τ</mi><mo>⋆</mo></msup></msub><msub><mi>η</mi><mn>0</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mo>⋆</mo></msup></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mn>0</mn></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>σ</mi><msup><mi>τ</mi><mo>⋆</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>τ</mi><mo>⋆</mo></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mo>⋆</mo></msup></mrow><mi>n</mi></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>τ</mi><mo>⋆</mo></msup></munderover></mstyle><mrow><mo stretchy="false">|</mo><msub><mi>m</mi><mi>s</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\sigma_{\tau^{\star}}n}{2\beta}\log\left(\frac{\eta_{\tau^{\star}}}{\eta_{0}}+\frac{\beta G^{2}\tau^{\star}}{n\eta_{0}}\right)\leq\frac{\sigma_{\tau^{\star}}n}{2\beta}\log\left(1+\tau^{\star}+\frac{\beta GD\tau^{\star}}{n}\right)\leq GD\sqrt{1+\sum_{s=1}^{\tau^{\star}}|m_{s}|}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(34)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p12" class="ltx_para">
<p id="A3.p12.1" class="ltx_p"><span id="A3.p12.1.1" class="ltx_text">For the suffix term,</span></p>
<table id="A3.Ex125" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex125.m1" class="ltx_Math" alttext="G^{2}\sum_{t=\tau^{\star}+1}^{T}\frac{|m_{t}|}{\eta_{t}}\leq GD\sum_{t=\tau^{\star}+1}^{T}\frac{|m_{t}|}{\sqrt{1+\sum_{s=1}^{t}|m_{s}|}}\\
\leq 2GD\left(\sqrt{1+d_{\mathrm{tot}}}-\sqrt{1+\sum_{s=1}^{\tau^{\star}}|m_{s}|}\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msup><mi>τ</mi><mo>⋆</mo></msup><mo>+</mo><mn>1</mn></mrow></mrow><mi>T</mi></munderover><mfrac><mrow><mo stretchy="false">|</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">|</mo></mrow><msub><mi>η</mi><mi>t</mi></msub></mfrac></mrow></mrow><mo>≤</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msup><mi>τ</mi><mo>⋆</mo></msup><mo>+</mo><mn>1</mn></mrow></mrow><mi>T</mi></munderover><mfrac><mrow><mo stretchy="false">|</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">|</mo></mrow><msqrt><mrow><mn>1</mn><mo rspace="0.055em">+</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></msubsup><mrow><mo stretchy="false">|</mo><msub><mi>m</mi><mi>s</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow></msqrt></mfrac></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msqrt><mrow><mn>1</mn><mo>+</mo><msub><mi>d</mi><mi>tot</mi></msub></mrow></msqrt><mo>−</mo><msqrt><mrow><mn>1</mn><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>τ</mi><mo>⋆</mo></msup></munderover><mrow><mo stretchy="false">|</mo><msub><mi>m</mi><mi>s</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">G^{2}\sum_{t=\tau^{\star}+1}^{T}\frac{|m_{t}|}{\eta_{t}}\leq GD\sum_{t=\tau^{\star}+1}^{T}\frac{|m_{t}|}{\sqrt{1+\sum_{s=1}^{t}|m_{s}|}}\\
\leq 2GD\left(\sqrt{1+d_{\mathrm{tot}}}-\sqrt{1+\sum_{s=1}^{\tau^{\star}}|m_{s}|}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p12.2" class="ltx_p"><span id="A3.p12.2.1" class="ltx_text">where the last inequality follows by telescoping the square roots.</span></p>
</div>
<div id="A3.p13" class="ltx_para">
<p id="A3.p13.1" class="ltx_p"><span id="A3.p13.1.1" class="ltx_text">Since the second branch is selected at <math id="A3.p13.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>,
<math id="A3.p13.m2" class="ltx_Math" alttext="\eta_{T}D^{2}/2=\eta_{0}D^{2}/2+(GD/2)\sqrt{1+d_{\mathrm{tot}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mn>2</mn></msup></mrow><mo>/</mo><mn>2</mn></mrow><mo>=</mo><mrow><mrow><mrow><msub><mi>η</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mn>2</mn></msup></mrow><mo>/</mo><mn>2</mn></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>+</mo><msub><mi>d</mi><mi>tot</mi></msub></mrow></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta_{T}D^{2}/2=\eta_{0}D^{2}/2+(GD/2)\sqrt{1+d_{\mathrm{tot}}}</annotation></semantics></math>.
Applying <a href="#A3.Thmtheorem1" title="Theorem C.1. ‣ Appendix C Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">C.1</span></a> with <math id="A3.p13.m3" class="ltx_Math" alttext="\tau=\tau^{\star}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>=</mo><msup><mi>τ</mi><mo>⋆</mo></msup></mrow><annotation encoding="application/x-tex">\tau=\tau^{\star}</annotation></semantics></math> and using
<a href="#A3.E31" title="In Proof. ‣ Appendix C Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equations</span> <span class="ltx_text ltx_ref_tag">31</span></a>, <a href="#A3.E34" title="Equation 34 ‣ Proof. ‣ Appendix C Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">34</span></a> and <a href="#A3.Ex125" title="Proof. ‣ Appendix C Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a>
gives</span></p>
<table id="A3.E35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E35.m1" class="ltx_Math" alttext="\operatorname{Reg}_{T}(u)\leq\frac{\eta_{0}D^{2}}{2}+\frac{n}{2\beta}\log\left(1+T+\frac{\beta GDT}{n}\right)+\frac{7}{2}GD\sqrt{1+d_{\mathrm{tot}}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>Reg</mi><mi>T</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mrow><msub><mi>η</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac><mo>+</mo><mrow><mfrac><mi>n</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>T</mi><mo>+</mo><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mi>n</mi></mfrac></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mfrac><mn>7</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>+</mo><msub><mi>d</mi><mi>tot</mi></msub></mrow></msqrt></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{Reg}_{T}(u)\leq\frac{\eta_{0}D^{2}}{2}+\frac{n}{2\beta}\log\left(1+T+\frac{\beta GDT}{n}\right)+\frac{7}{2}GD\sqrt{1+d_{\mathrm{tot}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(35)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p14" class="ltx_para">
<p id="A3.p14.1" class="ltx_p"><span id="A3.p14.1.1" class="ltx_text">Combining <a href="#A3.E33" title="In Proof. ‣ Appendix C Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equations</span> <span class="ltx_text ltx_ref_tag">33</span></a> and <a href="#A3.E35" title="Equation 35 ‣ Proof. ‣ Appendix C Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a>, using
<math id="A3.p14.m1" class="ltx_Math" alttext="\eta_{0}=G/D" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mn>0</mn></msub><mo>=</mo><mrow><mi>G</mi><mo>/</mo><mi>D</mi></mrow></mrow><annotation encoding="application/x-tex">\eta_{0}=G/D</annotation></semantics></math> and
<math id="A3.p14.m2" class="ltx_Math" alttext="\log\left(1+T+\frac{\beta GDT}{n}\right)={\mathcal{O}}(\log T)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>T</mi><mo>+</mo><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mi>n</mi></mfrac></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\log\left(1+T+\frac{\beta GDT}{n}\right)={\mathcal{O}}(\log T)</annotation></semantics></math>, yields</span></p>
<table id="A3.Ex126" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex126.m1" class="ltx_Math" alttext="\operatorname{Reg}_{T}(u)={\mathcal{O}}\left(\frac{n}{\beta}\log T+\min\left\{\frac{\sigma_{\max}n}{\beta}\log T,\;GD\sqrt{1+d_{\mathrm{tot}}}\right\}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>Reg</mi><mi>T</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mfrac><mi>n</mi><mi>β</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo>+</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mfrac><mrow><msub><mi>σ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mi>β</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo rspace="0.447em">,</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>+</mo><msub><mi>d</mi><mi>tot</mi></msub></mrow></msqrt></mrow><mo>}</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{Reg}_{T}(u)={\mathcal{O}}\left(\frac{n}{\beta}\log T+\min\left\{\frac{\sigma_{\max}n}{\beta}\log T,\;GD\sqrt{1+d_{\mathrm{tot}}}\right\}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p14.2" class="ltx_p"><span id="A3.p14.2.1" class="ltx_text">The additive <math id="A3.p14.m3" class="ltx_Math" alttext="GD" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">GD</annotation></semantics></math> term is absorbed into <math id="A3.p14.m4" class="ltx_Math" alttext="(n/\beta)\log T" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><annotation encoding="application/x-tex">(n/\beta)\log T</annotation></semantics></math> since
<math id="A3.p14.m5" class="ltx_Math" alttext="\beta\leq 1/(8GD)" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>≤</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta\leq 1/(8GD)</annotation></semantics></math>.</span></p>
</div>
<div id="A3.p15" class="ltx_para">
<p id="A3.p15.1" class="ltx_p"><span id="A3.p15.1.1" class="ltx_text">Finally, if <math id="A3.p15.m1" class="ltx_Math" alttext="d_{\mathrm{tot}}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>tot</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d_{\mathrm{tot}}=0</annotation></semantics></math>, then <math id="A3.p15.m2" class="ltx_Math" alttext="\sigma_{\max}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>max</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\sigma_{\max}=0</annotation></semantics></math> and the
delay-dependent minimum vanishes. Otherwise,
<math id="A3.p15.m3" class="ltx_Math" alttext="d_{\mathrm{tot}}\geq 1" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>tot</mi></msub><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d_{\mathrm{tot}}\geq 1</annotation></semantics></math>, so
<math id="A3.p15.m4" class="ltx_Math" alttext="\sqrt{1+d_{\mathrm{tot}}}\leq\sqrt{2d_{\mathrm{tot}}}" display="inline" intent=":literal"><semantics><mrow><msqrt><mrow><mn>1</mn><mo>+</mo><msub><mi>d</mi><mi>tot</mi></msub></mrow></msqrt><mo>≤</mo><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>tot</mi></msub></mrow></msqrt></mrow><annotation encoding="application/x-tex">\sqrt{1+d_{\mathrm{tot}}}\leq\sqrt{2d_{\mathrm{tot}}}</annotation></semantics></math>.
Moreover, <math id="A3.p15.m5" class="ltx_Math" alttext="\beta\leq 1/(8GD)" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>≤</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta\leq 1/(8GD)</annotation></semantics></math> by definition, and hence <math id="A3.p15.m6" class="ltx_Math" alttext="GD\leq 1/(8\beta)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo>≤</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">GD\leq 1/(8\beta)</annotation></semantics></math>. Therefore,
<math id="A3.p15.m7" class="ltx_Math" alttext="GD\sqrt{1+d_{\mathrm{tot}}}\leq(\sqrt{2}/(8\beta))\sqrt{d_{\mathrm{tot}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>+</mo><msub><mi>d</mi><mi>tot</mi></msub></mrow></msqrt></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msqrt><mn>2</mn></msqrt><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>d</mi><mi>tot</mi></msub></msqrt></mrow></mrow><annotation encoding="application/x-tex">GD\sqrt{1+d_{\mathrm{tot}}}\leq(\sqrt{2}/(8\beta))\sqrt{d_{\mathrm{tot}}}</annotation></semantics></math>.
Absorbing the constant factor into the <math id="A3.p15.m8" class="ltx_Math" alttext="\mathcal{O}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(\cdot)</annotation></semantics></math> notation yields</span></p>
<table id="A3.Ex127" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex127.m1" class="ltx_Math" alttext="\operatorname{Reg}_{T}(u)=\mathcal{O}\left(\frac{1}{\beta}\left[n\log T+\min\left\{\sigma_{\max}n\log T,\;\sqrt{d_{\mathrm{tot}}}\right\}\right]\right).\qed" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>Reg</mi><mi>T</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mi>β</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo>+</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><msub><mi>σ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo rspace="0.447em">,</mo><msqrt><msub><mi>d</mi><mi>tot</mi></msub></msqrt><mo>}</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0.0835em">.</mo><mo class="ltx_mathvariant_italic" lspace="0.0835em" mathvariant="italic" separator="true">∎</mo></mrow><annotation encoding="application/x-tex">\operatorname{Reg}_{T}(u)=\mathcal{O}\left(\frac{1}{\beta}\left[n\log T+\min\left\{\sigma_{\max}n\log T,\;\sqrt{d_{\mathrm{tot}}}\right\}\right]\right).\qed</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
