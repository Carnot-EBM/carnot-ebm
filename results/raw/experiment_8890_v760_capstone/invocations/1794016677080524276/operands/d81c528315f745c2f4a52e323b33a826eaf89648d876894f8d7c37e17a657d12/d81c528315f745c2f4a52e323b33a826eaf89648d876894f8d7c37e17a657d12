<p id="A3.p24.3" class="ltx_p"><span id="A3.p24.3.1" class="ltx_text">Recalling
<math id="A3.p24.m7" class="ltx_Math" alttext="\Phi_{t+1}=\Gamma_{u}(F_{t+1})+\sum_{\tau\in m_{t+1}}a_{\tau,t}\Gamma_{u}(H_{\tau,t+1})," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Φ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><mrow><msub><mi mathvariant="normal">Γ</mi><mi>u</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">+</mo><mrow><msub><mo>∑</mo><mrow><mi>τ</mi><mo>∈</mo><msub><mi>m</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msub><mrow><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Γ</mi><mi>u</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mrow><mi>τ</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Phi_{t+1}=\Gamma_{u}(F_{t+1})+\sum_{\tau\in m_{t+1}}a_{\tau,t}\Gamma_{u}(H_{\tau,t+1}),</annotation></semantics></math>
