<tbody id="A1.Ex69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex69.m1" class="ltx_Math" alttext="\displaystyle\sum_{h\in\mathcal{H}_{t}}F_{t}^{h}=\sum_{h\in\mathcal{H}}F_{t}^{h}-\sum_{h\in D_{t}}F_{t}^{h}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub></mrow></munder></mstyle><msubsup><mi>F</mi><mi>t</mi><mi>h</mi></msubsup></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></munder></mstyle><msubsup><mi>F</mi><mi>t</mi><mi>h</mi></msubsup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi>D</mi><mi>t</mi></msub></mrow></munder></mstyle><msubsup><mi>F</mi><mi>t</mi><mi>h</mi></msubsup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{h\in\mathcal{H}_{t}}F_{t}^{h}=\sum_{h\in\mathcal{H}}F_{t}^{h}-\sum_{h\in D_{t}}F_{t}^{h},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.p18.7" class="ltx_p"><span id="A1.SS3.p18.7.1" class="ltx_text">and for each <math id="A1.SS3.p18.m8" class="ltx_Math" alttext="\tau\in m_{t}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><msub><mi>m</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\tau\in m_{t}</annotation></semantics></math>,</span></p>
<table id="A1.EGx47" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex70.m1" class="ltx_Math" alttext="\displaystyle\sum_{h\in\mathcal{H}_{t}}w_{\tau}^{h}=\sum_{h\in\mathcal{H}_{{t-1}}}w_{\tau}^{h}-\sum_{h\in D_{t}}w_{\tau}^{h}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub></mrow></munder></mstyle><msubsup><mi>w</mi><mi>τ</mi><mi>h</mi></msubsup></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></munder></mstyle><msubsup><mi>w</mi><mi>τ</mi><mi>h</mi></msubsup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi>D</mi><mi>t</mi></msub></mrow></munder></mstyle><msubsup><mi>w</mi><mi>τ</mi><mi>h</mi></msubsup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{h\in\mathcal{H}_{t}}w_{\tau}^{h}=\sum_{h\in\mathcal{H}_{{t-1}}}w_{\tau}^{h}-\sum_{h\in D_{t}}w_{\tau}^{h},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.p18.8" class="ltx_p"><span id="A1.SS3.p18.8.1" class="ltx_text">so plugging these back in above we have</span></p>
<table id="A1.EGx48" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex71.m1" class="ltx_Math" alttext="\displaystyle M_{{t+1}}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle M_{{t+1}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex71.m2" class="ltx_Math" alttext="\displaystyle=\sum_{h\in\mathcal{H}_{t}}F_{t}^{h}+\sum_{\tau\in m_{t}}a_{\tau,{t-1}}\sum_{h\in\mathcal{H}_{t}}w_{\tau}^{h}+\sum_{\tau\in\mathcal{F}_{t}}\sum_{h\in\mathcal{H}_{t}}\eta_{h}w_{\tau}^{h}r_{\tau}^{h}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub></mrow></munder></mstyle><msubsup><mi>F</mi><mi>t</mi><mi>h</mi></msubsup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><msub><mi>m</mi><mi>t</mi></msub></mrow></munder></mstyle><mrow><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub></mrow></munder></mstyle><msubsup><mi>w</mi><mi>τ</mi><mi>h</mi></msubsup></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>t</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub></mrow></munder></mstyle><mrow><msub><mi>η</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>w</mi><mi>τ</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>τ</mi><mi>h</mi></msubsup></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{h\in\mathcal{H}_{t}}F_{t}^{h}+\sum_{\tau\in m_{t}}a_{\tau,{t-1}}\sum_{h\in\mathcal{H}_{t}}w_{\tau}^{h}+\sum_{\tau\in\mathcal{F}_{t}}\sum_{h\in\mathcal{H}_{t}}\eta_{h}w_{\tau}^{h}r_{\tau}^{h}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex72.m1" class="ltx_Math" alttext="\displaystyle=M_{t}-\sum_{h\in D_{t}}\left[F_{t}^{h}+\sum_{\tau\in m_{t}}a_{\tau,{t-1}}w_{\tau}^{h}\right]+\sum_{\tau\in\mathcal{F}_{t}}\sum_{h\in\mathcal{H}_{t}}\eta_{h}w_{\tau}^{h}r_{\tau}^{h}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>M</mi><mi>t</mi></msub><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi>D</mi><mi>t</mi></msub></mrow></munder></mstyle><mrow><mo>[</mo><mrow><msubsup><mi>F</mi><mi>t</mi><mi>h</mi></msubsup><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><msub><mi>m</mi><mi>t</mi></msub></mrow></munder></mstyle><mrow><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>w</mi><mi>τ</mi><mi>h</mi></msubsup></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>t</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub></mrow></munder></mstyle><mrow><msub><mi>η</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>w</mi><mi>τ</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>τ</mi><mi>h</mi></msubsup></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=M_{t}-\sum_{h\in D_{t}}\left[F_{t}^{h}+\sum_{\tau\in m_{t}}a_{\tau,{t-1}}w_{\tau}^{h}\right]+\sum_{\tau\in\mathcal{F}_{t}}\sum_{h\in\mathcal{H}_{t}}\eta_{h}w_{\tau}^{h}r_{\tau}^{h}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.p18.9" class="ltx_p"><span id="A1.SS3.p18.9.1" class="ltx_text">To bound the last term, we want to leverage the fact that</span></p>
<table id="A1.EGx49" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex73.m1" class="ltx_Math" alttext="\displaystyle\sum_{h\in\mathcal{H}_{\tau}}\eta_{h}w_{\tau}^{h}r_{\tau}^{h}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>τ</mi></msub></mrow></munder></mstyle><mrow><msub><mi>η</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>w</mi><mi>τ</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>τ</mi><mi>h</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{h\in\mathcal{H}_{\tau}}\eta_{h}w_{\tau}^{h}r_{\tau}^{h}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex73.m2" class="ltx_Math" alttext="\displaystyle=\left(\sum_{k\in\mathcal{H}}\eta_{k}w_{\tau}^{k}\right)\sum_{h\in\mathcal{H}_{\tau}}q_{\tau}^{h}r_{\tau}^{h}=0." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></munder></mstyle><mrow><msub><mi>η</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>w</mi><mi>τ</mi><mi>k</mi></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>τ</mi></msub></mrow></munder></mstyle><mrow><msubsup><mi>q</mi><mi>τ</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>τ</mi><mi>h</mi></msubsup></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\sum_{k\in\mathcal{H}}\eta_{k}w_{\tau}^{k}\right)\sum_{h\in\mathcal{H}_{\tau}}q_{\tau}^{h}r_{\tau}^{h}=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.p18.10" class="ltx_p"><span id="A1.SS3.p18.10.1" class="ltx_text">so observing that <math id="A1.SS3.p18.m9" class="ltx_Math" alttext="D_{s}=\mathcal{H}_{s-1}\setminus\mathcal{H}_{s}" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>s</mi></msub><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>s</mi></msub></mrow></mrow><annotation encoding="application/x-tex">D_{s}=\mathcal{H}_{s-1}\setminus\mathcal{H}_{s}</annotation></semantics></math>,
we have that <math id="A1.SS3.p18.m10" class="ltx_Math" alttext="\mathcal{H}_{\tau}\setminus\mathcal{H}_{t}=\bigcup_{s=\tau+1}^{t}D_{s}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>τ</mi></msub><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>⋃</mo><mrow><mi>s</mi><mo>=</mo><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></msubsup><msub><mi>D</mi><mi>s</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}_{\tau}\setminus\mathcal{H}_{t}=\bigcup_{s=\tau+1}^{t}D_{s}</annotation></semantics></math>, where the union is disjoint. We have</span></p>
<table id="A1.EGx50" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex74.m1" class="ltx_Math" alttext="\displaystyle\sum_{\tau\in\mathcal{F}_{t}}\sum_{h\in\mathcal{H}_{t}}\eta_{h}w_{\tau}^{h}r_{\tau}^{h}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>t</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub></mrow></munder></mstyle><mrow><msub><mi>η</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>w</mi><mi>τ</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>τ</mi><mi>h</mi></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{\tau\in\mathcal{F}_{t}}\sum_{h\in\mathcal{H}_{t}}\eta_{h}w_{\tau}^{h}r_{\tau}^{h}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex74.m2" class="ltx_Math" alttext="\displaystyle=\sum_{\tau\in\mathcal{F}_{t}}\Biggl[\;\underbrace{\sum_{h\in\mathcal{H}_{\tau}}\eta_{h}w_{\tau}^{h}r_{\tau}^{h}}_{=0}-\sum_{h\in\mathcal{H}_{\tau}\setminus\mathcal{H}_{t}}\eta_{h}w_{\tau}^{h}r_{\tau}^{h}\Biggr]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>t</mi></msub></mrow></munder></mstyle><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mrow><munder><munder accentunder="true"><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>τ</mi></msub></mrow></munder></mstyle><mrow><msub><mi>η</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>w</mi><mi>τ</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>τ</mi><mi>h</mi></msubsup></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mphantom></mphantom><mo>=</mo><mn>0</mn></mrow></munder><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>τ</mi></msub><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msub></mrow></mrow></munder></mstyle><mrow><msub><mi>η</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>w</mi><mi>τ</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>τ</mi><mi>h</mi></msubsup></mrow></mrow></mrow><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{\tau\in\mathcal{F}_{t}}\Biggl[\;\underbrace{\sum_{h\in\mathcal{H}_{\tau}}\eta_{h}w_{\tau}^{h}r_{\tau}^{h}}_{=0}-\sum_{h\in\mathcal{H}_{\tau}\setminus\mathcal{H}_{t}}\eta_{h}w_{\tau}^{h}r_{\tau}^{h}\Biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex75"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex75.m1" class="ltx_math_unparsed" alttext="\displaystyle=-\sum_{\tau\in\mathcal{F}_{t}}\sum_{s=\tau+1}^{t}\sum_{h\in D_{s}}\eta_{h}w_{\tau}^{h}r_{\tau}^{h}," display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>τ</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>t</mi></msub></mrow></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>s</mi><mo>=</mo><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>h</mi><mo>∈</mo><msub><mi>D</mi><mi>s</mi></msub></mrow></msub><mi>η</mi><msub><mrow></mrow><mi>h</mi></msub><mi>w</mi><msub><mrow></mrow><mi>τ</mi></msub><msup><mrow></mrow><mi>h</mi></msup><mi>r</mi><msub><mrow></mrow><mi>τ</mi></msub><msup><mrow></mrow><mi>h</mi></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=-\sum_{\tau\in\mathcal{F}_{t}}\sum_{s=\tau+1}^{t}\sum_{h\in D_{s}}\eta_{h}w_{\tau}^{h}r_{\tau}^{h},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.p18.11" class="ltx_p"><span id="A1.SS3.p18.11.1" class="ltx_text">so summing over <math id="A1.SS3.p18.m11" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, we have</span></p>
<table id="A1.EGx51" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex76.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{T}\left(M_{t+1}-M_{t}\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mo>(</mo><mrow><msub><mi>M</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>M</mi><mi>t</mi></msub></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{T}\left(M_{t+1}-M_{t}\right)</annotation></semantics></math></td>
