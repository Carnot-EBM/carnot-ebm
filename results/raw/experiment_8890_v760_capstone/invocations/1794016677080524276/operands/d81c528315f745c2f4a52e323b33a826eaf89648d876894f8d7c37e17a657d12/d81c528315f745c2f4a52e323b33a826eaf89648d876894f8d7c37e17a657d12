<tbody id="A3.Ex156"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex156.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{T}\log\left(1+\frac{\beta}{a_{t,t+d_{t}}}\lVert g_{t}\rVert_{(\nabla^{2}\overline{H}_{t})^{-1}}^{2}\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>β</mi><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo fence="true" rspace="0em">∥</mo><msub><mi>g</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mo rspace="0.167em">∇</mo><mn>2</mn></msup><msub><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{T}\log\left(1+\frac{\beta}{a_{t,t+d_{t}}}\lVert g_{t}\rVert_{(\nabla^{2}\overline{H}_{t})^{-1}}^{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex157"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex157.m1" class="ltx_Math" alttext="\displaystyle\qquad\leq\log\frac{\det\left(\eta_{T}I+\beta\sum_{t=1}^{T}g_{t}g_{t}^{\top}\right)}{\det(\eta_{0}I)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="2.278em">≤</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mo rspace="0em">det</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><msub><mi>g</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>g</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mrow><mo rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>η</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\leq\log\frac{\det\left(\eta_{T}I+\beta\sum_{t=1}^{T}g_{t}g_{t}^{\top}\right)}{\det(\eta_{0}I)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E49.m1" class="ltx_Math" alttext="\displaystyle\qquad\quad+\sigma_{\tau}\log\frac{\det\left(\eta_{\tau}I+\beta\sum_{t=1}^{\tau}g_{t}g_{t}^{\top}\right)}{\det(\eta_{0}I)}+2\beta G^{2}\sum_{t=\tau+1}^{T}\frac{|m_{t}|}{\eta_{t}}\;." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><msub><mi>σ</mi><mi>τ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mo rspace="0em">det</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>η</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>τ</mi></msubsup><mrow><msub><mi>g</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>g</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mrow><mo rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>η</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>T</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">|</mo></mrow><msub><mi>η</mi><mi>t</mi></msub></mfrac></mstyle></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\quad+\sigma_{\tau}\log\frac{\det\left(\eta_{\tau}I+\beta\sum_{t=1}^{\tau}g_{t}g_{t}^{\top}\right)}{\det(\eta_{0}I)}+2\beta G^{2}\sum_{t=\tau+1}^{T}\frac{|m_{t}|}{\eta_{t}}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(49)</span></td></tr></tbody>
