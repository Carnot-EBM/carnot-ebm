<p id="A1.SS3.p19.2" class="ltx_p"><span id="A1.SS3.p19.2.1" class="ltx_text">so recalling <math id="A1.SS3.p19.m4" class="ltx_Math" alttext="M_{T+1}=\sum_{h\in\mathcal{H}}F_{T+1}^{h}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>h</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></msub><msubsup><mi>F</mi><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow><mi>h</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">M_{T+1}=\sum_{h\in\mathcal{H}}F_{T+1}^{h}</annotation></semantics></math> and <math id="A1.SS3.p19.m5" class="ltx_Math" alttext="M_{1}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mn>1</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">M_{1}=1</annotation></semantics></math>
