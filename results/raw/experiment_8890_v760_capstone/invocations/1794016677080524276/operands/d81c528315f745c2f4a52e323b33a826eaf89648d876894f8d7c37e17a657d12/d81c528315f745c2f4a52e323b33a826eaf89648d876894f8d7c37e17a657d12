            <span id="algorithm1.4.1.2" class="ltx_text"><span id="algorithm1.4.1.2.1" class="ltx_text ltx_font_bold">Input:</span> </span>prior <math id="algorithm1.m1" class="ltx_Math" alttext="\rho\in\Delta(\mathcal{H})" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>∈</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho\in\Delta(\mathcal{H})</annotation></semantics></math> with <math id="algorithm1.m2" class="ltx_Math" alttext="\min_{h}\rho^{h}&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>min</mi><mi>h</mi></msub><mo lspace="0.167em">⁡</mo><msup><mi>ρ</mi><mi>h</mi></msup></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\min_{h}\rho^{h}&gt;0</annotation></semantics></math>, meta-learning rates <math id="algorithm1.m3" class="ltx_Math" alttext="0&lt;\eta_{h}\leq 1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><msub><mi>η</mi><mi>h</mi></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0&lt;\eta_{h}\leq 1</annotation></semantics></math> for each <math id="algorithm1.m4" class="ltx_Math" alttext="h\in\mathcal{H}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow><annotation encoding="application/x-tex">h\in\mathcal{H}</annotation></semantics></math>
</div>
<div id="algorithm1.4.2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;">2</span></span>
            <span id="algorithm1.4.2.2" class="ltx_text"><span id="algorithm1.4.2.2.1" class="ltx_text ltx_font_bold">Initialization:</span> </span><math id="algorithm1.m5" class="ltx_Math" alttext="F_{1}=\rho" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><mn>1</mn></msub><mo>=</mo><mi>ρ</mi></mrow><annotation encoding="application/x-tex">F_{1}=\rho</annotation></semantics></math>, <math id="algorithm1.m6" class="ltx_Math" alttext="S_{1}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mn>1</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">S_{1}=1</annotation></semantics></math>, <math id="algorithm1.m7" class="ltx_Math" alttext="\mathcal{H}_{0}=\mathcal{H}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mn>0</mn></msub><mo>=</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow><annotation encoding="application/x-tex">\mathcal{H}_{0}=\mathcal{H}</annotation></semantics></math>
</div>
<div id="algorithm1.4.3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.3.1" class="ltx_text ltx_font_bold" style="font-size:70%;">3</span></span>
            <span id="algorithm1.4.3.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm1.4.3.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m8" class="ltx_Math" alttext="t=1,\ldots,T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=1,\ldots,T</annotation></semantics></math></em> <span id="algorithm1.4.3.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.4" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
