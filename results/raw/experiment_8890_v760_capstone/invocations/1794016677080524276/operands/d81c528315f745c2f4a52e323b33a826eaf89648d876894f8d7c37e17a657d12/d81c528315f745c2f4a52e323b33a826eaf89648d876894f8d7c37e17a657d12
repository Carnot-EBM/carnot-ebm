<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E31.m1" class="ltx_Math" alttext="\displaystyle n\log\left(\frac{\eta_{t}}{\eta_{0}}+\frac{\beta G^{2}t}{n\eta_{0}}\right)\leq n\log\left(1+t+\frac{\beta GDt}{n}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>η</mi><mi>t</mi></msub><msub><mi>η</mi><mn>0</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mn>0</mn></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mi>n</mi></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle n\log\left(\frac{\eta_{t}}{\eta_{0}}+\frac{\beta G^{2}t}{n\eta_{0}}\right)\leq n\log\left(1+t+\frac{\beta GDt}{n}\right).</annotation></semantics></math></td>
