<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex85.m1" class="ltx_Math" alttext="\sum_{t=1}^{T}\chi_{t}(z_{t}^{h})^{2}\leq(T+2d_{\mathrm{tot}})\max_{t\in[T]}(z_{t}^{h})^{2}\leq G^{2}D^{2}(T+2d_{\mathrm{tot}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><msub><mi>χ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>z</mi><mi>t</mi><mi>h</mi></msubsup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>tot</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><munder><mi>max</mi><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>z</mi><mi>t</mi><mi>h</mi></msubsup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>tot</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{t=1}^{T}\chi_{t}(z_{t}^{h})^{2}\leq(T+2d_{\mathrm{tot}})\max_{t\in[T]}(z_{t}^{h})^{2}\leq G^{2}D^{2}(T+2d_{\mathrm{tot}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS0.SSS0.Px1.p2" class="ltx_para">
<p id="A2.SS0.SSS0.Px1.p2.1" class="ltx_p">For the base term, applying the Delayed OGD guarantee (see, e.g., <cite class="ltx_cite ltx_citemacro_citep"><a href="#bib.bib13" title="" class="ltx_ref">Quanrud and Khashabi, 2015</a>, Theorem 2.1</cite>) to the linear
losses <math id="A2.SS0.SSS0.Px1.p2.m1" class="ltx_Math" alttext="x\mapsto\left\langle g_{t},x\right\rangle" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo stretchy="false">↦</mo><mrow><mo>⟨</mo><mrow><msub><mi>g</mi><mi>t</mi></msub><mo>,</mo><mi>x</mi></mrow><mo>⟩</mo></mrow></mrow><annotation encoding="application/x-tex">x\mapsto\left\langle g_{t},x\right\rangle</annotation></semantics></math> gives</p>
<table id="A2.EGx54" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E15.m1" class="ltx_Math" alttext="\displaystyle E_{T}^{h}=\sum_{t=1}^{T}\left\langle g_{t},x_{t}^{h}-u\right\rangle=\mathcal{O}\left(GD\sqrt{T+d_{\mathrm{tot}}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>E</mi><mi>T</mi><mi>h</mi></msubsup><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mo>⟨</mo><mrow><msub><mi>g</mi><mi>t</mi></msub><mo>,</mo><mrow><msubsup><mi>x</mi><mi>t</mi><mi>h</mi></msubsup><mo>−</mo><mi>u</mi></mrow></mrow><mo>⟩</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>T</mi><mo>+</mo><msub><mi>d</mi><mi>tot</mi></msub></mrow></msqrt></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle E_{T}^{h}=\sum_{t=1}^{T}\left\langle g_{t},x_{t}^{h}-u\right\rangle=\mathcal{O}\left(GD\sqrt{T+d_{\mathrm{tot}}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
<p id="A2.SS0.SSS0.Px1.p2.2" class="ltx_p">Combining <a href="#A2.E14" title="In General convex losses. ‣ Appendix B Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equations</span> <span class="ltx_text ltx_ref_tag">14</span></a>, <a href="#A2.E15" title="Equation 15 ‣ General convex losses. ‣ Appendix B Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a> and <a href="#A2.E13" title="Equation 13 ‣ General convex losses. ‣ Appendix B Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a> yields</p>
<table id="A2.EGx55" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E16.m1" class="ltx_Math" alttext="\displaystyle\operatorname{Reg}_{T}(u)=\mathcal{O}\left(GD\sqrt{(T+d_{\mathrm{tot}})H_{\rho}}+GD\sigma_{\max}^{+}H_{\rho}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>Reg</mi><mi>T</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>+</mo><msub><mi>d</mi><mi>tot</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>ρ</mi></msub></mrow></msqrt></mrow><mo>+</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>max</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>ρ</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{Reg}_{T}(u)=\mathcal{O}\left(GD\sqrt{(T+d_{\mathrm{tot}})H_{\rho}}+GD\sigma_{\max}^{+}H_{\rho}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
<p id="A2.SS0.SSS0.Px1.p2.3" class="ltx_p">Since <math id="A2.SS0.SSS0.Px1.p2.m2" class="ltx_Math" alttext="\sigma_{\max}^{+}=1+\sigma_{\max}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>σ</mi><mi>max</mi><mo>+</mo></msubsup><mo>=</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>σ</mi><mi>max</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\sigma_{\max}^{+}=1+\sigma_{\max}</annotation></semantics></math> and <math id="A2.SS0.SSS0.Px1.p2.m3" class="ltx_Math" alttext="H_{\rho}=\mathcal{O}(\log\log T)" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>ρ</mi></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H_{\rho}=\mathcal{O}(\log\log T)</annotation></semantics></math>, the additive
<math id="A2.SS0.SSS0.Px1.p2.m4" class="ltx_Math" alttext="GDH_{\rho}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>ρ</mi></msub></mrow><annotation encoding="application/x-tex">GDH_{\rho}</annotation></semantics></math> term can be absorbed into <math id="A2.SS0.SSS0.Px1.p2.m5" class="ltx_Math" alttext="GD\sqrt{(T+d_{\mathrm{tot}})H_{\rho}}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>+</mo><msub><mi>d</mi><mi>tot</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>ρ</mi></msub></mrow></msqrt></mrow><annotation encoding="application/x-tex">GD\sqrt{(T+d_{\mathrm{tot}})H_{\rho}}</annotation></semantics></math>.
Therefore,</p>
<table id="A2.EGx56" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E17.m1" class="ltx_Math" alttext="\displaystyle\operatorname{Reg}_{T}(u)=\mathcal{O}\left(GD\sqrt{(T+d_{\mathrm{tot}})\log\log T}+GD\sigma_{\max}\log\log T\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>Reg</mi><mi>T</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>+</mo><msub><mi>d</mi><mi>tot</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow></msqrt></mrow><mo>+</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>max</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{Reg}_{T}(u)=\mathcal{O}\left(GD\sqrt{(T+d_{\mathrm{tot}})\log\log T}+GD\sigma_{\max}\log\log T\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
<p id="A2.SS0.SSS0.Px1.p2.4" class="ltx_p">which proves <a href="#S4.E3" title="In Theorem 4.2. ‣ 4.2 Universal Regret Guarantee ‣ 4 Universal Regret with Delayed Feedback ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">3</span></a>.</p>
</div>
</section>
<section id="A2.SS0.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Strongly convex losses.</h4>

<div id="A2.SS0.SSS0.Px2.p1" class="ltx_para">
<p id="A2.SS0.SSS0.Px2.p1.1" class="ltx_p">First observe that we can always trivially bound <math id="A2.SS0.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\lambda\leq 2G/D" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mo>/</mo><mi>D</mi></mrow></mrow><annotation encoding="application/x-tex">\lambda\leq 2G/D</annotation></semantics></math>.
Indeed, choose any <math id="A2.SS0.SSS0.Px2.p1.m2" class="ltx_Math" alttext="x,y\in\mathcal{X}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x,y\in\mathcal{X}</annotation></semantics></math> with <math id="A2.SS0.SSS0.Px2.p1.m3" class="ltx_Math" alttext="\|x-y\|=r&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">‖</mo></mrow><mo>=</mo><mi>r</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\|x-y\|=r&gt;0</annotation></semantics></math>, then
we have from <a href="#Thmassumption1" title="Assumption 1 (Bounded domain and gradients). ‣ 2 Problem Setting ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumptions</span> <span class="ltx_text ltx_ref_tag">1</span></a> and <a href="#Thmassumption2" title="Assumption 2 (𝜆-strong convexity). ‣ 2 Problem Setting ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> that <math id="A2.SS0.SSS0.Px2.p1.m4" class="ltx_Math" alttext="\lambda r^{2}\leq\left\langle\nabla f_{t}(x)-\nabla f_{t}(y),x-y\right\rangle\leq 2Gr" display="inline" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mn>2</mn></msup></mrow><mo>≤</mo><mrow><mo>⟨</mo><mrow><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow></mrow><mo>⟩</mo></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><annotation encoding="application/x-tex">\lambda r^{2}\leq\left\langle\nabla f_{t}(x)-\nabla f_{t}(y),x-y\right\rangle\leq 2Gr</annotation></semantics></math>, and hence whenever <math id="A2.SS0.SSS0.Px2.p1.m5" class="ltx_Math" alttext="r&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">r&gt;0</annotation></semantics></math> we have <math id="A2.SS0.SSS0.Px2.p1.m6" class="ltx_Math" alttext="\lambda r\leq 2G" display="inline" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow></mrow><annotation encoding="application/x-tex">\lambda r\leq 2G</annotation></semantics></math>.
Taking the supremum over all distances in <math id="A2.SS0.SSS0.Px2.p1.m7" class="ltx_Math" alttext="\mathcal{X}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒳</mi><annotation encoding="application/x-tex">\mathcal{X}</annotation></semantics></math> we have <math id="A2.SS0.SSS0.Px2.p1.m8" class="ltx_Math" alttext="\lambda D=\lambda\sup_{x,y\in\mathcal{X}}\|x-y\|\leq 2G" display="inline" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo>=</mo><mrow><mi>λ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0em">sup</mo><mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow></msub><mrow><mo stretchy="false">‖</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow></mrow><annotation encoding="application/x-tex">\lambda D=\lambda\sup_{x,y\in\mathcal{X}}\|x-y\|\leq 2G</annotation></semantics></math>, and hence <math id="A2.SS0.SSS0.Px2.p1.m9" class="ltx_Math" alttext="\lambda\leq 2G/D" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mo>/</mo><mi>D</mi></mrow></mrow><annotation encoding="application/x-tex">\lambda\leq 2G/D</annotation></semantics></math>.</p>
</div>
<div id="A2.SS0.SSS0.Px2.p2" class="ltx_para">
<p id="A2.SS0.SSS0.Px2.p2.1" class="ltx_p">Next, suppose <math id="A2.SS0.SSS0.Px2.p2.m1" class="ltx_Math" alttext="\lambda&lt;(2G/D)2^{-J}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>&lt;</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mo>/</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mo>−</mo><mi>J</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\lambda&lt;(2G/D)2^{-J}</annotation></semantics></math>. Since
<math id="A2.SS0.SSS0.Px2.p2.m2" class="ltx_Math" alttext="J=\lceil\log_{2}T\rceil" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>=</mo><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo stretchy="false">⌉</mo></mrow></mrow><annotation encoding="application/x-tex">J=\lceil\log_{2}T\rceil</annotation></semantics></math>, we have
<math id="A2.SS0.SSS0.Px2.p2.m3" class="ltx_Math" alttext="\frac{G^{2}}{\lambda}&gt;\frac{GD}{2}2^{J}\geq\frac{GDT}{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><msup><mi>G</mi><mn>2</mn></msup><mi>λ</mi></mfrac><mo>&gt;</mo><mrow><mfrac><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mi>J</mi></msup></mrow><mo>≥</mo><mfrac><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mn>2</mn></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{G^{2}}{\lambda}&gt;\frac{GD}{2}2^{J}\geq\frac{GDT}{2},</annotation></semantics></math>
so in particular</p>
<table id="A2.Ex86" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex86.m1" class="ltx_Math" alttext="T\leq\frac{2G}{\lambda D}." display="block" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>≤</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T\leq\frac{2G}{\lambda D}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS0.SSS0.Px2.p2.2" class="ltx_p">Together with <math id="A2.SS0.SSS0.Px2.p2.m4" class="ltx_Math" alttext="T+d_{\mathrm{tot}}=\mathcal{O}(T^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>+</mo><msub><mi>d</mi><mi>tot</mi></msub></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T+d_{\mathrm{tot}}=\mathcal{O}(T^{2})</annotation></semantics></math> via <a href="#Thmlemma12" title="Lemma 12. ‣ Appendix D Supporting Lemmas ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">12</span></a>, the guarantee for the general convex case
<a href="#S4.E3" title="In Theorem 4.2. ‣ 4.2 Universal Regret Guarantee ‣ 4 Universal Regret with Delayed Feedback ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">3</span></a>
therefore yields</p>
<table id="A2.Ex87" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex87.m1" class="ltx_Math" alttext="\operatorname{Reg}_{T}(u)=\mathcal{O}\left(GD\sqrt{(T+d_{\mathrm{tot}})H_{\rho}}+GD\sigma_{\max}^{+}H_{\rho}\right)=\mathcal{O}\left(\frac{G^{2}}{\lambda}\sigma_{\max}^{+}H_{\rho}\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>Reg</mi><mi>T</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>+</mo><msub><mi>d</mi><mi>tot</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>ρ</mi></msub></mrow></msqrt></mrow><mo>+</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>max</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>ρ</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><msup><mi>G</mi><mn>2</mn></msup><mi>λ</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>max</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>ρ</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\operatorname{Reg}_{T}(u)=\mathcal{O}\left(GD\sqrt{(T+d_{\mathrm{tot}})H_{\rho}}+GD\sigma_{\max}^{+}H_{\rho}\right)=\mathcal{O}\left(\frac{G^{2}}{\lambda}\sigma_{\max}^{+}H_{\rho}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS0.SSS0.Px2.p2.3" class="ltx_p">where we have recalled from above that <math id="A2.SS0.SSS0.Px2.p2.m5" class="ltx_Math" alttext="D\leq 2G/\lambda" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mo>/</mo><mi>λ</mi></mrow></mrow><annotation encoding="application/x-tex">D\leq 2G/\lambda</annotation></semantics></math> and <math id="A2.SS0.SSS0.Px2.p2.m6" class="ltx_Math" alttext="H_{\rho}\geq 1" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>ρ</mi></msub><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">H_{\rho}\geq 1</annotation></semantics></math>.</p>
</div>
<div id="A2.SS0.SSS0.Px2.p3" class="ltx_para">
<p id="A2.SS0.SSS0.Px2.p3.1" class="ltx_p">Lastly, consider <math id="A2.SS0.SSS0.Px2.p3.m1" class="ltx_Math" alttext="(2G/D)2^{-J}\leq\lambda\leq(2G/D)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mo>/</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mo>−</mo><mi>J</mi></mrow></msup></mrow><mo>≤</mo><mi>λ</mi><mo>≤</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mo>/</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(2G/D)2^{-J}\leq\lambda\leq(2G/D)</annotation></semantics></math>. In this case, we have
by construction of <math id="A2.SS0.SSS0.Px2.p3.m2" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> that there exists a <math id="A2.SS0.SSS0.Px2.p3.m3" class="ltx_Math" alttext="\hat{\lambda}\in\Lambda" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">\hat{\lambda}\in\Lambda</annotation></semantics></math>
such that <math id="A2.SS0.SSS0.Px2.p3.m4" class="ltx_Math" alttext="\hat{\lambda}\leq\lambda\leq 2\hat{\lambda}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mo>≤</mo><mi>λ</mi><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>λ</mi><mo>^</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\hat{\lambda}\leq\lambda\leq 2\hat{\lambda}</annotation></semantics></math>,
so consider the Delayed FTRL <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib28" title="" class="ltx_ref">Qiu et al., 2025</a>]</cite> instance tuned to
<math id="A2.SS0.SSS0.Px2.p3.m5" class="ltx_Math" alttext="\widehat{\lambda}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>λ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{\lambda}</annotation></semantics></math>. Among the <math id="A2.SS0.SSS0.Px2.p3.m6" class="ltx_Math" alttext="J+1" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">J+1</annotation></semantics></math> base algorithms associated
with this instance, let <math id="A2.SS0.SSS0.Px2.p3.m7" class="ltx_Math" alttext="h\in\mathcal{H}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow><annotation encoding="application/x-tex">h\in\mathcal{H}</annotation></semantics></math> be the one selected by
<a href="#S3.Thmtheorem2" title="Corollary 3.2. ‣ Algorithm design. ‣ 3 Second-order Expert Aggregation with Delayed Feedback ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Corollary</span> <span class="ltx_text ltx_ref_tag">3.2</span></a>.
Recall <math id="A2.SS0.SSS0.Px2.p3.m8" class="ltx_Math" alttext="z_{t}^{h}\coloneq\left\langle g_{t},x_{t}-x_{t}^{h}\right\rangle" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>z</mi><mi>t</mi><mi>h</mi></msubsup><mo>≔</mo><mrow><mo>⟨</mo><mrow><msub><mi>g</mi><mi>t</mi></msub><mo>,</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><msubsup><mi>x</mi><mi>t</mi><mi>h</mi></msubsup></mrow></mrow><mo>⟩</mo></mrow></mrow><annotation encoding="application/x-tex">z_{t}^{h}\coloneq\left\langle g_{t},x_{t}-x_{t}^{h}\right\rangle</annotation></semantics></math> and define the strongly convex surrogate
<math id="A2.SS0.SSS0.Px2.p3.m9" class="ltx_Math" alttext="f_{t}^{\widehat{\lambda}}(x)\coloneq\left\langle g_{t},x\right\rangle+\frac{\widehat{\lambda}}{2}\|x-x_{t}\|_{2}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>f</mi><mi>t</mi><mover accent="true"><mi>λ</mi><mo>^</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><mrow><mo>⟨</mo><mrow><msub><mi>g</mi><mi>t</mi></msub><mo>,</mo><mi>x</mi></mrow><mo>⟩</mo></mrow><mo>+</mo><mrow><mfrac><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>x</mi><mo>−</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{t}^{\widehat{\lambda}}(x)\coloneq\left\langle g_{t},x\right\rangle+\frac{\widehat{\lambda}}{2}\|x-x_{t}\|_{2}^{2}.</annotation></semantics></math>
Since <math id="A2.SS0.SSS0.Px2.p3.m10" class="ltx_Math" alttext="\widehat{\lambda}\leq\lambda" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mo>≤</mo><mi>λ</mi></mrow><annotation encoding="application/x-tex">\widehat{\lambda}\leq\lambda</annotation></semantics></math>, <a href="#Thmassumption2" title="Assumption 2 (𝜆-strong convexity). ‣ 2 Problem Setting ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">2</span></a> implies</p>
<table id="A2.Ex88" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex88.m1" class="ltx_Math" alttext="f_{t}(x_{t})-f_{t}(u)\leq\left\langle g_{t},x_{t}-u\right\rangle-\frac{\widehat{\lambda}}{2}\|x_{t}-u\|_{2}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>f</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><mo>⟨</mo><mrow><msub><mi>g</mi><mi>t</mi></msub><mo>,</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><mi>u</mi></mrow></mrow><mo>⟩</mo></mrow><mo>−</mo><mrow><mfrac><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><mi>u</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{t}(x_{t})-f_{t}(u)\leq\left\langle g_{t},x_{t}-u\right\rangle-\frac{\widehat{\lambda}}{2}\|x_{t}-u\|_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS0.SSS0.Px2.p3.2" class="ltx_p">Moreover,</p>
<table id="A2.EGx57" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex89.m1" class="ltx_Math" alttext="\displaystyle\left\langle g_{t},x_{t}-u\right\rangle-\frac{\widehat{\lambda}}{2}\|x_{t}-u\|_{2}^{2}=z_{t}^{h}-\frac{\widehat{\lambda}}{2}\|x_{t}-x_{t}^{h}\|_{2}^{2}+f_{t}^{\widehat{\lambda}}(x_{t}^{h})-f_{t}^{\widehat{\lambda}}(u)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>⟨</mo><mrow><msub><mi>g</mi><mi>t</mi></msub><mo>,</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><mi>u</mi></mrow></mrow><mo>⟩</mo></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><mi>u</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>=</mo><mrow><mrow><mrow><msubsup><mi>z</mi><mi>t</mi><mi>h</mi></msubsup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><msubsup><mi>x</mi><mi>t</mi><mi>h</mi></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>+</mo><mrow><msubsup><mi>f</mi><mi>t</mi><mover accent="true"><mi>λ</mi><mo>^</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>t</mi><mi>h</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msubsup><mi>f</mi><mi>t</mi><mover accent="true"><mi>λ</mi><mo>^</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\langle g_{t},x_{t}-u\right\rangle-\frac{\widehat{\lambda}}{2}\|x_{t}-u\|_{2}^{2}=z_{t}^{h}-\frac{\widehat{\lambda}}{2}\|x_{t}-x_{t}^{h}\|_{2}^{2}+f_{t}^{\widehat{\lambda}}(x_{t}^{h})-f_{t}^{\widehat{\lambda}}(u).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS0.SSS0.Px2.p3.3" class="ltx_p">Summing over <math id="A2.SS0.SSS0.Px2.p3.m11" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> therefore gives</p>
<table id="A2.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E18.m1" class="ltx_Math" alttext="\operatorname{Reg}_{T}(u)\leq\underbrace{\sum_{t=1}^{T}\left(z_{t}^{h}-\frac{\widehat{\lambda}}{2}\|x_{t}-x_{t}^{h}\|_{2}^{2}\right)}_{\eqcolon M_{T}^{h}}+\underbrace{\sum_{t=1}^{T}\left(f_{t}^{\widehat{\lambda}}(x_{t}^{h})-f_{t}^{\widehat{\lambda}}(u)\right)}_{\eqcolon E_{T}^{h}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>Reg</mi><mi>T</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≤</mo><mrow><munder><munder accentunder="true"><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><mo>(</mo><mrow><msubsup><mi>z</mi><mi>t</mi><mi>h</mi></msubsup><mo>−</mo><mrow><mfrac><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><msubsup><mi>x</mi><mi>t</mi><mi>h</mi></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mphantom></mphantom><mo>≕</mo><msubsup><mi>M</mi><mi>T</mi><mi>h</mi></msubsup></mrow></munder><mo rspace="0.055em">+</mo><munder><munder accentunder="true"><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><mo>(</mo><mrow><mrow><msubsup><mi>f</mi><mi>t</mi><mover accent="true"><mi>λ</mi><mo>^</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>t</mi><mi>h</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>f</mi><mi>t</mi><mover accent="true"><mi>λ</mi><mo>^</mo></mover></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mphantom></mphantom><mo>≕</mo><msubsup><mi>E</mi><mi>T</mi><mi>h</mi></msubsup></mrow></munder></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{Reg}_{T}(u)\leq\underbrace{\sum_{t=1}^{T}\left(z_{t}^{h}-\frac{\widehat{\lambda}}{2}\|x_{t}-x_{t}^{h}\|_{2}^{2}\right)}_{\eqcolon M_{T}^{h}}+\underbrace{\sum_{t=1}^{T}\left(f_{t}^{\widehat{\lambda}}(x_{t}^{h})-f_{t}^{\widehat{\lambda}}(u)\right)}_{\eqcolon E_{T}^{h}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS0.SSS0.Px2.p4" class="ltx_para">
<p id="A2.SS0.SSS0.Px2.p4.1" class="ltx_p">Now by <a href="#S3.Thmtheorem2" title="Corollary 3.2. ‣ Algorithm design. ‣ 3 Second-order Expert Aggregation with Delayed Feedback ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Corollary</span> <span class="ltx_text ltx_ref_tag">3.2</span></a>, we have</p>
<table id="A2.EGx58" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
