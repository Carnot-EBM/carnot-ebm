<math id="algorithm2.m14" class="ltx_Math" alttext="F_{t+1}(x)=(C_{t}-a_{t,t})\left(H_{t}(x)+\frac{\eta_{t}-\eta_{t-1}}{2}\lVert x-x_{t}\rVert_{2}^{2}\right)+\sum_{\tau\in\mathcal{F}_{t}}a_{\tau,t}U_{\tau}(x)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>F</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><mi>t</mi></msub><mo>−</mo><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>H</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mfrac><mrow><msub><mi>η</mi><mi>t</mi></msub><mo>−</mo><msub><mi>η</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo fence="true" rspace="0em">∥</mo><mrow><mi>x</mi><mo>−</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow><mo rspace="0.055em">+</mo><mrow><msub><mo>∑</mo><mrow><mi>τ</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>t</mi></msub></mrow></msub><mrow><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>U</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F_{t+1}(x)=(C_{t}-a_{t,t})\left(H_{t}(x)+\frac{\eta_{t}-\eta_{t-1}}{2}\lVert x-x_{t}\rVert_{2}^{2}\right)+\sum_{\tau\in\mathcal{F}_{t}}a_{\tau,t}U_{\tau}(x).</anno