<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex22.m1" class="ltx_Math" alttext="\displaystyle S_{{t+1}}+\sum_{\tau\in m_{{t+1}}}a_{\tau,t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><msub><mi>m</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></munder></mstyle><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle S_{{t+1}}+\sum_{\tau\in m_{{t+1}}}a_{\tau,t}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex22.m2" class="ltx_Math" alttext="\displaystyle=C_{t}-a_{{t,t}}+\sum_{\tau\in\mathcal{F}_{t}}a_{{\tau,t}}+\sum_{\tau\in m_{{t+1}}}a_{\tau,t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>C</mi><mi>t</mi></msub><mo>−</mo><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>t</mi></msub></mrow></munder></mstyle><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><msub><mi>m</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></munder></mstyle><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=C_{t}-a_{{t,t}}+\sum_{\tau\in\mathcal{F}_{t}}a_{{\tau,t}}+\sum_{\tau\in m_{{t+1}}}a_{\tau,t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex23.m1" class="ltx_Math" alttext="\displaystyle=C_{t}-a_{{t,t}}+\sum_{\tau\in\mathcal{F}_{t}}a_{{\tau,t}}+\sum_{\tau\in m_{t}\cup\left\{t\right\}}a_{\tau,t}-\sum_{\tau\in\mathcal{F}_{t}}a_{{\tau,t}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><msub><mi>C</mi><mi>t</mi></msub><mo>−</mo><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>t</mi></msub></mrow></munder></mstyle><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><mrow><msub><mi>m</mi><mi>t</mi></msub><mo>∪</mo><mrow><mo>{</mo><mi>t</mi><mo>}</mo></mrow></mrow></mrow></munder></mstyle><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>t</mi></msub></mrow></munder></mstyle><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=C_{t}-a_{{t,t}}+\sum_{\tau\in\mathcal{F}_{t}}a_{{\tau,t}}+\sum_{\tau\in m_{t}\cup\left\{t\right\}}a_{\tau,t}-\sum_{\tau\in\mathcal{F}_{t}}a_{{\tau,t}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex24.m1" class="ltx_Math" alttext="\displaystyle=C_{t}+\sum_{\tau\in m_{t}}a_{\tau,t}=S_{t}+\sum_{\tau\in m_{t}}\left(a_{\tau,{t-1}}-a_{{\tau,t}}\right)+\sum_{\tau\in m_{t}}a_{{\tau,t}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>C</mi><mi>t</mi></msub><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><msub><mi>m</mi><mi>t</mi></msub></mrow></munder></mstyle><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow><mo>=</mo><mrow><msub><mi>S</mi><mi>t</mi></msub><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><msub><mi>m</mi><mi>t</mi></msub></mrow></munder></mstyle><mrow><mo>(</mo><mrow><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>−</mo><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><msub><mi>m</mi><mi>t</mi></msub></mrow></munder></mstyle><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=C_{t}+\sum_{\tau\in m_{t}}a_{\tau,t}=S_{t}+\sum_{\tau\in m_{t}}\left(a_{\tau,{t-1}}-a_{{\tau,t}}\right)+\sum_{\tau\in m_{t}}a_{{\tau,t}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex25.m1" class="ltx_Math" alttext="\displaystyle=S_{t}+\sum_{\tau\in m_{t}}a_{\tau,{t-1}}=1," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>S</mi><mi>t</mi></msub><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><msub><mi>m</mi><mi>t</mi></msub></mrow></munder></mstyle><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=S_{t}+\sum_{\tau\in m_{t}}a_{\tau,{t-1}}=1,</annotation></semantics></math></td>
