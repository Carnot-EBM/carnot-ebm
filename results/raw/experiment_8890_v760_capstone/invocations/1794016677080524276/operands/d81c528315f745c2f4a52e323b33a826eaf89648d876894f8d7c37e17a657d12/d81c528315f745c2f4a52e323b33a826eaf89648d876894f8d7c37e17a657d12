<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E60.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{T}a_{t,t+d_{t}}\log\left(1+\frac{\beta}{a_{t,t+d_{t}}}\lVert g_{t}\rVert_{(\nabla^{2}\overline{H}_{t})^{-1}}^{2}\right)\leq\log\frac{\det\left(\eta_{T}I+\beta\sum_{t=1}^{T}g_{t}g_{t}^{\top}\right)}{\det(\eta_{0}I)}\;." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>β</mi><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo fence="true" rspace="0em">∥</mo><msub><mi>g</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mo rspace="0.167em">∇</mo><mn>2</mn></msup><msub><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mo rspace="0em">det</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><msub><mi>g</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>g</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mrow><mo rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>η</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{T}a_{t,t+d_{t}}\log\left(1+\frac{\beta}{a_{t,t+d_{t}}}\lVert g_{t}\rVert_{(\nabla^{2}\overline{H}_{t})^{-1}}^{2}\right)\leq\log\frac{\det\left(\eta_{T}I+\beta\sum_{t=1}^{T}g_{t}g_{t}^{\top}\right)}{\det(\eta_{0}I)}\;.</annotation></semantics></math></td>
