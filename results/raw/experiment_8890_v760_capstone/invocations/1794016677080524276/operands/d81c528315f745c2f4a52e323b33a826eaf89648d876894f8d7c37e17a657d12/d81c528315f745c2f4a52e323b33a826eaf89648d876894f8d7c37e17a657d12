</table>
<p id="A3.p34.2" class="ltx_p"><span id="A3.p34.2.1" class="ltx_text">Applying <a href="#A3.E50" title="In Proof. ‣ Appendix C Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">50</span></a> with <math id="A3.p34.m3" class="ltx_Math" alttext="s=T" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>=</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">s=T</annotation></semantics></math> and <math id="A3.p34.m4" class="ltx_Math" alttext="s=\tau" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>=</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">s=\tau</annotation></semantics></math> to
