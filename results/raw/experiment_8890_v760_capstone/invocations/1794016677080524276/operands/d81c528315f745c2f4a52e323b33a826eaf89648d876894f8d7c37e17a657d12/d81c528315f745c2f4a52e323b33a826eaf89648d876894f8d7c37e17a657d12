<math id="algorithm2.m13" class="ltx_Math" alttext="U_{\tau}(x)=H_{\tau}(x)+\frac{1}{a_{\tau,t}}\langle g_{\tau},x\rangle+\frac{\beta}{2a_{\tau,t}}\langle g_{\tau},x-x_{\tau}\rangle^{2}+\frac{\eta_{t}-\eta_{\tau-1}}{2}\lVert x-x_{\tau}\rVert_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>U</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>H</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mi>t</mi></mrow></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>g</mi><mi>τ</mi></msub><mo>,</mo><mi>x</mi></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>+</mo><mrow><mfrac><mi>β</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>g</mi><mi>τ</mi></msub><mo>,</mo><mrow><mi>x</mi><mo>−</mo><msub><mi>x</mi><mi>τ</mi></msub></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mfrac><mrow><msub><mi>η</mi><mi>t</mi></msub><mo>−</mo><msub><mi>η</mi><mrow><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo fence="true" rspace="0em">∥</mo><mrow><mi>x</mi><mo>−</mo><msub><mi>x</mi><mi>τ</mi></msub></mrow><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">U_{\tau}(x)=H_{\tau}(x)+\frac{1}{a_{\tau,t}}\langle g_{\tau},x\rangle+\frac{\beta}{2a_{\tau,t}}\langle g_{\tau},x-x_{\tau}\rangle^{2}+\frac{\eta_{t}-\eta_{\tau-1}}{2}\lVert x-x_{\tau}\rVert_{2}^{2}</annotation></semantics></math>

