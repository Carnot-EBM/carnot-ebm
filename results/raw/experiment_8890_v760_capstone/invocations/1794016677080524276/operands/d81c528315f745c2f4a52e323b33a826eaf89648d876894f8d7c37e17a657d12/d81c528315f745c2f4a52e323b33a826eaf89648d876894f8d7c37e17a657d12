<div id="Thmlemma9" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma9.2" class="ltx_text ltx_font_bold">Lemma 9</span></span><span id="Thmlemma9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma9.p1" class="ltx_para">
<p id="Thmlemma9.p1.1" class="ltx_p"><span id="Thmlemma9.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="Thmlemma9.p1.m1" class="ltx_Math" alttext="\tau\in\left\{0,\ldots,T\right\}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo>{</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in\left\{0,\ldots,T\right\}</annotation></semantics></math>, it holds that</span></p>
<table id="A3.EGx81" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E51.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{\tau}a_{t,t+d_{t}}\log\left(1+\frac{\beta}{a_{t,t+d_{t}}}\|g_{t}\|^{2}_{(\nabla^{2}\overline{H}_{t})^{-1}}\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>τ</mi></munderover></mstyle><mrow><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>β</mi><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>d</mi><mi>t</mi></msub></mrow></mrow></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>g</mi><mi>t</mi></msub><mo stretchy="false">‖</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mo rspace="0.167em">∇</mo><mn>2</mn></msup><msub><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{\tau}a_{t,t+d_{t}}\log\left(1+\frac{\beta}{a_{t,t+d_{t}}}\|g_{t}\|^{2}_{(\nabla^{2}\overline{H}_{t})^{-1}}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E51.m2" class="ltx_Math" alttext="\displaystyle\leq\log\frac{\det\left(\eta_{\tau}I+\beta\sum_{t=1}^{\tau}g_{t}g_{t}^{\top}\right)}{\det(\eta_{0}I)}\;." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mo rspace="0em">det</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>η</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>τ</mi></msubsup><mrow><msub><mi>g</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>g</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mrow><mo rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>η</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\log\frac{\det\left(\eta_{\tau}I+\beta\sum_{t=1}^{\tau}g_{t}g_{t}^{\top}\right)}{\det(\eta_{0}I)}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(51)</span></td></tr></tbody>
</table>
