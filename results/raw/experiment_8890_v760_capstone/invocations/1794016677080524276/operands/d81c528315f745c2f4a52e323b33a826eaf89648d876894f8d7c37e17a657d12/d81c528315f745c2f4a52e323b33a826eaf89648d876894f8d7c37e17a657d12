</div>
<div id="A3.p5" class="ltx_para">
<p id="A3.p5.1" class="ltx_p"><span id="A3.p5.1.1" class="ltx_text">By <a href="#Thmlemma7" title="Lemma 7. ‣ Appendix C Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">7</span></a>, the second sum is at most <math id="A3.p5.m1" class="ltx_Math" alttext="(\eta_{T}D^{2})/2" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">(\eta_{T}D^{2})/2</annotation></semantics></math>.</span></p>
</div>
<div id="A3.p6" class="ltx_para">
<p id="A3.p6.1" class="ltx_p"><span id="A3.p6.1.1" class="ltx_text">Moreover, by <a href="#Thmlemma6" title="Lemma 6. ‣ Appendix C Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">6</span></a>,</span></p>
<table id="A3.E29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E29.m1" class="ltx_Math" alttext="a_{t}\overline{H}_{t}(x_{t})+\ell_{t}(x_{t})-\min_{x\in\mathcal{X}}\left\{a_{t}\overline{H}_{t}(x)+\ell_{t}(x)\right\}\leq\frac{1}{2\beta}\log\left(1+\frac{\beta}{a_{t}}\lVert g_{t}\rVert_{(\nabla^{2}\overline{H}_{t})^{-1}}^{2}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><msub><mi>a</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><munder><mi>min</mi><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow></munder><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><msub><mi>a</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mfrac><mi>β</mi><msub><mi>a</mi><mi>t</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo fence="true" rspace="0em">∥</mo><msub><mi>g</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mo rspace="0.167em">∇</mo><mn>2</mn></msup><msub><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">a_{t}\overline{H}_{t}(x_{t})+\ell_{t}(x_{t})-\min_{x\in\mathcal{X}}\left\{a_{t}\overline{H}_{t}(x)+\ell_{t}(x)\right\}\leq\frac{1}{2\beta}\log\left(1+\frac{\beta}{a_{t}}\lVert g_{t}\rVert_{(\nabla^{2}\overline{H}_{t})^{-1}}^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
<p id="A3.p6.2" class="ltx_p"><span id="A3.p6.2.1" class="ltx_text">Consequently,</span></p>
<table id="A3.EGx63" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E30.m1" class="ltx_Math" alttext="\displaystyle\operatorname{Reg}_{T}(u)\leq\frac{\eta_{T}D^{2}}{2}+\frac{1}{2\beta}\sum_{t=1}^{T}\log\left(1+\frac{\beta}{a_{t}}\lVert g_{t}\rVert_{(\nabla^{2}\overline{H}_{t})^{-1}}^{2}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>Reg</mi><mi>T</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>β</mi><msub><mi>a</mi><mi>t</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo fence="true" rspace="0em">∥</mo><msub><mi>g</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mo rspace="0.167em">∇</mo><mn>2</mn></msup><msub><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{Reg}_{T}(u)\leq\frac{\eta_{T}D^{2}}{2}+\frac{1}{2\beta}\sum_{t=1}^{T}\log\left(1+\frac{\beta}{a_{t}}\lVert g_{t}\rVert_{(\nabla^{2}\overline{H}_{t})^{-1}}^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(30)</span></td></tr></tbody>
</table>
<p id="A3.p6.3" class="ltx_p"><span id="A3.p6.3.1" class="ltx_text">The stated result then follows by applying
<a href="#Thmlemma8" title="Lemma 8. ‣ Appendix C Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">8</span></a> for any
<math id="A3.p6.m1" class="ltx_Math" alttext="\tau\in\{0,\ldots,T\}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in\{0,\ldots,T\}</annotation></semantics></math>, which gives</span></p>
<table id="A3.EGx64" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex122"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex122.m1" class="ltx_Math" alttext="\displaystyle\operatorname{Reg}_{T}(u)\leq\frac{\eta_{T}D^{2}}{2}+\frac{n}{2\beta}\log\left(\frac{\eta_{T}}{\eta_{0}}+\frac{\beta G^{2}T}{n\eta_{0}}\right)+\frac{\sigma_{\tau}n}{2\beta}\log\left(\frac{\eta_{\tau}}{\eta_{0}}+\frac{\beta G^{2}\tau}{n\eta_{0}}\right)+G^{2}\sum_{t=\tau+1}^{T}\frac{|m_{t}|}{\eta_{t}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>Reg</mi><mi>T</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>η</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>n</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>η</mi><mi>T</mi></msub><msub><mi>η</mi><mn>0</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mn>0</mn></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>σ</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>η</mi><mi>τ</mi></msub><msub><mi>η</mi><mn>0</mn></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mn>0</mn></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>G</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>T</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><msub><mi>m</mi><mi>t</mi></msub><mo stretchy="false">|</mo></mrow><msub><mi>η</mi><mi>t</mi></msub></mfrac></mstyle></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{Reg}_{T}(u)\leq\frac{\eta_{T}D^{2}}{2}+\frac{n}{2\beta}\log\left(\frac{\eta_{T}}{\eta_{0}}+\frac{\beta G^{2}T}{n\eta_{0}}\right)+\frac{\sigma_{\tau}n}{2\beta}\log\left(\frac{\eta_{\tau}}{\eta_{0}}+\frac{\beta G^{2}\tau}{n\eta_{0}}\right)+G^{2}\sum_{t=\tau+1}^{T}\frac{|m_{t}|}{\eta_{t}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p6.4" class="ltx_p"><span id="A3.p6.4.1" class="ltx_text">which is exactly <a href="#A3.E26" title="In Theorem C.1. ‣ Appendix C Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">26</span></a>.
∎</span></p>
</div>
</div>
<div id="A3.p7" class="ltx_para">
<p id="A3.p7.1" class="ltx_p">The following theorem chooses the learning-rate sequence adaptively to balance the two delay-dependent terms in <a href="#A3.Thmtheorem1" title="Theorem C.1. ‣ Appendix C Omitted Details from Section ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">C.1</span></a>.
See <a href="#S4.Thmtheorem1" title="Theorem 4.1. ‣ 4.1 Improved Regret Bound for Exp-concave Losses ‣ 4 Universal Regret with Delayed Feedback ‣ Universal Online Convex Optimization With Delayed Feedback" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a></p>
</div>
<div id="A3.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.p8" class="ltx_para">
<p id="A3.p8.1" class="ltx_p"><span id="A3.p8.1.1" class="ltx_text">The sequence <math id="A3.p8.m1" class="ltx_Math" alttext="(\eta_{t})_{t=0}^{T}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>η</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mi>T</mi></msubsup><annotation encoding="application/x-tex">(\eta_{t})_{t=0}^{T}</annotation></semantics></math> is non-decreasing since
<math id="A3.p8.m2" class="ltx_Math" alttext="\sigma_{t}=\max_{s\leq t}\left|m_{s}\right|" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>t</mi></msub><mo>=</mo><mrow><msub><mi>max</mi><mrow><mi>s</mi><mo>≤</mo><mi>t</mi></mrow></msub><mo>⁡</mo><mrow><mo>|</mo><msub><mi>m</mi><mi>s</mi></msub><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma_{t}=\max_{s\leq t}\left|m_{s}\right|</annotation></semantics></math> and <math id="A3.p8.m3" class="ltx_Math" alttext="\sum_{s\leq t}\left|m_{s}\right|" display="inline" intent=":literal"><semantics><mrow><msub><mo>∑</mo><mrow><mi>s</mi><mo>≤</mo><mi>t</mi></mrow></msub><mrow><mo lspace="0em">|</mo><msub><mi>m</mi><mi>s</mi></msub><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\sum_{s\leq t}\left|m_{s}\right|</annotation></semantics></math> define
non-decreasing sequences, and the point-wise minimum of
two non-decreasing sequences is also non-decreasing. Moreover, since <math id="A3.p8.m4" class="ltx_Math" alttext="\left|m_{s}\right|\leq s-1" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><msub><mi>m</mi><mi>s</mi></msub><mo>|</mo></mrow><mo>≤</mo><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\left|m_{s}\right|\leq s-1</annotation></semantics></math>,
we have <math id="A3.p8.m5" class="ltx_Math" alttext="\sum_{s=1}^{t}|m_{s}|\leq\sum_{s=1}^{t}(s-1)=t(t-1)/2" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></msubsup><mrow><mo lspace="0em" stretchy="false">|</mo><msub><mi>m</mi><mi>s</mi></msub><mo stretchy="false">|</mo></mrow></mrow><mo rspace="0.111em">≤</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></msubsup><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">\sum_{s=1}^{t}|m_{s}|\leq\sum_{s=1}^{t}(s-1)=t(t-1)/2</annotation></semantics></math>, so the definition of <math id="A3.p8.m6" class="ltx_Math" alttext="\eta_{t}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\eta_{t}</annotation></semantics></math> implies
<math id="A3.p8.m7" class="ltx_Math" alttext="\eta_{t}\leq\eta_{0}+Gt/D" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>t</mi></msub><mo>≤</mo><mrow><msub><mi>η</mi><mn>0</mn></msub><mo>+</mo><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>/</mo><mi>D</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta_{t}\leq\eta_{0}+Gt/D</annotation></semantics></math>. Hence, using <math id="A3.p8.m8" class="ltx_Math" alttext="\eta_{0}=G/D" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mn>0</mn></msub><mo>=</mo><mrow><mi>G</mi><mo>/</mo><mi>D</mi></mrow></mrow><annotation encoding="application/x-tex">\eta_{0}=G/D</annotation></semantics></math>,</span></p>
