</table>
<p id="A1.SS3.p2.2" class="ltx_p"><span id="A1.SS3.p2.2.1" class="ltx_text">so <math id="A1.SS3.p2.m7" class="ltx_Math" alttext="S_{t}+\sum_{\tau\in m_{t}}a_{\tau,{t-1}}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>S</mi><mi>t</mi></msub><mo rspace="0.055em">+</mo><mrow><msub><mo>∑</mo><mrow><mi>τ</mi><mo>∈</mo><msub><mi>m</mi><mi>t</mi></msub></mrow></msub><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">S_{t}+\sum_{\tau\in m_{t}}a_{\tau,{t-1}}=1</annotation></semantics></math> holds for all <math id="A1.SS3.p2.m8" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> by induction.
Moreover, plugging this condition into the definition of <math id="A1.SS3.p2.m9" class="ltx_Math" alttext="C_{t}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>t</mi></msub><annotation encoding="application/x-tex">C_{t}</annotation></semantics></math> we have</span></p>
<table id="A1.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex26.m1" class="ltx_Math" alttext="\displaystyle C_{t}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\displaystyle C_{t}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex26.m2" class="ltx_Math" alttext="\displaystyle=S_{t}+\sum_{\tau\in m_{t}}\delta_{{\tau,t}}=S_{t}+\sum_{\tau\in m_{t}}\left(a_{\tau,{t-1}}-a_{\tau,t}\right)=1-\sum_{\tau\in m_{t}}a_{{\tau,t}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>S</mi><mi>t</mi></msub><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><msub><mi>m</mi><mi>t</mi></msub></mrow></munder></mstyle><msub><mi>δ</mi><mrow><mi>τ</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow><mo>=</mo><mrow><msub><mi>S</mi><mi>t</mi></msub><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><msub><mi>m</mi><mi>t</mi></msub></mrow></munder></mstyle><mrow><mo>(</mo><mrow><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>−</mo><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><msub><mi>m</mi><mi>t</mi></msub></mrow></munder></mstyle><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=S_{t}+\sum_{\tau\in m_{t}}\delta_{{\tau,t}}=S_{t}+\sum_{\tau\in m_{t}}\left(a_{\tau,{t-1}}-a_{\tau,t}\right)=1-\sum_{\tau\in m_{t}}a_{{\tau,t}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex27.m1" class="ltx_Math" alttext="\displaystyle\geq 1-\left|m_{t}\right|a_{{t,t}}=1-\frac{\left|m_{t}\right|}{1+\left|m_{t}\right|}=\frac{1}{1+\left|m_{t}\right|}=a_{{t,t}}&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mo>|</mo><msub><mi>m</mi><mi>t</mi></msub><mo>|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mo>|</mo><msub><mi>m</mi><mi>t</mi></msub><mo>|</mo></mrow><mrow><mn>1</mn><mo>+</mo><mrow><mo>|</mo><msub><mi>m</mi><mi>t</mi></msub><mo>|</mo></mrow></mrow></mfrac></mstyle></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mrow><mo>|</mo><msub><mi>m</mi><mi>t</mi></msub><mo>|</mo></mrow></mrow></mfrac></mstyle><mo>=</mo><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq 1-\left|m_{t}\right|a_{{t,t}}=1-\frac{\left|m_{t}\right|}{1+\left|m_{t}\right|}=\frac{1}{1+\left|m_{t}\right|}=a_{{t,t}}&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.p2.3" class="ltx_p"><span id="A1.SS3.p2.3.1" class="ltx_text">so every term in <math id="A1.SS3.p2.m10" class="ltx_Math" alttext="S_{{t+1}}=(C_{t}-a_{{t,t}})+\sum_{\tau\in\mathcal{F}_{t}}a_{{\tau,t}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><mi>t</mi></msub><mo>−</mo><msub><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo rspace="0.055em">+</mo><mrow><msub><mo>∑</mo><mrow><mi>τ</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>t</mi></msub></mrow></msub><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">S_{{t+1}}=(C_{t}-a_{{t,t}})+\sum_{\tau\in\mathcal{F}_{t}}a_{{\tau,t}}</annotation></semantics></math> is
non-negative and in particular <math id="A1.SS3.p2.m11" class="ltx_Math" alttext="S_{t}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>t</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">S_{t}\geq 0</annotation></semantics></math> for all <math id="A1.SS3.p2.m12" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> by induction.</span></p>
</div>
<div id="A1.SS3.p3" class="ltx_para">
<p id="A1.SS3.p3.1" class="ltx_p"><span id="A1.SS3.p3.1.1" class="ltx_text">Finally, note that starting from <math id="A1.SS3.p3.m1" class="ltx_Math" alttext="a_{\tau,\tau}=\frac{1}{1+\left|m_{\tau}\right|}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mi>τ</mi></mrow></msub><mo>=</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mrow><mo>|</mo><msub><mi>m</mi><mi>τ</mi></msub><mo>|</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">a_{\tau,\tau}=\frac{1}{1+\left|m_{\tau}\right|}</annotation></semantics></math>,
we have</span></p>
<table id="A1.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex28.m1" class="ltx_Math" alttext="\displaystyle a_{\tau,\tau+1}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><annotation encoding="application/x-tex">\displaystyle a_{\tau,\tau+1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex28.m2" class="ltx_Math" alttext="\displaystyle=\min\left\{a_{\tau,\tau},a_{\tau+1,\tau+1}\right\}=\min_{s\in\left\{\tau,\tau+1\right\}}\frac{1}{1+\left|m_{s}\right|}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><msub><mi>a</mi><mrow><mi>τ</mi><mo>,</mo><mi>τ</mi></mrow></msub><mo>,</mo><msub><mi>a</mi><mrow><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo>}</mo></mrow></mrow><mo>=</mo><mrow><munder><mi>min</mi><mrow><mi>s</mi><mo>∈</mo><mrow><mo>{</mo><mrow><mi>τ</mi><mo>,</mo><mrow><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo>}</mo></mrow></mrow></munder><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mrow><mo>|</mo><msub><mi>m</mi><mi>s</mi></msub><mo>|</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\min\left\{a_{\tau,\tau},a_{\tau+1,\tau+1}\right\}=\min_{s\in\left\{\tau,\tau+1\right\}}\frac{1}{1+\left|m_{s}\right|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
