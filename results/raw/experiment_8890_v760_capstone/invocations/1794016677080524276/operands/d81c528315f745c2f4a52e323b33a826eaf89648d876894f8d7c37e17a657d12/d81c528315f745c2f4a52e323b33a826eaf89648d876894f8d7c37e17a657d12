)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Phi_{t+1}\leq(C_{t}-a_{t,t})\Gamma_{u}(H_{t,t+1})+\sum_{\tau\in\mathcal{F}_{t}}a_{\tau,t}\Gamma_{u}(U_{\tau})+\sum_{\tau\in m_{t+1}}a_{\tau,t}\Gamma_{u}(H_{\tau,t+1}).</annotation></semantics></math></td>
