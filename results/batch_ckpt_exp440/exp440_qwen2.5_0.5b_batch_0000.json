      "entry_point": "parse_nested_parens",
      "prompt": "def parse_nested_parens(paren_string: str) -> list:\n    \"\"\"Return max nesting depth for each paren group.\"\"\"\n",
      "canonical_solution": "    groups = paren_string.split()\n    result = []\n    for g in groups:\n        depth = max_depth = 0\n        for c in g:\n            if c == '(':\n                depth += 1\n                max_depth = max(max_depth, depth)\n            elif c == ')':\n                depth -= 1\n        result.append(max_depth)\n    return result\n",
