    {
      "task_id": "HumanEval/1",
      "entry_point": "separate_paren_groups",
      "prompt": "def separate_paren_groups(paren_string: str) -> list:\n    \"\"\"Separate groups of nested parentheses.\"\"\"\n",
      "canonical_solution": "    result, depth, current = [], 0, ''\n    for c in paren_string:\n        if c == '(':\n            depth += 1\n            current += c\n        elif c == ')':\n            current += c\n            depth -= 1\n            if depth == 0:\n                result.append(current)\n                current = ''\n    return result\n",
      "test_cases": [
        [
          [
            "(()()) ((())) () ((())()())"
          ],
          [
            "(()())",
            "((()))",
            "()",
            "((())()())"
          ]
        ]
      ],
      "test": ""
