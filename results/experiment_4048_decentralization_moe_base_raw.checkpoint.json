      {
        "code": "def transform(grid):\n    H, W = grid.shape\n    flipped = grid[:, ::-1]\n    result = np.zeros((3 * H, 3 * W), dtype=int)\n    for bi in range(3):\n        for bj in range(3):\n            if bi % 2 == 0:\n                result[bi * H:(bi + 1) * H, bj * W:(bj + 1) * W] = grid\n            else:\n                result[bi * H:(bi + 1) * H, bj * W:(bj + 1) * W] = flipped\n    return result",
