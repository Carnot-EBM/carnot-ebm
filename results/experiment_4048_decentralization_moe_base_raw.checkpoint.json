      {
        "code": "import numpy as np\n\ndef transform(grid):\n    # Find all non-zero objects\n    # For each color, find the longest horizontal or vertical segment\n    \n    rows, cols = grid.shape\n    colors = set()\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] != 0:\n                colors.add(grid[r][c])\n    \n    # For each color, find the longest segment\n    color_lengths = {}\n    for color in colors:\n        max_len = 0\n        # Check horizontal segments\n        for r in range(rows):\n            seg_len = 0\n            for c in range(cols):\n                if grid[r][c] == color:\n                    seg_len += 1\n                    max_len = max(max_len, seg_len)\n                else:\n                    seg_len = 0\n        # Check vertical segments\n        for c in range(cols):\n            seg_len = 0\n            for r in range(rows):\n                if grid[r][c] == color:\n                    seg_len += 1\n                    max_len = max(max_len, seg_len)\n                else:\n                    seg_len = 0\n        color_lengths[color] = max_len\n    \n    # Sort by length descending\n    sorted_colors = sorted(color_lengths.keys(), key=lambda c: color_lengths[c], reverse=True)\n    \n    # Output size\n    output_size = color_lengths[sorted_colors[0]]\n    \n    # Create output grid\n    output = np.zeros((output_size, output_size), dtype=int)\n    \n    for r in range(output_size):\n        for c in range(output_size):\n            layer = min(r, c, output_size - 1 - r, output_size - 1 - c)\n            output[r][c] = sorted_colors[layer]\n    \n    return output",
