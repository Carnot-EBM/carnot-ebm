import numpy as np

import numpy as np

def engine(grid, action, data):
    if action != 6:
        return grid.copy()
    
    x, y = data['x'], data['y']
    # The game seems to be a puzzle where clicking on specific regions 
    # changes their color to a specific value (8 or 9) and updates a progress bar at the bottom.
    # The regions are defined by 6x6 blocks.
    # The regions are likely mapped to the center of these blocks.
    #
    # Based on thes observed transitions:
    # (46, 38) -> r36-41, c44-49 (6x6 block)
    # (38, 54) -> r52-57, c36-41 (6x6 block)
    # (54, 54) -> r52-57, c52-57 (6x6 block)
    # (38, 46) -> r44-49, c36-41 (6x6 block)
    #
    # The pattern is: row = y - 2, col = x - 2.
    # The block is [y-2 : y+4, x-2 : x+4] ? No.
    # Let's check:
    # (46, 38) -> y=38, x=46. Block: r36-41, c44-49. 
    #   r_start = 38 - 2 = 36. r_end = 36 + 6 = 42.
    #   c_start = 46 - 2 = 44. c_end = 44 + 6 = 50.
    #   This matches perfectly.
    
    r_start = y - 2
    c_start = x - 2
    
    # We only change the block if it's within bounds and not already the target color.
    # The target color is likely 9 or 8.
    # Looking at the transitions, the first click on (46, 38) changed it to 8, then the second click changed it to 9.
    # It's a toggle or a sequence.
    # Let's check the other clicks:
    # (38, 54) -> 8, then (54, 54) -> 8, then (46, 38) -> 9, then (54, 54) -> 9.
    # It seems the color toggles between 8 and 9.
    
    # The block is 6x6.
    # Let's check if the block is within bounds.
    # if r_start < 0 or c_start < 0 or r_start + 6 > 64 or c_start + 6 > 64:
    #     return grid.copy()
    
    # The block is 6x6.
    # We identify the target block.
    # The block is 6x6.
    # The block is 6x6.
    
    # The block is 6x6 = 36 cells.
    #
    # The block is 6x6.
    #
