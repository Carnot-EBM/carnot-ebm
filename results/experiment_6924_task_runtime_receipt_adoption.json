      "api": "ExperimentTemplate.task_runtime_receipts",
      "call_pattern": "with tmpl.task_runtime_receipts(path, task_id=TASK_ID, control_id=CONTROL_ID, runner_selection=runner, model_identity=model, device_ids=device_ids, model_count=len(models)) as runtime:\n    with runtime.phase('generation', model_id=model_id, child_pids=[server.pid]) as phase:\n        phase['raw_output_bytes'] = output\n        phase['exit_status'] = exit_status\n        phase['gpu_samples'] = pid_uuid_vram_utilization_offload_samples",
