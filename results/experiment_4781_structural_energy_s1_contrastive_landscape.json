  "field_principles": {
    "denoising_direction_agreement": {
      "principle": "the energy-vs-classifier distinction -- -deltaE descent must point toward correctness, a property a point classifier lacks."
    },
    "energy_ranking_loo_auroc_ci95": {
      "principle": ">=0.70 with CI95 excluding chance across seeds is the bar -- multi-seed is what S0' (single-seed) did not establish."
    },
    "energy_ranking_loo_auroc_mean": {
      "principle": "the load-bearing measurement -- mean cross-game LOO AUROC ranking by -E across >=10 seeds."
    },
    "honest_verdict": {
      "principle": "terminal prefix; a usable energy landscape is success_structural_energy_s1_landscape_authorizes_s2, a bounded result is complete_structural_energy_s1_discriminates_no_usable_landscape."
    },
    "in_sample_auroc": {
      "principle": "positive control > 0.60 -- else the harness is broken."
    },
    "inference_substrate": {
      "principle": "verifier_ensemble_against_cached_candidates (scores structural features over cached transitions, no LLM; 1s floor)."
    },
    "n_seeds": {
      "principle": ">=10 -- the single-seed S0' result must be shown robust before the energy is trusted as a landscape."
    },
    "origin_probe_auroc": {
      "principle": "carry the S0' leak control -- must stay < 0.6 (origin matched); a regression means the contrastive training reintroduced an origin shortcut."
    },
    "per_family_loo": {
      "principle": ">=2 independent structural families each >= 0.60 -- kills the frame_delta-single-lever risk for the energy."
    },
    "preconditions_checked": {
      "principle": "records the arcade/feature-import checks so a silent-missing-resource run cannot fabricate an AUROC."
    },
    "random_seeds_used": {
      "principle": "the list of >=10 seeds -- determinism + reproducibility for the multi-seed claim."
    },
    "reproducibility_checksum": {
      "principle": "content hash of (corpus, folds, energy training config) so a replication catches drift."
    },
    "shuffled_label_control_auroc": {
      "principle": "<= 0.55 -- the second leak control must hold under contrastive training."
    },
    "verifier_is_oracle": {
      "principle": "MUST be false -- the energy never runs the env win-check; required for check_circular_moat_overclaim."
    }
  },
