#!/usr/bin/env python
"""Per-PID VRAM sampler for the inducer head-to-head.

WHY this exists (verbose, per CLAUDE.md documentation standards): three prior attempts at this
exact measurement died with an unexplained hang. The 2026-07-24 attempt recorded GPU 1 dropping
from 21GB to 4MiB -- the documented eGPU PCI-bus fault -- but only found that out AFTER the fact by
reading logs. If a card falls off the bus mid-run, that must be a RECORDED FACT with a timestamp,
not something inferred later. So we sample per-PID residency (not just per-card totals: per-card
totals cannot tell you WHICH process lost its allocation) continuously to a jsonl for the whole run.
"""

from __future__ import annotations

import json
import subprocess
import sys
import time
from pathlib import Path

OUT = Path(sys.argv[1])
INTERVAL = float(sys.argv[2]) if len(sys.argv) > 2 else 10.0


def q(args: list[str]) -> list[str]:
    try:
        return subprocess.run(
            args, capture_output=True, text=True, timeout=20
        ).stdout.strip().splitlines()
    except Exception as exc:  # a hung nvidia-smi is itself a bus-fault symptom worth recording
        return [f"QUERY_ERROR {type(exc).__name__}: {exc}"]


def sample() -> dict:
    cards = []
    for line in q(
        [
            "nvidia-smi",
            "--query-gpu=index,uuid,memory.used,memory.total,utilization.gpu",
            "--format=csv,noheader,nounits",
        ]
    ):
        p = [x.strip() for x in line.split(",")]
        if len(p) == 5 and p[0].isdigit():
            cards.append(
                {
                    "index": int(p[0]),
                    "uuid": p[1],
                    "used_mib": int(p[2]),
                    "total_mib": int(p[3]),
                    "util": int(p[4]),
                }
            )
        else:
            cards.append({"raw": line})
    procs = []
    for line in q(
        ["nvidia-smi", "--query-compute-apps=pid,gpu_uuid,used_memory", "--format=csv,noheader,nounits"]
    ):
        p = [x.strip() for x in line.split(",")]
        if len(p) == 3 and p[0].isdigit():
            procs.append({"pid": int(p[0]), "gpu_uuid": p[1], "used_mib": int(p[2])})
        else:
            procs.append({"raw": line})
    return {"ts": time.time(), "iso": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "cards": cards, "procs": procs}


def main() -> None:
    OUT.parent.mkdir(parents=True, exist_ok=True)
    with OUT.open("a") as f:
        while True:
            f.write(json.dumps(sample()) + "\n")
            f.flush()
            time.sleep(INTERVAL)


if __name__ == "__main__":
    main()
