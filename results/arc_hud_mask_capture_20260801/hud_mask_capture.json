{
  "acceptance_gates": {
    "gate_1_sharp_test_tn36_row1_detected": {
      "passed": true,
      "principle": "tn36's engines model row 1 and nothing else, so row 1 is the band whose masking decides whether the six perfect-1.0 candidates stay perfect. A detector that cannot see it cannot fix the metric. NOTE this gate is about DETECTION only -- gate 4 is what decides whether it may be used."
    },
    "gate_2_every_stage1_accepted_band_carries_positive_evidence": {
      "n_stage1_accepted": 9,
      "passed": true,
      "principle": "changed_fraction alone cannot distinguish a counter row from the row the player walks along, so 'the detector flagged it' is not by itself a licence to delete cells. Every accepted band passed at least one decoupling discriminator."
    },
    "gate_3_no_stage1_accepted_band_tripped_a_playfield_alarm": {
      "passed": true,
      "principle": "over-masking destroys CORRECTNESS while under-masking only costs efficiency (logical_hud_mask's own docstring), so any alarm on either corpus excludes the band."
    },
    "gate_4_every_shipped_mask_is_clean_on_BOTH_corpora": {
      "n_masks_shipped": 6,
      "n_masks_withheld": 3,
      "passed": true,
      "principle": "REQ-ARC-WMTE-6017: a verdict is a statement about (mask, corpus), never about the mask alone. A mask cleared only on the corpus it was derived from is not cleared."
    },
