  "backtracking_policy": {
    "actions": {
      "abstained": {
        "next_step": "do_not_promote_headline_claim",
        "requires_exact_acceptance": false,
        "trigger_conditions": [
          "source_provenance_or_uncertainty_policy_blocks",
          "model_identity_coverage_risk_blocks",
