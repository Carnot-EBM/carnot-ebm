>>>>>>     return arr, False
       
       
    1: def _sigmoid(values: np.ndarray) -> np.ndarray:
>>>>>>     return (1.0 / (1.0 + np.exp(-np.clip(values, -60.0, 60.0)))).astype(np.float32)
       
       
    1: def _balanced_weights(labels: np.ndarray) -> np.ndarray:
>>>>>>     y = np.asarray(labels, dtype=np.float32)
>>>>>>     n_pos = float(np.sum(y > 0.5))
>>>>>>     n_neg = float(len(y) - n_pos)
>>>>>>     if n_pos == 0.0 or n_neg == 0.0:
>>>>>>         return np.ones_like(y, dtype=np.float32)
>>>>>>     return np.where(y > 0.5, len(y) / (2.0 * n_pos), len(y) / (2.0 * n_neg)).astype(np.float32)
       
       
