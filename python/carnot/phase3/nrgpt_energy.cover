>>>>>>     return None
       
       
    1: def _find_answer_token(tokens: Sequence[str]) -> int | None:
>>>>>>     for idx, token in enumerate(tokens):
>>>>>>         if str(token).lower() == "answer":
>>>>>>             return idx
>>>>>>     return None
       
       
    1: def _first_number_after(tokens: Sequence[str], idx: int) -> tuple[int, float] | None:
