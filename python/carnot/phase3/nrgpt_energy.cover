    1: def locate_arithmetic_error_token(response_tokens: Sequence[str]) -> int | None:
           """Return the token index of a detected wrong arithmetic claim, if any."""
       
>>>>>>     tokens = [str(token) for token in response_tokens]
>>>>>>     for idx, token in enumerate(tokens):
>>>>>>         if token != "=":
>>>>>>             continue
>>>>>>         lhs = _scan_expression_left(tokens, idx)
>>>>>>         rhs = _scan_expression_right(tokens, idx)
>>>>>>         lhs_value = _expression_value(lhs)
>>>>>>         rhs_value = _expression_value(rhs)
>>>>>>         if lhs_value is None or rhs_value is None:
>>>>>>             continue
>>>>>>         if not np.isclose(lhs_value, rhs_value, rtol=1e-6, atol=1e-6):
>>>>>>             return _first_number_position(rhs)
       
>>>>>>     answer_idx = _find_answer_token(tokens)
>>>>>>     if answer_idx is None:
>>>>>>         return None
>>>>>>     expected = _find_first_arithmetic_expression(tokens, stop_idx=answer_idx)
>>>>>>     claimed = _first_number_after(tokens, answer_idx)
>>>>>>     if expected is None or claimed is None:
>>>>>>         return None
>>>>>>     claimed_idx, claimed_value = claimed
>>>>>>     if np.isclose(expected, claimed_value, rtol=1e-6, atol=1e-6):
>>>>>>         return None
>>>>>>     return claimed_idx
       
       
    4: def evaluate_per_token_fover(
    1:     rows: Sequence[dict[str, Any]],
           *,
    2:     model: NRGPTEnergyModel | None = None,
    1: ) -> PerTokenEvaluation:
           """Evaluate token energies against located FoVer arithmetic error tokens."""
       
>>>>>>     scorer = model or NRGPTEnergyModel()
>>>>>>     token_labels: list[int] = []
>>>>>>     token_scores: list[float] = []
>>>>>>     n_errors = 0
>>>>>>     n_localized = 0
>>>>>>     n_correct = 0
>>>>>>     n_incorrect = 0
>>>>>>     for row in rows:
>>>>>>         text = response_text(row)
>>>>>>         tokens = tokenize_response(text)
>>>>>>         if not tokens:
>>>>>>             continue
>>>>>>         row_is_correct = label_to_int(row.get("label")) == 1
>>>>>>         n_correct += int(row_is_correct)
>>>>>>         n_incorrect += int(not row_is_correct)
>>>>>>         error_idx = None if row_is_correct else locate_arithmetic_error_token(tokens)
>>>>>>         energies = scorer.energy_per_token(tokens)
>>>>>>         if error_idx is not None:
>>>>>>             n_errors += 1
>>>>>>             if abs(int(np.argmax(energies)) - error_idx) <= 2:
>>>>>>                 n_localized += 1
>>>>>>         for idx, energy in enumerate(energies):
>>>>>>             token_labels.append(1 if error_idx is not None and idx == error_idx else 0)
>>>>>>             token_scores.append(float(energy))
       
>>>>>>     localization_rate = n_localized / n_errors if n_errors else 0.0
>>>>>>     return PerTokenEvaluation(
>>>>>>         per_token_auroc=float(auroc(token_labels, token_scores)),
>>>>>>         energy_spike_localization_rate=float(localization_rate),
>>>>>>         n_eval_rows=int(n_correct + n_incorrect),
>>>>>>         n_token_scores=len(token_scores),
>>>>>>         n_error_tokens=n_errors,
>>>>>>         n_correct_rows=n_correct,
>>>>>>         n_incorrect_rows=n_incorrect,
           )
       
       
