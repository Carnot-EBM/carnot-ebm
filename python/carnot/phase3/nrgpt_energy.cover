    6: def split_fover_rows(
    1:     rows: Sequence[dict[str, Any]],
           *,
    2:     n_train: int = DEFAULT_N_TRAIN,
    2:     n_eval: int = DEFAULT_N_EVAL,
    2:     seed: int = DEFAULT_SEED,
    1: ) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
           """Return a deterministic stratified train/eval split."""
       
>>>>>>     by_label = {0: [], 1: []}
>>>>>>     for row in rows:
>>>>>>         by_label[label_to_int(row.get("label"))].append(dict(row))
>>>>>>     if not by_label[0] or not by_label[1]:
>>>>>>         raise ValueError("FoVer split requires both correct and incorrect rows")
       
>>>>>>     rng = np.random.default_rng(seed)
>>>>>>     for label_rows in by_label.values():
>>>>>>         rng.shuffle(label_rows)
       
>>>>>>     total_available = len(by_label[0]) + len(by_label[1])
>>>>>>     requested_total = int(n_train) + int(n_eval)
>>>>>>     target_total = min(total_available, requested_total)
>>>>>>     if total_available >= requested_total:
>>>>>>         eval_target = int(n_eval)
>>>>>>         train_target = int(n_train)
           else:
>>>>>>         eval_target = min(int(n_eval), max(1, target_total // 5))
>>>>>>         train_target = min(int(n_train), target_total - eval_target)
       
>>>>>>     neg_fraction = len(by_label[0]) / total_available
>>>>>>     eval_neg = int(np.clip(round(eval_target * neg_fraction), 1, eval_target - 1))
>>>>>>     train_neg = int(np.clip(round(train_target * neg_fraction), 1, train_target - 1))
       
>>>>>>     eval_rows = by_label[0][:eval_neg] + by_label[1][: eval_target - eval_neg]
>>>>>>     train_rows = (
>>>>>>         by_label[0][eval_neg : eval_neg + train_neg]
>>>>>>         + by_label[1][eval_target - eval_neg : eval_target - eval_neg + train_target - train_neg]
           )
>>>>>>     rng.shuffle(eval_rows)
>>>>>>     rng.shuffle(train_rows)
>>>>>>     return train_rows, eval_rows
       
       
