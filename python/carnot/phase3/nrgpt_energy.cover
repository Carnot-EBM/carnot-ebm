    1:         lr: float,
    2:         beta1: float = 0.9,
    2:         beta2: float = 0.999,
    1:     ) -> None:
>>>>>>         self._t += 1
>>>>>>         self._m_w = beta1 * self._m_w + (1.0 - beta1) * grad_w
>>>>>>         self._v_w = beta2 * self._v_w + (1.0 - beta2) * grad_w * grad_w
>>>>>>         self._m_b = np.float32(beta1 * self._m_b + (1.0 - beta1) * grad_b)
>>>>>>         self._v_b = np.float32(beta2 * self._v_b + (1.0 - beta2) * grad_b * grad_b)
>>>>>>         m_w = self._m_w / (1.0 - beta1**self._t)
>>>>>>         v_w = self._v_w / (1.0 - beta2**self._t)
>>>>>>         m_b = self._m_b / (1.0 - beta1**self._t)
>>>>>>         v_b = self._v_b / (1.0 - beta2**self._t)
>>>>>>         self.weights -= np.float32(lr) * m_w / (np.sqrt(v_w) + 1e-8)
>>>>>>         self.bias = np.float32(self.bias - np.float32(lr) * m_b / (np.sqrt(v_b) + 1e-8))
       
       
    2: class NRGPTEnergyModel:
    1:     """Sequential hidden-state energy readout for token-level FoVer scoring.
       
