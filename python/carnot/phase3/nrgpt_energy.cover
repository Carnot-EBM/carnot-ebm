>>>>>>             raise ValueError("d_emb must be >= 1")
>>>>>>         rng = np.random.default_rng(seed)
>>>>>>         self.weights = rng.normal(0.0, 0.01, size=d_emb).astype(np.float32)
>>>>>>         self.bias = np.float32(0.0)
>>>>>>         self._m_w = np.zeros_like(self.weights)
>>>>>>         self._v_w = np.zeros_like(self.weights)
>>>>>>         self._m_b = np.float32(0.0)
>>>>>>         self._v_b = np.float32(0.0)
>>>>>>         self._t = 0
       
    1:     def logits(self, embeddings: np.ndarray) -> np.ndarray:
>>>>>>         x = np.asarray(embeddings, dtype=np.float32)
>>>>>>         return (x @ self.weights + self.bias).astype(np.float32)
       
    1:     def score(self, embeddings: np.ndarray) -> np.ndarray:
>>>>>>         return self.logits(embeddings)
       
    1:     def probabilities(self, embeddings: np.ndarray) -> np.ndarray:
>>>>>>         return _sigmoid(self.logits(embeddings))
       
    8:     def fit(
               self,
    1:         embeddings: np.ndarray,
    1:         labels: np.ndarray,
               *,
    2:         epochs: int = 50,
    2:         lr: float = 0.25,
    2:         batch_size: int = 256,
    2:         l2: float = 1e-4,
    1:     ) -> None:
>>>>>>         x = np.asarray(embeddings, dtype=np.float32)
>>>>>>         y = np.asarray(labels, dtype=np.float32)
>>>>>>         rng = np.random.default_rng(DEFAULT_SEED + x.shape[1])
>>>>>>         weights = _balanced_weights(y)
>>>>>>         for _ in range(int(epochs)):
>>>>>>             for idx in _minibatches(len(x), batch_size, rng):
>>>>>>                 xb = x[idx]
>>>>>>                 yb = y[idx]
>>>>>>                 wb = weights[idx]
>>>>>>                 pred = _sigmoid(xb @ self.weights + self.bias)
>>>>>>                 delta = (pred - yb) * wb
>>>>>>                 denom = float(np.sum(wb) + 1e-12)
>>>>>>                 grad_w = (xb.T @ delta) / denom + l2 * self.weights
>>>>>>                 grad_b = np.float32(np.sum(delta) / denom)
>>>>>>                 self._adam_step(grad_w.astype(np.float32), grad_b, lr=lr)
       
