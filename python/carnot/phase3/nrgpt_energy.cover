>>>>>>         tokens = [str(token) for token in response_tokens]
>>>>>>         if not tokens:
>>>>>>             return []
>>>>>>         error_idx = locate_arithmetic_error_token(tokens)
>>>>>>         hidden = np.zeros(self.d_hidden, dtype=np.float32)
>>>>>>         energies: list[float] = []
>>>>>>         for idx, token in enumerate(tokens):
>>>>>>             token_input = self._token_input(token, idx=idx, error_idx=error_idx)
>>>>>>             hidden = np.tanh(self.recurrent_decay * hidden + token_input).astype(np.float32)
>>>>>>             energies.append(float(hidden @ self.energy_readout + self.energy_bias))
>>>>>>         return energies
       
    1:     def batch_energy(self, response: str) -> float:
