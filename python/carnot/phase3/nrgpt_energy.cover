>>>>>>     if text[0] == "[":
>>>>>>         payload = json.loads(text)
>>>>>>         return [dict(row) for row in payload if isinstance(row, dict)]
>>>>>>     return [json.loads(line) for line in text.splitlines() if line.strip()]
       
       
    1: def _scan_expression_left(tokens: Sequence[str], eq_idx: int) -> list[tuple[int, str]]:
>>>>>>     pairs: list[tuple[int, str]] = []
>>>>>>     idx = eq_idx - 1
>>>>>>     while idx >= 0:
>>>>>>         token = str(tokens[idx])
>>>>>>         if token in _IGNORED_ARITHMETIC_TOKENS:
>>>>>>             idx -= 1
>>>>>>             continue
>>>>>>         if not _is_arithmetic_token(token):
>>>>>>             break
>>>>>>         pairs.append((idx, token))
>>>>>>         idx -= 1
>>>>>>     pairs.reverse()
>>>>>>     return _trim_expression_pairs(pairs)
       
       
    1: def _scan_expression_right(tokens: Sequence[str], eq_idx: int) -> list[tuple[int, str]]:
>>>>>>     pairs: list[tuple[int, str]] = []
>>>>>>     idx = eq_idx + 1
>>>>>>     while idx < len(tokens):
>>>>>>         token = str(tokens[idx])
>>>>>>         if token in _IGNORED_ARITHMETIC_TOKENS:
>>>>>>             idx += 1
>>>>>>             continue
>>>>>>         if not _is_arithmetic_token(token):
>>>>>>             break
>>>>>>         pairs.append((idx, token))
>>>>>>         idx += 1
>>>>>>     return _trim_expression_pairs(pairs)
       
       
    1: def _trim_expression_pairs(pairs: list[tuple[int, str]]) -> list[tuple[int, str]]:
>>>>>>     while pairs and _normalize_operator(pairs[-1][1]) is not None:
>>>>>>         pairs.pop()
>>>>>>     while pairs and _normalize_operator(pairs[0][1]) in {"*", "/"}:
>>>>>>         pairs.pop(0)
>>>>>>     if sum(1 for _, token in pairs if _is_number_token(token)) == 0:
>>>>>>         return []
>>>>>>     return pairs
       
       
    1: def _expression_value(pairs: Sequence[tuple[int, str]]) -> float | None:
