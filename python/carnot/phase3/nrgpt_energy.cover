>>>>>>         return None
>>>>>>     parts: list[str] = []
>>>>>>     has_operator = False
>>>>>>     for _, token in pairs:
>>>>>>         number = _normalize_number(token)
>>>>>>         if number is not None:
>>>>>>             parts.append(number)
>>>>>>             continue
>>>>>>         operator = _normalize_operator(token)
>>>>>>         if operator is None:
>>>>>>             return None
>>>>>>         has_operator = True
>>>>>>         parts.append(operator)
>>>>>>     if not has_operator:
>>>>>>         return _coerce_float(parts[0])
>>>>>>     return _safe_eval_arithmetic("".join(parts))
       
       
    1: def _first_number_position(pairs: Sequence[tuple[int, str]]) -> int | None:
