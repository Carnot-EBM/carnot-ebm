    5: def build_synthetic_fover_rows(
    2:     n_pairs: int = DEFAULT_N_TRAIN + DEFAULT_N_EVAL,
           *,
    2:     seed: int = DEFAULT_SEED,
    1: ) -> list[dict[str, Any]]:
           """Build an honest synthetic fallback when no FoVer corpus is present."""
       
>>>>>>     rng = np.random.default_rng(seed)
>>>>>>     rows: list[dict[str, Any]] = []
>>>>>>     for i in range(int(n_pairs)):
>>>>>>         a = int(rng.integers(2, 50))
>>>>>>         b = int(rng.integers(2, 50))
>>>>>>         correct = bool(i % 2 == 0)
>>>>>>         answer = a + b if correct else a + b + int(rng.choice([-2, -1, 1, 2]))
>>>>>>         label = "correct" if correct else "incorrect"
>>>>>>         rows.append(
>>>>>>             {
>>>>>>                 "question_id": f"synthetic_{i}",
>>>>>>                 "step_text": f"Compute {a} + {b}. The answer is {answer}.",
>>>>>>                 "label": label,
>>>>>>                 "confidence": 1.0,
                   }
               )
>>>>>>     return rows
       
       
    1: def label_to_int(label: Any) -> int:
>>>>>>     if isinstance(label, bool):
>>>>>>         return int(label)
>>>>>>     if isinstance(label, (int, float)) and label in (0, 1):
>>>>>>         return int(label)
>>>>>>     value = str(label).strip().lower()
>>>>>>     if value in {"correct", "true", "yes", "1"}:
>>>>>>         return 1
>>>>>>     if value in {"incorrect", "false", "no", "0"}:
>>>>>>         return 0
>>>>>>     raise ValueError(f"unsupported FoVer label: {label!r}")
       
       
    1: def response_text(row: dict[str, Any]) -> str:
>>>>>>     for key in ("step_text", "response", "text", "answer", "completion"):
>>>>>>         value = row.get(key)
>>>>>>         if value:
>>>>>>             return str(value)
>>>>>>     return ""
       
       
    1: def _read_rows(path: Path) -> list[dict[str, Any]]:
