    7:     def __init__(
               self,
    2:         d_hidden: int = DEFAULT_ENERGY_DIM,
               *,
    2:         recurrent_decay: float = 0.35,
    2:         spike_scale: float = 2.0,
    2:         seed: int = DEFAULT_SEED,
    1:     ) -> None:
>>>>>>         if d_hidden < 1:
>>>>>>             raise ValueError("d_hidden must be >= 1")
>>>>>>         self.d_hidden = int(d_hidden)
>>>>>>         self.recurrent_decay = float(recurrent_decay)
>>>>>>         self.spike_scale = float(spike_scale)
>>>>>>         self.seed = int(seed)
>>>>>>         rng = np.random.default_rng(seed)
>>>>>>         self.token_noise = rng.normal(0.0, 0.01, size=self.d_hidden).astype(np.float32)
>>>>>>         self.token_noise[0] = 0.0
>>>>>>         self.energy_readout = np.zeros(self.d_hidden, dtype=np.float32)
>>>>>>         self.energy_readout[0] = np.float32(1.0)
>>>>>>         self.energy_bias = np.float32(0.0)
       
