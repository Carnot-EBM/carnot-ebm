>>>>>>         value = _coerce_float(str(tokens[pos]))
>>>>>>         if value is not None:
>>>>>>             return pos, value
>>>>>>     return None
       
       
    1: def _find_first_arithmetic_expression(tokens: Sequence[str], *, stop_idx: int) -> float | None:
>>>>>>     for start in range(stop_idx):
>>>>>>         if not _is_number_token(str(tokens[start])):
>>>>>>             continue
>>>>>>         pairs: list[tuple[int, str]] = []
>>>>>>         idx = start
>>>>>>         while idx < stop_idx:
>>>>>>             token = str(tokens[idx])
>>>>>>             if token in _IGNORED_ARITHMETIC_TOKENS:
>>>>>>                 idx += 1
