    1:     def __init__(self, dim: int = DEFAULT_EMBEDDING_DIM) -> None:
>>>>>>         if dim < 1:
>>>>>>             raise ValueError("embedding dim must be >= 1")
>>>>>>         self.dim = int(dim)
       
    1:     def encode(self, texts: Sequence[str]) -> np.ndarray:
>>>>>>         rows: list[np.ndarray] = []
>>>>>>         for text in texts:
>>>>>>             vec = np.zeros(self.dim, dtype=np.float32)
>>>>>>             tokens = _TOKEN_RE.findall(text.lower()) or [""]
>>>>>>             for token in tokens:
>>>>>>                 digest = hashlib.blake2b(token.encode("utf-8"), digest_size=8).digest()
>>>>>>                 value = int.from_bytes(digest, "little", signed=False)
>>>>>>                 idx = value % self.dim
>>>>>>                 sign = 1.0 if ((value >> 9) & 1) else -1.0
>>>>>>                 vec[idx] += sign
>>>>>>             norm = float(np.linalg.norm(vec))
>>>>>>             vec /= max(norm, 1e-12)
>>>>>>             rows.append(vec)
>>>>>>         return np.stack(rows, axis=0).astype(np.float32)
       
       
    2: class LogisticProbe:
    1:     """Small weighted logistic-regression probe trained with Adam."""
       
    1:     def __init__(self, d_emb: int, seed: int = DEFAULT_SEED) -> None:
