    2: class NRGPTEnergyBlock:
    1:     """Three-layer MLP energy with bounded recurrent gradient descent.
       
           ``energy(z)`` is a scalar MLP.  ``forward(z)`` repeatedly computes
           ``grad_z energy(z)`` and applies ``z <- z - step_size * grad``.  Gradient
           and state clipping keep the recurrence bounded, which is important because
           this is an architecture seed rather than a fully trained foundation model.
           """
       
    1:     n_linear_layers = 3
       
   10:     def __init__(
               self,
    1:         d_emb: int,
    2:         d_energy: int = DEFAULT_ENERGY_DIM,
    2:         n_iters: int = 3,
               *,
    2:         step_size: float = 0.05,
    2:         grad_clip: float = 1.0,
    2:         state_clip: float = 4.0,
    2:         seed: int = DEFAULT_SEED,
    1:     ) -> None:
>>>>>>         if d_emb < 1:
>>>>>>             raise ValueError("d_emb must be >= 1")
>>>>>>         if d_energy < 1:
>>>>>>             raise ValueError("d_energy must be >= 1")
>>>>>>         if n_iters < 1:
>>>>>>             raise ValueError("n_iters must be >= 1")
>>>>>>         self.d_emb = int(d_emb)
>>>>>>         self.d_energy = int(d_energy)
>>>>>>         self.n_iters = int(n_iters)
>>>>>>         self.step_size = float(step_size)
>>>>>>         self.grad_clip = float(grad_clip)
>>>>>>         self.state_clip = float(state_clip)
>>>>>>         rng = np.random.default_rng(seed)
>>>>>>         scale1 = np.sqrt(2.0 / self.d_emb)
>>>>>>         scale2 = np.sqrt(2.0 / self.d_energy)
>>>>>>         self.W1 = rng.normal(0.0, scale1, size=(self.d_emb, self.d_energy)).astype(np.float32)
>>>>>>         self.b1 = np.zeros(self.d_energy, dtype=np.float32)
>>>>>>         self.W2 = rng.normal(0.0, scale2, size=(self.d_energy, self.d_energy)).astype(np.float32)
>>>>>>         self.b2 = np.zeros(self.d_energy, dtype=np.float32)
>>>>>>         self.W3 = rng.normal(0.0, scale2, size=(self.d_energy, 1)).astype(np.float32)
>>>>>>         self.b3 = np.zeros(1, dtype=np.float32)
>>>>>>         self._params = [self.W1, self.b1, self.W2, self.b2, self.W3, self.b3]
>>>>>>         self._m = [np.zeros_like(param) for param in self._params]
>>>>>>         self._v = [np.zeros_like(param) for param in self._params]
>>>>>>         self._t = 0
       
    1:     def __call__(self, z: np.ndarray) -> np.ndarray:
>>>>>>         return self.forward(z)
       
    1:     def copy_with_n_iters(self, n_iters: int) -> "NRGPTEnergyBlock":
>>>>>>         clone = NRGPTEnergyBlock(
>>>>>>             self.d_emb,
>>>>>>             self.d_energy,
>>>>>>             n_iters,
>>>>>>             step_size=self.step_size,
>>>>>>             grad_clip=self.grad_clip,
>>>>>>             state_clip=self.state_clip,
>>>>>>             seed=0,
               )
>>>>>>         for target, source in zip(clone._params, self._params):
>>>>>>             target[...] = source
>>>>>>         return clone
       
    1:     def energy(self, z: np.ndarray) -> np.ndarray:
>>>>>>         values, _ = self._forward_cache(np.asarray(z, dtype=np.float32))
>>>>>>         return values
       
    1:     def energy_grad(self, z: np.ndarray) -> np.ndarray:
>>>>>>         x, was_vector = _as_2d(np.asarray(z, dtype=np.float32))
>>>>>>         _, cache = self._forward_cache(x)
>>>>>>         grad_h2_pre = (1.0 - cache["h2"] ** 2) * self.W3.T
>>>>>>         grad_h1 = grad_h2_pre @ self.W2.T
>>>>>>         grad_h1_pre = grad_h1 * (1.0 - cache["h1"] ** 2)
>>>>>>         grad_x = grad_h1_pre @ self.W1.T
>>>>>>         return grad_x[0] if was_vector else grad_x.astype(np.float32)
       
    1:     def forward(self, z: np.ndarray) -> np.ndarray:
>>>>>>         x, was_vector = _as_2d(np.asarray(z, dtype=np.float32))
>>>>>>         state = np.clip(x.copy(), -self.state_clip, self.state_clip)
>>>>>>         for _ in range(self.n_iters):
>>>>>>             grad = self.energy_grad(state)
>>>>>>             grad_2d, _ = _as_2d(grad)
>>>>>>             grad_norm = np.linalg.norm(grad_2d, axis=1, keepdims=True)
>>>>>>             scale = np.minimum(1.0, self.grad_clip / np.maximum(grad_norm, 1e-12))
>>>>>>             bounded_grad = grad_2d * scale
>>>>>>             state = np.clip(
>>>>>>                 state - np.float32(self.step_size) * bounded_grad,
>>>>>>                 -self.state_clip,
>>>>>>                 self.state_clip,
>>>>>>             ).astype(np.float32)
>>>>>>         return state[0] if was_vector else state
       
    1:     def _forward_cache(self, z: np.ndarray) -> tuple[np.ndarray, dict[str, np.ndarray]]:
>>>>>>         x, _ = _as_2d(z)
>>>>>>         a1 = x @ self.W1 + self.b1
>>>>>>         h1 = np.tanh(a1).astype(np.float32)
>>>>>>         a2 = h1 @ self.W2 + self.b2
>>>>>>         h2 = np.tanh(a2).astype(np.float32)
>>>>>>         energy = (h2 @ self.W3 + self.b3).reshape(-1).astype(np.float32)
>>>>>>         return energy, {"x": x, "h1": h1, "h2": h2}
       
    6:     def _adam_step(
               self,
    1:         grads: Sequence[np.ndarray],
               *,
    1:         lr: float,
    2:         beta1: float = 0.9,
    2:         beta2: float = 0.999,
    1:     ) -> None:
>>>>>>         self._t += 1
>>>>>>         for i, (param, grad) in enumerate(zip(self._params, grads)):
>>>>>>             clipped = np.clip(grad.astype(np.float32), -5.0, 5.0)
>>>>>>             self._m[i] = beta1 * self._m[i] + (1.0 - beta1) * clipped
>>>>>>             self._v[i] = beta2 * self._v[i] + (1.0 - beta2) * clipped * clipped
>>>>>>             m_hat = self._m[i] / (1.0 - beta1**self._t)
>>>>>>             v_hat = self._v[i] / (1.0 - beta2**self._t)
>>>>>>             param -= np.float32(lr) * m_hat / (np.sqrt(v_hat) + 1e-8)
       
       
