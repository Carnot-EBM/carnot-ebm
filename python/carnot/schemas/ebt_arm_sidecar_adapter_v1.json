{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CarnotEbtArmSidecarAdapterV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "candidate",
    "constraints",
    "energy_terms",
    "verifier_feedback",
    "confidence",
    "exact_label_reference",
    "source_artifacts"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "prompt_id",
        "candidate_text",
        "candidate_label",
        "model_id"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "prompt_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_text": {
          "type": "string",
          "minLength": 1
        },
        "candidate_label": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "token_logprobs": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "constraint_id",
          "description",
          "satisfied",
          "weight",
          "violation_energy",
          "label_ref"
        ],
        "properties": {
          "constraint_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "satisfied": {
            "type": "boolean"
          },
          "weight": {
            "type": "number",
            "minimum": 0.0
          },
          "violation_energy": {
            "type": "number",
            "minimum": 0.0
          },
          "label_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "energy_terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source",
          "value",
          "weight"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "weight": {
            "type": "number",
            "minimum": 0.0
          }
        }
      }
    },
    "verifier_feedback": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "verifier_id",
          "status",
          "energy",
          "message",
          "violations"
        ],
        "properties": {
          "verifier_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "abstain",
              "not_run"
            ]
          },
          "energy": {
            "type": "number",
            "minimum": 0.0
          },
          "message": {
            "type": "string"
          },
          "violations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence",
        "abstain",
        "abstention_reason",
        "calibration_ref"
      ],
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "abstain": {
          "type": "boolean"
        },
        "abstention_reason": {
          "type": "string"
        },
        "calibration_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "exact_label_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label_id",
        "label",
        "authority",
        "source_artifact",
        "checksum"
      ],
      "properties": {
        "label_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "enum": [
            "exact_solver",
            "deterministic_tests",
            "human_audited_fixture"
          ]
        },
        "source_artifact": {
          "type": "string",
          "minLength": 1
        },
        "checksum": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
