    1: """Rust binding availability flag.
       
       When the optional ``carnot._rust`` extension (built via maturin from the
       ``carnot-python`` crate) is installed, ``RUST_AVAILABLE`` is True and the
       native Rust model/sampler classes are re-exported here for convenience.
       
       When Rust bindings are absent (pure-Python install), ``RUST_AVAILABLE`` is
       False and all Rust class references are None.  Callers should check
       ``RUST_AVAILABLE`` before attempting to use any ``Rust*`` class.
       """
       
    1: from __future__ import annotations
       
    1: RUST_AVAILABLE: bool
    1: """True when the compiled Rust extension ``carnot._rust`` is importable."""
       
    1: try:
    1:     from carnot._rust import (  # type: ignore[import-not-found]
               RustBoltzmannModel,
               RustGibbsModel,
               RustHMCSampler,
               RustIsingModel,
               RustLangevinSampler,
               RustVerificationResult,
               RustVerifyPipeline,
           )
       
>>>>>>     RUST_AVAILABLE = True
    1: except ImportError:
    1:     RUST_AVAILABLE = False
    1:     RustIsingModel = None  # type: ignore[assignment,misc]
    1:     RustGibbsModel = None  # type: ignore[assignment,misc]
    1:     RustBoltzmannModel = None  # type: ignore[assignment,misc]
    1:     RustLangevinSampler = None  # type: ignore[assignment,misc]
    1:     RustHMCSampler = None  # type: ignore[assignment,misc]
    1:     RustVerifyPipeline = None  # type: ignore[assignment,misc]
    1:     RustVerificationResult = None  # type: ignore[assignment,misc]
       
    1: __all__ = [
           "RUST_AVAILABLE",
           "RustBoltzmannModel",
           "RustGibbsModel",
           "RustHMCSampler",
           "RustIsingModel",
           "RustLangevinSampler",
           "RustVerificationResult",
