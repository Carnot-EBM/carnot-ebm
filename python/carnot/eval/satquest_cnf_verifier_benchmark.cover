   36:     }[format_name]
   36:     return (
   72:         "Solve this bounded CNF SATQuest verifier case.\n"
   36:         f"Case: {instance.instance_id}\n"
   36:         f"Format: {format_name}\n"
               "Return exactly one JSON object and no prose.\n"
               "Use this schema:\n"
   36:         f"{json.dumps(schema, sort_keys=True)}\n"
               "If SAT, include a full assignment for x1..xN. If UNSAT, assignment may be null.\n"
