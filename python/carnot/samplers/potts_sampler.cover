    1: """Synchronous q-state Potts sampler for validating the KV260 RTL path.
       
       **Researcher summary:**
           Binary Ising sampling only has two states per spin, which matches a
           satisfied/violated constraint view.  The q=3 Potts sampler keeps the same
           sparse graph structure but lets each spin represent correct, partial, or
           violated.  This file is the CPU reference model for
           ``hardware/kv260/potts_sampler_v1.v``: it checks that the update rule has
           sane energy behavior before the RTL is synthesized.
       
       **Detailed explanation for engineers:**
           The Potts energy used here is ``E = -sum_ij J_ij * delta(s_i, s_j)`` with
           integer spins in ``[0, q-1]``.  Positive couplings therefore prefer equal
           states, just as a ferromagnetic Ising coupling prefers aligned spins.  Each
           sweep performs the same two-phase checkerboard schedule as the synchronous
           Ising RTL: all even-indexed spins sample from their conditional
           distribution using the old phase state, then all odd-indexed spins sample
           using the freshly updated even state.
       
       Spec: REQ-POTTS-001, REQ-POTTS-002, REQ-POTTS-003
       """
       
    1: from __future__ import annotations
       
    1: import numpy as np
       
       
    2: class PottsSampler:
    1:     """q=3 Potts machine sampler via synchronous checkerboard update.
       
           State: each spin in {0,1,2}. Energy: E = -sum J_ij * delta(s_i, s_j).
           Update: for spin i, compute E_i(a) for a in {0,1,2}, sample from
           Softmax(-beta * E_i).
       
           Parameters
           ----------
           n_spins:
               Number of Potts variables.
           q:
               Number of states per spin.  The hardware target is q=3, but q=2 is
               kept for boundary checks against an Ising alignment objective.
           beta:
               Inverse temperature.  Higher values make the update greedier toward the
               lowest conditional energy.
           """
       
    1:     def __init__(self, n_spins: int, q: int = 3, beta: float = 2.0):
>>>>>>         if n_spins <= 0:
>>>>>>             raise ValueError("n_spins must be > 0")
>>>>>>         if q < 2:
>>>>>>             raise ValueError("q must be >= 2")
>>>>>>         if beta < 0.0:
>>>>>>             raise ValueError("beta must be >= 0")
       
>>>>>>         self.n_spins = int(n_spins)
>>>>>>         self.q = int(q)
>>>>>>         self.beta = float(beta)
>>>>>>         self._states = np.arange(self.q, dtype=np.int64)
>>>>>>         self._even_indices = np.arange(0, self.n_spins, 2, dtype=np.int64)
>>>>>>         self._odd_indices = np.arange(1, self.n_spins, 2, dtype=np.int64)
       
    5:     def sample(
               self,
    1:         J: np.ndarray,
    2:         n_steps: int = 1000,
    2:         init_state: np.ndarray | None = None,
    1:     ) -> np.ndarray:
               """Run synchronous checkerboard Potts Gibbs sampling.
       
               ``init_state`` is intentionally optional: the public call requested by
               the experiment is ``sample(J, n_steps=...)``, while tests and validation
               can pass an initial state to measure paired energy changes.
       
               Spec: REQ-POTTS-001, REQ-POTTS-002
               """
>>>>>>         if n_steps < 0:
>>>>>>             raise ValueError("n_steps must be >= 0")
>>>>>>         couplings = self._validate_couplings(J)
>>>>>>         spins = self._initial_state(init_state)
       
>>>>>>         for _ in range(n_steps):
>>>>>>             spins = self._checkerboard_sweep(couplings, spins)
>>>>>>         return spins
       
    1:     def energy(self, J: np.ndarray, spins: np.ndarray) -> float:
               """Return ``E = -sum_ij J_ij * delta(s_i, s_j)`` as a Python float.
       
               Self-couplings on the diagonal are ignored because they add no useful
               pairwise constraint information and would be a constant in normal Potts
               graph encodings where ``J[i, i] == 0``.
       
               Spec: REQ-POTTS-002, REQ-POTTS-003
               """
>>>>>>         couplings = self._validate_couplings(J)
>>>>>>         state = self._validate_spins(spins)
>>>>>>         matches = state[:, None] == state[None, :]
>>>>>>         off_diagonal = ~np.eye(self.n_spins, dtype=bool)
>>>>>>         return -float(np.sum(couplings * matches * off_diagonal))
       
    1:     def _initial_state(self, init_state: np.ndarray | None) -> np.ndarray:
               """Create or validate the chain's starting state."""
>>>>>>         if init_state is None:
>>>>>>             return np.random.randint(0, self.q, size=self.n_spins).astype(np.int64)
>>>>>>         return self._validate_spins(init_state).copy()
       
    1:     def _validate_couplings(self, J: np.ndarray) -> np.ndarray:
               """Validate the dense Potts coupling matrix."""
>>>>>>         couplings = np.asarray(J, dtype=np.float64)
>>>>>>         expected = (self.n_spins, self.n_spins)
>>>>>>         if couplings.shape != expected:
>>>>>>             raise ValueError(f"J must have shape {expected}, got {couplings.shape}")
>>>>>>         if not np.all(np.isfinite(couplings)):
>>>>>>             raise ValueError("J must contain only finite values")
>>>>>>         return couplings
       
    1:     def _validate_spins(self, spins: np.ndarray) -> np.ndarray:
               """Validate a Potts spin vector."""
>>>>>>         state = np.asarray(spins, dtype=np.int64)
>>>>>>         if state.shape != (self.n_spins,):
>>>>>>             raise ValueError(f"spins must have shape ({self.n_spins},), got {state.shape}")
>>>>>>         if np.any(state < 0) or np.any(state >= self.q):
>>>>>>             raise ValueError(f"spins must be in [0, {self.q - 1}]")
>>>>>>         return state
       
    1:     def _checkerboard_sweep(self, J: np.ndarray, spins: np.ndarray) -> np.ndarray:
               """One full sweep: even phase followed by odd phase."""
>>>>>>         next_spins = self._update_phase(J, spins, self._even_indices)
>>>>>>         return self._update_phase(J, next_spins, self._odd_indices)
       
    1:     def _update_phase(self, J: np.ndarray, spins: np.ndarray, indices: np.ndarray) -> np.ndarray:
               """Synchronously update one checkerboard phase."""
>>>>>>         updated = spins.copy()
>>>>>>         proposed = []
>>>>>>         for spin_i in indices:
>>>>>>             probs = self._conditional_probabilities(J, spins, int(spin_i))
>>>>>>             proposed.append(self._draw_state(probs))
>>>>>>         updated[indices] = np.asarray(proposed, dtype=np.int64)
>>>>>>         return updated
       
    5:     def _conditional_probabilities(
    3:         self, J: np.ndarray, spins: np.ndarray, spin_i: int
    1:     ) -> np.ndarray:
               """Compute ``softmax(-beta * E_i(a))`` for every state ``a``."""
>>>>>>         row = J[spin_i].copy()
>>>>>>         row[spin_i] = 0.0
>>>>>>         matches = self._states[:, None] == spins[None, :]
>>>>>>         energies = -np.sum(row[None, :] * matches, axis=1)
       
>>>>>>         logits = -self.beta * energies
>>>>>>         logits = logits - np.max(logits)
>>>>>>         weights = np.exp(np.clip(logits, -745.0, 0.0))
>>>>>>         total = float(np.sum(weights))
>>>>>>         if total <= 0.0 or not np.isfinite(total):
>>>>>>             return np.full(self.q, 1.0 / self.q, dtype=np.float64)
>>>>>>         return weights / total
       
    1:     def _draw_state(self, probabilities: np.ndarray) -> int:
               """Draw a categorical state from a normalised probability vector."""
>>>>>>         cumulative = np.cumsum(probabilities)
>>>>>>         threshold = np.random.random()
>>>>>>         idx = int(np.searchsorted(cumulative, threshold, side="right"))
>>>>>>         return min(idx, self.q - 1)
