    1: """CPU compressed lookup-table Bernoulli random-variate sampler.
       
       **Researcher summary:**
           Ising-style samplers repeatedly convert a local field into a Bernoulli
           probability with ``sigmoid(field)`` and then compare that probability to a
           random variate. This module replaces the per-sample exponential with a
           compact fixed-point lookup table. The table is intentionally CPU-only: it
           is useful evidence about the software sampler boundary, not evidence of any
           FPGA, GateMate, KV260, or TSU speedup.
       
       Spec: REQ-SAMPLE-3105, SCENARIO-SAMPLE-3105
       """
       
    1: from __future__ import annotations
       
    1: import math
    1: import time
    1: from dataclasses import dataclass, field
    1: from typing import Any
       
    1: import numpy as np
       
    1: SPEC_REFS = ["REQ-SAMPLE-3105", "SCENARIO-SAMPLE-3105"]
    1: IMPLEMENTATION_PATH = "python/carnot/samplers/clut_random_variate.py"
    1: FPGA_MAPPING_NOTES_PATH = "docs/research-notes/experiment_3105_clut_sampler_fpga_mapping.md"
    1: DEFAULT_N_VARIATES = 65_536
    1: DEFAULT_REPEATS = 5
    1: DEFAULT_SEED = 3105
    1: DEFAULT_LOGIT_MIN = -8.0
    1: DEFAULT_LOGIT_MAX = 8.0
    1: DEFAULT_TABLE_SIZE = 1025
    1: DEFAULT_THRESHOLD_BITS = 15
    1: DEFAULT_N_BINS = 16
       
       
    1: def _as_finite_float_array(values: object, name: str) -> np.ndarray:
>>>>>>     array = np.asarray(values, dtype=np.float64)
>>>>>>     if not np.all(np.isfinite(array)):
>>>>>>         raise ValueError(f"{name} must contain only finite values")
>>>>>>     return array
       
       
    1: def stable_sigmoid(logits: object) -> np.ndarray:
           """Return a numerically stable logistic transform for finite logits.
       
           Why this helper exists: the exact baseline should be boring and auditable.
           Splitting positive and negative inputs avoids overflow warnings while still
           keeping the implementation pure NumPy and easy to compare against the cLUT
           approximation.
       
           Spec: REQ-SAMPLE-3105-2
           """
>>>>>>     values = _as_finite_float_array(logits, "logits")
>>>>>>     result = np.empty_like(values, dtype=np.float64)
>>>>>>     positive = values >= 0.0
>>>>>>     result[positive] = 1.0 / (1.0 + np.exp(-values[positive]))
>>>>>>     exp_values = np.exp(values[~positive])
>>>>>>     result[~positive] = exp_values / (1.0 + exp_values)
>>>>>>     return result
       
       
    1: def _sigmoid_scalar(logit: float) -> float:
>>>>>>     if logit >= 0.0:
>>>>>>         return 1.0 / (1.0 + math.exp(-logit))
>>>>>>     exp_value = math.exp(logit)
>>>>>>     return exp_value / (1.0 + exp_value)
       
       
    3: @dataclass
    2: class ClutLogisticBernoulliSampler:
    1:     """Sample Bernoulli variates from a compressed fixed-point logistic cLUT.
       
           The table stores ``sigmoid(logit)`` as integer thresholds over a bounded
           logit range. Sampling then becomes: clip the logit, find the nearest table
           entry, draw a fixed-width random word, and compare it with the threshold.
           That mirrors the hardware-adjacent primitive Carnot would map to LUTRAM or
           BRAM plus a comparator, while this implementation remains a CPU NumPy
           microbench only.
       
           Spec: REQ-SAMPLE-3105-1
           """
       
    1:     logit_min: float = DEFAULT_LOGIT_MIN
    1:     logit_max: float = DEFAULT_LOGIT_MAX
    1:     table_size: int = DEFAULT_TABLE_SIZE
    1:     threshold_bits: int = DEFAULT_THRESHOLD_BITS
    1:     seed: int = DEFAULT_SEED
    1:     threshold_table: np.ndarray = field(init=False)
    1:     _rng: np.random.Generator = field(init=False, repr=False)
       
    1:     def __post_init__(self) -> None:
>>>>>>         if not np.isfinite(self.logit_min) or not np.isfinite(self.logit_max):
>>>>>>             raise ValueError("logit_min and logit_max must be finite")
>>>>>>         if self.logit_min >= self.logit_max:
>>>>>>             raise ValueError("logit_min must be smaller than logit_max")
>>>>>>         if int(self.table_size) < 2:
>>>>>>             raise ValueError("table_size must be at least 2")
>>>>>>         if int(self.threshold_bits) < 1 or int(self.threshold_bits) > 16:
>>>>>>             raise ValueError("threshold_bits must be in the inclusive range [1, 16]")
       
>>>>>>         self.table_size = int(self.table_size)
>>>>>>         self.threshold_bits = int(self.threshold_bits)
>>>>>>         grid = np.linspace(float(self.logit_min), float(self.logit_max), self.table_size)
>>>>>>         thresholds = np.rint(stable_sigmoid(grid) * float(self.random_modulus)).astype(np.int64)
>>>>>>         thresholds = np.clip(thresholds, 0, self.random_modulus)
>>>>>>         self.threshold_table = thresholds.astype(np.uint16)
>>>>>>         self._rng = np.random.default_rng(int(self.seed))
       
    2:     @property
    2:     def random_modulus(self) -> int:
               """Return the fixed-point denominator used by threshold comparisons."""
>>>>>>         return int(1 << int(self.threshold_bits))
       
    2:     @property
    2:     def table_nbytes(self) -> int:
               """Return the compressed table footprint in bytes."""
>>>>>>         return int(self.threshold_table.nbytes)
       
    1:     def _indices_for_logits(self, logits: object) -> np.ndarray:
>>>>>>         values = _as_finite_float_array(logits, "logits")
>>>>>>         clipped = np.clip(values, float(self.logit_min), float(self.logit_max))
>>>>>>         scale = (self.table_size - 1) / (float(self.logit_max) - float(self.logit_min))
>>>>>>         return np.rint((clipped - float(self.logit_min)) * scale).astype(np.int64)
       
    1:     def thresholds_for_logits(self, logits: object) -> np.ndarray:
               """Return fixed-point thresholds for each supplied logit."""
>>>>>>         return self.threshold_table[self._indices_for_logits(logits)]
       
    1:     def approximate_probabilities(self, logits: object) -> np.ndarray:
               """Return cLUT probabilities represented by the fixed-point thresholds.
       
               Spec: REQ-SAMPLE-3105-2
               """
>>>>>>         thresholds = self.thresholds_for_logits(logits).astype(np.float64)
>>>>>>         return thresholds / float(self.random_modulus)
       
    1:     def table_max_abs_probability_error(self, logits: object) -> float:
               """Measure lookup-table approximation error against exact sigmoid."""
>>>>>>         values = _as_finite_float_array(logits, "logits")
>>>>>>         errors = np.abs(self.approximate_probabilities(values) - stable_sigmoid(values))
>>>>>>         return float(np.max(errors))
       
    1:     def sample_logits(self, logits: object, *, seed: int | None = None) -> np.ndarray:
               """Draw Bernoulli samples for logistic probabilities implied by logits.
       
               Passing ``seed`` creates an independent deterministic draw. Omitting it
               advances the sampler's internal generator, which is useful for repeated
               sampling from the same configured cLUT.
       
               Spec: REQ-SAMPLE-3105-1
               """
>>>>>>         thresholds = self.thresholds_for_logits(logits)
>>>>>>         rng = self._rng if seed is None else np.random.default_rng(int(seed))
>>>>>>         random_words = rng.integers(
>>>>>>             0,
>>>>>>             self.random_modulus,
>>>>>>             size=thresholds.shape,
>>>>>>             dtype=np.uint16,
               )
>>>>>>         return random_words < thresholds
       
       
    1: def exact_logistic_bernoulli_baseline(logits: object, *, seed: int) -> np.ndarray:
           """Draw Bernoulli samples by evaluating the exact logistic per variate.
       
           Why this is scalar: the benchmark needs a simple baseline sampler, not a
           tuned NumPy ufunc contest. The cLUT speed number is therefore scoped to a
           scalar exact-logistic CPU baseline and is not a hardware claim.
       
           Spec: REQ-SAMPLE-3105-2
           """
>>>>>>     values = _as_finite_float_array(logits, "logits")
>>>>>>     rng = np.random.default_rng(int(seed))
>>>>>>     samples = np.empty(values.shape, dtype=np.bool_)
>>>>>>     flat_samples = samples.reshape(-1)
>>>>>>     for index, logit in enumerate(values.reshape(-1)):
>>>>>>         flat_samples[index] = rng.random() < _sigmoid_scalar(float(logit))
>>>>>>     return samples
       
       
    2: def distribution_error_report(
           *,
>>>>>>     samples: object,
>>>>>>     expected_probabilities: object,
>>>>>>     logits: object,
    1:     n_bins: int = DEFAULT_N_BINS,
>>>>>> ) -> dict[str, Any]:
           """Compare Bernoulli sample frequencies against expected probabilities.
       
           The report bins by local-field logit because a sampler can have the right
           global mean while being biased in cold or hot field regions. That per-bin
           view is the narrow quality check needed before treating cLUT variates as a
           candidate primitive for Ising-style sampler paths.
       
           Spec: REQ-SAMPLE-3105-2
           """
>>>>>>     sample_array = np.asarray(samples, dtype=np.bool_)
>>>>>>     expected = _as_finite_float_array(expected_probabilities, "expected_probabilities")
>>>>>>     logit_array = _as_finite_float_array(logits, "logits")
>>>>>>     if sample_array.shape != expected.shape or sample_array.shape != logit_array.shape:
>>>>>>         raise ValueError("samples, expected_probabilities, and logits must have the same shape")
>>>>>>     if sample_array.size == 0:
>>>>>>         raise ValueError("samples must be non-empty")
       
>>>>>>     n_bins = max(1, int(n_bins))
>>>>>>     edges = np.linspace(float(np.min(logit_array)), float(np.max(logit_array)), n_bins + 1)
>>>>>>     bin_ids = np.digitize(logit_array, edges[1:-1], right=False)
>>>>>>     sample_float = sample_array.astype(np.float64)
>>>>>>     bins: list[dict[str, float | int]] = []
>>>>>>     abs_errors: list[float] = []
       
>>>>>>     for bin_index in np.unique(bin_ids):
>>>>>>         mask = bin_ids == bin_index
>>>>>>         empirical = float(np.mean(sample_float[mask]))
>>>>>>         expected_mean = float(np.mean(expected[mask]))
>>>>>>         abs_error = abs(empirical - expected_mean)
>>>>>>         abs_errors.append(abs_error)
>>>>>>         bins.append(
>>>>>>             {
>>>>>>                 "bin_index": int(bin_index),
>>>>>>                 "count": int(np.count_nonzero(mask)),
>>>>>>                 "logit_min": float(np.min(logit_array[mask])),
>>>>>>                 "logit_max": float(np.max(logit_array[mask])),
>>>>>>                 "empirical_probability": empirical,
>>>>>>                 "expected_probability": expected_mean,
>>>>>>                 "abs_error": float(abs_error),
                   }
               )
       
>>>>>>     overall_empirical = float(np.mean(sample_float))
>>>>>>     overall_expected = float(np.mean(expected))
>>>>>>     return {
>>>>>>         "n_samples": int(sample_array.size),
>>>>>>         "n_bins": int(n_bins),
>>>>>>         "overall_empirical_probability": overall_empirical,
>>>>>>         "overall_expected_probability": overall_expected,
>>>>>>         "overall_abs_error": float(abs(overall_empirical - overall_expected)),
>>>>>>         "max_abs_bin_error": float(max(abs_errors)),
>>>>>>         "mean_abs_bin_error": float(np.mean(abs_errors)),
>>>>>>         "bins": bins,
           }
       
       
    1: def _generate_ising_style_logits(n_variates: int, seed: int) -> np.ndarray:
>>>>>>     rng = np.random.default_rng(int(seed))
>>>>>>     spin_a = rng.choice(np.array([-1.0, 1.0]), size=int(n_variates))
>>>>>>     spin_b = rng.choice(np.array([-1.0, 1.0]), size=int(n_variates))
>>>>>>     noise = rng.normal(loc=0.0, scale=1.1, size=int(n_variates))
>>>>>>     fields = (1.15 * spin_a) + (0.55 * spin_b) + noise
>>>>>>     return np.clip(fields, -6.0, 6.0).astype(np.float64)
       
       
    1: def _timed_sampler(callable_sampler: Any, *, repeats: int) -> dict[str, float | int]:
>>>>>>     durations: list[float] = []
>>>>>>     checksum = 0
>>>>>>     for repeat_index in range(int(repeats)):
>>>>>>         started = time.perf_counter_ns()
>>>>>>         samples = callable_sampler(repeat_index)
>>>>>>         durations.append((time.perf_counter_ns() - started) / 1_000_000_000.0)
>>>>>>         checksum += int(np.count_nonzero(samples)) + repeat_index
>>>>>>     return {
>>>>>>         "median_s": float(np.median(durations)),
>>>>>>         "min_s": float(np.min(durations)),
>>>>>>         "max_s": float(np.max(durations)),
>>>>>>         "checksum": int(checksum),
           }
       
       
    4: def run_clut_microbench(
           *,
    1:     n_variates: int = DEFAULT_N_VARIATES,
    1:     repeats: int = DEFAULT_REPEATS,
    1:     seed: int = DEFAULT_SEED,
>>>>>> ) -> dict[str, Any]:
           """Run the CPU cLUT microbench and return artifact-ready fields.
       
           Spec: REQ-SAMPLE-3105-3, REQ-SAMPLE-3105-4, SCENARIO-SAMPLE-3105
           """
>>>>>>     n_variates = max(1, int(n_variates))
>>>>>>     repeats = max(1, int(repeats))
>>>>>>     logits = _generate_ising_style_logits(n_variates, seed)
>>>>>>     expected = stable_sigmoid(logits)
>>>>>>     sampler = ClutLogisticBernoulliSampler(seed=seed)
       
>>>>>>     clut_samples = sampler.sample_logits(logits, seed=seed + 1)
>>>>>>     baseline_samples = exact_logistic_bernoulli_baseline(logits, seed=seed + 2)
>>>>>>     clut_probabilities = sampler.approximate_probabilities(logits)
>>>>>>     table_abs_errors = np.abs(clut_probabilities - expected)
       
>>>>>>     clut_error = distribution_error_report(
>>>>>>         samples=clut_samples,
>>>>>>         expected_probabilities=expected,
>>>>>>         logits=logits,
>>>>>>         n_bins=DEFAULT_N_BINS,
           )
>>>>>>     baseline_error = distribution_error_report(
>>>>>>         samples=baseline_samples,
>>>>>>         expected_probabilities=expected,
>>>>>>         logits=logits,
>>>>>>         n_bins=DEFAULT_N_BINS,
           )
       
>>>>>>     clut_timing = _timed_sampler(
>>>>>>         lambda repeat: sampler.sample_logits(logits, seed=seed + 100 + repeat),
>>>>>>         repeats=repeats,
           )
>>>>>>     baseline_timing = _timed_sampler(
>>>>>>         lambda repeat: exact_logistic_bernoulli_baseline(logits, seed=seed + 200 + repeat),
>>>>>>         repeats=repeats,
           )
>>>>>>     speedup_ratio = float(baseline_timing["median_s"] / max(float(clut_timing["median_s"]), 1e-12))
>>>>>>     error_thresholds = {
>>>>>>         "clut_table_max_abs_probability_error": 0.004,
>>>>>>         "clut_empirical_max_abs_bin_error": 0.06,
           }
>>>>>>     distribution_error_gate_passed = bool(
>>>>>>         float(np.max(table_abs_errors)) <= error_thresholds["clut_table_max_abs_probability_error"]
>>>>>>         and float(clut_error["max_abs_bin_error"])
>>>>>>         <= error_thresholds["clut_empirical_max_abs_bin_error"]
           )
       
>>>>>>     return {
>>>>>>         "spec_refs": SPEC_REFS,
>>>>>>         "clut_microbench_ready": distribution_error_gate_passed,
>>>>>>         "implementation_path": IMPLEMENTATION_PATH,
>>>>>>         "benchmark_commands": [
