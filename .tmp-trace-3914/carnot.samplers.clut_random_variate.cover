>>>>>>             "clut_table_max_abs_probability_error": float(np.max(table_abs_errors)),
>>>>>>             "clut_table_mean_abs_probability_error": float(np.mean(table_abs_errors)),
>>>>>>             "clut_empirical": clut_error,
>>>>>>             "baseline_empirical": baseline_error,
>>>>>>             "thresholds": error_thresholds,
