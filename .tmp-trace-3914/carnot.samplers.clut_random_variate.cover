>>>>>>             "baseline_samples_per_second": float(n_variates / float(baseline_timing["median_s"])),
>>>>>>             "clut_samples_per_second": float(n_variates / float(clut_timing["median_s"])),
>>>>>>             "speedup_ratio": speedup_ratio,
