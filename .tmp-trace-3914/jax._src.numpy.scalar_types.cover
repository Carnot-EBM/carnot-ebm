       # At present JAX doesn't have a reason to distinguish between scalars and arrays
       # in its object system. Further, we want JAX scalars to have the same type
       # promotion behaviors as JAX arrays. Rather than introducing a new type of JAX
       # scalar object with JAX promotion behaviors, instead we make the JAX scalar
       # types return JAX arrays when instantiated.
       
    1: from typing import Any
       
    1: import numpy as np
       
    1: from jax._src.typing import Array
    1: from jax._src import core
    1: from jax._src import dtypes
    1: from jax._src.numpy.array_constructors import asarray
       
       
       # Some objects below rewrite their __module__ attribute to this name.
    1: _PUBLIC_MODULE_NAME = "jax.numpy"
       
       
    3: class _ScalarMeta(type):
>>>>>>   dtype: np.dtype
       
    2:   @property
    2:   def __numpy_dtype__(self) -> np.dtype:
           # __numpy_dtype__ protocol added in NumPy v2.4.0.
>>>>>>     return self.dtype
       
    1:   def __hash__(self) -> int:
   30:     return hash(self.dtype.type)
       
    1:   def __eq__(self, other: Any) -> bool:
   15:     return self is other or self.dtype.type == other
       
    1:   def __ne__(self, other: Any) -> bool:
>>>>>>     return not (self == other)
       
    1:   def __call__(self, x: Any) -> Array:
>>>>>>     return asarray(x, dtype=self.dtype)
       
    1:   def __instancecheck__(self, instance: Any) -> bool:
>>>>>>     return isinstance(instance, self.dtype.type)
       
    1: def _abstractify_scalar_meta(x):
>>>>>>   raise TypeError(f"JAX scalar type {x} cannot be interpreted as a JAX array.")
    1: core.pytype_aval_mappings[_ScalarMeta] = _abstractify_scalar_meta
       
    1: def _make_scalar_type(np_scalar_type: type) -> _ScalarMeta:
   56:   meta = _ScalarMeta(np_scalar_type.__name__, (object,),
   28:                      {"dtype": np.dtype(np_scalar_type)})
   28:   meta.__module__ = _PUBLIC_MODULE_NAME
   28:   meta.__doc__ =\
   28:   f"""A JAX scalar constructor of type {np_scalar_type.__name__}.
       
         While NumPy defines scalar types for each data type, JAX represents
         scalars as zero-dimensional arrays.
         """
   28:   return meta
       
