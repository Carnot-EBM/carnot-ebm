>>>>>>         elif isinstance(t, TerminalNode):
>>>>>>             listener.visitTerminal(t)
>>>>>>             return
>>>>>>         self.enterRule(listener, t)
>>>>>>         for child in t.getChildren():
>>>>>>             self.walk(listener, child)
>>>>>>         self.exitRule(listener, t)
       
