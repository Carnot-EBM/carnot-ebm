    1:     def __init__(self, max_size: int):
    1:         super().__init__(max_size)
    1:         self.__tick: int = 0
       
    1:     def tick(self) -> int:
    2:         self.__tick += 1
    2:         return self.__tick
       
    1:     def new_entry(self, key: K, value: V) -> Any:
    1:         return (1, self.tick())
       
    1:     def on_access(self, key: K, value: V, score: Any) -> Any:
    1:         return (2, self.tick())
       
       
    2: class LRUCache(Generic[K, V]):
