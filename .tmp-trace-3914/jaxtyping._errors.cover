    2: class TypeCheckError(TypeError):
    1:     pass
       
       
       # Not inheriting from TypeError as that gets caught and re-reraised as just a TypeError
       # when using typeguard<3.
    2: class AnnotationError(Exception):
    1:     pass
       
       
    1: TypeCheckError.__module__ = "jaxtyping"
    1: AnnotationError.__module__ = "jaxtyping"
