>>>>>>     gen_inst = gen(*args, **kwargs)
>>>>>>     args_, kwargs_ = next(gen_inst)
>>>>>>     return gen_inst.send(f(*args_, **kwargs_))
>>>>>>   return transformation2(gen2, fun, *gen_static_args)()
       
