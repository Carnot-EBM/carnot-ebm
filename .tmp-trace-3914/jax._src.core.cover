>>>>>>   if s.stop is None:
>>>>>>     stop = axis_size if step_gt_0 else -1
         else:
>>>>>>     stop = clamp_index(convert_to_index(s.stop), "stop")
       
>>>>>>   gap = step if step_gt_0 else - step
