>>>>>>     return ShapedArray((*aval.shape, *elt_aval.shape), elt_aval.dtype,
>>>>>>                        sharding=physical_sharding(aval, aval.sharding),
>>>>>>                        manual_axis_type=aval.mat)
>>>>>>   return aval
       
