>>>>>>     unreduced = frozenset(u for u in mat.unreduced if mesh.shape[u] != 1)
>>>>>>     reduced = frozenset(r for r in mat.reduced if mesh.shape[r] != 1)
>>>>>>     return mat.update(varying=varying, unreduced=unreduced, reduced=reduced)
>>>>>>   return mat
       
       
