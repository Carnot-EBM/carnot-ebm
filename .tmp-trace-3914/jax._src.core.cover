    6: def pp_toplevel_jaxpr(jaxpr_to_print: Jaxpr, *,
    1:                       source_info: bool = False,
    1:                       print_shapes: bool = True,
    1:                       custom_pp_eqn_rules : bool = True,
    1:                       name_stack: bool = False,
