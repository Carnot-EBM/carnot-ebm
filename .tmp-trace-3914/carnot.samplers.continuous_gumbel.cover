       simulates probabilistic hardware sampling, and the chosen move updates the
       continuous state.
       
       Spec: REQ-SAMPLE-2044
       """
       
    1: from __future__ import annotations
       
    1: from dataclasses import dataclass
    1: from typing import TYPE_CHECKING
       
    1: import jax
    1: import jax.numpy as jnp
    1: import jax.random as jrandom
       
    1: if TYPE_CHECKING:
>>>>>>     from carnot.core.energy import EnergyFunction
       
       
    3: @dataclass
    2: class ContinuousGumbelSampler:
    1:     """Gumbel-perturbed categorical mover for continuous energy landscapes.
       
           ``move_values`` are relative category values multiplied by ``step_size``.
           With the default ``(-1, 0, 1)`` support, each coordinate can move down, stay
           fixed, or move up. The sampler scores each move with a local quadratic
           approximation to the energy change and then applies Gumbel-Max (hard mode)
           or Gumbel-Softmax (relaxed mode).
       
           Spec: REQ-SAMPLE-2044
           """
       
    1:     step_size: float = 0.1
    1:     move_values: tuple[float, ...] = (-1.0, 0.0, 1.0)
    1:     energy_temperature: float = 0.05
    1:     softmax_temperature: float = 0.5
    1:     gumbel_scale: float = 1.0
    1:     hard: bool = True
    1:     anneal_rate: float = 1.0
    1:     curvature: float = 1.0
    1:     clip_norm: float | None = None
       
    1:     def _clip_gradient(self, grad: jax.Array) -> jax.Array:
               """Bound gradient norm while preserving direction."""
>>>>>>         if self.clip_norm is None:
>>>>>>             return grad
>>>>>>         norm = jnp.linalg.norm(grad)
>>>>>>         safe_norm = jnp.maximum(norm, jnp.asarray(1e-12, dtype=grad.dtype))
>>>>>>         clipped = grad * (self.clip_norm / safe_norm)
>>>>>>         return jnp.where(norm > self.clip_norm, clipped, grad)
       
    1:     def _move_values_for_step(self, step_index: jax.Array) -> jax.Array:
               """Return the annealed continuous move support for one step."""
>>>>>>         scale = self.step_size * (self.anneal_rate**step_index)
>>>>>>         return jnp.asarray(self.move_values, dtype=jnp.float32) * scale
       
    1:     def _gumbel_noise(self, key: jax.Array, shape: tuple[int, ...]) -> jax.Array:
               """Draw numerically stable Gumbel noise for categorical perturbations."""
>>>>>>         if self.gumbel_scale == 0.0:
>>>>>>             return jnp.zeros(shape, dtype=jnp.float32)
>>>>>>         eps = jnp.asarray(1e-6, dtype=jnp.float32)
>>>>>>         uniform = jrandom.uniform(key, shape, minval=eps, maxval=1.0 - eps)
>>>>>>         return -jnp.log(-jnp.log(uniform)) * self.gumbel_scale
       
    1:     def _categorical_delta(
               self,
>>>>>>         grad: jax.Array,
>>>>>>         key: jax.Array,
>>>>>>         step_index: jax.Array,
>>>>>>     ) -> jax.Array:
               """Convert an energy gradient into one Gumbel-sampled continuous move."""
>>>>>>         grad = self._clip_gradient(grad)
>>>>>>         moves = self._move_values_for_step(step_index)
>>>>>>         delta_energy = grad[..., None] * moves + 0.5 * self.curvature * (moves**2)
>>>>>>         logits = -delta_energy / self.energy_temperature
>>>>>>         perturbed = logits + self._gumbel_noise(key, logits.shape)
       
>>>>>>         if self.hard:
>>>>>>             selected = jnp.argmax(perturbed, axis=-1)
>>>>>>             return jnp.take(moves, selected)
       
>>>>>>         weights = jax.nn.softmax(perturbed / self.softmax_temperature, axis=-1)
>>>>>>         return jnp.sum(weights * moves, axis=-1)
       
    1:     def _run(
               self,
>>>>>>         energy_fn: EnergyFunction,
>>>>>>         init: jax.Array,
>>>>>>         n_steps: int,
>>>>>>         key: jax.Array | None,
>>>>>>     ) -> tuple[jax.Array, jax.Array]:
               """Run the chain and return both final state and all intermediate states."""
>>>>>>         if n_steps < 0:
>>>>>>             raise ValueError("n_steps must be non-negative.")
>>>>>>         if key is None:
>>>>>>             key = jrandom.PRNGKey(0)
       
>>>>>>         def step(
>>>>>>             carry: tuple[jax.Array, jax.Array],
>>>>>>             step_index: jax.Array,
>>>>>>         ) -> tuple[tuple[jax.Array, jax.Array], jax.Array]:
>>>>>>             x, current_key = carry
>>>>>>             current_key, subkey = jrandom.split(current_key)
>>>>>>             delta = self._categorical_delta(energy_fn.grad_energy(x), subkey, step_index)
>>>>>>             x_new = x + delta
>>>>>>             return (x_new, current_key), x_new
       
>>>>>>         (x_final, _), chain = jax.lax.scan(step, (init, key), jnp.arange(n_steps))
>>>>>>         return x_final, chain
       
    1:     def sample(
               self,
>>>>>>         energy_fn: EnergyFunction,
>>>>>>         init: jax.Array,
>>>>>>         n_steps: int,
>>>>>>         key: jax.Array | None = None,
>>>>>>     ) -> jax.Array:
               """Run Gumbel sampling and return only the final continuous state.
       
