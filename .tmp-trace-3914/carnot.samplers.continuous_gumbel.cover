               """
>>>>>>         x_final, _ = self._run(energy_fn, init, n_steps, key)
>>>>>>         return x_final
       
    1:     def sample_chain(
               self,
>>>>>>         energy_fn: EnergyFunction,
>>>>>>         init: jax.Array,
>>>>>>         n_steps: int,
>>>>>>         key: jax.Array | None = None,
>>>>>>     ) -> jax.Array:
               """Run Gumbel sampling and return every intermediate state.
       
               Spec: REQ-SAMPLE-2044-3
