    1: """This package is used to define and parse command line flags.
       
       This package defines a *distributed* flag-definition policy: rather than
       an application having to define all flags in or near main(), each Python
       module defines flags that are useful to it.  When one Python module
       imports another, it gains access to the other's flags.  (This is
       implemented by having all modules share a common, global registry object
       containing all the flag information.)
       
       Flags are defined through the use of one of the DEFINE_xxx functions.
       The specific function used determines how the flag is parsed, checked,
       and optionally type-converted, when it's seen on the command line.
       """
       
    1: import sys
       
    1: from absl.flags import _argument_parser
    1: from absl.flags import _defines
    1: from absl.flags import _exceptions
    1: from absl.flags import _flag
    1: from absl.flags import _flagvalues
    1: from absl.flags import _helpers
    1: from absl.flags import _validators
       
    1: __all__ = (
           'DEFINE',
           'DEFINE_flag',
           'DEFINE_string',
           'DEFINE_boolean',
           'DEFINE_bool',
           'DEFINE_float',
           'DEFINE_integer',
           'DEFINE_enum',
           'DEFINE_enum_class',
           'DEFINE_list',
           'DEFINE_spaceseplist',
           'DEFINE_multi',
           'DEFINE_multi_string',
           'DEFINE_multi_integer',
           'DEFINE_multi_float',
           'DEFINE_multi_enum',
           'DEFINE_multi_enum_class',
           'DEFINE_alias',
           # Flag validators.
           'register_validator',
           'validator',
           'register_multi_flags_validator',
           'multi_flags_validator',
           'mark_flag_as_required',
           'mark_flags_as_required',
           'mark_flags_as_mutual_exclusive',
           'mark_bool_flags_as_mutual_exclusive',
           # Flag modifiers.
           'set_default',
           'override_value',
           # Key flag related functions.
           'declare_key_flag',
           'adopt_module_key_flags',
           'disclaim_key_flags',
           # Module exceptions.
           'Error',
           'CantOpenFlagFileError',
           'DuplicateFlagError',
           'IllegalFlagValueError',
           'UnrecognizedFlagError',
           'UnparsedFlagAccessError',
           'ValidationError',
           'FlagNameConflictsWithMethodError',
           # Public classes.
           'Flag',
           'BooleanFlag',
           'EnumFlag',
           'EnumClassFlag',
           'MultiFlag',
           'MultiEnumClassFlag',
           'FlagHolder',
           'FlagValues',
           'ArgumentParser',
           'BooleanParser',
           'EnumParser',
           'EnumClassParser',
           'ArgumentSerializer',
           'FloatParser',
           'IntegerParser',
           'BaseListParser',
           'ListParser',
           'ListSerializer',
           'EnumClassListSerializer',
           'CsvListSerializer',
           'WhitespaceSeparatedListParser',
           'EnumClassSerializer',
           # Helper functions.
           'get_help_width',
           'text_wrap',
           'flag_dict_to_args',
           'doc_to_help',
           # The global FlagValues instance.
           'FLAGS',
       )
       
       # Initialize the FLAGS_MODULE as early as possible.
       # It's only used by adopt_module_key_flags to take SPECIAL_FLAGS into account.
    1: _helpers.FLAGS_MODULE = sys.modules[__name__]
       
       # Add current module to disclaimed module ids.
    1: _helpers.disclaim_module_ids.add(id(sys.modules[__name__]))
       
       # DEFINE functions. They are explained in more details in the module doc string.
       # pylint: disable=invalid-name
    1: DEFINE = _defines.DEFINE
    1: DEFINE_flag = _defines.DEFINE_flag
    1: DEFINE_string = _defines.DEFINE_string
    1: DEFINE_boolean = _defines.DEFINE_boolean
    1: DEFINE_bool = DEFINE_boolean  # Match C++ API.
    1: DEFINE_float = _defines.DEFINE_float
    1: DEFINE_integer = _defines.DEFINE_integer
    1: DEFINE_enum = _defines.DEFINE_enum
    1: DEFINE_enum_class = _defines.DEFINE_enum_class
    1: DEFINE_list = _defines.DEFINE_list
    1: DEFINE_spaceseplist = _defines.DEFINE_spaceseplist
    1: DEFINE_multi = _defines.DEFINE_multi
    1: DEFINE_multi_string = _defines.DEFINE_multi_string
    1: DEFINE_multi_integer = _defines.DEFINE_multi_integer
    1: DEFINE_multi_float = _defines.DEFINE_multi_float
    1: DEFINE_multi_enum = _defines.DEFINE_multi_enum
    1: DEFINE_multi_enum_class = _defines.DEFINE_multi_enum_class
    1: DEFINE_alias = _defines.DEFINE_alias
       # pylint: enable=invalid-name
       
       # Flag validators.
    1: register_validator = _validators.register_validator
    1: validator = _validators.validator
    1: register_multi_flags_validator = _validators.register_multi_flags_validator
    1: multi_flags_validator = _validators.multi_flags_validator
    1: mark_flag_as_required = _validators.mark_flag_as_required
    1: mark_flags_as_required = _validators.mark_flags_as_required
    1: mark_flags_as_mutual_exclusive = _validators.mark_flags_as_mutual_exclusive
    1: mark_bool_flags_as_mutual_exclusive = _validators.mark_bool_flags_as_mutual_exclusive
       
       # Flag modifiers.
    1: set_default = _defines.set_default
    1: override_value = _defines.override_value
       
       # Key flag related functions.
    1: declare_key_flag = _defines.declare_key_flag
    1: adopt_module_key_flags = _defines.adopt_module_key_flags
    1: disclaim_key_flags = _defines.disclaim_key_flags
       
       # Module exceptions.
       # pylint: disable=invalid-name
    1: Error = _exceptions.Error
    1: CantOpenFlagFileError = _exceptions.CantOpenFlagFileError
    1: DuplicateFlagError = _exceptions.DuplicateFlagError
    1: IllegalFlagValueError = _exceptions.IllegalFlagValueError
    1: UnrecognizedFlagError = _exceptions.UnrecognizedFlagError
    1: UnparsedFlagAccessError = _exceptions.UnparsedFlagAccessError
    1: ValidationError = _exceptions.ValidationError
    1: FlagNameConflictsWithMethodError = _exceptions.FlagNameConflictsWithMethodError
       
       # Public classes.
    1: Flag = _flag.Flag
    1: BooleanFlag = _flag.BooleanFlag
    1: EnumFlag = _flag.EnumFlag
    1: EnumClassFlag = _flag.EnumClassFlag
    1: MultiFlag = _flag.MultiFlag
    1: MultiEnumClassFlag = _flag.MultiEnumClassFlag
    1: FlagHolder = _flagvalues.FlagHolder
    1: FlagValues = _flagvalues.FlagValues
    1: ArgumentParser = _argument_parser.ArgumentParser
    1: BooleanParser = _argument_parser.BooleanParser
    1: EnumParser = _argument_parser.EnumParser
    1: EnumClassParser = _argument_parser.EnumClassParser
    1: ArgumentSerializer = _argument_parser.ArgumentSerializer
    1: FloatParser = _argument_parser.FloatParser
    1: IntegerParser = _argument_parser.IntegerParser
    1: BaseListParser = _argument_parser.BaseListParser
    1: ListParser = _argument_parser.ListParser
    1: ListSerializer = _argument_parser.ListSerializer
    1: EnumClassListSerializer = _argument_parser.EnumClassListSerializer
    1: CsvListSerializer = _argument_parser.CsvListSerializer
    1: WhitespaceSeparatedListParser = _argument_parser.WhitespaceSeparatedListParser
    1: EnumClassSerializer = _argument_parser.EnumClassSerializer
       # pylint: enable=invalid-name
       
       # Helper functions.
    1: get_help_width = _helpers.get_help_width
    1: text_wrap = _helpers.text_wrap
    1: flag_dict_to_args = _helpers.flag_dict_to_args
    1: doc_to_help = _helpers.doc_to_help
       
       # Special flags.
    1: _helpers.SPECIAL_FLAGS = FlagValues()
       
    2: DEFINE_string(
    1:     'flagfile', '',
    1:     'Insert flag definitions from the given file into the command line.',
    1:     _helpers.SPECIAL_FLAGS)  # pytype: disable=wrong-arg-types
       
    2: DEFINE_string('undefok', '',
    1:               'comma-separated list of flag names that it is okay to specify '
                     'on the command line even if the program does not define a flag '
                     'with that name.  IMPORTANT: flags in this list that have '
                     'arguments MUST use the --flag=value format.',
    1:               _helpers.SPECIAL_FLAGS)  # pytype: disable=wrong-arg-types
       
       #: The global FlagValues instance.
    1: FLAGS = _flagvalues.FLAGS
