    1: from typing import Any, TypeVar
    1: from collections.abc import Iterator, Mapping
       
    1: K = TypeVar("K")
    1: V = TypeVar("V")
       
       
    2: class FrozenDict(Mapping[K, V]):
       
    1:   def __init__(self, d: Mapping[K, V]):
    2:     self._d = dict(d.items())
       
    1:   def __repr__(self) -> str:
>>>>>>     return f"FrozenDict({self._d!r})"
       
    1:   def __str__(self) -> str:
>>>>>>     return f"FrozenDict({self._d})"
       
    1:   def __getitem__(self, key: K) -> V:
>>>>>>     return self._d[key]
       
    1:   def __hash__(self) -> int:
           # This assumes that the values are hashable.
    1:     return hash(frozenset(self._d.items()))
       
    1:   def __eq__(self, other: Any) -> bool:
>>>>>>     if not isinstance(other, FrozenDict):
>>>>>>       return False
>>>>>>     return self._d == other._d
       
    1:   def __iter__(self) -> Iterator[K]:
>>>>>>     return iter(self._d)
       
    1:   def __len__(self) -> int:
>>>>>>     return len(self._d)
       
    1:   def get(self, key: K) -> V | None:  # pyrefly: ignore[bad-override]
>>>>>>     return self._d.get(key, None)
