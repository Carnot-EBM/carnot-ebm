>>>>>>     if full_backtrace:
>>>>>>         ex.__cause__ = cause
           else:
>>>>>>         ex.__cause__ = None
>>>>>>     raise ex.with_traceback(sys.exc_info()[2])  # set env var OC_CAUSE=1 for full trace
       
       
