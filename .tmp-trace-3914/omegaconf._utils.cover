>>>>>>             hasattr(t, "__module__")
>>>>>>             and t.__module__ != "builtins"
>>>>>>             and t.__module__ != "typing"
>>>>>>             and not t.__module__.startswith("omegaconf.")
               ):
>>>>>>             module_prefix = str(t.__module__) + "."
               else:
>>>>>>             module_prefix = ""
>>>>>>         ret = module_prefix + ret
>>>>>>     if is_optional:
>>>>>>         return f"Optional[{ret}]"
           else:
>>>>>>         return ret
       
       
