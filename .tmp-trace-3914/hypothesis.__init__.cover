    1: """Hypothesis is a library for writing unit tests which are parametrized by
       some source of data.
       
       It verifies your code against a wide range of input and minimizes any
       failing examples it finds.
       """
       
    1: import _hypothesis_globals
       
    1: from hypothesis._settings import HealthCheck, Phase, Verbosity, settings
    1: from hypothesis.control import (
           assume,
           currently_in_test_context,
           event,
           note,
           reject,
           target,
       )
    1: from hypothesis.core import example, find, given, reproduce_failure, seed
    1: from hypothesis.entry_points import run
    1: from hypothesis.internal.detection import is_hypothesis_test
    1: from hypothesis.internal.entropy import register_random
    1: from hypothesis.utils.conventions import infer
    1: from hypothesis.version import __version__, __version_info__
       
    1: __all__ = [
           "HealthCheck",
           "Phase",
           "Verbosity",
           "__version__",
           "__version_info__",
           "assume",
           "currently_in_test_context",
           "event",
           "example",
           "find",
           "given",
           "infer",
           "is_hypothesis_test",
           "note",
           "register_random",
           "reject",
           "reproduce_failure",
           "seed",
           "settings",
           "target",
       ]
       
    1: run()
    1: del run
       
    1: _hypothesis_globals.in_initialization -= 1
    1: del _hypothesis_globals
