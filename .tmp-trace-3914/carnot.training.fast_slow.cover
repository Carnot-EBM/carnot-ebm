>>>>>>         return cls(
>>>>>>             iteration=iteration,
>>>>>>             verified=bool(getattr(verification_result, "verified", False)),
>>>>>>             energy=float(getattr(verification_result, "energy", 0.0)),
>>>>>>             violation_count=len(violations),
>>>>>>             lines=tuple(lines),
