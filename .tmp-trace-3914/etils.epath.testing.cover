    3: @dataclasses.dataclass(eq=False)
    2: class _MockBackend(_backend_cls):
    1:   """Backend with functions overwritten."""
       
    1:   mock_fns: dict[str, _MockFn]
       
    1:   def _get_fn(self, fn_name):
