    1: from collections.abc import Callable, Iterator
       
    1: type Callback = Callable[[], object]
    1: type SimpleContextManager = Iterator[None]
    1: type KeySpec = str  # like r"\C-c"
    1: type CommandName = str  # like "interrupt"
    1: type EventTuple = tuple[CommandName, str]
    1: type Completer = Callable[[str, int], str | None]
    1: type CharBuffer = list[str]
    1: type CharWidths = list[int]
