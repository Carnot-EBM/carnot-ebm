>>>>>>         return None
       
    1:     def _new_sampler(self, seed: int) -> ClutLogisticBernoulliSampler:
>>>>>>         return ClutLogisticBernoulliSampler(
>>>>>>             logit_min=self.logit_min,
>>>>>>             logit_max=self.logit_max,
>>>>>>             table_size=self.table_size,
>>>>>>             threshold_bits=self.threshold_bits,
>>>>>>             seed=seed,
               )
       
    2:     @staticmethod
    2:     def _coerce_ising_inputs(biases: object, couplings: object) -> tuple[np.ndarray, np.ndarray]:
>>>>>>         bias_vector = np.asarray(biases, dtype=np.float64)
>>>>>>         coupling_matrix = np.asarray(couplings, dtype=np.float64)
>>>>>>         if bias_vector.ndim != 1:
>>>>>>             raise ValueError("biases must be a one-dimensional finite array")
>>>>>>         if coupling_matrix.shape != (bias_vector.size, bias_vector.size):
>>>>>>             raise ValueError("couplings must have shape (n_spins, n_spins)")
>>>>>>         if not np.all(np.isfinite(bias_vector)):
>>>>>>             raise ValueError("biases must contain only finite values")
>>>>>>         if not np.all(np.isfinite(coupling_matrix)):
>>>>>>             raise ValueError("couplings must contain only finite values")
>>>>>>         return bias_vector, coupling_matrix
       
       
    3: def clut_backend_distribution_check(
           *,
    1:     n_samples: int = DEFAULT_DISTRIBUTION_SAMPLES,
    1:     seed: int = DEFAULT_CLUT_BACKEND_SEED,
>>>>>> ) -> dict[str, Any]:
           """Measure zero-coupling Bernoulli distribution error for the cLUT backend."""
>>>>>>     biases = np.array([-2.0, 0.0, 2.0], dtype=np.float64)
>>>>>>     couplings = np.zeros((biases.size, biases.size), dtype=np.float64)
>>>>>>     samples = ClutCpuBackend(seed=seed).sample(
>>>>>>         biases,
>>>>>>         couplings,
>>>>>>         n_samples=max(1, int(n_samples)),
>>>>>>         config={"beta": 1.0, "steps_per_sample": 1, "seed": seed},
           )
>>>>>>     logits = np.broadcast_to(biases, samples.shape)
>>>>>>     expected = stable_sigmoid(logits)
>>>>>>     error = distribution_error_report(
>>>>>>         samples=samples,
>>>>>>         expected_probabilities=expected,
>>>>>>         logits=logits,
>>>>>>         n_bins=3,
           )
>>>>>>     passed = bool(
>>>>>>         error["max_abs_bin_error"] <= CLUT_BACKEND_DISTRIBUTION_THRESHOLDS["max_abs_bin_error"]
>>>>>>         and error["overall_abs_error"]
>>>>>>         <= CLUT_BACKEND_DISTRIBUTION_THRESHOLDS["overall_abs_error"]
           )
>>>>>>     return {
>>>>>>         "distribution_checks_passed": passed,
>>>>>>         "n_samples_per_spin": int(samples.shape[0]),
>>>>>>         "random_seed": int(seed),
>>>>>>         "distribution_error": error,
>>>>>>         "thresholds": dict(CLUT_BACKEND_DISTRIBUTION_THRESHOLDS),
           }
       
       
    1: def _time_clut_backend_sample(
           *,
>>>>>>     repeats: int,
>>>>>>     n_samples: int,
>>>>>>     seed: int,
>>>>>> ) -> dict[str, float | int | bool | str]:
>>>>>>     repeats = max(1, int(repeats))
>>>>>>     n_samples = max(1, int(n_samples))
>>>>>>     biases = np.array([-2.0, 0.0, 2.0], dtype=np.float64)
>>>>>>     couplings = np.zeros((biases.size, biases.size), dtype=np.float64)
>>>>>>     durations: list[float] = []
>>>>>>     checksum = 0
       
>>>>>>     for repeat_index in range(repeats):
>>>>>>         started = time.perf_counter_ns()
>>>>>>         samples = ClutCpuBackend(seed=seed).sample(
>>>>>>             biases,
>>>>>>             couplings,
>>>>>>             n_samples=n_samples,
>>>>>>             config={"beta": 1.0, "steps_per_sample": 1, "seed": seed + repeat_index},
               )
>>>>>>         durations.append((time.perf_counter_ns() - started) / 1_000_000_000.0)
>>>>>>         checksum += int(np.count_nonzero(samples)) + repeat_index
       
>>>>>>     return {
>>>>>>         "measured": True,
>>>>>>         "scope": "CPU NumPy cLUT backend adapter timing only; no speedup baseline claim",
>>>>>>         "timer": "time.perf_counter_ns",
>>>>>>         "n_samples": int(n_samples),
>>>>>>         "n_spins": int(biases.size),
>>>>>>         "repeats": int(repeats),
>>>>>>         "median_s": float(np.median(durations)),
>>>>>>         "min_s": float(np.min(durations)),
>>>>>>         "max_s": float(np.max(durations)),
>>>>>>         "checksum": int(checksum),
           }
       
       
