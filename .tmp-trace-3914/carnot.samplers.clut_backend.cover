    1:     def minimize_energy(
               self,
>>>>>>         biases: np.ndarray,
>>>>>>         couplings: np.ndarray,
>>>>>>         n_samples: int,
>>>>>>         n_steps: int,
>>>>>>         beta: float,
>>>>>>     ) -> np.ndarray:
               """Run the cLUT backend for the requested number of synchronous steps."""
>>>>>>         return self.sample(
>>>>>>             biases,
>>>>>>             couplings,
>>>>>>             n_samples,
>>>>>>             {
>>>>>>                 "beta": beta,
>>>>>>                 "steps_per_sample": n_steps,
>>>>>>                 "seed": self.seed,
