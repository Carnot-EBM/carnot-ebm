    1:     def sample(
               self,
>>>>>>         biases: np.ndarray,
>>>>>>         couplings: np.ndarray,
>>>>>>         n_samples: int,
>>>>>>         config: dict[str, Any],
>>>>>>     ) -> np.ndarray:
               """Draw fixed-temperature Ising samples through cLUT Bernoulli updates.
       
               Why this remains modest: the adapter is a backend boundary test, not a
               replacement for the production JAX sampler. It proves existing caller
               code can opt into the cLUT random-variate path and audit the resulting
               distribution without making a new speed claim.
               """
>>>>>>         bias_vector, coupling_matrix = self._coerce_ising_inputs(biases, couplings)
>>>>>>         runtime_config = dict(config)
>>>>>>         beta = float(runtime_config.get("beta", 1.0))
>>>>>>         steps = max(1, int(runtime_config.get("steps_per_sample", 1)))
>>>>>>         sample_count = max(1, int(n_samples))
>>>>>>         sampler_seed = int(runtime_config.get("seed", self.seed))
>>>>>>         sampler = self._new_sampler(sampler_seed)
>>>>>>         states = np.zeros((sample_count, bias_vector.size), dtype=np.bool_)
       
>>>>>>         for _ in range(steps):
>>>>>>             local_fields = beta * (bias_vector + states.astype(np.float64) @ coupling_matrix)
>>>>>>             states = sampler.sample_logits(local_fields)
       
>>>>>>         return states
       
