>>>>>>       raise TypeError(
>>>>>>           'Expect argument to be a string, int, or float, found {}'.format(
>>>>>>               type(argument)))
       
    1:   def flag_type(self) -> str:
           """See base class."""
>>>>>>     return 'float'
       
       
