>>>>>>       sh = '%s <= %s' % (self.number_name, upper_bound)
>>>>>>     elif lower_bound is not None:
>>>>>>       sh = '%s >= %s' % (self.number_name, lower_bound)
>>>>>>     self.syntactic_help = sh
       
