    1: """Self-adaptive Lagrangian Ising sampler for constrained binary problems.
       
       **Researcher summary:**
           This module implements the arXiv:2501.04971 idea in the small, practical
           form needed by Carnot's CPU sampler tests: run Gibbs sweeps on a binary
           Ising energy, measure constraint violations, then increase the Lagrange
           multipliers attached to the violated constraints. The next Gibbs sweep sees
           a reshaped energy landscape without a human retuning the fixed penalty.
       
       **Detailed explanation for engineers:**
           The sampler keeps the base Ising objective
       
               E(s) = -0.5 * s.T @ J @ s - h.T @ s
       
           and adds a constraint term ``lambda.T @ g(s)``. The callable
           ``constraint_fn`` returns ``g(s)`` as a vector of violation scalars. For the
           benchmark below those scalars are normalized absolute equality residuals,
           so larger values mean "more infeasible" and zero means feasible. After the
           inner Gibbs sweeps, the outer update applies
       
               lambda <- lambda + lr * g(s)
       
           which is the self-adaptive part: constraints that remain violated become
           more expensive in the next outer iteration. The implementation evaluates
           candidate energies directly for each spin flip, so it works with arbitrary
           Python/NumPy constraint functions instead of requiring the constraints to be
           decomposed into pairwise couplings first.
       
       Spec: REQ-SAMPLE-2359, SCENARIO-SAMPLE-2359
       """
       
    1: from __future__ import annotations
       
    1: from collections.abc import Callable, Sequence
    1: from dataclasses import dataclass
    1: from typing import Any
       
    1: import numpy as np
       
       
    1: ConstraintFn = Callable[[np.ndarray], Sequence[float] | np.ndarray]
       
       
    3: @dataclass(frozen=True)
    2: class AdaptiveIsingResult:
    1:     """Result from an adaptive or fixed-penalty constrained Ising solve.
       
           The result records the final state plus the outer-loop history needed to
           compare convergence against a fixed penalty. ``iterations_to_feasibility``
           is the first outer iteration whose constraint norm is below the threshold;
           when feasibility is not reached it is reported as ``n_outer + 1`` so speedup
           ratios honestly represent a timeout.
       
           Spec: REQ-SAMPLE-2359-4
           """
       
    1:     state: np.ndarray
    1:     lambdas: np.ndarray
    1:     feasible: bool
    1:     iterations_to_feasibility: int
    1:     final_constraint_violation: float
    1:     violation_history: list[float]
    1:     lambda_history: list[list[float]]
    1:     energy_history: list[float]
    1:     n_outer: int
    1:     n_inner: int
       
    2:     @property
    2:     def convergence_rate(self) -> int:
               """Return the outer iteration count used as the convergence metric."""
>>>>>>         return self.iterations_to_feasibility
       
    1:     def as_dict(self) -> dict[str, Any]:
               """Return a JSON-serializable view of the run."""
>>>>>>         return {
>>>>>>             "state": self.state.astype(int).tolist(),
>>>>>>             "lambdas": self.lambdas.astype(float).tolist(),
>>>>>>             "feasible": self.feasible,
>>>>>>             "iterations_to_feasibility": self.iterations_to_feasibility,
>>>>>>             "convergence_rate": self.convergence_rate,
>>>>>>             "final_constraint_violation": self.final_constraint_violation,
>>>>>>             "violation_history": [float(value) for value in self.violation_history],
>>>>>>             "lambda_history": [[float(value) for value in row] for row in self.lambda_history],
>>>>>>             "energy_history": [float(value) for value in self.energy_history],
>>>>>>             "n_outer": self.n_outer,
>>>>>>             "n_inner": self.n_inner,
               }
       
       
    3: @dataclass(frozen=True)
    2: class AdaptiveIsingBenchmarkProblem:
