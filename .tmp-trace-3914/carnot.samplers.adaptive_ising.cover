    1:     name: str
    1:     description: str
    1:     J: np.ndarray
    1:     h: np.ndarray
    1:     constraint_fn: ConstraintFn
    1:     init_state: np.ndarray
    1:     lr: float
    1:     beta: float
    1:     n_outer: int = 50
    1:     n_inner: int = 10
    1:     threshold: float = 0.1
       
    2:     @property
    2:     def n_constraints(self) -> int:
