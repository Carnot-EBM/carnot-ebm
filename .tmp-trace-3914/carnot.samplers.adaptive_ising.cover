>>>>>>         return {
>>>>>>             "name": self.name,
>>>>>>             "description": self.description,
>>>>>>             "n_spins": int(self.h.shape[0]),
>>>>>>             "n_constraints": self.n_constraints,
>>>>>>             "lr": float(self.lr),
>>>>>>             "beta": float(self.beta),
>>>>>>             "n_outer": int(self.n_outer),
>>>>>>             "n_inner": int(self.n_inner),
>>>>>>             "threshold": float(self.threshold),
>>>>>>             "initial_constraint_violation": float(
>>>>>>                 np.linalg.norm(_constraint_vector(self.constraint_fn, self.init_state))
                   ),
               }
       
       
    2: class SelfAdaptiveIsingSampler:
    1:     """Binary Gibbs sampler with self-adaptive Lagrange multiplier updates.
       
           Args:
               J: Square coupling matrix for the binary Ising/QUBO objective. The
                   diagonal is ignored by the benchmark but not forcibly changed, so
                   callers can pass their exact local energy model.
               h: Bias vector. Positive values make state bit ``1`` energetically
                   cheaper, negative values prefer ``0``.
               constraint_fn: Callable returning one or more scalar constraint
                   violations for a binary state. A value of zero means that
                   constraint is satisfied.
               lr: Learning rate in ``lambdas += lr * constraint_violations``.
               beta: Inverse temperature for the Gibbs conditional.
               init_state: Optional binary initial state. If omitted, the sampler draws
                   one from ``random_seed``.
               random_seed: Seed for NumPy's local random generator.
               initial_lambdas: Optional starting multipliers. When omitted, the
                   multipliers are initialized to zero as required by Exp 2359.
       
           Spec: REQ-SAMPLE-2359-1, REQ-SAMPLE-2359-2, REQ-SAMPLE-2359-3
           """
       
    6:     def __init__(
               self,
>>>>>>         J: np.ndarray,
>>>>>>         h: np.ndarray,
>>>>>>         constraint_fn: ConstraintFn,
               *,
    1:         lr: float = 1.0,
    1:         beta: float = 5.0,
    1:         init_state: np.ndarray | None = None,
    1:         random_seed: int | None = None,
    1:         initial_lambdas: np.ndarray | Sequence[float] | None = None,
>>>>>>     ) -> None:
>>>>>>         self.J = _validate_square_matrix(J)
>>>>>>         self.h = _validate_bias(h, self.J.shape[0])
>>>>>>         self.constraint_fn = constraint_fn
>>>>>>         self.lr = float(lr)
>>>>>>         self.beta = float(beta)
>>>>>>         if self.lr < 0.0:
>>>>>>             raise ValueError("lr must be nonnegative")
>>>>>>         if self.beta <= 0.0:
>>>>>>             raise ValueError("beta must be positive")
       
>>>>>>         self.rng = np.random.default_rng(random_seed)
>>>>>>         self.state = self._initial_state(init_state)
>>>>>>         violations = self.constraint_violations(self.state)
>>>>>>         if initial_lambdas is None:
>>>>>>             self.lambdas = np.zeros_like(violations, dtype=np.float64)
               else:
>>>>>>             lambdas = np.asarray(initial_lambdas, dtype=np.float64)
>>>>>>             if lambdas.shape != violations.shape:
>>>>>>                 raise ValueError(
>>>>>>                     "initial_lambdas shape must match constraint_fn output shape "
>>>>>>                     f"{violations.shape}, got {lambdas.shape}"
                       )
>>>>>>             self.lambdas = lambdas.copy()
       
    1:     def _initial_state(self, init_state: np.ndarray | None) -> np.ndarray:
>>>>>>         if init_state is None:
>>>>>>             return self.rng.integers(0, 2, size=self.h.shape[0], dtype=np.int8)
>>>>>>         state = np.asarray(init_state, dtype=np.int8)
>>>>>>         if state.shape != self.h.shape:
>>>>>>             raise ValueError(f"init_state shape must be {self.h.shape}, got {state.shape}")
>>>>>>         if not np.all((state == 0) | (state == 1)):
>>>>>>             raise ValueError("init_state must contain only binary values 0 or 1")
>>>>>>         return state.copy()
       
    1:     def constraint_violations(self, state: np.ndarray | None = None) -> np.ndarray:
               """Evaluate the current constraint violation vector.
       
               The sampler treats the returned values as energy penalties. Benchmarks
               therefore pass normalized nonnegative residuals. Callers that want a
               signed dual update can return signed values; the update rule itself is
               intentionally not clipped or rectified.
       
               Spec: REQ-SAMPLE-2359-1
               """
>>>>>>         chosen_state = self.state if state is None else np.asarray(state, dtype=np.int8)
>>>>>>         return _constraint_vector(self.constraint_fn, chosen_state)
       
    1:     def energy(self, state: np.ndarray | None = None) -> float:
               """Compute base Ising energy plus current Lagrange constraint energy."""
>>>>>>         chosen_state = self.state if state is None else np.asarray(state, dtype=np.float64)
>>>>>>         base_energy = -0.5 * float(chosen_state @ self.J @ chosen_state) - float(
>>>>>>             self.h @ chosen_state
               )
>>>>>>         violations = self.constraint_violations(chosen_state.astype(np.int8))
>>>>>>         return float(base_energy + self.lambdas @ violations)
       
    1:     def sample_step(self) -> np.ndarray:
               """Run one sequential Gibbs sweep over all spins.
       
               For each bit, the method evaluates the full constrained energy for the
               candidate states ``0`` and ``1``. This is slower than a closed-form local
               field for pairwise Ising terms, but it is deliberately general: the
               constraint function can be any Python callable over the whole state.
       
               Spec: REQ-SAMPLE-2359-2
               """
>>>>>>         for spin_idx in range(self.state.shape[0]):
>>>>>>             state0 = self.state.copy()
>>>>>>             state1 = self.state.copy()
>>>>>>             state0[spin_idx] = 0
>>>>>>             state1[spin_idx] = 1
>>>>>>             e0 = self.energy(state0)
>>>>>>             e1 = self.energy(state1)
>>>>>>             p_one = _probability_one(self.beta * (e1 - e0))
>>>>>>             self.state[spin_idx] = 1 if self.rng.random() < p_one else 0
>>>>>>         return self.state.copy()
       
    1:     def lagrange_update(
>>>>>>         self, constraint_violations: np.ndarray | Sequence[float] | None = None
>>>>>>     ) -> np.ndarray:
               """Apply ``lambdas += lr * constraint_violations``.
       
               Spec: REQ-SAMPLE-2359-3
               """
>>>>>>         if constraint_violations is None:
>>>>>>             violations = self.constraint_violations()
               else:
>>>>>>             violations = np.asarray(constraint_violations, dtype=np.float64)
>>>>>>         if violations.shape != self.lambdas.shape:
>>>>>>             raise ValueError(
>>>>>>                 f"constraint violation shape must be {self.lambdas.shape}, got {violations.shape}"
                   )
>>>>>>         self.lambdas = self.lambdas + self.lr * violations
>>>>>>         return self.lambdas.copy()
       
    1:     def solve(
               self,
>>>>>>         n_outer: int = 50,
>>>>>>         n_inner: int = 10,
>>>>>>         threshold: float = 0.1,
>>>>>>     ) -> AdaptiveIsingResult:
               """Alternate Gibbs sweeps with Lagrange updates until feasibility.
       
               Spec: REQ-SAMPLE-2359-4
               """
>>>>>>         return _run_outer_loop(
>>>>>>             sampler=self,
>>>>>>             n_outer=n_outer,
>>>>>>             n_inner=n_inner,
>>>>>>             threshold=threshold,
>>>>>>             update_lambdas=True,
               )
       
       
    1: def _validate_square_matrix(J: np.ndarray) -> np.ndarray:
>>>>>>     matrix = np.asarray(J, dtype=np.float64)
>>>>>>     if matrix.ndim != 2 or matrix.shape[0] != matrix.shape[1]:
>>>>>>         raise ValueError(f"J must be a square matrix, got shape {matrix.shape}")
>>>>>>     return matrix.copy()
       
       
    1: def _validate_bias(h: np.ndarray, n_spins: int) -> np.ndarray:
>>>>>>     bias = np.asarray(h, dtype=np.float64)
>>>>>>     if bias.shape != (n_spins,):
>>>>>>         raise ValueError(f"h must have shape {(n_spins,)}, got {bias.shape}")
>>>>>>     return bias.copy()
       
       
    1: def _constraint_vector(constraint_fn: ConstraintFn, state: np.ndarray) -> np.ndarray:
>>>>>>     violations = np.asarray(constraint_fn(state.copy()), dtype=np.float64)
>>>>>>     if violations.ndim == 0:
>>>>>>         violations = violations.reshape(1)
>>>>>>     if violations.ndim != 1:
>>>>>>         raise ValueError("constraint_fn must return a scalar or 1D sequence")
>>>>>>     if not np.all(np.isfinite(violations)):
>>>>>>         raise ValueError("constraint_fn returned non-finite violations")
>>>>>>     return violations
       
       
    1: def _probability_one(beta_energy_delta: float) -> float:
           """Return ``P(s_i=1)`` from ``beta * (E_one - E_zero)`` stably."""
>>>>>>     clipped = float(np.clip(beta_energy_delta, -700.0, 700.0))
>>>>>>     return float(1.0 / (1.0 + np.exp(clipped)))
       
       
    1: def _run_outer_loop(
           *,
>>>>>>     sampler: SelfAdaptiveIsingSampler,
>>>>>>     n_outer: int,
>>>>>>     n_inner: int,
>>>>>>     threshold: float,
>>>>>>     update_lambdas: bool,
>>>>>> ) -> AdaptiveIsingResult:
>>>>>>     if n_outer <= 0:
>>>>>>         raise ValueError("n_outer must be positive")
>>>>>>     if n_inner <= 0:
>>>>>>         raise ValueError("n_inner must be positive")
>>>>>>     if threshold < 0.0:
>>>>>>         raise ValueError("threshold must be nonnegative")
       
>>>>>>     violation_history: list[float] = []
>>>>>>     lambda_history: list[list[float]] = []
>>>>>>     energy_history: list[float] = []
       
>>>>>>     for outer_idx in range(1, n_outer + 1):
>>>>>>         for _ in range(n_inner):
>>>>>>             sampler.sample_step()
>>>>>>         violations = sampler.constraint_violations()
>>>>>>         violation_norm = float(np.linalg.norm(violations))
>>>>>>         violation_history.append(violation_norm)
>>>>>>         lambda_history.append(sampler.lambdas.astype(float).tolist())
>>>>>>         energy_history.append(sampler.energy())
>>>>>>         if violation_norm < threshold:
>>>>>>             return AdaptiveIsingResult(
>>>>>>                 state=sampler.state.copy(),
>>>>>>                 lambdas=sampler.lambdas.copy(),
>>>>>>                 feasible=True,
>>>>>>                 iterations_to_feasibility=outer_idx,
>>>>>>                 final_constraint_violation=violation_norm,
>>>>>>                 violation_history=violation_history,
>>>>>>                 lambda_history=lambda_history,
>>>>>>                 energy_history=energy_history,
>>>>>>                 n_outer=n_outer,
>>>>>>                 n_inner=n_inner,
                   )
>>>>>>         if update_lambdas:
>>>>>>             sampler.lagrange_update(violations)
       
>>>>>>     final_violation = violation_history[-1]
>>>>>>     return AdaptiveIsingResult(
>>>>>>         state=sampler.state.copy(),
>>>>>>         lambdas=sampler.lambdas.copy(),
>>>>>>         feasible=False,
>>>>>>         iterations_to_feasibility=n_outer + 1,
>>>>>>         final_constraint_violation=final_violation,
>>>>>>         violation_history=violation_history,
>>>>>>         lambda_history=lambda_history,
>>>>>>         energy_history=energy_history,
>>>>>>         n_outer=n_outer,
>>>>>>         n_inner=n_inner,
           )
       
       
    1: def make_benchmark_problems(random_seed: int = 42) -> list[AdaptiveIsingBenchmarkProblem]:
           """Build the two deterministic CPU benchmark problems for Exp 2359.
       
           Problem A is a 16-spin ferromagnet whose base energy prefers many active
           bits, while the constraint requires exactly four active bits. Problem B has
           32 spins with a small random symmetric coupling matrix and a feasible linear
           equality constraint. Both start from an infeasible all-active state so the
           fixed penalty and adaptive update see the same repair task.
       
           Spec: REQ-SAMPLE-2359-5
           """
>>>>>>     rng = np.random.default_rng(random_seed)
       
>>>>>>     n_a = 16
>>>>>>     J_a = np.full((n_a, n_a), 0.08, dtype=np.float64)
>>>>>>     np.fill_diagonal(J_a, 0.0)
>>>>>>     h_a = np.full(n_a, 0.25, dtype=np.float64)
       
>>>>>>     def problem_a_constraint(state: np.ndarray) -> list[float]:
>>>>>>         return [abs(float(state.sum() - 4.0)) / float(n_a)]
       
>>>>>>     problem_a = AdaptiveIsingBenchmarkProblem(
>>>>>>         name="ferromagnet_sum_eq_4",
>>>>>>         description="16-spin ferromagnet with normalized equality violation |sum(s)-4|/16",
>>>>>>         J=J_a,
>>>>>>         h=h_a,
>>>>>>         constraint_fn=problem_a_constraint,
>>>>>>         init_state=np.ones(n_a, dtype=np.int8),
>>>>>>         lr=4.0,
>>>>>>         beta=8.0,
           )
       
>>>>>>     n_b = 32
>>>>>>     random_couplings = rng.normal(loc=0.0, scale=0.015, size=(n_b, n_b))
>>>>>>     J_b = (random_couplings + random_couplings.T) / 2.0
>>>>>>     np.fill_diagonal(J_b, 0.0)
>>>>>>     weights = rng.integers(1, 5, size=n_b).astype(np.float64)
>>>>>>     target_state = np.zeros(n_b, dtype=np.int8)
>>>>>>     target_state[:10] = 1
>>>>>>     target = float(weights @ target_state)
>>>>>>     total_weight = float(weights.sum())
>>>>>>     h_b = 0.16 + 0.02 * rng.normal(size=n_b)
       
>>>>>>     def problem_b_constraint(state: np.ndarray) -> list[float]:
>>>>>>         weighted_sum = float(weights @ state)
>>>>>>         return [abs(weighted_sum - target) / total_weight]
       
>>>>>>     problem_b = AdaptiveIsingBenchmarkProblem(
>>>>>>         name="random32_linear_equality",
               description=(
>>>>>>             "32-spin random coupling problem with normalized linear equality |w.T@s-target|/sum(w)"
               ),
>>>>>>         J=J_b,
>>>>>>         h=h_b,
>>>>>>         constraint_fn=problem_b_constraint,
>>>>>>         init_state=np.ones(n_b, dtype=np.int8),
>>>>>>         lr=5.0,
>>>>>>         beta=7.0,
>>>>>>         n_inner=40,
           )
       
>>>>>>     return [problem_a, problem_b]
       
       
    3: def run_fixed_penalty_baseline(
>>>>>>     problem: AdaptiveIsingBenchmarkProblem,
           *,
    1:     fixed_penalty: float = 1.0,
    1:     random_seed: int = 42,
>>>>>> ) -> AdaptiveIsingResult:
           """Run the fixed-penalty baseline with constant constraint weight.
       
           Spec: REQ-SAMPLE-2359-5
           """
>>>>>>     sampler = SelfAdaptiveIsingSampler(
>>>>>>         J=problem.J,
>>>>>>         h=problem.h,
>>>>>>         constraint_fn=problem.constraint_fn,
>>>>>>         lr=0.0,
>>>>>>         beta=problem.beta,
>>>>>>         init_state=problem.init_state,
>>>>>>         random_seed=random_seed,
>>>>>>         initial_lambdas=np.full(problem.n_constraints, fixed_penalty, dtype=np.float64),
           )
>>>>>>     return _run_outer_loop(
>>>>>>         sampler=sampler,
>>>>>>         n_outer=problem.n_outer,
>>>>>>         n_inner=problem.n_inner,
>>>>>>         threshold=problem.threshold,
>>>>>>         update_lambdas=False,
           )
       
       
    2: def run_adaptive_lagrangian_solver(
>>>>>>     problem: AdaptiveIsingBenchmarkProblem,
           *,
    1:     random_seed: int = 42,
>>>>>> ) -> AdaptiveIsingResult:
           """Run the self-adaptive Lagrangian sampler on one benchmark problem."""
>>>>>>     sampler = SelfAdaptiveIsingSampler(
>>>>>>         J=problem.J,
>>>>>>         h=problem.h,
>>>>>>         constraint_fn=problem.constraint_fn,
>>>>>>         lr=problem.lr,
>>>>>>         beta=problem.beta,
>>>>>>         init_state=problem.init_state,
>>>>>>         random_seed=random_seed,
           )
>>>>>>     return sampler.solve(
>>>>>>         n_outer=problem.n_outer,
>>>>>>         n_inner=problem.n_inner,
>>>>>>         threshold=problem.threshold,
           )
       
       
    1: def run_self_adaptive_ising_benchmark(random_seed: int = 42) -> dict[str, Any]:
           """Run Exp 2359's two-problem adaptive-vs-fixed CPU benchmark.
       
           Spec: REQ-SAMPLE-2359-5, REQ-SAMPLE-2359-6, SCENARIO-SAMPLE-2359
           """
>>>>>>     problems = make_benchmark_problems(random_seed=random_seed)
>>>>>>     per_problem: list[dict[str, Any]] = []
       
>>>>>>     for index, problem in enumerate(problems):
>>>>>>         fixed = run_fixed_penalty_baseline(
>>>>>>             problem,
>>>>>>             fixed_penalty=1.0,
>>>>>>             random_seed=random_seed + index,
               )
>>>>>>         adaptive = run_adaptive_lagrangian_solver(
>>>>>>             problem,
>>>>>>             random_seed=random_seed + index,
               )
>>>>>>         speedup = fixed.iterations_to_feasibility / max(1, adaptive.iterations_to_feasibility)
>>>>>>         per_problem.append(
>>>>>>             {
>>>>>>                 **problem.metadata(),
>>>>>>                 "fixed_penalty": fixed.as_dict(),
>>>>>>                 "adaptive_lagrangian": adaptive.as_dict(),
>>>>>>                 "adaptive_speedup": float(speedup),
>>>>>>                 "final_constraint_violation": adaptive.final_constraint_violation,
>>>>>>                 "fixed_iters": fixed.iterations_to_feasibility,
>>>>>>                 "adaptive_iters": adaptive.iterations_to_feasibility,
                   }
               )
       
>>>>>>     speedups = [float(result["adaptive_speedup"]) for result in per_problem]
>>>>>>     final_violations = [float(result["final_constraint_violation"]) for result in per_problem]
>>>>>>     adaptive_ising_validated = any(speedup >= 1.5 for speedup in speedups)
>>>>>>     adaptive_speedup = max(speedups) if speedups else 0.0
>>>>>>     final_constraint_violation = max(final_violations) if final_violations else float("inf")
>>>>>>     if adaptive_ising_validated:
>>>>>>         honest_verdict = "complete: adaptive_lagrangian_ising_validated_cpu_seed_42"
           else:
>>>>>>         honest_verdict = "complete: adaptive_lagrangian_ising_not_validated_cpu_seed_42"
       
>>>>>>     return {
>>>>>>         "honest_verdict": honest_verdict,
>>>>>>         "adaptive_ising_validated": adaptive_ising_validated,
>>>>>>         "adaptive_speedup": float(adaptive_speedup),
>>>>>>         "mean_adaptive_speedup": float(np.mean(speedups)) if speedups else 0.0,
>>>>>>         "final_constraint_violation": float(final_constraint_violation),
>>>>>>         "n_problems": len(per_problem),
>>>>>>         "random_seed": random_seed,
>>>>>>         "fixed_penalty": 1.0,
>>>>>>         "feasibility_threshold": 0.1,
>>>>>>         "per_problem_results": per_problem,
>>>>>>         "artifact_field_principles": {
>>>>>>             "honest_verdict": "Terminal-prefix required.",
>>>>>>             "adaptive_ising_validated": (
>>>>>>                 "True if adaptive_speedup >= 1.5x on at least 1 of 2 problems."
                   ),
>>>>>>             "adaptive_speedup": (
>>>>>>                 "Iterations ratio: fixed-penalty / adaptive Lagrangian to feasibility."
                   ),
>>>>>>             "final_constraint_violation": (
>>>>>>                 "Constraint residual after convergence. Adversarial check: should be near 0."
                   ),
>>>>>>             "n_problems": "Must be 2.",
>>>>>>             "random_seed": "Reproducibility. Must be 42.",
               },
           }
