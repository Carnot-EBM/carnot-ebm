    3:     choices: Dict[str, Any] = field(default_factory=lambda: {})
       
       
   22: @dataclass
    2: class HydraConf:
    3:     defaults: List[Any] = field(
    2:         default_factory=lambda: [
    1:             {"output": "default"},
    1:             {"launcher": "basic"},
    1:             {"sweeper": "basic"},
    1:             {"help": "default"},
    1:             {"hydra_help": "default"},
    1:             {"hydra_logging": "default"},
    1:             {"job_logging": "default"},
    1:             {"callbacks": None},
                   # env specific overrides
    1:             {"env": "default"},
