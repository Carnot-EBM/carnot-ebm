    3:     task: List[str] = field(default_factory=lambda: [])
       
       
       # job runtime information will be populated here
   14: @dataclass
    2: class JobConf:
           # Job name, populated automatically unless specified by the user (in config or cli)
    2:     name: str = MISSING
       
           # Change current working dir to the output dir.
           # Will be non-optional and default to False in Hydra 1.3
    2:     chdir: Optional[bool] = None
       
           # Populated automatically by Hydra.
           # Concatenation of job overrides that can be used as a part
           # of the directory name.
           # This can be configured via hydra.job.config.override_dirname
    2:     override_dirname: str = MISSING
       
           # Job ID in underlying scheduling system
    2:     id: str = MISSING
       
           # Job number if job is a part of a sweep
    2:     num: int = MISSING
       
           # The config name used by the job
    2:     config_name: Optional[str] = MISSING
       
           # Environment variables to set remotely
    2:     env_set: Dict[str, str] = field(default_factory=dict)
           # Environment variables to copy from the launching machine
    2:     env_copy: List[str] = field(default_factory=list)
       
           # Job config
    6:     @dataclass
    2:     class JobConfig:
    8:         @dataclass
               # configuration for the ${hydra.job.override_dirname} runtime variable
    2:         class OverrideDirname:
    2:             kv_sep: str = "="
    2:             item_sep: str = ","
    2:             exclude_keys: List[str] = field(default_factory=list)
       
    2:         override_dirname: OverrideDirname = field(default_factory=OverrideDirname)
       
    2:     config: JobConfig = field(default_factory=JobConfig)
       
       
    7: @dataclass
    2: class ConfigSourceInfo:
