>>>>>>     if exc_type is None or exc_value is None:
>>>>>>       return
       
>>>>>>     if self.traceback is None or has_user_context(exc_value):
>>>>>>       return
       
>>>>>>     filtered_tb = traceback_util.filter_traceback(self.traceback.as_python_traceback())
>>>>>>     if filtered_tb:
