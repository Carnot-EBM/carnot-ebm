>>>>>>       exp.__context__ = exc_value.__context__
>>>>>>       exp.__cause__ = exc_value.__cause__
>>>>>>       exp.__suppress_context__ = exc_value.__suppress_context__
>>>>>>       exc_value.__context__ = None
