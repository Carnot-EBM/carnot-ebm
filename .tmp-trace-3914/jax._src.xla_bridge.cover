>>>>>>     options['enable_mock_nccl'] = mock_num_processes > 0
>>>>>>     if mock_num_processes > 0:
>>>>>>       options['num_nodes'] = mock_num_processes
>>>>>>       if mock_gpu_topology:
>>>>>>         options['mock_gpu_topology'] = mock_gpu_topology
       
>>>>>>   return options
       
