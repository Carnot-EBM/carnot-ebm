    1:                       "jax_cpu_get_local_topology_timeout_minutes"),
       )
       
    2: cpu_get_global_topology_timeout_minutes = config.int_state(
    1:     name="jax_cpu_get_global_topology_timeout_minutes",
    1:     default=5,
           help=(
    1:         "Timeout in minutes for getting the global topology of CPU devices;"
               " should be strictly greater than"
               " `--jax_cpu_get_local_topology_timeout_minutes`."
           ),
    2:     validator=partial(_validate_backend_not_initialized,
    1:                       "jax_cpu_get_global_topology_timeout_minutes"),
       )
