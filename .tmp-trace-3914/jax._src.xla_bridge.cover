>>>>>>     options.update(pjrt_client_options)
       
>>>>>>   if plugin_name in ("cuda", "rocm"):
>>>>>>     visible_devices = (CUDA_VISIBLE_DEVICES.value if plugin_name == "cuda"
>>>>>>         else _ROCM_VISIBLE_DEVICES.value)
