    2: class Chunk(object):
    1:     pass
       
    2: class TagChunk(Chunk):
    1:     __slots__ = ('tag', 'label')
       
    1:     def __init__(self, tag:str, label:str=None):
>>>>>>         self.tag = tag
>>>>>>         self.label = label
       
    1:     def __str__(self):
>>>>>>         if self.label is None:
>>>>>>             return self.tag
               else:
>>>>>>             return self.label + ":" + self.tag
       
    2: class TextChunk(Chunk):
    1:     __slots__ = 'text'
       
    1:     def __init__(self, text:str):
>>>>>>         self.text = text
       
