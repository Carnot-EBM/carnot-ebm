    1: """Container for stat objects."""
       
    1: import dataclasses
    1: from typing import Optional
       
       
   11: @dataclasses.dataclass
    2: class StatResult:
    1:   """Results of `path.stat()`.
       
         Attributes:
           is_directory: Whether the file is a directory
           length: Size in bytes
           mtime: Time since last modification (in sec since the epoch)
           owner: the owner of the path.
           group: the group of the path.
           mode: the st_mode of the path.
         """
       
    1:   is_directory: bool
    1:   length: int
    1:   mtime: int
    2:   owner: Optional[str] = None
    2:   group: Optional[str] = None
    2:   mode: Optional[int] = None
