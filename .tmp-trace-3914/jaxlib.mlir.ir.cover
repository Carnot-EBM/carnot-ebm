    1: def register_attribute_builder(kind, replace=False, allow_existing=False):
   80:     def decorator_builder(func):
   80:         AttrBuilder.insert(kind, func, replace=replace, allow_existing=allow_existing)
   80:         return func
       
   80:     return decorator_builder
       
       
