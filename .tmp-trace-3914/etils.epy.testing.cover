       # ==== Hermetic tests ===
       
    1: _SKIP_NON_HERMETIC = False
       
       # Non hermetic tests are explicitly marked and skipped if `_SKIP_NON_HERMETIC`
       # is True.
    2: non_hermetic = pytest.mark.skipif(
    1:     _SKIP_NON_HERMETIC,
    1:     reason='Non-hermetic test skipped.',
