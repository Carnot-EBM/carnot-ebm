    1: """Required functions for optimized contractions of numpy arrays using cupy."""
       
    1: from opt_einsum.helpers import has_array_interface
    1: from opt_einsum.sharing import to_backend_cache_wrap
       
    1: __all__ = ["to_cupy", "build_expression", "evaluate_constants"]
       
       
    2: @to_backend_cache_wrap
    2: def to_cupy(array):  # pragma: no cover
>>>>>>     import cupy
       
>>>>>>     if has_array_interface(array):
>>>>>>         return cupy.asarray(array)
       
>>>>>>     return array
       
       
    1: def build_expression(_, expr):  # pragma: no cover
           """Build a cupy function based on ``arrays`` and ``expr``."""
       
>>>>>>     def cupy_contract(*arrays):
>>>>>>         return expr._contract([to_cupy(x) for x in arrays], backend="cupy").get()
       
>>>>>>     return cupy_contract
       
       
    1: def evaluate_constants(const_arrays, expr):  # pragma: no cover
           """Convert constant arguments to cupy arrays, and perform any possible
           constant contractions.
           """
>>>>>>     return expr(*[to_cupy(x) for x in const_arrays], backend="cupy", evaluate_constants=True)
