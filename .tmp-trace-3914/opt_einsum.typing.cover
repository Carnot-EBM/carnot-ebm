    1: """Types used in the opt_einsum package."""
       
    1: from collections import namedtuple
    1: from typing import Any, Callable, Collection, Dict, FrozenSet, List, Literal, Optional, Tuple, Union
       
    1: TensorShapeType = Tuple[int, ...]
    1: PathType = Collection[TensorShapeType]
       
    1: ArrayType = Any
       
    1: ArrayIndexType = FrozenSet[str]
    1: ArrayShaped = namedtuple("ArrayShaped", ["shape"])
       
    1: ContractionListType = List[Tuple[Any, ArrayIndexType, str, Optional[Tuple[str, ...]], Union[str, bool]]]
    1: PathSearchFunctionType = Callable[[List[ArrayIndexType], ArrayIndexType, Dict[str, int], Optional[int]], PathType]
       
       # Contract kwargs
    2: OptimizeKind = Union[
    2:     None,
    1:     bool,
    2:     Literal[
    1:         "optimal", "dp", "greedy", "random-greedy", "random-greedy-128", "branch-all", "branch-2", "auto", "auto-hq"
           ],
    1:     PathType,
    1:     PathSearchFunctionType,
       ]
    1: BackendType = Literal["auto", "object", "autograd", "cupy", "dask", "jax", "theano", "tensorflow", "torch", "libjax"]
