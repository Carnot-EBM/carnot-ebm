    2: class RangeTransition(Transition):
    1:     __slots__ = ('serializationType', 'start', 'stop')
       
    1:     def __init__(self, target:ATNState, start:int, stop:int):
>>>>>>         super().__init__(target)
>>>>>>         self.serializationType = self.RANGE
>>>>>>         self.start = start
>>>>>>         self.stop = stop
>>>>>>         self.label = self.makeLabel()
       
    1:     def makeLabel(self):
>>>>>>         s = IntervalSet()
>>>>>>         s.addRange(range(self.start, self.stop + 1))
