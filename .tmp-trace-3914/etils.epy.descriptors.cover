    1: """Descriptor utils."""
       
    1: import typing
    1: from typing import Any, Callable
       
    1: _T = typing.TypeVar('_T')
       
       
    1: if typing.TYPE_CHECKING:
         # TODO(b/171883689): There is likely a better way to annotate descriptors
       
>>>>>>   def classproperty(fn: Callable[[Any], _T]) -> _T:  # pylint: disable=function-redefined
>>>>>>     return fn(type(None))
       
       else:
       
    2:   class classproperty:  # pylint: disable=invalid-name
    1:     """Decorator combining `property` and `classmethod`."""
       
    1:     def __init__(self, fget):
>>>>>>       self.fget = fget
       
    1:     def __get__(self, obj, cls):
>>>>>>       return self.fget(cls)
