           "/inspect.py",
           "/re.py",
           "/re/__init__.py",  # refactored in Python 3.11
           "/warnings.py",
           # Quite rarely, the first AFNP line is in Pytest's internals.
           "/_pytest/**",
           "/pluggy/_*.py",
           # used by pytest for failure formatting in the terminal.
