    2: class InterpolationKeyError(InterpolationResolutionError):
    1:     """
           Thrown when a node does not exist when resolving an interpolation.
           """
       
       
    2: class InterpolationToMissingValueError(InterpolationResolutionError):
    1:     """
           Thrown when a node interpolation points to a node that is set to ???.
           """
       
       
    2: class InterpolationValidationError(InterpolationResolutionError, ValidationError):
    1:     """
           Thrown when the result of an interpolation fails the validation step.
           """
       
       
