    2: class InterpolationResolutionError(OmegaConfBaseException, ValueError):
    1:     """
           Base class for exceptions raised when resolving an interpolation.
           """
       
       
    2: class UnsupportedInterpolationType(InterpolationResolutionError):
    1:     """
