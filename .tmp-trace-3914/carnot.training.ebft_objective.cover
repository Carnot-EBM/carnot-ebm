    1: """Energy-Based Fine-Tuning (EBFT) objective function.
       
       Spec: REQ-TRAIN-007
       """
       
    1: from typing import Callable
       
    1: import jax.numpy as jnp
       
       
    1: def ebft_loss(
>>>>>>     energy_fn: Callable[[jnp.ndarray], jnp.ndarray],
>>>>>>     expert_sequences: jnp.ndarray,
>>>>>>     rollout_sequences: jnp.ndarray,
>>>>>> ) -> jnp.ndarray:
           """Computes the Energy-Based Fine-Tuning (EBFT) objective.
           
           EBFT matches features over continuous rollouts without explicit external verifiers,
           by minimizing the energy of expert sequences and maximizing the energy of rollouts
           (acting as contrastive negative samples).
           
           Args:
               energy_fn: A callable taking a batch of sequences and returning scalar energies.
                   Typically `energy_fn(sequences)` returns shape (batch_size,).
               expert_sequences: Array of shape (expert_batch, ...) representing ground-truth 
                   or high-quality sequences.
               rollout_sequences: Array of shape (rollout_batch, ...) representing model-generated 
                   trajectories or rollouts.
                   
           Returns:
               Scalar loss value (EBFT objective).
           """
>>>>>>     expert_energies = energy_fn(expert_sequences)
>>>>>>     rollout_energies = energy_fn(rollout_sequences)
           
           # Contrastive objective: push expert energy down, rollout energy up
>>>>>>     loss = jnp.mean(expert_energies) - jnp.mean(rollout_energies)
>>>>>>     return loss
