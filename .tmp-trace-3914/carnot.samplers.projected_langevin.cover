>>>>>>         expected_delta = projected_rate - casal_rate
>>>>>>     if artifact["projected_langevin_competitive"] is not expected_competitive:
>>>>>>         raise ValueError("projected_langevin_competitive does not match rates")
>>>>>>     if artifact["langevin_vs_casal_delta"] != expected_delta:
>>>>>>         raise ValueError("langevin_vs_casal_delta does not match rates")
       
       
    1: def write_experiment_2355_artifact(
>>>>>>     output_path: str | Path | None = None,
>>>>>> ) -> dict[str, Any]:
           """Write `results/experiment_2355_projected_langevin.json`."""
>>>>>>     artifact = build_experiment_2355_artifact(random_seed=RANDOM_SEED)
>>>>>>     path = Path(output_path) if output_path is not None else _default_output_path()
>>>>>>     path.parent.mkdir(parents=True, exist_ok=True)
