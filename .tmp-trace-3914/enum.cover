>>>>>>     if num >= 0:
>>>>>>         s = bltns.bin(num + ceiling).replace('1', '0', 1)
           else:
>>>>>>         s = bltns.bin(~num ^ (ceiling - 1) + ceiling)
>>>>>>     sign = s[:3]
>>>>>>     digits = s[3:]
>>>>>>     if max_bits is not None:
>>>>>>         if len(digits) < max_bits:
>>>>>>             digits = (sign[-1] * max_bits + digits)[-max_bits:]
>>>>>>     return "%s %s" % (sign, digits)
       
