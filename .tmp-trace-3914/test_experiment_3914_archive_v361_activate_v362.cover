    2:         (lambda p: p.update(core_pretest_green=False), "core pretest"),
    2:         (lambda p: p.update(live_model_modules_importable="yes"), "live model modules"),
    2:         (lambda p: p.update(active_milestone_confirmed=False), "active milestone"),
    2:         (lambda p: p.update(n_tasks_archived=10), "n_tasks_archived"),
    2:         (lambda p: p.update(exp3904_honest_verdict="complete: wrong"), "Exp 3904"),
