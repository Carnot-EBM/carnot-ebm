    6: def test_req_report_3914_subprocess_helpers(
    1:     tmp_path: Path,
    1:     monkeypatch: pytest.MonkeyPatch,
    1: ) -> None:
           """REQ-REPORT-3914: subprocess helpers use the mandated commands."""
       
    1:     calls: list[list[str]] = []
       
    2:     class Completed:
    1:         returncode = 0
    1:         stdout = SUMMARY_STDOUT
    1:         stderr = ""
       
    1:     def run_subprocess(cmd: list[str], **kwargs: object) -> Completed:
    4:         calls.append(cmd)
    4:         assert kwargs["cwd"] == tmp_path
    4:         return Completed()
       
    1:     monkeypatch.setattr(mod.subprocess, "run", run_subprocess)
    1:     summary = mod.run_summarize_artifacts(tmp_path)
    1:     assert summary.stdout == SUMMARY_STDOUT
    1:     assert summary.exit_code == 0
