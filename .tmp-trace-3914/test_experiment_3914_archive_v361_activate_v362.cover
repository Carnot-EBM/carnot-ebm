    2:         (lambda p: p.update(n361_wash_root_causes="only poison-test cascade"), "root causes"),
    2:         (lambda p: p.update(backend_routing_recommendation="gemini only"), "backend"),
    2:         (lambda p: p.update(inference_substrate="live_model"), "inference"),
    2:         (lambda p: p.update(duration_s=0.0), "duration_s"),
    2:         (lambda p: p.update(reproducibility_checksum="short"), "sha256"),
    2:         (lambda p: p.update(reproducibility_checksum="0" * 64), "does not match"),
    2:         (lambda p: p.update(model_specs={}), "model_specs"),
    2:         (lambda p: p.update(copied_marker="GGUF"), "compute-bound markers"),
           ],
       )
