>>>>>>     if isinstance(self.ref_or_view, TransformedRef):
>>>>>>       view = self.ref_or_view
>>>>>>       return TransformedRef(view.ref, (*view.transforms, indexer))
>>>>>>     return TransformedRef(self.ref_or_view, (indexer,))
       
       
