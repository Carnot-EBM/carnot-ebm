       # We register the TransformedRefs with the tracing registry here, but not other
       # registries. This allows us to treat TransformedRefs as pytree nodes
       # internally, but as leaves in user code.
    1: unflatten_func = lambda meta, data: TransformedRef(*data)
    1: flatten_func = lambda x: ((x.ref, x.transforms), None)
    2: tracing_registry.register_dataclass_node(TransformedRef,
    1:                                          ["ref", "transforms"], [])
    1: _registry[TransformedRef] = _RegistryEntry(flatten_func, unflatten_func)
       
       
