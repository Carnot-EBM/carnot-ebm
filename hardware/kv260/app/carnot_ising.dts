/*
 * Device-tree overlay for the Carnot Ising sampler on KV260.
 *
 * Why this file exists:
 *   xmutil loadapp reprograms the PL region, but the kernel still needs a
 *   device-tree node describing the new fabric-side peripherals so user-space
 *   drivers (or /dev/mem mmap) can find them.  Without this overlay the PL
 *   loads silently but no peripheral appears under /sys/bus/platform — the
 *   fabric "exists" but no OS-visible handle.
 *
 * What this overlay declares:
 *   One AXI-Lite slave at 0xA000_0000, 128 KB window (matching the address
 *   assignment from hardware/kv260/build_bd.tcl: assign_bd_address picks
 *   0xA000_0000 [128K] for the ising_sampler_128_sync cell).  Clock source is
 *   pl_clk0 from the PS (CLK_LPD[0] = 0x47 for K26).  Compatible string is
 *   generic-uio so userspace can mmap /dev/uio* without a kernel driver —
 *   this matches the AXI mmap flow in
 *   scripts/experiment_661_kv260_n64_benchmark.py (KRIA_AXI_HELPER block).
 *
 *   If/when we write a proper in-kernel driver, flip the compatible string to
 *   "carnot,ising-sampler-v1" and load that module before xmutil loadapp.
 */
/dts-v1/;
/plugin/;

/ {
	compatible = "xlnx,zynqmp";

	/*
	 * Fragment 0: request pl_clk0 (FCLK_CLK0) at 40 MHz via the Kria
	 * fclk_cfg manager.  Kria's xmutil loadapp reads this and programs
	 * the clock BEFORE the fabric is activated — critical, because the
	 * sampler's AXI slave won't respond to anything if the AXI aclk is
	 * dark, which causes PS-side AXI transactions to hang the CPU
	 * (observed in Exp 661 first attempt: whole board went unreachable).
	 *
	 * Do NOT re-bind the clock at the peripheral node below (clocks = ...)
	 * — that triggers a second clock-framework request that fights with
	 * fclk_cfg and sometimes ends up with the PL running at 0 Hz.
	 */
	fragment@0 {
		target-path = "/";
		__overlay__ {
			firmware-name = "carnot_ising_v2_n64.bit.bin";
			clocking0: clocking0 {
				#clock-cells = <0>;
				compatible = "xlnx,fclk";
				clocks = <&zynqmp_clk 0x47>;
				assigned-clocks = <&zynqmp_clk 0x47>;
				assigned-clock-rates = <40000000>;
			};
		};
	};

	/* Fragment 1: AXI-Lite slave as a UIO device.  User-space opens
	 * /dev/uio<N> and mmaps the register window — kernel FPGA-manager/UIO
	 * core handles the AXI timing properly, so a malformed access gets
	 * a bus error on the user side rather than hanging the PS. */
	fragment@1 {
		target = <&amba>;
		__overlay__ {
			#address-cells = <2>;
			#size-cells = <2>;

			ising_sampler@a0000000 {
				compatible = "generic-uio";
				reg = <0x0 0xa0000000 0x0 0x20000>;  /* 128 KB @ 0xA000_0000 */
				status = "okay";
			};
		};
	};
};
