[Unit]
Description=Carnot ARC-AGI-3 competition news watch (daily, codex web search)
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/home/ianblenke/github.com/ianblenke/carnot
Environment=PATH=/home/ianblenke/github.com/Carnot-EBM/carnot-ebm/.venv/bin:/home/ianblenke/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/home/ianblenke/github.com/Carnot-EBM/carnot-ebm/.venv/bin/python scripts/arc_news_watch.py
StandardOutput=journal
StandardError=journal
