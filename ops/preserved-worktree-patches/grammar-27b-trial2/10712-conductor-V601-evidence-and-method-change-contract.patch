+    bad_blocked["gate_check_summary"] = {}
+    bad_blocked["verdict_class"] = "positive"
+    blocked_errors = mod.validate_artifact(bad_blocked)
+    assert "blocked_contract_requires_exact_failed_check" in blocked_errors
