+def test_validator_rejects_every_readiness_shape_error() -> None:
+    # REQ-REPORT-6865
+    artifact = mod.build_artifact(REPO_ROOT, "20260902", live_reports={})
+
+    malformed = deepcopy(artifact)
+    del malformed["schema"]
