+    current_but_missing = mod.active_roadmap_check(
+        {"milestone": mod.EXPECTED_ACTIVE_MILESTONE, "tasks": []}
+    )
+    assert current_but_missing["observed"] == {
+        "task_id": mod.EXP6865_TASK_ID,
+        "deliverable": None,
