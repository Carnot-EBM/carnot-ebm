+    bg = int(np.bincount(grid.ravel()).argmax())
+    colors = [int(c) for c in np.unique(grid) if int(c) != bg]
+
+    counts = {c: int(np.sum(grid == c)) for c in colors}
+    outline = max(colors, key=lambda c: counts[c])
+
+    fill = None
+    best = None
+    for c in colors:
+        if c == outline:
+            continue
+        adj = 0
+        for r, col in np.argwhere(grid == c):
+            for dr in (-1, 0, 1):
+                for dc in (-1, 0, 1):
+                    if dr == 0 and dc == 0:
+                        continue
+                    nr, nc = r + dr, col + dc
+                    if 0 <= nr < h and 0 <= nc < w and grid[nr, nc] == outline:
+                        adj += 1
+        score = (adj, counts[c], -c)
+        if best is None or score > best:
+            best = score
+            fill = c
+
+    barrier = set(map(tuple, np.argwhere((grid != bg) & (grid != fill))))
+    outline_cells = set(map(tuple, np.argwhere(grid == outline)))
+    dirs8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if dr or dc]
+
+    for r, c in list(outline_cells):
+        neigh = []
+        for dr, dc in dirs8:
+            if (r + dr, c + dc) in outline_cells:
+                neigh.append((dr, dc))
+        if len(neigh) == 1:
+            dr, dc = neigh[0]
+            if dr != 0 and dc != 0:
+                nr, nc = r - dr, c - dc
+                while 0 <= nr < h and 0 <= nc < w:
+                    barrier.add((nr, nc))
+                    nr -= dr
+                    nc -= dc
+
+    seed_cells = np.argwhere(grid == fill)
+    sr, sc = seed_cells.mean(axis=0)
+
+    for c in colors:
+        if c == outline or c == fill:
+            continue
+        remaining = set(map(tuple, np.argwhere(grid == c)))
+        while remaining:
+            start = remaining.pop()
+            comp = [start]
+            stack = [start]
+            while stack:
+                r, col = stack.pop()
+                for dr, dc in dirs8:
+                    q = (r + dr, col + dc)
+                    if q in remaining:
+                        remaining.remove(q)
+                        stack.append(q)
+                        comp.append(q)
+            if len(comp) > 1:
+                cr = sum(p[0] for p in comp) / len(comp)
+                cc = sum(p[1] for p in comp) / len(comp)
+                dr = 0 if abs(cr - sr) < 0.5 else (1 if cr > sr else -1)
+                dc = 0 if abs(cc - sc) < 0.5 else (1 if cc > sc else -1)
+                if dr or dc:
+                    for r, col in comp:
