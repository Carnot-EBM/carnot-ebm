+
+            reachable = np.zeros((bh, bw), dtype=bool)
+            stack = []
+            for r in range(bh):
+                for c in (0, bw - 1):
+                    if not wall[r, c] and not reachable[r, c]:
+                        reachable[r, c] = True
+                        stack.append((r, c))
+            for c in range(bw):
+                for r in (0, bh - 1):
+                    if not wall[r, c] and not reachable[r, c]:
