+            "code": "def transform(grid):\n    H, W = grid.shape\n\n    pats = [\n        (\"up\",    (2, 3), [(0, 1), (1, 0), (1, 1), (1, 2)], (1, 1), (0, 1), (-1, 0)),\n        (\"down\",  (2, 3), [(0, 0), (0, 1), (0, 2), (1, 1)], (0, 1), (1, 1), (1, 0)),\n        (\"left\",  (3, 2), [(0, 1), (1, 0), (1, 1), (2, 1)], (1, 1), (1, 0), (0, -1)),\n        (\"right\", (3, 2), [(0, 0), (1, 0), (1, 1), (2, 0)], (1, 0), (1, 1), (0, 1)),\n    ]\n\n    markers = []\n    marked = set()\n\n    for _, (ph, pw), cells, joint, tip, delta in pats:\n        allcells = {(r, c) for r in range(ph) for c in range(pw)}\n        offcells = list(allcells - set(cells))\n        for r in range(H - ph + 1):\n            for c in range(W - pw + 1):\n                ok = True\n                pos = [(r + a, c + b) for a, b in cells]\n                joint_pos = (r + joint[0], c + joint[1])\n\n                for a, b in cells:\n                    rr, cc = r + a, c + b\n                    if (rr, cc) == joint_pos:\n                        continue\n                    if grid[rr, cc] != 1:\n                        ok = False\n                        break\n                if not ok:\n                    continue\n\n                if grid[joint_pos] == 1:\n                    pass\n                elif grid[joint_pos] < 0:\n                    ok = False\n\n                if not ok:\n                    continue\n\n                for a, b in offcells:\n                    if grid[r + a, c + b] == 1:\n                        ok = False\n                        break\n                if not ok:\n                    continue\n\n                key = tuple(sorted(pos))\n                if key in marked:\n                    continue\n                marked.add(key)\n                markers.append({\n                    \"cells\": pos,\n                    \"joint\": joint_pos,\n                    \"tip\": (r + tip[0], c + tip[1]),\n                    \"delta\": delta,\n                })\n\