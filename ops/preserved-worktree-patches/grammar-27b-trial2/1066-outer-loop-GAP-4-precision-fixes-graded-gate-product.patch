+            if not is_fg[r, c]:
+                continue
+            orth = False
+            diag = False
+            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                rr, cc = r + dr, c + dc
+                if 0 <= rr < h and 0 <= cc < w and is_fg[rr, cc]:
+                    orth = True
+            for dr, dc in ((-1, -1), (-1, 1), (1, -1), (1, 1)):
+                rr, cc = r + dr, c + dc
+                if 0 <= rr < h and 0 <= cc < w and is_fg[rr, cc]:
