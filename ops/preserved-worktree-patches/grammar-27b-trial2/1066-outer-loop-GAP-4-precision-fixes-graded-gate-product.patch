+===== RAW OUTPUT =====
+```python
+def transform(grid):
+    out = grid.copy()
+    h, w = grid.shape
+
+    pts2 = np.argwhere(grid == 2)
+    cr, cc = pts2[0]
+
+    obj = [(r, c) for r in range(h) for c in range(w)
+           if abs(r - cr) <= 1 and abs(c - cc) <= 1]
+
+    def component_from(sr, sc):
+        seen = np.zeros((h, w), dtype=bool)
+        q = [(sr, sc)]
+        seen[sr, sc] = True
+        cells = []
+        while q:
+            r, c = q.pop(0)
+            cells.append((r, c))
+            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and grid[nr, nc] != 6:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        return cells, seen
+
+    comp, in_comp = component_from(cr, cc)
+    comp9 = [(r, c) for r, c in comp if grid[r, c] == 9]
+
+    # No walls: outside marks act from the upper/left side of the target.
+    if not np.any(grid == 6):
+        out[grid == 9] = 7
+        for r, c in comp9:
+            if r < cr:
+                dc = -1 if c < cc else (1 if c > cc else 0)
+                out[cr - 1, cc + dc] = 9
+            if c < cc:
+                dr = -1 if r < cr else (1 if r > cr else 0)
+                out[cr + dr, cc - 1] = 9
+        out[cr, cc] = 2
+        return out
+
+    rs = [r for r, c in comp]
+    cs = [c for r, c in comp]
+    minr, maxr = min(rs), max(rs)
+    minc, maxc = min(cs), max(cs)
+
+    # Open wall layout: the reachable marks fill the whole target; marks
+    # beyond the upper separating wall remain as the outside pattern.
+    if minr == 0 and maxr == h - 1 and minc == 0 and maxc == w - 1:
+        wall_rows = []
+        for r in range(cr):
+            run = 0
+            best = 0
+            for c in range(w):
+                if grid[r, c] == 6:
+                    run += 1
+                    best = max(best, run)
+                else:
+                    run = 0
+            if best >= 4:
+                wall_rows.append(r)
+        top_wall = max(wall_rows) if wall_rows else cr
+
+        for r, c in comp9:
+            if not (r < top_wall and not (r == top_wall - 2 and c == cc + 1)):
+                out[r, c] = 7
+
+        for r, c in obj:
+            out[r, c] = 9
+        return out
+
+    # Closed/local region: project reachable 9s into the 3x3 target by
+    # their position in that region, reversed toward the center.
+    for r, c in comp9:
+        out[r, c] = 7
+        br = int((r - minr) * 3 // (maxr - minr + 1))
+        bc = int((c - minc) * 3 // (maxc - minc + 1))
+        br = min(2, max(0, br))
+        bc = min(2, max(0, bc))
+        out[cr + 1 - br, cc + 1 - bc] = 9
+
+    out[cr, cc] = 2
+    return out
+```
