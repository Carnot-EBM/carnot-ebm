+    r1, c1 = zero_pos.max(axis=0)
+    h, w = r1 - r0 + 1, c1 - c0 + 1
+
+    out = np.zeros((h, w), dtype=int)
+
+    legend = []
+    for r in range(r0, r1 + 1):
