+        count = 0
+        rows, cols = mask.shape
+
+        for sr, sc in np.argwhere(mask):
+            if seen[sr, sc]:
+                continue
+            count += 1
+            stack = [(sr, sc)]
+            seen[sr, sc] = True
+            while stack:
+                r, c = stack.pop()
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = r + dr, c + dc
+                    if 0 <= nr < rows and 0 <= nc < cols and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+        return count
+
+    for color, rr, cc in legend:
