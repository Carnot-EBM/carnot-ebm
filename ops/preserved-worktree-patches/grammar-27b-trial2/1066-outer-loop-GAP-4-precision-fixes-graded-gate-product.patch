+    bg = vals[order[0]]
+    wall = vals[order[1]]
+
+    h, w = grid.shape
+    out = grid.copy()
+    visited = np.zeros((h, w), dtype=bool)
+    dirs = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+    for sr in range(h):
