+            "code": "def transform(grid):\n    bg = np.bincount(grid.ravel()).argmax()\n    vals, cnts = np.unique(grid, return_counts=True)\n    counts = {int(v): int(c) for v, c in zip(vals, cnts)}\n\n    non_bg = [c for c in counts if c != bg]\n    frame = max(non_bg, key=lambda c: counts[c])\n\n    # The stray marker color is the tiny non-background color; keep the frame\n    # and all colors with enough mass to belong to the fragments.\n    keep = set(c for c in non_bg if counts[c] > 3)\n    keep.add(frame)\n\n    h0, w0 = grid.shape\n    mask = np.isin(grid, list(keep))\n    seen = np.zeros(grid.shape, dtype=bool)\n    pieces = []\n\n    for sr in range(h0):\n        for sc in range(w0):\n            if not mask[sr, sc] or seen[sr, sc]:\n                continue\n\n            stack = [(sr, sc)]\n            seen[sr, sc] = True\n            cells = []\n\n            while stack:\n                r, c = stack.pop()\n                cells.append((r, c))\n                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nr, nc = r + dr, c + dc\n                    if 0 <= nr < h0 and 0 <= nc < w0 and mask[nr, nc] and not seen[nr, nc]:\n                        seen[nr, nc] = True\n                        stack.append((nr, nc))\n\n            rs = [p[0] for p in cells]\n            cs = [p[1] for p in cells]\n            rmin, cmin = min(rs), min(cs)\n            rel = [(r - rmin, c - cmin, int(grid[r, c])) for r, c in cells]\n            pieces.append({\n                \"orig\": (rmin, cmin),\n                \"h\": max(rs) - rmin + 1,\n                \"w\": max(cs) - cmin + 1,\n                \"cells\": rel,\n                \"area\": len(rel),\n            })\n\n    total = sum(p[\"area\"] for p in pieces)\n    dims = []\n    for h in range(1, h0 + 1):\n        if total % h == 0:\n            w = total // h\n            if w <= w0:\n                dims.append((h, w))\n    dims.sort(key=lambda x: (abs(x[0] - x[1]), x[0] + x[1]))\n\n    def solve_pack(H, W):\n        board = np.full((H, W), -1, dtype=int)\n        used = [False] * len(pieces)\n        placed = [None] * len(pieces)\n\n        order_cells = [p[\"cells\"] for p in pieces]\n\n        def can_place(i, tr, tc):\n            for r, c, v in order_cells[i]:\n                rr, cc = tr + r, tc + c\n                if rr < 0 or rr >= H or cc < 0 or cc >= W:\n                    return False\n                if board[rr, cc] != -1:\n                    return False\n                if (rr == 0 or rr == H - 1 or cc == 0 or cc == W - 1) and v != frame:\n                    return False\n            return True\n\n        def put(i, tr, tc, val):\n            for r, c, v in order_cells[i]:\n                board[tr + r, tc + c] = v if val else -1\n\n        def first_empty():\n            for r in range(H):\n                for c in range(W):\n                    if board[r, c] == -1:\n                        return r, c\n            return None\n\n        def backtrack(n):\n            if n == len(pieces):\n                return True\n\n            empty = first_empty()\n            if empty is None:\n                return True\n            er, ec = empty\n\n            cand = []\n            for i, p in enumerate(pieces):\n                if used[i]:\n                    continue\n                for pr, pc, _ in p[\"cells\"]:\n                    tr, tc = er - pr, ec - pc\n                    if can_place(i, tr, tc):\n                        cand.append((i, tr, tc))\n\n            cand.sort(key=lambda x: -pieces[x[0]][\"area\"])\n\n            for i, tr, tc in cand:\n                used[i] = True\n                placed[i] = (tr, tc)\n                put(i, tr, tc, True)\n                if backtrack(n + 1):\n                    return True\n                put(i, tr, tc, False)\n                placed[i] = None\n                used[i] = False\n\n            return False\n\n        if backtrack(0):\n            return board.copy(), placed[