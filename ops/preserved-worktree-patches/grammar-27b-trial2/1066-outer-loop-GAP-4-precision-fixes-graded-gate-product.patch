+            "code": "def transform(grid):\n    h, w = grid.shape\n    g = grid.copy()\n\n    def neigh4(r, c):\n        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < h and 0 <= cc < w:\n                yield rr, cc\n\n    def norm(cells):\n        rs = [p[0] for p in cells]\n        cs = [p[1] for p in cells]\n        r0, c0 = min(rs), min(cs)\n        return tuple(sorted((r - r0, c - c0) for r, c in cells))\n\n    def canonical(cells):\n        pts = list(cells)\n        forms = []\n        for k in range(8):\n            q = []\n            for r, c in pts:\n                if k == 0:\n                    x, y = r, c\n                elif k == 1:\n                    x, y = r, -c\n                elif k == 2:\n                    x, y = -r, c\n                elif k == 3:\n                    x, y = -r, -c\n                elif k == 4:\n                    x, y = c, r\n                elif k == 5:\n                    x, y = c, -r\n                elif k == 6:\n                    x, y = -c, r\n                else:\n                    x, y = -c, -r\n                q.append((x, y))\n            forms.append(norm(q))\n        return min(forms)\n\n    seen = np.zeros((h, w), dtype=bool)\n    marks = []\n\n    for r in range(h):\n        for c in range(w):\n            if g[r, c] != 1 or seen[r, c]:\n                continue\n\n            stack = [(r, c)]\n            comp = []\n            seen[r, c] = True\n            while stack:\n                p = stack.pop()\n                comp.append(p)\n                for q in neigh4(*p):\n                    if not seen[q] and g[q] == 1:\n                        seen[q] = True\n                        stack.append(q)\n\n            border = []\n            for p in comp:\n                for q in neigh4(*p):\n                    if g[q] != 1:\n                        border.append(int(g[q]))\n            if not border:\n                continue\n            bg = max(set(border), key=border.count)\n\n            cells = set(comp)\n            labels = []\n            changed = True\n            while changed:\n                changed = False\n                for p in list(cells):\n                    for q in neigh4(*p):\n                        v = int(g[q])\n                        if q not in cells and v != 1 and v != bg:\n                            same_bg = 0\n                            for x in neigh4(*q):\n                                if int(g[x]) == bg or x in cells:\n                                    same_bg += 1\n                            if same_bg >= 2:\n                                cells.add(q)\n                                labels.append(v)\n                                changed = True\n\n            marks.append({\"cells\": cells, \"shape\": canonical(cells), \"bg\": bg, \"labels\": labels})\n            for p in cells:\n                g[p] = bg\n\n    # Also catch small non-1 islands embedded inside a different color.\n    seen2 = np.zeros((h, w), dtype=bool)\n    for r in range(h):\n        for c in range(w):\n            if seen2[r, c]:\n                continue\n            col = int(grid[r, c])\n            stack = [(r, c)]\n            comp = []\n            seen2[r, c] = True\n            while stack:\n                p = stack.pop()\n                comp.append(p)\n                for q in neigh4(*p):\n                    if not seen2[q] and int(grid[q]) == col:\n                        seen2[q] = True\n                        stack.append(q)\n            if col == 1 or len(comp) > 9:\n                continue\n            border = []\n            for p in comp:\n                for q in neigh4(*p):\n                    if q not in comp and int(grid[q]) != 1:\n                        border.append(int(grid[q]))\n            if border:\n                bg = max(set(border), key=border.count)\n                if bg != col and border.count(bg) >= len(border) - 1:\n                    cells = set(comp)\n                    marks.append({\"cells\": cells, \"shape\": canonical(cells), \"bg\": bg, \"labels\": [col]})\n                    for p in cells:\n                        g[p] = bg\n\n    by_shape = {}\n    for m in marks:\n        by_shape.setdefault(m[\"shape\"], []).append(m)\n\n    cmap = {}\n    for shape, ms in by_shape.items():\n        plain = [m for m in ms if not m[\"labels\"]]\n        labeled = [m for m in ms if m[\"labels\"]]\n        if plain and labeled:\n            for m in plain:\n                labs = []\n                for x in labeled:\n                    labs += x[\"labels\"]\n                if labs:\n                    cmap[m[\"bg\"]] = max(set(labs), key=labs.count)\n            pbg = plain[0][\"bg\"]\n            for m in labeled:\n                cmap[m[\"bg\"]] = pbg\n\n    for m in marks:\n        if m[\"bg\"] not in cmap and m[\"labels\"]:\n            labs = m[\"labels\"]\n            cmap[m[\"bg\"]] = max(set(labs), key=labs.count)\n\n    out = g.copy()\n    for color, new_color in cmap.items():\n        out[g == color] = new_color\n\n    return out.T if h != w else out",
