+            a -= 1
+        b = c
+        while b + 1 < w and keep[r, b + 1]:
+            b += 1
+        return b - a + 1
+
+    def vert_run_len(r, c):
+        a = r
+        while a - 1 >= 0 and keep[a - 1, c]:
+            a -= 1
+        b = r
+        while b + 1 < h and keep[b + 1, c]:
+            b += 1
+        return b - a + 1
+
+    rem_pts = np.argwhere(removed)
+
+    for r in range(h):
+        cols = np.where(keep[r])[0]
+        for a, b in zip(cols, cols[1:]):
+            gap = b - a - 1
+            if gap <= 0 or gap > 5:
+                continue
+            if horiz_run_len(r, a) < 2 and horiz_run_len(r, b) < 2:
+                continue
+            ok = False
+            for rr, cc in rem_pts:
+                if a < cc < b and (abs(rr - r) == abs(cc - a) or abs(rr - r) == abs(cc - b)):
+                    ok = True
+                    break
+            if ok:
+                out[r, a:b + 1] = fg
+
+    for c in range(w):
+        rows = np.where(keep[:, c])[0]
+        for a, b in zip(rows, rows[1:]):
