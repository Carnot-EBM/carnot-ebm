+            "code": "def transform(grid):\n    bg = int(np.bincount(grid.ravel(), minlength=10).argmax())\n    counts = np.bincount(grid.ravel(), minlength=10)\n    non_bg = [c for c in range(10) if c != bg and counts[c] > 0]\n    border = max(non_bg, key=lambda c: counts[c])\n\n    allowed = {border}\n    for c in non_bg:\n        if counts[c] >= 4:\n            allowed.add(c)\n\n    valid = np.zeros(grid.shape, dtype=bool)\n    for c in allowed:\n        valid |= (grid == c)\n\n    R, C = grid.shape\n    seen = np.zeros_like(valid, dtype=bool)\n    rects = []\n\n    def edge_ok(a):\n        return (\n            np.all(a[0, :] == border) or\n            np.all(a[-1, :] == border) or\n            np.all(a[:, 0] == border) or\n            np.all(a[:, -1] == border)\n        )\n\n    for sr in range(R):\n        for sc in range(C):\n            if not valid[sr, sc] or seen[sr, sc]:\n                continue\n\n            q = [(sr, sc)]\n            seen[sr, sc] = True\n            cells = []\n            for r, c in q:\n                cells.append((r, c))\n                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nr, nc = r + dr, c + dc\n                    if 0 <= nr < R and 0 <= nc < C and valid[nr, nc] and not seen[nr, nc]:\n                        seen[nr, nc] = True\n                        q.append((nr, nc))\n\n            rs = [p[0] for p in cells]\n            cs = [p[1] for p in cells]\n            r0, r1, c0, c1 = min(rs), max(rs), min(cs), max(cs)\n            submask = valid[r0:r1 + 1, c0:c1 + 1]\n\n            if np.all(submask):\n                a = grid[r0:r1 + 1, c0:c1 + 1]\n                if a.shape[0] >= 2 and a.shape[1] >= 2 and border in a and edge_ok(a):\n                    rects.append((r0, c0, a.copy()))\n                continue\n\n            rem = submask.copy()\n            while np.any(rem):\n                best = None\n                h0, w0 = rem.shape\n                pref = np.pad(rem.astype(int), ((1, 0), (1, 0))).cumsum(0).cumsum(1)\n\n                for a0 in range(h0):\n                    for b0 in range(w0):\n                        if not rem[a0, b0]:\n                            continue\n                        for a1 in range(a0 + 1, h0):\n                            for b1 in range(b0 + 1, w0):\n                                area = (a1 - a0 + 1) * (b1 - b0 + 1)\n                                s = pref[a1 + 1, b1 + 1] - pref[a0, b1 + 1] - pref[a1 + 1, b0] + pref[a0, b0]\n                                if s != area:\n                                    continue\n                                a = grid[r0 + a0:r0 + a1 + 1, c0 + b0:c0 + b1 + 1]\n                                if border in a and edge_ok(a):\n                                    if best is None or area > best[0]:\n                                        best = (area, a0, a1, b0, b1)\n\n                if best is None:\n                    break\n\n                _, a0, a1, b0, b1 = best\n                rects.append((r0 + a0, c0 + b0, grid[r0 + a0:r0 + a1 + 1, c0 + b0:c0 + b1 + 1].copy()))\n                rem[a0:a1 + 1, b0:b1 + 1] = False\n\n    rects.sort(key=lambda x: (x[0], x[1]))\n    pieces = [x[2] for x in rects]\n    if not pieces:\n        return grid.copy()\n\n    area = sum(p.size for p in pieces)\n    maxh = max(p.shape[0] for p in pieces)\n    maxw = max(p.shape[1] for p in pieces)\n\n    candidates = []\n    for h in range(maxh, area + 1):\n        if area % h == 0:\n            w = area // h\n            if w >= maxw:\n                candidates.append((h, w))\n    candidates.sort(key=lambda hw: (hw[0] > hw[1], abs(hw[1] / hw[0] - 1.6)))\n\n    solution = None\n\n    def fits_boundary(p, y, x, H, W):\n        h, w = p.shape\n        if y == 0 and not np.all(p[0, :] == border):\n            return False\n        if y + h == H and not np.all(p[-1, :] == border):\n            return False\n        if x == 0 and not np.all(p[:, 0] == border):\n            return False\n   