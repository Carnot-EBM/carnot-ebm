+            "code": "def transform(grid):\n    h, w = grid.shape\n    bg = np.bincount(grid.ravel()).argmax()\n    out = grid.copy()\n\n    seen = np.zeros((h, w), dtype=bool)\n    comps = []\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r, c] == 1 and not seen[r, c]:\n                stack = [(r, c)]\n                seen[r, c] = True\n                comp = []\n\n                while stack:\n                    cr, cc = stack.pop()\n                    comp.append((cr, cc))\n                    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nr, nc = cr + dr, cc + dc\n                        if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and grid[nr, nc] == 1:\n                            seen[nr, nc] = True\n                            stack.append((nr, nc))\n\n                comps.append(comp)\n\n    comp_infos = []\n    for comp in comps:\n        rs = [p[0] for p in comp]\n        cs = [p[1] for p in comp]\n        r0, r1 = min(rs), max(rs)\n        c0, c1 = min(cs), max(cs)\n\n        bh, bw = r1 - r0 + 1, c1 - c0 + 1\n        blocked = np.zeros((bh, bw), dtype=bool)\n        for r, c in comp:\n            blocked[r - r0, c - c0] = True\n\n        reachable = np.zeros((bh, bw), dtype=bool)\n        stack = []\n        for rr in range(bh):\n            for cc in range(bw):\n                if rr in (0, bh - 1) or cc in (0, bw - 1):\n                    if not blocked[rr, cc] and not reachable[rr, cc]:\n                        reachable[rr, cc] = True\n                        stack.append((rr, cc))\n\n        while stack:\n            rr, cc = stack.pop()\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                nr, nc = rr + dr, cc + dc\n                if 0 <= nr < bh and 0 <= nc < bw and not blocked[nr, nc] and not reachable[nr, nc]:\n                    reachable[nr, nc] = True\n                    stack.append((nr, nc))\n\n        holes = []\n        for rr in range(bh):\n            for cc in range(bw):\n                gr, gc = r0 + rr, c0 + cc\n                if not blocked[rr, cc] and not reachable[rr, cc] and grid[gr, gc] == bg:\n                    holes.append((gr, gc))\n\n        comp_infos.append((comp, holes))\n\n    for comp, holes in comp_infos:\n        if holes:\n            for r, c in comp:\n                out[r, c] = 8\n            for r, c in holes:\n                out[r, c] = 6\n\n    for comp, holes in comp_infos:\n        shape = comp + holes\n        for r, c in shape:\n            for dr in (-1, 0, 1):\n                for dc in (-1, 0, 1):\n                    nr, nc = r + dr, c + dc\n                    if 0 <= nr < h and 0 <= nc < w and out[nr, nc] == bg:\n                        out[nr, nc] = 2\n\n    return out",
