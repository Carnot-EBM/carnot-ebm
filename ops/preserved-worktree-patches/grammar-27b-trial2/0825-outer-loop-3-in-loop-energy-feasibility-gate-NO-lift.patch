+    return {
+        "artifact_path": EXP3915_ARTIFACT_REL_PATH.as_posix(),
+        "artifact_sha256": _sha256_file(artifact_path),
+        "harness_module_path": str(artifact.get("harness_module_path") or GGUF_HARNESS_MODULE_PATH),
