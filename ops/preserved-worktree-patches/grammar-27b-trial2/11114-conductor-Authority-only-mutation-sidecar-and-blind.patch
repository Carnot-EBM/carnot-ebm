+def _path_writable(path: Path) -> bool:
+    try:
+        path.mkdir(parents=True, exist_ok=True)
+        descriptor, name = tempfile.mkstemp(prefix=".exp6997-write-probe-", dir=path)
+        os.close(descriptor)
+        Path(name).unlink()
+        return True
+    except OSError:
+        return False
+
