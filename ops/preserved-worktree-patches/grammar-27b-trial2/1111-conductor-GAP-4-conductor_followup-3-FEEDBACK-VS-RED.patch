+          "code": "def transform(grid):\n    g = np.array(grid)\n    H0, W0 = g.shape\n\n    vals, cnts = np.unique(g, return_counts=True)\n    bg = vals[np.argmax(cnts)]\n\n    counts = {int(v): int(c) for v, c in zip(vals, cnts) if int(v) != int(bg)}\n    border = max(counts, key=lambda k: counts[k])\n    target = {c for c, n in counts.items() if c == border or n >= 4}\n\n    mask = np.isin(g, list(target))\n    seen = np.zeros(g.shape, dtype=bool)\n    pieces = []\n\n    for r in range(H0):\n        for c in range(W0):\n            if not mask[r, c] or seen[r, c]:\n                continue\n            stack = [(r, c)]\n            seen[r, c] = True\n            cells = []\n            while stack:\n                y, x = stack.pop()\n                cells.append((y, x))\n                for dy, dx in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    ny, nx = y + dy, x + dx\n                    if 0 <= ny < H0 and 0 <= nx < W0 and mask[ny, nx] and not seen[ny, nx]:\n                        seen[ny, nx] = True\n                        stack.append((ny, nx))\n\n            rows = [p[0] for p in cells]\n            cols = [p[1] for p in cells]\n            r1, r2 = min(rows), max(rows)\n            c1, c2 = min(cols), max(cols)\n            submask = mask[r1:r2 + 1, c1:c2 + 1]\n\n            if submask.all():\n                pieces.append(g[r1:r2 + 1, c1:c2 + 1].copy())\n            else:\n                row_ranges = []\n                ok = True\n                for yy in range(submask.shape[0]):\n                    xs = np.where(submask[yy])[0]\n                    if len(xs) == 0:\n                        row_ranges.append(None)\n                    elif xs[-1] - xs[0] + 1 == len(xs):\n                        row_ranges.append((int(xs[0]), int(xs[-1])))\n                    else:\n                        ok = False\n                        break\n                if ok:\n                    yy = 0\n                    while yy < len(row_ranges):\n                        if row_ranges[yy] is None:\n                            yy += 1\n                            continue\n                        a, b = row_ranges[yy]\n                        y2 = yy\n                        while y2 + 1 < len(row_ranges) and row_ranges[y2 + 1] == (a, b):\n                            y2 += 1\n                        arr = g[r1 + yy:r1 + y2 + 1, c1 + a:c1 + b + 1]\n                        if np.isin(arr, list(target)).all():\n                            pieces.append(arr.copy())\n                        yy = y2 + 1\n\n    pieces.sort(key=lambda a: (-a.size, -a.shape[0], -a.shape[1]))\n\n    total = sum(p.size for p in pieces)\n    maxh = max(p.shape[0] for p in pieces)\n    maxw = max(p.shape[1] for p in pieces)\n\n    candidates = []\n    for h in range(maxh, min(H0, total) + 1):\n        if total % h == 0:\n            w = total // h\n            if maxw <= w <= W0:\n                candidates.append((h, w))\n    candidates.sort(key=lambda hw: (abs((hw[1] / hw[0]) - (W0 / H0)), abs(hw[0] - hw[1])))\n\n    def side_ok(piece, y, x, h, w, OH, OW):\n        if y == 0 and not np.all(piece[0, :] == border):\n            return False\n        if y + h == OH and not np.all(piece[-1, :] == border):\n            return False\n        if x == 0 and not np.all(piece[:, 0] == border):\n            return False\n        if x + w == OW and not np.all(piece[:, -1] == border):\n            return False\n        return True\n\n    def pack(OH, OW):\n        occ = np.zeros((OH, OW), dtype=bool)\n        canvas = np.full((OH, OW), bg, dtype=g.dtype)\n        used = [False] * len(pieces)\n\n        def bt(n):\n            if n == len(pieces):\n                return (np.all(canvas[0, :] == border) and\n                        np.all(canvas[-1, :] == border) and\n                        np.all(canvas[:, 0] == border) and\n                        np.all(canvas[:, -1] == border))\n            pos = np.argwhere(~occ)\n            if len(pos) == 0:\n                return False\n            y, x = map(int, pos[0])\n\n            for i, p in enumerate(pieces):\n                if used[i]:\n                    continue\n                h, w = p.shape\n                if y + h > OH or x + w > OW:\n                    continue\n                if np.any(occ[y:y + h, x:x + w]):\n                    continue\n                if not side_ok(p, y, x, h, w, OH, OW):\n                    continue\n\n                used[i] = True\n                occ[y:y + h, x:x + w] = True\n                canvas[y:y + h, x:x + w] = p\n\n                if bt(n + 1):\n                    return True\n\n                used[i] = False\n                occ[y:y + h, x:x + w] = False\n                canvas[y:y + h, x:x + w] = bg\n            return False\n\n        return canvas if bt(0) else None\n\n    assembled = None\n    for h, w in candidates:\n        assembled = pack(h, w)\n        if assembled is not None:\n            break\n\n    if assembled is None:\n        return g.copy()\n\n    out = np.full_like(g, bg)\n    h, w = assembled.shape\n    top = max(0, H0 - h - 2)\n    left = max(0, W0 - w - 2)\n    out[top:top + h, left:left + w] = assembled\n    return out",
