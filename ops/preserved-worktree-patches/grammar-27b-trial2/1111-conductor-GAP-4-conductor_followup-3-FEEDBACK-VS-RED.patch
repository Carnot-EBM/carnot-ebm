+        "code": "def transform(grid):\n    g = grid\n    out = g.copy()\n    h, w = g.shape\n    bg = 8\n\n    sep_rows = [r for r in range(h) if len(set(g[r].tolist())) == 1 and g[r, 0] != bg]\n    first_sep, second_sep = sep_rows[0], sep_rows[-1]\n\n    mask = (g != bg)\n    for r in sep_rows:\n        mask[r, :] = False\n\n    row_has = mask.any(axis=1)\n    row_bands = []\n    r = 0\n    while r < h:\n        if row_has[r]:\n            s = r\n            while r < h and row_has[r]:\n                r += 1\n            row_bands.append((s, r - 1))\n        r += 1\n\n    col_has = mask.any(axis=0)\n    col_bands = []\n    c = 0\n    while c < w:\n        if col_has[c]:\n            s = c\n            while c < w and col_has[c]:\n                c += 1\n            col_bands.append((s, c - 1))\n        c += 1\n\n    row_starts = [a for a, b in row_bands]\n    col_starts = [a for a, b in col_bands]\n\n    top_rows = [r for r in row_starts if r < first_sep]\n    lib_rows = [r for r in row_starts if first_sep < r < second_sep]\n    top_r = top_rows[0]\n\n    def patch_at(r, c):\n        return g[r:r + 3, c:c + 3]\n\n    top_patterns = []\n    for ci, c in enumerate(col_starts):\n        p = patch_at(top_r, c)\n        if (p != bg).any():\n            top_patterns.append((ci, p.copy()))\n\n    matches = []\n    for ti, p in top_patterns:\n        for ri, r in enumerate(lib_rows):\n            for ci, c in enumerate(col_starts):\n                if patch_at(r, c).shape == p.shape and (patch_at(r, c) == p).all():\n                    matches.append((ti, ri, ci, r, c))\n\n    for _, _, _, r, c in matches:\n        for rr in range(max(0, r - 1), min(h, r + 4)):\n            for cc in range(max(0, c - 1), min(w, c + 4)):\n                if out[rr, cc] == bg:\n                    out[rr, cc] = 3\n\n    rows = [m[1] for m in matches]\n    cols = [m[2] for m in matches]\n    full_row = len(matches) == len(col_starts) and len(set(rows)) == 1 and len(set(cols)) == len(col_starts)\n    full_col = len(matches) == len(lib_rows) and len(set(cols)) == 1 and len(set(rows)) == len(lib_rows)\n    full_line = full_row or full_col\n\n    if full_line:\n        for rr in range(0, first_sep):\n            for cc in range(w):\n                if out[rr, cc] == bg:\n                    out[rr, cc] = 3\n\n    if full_row:\n        line_row = rows[0]\n        by_top = {ti: ci for ti, _, ci, _, _ in matches}\n        for ti, ci in by_top.items():\n            if ti == ci and line_row + 1 < len(lib_rows):\n                c = col_starts[ti]\n                src = patch_at(lib_rows[line_row + 1], c)\n                out[top_r:top_r + 3, c:c + 3] = 3\n                for rr in range(3):\n                    for cc in range(3):\n                        if src[rr, cc] != bg:\n                            out[top_r + rr, c + cc] = src[rr, cc]\n\n    fill = 3 if full_line else 2\n    for rr in range(second_sep + 1, h):\n        out[rr, :] = fill\n\n    return out",
