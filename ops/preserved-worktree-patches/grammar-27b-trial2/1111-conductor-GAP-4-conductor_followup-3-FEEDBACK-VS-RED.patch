+            qi = 0
+            while qi < len(layer_q):
+                r, c = layer_q[qi]
+                qi += 1
+                for dr, dc in dirs:
+                    nr, nc = r + dr, c + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and dist[nr, nc] < 0:
+                        dist[nr, nc] = dist[r, c] + 1
+                        layer_q.append((nr, nc))
+
+            seed_by_layer = {}
+            max_layer = -1
+            for r, c in comp:
