x_c = max(c + 5 for r, c, col in big)\n\n    out = np.full((max_r - min_r, max_c - min_c), bg, dtype=grid.dtype)\n\n    for r, c, col in big:\n        rr, cc = r - min_r, c - min_c\n        out[rr:rr+5, cc:cc+5] = col\n        pat = patterns[col]\n        for i in range(3):\n            for j in range(3):\n                if pat[i, j] == col:\n                    out[rr + 1 + i, cc + 1 + j] = bg\n\n    return out",
