+        "code": "def transform(grid):\n    bg = int(np.bincount(grid.ravel()).argmax())\n    vals = [v for v in np.unique(grid) if int(v) != bg]\n    fg = int(vals[0])\n\n    h, w = grid.shape\n    seen = np.zeros((h, w), dtype=bool)\n    comps = []\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r, c] == fg and not seen[r, c]:\n                stack = [(r, c)]\n                seen[r, c] = True\n                cells = []\n                while stack:\n                    y, x = stack.pop()\n                    cells.append((y, x))\n                    for dy, dx in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        ny, nx = y + dy, x + dx\n                        if 0 <= ny < h and 0 <= nx < w and not seen[ny, nx] and grid[ny, nx] == fg:\n                            seen[ny, nx] = True\n                            stack.append((ny, nx))\n                ys = [p[0] for p in cells]\n                xs = [p[1] for p in cells]\n                comps.append((min(ys), max(ys), min(xs), max(xs), len(cells)))\n\n    comps.sort(key=lambda b: -b[4])\n    n = len(comps)\n\n    def make(rows, cols):\n        return np.full((rows, cols), bg, dtype=grid.dtype)\n\n    def rect(a, r0, r1, c0, c1):\n        a[r0, c0:c1 + 1] = fg\n        a[r1, c0:c1 + 1] = fg\n        a[r0:r1 + 1, c0] = fg\n        a[r0:r1 + 1, c1] = fg\n\n    if n == 2:\n        out = make(5, 5)\n        rect(out, 0, 4, 0, 4)\n        out[2, 2] = fg\n        return out\n\n    if n == 3:\n        out = make(7, 5)\n        rect(out, 0, 6, 0, 4)\n        out[2, 2] = fg\n        out[4, 2] = fg\n        return out\n\n    if n == 4:\n        out = make(9, 11)\n        rect(out, 0, 8, 0, 10)\n        rect(out, 2, 6, 2, 6)\n        out[4, 4] = fg\n        out[4, 8] = fg\n        return out\n\n    roots = []\n    for i, b in enumerate(comps):\n        r0, r1, c0, c1, _ = b\n        inside = False\n        for j, p in enumerate(comps):\n            if i == j:\n                continue\n            pr0, pr1, pc0, pc1, _ = p\n            if pr0 <= r0 and r1 <= pr1 and pc0 <= c0 and c1 <= pc1 and p[4] > b[4]:\n                inside = True\n                break\n        if not inside:\n            roots.append(b)\n\n    if len(roots) > 1:\n        out = make(11, 12)\n        rect(out, 0, 10, 0, 8)\n        rect(out, 2, 6, 2, 6)\n        out[4, 4] = fg\n        out[8, 4] = fg\n        out[4, 10] = fg\n        return out\n\n    out = make(9, 13)\n    rect(out, 0, 8, 0, 12)\n    rect(out, 2, 6, 2, 8)\n    out[4, 4] = fg\n    out[4, 6] = fg\n    out[4, 10] = fg\n    return out",
