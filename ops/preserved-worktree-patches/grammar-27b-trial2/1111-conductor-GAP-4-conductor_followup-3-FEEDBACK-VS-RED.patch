+          "code": "def transform(grid):\n    bg = np.bincount(grid.ravel()).argmax()\n    vals, cnts = np.unique(grid, return_counts=True)\n    fg = vals[np.argmin(cnts)]\n\n    rs, cs = np.where(grid == fg)\n    r0, r1, c0, c1 = rs.min(), rs.max(), cs.min(), cs.max()\n    a = (grid[r0:r1 + 1, c0:c1 + 1] == fg)\n    h, w = a.shape\n\n    def levels(counts):\n        m = int(counts.max())\n        th = max(3, min(m, max(5, (m + 1) // 2)))\n        good = counts >= th\n        runs = []\n        i = 0\n        while i < len(good):\n            if not good[i]:\n                i += 1\n                continue\n            j = i\n            while j + 1 < len(good) and good[j + 1]:\n                j += 1\n            seg = np.arange(i, j + 1)\n            best = int(seg[np.argmax(counts[seg])])\n            runs.append((i, j, best))\n            i = j + 1\n\n        if not runs:\n            return [(0, len(counts) - 1, len(counts) // 2)]\n\n        merged = []\n        for run in runs:\n            if merged and run[2] - merged[-1][2] <= 2:\n                i0 = merged[-1][0]\n                j1 = run[1]\n                seg = np.arange(i0, j1 + 1)\n                best = int(seg[np.argmax(counts[seg])])\n                merged[-1] = (i0, j1, best)\n            else:\n                merged.append(run)\n        return merged\n\n    ylev = levels(a.sum(axis=1))\n    xlev = levels(a.sum(axis=0))\n\n    oh = 2 * len(ylev) - 1\n    ow = 2 * len(xlev) - 1\n    out = np.full((oh, ow), bg, dtype=grid.dtype)\n\n    def any_fg(rlo, rhi, clo, chi):\n        rlo = max(0, int(rlo))\n        rhi = min(h - 1, int(rhi))\n        clo = max(0, int(clo))\n        chi = min(w - 1, int(chi))\n        if rlo > rhi or clo > chi:\n            return False\n        return bool(a[rlo:rhi + 1, clo:chi + 1].any())\n\n    for i, yr in enumerate(ylev):\n        y0, y1, yc = yr\n        rr = 2 * i\n        for j, xr in enumerate(xlev):\n            x0, x1, xc = xr\n            cc = 2 * j\n            if any_fg(y0 - 1, y1 + 1, x0 - 1, x1 + 1):\n                out[rr, cc] = fg\n\n        for j in range(len(xlev) - 1):\n            left = xlev[j][2]\n            right = xlev[j + 1][2]\n            if any_fg(y0 - 1, y1 + 1, left, right):\n                out[rr, 2 * j + 1] = fg\n\n    for i in range(len(ylev) - 1):\n        top = ylev[i][2]\n        bot = ylev[i + 1][2]\n        rr = 2 * i + 1\n        for j, xr in enumerate(xlev):\n            x0, x1, xc = xr\n            if any_fg(top, bot, x0 - 1, x1 + 1):\n                out[rr, 2 * j] = fg\n\n    # Keep the clean rectangular frame implied by the outside enclosure.\n    out[0, :] = fg\n    out[-1, :] = fg\n    out[:, 0] = fg\n    out[:, -1] = fg\n\n    return out",
