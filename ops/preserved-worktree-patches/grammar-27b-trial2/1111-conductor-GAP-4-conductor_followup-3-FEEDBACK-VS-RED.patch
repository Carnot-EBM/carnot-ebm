+def transform(grid):
+    g = grid
+    H, W = g.shape
+
+    # Find 8-connected nonzero components; the large component is the object.
+    seen = np.zeros((H, W), dtype=bool)
+    comps = []
+    for r in range(H):
+        for c in range(W):
+            if g[r, c] != 0 and not seen[r, c]:
+                q = [(r, c)]
+                seen[r, c] = True
+                pts = []
+                while q:
+                    x, y = q.pop()
+                    pts.append((x, y))
+                    for dx in (-1, 0, 1):
+                        for dy in (-1, 0, 1):
+                            if dx == 0 and dy == 0:
+                                continue
+                            nx, ny = x + dx, y + dy
+                            if 0 <= nx < H and 0 <= ny < W and not seen[nx, ny] and g[nx, ny] != 0:
+                                seen[nx, ny] = True
+                                q.append((nx, ny))
+                comps.append(pts)
+
+    main = max(comps, key=len)
+    main_set = set(main)
+    rs = [p[0] for p in main]
+    cs = [p[1] for p in main]
+    r0, r1 = min(rs), max(rs)
+    c0, c1 = min(cs), max(cs)
+    crop = g[r0:r1 + 1, c0:c1 + 1]
+    h, w = crop.shape
+
+    out = np.zeros_like(crop)
+
+    def op_mask(mask, op):
+        if op == "lr":
+            return np.fliplr(mask)
+        if op == "ud":
+            return np.flipud(mask)
+        if op == "rot":
+            return np.rot90(mask, 2)
+        if op == "tr":
+            return mask.T
+        if op == "anti":
+            return np.fliplr(mask).T
+        return mask
+
+    # Outside clue components, grouped by color.
+    clues = {}
+    for pts in comps:
+        if pts is main:
+            continue
+        col = int(g[pts[0][0], pts[0][1]])
+        clues.setdefault(col, []).append(pts)
+
+    cr = (r0 + r1) / 2.0
+    cc = (c0 + c1) / 2.0
+
+    def choose_op(pts):
+        prs = [p[0] for p in pts]
+        pcs = [p[1] for p in pts]
+        ar = (min(prs) + max(prs)) / 2.0
+        ac = (min(pcs) + max(pcs)) / 2.0
+        dh = ar - cr
+        dw = ac - cc
+        ph = max(prs) - min(prs) + 1
+        pw = max(pcs) - min(pcs) + 1
+
+        if ph > pw:
+            if dh > 0 and dw < 0:
+                return "rot"
+            return "ud" if abs(dh) >= abs(dw) else "lr"
+
+        if pw > ph:
+            if dh < 0 and dw > 0:
+                return "anti"
+            if dh < 0 and dw < 0:
+                return "tr"
+            if dh > 0 and dw < 0:
+                return "rot"
+            return "lr" if abs(dw) >= abs(dh) else "ud"
+
+        if abs(dw) > abs(dh):
+            return "lr"
+        if abs(dh) > abs(dw):
+            return "ud"
+        if dh * dw < 0:
+            return "anti"
+        return "tr"
+
+    colors = [int(x) for x in np.unique(crop) if x != 0]
+    for col in colors:
+        mask = crop == col
+        if col in clues:
+            pts = max(clues[col], key=len)
+            op = choose_op(pts)
+            mask = op_mask(mask, op)
+        out[mask] = col
+
+    return out
