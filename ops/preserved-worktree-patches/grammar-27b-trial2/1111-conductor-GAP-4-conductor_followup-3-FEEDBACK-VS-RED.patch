+    bg = int(grid[0, 0])
+    h, w = grid.shape
+
+    # Find the small 3x5 "objects" by their middle row of five same-colored cells.
+    objs = []
+    for r in range(1, h - 1):
+        c = 0
+        while c <= w - 5:
+            vals = grid[r, c:c+5]
+            col = int(vals[0])
+            if col != bg and (vals == col).all():
