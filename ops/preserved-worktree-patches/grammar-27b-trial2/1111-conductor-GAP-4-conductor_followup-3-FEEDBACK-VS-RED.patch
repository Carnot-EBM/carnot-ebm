+          "code": "def transform(grid):\n    out = grid.copy()\n    h, w = grid.shape\n\n    vals, counts = np.unique(grid, return_counts=True)\n    bg = int(vals[np.argmax(counts)])\n\n    sep_rows = []\n    for r in range(h):\n        row = grid[r]\n        if np.all(row == row[0]) and row[0] != bg:\n            sep_rows.append(r)\n\n    if len(sep_rows) < 2:\n        return out\n\n    top_sep, bot_sep = sep_rows[0], sep_rows[-1]\n\n    def components(r0, r1):\n        seen = np.zeros((h, w), dtype=bool)\n        objs = []\n        for r in range(r0, r1):\n            for c in range(w):\n                if seen[r, c] or grid[r, c] == bg:\n                    continue\n                color = int(grid[r, c])\n                stack = [(r, c)]\n                seen[r, c] = True\n                cells = []\n                while stack:\n                    rr, cc = stack.pop()\n                    cells.append((rr, cc))\n                    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nr, nc = rr + dr, cc + dc\n                        if r0 <= nr < r1 and 0 <= nc < w:\n                            if not seen[nr, nc] and grid[nr, nc] == color:\n                                seen[nr, nc] = True\n                                stack.append((nr, nc))\n                objs.append({\"color\": color, \"cells\": cells})\n        return objs\n\n    query = components(0, top_sep)\n    catalog = components(top_sep + 1, bot_sep)\n    all_objs = query + catalog\n\n    row_score = {}\n    col_score = {}\n    for obj in all_objs:\n        rs = [p[0] for p in obj[\"cells\"]]\n        cs = [p[1] for p in obj[\"cells\"]]\n        for t in range(max(0, max(rs) - 2), min(min(rs), h - 3) + 1):\n            row_score[t] = row_score.get(t, 0) + 1\n        for l in range(max(0, max(cs) - 2), min(min(cs), w - 3) + 1):\n            col_score[l] = col_score.get(l, 0) + 1\n\n    def attach_tile(obj):\n        rs = [p[0] for p in obj[\"cells\"]]\n        cs = [p[1] for p in obj[\"cells\"]]\n        row_candidates = range(max(0, max(rs) - 2), min(min(rs), h - 3) + 1)\n        col_candidates = range(max(0, max(cs) - 2), min(min(cs), w - 3) + 1)\n        top = max(row_candidates, key=lambda x: (row_score.get(x, 0), -abs(x - min(rs))))\n        left = max(col_candidates, key=lambda x: (col_score.get(x, 0), -abs(x - min(cs))))\n        obj[\"top\"] = top\n        obj[\"left\"] = left\n        mask = []\n        color = obj[\"color\"]\n        for r in range(top, top + 3):\n            for c in range(left, left + 3):\n                mask.append(1 if grid[r, c] == color else 0)\n        obj[\"key\"] = (color, tuple(mask))\n\n    for obj in all_objs:\n        attach_tile(obj)\n\n    query_keys = {obj[\"key\"] for obj in query}\n    selected = [obj for obj in catalog if obj[\"key\"] in query_keys]\n\n    line_case = False\n    if selected and len(selected) == len(query):\n        rows = {obj[\"top\"] for obj in selected}\n        cols = {obj[\"left\"] for obj in selected}\n        line_case = len(rows) == 1 or len(cols) == 1\n\n    def paint_frame(top, left):\n        for r in range(max(0, top - 1), min(h, top + 4)):\n            for c in range(max(0, left - 1), min(w, left + 4)):\n                if out[r, c] == bg:\n                    out[r, c] = 3\n\n    if line_case:\n        for r in range(0, top_sep):\n            for c in range(w):\n                if out[r, c] == bg:\n                    out[r, c] = 3\n\n    for obj in selected:\n        paint_frame(obj[\"top\"], obj[\"left\"])\n\n    fill = 3 if line_case else 2\n    for r in range(bot_sep + 1, h):\n        out[r, :] = fill\n\n    return out",
