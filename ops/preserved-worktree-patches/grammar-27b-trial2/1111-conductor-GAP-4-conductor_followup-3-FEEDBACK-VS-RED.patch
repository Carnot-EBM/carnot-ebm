+        "code": "def transform(grid):\n    h, w = grid.shape\n    pts = np.argwhere(grid != 0)\n    if len(pts) == 0:\n        return grid.copy()\n\n    rows = sorted(set(int(r) for r, c in pts))\n    cols = sorted(set(int(c) for r, c in pts))\n\n    best = None\n    best_score = None\n    for r0 in rows:\n        for r1 in rows:\n            if r1 < r0:\n                continue\n            for c0 in cols:\n                for c1 in cols:\n                    if c1 < c0:\n                        continue\n                    area = (r1 - r0 + 1) * (c1 - c0 + 1)\n                    if area > 225:\n                        continue\n                    inside = np.count_nonzero(grid[r0:r1 + 1, c0:c1 + 1])\n                    if inside == 0:\n                        continue\n                    score = inside * 10 - area\n                    if best_score is None or score > best_score:\n                        best_score = score\n                        best = (r0, r1, c0, c1)\n\n    r0, r1, c0, c1 = best\n    crop = grid[r0:r1 + 1, c0:c1 + 1]\n    ch, cw = crop.shape\n\n    outside = grid.copy()\n    outside[r0:r1 + 1, c0:c1 + 1] = 0\n\n    def outside_components(color):\n        seen = np.zeros_like(outside, dtype=bool)\n        comps = []\n        for rr, cc in np.argwhere(outside == color):\n            rr, cc = int(rr), int(cc)\n            if seen[rr, cc]:\n                continue\n            q = [(rr, cc)]\n            seen[rr, cc] = True\n            comp = []\n            while q:\n                a, b = q.pop()\n                comp.append((a, b))\n                for da in (-1, 0, 1):\n                    for db in (-1, 0, 1):\n                        if da == 0 and db == 0:\n                            continue\n                        na, nb = a + da, b + db\n                        if 0 <= na < h and 0 <= nb < w and not seen[na, nb] and outside[na, nb] == color:\n                            seen[na, nb] = True\n                            q.append((na, nb))\n            comps.append(comp)\n        return comps\n\n    def apply(mask, kind):\n        if kind == \"h\":\n            return mask[:, ::-1]\n        if kind == \"v\":\n            return mask[::-1, :]\n        if kind == \"r180\":\n            return mask[::-1, ::-1]\n        if kind == \"rccw\":\n            return np.rot90(mask, 1)\n        if kind == \"rcw\":\n            return np.rot90(mask, -1)\n        return mask\n\n    result = np.zeros_like(crop)\n    colors = [int(x) for x in np.unique(crop) if x != 0]\n    colors.sort(key=lambda x: np.count_nonzero(crop == x), reverse=True)\n\n    mid_r = (r0 + r1) / 2\n    mid_c = (c0 + c1) / 2\n\n    for color in colors:\n        mask = crop == color\n        comps = outside_components(color)\n        kind = \"same\"\n\n        if comps:\n            comp = max(comps, key=len)\n            rs = [p[0] for p in comp]\n            cs = [p[1] for p in comp]\n            ar0, ar1, ac0, ac1 = min(rs), max(rs), min(cs), max(cs)\n            ah, aw = ar1 - ar0 + 1, ac1 - ac0 + 1\n            cy = (ar0 + ar1) / 2\n            cx = (ac0 + ac1) / 2\n            dy = cy - mid_r\n            dx = cx - mid_c\n\n            if ah == 1 and aw > 1:\n                if dy < 0:\n                    kind = \"rccw\"\n                elif dy > 0:\n                    kind = \"r180\"\n                else:\n                    kind = \"h\"\n            elif aw == 1 and ah > 1:\n                if dy < 0 and dx < 0:\n                    kind = \"rcw\"\n                elif dy > 0:\n                    kind = \"r180\"\n                elif abs(dx) > abs(dy):\n                    kind = \"h\"\n                else:\n                    kind = \"v\"\n            else:\n                touches_edge = (\n                    np.any(mask[0, :]) or np.any(mask[-1, :]) or\n                    np.any(mask[:, 0]) or np.any(mask[:, -1])\n                )\n                if abs(dx) > abs(dy):\n                    kind = \"h\"\n                elif dy > 0:\n                    kind = \"rcw\" if touches_edge else \"v\"\n                elif dy < 0 and dx > 0:\n                    kind = \"same\"\n                elif dy < 0:\n                    kind = \"rccw\"\n                else:\n                    kind = \"h\"\n\n        moved = apply(mask, kind)\n        if moved.shape == result.shape:\n            result[moved] = color\n\n    return result",
