\n        ar = (min(prs) + max(prs)) / 2.0\n        ac = (min(pcs) + max(pcs)) / 2.0\n        dh = ar - cr\n        dw = ac - cc\n        ph = max(prs) - min(prs) + 1\n        pw = max(pcs) - min(pcs) + 1\n\n        if ph > pw:\n            if dh > 0 and dw < 0:\n                return \"rot\"\n            return \"ud\" if abs(dh) >= abs(dw) else \"lr\"\n\n        if pw > ph:\n            if dh < 0 and dw > 0:\n                return \"anti\"\n            if dh < 0 and dw < 0:\n                return \"tr\"\n            if dh > 0 and dw < 0:\n                return \"rot\"\n            return \"lr\" if abs(dw) >= abs(dh) else \"ud\"\n\n        if abs(dw) > abs(dh):\n            return \"lr\"\n        if abs(dh) > abs(dw):\n            return \"ud\"\n        if dh * dw < 0:\n            return \"anti\"\n        return \"tr\"\n\n    colors = [int(x) for x in np.unique(crop) if x != 0]\n    for col in colors:\n        mask = crop == col\n        if col in clues:\n            pts = max(clues[col], key=len)\n            op = choose_op(pts)\n            mask = op_mask(mask, op)\n        out[mask] = col\n\n    return out",
