+
+            dist = -np.ones((h, w), dtype=int)
+            layer_q = []
+            for r, c in comp:
+                boundary = False
+                for dr, dc in dirs:
+                    nr, nc = r + dr, c + dc
+                    if not (0 <= nr < h and 0 <= nc < w) or not mask[nr, nc]:
+                        boundary = True
