+          "code": "def transform(grid):\n    bg = int(np.bincount(grid.ravel()).argmax())\n    h, w = grid.shape\n    seen = np.zeros((h, w), dtype=bool)\n    comps = []\n\n    for r in range(h):\n        for c in range(w):\n            if seen[r, c] or grid[r, c] == bg:\n                continue\n            color = int(grid[r, c])\n            stack = [(r, c)]\n            seen[r, c] = True\n            cells = []\n            while stack:\n                rr, cc = stack.pop()\n                cells.append((rr, cc))\n                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nr, nc = rr + dr, cc + dc\n                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and grid[nr, nc] != bg:\n                        seen[nr, nc] = True\n                        stack.append((nr, nc))\n\n            rs = [p[0] for p in cells]\n            cs = [p[1] for p in cells]\n            comps.append({\n                \"cells\": cells,\n                \"color\": color,\n                \"minr\": min(rs),\n                \"maxr\": max(rs),\n                \"minc\": min(cs),\n                \"maxc\": max(cs),\n                \"height\": max(rs) - min(rs) + 1,\n                \"width\": max(cs) - min(cs) + 1,\n                \"center2\": min(cs) + max(cs),\n            })\n\n    bars = [x for x in comps if x[\"height\"] == 1 and len(x[\"cells\"]) == x[\"width\"] and x[\"width\"] >= 3]\n    glyphs = [x for x in comps if x[\"height\"] > 1]\n\n    tops = sorted(set([x[\"minr\"] for x in glyphs] + [x[\"minr\"] for x in bars]))\n    diffs = [b - a for a, b in zip(tops, tops[1:]) if b > a]\n    step = min(diffs) if diffs else 4\n\n    out = grid.copy()\n\n    for bar in bars:\n        for r, c in bar[\"cells\"]:\n            out[r, c] = bg\n\n    for bar in bars:\n        col_glyphs = [\n            g for g in glyphs\n            if g[\"center2\"] == bar[\"center2\"] and g[\"minr\"] < bar[\"minr\"]\n        ]\n        if not col_glyphs:\n            continue\n\n        if bar[\"color\"] == 2:\n            for g in col_glyphs:\n                for r, c in g[\"cells\"]:\n                    out[r, c] = 5\n\n        elif bar[\"color\"] == 3:\n            source = max(col_glyphs, key=lambda g: g[\"minr\"])\n            color = source[\"color\"]\n            mask = [(r - source[\"minr\"], c - source[\"minc\"]) for r, c in source[\"cells\"]]\n            top = min(g[\"minr\"] for g in col_glyphs)\n\n            for k in range(1, color + 2):\n                nr = top - k * step\n                if nr < 0 or nr + source[\"height\"] > h:\n                    break\n                for dr, dc in mask:\n                    rr, cc = nr + dr, source[\"minc\"] + dc\n                    if 0 <= rr < h and 0 <= cc < w:\n                        out[rr, cc] = color\n\n    return out",
