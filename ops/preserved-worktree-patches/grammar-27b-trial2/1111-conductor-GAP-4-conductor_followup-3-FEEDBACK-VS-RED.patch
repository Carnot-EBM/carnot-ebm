y in quadrants:\n        quad = grid[r_off:r_end, c_off:c_end]\n        trr, tcc = np.where(quad == 2)\n        if len(trr) == 0:\n            continue\n\n        tar0, tar1 = trr.min(), trr.max() + 1\n        tac0, tac1 = tcc.min(), tcc.max() + 1\n        th, tw = tar1 - tar0, tac1 - tac0\n        sy = th / ah\n        sx = tw / aw\n\n        for col, r0, r1, c0, c1 in comps:\n            rel_r0, rel_r1 = r0 - ar0, r1 - ar0\n            rel_c0, rel_c1 = c0 - ac0, c1 - ac0\n\n            if flip_y:\n                rel_r0, rel_r1 = ah - rel_r1, ah - rel_r0\n            if flip_x:\n                rel_c0, rel_c1 = aw - rel_c1, aw - rel_c0\n\n            nr0 = r_off + tar0 + rnd(rel_r0 * sy)\n            nr1 = r_off + tar0 + rnd(rel_r1 * sy)\n            nc0 = c_off + tac0 + rnd(rel_c0 * sx)\n            nc1 = c_off + tac0 + rnd(rel_c1 * sx)\n\n            nr0 = max(0, min(h, nr0))\n            nr1 = max(0, min(h, nr1))\n            nc0 = max(0, min(w, nc0))\n            nc1 = max(0, min(w, nc1))\n\n            if nr0 < nr1 and nc0 < nc1:\n                out[nr0:nr1, nc0:nc1] = col\n\n    return out",
