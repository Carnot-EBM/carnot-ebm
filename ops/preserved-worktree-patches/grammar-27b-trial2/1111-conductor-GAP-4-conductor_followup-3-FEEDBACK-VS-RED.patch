+    vals, counts = np.unique(grid, return_counts=True)
+    bg = vals[np.argmax(counts)]
+
+    non_bg = vals[vals != bg]
+    if len(non_bg) == 0:
+        return out
+
+    sep = None
+    best = -1
+    for v in non_bg:
+        c = int(np.sum(grid == v))
+        if c > best:
+            best = c
+            sep = v
+
+    seen = np.zeros((h, w), dtype=bool)
+
+    for sr in range(h):
+        for sc in range(w):
+            if seen[sr, sc] or grid[sr, sc] == sep:
+                continue
+
+            q = [(sr, sc)]
+            seen[sr, sc] = True
+            cells = []
+            qi = 0
+
+            while qi < len(q):
+                r, c = q[qi]
+                qi += 1
+                cells.append((r, c))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = r + dr, c + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and grid[nr, nc] != sep:
