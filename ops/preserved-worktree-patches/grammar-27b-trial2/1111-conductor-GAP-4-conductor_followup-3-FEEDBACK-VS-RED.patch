           w = total // h\n            if min_h <= h <= rows and min_w <= w <= cols:\n                factors.append((h, w))\n\n    best = None\n\n    for h, w in factors:\n        board = np.full((h, w), -1, dtype=int)\n        used = [False] * len(pieces)\n        placed = [None] * len(pieces)\n\n        def search(k):\n            nonlocal best\n            if k == len(pieces):\n                if np.any(board == -1):\n                    return\n                if not (\n                    np.all(board[0, :] == frame)\n                    and np.all(board[-1, :] == frame)\n                    and np.all(board[:, 0] == frame)\n                    and np.all(board[:, -1] == frame)\n                ):\n                    return\n\n                for orow in range(rows - h + 1):\n                    for ocol in range(cols - w + 1):\n                        fixed = 0\n                        cost = 0\n                        for i, p in enumerate(pieces):\n                            pr, pc = placed[i]\n                            rr, cc = p[2]\n                            d = abs(orow + pr - rr) + abs(ocol + pc - cc)\n                            cost += d\n                            if d == 0:\n                                fixed += 1\n                        score = (-fixed, cost)\n                        if best is None or score < best[0]:\n                            best = (score, board.copy(), (orow, ocol), (h, w))\n                return\n\n            empty = np.argwhere(board == -1)\n            if empty.size == 0:\n                return\n            r, c = empty[0]\n\n            for i, (arr, mask, origin, area) in enumerate(pieces):\n                if used[i]:\n                    continue\n                ph, pw = arr.shape\n                for ar, ac in np.argwhere(mask):\n                    tr, tc = r - ar, c - ac\n                    if tr < 0 or tc < 0 or tr + ph > h or tc + pw > w:\n                        continue\n                    sub =