+                        if not (0 <= nr < h and 0 <= nc < w) or grid[nr, nc] == line:
+                            boundary = True
+                            break
+                if boundary:
+                    dist[(r, c)] = 0
+                    dq.append((r, c))
+
+            head = 0
+            while head < len(dq):
+                r, c = dq[head]
+                head += 1
+                for dr, dc in dirs:
+                    nr, nc = r + dr, c + dc
+                    if (nr, nc) in comp_set and (nr, nc) not in dist:
+                        dist[(nr, nc)] = dist[(r, c)] + 1
+                        dq.append((nr, nc))
+
+            seed_layers = {}
+            for r, c in comp:
