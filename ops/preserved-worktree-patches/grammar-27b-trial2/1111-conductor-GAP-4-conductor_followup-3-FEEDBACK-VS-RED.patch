+
+            q = [(sr, sc)]
+            seen[sr, sc] = True
+            comp = []
+            head = 0
+
+            while head < len(q):
+                r, c = q[head]
+                head += 1
+                comp.append((r, c))
+                for dr, dc in dirs:
