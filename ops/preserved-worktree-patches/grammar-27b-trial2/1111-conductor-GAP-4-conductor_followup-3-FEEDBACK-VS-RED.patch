+                    if 0 <= nr < h and 0 <= nc < w:
+                        if not seen[nr, nc] and grid[nr, nc] != line:
+                            seen[nr, nc] = True
+                            q.append((nr, nc))
+
+            comp_set = set(comp)
+            dist = {}
+            dq = []
+
+            for r, c in comp:
+                boundary = r == 0 or r == h - 1 or c == 0 or c == w - 1
+                if not boundary:
+                    for dr, dc in dirs:
