+        col_rows = sorted(by_center[c])
+        obj_color = col_rows[-1][1]
+        count = len(col_rows)
+
+        # A bottom bar matching another bar color means the column's objects are
+        # recolored to the missing color 5.
+        other_bar_colors = {v for k, v in bar_by_center.items() if k != c}
+        if bcol in other_bar_colors:
