+        "code": "def transform(grid):\n    out = grid.copy()\n    h, w = grid.shape\n\n    counts = np.bincount(grid.ravel(), minlength=10)\n    bg = int(np.argmax(counts))\n\n    sep_rows = [r for r in range(h) if np.all(grid[r, :] == grid[r, 0]) and grid[r, 0] != bg]\n    sep_cols = [c for c in range(w) if np.all(grid[:, c] == grid[0, c]) and grid[0, c] != bg]\n    if not sep_rows or not sep_cols:\n        return out\n\n    sr = sep_rows[len(sep_rows) // 2]\n    sc = sep_cols[len(sep_cols) // 2]\n\n    active = (grid != bg)\n    active[sr, :] = False\n    active[:, sc] = False\n\n    seen = np.zeros((h, w), dtype=bool)\n    comps = []\n    for r in range(h):\n        for c in range(w):\n            if not active[r, c] or seen[r, c]:\n                continue\n            stack = [(r, c)]\n            seen[r, c] = True\n            cells = []\n            while stack:\n                x, y = stack.pop()\n                cells.append((x, y))\n                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nx, ny = x + dx, y + dy\n                    if 0 <= nx < h and 0 <= ny < w and active[nx, ny] and not seen[nx, ny]:\n                        seen[nx, ny] = True\n                        stack.append((nx, ny))\n            comps.append(cells)\n\n    proto = None\n    best_key = None\n    for cells in comps:\n        vals = {int(grid[r, c]) for r, c in cells}\n        if 2 in vals and len(vals) > 1:\n            key = (len(vals), len(cells))\n            if best_key is None or key > best_key:\n                best_key = key\n                proto = cells\n\n    if proto is None:\n        return out\n\n    proto_set = set(proto)\n    p2 = [(r, c) for r, c in proto if grid[r, c] == 2]\n    ar0 = min(r for r, c in p2)\n    ar1 = max(r for r, c in p2) + 1\n    ac0 = min(c for r, c in p2)\n    ac1 = max(c for r, c in p2) + 1\n    ah = ar1 - ar0\n    aw = ac1 - ac0\n\n    proto_side_r = 0 if ar0 < sr else 1\n    proto_side_c = 0 if ac0 < sc else 1\n\n    def draw_cell(color, tr0, tc0, th, tw, r, c, flip_v, flip_h):\n        y0, y1 = r - ar0, r - ar0 + 1\n        x0, x1 = c - ac0, c - ac0 + 1\n\n        if flip_v:\n            y0, y1 = ah - y1, ah - y0\n        if flip_h:\n            x0, x1 = aw - x1, aw - x0\n\n        yy0 = tr0 + int(np.floor(y0 * th / ah + 1e-9))\n        yy1 = tr0 + int(np.ceil(y1 * th / ah - 1e-9))\n        xx0 = tc0 + int(np.floor(x0 * tw / aw + 1e-9))\n        xx1 = tc0 + int(np.ceil(x1 * tw / aw - 1e-9))\n\n        for yy in range(yy0, yy1):\n            for xx in range(xx0, xx1):\n                if 0 <= yy < h and 0 <= xx < w and yy != sr and xx != sc:\n                    out[yy, xx] = color\n\n    for cells in comps:\n        if any(cell in proto_set for cell in cells):\n            continue\n        vals = {int(grid[r, c]) for r, c in cells}\n        if vals != {2}:\n            continue\n\n        tr0 = min(r for r, c in cells)\n        tr1 = max(r for r, c in cells) + 1\n        tc0 = min(c for r, c in cells)\n        tc1 = max(c for r, c in cells) + 1\n        th = tr1 - tr0\n        tw = tc1 - tc0\n\n        side_r = 0 if tr0 < sr else 1\n        side_c = 0 if tc0 < sc else 1\n        flip_v = side_r != proto_side_r\n        flip_h = side_c != proto_side_c\n\n        for r, c in proto:\n            draw_cell(int(grid[r, c]), tr0, tc0, th, tw, r, c, flip_v, flip_h)\n\n    return out",
