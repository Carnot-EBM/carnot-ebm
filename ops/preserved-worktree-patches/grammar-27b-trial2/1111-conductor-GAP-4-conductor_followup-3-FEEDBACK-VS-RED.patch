+          "code": "def transform(grid):\n    out = grid.copy()\n    h, w = out.shape\n\n    # Turn each horizontal 777 bridge into an 8-6-8 gate, and extend the 6\n    # vertically onto the neighboring horizontal rails.\n    centers_by_gap = {}\n    for r in range(h):\n        c = 0\n        while c <= w - 3:\n            if grid[r, c] == 7 and grid[r, c + 1] == 7 and grid[r, c + 2] == 7:\n                mid = c + 1\n                out[r, c:c + 3] = [8, 6, 8]\n                if r - 1 >= 0:\n                    out[r - 1, mid] = 6\n                if r + 1 < h:\n                    out[r + 1, mid] = 6\n                centers_by_gap[r] = centers_by_gap.get(r, []) + [mid]\n                c += 3\n            else:\n                c += 1\n\n    # Remove original rail-end markers.\n    out[grid == 3] = 8\n\n    # Restore blue markers on horizontal rails according to connectivity from\n    # the left and right edges through the inserted gates.\n    rail_rows = [r for r in range(h) if r % 2 == 0]\n    left = True\n    right = True\n\n    for i, r in enumerate(rail_rows):\n        above = r - 1\n        if above in centers_by_gap:\n            cs = centers_by_gap[above]\n            if any(c <= 4 for c in cs):\n                left = not left\n            if any(c >= w - 5 for c in cs):\n                right = not right\n\n        below = r + 1\n        if left and r != 0:\n            out[r, 0] = 3\n            if below in centers_by_gap and any(c <= 4 for c in centers_by_gap[below]):\n                out[r, 1] = 3\n\n        if right and r != 0:\n            out[r, w - 1] = 3\n            if below in centers_by_gap and any(c >= w - 5 for c in centers_by_gap[below]):\n                out[r, w - 2] = 3\n\n    return out",
