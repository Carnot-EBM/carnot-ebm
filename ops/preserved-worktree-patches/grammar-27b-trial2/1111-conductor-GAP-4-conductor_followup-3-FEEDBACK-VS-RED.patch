+          "code": "def transform(grid):\n    g = grid\n    rows, cols = g.shape\n    nz = (g != 0).astype(int)\n    total = int(nz.sum())\n    if total == 0:\n        return g.copy()\n\n    ps = np.zeros((rows + 1, cols + 1), dtype=int)\n    ps[1:, 1:] = nz.cumsum(0).cumsum(1)\n\n    def rect_sum(r0, r1, c0, c1):\n        return int(ps[r1, c1] - ps[r0, c1] - ps[r1, c0] + ps[r0, c0])\n\n    need = int(np.ceil(total * 0.75))\n    best = None\n    best_score = None\n\n    for r0 in range(rows):\n        for r1 in range(r0 + 1, rows + 1):\n            for c0 in range(cols):\n                for c1 in range(c0 + 1, cols + 1):\n                    count = rect_sum(r0, r1, c0, c1)\n                    if count < need:\n                        continue\n                    area = (r1 - r0) * (c1 - c0)\n                    score = count - 0.05 * area\n                    if best_score is None or score > best_score:\n                        best_score = score\n                        best = (r0, r1, c0, c1)\n\n    r0, r1, c0, c1 = best\n    crop = g[r0:r1, c0:c1]\n    out = np.zeros_like(crop)\n\n    outside = np.ones_like(g, dtype=bool)\n    outside[r0:r1, c0:c1] = False\n\n    for color in np.unique(crop):\n        if color == 0:\n            continue\n\n        marker_count = int(((g == color) & outside).sum())\n        k = (-marker_count) % 4\n\n        mask = (crop == color)\n        if k:\n            mask = np.rot90(mask, k)\n\n        out[mask] = color\n\n    return out",
