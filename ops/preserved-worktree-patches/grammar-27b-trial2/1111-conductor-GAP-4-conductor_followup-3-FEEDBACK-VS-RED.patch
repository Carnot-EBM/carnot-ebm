:\n                if s <= a <= e:\n                    out[r, s] = 3\n                    break\n        if runs:\n            out[r, runs[-1][1]] = 3\n\n    for r in range(0, h, 2):\n        above = sorted(centers.get(r - 1, []))\n        below = sorted(centers.get(r + 1, []))\n\n        if above and not below:\n            bottom_marks(r, above)\n        elif not above and below:\n            continue\n        elif len(above) == len(below):\n            diffs = [b - a for a, b in zip(above, below)]\n            if diffs and all(d > 0 for d in diffs):\n                mark_left(r)\n            elif diffs and all(d < 0 for d in diffs):\n                mark_right(r)\n        elif len(above) > len(below) and below:\n            if min(below) > min(above):\n                mark_left(r)\n            if max(below) < max(above):\n                mark_right(r)\n\n    return out",
