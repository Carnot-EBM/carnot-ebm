+          "code": "def transform(grid):\n    h, w = grid.shape\n\n    vals, counts = np.unique(grid, return_counts=True)\n    bg = vals[np.argmax(counts)]\n\n    sep_col = None\n    sep_color = None\n    for c in range(w):\n        if np.all(grid[:, c] == grid[0, c]) and grid[0, c] != bg:\n            sep_col = c\n            sep_color = grid[0, c]\n            break\n\n    out = grid.copy()\n\n    object_mask = np.zeros((h, w), dtype=bool)\n    object_mask[:, :sep_col] = (grid[:, :sep_col] != bg) & (grid[:, :sep_col] != sep_color)\n    out[object_mask] = bg\n\n    seen = np.zeros((h, w), dtype=bool)\n    mark_rows = set()\n\n    for sr in range(h):\n        for sc in range(sep_col):\n            if seen[sr, sc] or not object_mask[sr, sc]:\n                continue\n\n            color = grid[sr, sc]\n            stack = [(sr, sc)]\n            seen[sr, sc] = True\n            cells = []\n\n            while stack:\n                r, c = stack.pop()\n                cells.append((r, c))\n                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nr, nc = r + dr, c + dc\n                    if 0 <= nr < h and 0 <= nc < sep_col:\n                        if not seen[nr, nc] and object_mask[nr, nc] and grid[nr, nc] == color:\n                            seen[nr, nc] = True\n                            stack.append((nr, nc))\n\n            max_c = max(c for _, c in cells)\n            shift = (sep_col - 1) - max_c\n\n            shifted = set()\n            for r, c in cells:\n                nc = c + shift\n                out[r, nc] = color\n                shifted.add((r, nc))\n\n            edge_col = sep_col - 1\n            for r, c in shifted:\n                if c == edge_col and (r - 1, c) in shifted and (r + 1, c) in shifted:\n                    mark_rows.add(r)\n\n    for r in mark_rows:\n        out[r, sep_col + 1:] = 2\n\n    return out",
