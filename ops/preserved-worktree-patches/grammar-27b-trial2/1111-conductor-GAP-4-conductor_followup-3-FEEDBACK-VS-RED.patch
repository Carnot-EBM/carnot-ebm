+          "code": "def transform(grid):\n    out = grid.copy()\n    h, w = grid.shape\n\n    bg = int(np.bincount(grid.ravel(), minlength=10).argmax())\n\n    sep_rows = []\n    for r in range(h):\n        vals = grid[r]\n        if np.all(vals == vals[0]) and int(vals[0]) != bg:\n            sep_rows.append(r)\n\n    first_sep = sep_rows[0]\n    last_sep = sep_rows[-1]\n\n    non_sep_rows = [r for r in range(h) if r not in sep_rows]\n    active_rows = []\n    for r in non_sep_rows:\n        if np.any(grid[r] != bg):\n            active_rows.append(r)\n\n    row_groups = []\n    for r in active_rows:\n        if not row_groups or r != row_groups[-1][-1] + 1:\n            row_groups.append([r])\n        else:\n            row_groups[-1].append(r)\n\n    top_group = None\n    catalog_row_groups = []\n    for g in row_groups:\n        if g[-1] < first_sep:\n            top_group = g\n        elif g[0] > first_sep and g[-1] < last_sep:\n            catalog_row_groups.append(g)\n\n    active_cols = []\n    for c in range(w):\n        found = False\n        for r in non_sep_rows:\n            if grid[r, c] != bg:\n                found = True\n                break\n        if found:\n            active_cols.append(c)\n\n    col_groups = []\n    for c in active_cols:\n        if not col_groups or c != col_groups[-1][-1] + 1:\n            col_groups.append([c])\n        else:\n            col_groups[-1].append(c)\n\n    def tile_info(rows, cols):\n        tile = grid[rows[0]:rows[-1] + 1, cols[0]:cols[-1] + 1]\n        mask = tile != bg\n        if not np.any(mask):\n            return None\n        colors = tile[mask]\n        color = int(np.bincount(colors, minlength=10).argmax())\n        return tuple(tuple(int(x) for x in row) for row in mask), color\n\n    query_patterns = set()\n    top_tiles = []\n    for cols in col_groups:\n        info = tile_info(top_group, cols)\n        top_tiles.append(info)\n        if info is not None:\n            query_patterns.add(info[0])\n\n    catalog = []\n    matches = []\n    for ri, rows in enumerate(catalog_row_groups):\n        row = []\n        for ci, cols in enumerate(col_groups):\n            info = tile_info(rows, cols)\n            row.append(info)\n            if info is not None and info[0] in query_patterns:\n                matches.append((ri, ci))\n        catalog.append(row)\n\n    match_set = set(matches)\n    complete_rows = [\n        ri for ri in range(len(catalog_row_groups))\n        if all((ri, ci) in match_set for ci in range(len(col_groups)))\n    ]\n    complete_cols = [\n        ci for ci in range(len(col_groups))\n        if all((ri, ci) in match_set for ri in range(len(catalog_row_groups)))\n    ]\n\n    def fill_frame(rows, cols):\n        r0 = max(0, rows[0] - 1)\n        r1 = min(h - 1, rows[-1] + 1)\n        c0 = max(0, cols[0] - 1)\n        c1 = min(w - 1, cols[-1] + 1)\n        area = out[r0:r1 + 1, c0:c1 + 1]\n        area[area == bg] = 3\n\n    for ri, ci in matches:\n        fill_frame(catalog_row_groups[ri], col_groups[ci])\n\n    has_complete_line = bool(complete_rows or complete_cols)\n\n    if has_complete_line:\n        top_area = out[:first_sep, :]\n        top_area[top_area == bg] = 3\n        out[last_sep + 1:, :] = 3\n\n        for ri in complete_rows:\n            if ri + 1 < len(catalog_row_groups):\n                for ci, info in enumerate(top_tiles):\n                    if info is not None and catalog[ri][ci] is not None and info[0] == catalog[ri][ci][0]:\n                        next_info = catalog[ri + 1][ci]\n                        if next_info is not None:\n                            rows = top_group\n                            cols = col_groups[ci]\n                            rr0, rr1 = rows[0], rows[-1] + 1\n                            cc0, cc1 = cols[0], cols[-1] + 1\n                            out[rr0:rr1, cc0:cc1] = 3\n                            pat, color = next_info\n                            for a, prow in enumerate(pat):\n                                for b, v in enumerate(prow):\n                                    if v:\n                                        out[rr0 + a, cc0 + b] = color\n    else:\n        out[last_sep + 1:, :] = 2\n\n    return out",
