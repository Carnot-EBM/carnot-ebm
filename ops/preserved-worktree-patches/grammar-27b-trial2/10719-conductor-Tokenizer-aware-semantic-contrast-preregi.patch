+                "accepted_cells": len(artifact["accepted_cell_manifest"]),
+                "rejected_cells": len(artifact["rejected_cell_manifest"]),
+                "honest_verdict": artifact["honest_verdict"],
+            }
+        )
+    )
+    return 0
