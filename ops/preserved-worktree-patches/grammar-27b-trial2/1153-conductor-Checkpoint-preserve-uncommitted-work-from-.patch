    # If no markers are active, check if they are just near each other\n    if not active_markers:\n        for r, c in markers:\n            for dr in range(-2, 3):\n                for dc in range(-2, 3):\n                    nr, nc = r + dr, c + dc\n                    if 0 <= nr < rows and 0 <= nc < cols:\n                        if grid[nr, nc] != 0 and (nr, nc) != (r, c):\n                            active_markers.append((r, c))\n                            break\n                if (r, c) in active_markers: break\n\n    # Fill neighbors of active markers\n    for r, c in active_markers:\n        for dr in range(-1, 2):\n            for dc in range(-1, 2):\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < rows and 0 <= nc < cols:\n                    if res[nr, nc] == 0:\n                        res[nr, nc] = 1\n                        \n    return res",
