             # This is a vertical pattern, but the output shows \n                        # the pattern is still horizontal.\n                        # Actually, in all demos, the output is a perfectly \n                        # tiled version of the main pattern.\n                        pass\n                break\n\n    # The output is a grid where every cell (r, c) is pattern[c % len(pattern)]\n    # But wait, looking at Demo 1: \n    # Input row 0: [5, 2, 5, 2, 5, 2, 5, 1] -> Output row 0: [2, 5, 2, 5, 2, 5, 2, 5]\n    # It seems the pattern is shifted or the grid is filled such that \n    # the pattern is consistent across the whole grid.\n    \n    # Let's re-examine:\n    # Demo 1: Pattern [5, 2]. Output is [2, 5, 2, 5, 2, 5, 2, 5]\n    # Demo 2: Pattern [6, 3, 5, 7]. Output is [3, 5, 7, 6, 3, 5, 7, 6...]\n    # Demo 3: Pattern [7, 6, 3]. Output is [6, 3, 7, 6, 3, 7, 6, 3, 7]\n    \n    # Rule: The output grid is filled with the pattern such that \n    # output[r, c] = pattern[(r + c + 1) % len(pattern)]\n    # Let's check Demo 1: pattern [5, 2]. \n    # r=0, c=0: (0+0+1)%2 = 1 -> pattern[1] = 2. Correct.\n    # r=0, c=1: (0+1+1)%2 = 0 -> pattern[0] = 5. Correct.\n    # Demo 2: pattern [6, 3, 5, 7].\n    # r=0, c=0: (0+0+1)%4 = 1 -> pattern[1] = 3. Correct.\n    # r=0, c=1: (0+1+1)%4 = 2 -> pattern[2] = 5. Correct.\n    # Demo 3: pattern [7, 6, 3].\n    # r=0, c=0: (0+0+1)%3 = 1 -> pattern[1] = 6. Correct.\n    \n    # Wait, the pattern is actually the first few elements of the input \n    # excluding the \"border\" element.\n    # Demo 1: [5, 2, 5, 2, 5, 2, 5, 1] -> pattern [5, 2]\n    # Demo 2: [6, 3, 5, 7, 6, 3, 5, 7, 6, 3, 5, 8...] -> pattern [6, 3, 5, 7]\n    # Demo 3: [7, 6, 3, 7, 6, 3, 7, 6, 4] -> pattern [7, 6, 3]\n    \n    # Let's refine pattern extraction:\n    # It's the repeating sequence in the first row before it hits a different color \n    # (the border color).\n    \n    first_row = grid[0]\n    pattern = []\n    for i in range(len(first_row)):\n        if first_row[i] != first_row[0]:\n            # The pattern is the sequence before this index\n            # But we need to find the smallest repeating unit.\n            sub = first_row[:i].tolist()\n            # Find smallest period of 'sub'\n            for p in range(1, len(sub) + 1):\n                if len(sub) % p == 0:\n                    unit = sub[:p]\n                    if unit * (len(sub) // p) == sub:\n                        pattern = unit\n                        break\n            break\n        if i == len(first_row) - 1: # Entire row is same except last\n            sub = first_row[:-1].tolist()\n            for p in range(1, len(sub) + 1):\n                if len(sub) % p == 0:\n                    unit = sub[:p]\n                    if unit * (len(sub) // p) == sub:\n                        pattern = unit\n                        break\n    \n    # If pattern still empty, try the first row again but look for the first change\n    if not pattern:\n        for i in range(1, len(first_row)):\n            if first_row[i] != first_row[0]:\n                sub = first_row[:i].tolist()\n                # Just take the first two or three elements if no period found\n                pattern = sub[:2] if len(sub) >= 2 else sub\n                break\n\n    # Final construction:\n    # The output grid is filled such that output[r, c] = pattern[(r + c + 1) % len(pattern)]\n    # Wait, looking at Demo 1 again:\n    # Output row 0: [2, 5, 2, 5, 2, 5, 2, 5]\n    # Pattern was [5, 2]. \n    # Index 0: (0+0+1)%2 = 1 -> pattern[1] = 2\n    # Index 1: (0+1+1)%2 = 0 -> pattern[0] = 5\n    # This works.\n    \n    res = np.zeros((rows, cols), dtype=int)\n    p_len = len(pattern)\n    for r in range(rows):\n        for c in range(cols):\n            res[r, c] = pattern[(r + c + 1) % p_len]\n            \n    return res",
