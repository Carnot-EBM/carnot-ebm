+#!/usr/bin/env python3
+"""Run Exp 3769 Phase-1 package/CLI/MCP software E2E smoke."""
+
+from __future__ import annotations
+
+from carnot.reporting.phase1_e2e_smoke import main
+
+
+if __name__ == "__main__":
