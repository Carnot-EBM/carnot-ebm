+def synthetic_grounding_auroc(exp3655: Mapping[str, Any]) -> float:
+    """Read the synthetic-corpus real-NLI grounding AUROC from Exp 3655."""
+
+    metric = exp3655.get("grounding_auroc_real_nli")
