+            "file_sha256": record.get("file_sha256"),
+            "immutable": True,
+        }
+        for source_id, record in records.items()
+    }
+    for source_id, path, immutable in (
+        ("conductor_log", CONDUCTOR_LOG_PATH, False),
+        ("v599_references", REFERENCE_PATH, True),
