+    """REQ-LEARN-4100: missing resources map to explicit blocked verdicts."""
+
+    checks, blocker, _path, _probe = exp4100.check_preconditions(
+        repo_root=tmp_path,
+        trm_weights_dir=tmp_path / "missing-hf",
