+from carnot.agentic import arc_exp4100_trm_verifier_rft_conditional as exp4100
+
+
+REPO = Path(__file__).resolve().parents[2]
+SPEC_PATH = REPO / "openspec" / "capabilities" / "self-learning" / "spec.md"
