+    print(f"terminal_state_reached: {artifact['terminal_state_reached']}")
+    print(f"duration_s: {artifact['duration_s']}")
+    print(f"run_duration_s: {artifact['run_duration_s']}")
+
+
+if __name__ == "__main__":  # pragma: no cover
+    main()
