+        (s0, a, s0),
+        (s0, a, s1),
+        (s1, a, s1),
+        (s1, a, s0)
+    ]
+
+m = PinductorModel("test", step_fn, 2)
+m.fit([dummy_traj()])
+print(m.consistency_energy([dummy_traj()]))
