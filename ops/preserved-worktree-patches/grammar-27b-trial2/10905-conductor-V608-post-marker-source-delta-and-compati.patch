+def _fake_repo(tmp_path: Path, *, missing: str | None = None) -> Path:
+    root = tmp_path / "repo"
+    required = {
+        "research-references.md": (
+            "# Reference ledger\n\n"
+            "<!-- V608-PLANNER-REFRESH-20260903-START -->\n"
