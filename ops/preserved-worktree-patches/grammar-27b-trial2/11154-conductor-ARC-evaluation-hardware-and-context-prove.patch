+def test_provenance_hash_is_stable_in_a_fresh_process() -> None:
+    """SCENARIO-ARC-7010-LIVE-ROUND-TRIP: canonical bytes cross processes."""
+    record = build_arc_eval_provenance(_live_input())
+    code = (
