+def test_req_arc_wmte_6921_helper_defenses_and_frame_fallback(tmp_path: Path) -> None:
+    """REQ-ARC-WMTE-6921 fails closed on malformed and non-live source shapes."""
+
+    invalid_json = tmp_path / "invalid.json"
