+def test_req_4142_classifies_baseline_graft_and_diffusiongemma_gate() -> None:
+    # REQ-VERIFY-4142: .383 distinguishes executable oracle from transferable value.
+    baseline = exp4142.classify_sudoku_baseline(REPO_ROOT)
