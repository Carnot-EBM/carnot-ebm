+      addressed_by: "The new mechanism writes only exact-success traces after outcomes, uses fixed abstention, separates fresh processes, and compares trace placement under the same token budget."
+      retire_if_same_verdict: true
+    - experiment_id: exp6873-prospective-sealed-self-learning-audit
+      verdict: complete_null_prospective_sealed_self_learning_utility_not_demonstrated
