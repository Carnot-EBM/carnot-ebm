+- id: exp7001-pwa-certificate-cold-audit
+  title: Fresh-process blinded PWA-KAN certificate audit
+  track: verification
+  priority: critical
+  agent_type: codex
+  model: gpt-5.6-sol
+  requires_gpu: false
+  max_turns: 30
+  estimated_wall_time_min: 120
+  per_unit_rows: true
+  prior_failures:
+    - experiment_id: exp6989-pwa-certificate-cold-audit
+      verdict: "GATE_BLOCKED: upstream exp6988-certified-pwa-kan-ranker retired"
+      addressed_by: "Exp6989 never received a candidate artifact because Exp6988 stopped at the leakage gate. Exp7001 consumes Exp7000's new artifact-complete field after the independent blinded-feature release, even when the learned result is null."
