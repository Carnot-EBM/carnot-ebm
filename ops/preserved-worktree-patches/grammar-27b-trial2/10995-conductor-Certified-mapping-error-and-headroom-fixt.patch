+def gate_check(check: str, expected: Any, observed: Any) -> JsonDict:
+    """Record both sides of one exact precondition comparison."""
+
+    return {
+        "check": check,
+        "expected_value": expected,
+        "observed_value": observed,
+        "passed": expected == observed,
+    }
+
