+    def fake_reasoner(selected_panel: exp.FoVerPanel, _model_specs: dict[str, object]) -> exp.ReasonerScoring:
+        scores = [1 if label == 1 and idx % 4 != 0 else 0 for idx, label in enumerate(selected_panel.labels)]
