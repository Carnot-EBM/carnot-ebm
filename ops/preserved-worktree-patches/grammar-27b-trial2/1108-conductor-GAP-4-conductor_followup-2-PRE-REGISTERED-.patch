+            else:
+                top_row = marker_rows[0]
+            left_col = a[1] - mw if side == "left" else a[1] + 1
+
+        for rr in range(mh):
+            for cc in range(mw):
+                if m[rr, cc]:
+                    x, y = top_row + rr, left_col + cc
+                    if 0 <= x < h and 0 <= y < w:
+                        out[x, y] = color
+
+    return out
+```
