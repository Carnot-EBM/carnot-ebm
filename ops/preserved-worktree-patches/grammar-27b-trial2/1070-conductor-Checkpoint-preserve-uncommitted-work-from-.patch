+    def transform(grid):
+        # grid: 2D numpy int array (colors 0-9). Return the transformed grid as a numpy
+        # int array. THE OUTPUT SHAPE MAY DIFFER from the input shape.
+Infer the rule from the demos and implement it GENERICALLY (np is provided; no imports, no file/network access). Your function MUST reproduce every demo output exactly from its demo input, and must then generalize to the test input by applying the SAME rule. Do NOT hardcode demo-specific coordinates/colors or anything specific to the test input. Output ONLY one ```python code block.
+===== RAW OUTPUT =====
+```python
+def transform(grid):
+    pts = [tuple(p) for p in np.argwhere(grid != 0)]
+    pts_set = set(pts)
+
+    seen = set()
+    clusters = []
+    for p in pts:
+        if p in seen:
+            continue
+        q = [p]
+        seen.add(p)
+        comp = []
+        i = 0
+        while i < len(q):
+            r, c = q[i]
+            i += 1
+            comp.append((r, c))
+            for dr in range(-2, 3):
+                for dc in range(-2, 3):
+                    if dr == 0 and dc == 0:
+                        continue
+                    nb = (r + dr, c + dc)
+                    if nb in pts_set and nb not in seen:
+                        seen.add(nb)
+                        q.append(nb)
+        clusters.append(comp)
+
+    main = max(clusters, key=len)
+    rs = [r for r, c in main]
+    cs = [c for r, c in main]
+    r0, r1 = min(rs), max(rs)
+    c0, c1 = min(cs), max(cs)
+
+    crop = grid[r0:r1 + 1, c0:c1 + 1]
+    h, w = crop.shape
+
+    turns = {}
+    for r, c in pts:
+        if not (r0 <= r <= r1 and c0 <= c <= c1):
+            color = int(grid[r, c])
+            turns[color] = turns.get(color, 0) + 1
+
+    out = np.zeros_like(crop)
+    for color in sorted(int(x) for x in np.unique(crop) if x != 0):
+        mask = (crop == color)
+        k = turns.get(color, 0) % 4
+        if k:
+            mask = np.rot90(mask, -k)
+        out[mask] = color
+
+    return out
+```
