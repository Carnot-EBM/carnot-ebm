+        "- missing discriminator: recognize rules not surfaced by local candidates.\n"
+        "- candidate design: stronger base or verifier-guided generation.\n"
+        "- priority: high\n",
+        encoding="utf-8",
+    )
+    for name in (
+        "arc3_gap4_rule_exec_verifier.json",
