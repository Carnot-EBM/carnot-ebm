+                "max_epochs_cap_confirmed": False,
+                "max_time_s": 3600.0,
+                "target_max_epochs": 9399,
+                "timer_train_elapsed_s": 3641.9931271109963,
+            },
+            "duration_s": 0.121,
+            "honest_verdict": "blocked_noop_cap_not_confirmed_timer_elapsed",
+            "max_epochs_cap_confirmed": False,
+            "post_epoch": 6399,
+            "seed_epoch": 6399,
+            "stable_checkpoint_path": "results/trm_runs/sudoku_extreme_baseline/last.ckpt",
+            "val_exact_accuracy": None,
+        },
+    )
+    _write_json(
+        root / "results" / "experiment_4149_sudoku_accumulate_pass4_convergence.json",
+        {
+            "blocked_cause": "pass1 verdict=blocked_noop_cap_not_confirmed_timer_elapsed",
+            "honest_verdict": "blocked_pass3_noop_unresolved",
+            "native_trainer_launched": False,
+            "val_exact_accuracy": 0.278172343969,
+            "val_trajectory_v384": [
+                {"pass_label": "v384_start", "effective_val_exact_accuracy": 0.278172343969},
+                {"pass_label": "pass1", "val_exact_accuracy": None},
+            ],
+        },
+    )
+    _write_json(
+        root / "results" / "experiment_4150_decisive_verifier_graft_sudoku.json",
+        {
+            "baseline_status": {"faithful": False, "faithful_threshold": 0.85},
+            "graft_deferred": True,
+            "honest_verdict": "complete: graft_deferred_baseline_below_0.85",
+            "verifier_value_added": False,
