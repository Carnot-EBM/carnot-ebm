+
+    assert mod.read_json_object(tmp_path / "missing.json") == {}
+    bad = tmp_path / "bad.json"
+    bad.write_text("{bad", encoding="utf-8")
+    assert mod.read_json_object(bad) == {}
+    list_path = tmp_path / "list.json"
+    list_path.write_text("[1]", encoding="utf-8")
