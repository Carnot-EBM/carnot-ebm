+def test_read_sources_and_build_v384_close_state(tmp_path: Path) -> None:
+    """SCENARIO-REPORT-4156: close-state records the corrected stale-Timer diagnosis."""
+
+    root = make_repo(tmp_path)
+    sources = mod.read_v384_sources(root)
+    assert sources["4146"]["duration_s"] == 0.121
+    cited = mod.build_cited_upstream(root)
+    assert any(item["kind"] == "contiguous_metric_csv" for item in cited)
+    assert all(item["sha256"] is None or mod.is_sha256(item["sha256"]) for item in cited)
+    state = mod.build_v384_close_state(sources, mod.read_contiguous_metrics(root), run_alive=False)
+    assert state["epoch_fix_was_misdiagnosis"] is True
+    assert state["stale_timer_guard_misfire"] is True
+    assert state["timer_train_elapsed_s"] == 3641.99
+    assert state["max_time_s"] == 3600.0
+    assert state["config_max_epochs"] == 50000
+    assert state["seed_epoch"] == 6399
+    assert state["post_epoch"] == 6399
+    assert state["exp4146_duration_s"] == 0.121
+    assert state["exp4146_val_exact_accuracy"] is None
+    assert state["bounded_pass_chain_retired"] is True
+    assert state["contiguous_run_is_working_fix"] is True
+    assert state["max_contiguous_val_exact_accuracy_rounded"] == 0.501
+    assert state["contiguous_baseline_above_042"] is True
+    assert state["decisive_graft_deferred"] is True
+    assert state["decisive_graft_deferred_reason"] == "baseline_val_below_0.85"
+
+    default_state = mod.build_v384_close_state({}, [], run_alive=False)
+    assert default_state["max_contiguous_val_exact_accuracy_rounded"] == 0.0
+    assert default_state["contiguous_run_is_working_fix"] is False
