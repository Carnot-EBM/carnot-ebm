+    good = tmp_path / "good.json"
+    good.write_text(json.dumps({"x": 1}), encoding="utf-8")
+    assert mod.read_json_object(good) == {"x": 1}
+    assert mod.is_sha256(mod.file_sha256(good))
+    assert mod.file_sha256(tmp_path / "nope") is None
