+def test_req_report_4156_spec_declares_contract() -> None:
+    """REQ-REPORT-4156: OpenSpec declares required fields and scenarios."""
+
+    spec = Path("openspec/capabilities/research-reporting/spec.md").read_text(encoding="utf-8")
+    assert "REQ-REPORT-4156" in spec
+    assert "SCENARIO-REPORT-4156" in spec
