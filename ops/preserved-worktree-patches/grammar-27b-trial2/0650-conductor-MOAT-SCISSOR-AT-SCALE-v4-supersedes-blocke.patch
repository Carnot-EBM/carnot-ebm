+def test_scenario_verify_3869_reuses_residual_and_bootstrap_definitions() -> None:
+    """SCENARIO-VERIFY-3869: residual and Jaccard reuse the Exp3827 semantics."""
+
+    metrics = exp.compute_scissor_metrics(
