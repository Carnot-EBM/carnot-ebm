+def test_req_verify_3869_model_resolution_prefers_qwen_then_fallback(
+    monkeypatch: pytest.MonkeyPatch,
+    tmp_path: Path,
+) -> None:
+    """REQ-VERIFY-3869: Qwen is preferred and Gemma is recorded as fallback."""
+
+    qwen = tmp_path / "qwen.gguf"
