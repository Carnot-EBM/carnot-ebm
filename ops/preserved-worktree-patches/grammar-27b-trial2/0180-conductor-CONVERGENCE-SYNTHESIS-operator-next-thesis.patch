+                    "rerunning the settled FoVer weighting or selection lines."
+                ),
+                "authority": "research-program.md; project_verifier_domain_bound background",
+                "operator_action_required": True,
+            },
+            {
+                "thesis": "finalize_submit_and_maintenance",
+                "summary": (
