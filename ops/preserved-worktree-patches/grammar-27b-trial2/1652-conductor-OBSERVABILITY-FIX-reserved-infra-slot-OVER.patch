+#!/usr/bin/env python3
+"""Run Exp 4161 operational-retro timing detector repair."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import sys
+
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+PYTHON_ROOT = REPO_ROOT / "python"
+if str(PYTHON_ROOT) not in sys.path:  # pragma: no cover - direct-script import guard
+    sys.path.insert(0, str(PYTHON_ROOT))
+
+from carnot.reporting.observability_timing_detector_4161 import run  # noqa: E402
+
+
+def main() -> int:
+    output_path = run(REPO_ROOT)
+    payload = json.loads(output_path.read_text(encoding="utf-8"))
+    print(json.dumps(payload, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
