+            "honest_verdict": (
+                "complete: ebt_fundamental_REPLICATED_beam0.000_argmin0.000_"
+                "vs_ar0.910_nseeds2_energy_as_generator_banked_negative"
+            ),
+            "flagged_adversarial": False,
+            "replication_outcome": "REPLICATED",
+            "reproducibility_checksum": "a" * 64,
+        },
+    )
