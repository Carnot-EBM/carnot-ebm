+class CheckpointScalars:
+    """CPU-only scalar view of the shared Lightning checkpoint."""
+
+    load_ok: bool
+    detail: str
+    epoch: int | None
+    manual_lr_step: int | None
+
+    def to_dict(self) -> dict[str, Any]:
