+def build_blocked_artifact(
+    reason: str,
+    *,
+    research_complete_yaml_parses: bool,
+    core_pretest_green: bool,
+    ebt_harness_importable: bool,
+    preconditions_checked: Mapping[str, Any],
+    started_s: float | None,
