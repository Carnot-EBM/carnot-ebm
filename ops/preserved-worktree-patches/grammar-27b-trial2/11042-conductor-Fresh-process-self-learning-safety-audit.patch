@@ -0,0 +1,19 @@
+#!/usr/bin/env python3
+"""Run the Exp6979 read-only cold audit in a fresh process."""
+
+from __future__ import annotations
+
+from pathlib import Path
+import sys
+
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+PYTHON_ROOT = REPO_ROOT / "python"
+if str(PYTHON_ROOT) not in sys.path:
+    sys.path.insert(0, str(PYTHON_ROOT))
+
+from carnot.experiment_6979_self_learning_cold_audit import main  # noqa: E402
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tests/python/test_experiment_6979_self_learning_cold_audit.py b/tests/python/test_experiment_6979_self_learning_cold_audit.py
