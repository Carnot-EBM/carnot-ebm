+def build_corrigendum_artifact(
+    *,
+    exp3704: Mapping[str, Any],
+    exp3704_path: Path,
+    exp3704_sha256: str,
+    north_star_hash_before: str,
+    north_star_hash_after: str,
+    ci_workflow_hash_before: str,
