+        summary_statuses=_summary_statuses(live_critical={3920, 3922}),
+        started_s=2.0,
+        now_s=2.5,
+    )
+    saved = json.loads(output.read_text(encoding="utf-8"))
+    exp3923.validate_artifact(saved)
+    assert saved["honest_verdict"] == artifact["honest_verdict"]
+
