+def build_research_complete_block(task_verdicts: Mapping[str, str]) -> str:
+    """Build the append-only `.366` archive truth record."""
+
+    finding = (
+        ".366 banked the exp3954 lp85 second ARC solve, recorded exp3959 as "
+        "flagged M3 fabrication, and preserved the no-artifact state for "
+        "exp3953, exp3955, exp3960, exp3961, and exp3962."
+    )
+    lines = [
+        f"- id: {ARCHIVED_MILESTONE}",
+        f"  {ARCHIVE_MARKER}",
+        f"  title: {yaml_single_quote('Archive .366 and activate .367 with ARC truth preserved')}",
+        "  doc: openspec/change-proposals/research-roadmap-vNEXT.md",
+        "  completed: '2026-06-09'",
+        f"  finding: {yaml_single_quote(finding)}",
+        "  activation_recorded: exp3963-archive-v366-activate-v367",
+        "  tasks:",
+    ]
+    for task in V366_TASKS:
+        task_id = str(task["id"])
+        result = task_verdicts.get(task_id, "missing")
+        lines.extend(
+            [
+                f"  - id: {task_id}",
+                f"    title: {yaml_single_quote(str(task['title']))}",
+                f"    deliverable: {task['deliverable']}",
+                f"    result: {yaml_single_quote(result)}",
+            ]
+        )
