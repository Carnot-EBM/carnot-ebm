+def _milestone_tasks(text: str, milestone_id: str) -> list[Mapping[str, Any]]:
+    try:
+        data = yaml.safe_load(text)
+    except yaml.YAMLError:
+        return []
+    milestones = data.get("milestones") if isinstance(data, Mapping) else None
+    if not isinstance(milestones, list):
+        return []
+    tasks: list[Mapping[str, Any]] = []
+    for milestone in milestones:
+        if not isinstance(milestone, Mapping) or str(milestone.get("id")) != milestone_id:
+            continue
+        raw_tasks = milestone.get("tasks")
+        if not isinstance(raw_tasks, list):
+            continue
+        tasks.extend(task for task in raw_tasks if isinstance(task, Mapping))
+    return tasks
+
+
+def second_solve_recorded_from_text(text: str) -> bool:
+    """Return true when the .366 archive preserves Exp 3954 as the second solve."""
+
+    for task in _milestone_tasks(text, ARCHIVED_MILESTONE):
+        if task.get("id") != "exp3954-second-game-solve":
+            continue
+        result = str(task.get("result") or "")
+        if (
+            result.startswith("complete:")
+            and "second_game_solve_lp85-305b61c3" in result
+            and "SECOND_SOLVE" in result
+        ):
+            return True
+    return False
+
+
+def m3_fabrication_recorded_from_text(text: str) -> bool:
+    """Return true when the .366 archive records Exp 3959 as fabricated."""
+
+    for task in _milestone_tasks(text, ARCHIVED_MILESTONE):
+        if task.get("id") != "exp3959-m3-efficiency-real-games":
+            continue
+        result = str(task.get("result") or "")
+        if (
+            "M3_FABRICATION" in result
+            and "VERIFIER_NOT_IN_LOOP" in result
+            and "SIMULATED_NOT_REAL" in result
+        ):
+            return True
+    return False
+
