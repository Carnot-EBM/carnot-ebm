+        "milestone resumes it (continuous, not one-shot)."
+    ),
+    "model_specs": (
+        "Names the corpus + 4 verifiers + the JEPA predictor -- honest substrate."
+    ),
+    "random_seed": "Determinism precondition.",
+    "reproducibility_checksum": "Content hash catches drift.",
