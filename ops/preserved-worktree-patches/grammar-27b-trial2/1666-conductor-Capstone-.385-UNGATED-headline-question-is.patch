+            "estimated_passes_to_085",
+        ]
+    if 4158 in clean_ids:
+        fields[4158] = [
+            "headroom_present",
+            "oracle_at_k",
+            "vote_at_1",
+            "rerank_lift_vs_vote",
+            "verifier_recovers_outvoted",
+            "cost_ratio_vs_llm_judge",
+        ]
+    if 4159 in clean_ids:
+        fields[4159] = [
+            "graft_deferred",
+            "verifier_value_added",
+            "current_val",
+            "rft_vs_ablation_delta",
+        ]
+    if 4160 in clean_ids:
+        fields[4160] = [
+            "action_efficiency_ratio",
