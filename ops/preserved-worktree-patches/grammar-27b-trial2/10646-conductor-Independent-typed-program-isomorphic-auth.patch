+def test_scenario_constraint_6849_semantic_mutations_flip_exact_labels(
+    artifact: dict,
+) -> None:
+    """SCENARIO-CONSTRAINT-6849-REDUCER-MUTATION pins exact negative controls."""
+
+    rows = artifact["semantic_mutation_rows"]
+
+    assert len(rows) == 4
