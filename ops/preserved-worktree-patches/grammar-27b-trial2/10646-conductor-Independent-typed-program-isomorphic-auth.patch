+    assert witnesses == [
+        {
+            "collision_kind": "duplicate_identifier",
+            "identity": "same",
+            "namespace": "candidate",
+            "occurrences": 2,
+            "semantic_identities": ["sem-a", "sem-b"],
+        }
+    ]
