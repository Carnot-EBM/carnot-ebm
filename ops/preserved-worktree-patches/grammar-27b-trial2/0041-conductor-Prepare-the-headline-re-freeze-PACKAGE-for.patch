+def test_exp3681_helper_edges(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    """REQ-PUBLISH-040: helper branches stay honest on missing or bad inputs."""
+
+    assert exp3681._sha256_file(tmp_path / "missing") == "missing"
