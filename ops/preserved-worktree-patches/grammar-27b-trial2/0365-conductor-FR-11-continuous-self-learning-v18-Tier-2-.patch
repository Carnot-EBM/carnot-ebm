+    labels_arr = np.asarray(labels, dtype=np.int64)
+    _require_binary_labels(labels_arr)
+    raw_matrix = score_matrix(scores_by_verifier, VERIFIER_NAMES)
+    if raw_matrix.shape[0] != len(labels_arr):
