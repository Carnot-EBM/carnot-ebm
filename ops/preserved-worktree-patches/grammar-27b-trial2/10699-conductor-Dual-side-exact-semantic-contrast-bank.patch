+#!/usr/bin/env python3
+"""Run the Exp6862 deterministic dual-side semantic contrast bank."""
+
+from carnot.experiment_6862_dual_side_semantic_contrast_bank import main
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tests/python/test_experiment_6862_dual_side_semantic_contrast_bank.py b/tests/python/test_experiment_6862_dual_side_semantic_contrast_bank.py
