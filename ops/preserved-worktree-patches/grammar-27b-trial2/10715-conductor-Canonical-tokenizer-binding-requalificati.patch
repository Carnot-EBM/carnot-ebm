+        "candidate_sequence_template": EXP6862_CANDIDATE_SEQUENCE_TEMPLATE,
+        "probes": probes,
+        "settings": list(PROBE_SETTINGS),
+    }
+    return {**basis, "manifest_sha256": sha256_json(basis)}
+
