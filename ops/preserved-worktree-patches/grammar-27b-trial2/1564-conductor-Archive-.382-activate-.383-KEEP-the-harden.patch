+        ("cited_upstream_artifacts", lambda a: a.__setitem__("cited_upstream_artifacts", "x")),
+        ("reproducibility_checksum", lambda a: a.__setitem__("reproducibility_checksum", "short")),
+    ]
+    for match, mutate in cases:
