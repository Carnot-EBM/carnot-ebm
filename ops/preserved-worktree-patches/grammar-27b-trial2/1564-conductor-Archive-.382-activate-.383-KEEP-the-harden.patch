+INFERENCE_SUBSTRATE = "aggregation_from_upstream_artifacts"
+SCHEMA = "carnot.archive_activation.v382_to_v383_4134.v1"
+EXPERIMENT_ID = "exp4134"
+TASK_ID = "exp4134-archive-v382-activate-v383"
+
