+    pool = exp.load_eval_pool(Path("results/arc3_gap4_arc2_eval_pool.json.gz"))
+    chain_artifact = exp.load_json(Path("results/arc3_gap4_arc2_chain_ensemble.json"))
+    tasks = exp.clean_new_tasks(pool["entries"], chain_artifact)
