+
+    n_eval = 0
+    gold_e_easy, gold_e_hard = [], []  # gold scores paired (for overall AUROC)
+    easy_scores, hard_scores = [], []
+    per_distr = {}  # kind -> list of (gold_score, distractor_score)
+
+    for t in task_ids:
