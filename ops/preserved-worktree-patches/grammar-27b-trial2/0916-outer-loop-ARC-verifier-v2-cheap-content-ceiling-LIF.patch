+from arc_grid_verifier_discriminator_draft import (  # noqa: E402  (path-insert before import)
+    _auroc,
+    _bg,
+    _build_invariants,
+    _colors,
+    _dims,
+    _distractors,
+    _palette_counts,
+    _predicted_dims,
+)
