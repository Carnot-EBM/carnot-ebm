+        prev = c
+
+    top_rows = np.where(np.any((g[:first_sep] != bg) & (g[:first_sep] != g[first_sep, 0]), axis=1))[0]
+    top_start = top_rows[0] if len(top_rows) else 1
+
+    def sig_at(r, c):
+        return tuple(tuple(int(x) for x in row) for row in g[r:r+3, c:c+3])
