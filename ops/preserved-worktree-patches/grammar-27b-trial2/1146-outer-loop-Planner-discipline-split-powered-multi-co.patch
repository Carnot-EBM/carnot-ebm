+def _minimum_effect_raw(
+    n: int,
+    target_power: float = POWER_TARGET,
+    alpha: float = ALPHA,
+) -> float:
+    if n <= 0 or _power_at_probability(n, 1.0, alpha) < target_power:
+        return 1.0
+    lo = 0.5
+    hi = 1.0
+    for _ in range(60):
+        mid = (lo + hi) / 2.0
+        if _power_at_probability(n, mid, alpha) >= target_power:
+            hi = mid
+        else:
+            lo = mid
+    return hi - 0.5
