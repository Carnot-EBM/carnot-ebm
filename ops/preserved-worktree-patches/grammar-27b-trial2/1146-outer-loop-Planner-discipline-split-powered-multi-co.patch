+            start = cells.pop()
+            q = [start]
+            comp = [start]
+            for r, c in q:
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    p = (r + dr, c + dc)
+                    if p in cells:
