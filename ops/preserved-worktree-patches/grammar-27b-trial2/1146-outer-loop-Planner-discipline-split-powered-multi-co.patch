+    for r, c in barrier:
+        out[r, c] = grid[r, c]
+
+    occupied = set(barrier_set)
+    remaining = pieces[:]
+
+    while remaining:
+        best = None
+
+        for i, p in enumerate(remaining):
+            for tr in range(0, H - p["h"] + 1):
+                for tc in range(0, W - p["w"] + 1):
+                    placed = [(tr + r, tc + c) for r, c in p["cells"]]
+                    if any(pos in occupied for pos in placed):
+                        continue
+
+                    contact = 0
+                    barrier_contact = 0
+                    for r, c in placed:
+                        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                            nb = (r + dr, c + dc)
+                            if nb in occupied:
