+    vals, counts = np.unique(g, return_counts=True)
+    bg = vals[np.argmax(counts)]
+
+    sep_rows = [r for r in range(h) if len(set(g[r].tolist())) == 1 and g[r, 0] != bg]
+    first_sep = sep_rows[0]
+    last_sep = sep_rows[-1]
+
+    body = g[first_sep + 1:last_sep]
+    body_rows = np.where(np.any((body != bg) & (body != g[first_sep, 0]), axis=1))[0] + first_sep + 1
+    row_starts = []
+    prev = None
+    for r in body_rows:
+        if prev is None or r > prev + 1:
