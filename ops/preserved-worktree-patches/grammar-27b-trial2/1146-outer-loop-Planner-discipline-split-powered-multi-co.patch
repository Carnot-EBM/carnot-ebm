+        q = grid[r0:r1, c0:c1]
+        q2 = np.argwhere(q == 2)
+        if len(q2) == 0:
+            continue
+
+        if sr == 1 and sc == 1:
+            pat = pattern
+        elif sr == 1 and sc == -1:
+            pat = pattern[:, ::-1]
+        elif sr == -1 and sc == 1:
+            pat = pattern[::-1, :]
+        else:
