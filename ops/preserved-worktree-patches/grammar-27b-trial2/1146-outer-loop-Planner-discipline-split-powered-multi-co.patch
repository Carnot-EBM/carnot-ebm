+            while c < w and out[r, c] == col:
+                c += 1
+            c1 = c - 1
+            if col in (2, 3):
+                marker_runs.append((col, c0, c1))
+        else:
+            c += 1
+
+    twos = [(c0, c1) for col, c0, c1 in marker_runs if col == 2]
+    threes = [(c0, c1) for col, c0, c1 in marker_runs if col == 3]
+
+    # Remove the bottom instruction markers.
+    for _, c0, c1 in marker_runs:
+        out[r, c0:c1 + 1] = bg
+
+    # Find connected components above the bottom marker row.
+    seen = np.zeros(out.shape, dtype=bool)
+    comps = []
+    for i in range(h - 1):
+        for j in range(w):
+            if seen[i, j] or out[i, j] == bg:
+                continue
+            color = out[i, j]
+            stack = [(i, j)]
+            seen[i, j] = True
+            cells = []
+            while stack:
+                x, y = stack.pop()
+                cells.append((x, y))
+                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nx, ny = x + dx, y + dy
+                    if 0 <= nx < h - 1 and 0 <= ny < w and not seen[nx, ny] and out[nx, ny] == color:
+                        seen[nx, ny] = True
+                        stack.append((nx, ny))
+            rs = [p[0] for p in cells]
+            cs = [p[1] for p in cells]
+            comps.append({
+                "color": color,
+                "cells": cells,
+                "r0": min(rs), "r1": max(rs),
+                "c0": min(cs), "c1": max(cs)
+            })
+
+    def in_slot(comp, slot):
+        c0, c1 = slot
+        return comp["c0"] >= c0 and comp["c1"] <= c1
+
+    two_count = sum(1 for comp in comps for slot in twos if in_slot(comp, slot))
+
+    # Columns marked 2 are recolored to 5.
+    for comp in comps:
+        if any(in_slot(comp, slot) for slot in twos):
+            for i, j in comp["cells"]:
+                out[i, j] = 5
+
+    # Infer vertical repeat spacing for the repeated motif.
+    tops = sorted({comp["r0"] for comp in comps})
+    diffs = [b - a for a, b in zip(tops, tops[1:]) if b > a]
+    period = min(diffs) if diffs else None
+
+    # Columns marked 3 receive extra copies above, one for each 2-marked object.
+    for slot in threes:
+        slot_comps = [comp for comp in comps if in_slot(comp, slot)]
+        if not slot_comps:
+            continue
+        template = min(slot_comps, key=lambda x: x["r0"])
+        step = period if period is not None else (template["r1"] - template["r0"] + 2)
+        for k in range(1, two_count + 1):
+            dr = -step * k
+            for i, j in template["cells"]:
+                ni = i + dr
+                if 0 <= ni < h:
+                    out[ni, j] = template["color"]
+
+    return out
