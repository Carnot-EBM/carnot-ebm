+        cs = [p[1] for p in comp]
+        r0, c0 = min(rs), min(cs)
+        cells = [(r - r0, c - c0) for r, c in comp]
+        pieces.append({
+            "color": color,
+            "cells": cells,
+            "h": max(rs) - r0 + 1,
+            "w": max(cs) - c0 + 1,
+            "orig": (r0, c0),
