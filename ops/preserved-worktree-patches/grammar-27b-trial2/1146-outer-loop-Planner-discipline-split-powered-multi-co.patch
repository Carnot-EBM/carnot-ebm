+        prev = r
+
+    body_cols = np.where(np.any((g[first_sep + 1:last_sep] != bg) &
+                                (g[first_sep + 1:last_sep] != g[first_sep, 0]), axis=0))[0]
+    col_starts = []
+    prev = None
+    for c in body_cols:
+        if prev is None or c > prev + 1:
