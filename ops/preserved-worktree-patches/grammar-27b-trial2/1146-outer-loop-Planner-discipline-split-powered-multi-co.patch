+                        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                            nr, nc = cr + dr, cc + dc
+                            if r0 <= nr <= r1 and c0 <= nc <= c1 and (nr, nc) not in comp_set and (nr, nc) not in box_bg_seen:
+                                box_bg_seen.add((nr, nc))
+                                q.append((nr, nc))
+
+                    if not touches_box_edge:
+                        holes.update(region)
+
+            if holes:
+                for r, c in comp:
+                    out[r, c] = 8
