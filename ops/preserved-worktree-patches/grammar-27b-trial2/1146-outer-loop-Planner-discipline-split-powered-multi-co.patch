+
+    bottom_r = max(r for r, _, _ in centers)
+    instruction_row = bottom_r
+    object_centers = [(r, c, color) for r, c, color in centers if r != instruction_row]
+
+    # Remove the instruction row.
+    out[instruction_row, :] = bg
+
+    by_col = {}
+    for r, c, color in object_centers:
+        by_col.setdefault(c, []).append((r, color))
+
+    def paint_shape(arr, mid_r, center_c, color):
+        arr[mid_r - 1, center_c - 1:center_c + 2] = color
+        arr[mid_r, center_c - 2:center_c + 3] = color
