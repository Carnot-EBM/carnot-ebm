+        for r in range(H - s + 1):
+            for c in range(W - s + 1):
+                n = np.count_nonzero(g[r:r+s, c:c+s])
+                if n == 0:
+                    continue
+                dens = n / (s * s)
+                if dens < 0.20:
+                    continue
+                key = (n, dens, -s)
+                if best is None or key > best[0]:
+                    best = (key, r, c, s)
