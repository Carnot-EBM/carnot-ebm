+    def transform(grid):
+        # grid: 2D numpy int array (colors 0-9). Return the transformed grid as a numpy
+        # int array. THE OUTPUT SHAPE MAY DIFFER from the input shape.
+Infer the rule from the demos and implement it GENERICALLY (np is provided; no imports, no file/network access). Your function MUST reproduce every demo output exactly from its demo input, and must then generalize to the test input by applying the SAME rule. Do NOT hardcode demo-specific coordinates/colors or anything specific to the test input. Output ONLY one ```python code block.
+===== RAW OUTPUT =====
+```python
+def transform(grid):
+    h, w = grid.shape
+    vals, counts = np.unique(grid, return_counts=True)
+
+    bg = vals[np.argmax(counts)]
+
+    sep = None
+    sep_count = -1
+    for v, c in zip(vals, counts):
+        if v != bg and c > sep_count:
+            sep = v
+            sep_count = c
+
+    if sep is None:
+        return grid.copy()
+
+    out = grid.copy()
+    seen = np.zeros((h, w), dtype=bool)
+
+    for sr in range(h):
+        for sc in range(w):
+            if seen[sr, sc] or grid[sr, sc] == sep:
+                continue
+
+            stack = [(sr, sc)]
+            seen[sr, sc] = True
+            comp = []
+
+            while stack:
+                r, c = stack.pop()
+                comp.append((r, c))
+                for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and grid[nr, nc] != sep:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            rmin = min(r for r, c in comp)
+            rmax = max(r for r, c in comp)
+            cmin = min(c for r, c in comp)
+            cmax = max(c for r, c in comp)
+
+            ring_colors = {}
+            for r, c in comp:
+                v = grid[r, c]
+                if v != bg and v != sep:
+                    d = min(r - rmin, rmax - r, c - cmin, cmax - c)
+                    ring_colors.setdefault(d, v)
+
+            if not ring_colors:
+                continue
+
+            max_seed_ring = max(ring_colors)
+            cycle = [ring_colors.get(i, bg) for i in range(max_seed_ring + 1)]
+
+            for r, c in comp:
+                d = min(r - rmin, rmax - r, c - cmin, cmax - c)
+                out[r, c] = cycle[d % len(cycle)]
+
+    return out
+```
