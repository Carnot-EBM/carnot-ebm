+        outside[r0:r0+s, c0:c0+s] = False
+        pts = np.argwhere(outside)
+
+        if len(pts) == 0:
+            trans = layer
+        else:
+            rr0, cc0 = pts.min(axis=0)
+            rr1, cc1 = pts.max(axis=0)
+            h = rr1 - rr0 + 1
+            w = cc1 - cc0 + 1
+            cr = (rr0 + rr1) / 2
+            cc = (cc0 + cc1) / 2
+            mr = r0 + (s - 1) / 2
+            mc = c0 + (s - 1) / 2
+            dr = cr - mr
+            dc = cc - mc
+
+            if h > w:
+                trans = np.rot90(layer, 2)
+            elif w > h:
+                if dr < 0:
+                    trans = np.rot90(layer, 1)
+                else:
+                    trans = np.rot90(layer, 2)
+            else:
+                lpts = np.argwhere(layer)
+                touches = False
+                if len(lpts):
