+            candidates.sort(key=lambda x: np.sum(x[2]), reverse=True)
+            patterns[col] = candidates[0][2]
+
+    # Crop to the large-block arrangement.
+    rmin = min(r for r, c, col in large) - 1
+    cmin = min(c for r, c, col in large) - 1
+    rmax = max(r for r, c, col in large) + 6
