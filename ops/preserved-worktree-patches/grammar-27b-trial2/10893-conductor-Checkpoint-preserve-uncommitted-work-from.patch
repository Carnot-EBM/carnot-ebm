+def blocked_artifact(
+    *,
+    date: str,
+    duration_s: float,
+    checks: Sequence[Mapping[str, Any]],
+    source_hashes: Mapping[str, Any],
+    model_files: Sequence[Mapping[str, Any]],
+) -> JsonDict:
+    """Return the exact terminal artifact for failed preconditions."""
