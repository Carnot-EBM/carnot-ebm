+def artifact_checksum(artifact: Mapping[str, Any]) -> str:
+    """Hash every artifact field except the digest that contains the hash."""
+
+    return sha256_text(
+        canonical_json(
+            {key: value for key, value in artifact.items() if key != "reproducibility_checksum"}
+        )
+    )
