+                    _hz_lethal = bool(self.hazard_move_pruner.should_prune(frame, _hz_row))
+                except Exception:
+                    _hz_lethal = False
+                    self._hazard_prune_errors += 1
+                if _hz_lethal:
+                    self._hazard_rows_pruned += 1
+                else:
+                    kept.append(_hz_row)
+            if not kept:
