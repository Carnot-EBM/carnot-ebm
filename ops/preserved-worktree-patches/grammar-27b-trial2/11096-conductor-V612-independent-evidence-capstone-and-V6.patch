+                    except TypeError:
+                        try:
+                            action_prior.reset()
+                        except Exception:
+                            pass
+                    except Exception:
+                        pass
+            if over:
+                origin_node = self.graph.get(o["origin"], {})
+                act = {"action": o["action"], "data": o["data"]}
+                new_path = list(origin_node.get("path", [])) + [act]
+                self._record_discriminative_sample(
+                    latest,
+                    previous_frame=o.get("previous_frame") or origin_node.get("frame"),
+                    label=0,
+                    source="game_over",
+                    node_hash=h,
+                    path=new_path,
