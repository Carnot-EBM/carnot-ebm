+    @staticmethod
+    def _reward_machine_grid_hash(grid: Any) -> str:
+        try:
+            import numpy as np
+
+            arr = np.asarray(grid)
+            payload = {
+                "shape": list(arr.shape),
+                "values": arr.astype(int, copy=False).tolist() if arr.size else [],
+            }
+            return json.dumps(payload, sort_keys=True, separators=(",", ":"))
+        except Exception:
+            return repr(grid)[:160]
