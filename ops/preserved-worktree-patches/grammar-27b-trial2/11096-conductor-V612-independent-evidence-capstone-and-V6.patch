+        two_sided_goal_contract: Any | bool | None = None,
+        # REQ-ARC-WMTE-6180 (lever #5, 2026-08-07): default None (not the SUBMITTED_*/kit value)
+        # for the same reason as `hazard_move_pruner` above -- GATED, resolved through the
