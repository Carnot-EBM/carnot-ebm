            v_period = period\n                break\n    \n    # Extract the tile\n    tile = clean_part[:v_period, :h_period]\n    \n    # Extend the tile to fill the entire grid\n    result = np.zeros((rows, cols), dtype=int)\n    for r in range(rows):\n        for c in range(cols):\n            result[r, c] = tile[r % v_period, c % h_period]\n    \n    return result",
