 in range(h):\n        xs = np.flatnonzero(out[r] == col)\n        if len(xs) < 2:\n            continue\n        for a, b in zip(xs[:-1], xs[1:]):\n            if 1 < b - a <= 4 and row_support(r, a, b):\n                out[r, a:b + 1] = col\n\n    for c in range(w):\n        ys = np.flatnonzero(out[:, c] == col)\n        if len(ys) < 2:\n            continue\n        for a, b in zip(ys[:-1], ys[1:]):\n            if 1 < b - a <= 5 and col_support(c, a, b):\n                out[a:b + 1, c] = col\n\n    return out",
