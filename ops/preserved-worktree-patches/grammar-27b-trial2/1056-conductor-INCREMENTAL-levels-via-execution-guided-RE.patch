+
+        op = "id"
+        if len(pts):
+            rr0, cc0 = pts.min(axis=0)
+            rr1, cc1 = pts.max(axis=0)
+            h = rr1 - rr0 + 1
+            w = cc1 - cc0 + 1
+            cy = (rr0 + rr1) / 2
+            cx = (cc0 + cc1) / 2
+            cnt = int(mask.sum())
+
+            if h == 1 and w > 1:
+                op = "ccw" if cy < r0 else "id"
+            elif w == 1 and h > 1:
+                op = "ccw" if cy < r0 else "r180"
+            elif h == 1 and w == 1:
