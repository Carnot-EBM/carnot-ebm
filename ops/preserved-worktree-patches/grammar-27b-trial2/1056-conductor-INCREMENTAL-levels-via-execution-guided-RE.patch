+                    if 0 <= nr < h and 0 <= nc < w and not outside[nr, nc] and (nr, nc) not in blocked:
+                        outside[nr, nc] = True
+                        stack.append((nr, nc))
+
+            holes = []
+            for r in range(h):
+                for c in range(w):
+                    if grid[r, c] == bg and (r, c) not in border and not outside[r, c]:
+                        holes.append((r, c))
+
+            for r, c in border:
+                out[r, c] = 2
+
+            if holes:
+                for r, c in cells:
+                    out[r, c] = 8
+                for r, c in holes:
+                    out[r, c] = 6
