+      "code": "def transform(grid):\n    bg = np.bincount(grid.ravel(), minlength=10).argmax()\n    counts = np.bincount(grid.ravel(), minlength=10)\n\n    non_bg = [c for c in range(10) if c != bg and counts[c] > 0]\n    marker_colors = [c for c in non_bg if counts[c] == min(counts[x] for x in non_bg)]\n    marker = marker_colors[0]\n\n    keep_colors = [c for c in non_bg if c != marker]\n    border = max(keep_colors, key=lambda c: counts[c])\n\n    h0, w0 = grid.shape\n    keep = np.isin(grid, keep_colors)\n    seen = np.zeros_like(keep, dtype=bool)\n    pieces = []\n\n    for r in range(h0):\n        for c in range(w0):\n            if keep[r, c] and not seen[r, c]:\n                q = [(r, c)]\n                seen[r, c] = True\n                pts = []\n                for rr, cc in q:\n                    pts.append((rr, cc))\n                    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nr, nc = rr + dr, cc + dc\n                        if 0 <= nr < h0 and 0 <= nc < w0 and keep[nr, nc] and not seen[nr, nc]:\n                            seen[nr, nc] = True\n                            q.append((nr, nc))\n\n                rs = [p[0] for p in pts]\n                cs = [p[1] for p in pts]\n                r1, r2 = min(rs), max(rs)\n                c1, c2 = min(cs), max(cs)\n                cells = []\n                for rr, cc in pts:\n                    cells.append((rr - r1, cc - c1, int(grid[rr, cc])))\n                pieces.append({\n                    \"h\": r2 - r1 + 1,\n                    \"w\": c2 - c1 + 1,\n                    \"cells\": cells,\n                    \"n\": len(cells)\n                })\n\n    area = sum(p[\"n\"] for p in pieces)\n\n    mpts = np.argwhere(grid == marker)\n    mr1, mc1 = mpts.min(axis=0)\n    mr2, mc2 = mpts.max(axis=0)\n    marker_set = {(int(r), int(c)) for r, c in mpts}\n    missing = None\n    for rr in range(int(mr1), int(mr2) + 1):\n        for cc in range(int(mc1), int(mc2) + 1):\n            if (rr, cc) not in marker_set:\n                missing = (rr, cc)\n\n    mr, mc = missing\n    if missing == (mr2, mc2):\n        corner = \"tl\"\n    elif missing == (mr1, mc1):\n        corner = \"br\"\n    elif missing == (mr1, mc2):\n        corner = \"bl\"\n    else:\n        corner = \"tr\"\n\n    def origin_for(H, W):\n        if corner == \"tl\":\n            return mr, mc\n        if corner == \"br\":\n            return mr - H + 1, mc - W + 1\n        if corner == \"bl\":\n            return mr - H + 1, mc\n        return mr, mc - W + 1\n\n    dims = []\n    for H in range(1, area + 1):\n        if area % H == 0:\n            W = area // H\n            if H <= h0 and W <= w0:\n                top, left = origin_for(H, W)\n                if 0 <= top and 0 <= left and top + H <= h0 and left + W <= w0:\n                    if H >= max(p[\"h\"] for p in pieces) and W >= max(p[\"w\"] for p in pieces):\n                        dims.append((H, W))\n    dims.sort(key=lambda x: (x[0] > x[1], abs(x[0] - x[1]), x[0]))\n\n    pieces.sort(key=lambda p: -p[\"n\"])\n\n    def solve(H, W):\n        board = np.full((H, W), -1, dtype=int)\n        used = [False] * len(pieces)\n\n        def ok_place(p, top, left):\n            if top < 0 or left < 0 or top + p[\"h\"] > H or left + p[\"w\"] > W:\n                return False\n            for dr, dc, val in p[\"cells\"]:\n                rr, cc = top + dr, left + dc\n                if board[rr, cc] != -1:\n                    return False\n                if (rr == 0 or cc == 0 or rr == H - 1 or cc == W - 1) and val != border:\n                    return False\n            return True\n\n        def put(p, top, left, val):\n            for dr, dc, col in p[\"cells\"]:\n                board[top + dr, left + dc] = col if val else -1\n\n        def bt():\n            pos = np.argwhere(board == -1)\n            if len(pos) == 0:\n                return True\n            r, c = map(int, pos[0])\n            for i, p in enumerate(pieces):\n                if used[i]:\n                    continue\n                for dr, dc, _ in p[\"cells\"]:\n                    top, left = r - dr, c - dc\n                    if ok_place(p, top, left):\n                        used[i] = True\n                        put(p, top, left, True)\n                        if bt():\n                            return True\n                        put(p, top, left, False)\n                        used[i] = False\n            return False\n\n        if bt():\n            return board\n        return None\n\n    rect = None\n    best_dim = None\n    for H, W in dims:\n        rect = solve(H, W)\n        if rect is not None:\n            best_dim = (H, W)\n            break\n\n    out = np.full_like(grid, bg)\n    H, W = best_dim\n    top, left = origin_for(H, W)\n    out[top:top + H, left:left + W] = rect\n    return out",
