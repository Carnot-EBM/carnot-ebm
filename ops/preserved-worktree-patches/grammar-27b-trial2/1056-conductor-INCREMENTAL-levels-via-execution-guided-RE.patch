+      "code": "def transform(grid):\n    h, w = grid.shape\n    out = grid.copy()\n\n    vals, counts = np.unique(grid, return_counts=True)\n    bg = vals[np.argmax(counts)]\n\n    colors = [v for v in vals if v != bg]\n    comps = []\n    seen = np.zeros((h, w), dtype=bool)\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r, c] == bg or seen[r, c]:\n                continue\n            col = grid[r, c]\n            stack = [(r, c)]\n            seen[r, c] = True\n            cells = []\n            while stack:\n                rr, cc = stack.pop()\n                cells.append((rr, cc))\n                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nr, nc = rr + dr, cc + dc\n                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and grid[nr, nc] == col:\n                        seen[nr, nc] = True\n                        stack.append((nr, nc))\n            comps.append((col, cells))\n\n    frame_color = None\n    best = -1\n    for col, cells in comps:\n        if len(cells) > best:\n            best = len(cells)\n            frame_color = col\n\n    seed_colors = [v for v in colors if v != frame_color]\n    fill_color = None\n    for col in seed_colors:\n        if np.sum(grid == col) == 1:\n            fill_color = col\n            break\n    if fill_color is None:\n        fill_color = seed_colors[0]\n\n    barrier = (grid == frame_color)\n\n    for col in seed_colors:\n        if col != fill_color:\n            barrier |= (grid == col)\n\n    starts = list(zip(*np.where(grid == fill_color)))\n    q = list(starts)\n    reached = np.zeros((h, w), dtype=bool)\n    for r, c in starts:\n        reached[r, c] = True\n\n    while q:\n        r, c = q.pop(0)\n        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < h and 0 <= nc < w and not reached[nr, nc] and not barrier[nr, nc]:\n                reached[nr, nc] = True\n              