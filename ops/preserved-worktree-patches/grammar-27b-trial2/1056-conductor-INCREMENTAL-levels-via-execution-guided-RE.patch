+      "code": "def transform(grid):\n    g = grid\n    rows = np.where(np.any(g != 0, axis=1))[0]\n\n    best_start = best_end = rows[0]\n    start = prev = rows[0]\n    for r in rows[1:]:\n        if r == prev + 1:\n            prev = r\n        else:\n            if prev - start > best_end - best_start:\n                best_start, best_end = start, prev\n            start = prev = r\n    if prev - start > best_end - best_start:\n        best_start, best_end = start, prev\n\n    r0, r1 = best_start, best_end\n    cols = np.where(np.any(g[r0:r1 + 1] != 0, axis=0))[0]\n    c0, c1 = cols[0], cols[-1]\n\n    crop = g[r0:r1 + 1, c0:c1 + 1]\n    h, w = crop.shape\n    out = np.zeros_like(crop)\n\n    outside_rect = np.ones(g.shape, dtype=bool)\n    outside_rect[r0:r1 + 1, c0:c1 + 1] = False\n\n    for color in np.unique(crop):\n        if color == 0:\n            continue\n\n        mask = crop == color\n        pts = np.argwhere((g == color) & outside_rect)\n\n        if len(pts):\n            rr0, cc0 = pts.min(axis=0)\n            rr1, cc1 = pts.max(axis=0)\n\n            above = rr1 < r0\n            below = rr0 > r1\n            left = cc1 < c0\n            right = cc0 > c1\n\n            diagonal = (above or below) and (left or right)\n            ph = rr1 - rr0 + 1\n            pw = cc1 - cc0 + 1\n\n            if diagonal:\n                if len(pts) == 1:\n                    if (below and left) or (above and right):\n                        mask = np.rot90(mask, -1)\n                    else:\n                        mask = np.rot90(mask, 1)\n                elif ph > pw:\n                    mask = np.flipud(np.fliplr(mask))\n                elif pw > ph:\n                    mask = np.flipud(mask)\n                else:\n                    mask = np.flipud(np.fliplr(mask))\n            else:\n                if left or right:\n                    mask = np.fliplr(mask)\n                if above or below:\n                    mask = np.flipud(mask)\n\n        out[mask] = color\n\n    return out",
