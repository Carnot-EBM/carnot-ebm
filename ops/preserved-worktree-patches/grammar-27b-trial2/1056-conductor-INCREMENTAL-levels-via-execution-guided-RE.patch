                for r in range(a + 1, b):\n                            if g[r, c] == bg:\n                                fill[r, c] = True\n\n            row_items = sorted((r, min(cs), max(cs)) for r, cs in rows.items())\n            for i in range(len(row_items)):\n                r1, a1, b1 = row_items[i]\n                for j in range(i + 1, len(row_items)):\n                    r2, a2, b2 = row_items[j]\n                    a, b = max(a1, a2), min(b1, b2)\n                    if a > b:\n                        continue\n                    if all((rr, a) in s or (rr, b) in s for rr in range(r1, r2 + 1)):\n                        for rr in range(r1 + 1, r2):\n                            for cc in range(a, b + 1):\n                                if g[rr, cc] == bg:\n                                    fill[rr, cc] = True\n                                    made = True\n\n            col_items = sorted((c, min(rs), max(rs)) for c, rs in cols.items())\n            for i in range(len(col_items)):\n                c1, a1, b1 = col_items[i]\n                for j in range(i + 1, len(col_items)):\n                    c2, a2, b2 = col_items[j]\n                    a, b = max(a1, a2), min(b1, b2)\n                    if a > b:\n                        continue\n                    if all((a, cc) in s or (b, cc) in s for cc in range(c1, c2 + 1)):\n                        for rr in range(a, b + 1):\n                            for cc in range(c1 + 1, c2):\n                                if g[rr, cc] == bg:\n                                    fill[rr, cc] = True\n                                    made = True\n\n            if made:\n                for r, c in cells:\n                    anchors[r, c] = True\n\n    for r in range(h):\n        seen_border = False\n        for c in range(w):\n            if anchors[r, c]:\n                seen_border = True\n            elif seen_border and g[r, c] == paint:\n                fill[r, c] = True\n\n    out = g.copy()\n  