+      "code": "def transform(grid):\n    bg = np.bincount(grid.ravel()).argmax()\n    h, w = grid.shape\n\n    best = None\n    for col in np.unique(grid):\n        if col == bg:\n            continue\n        for r1 in range(h):\n            for r2 in range(r1 + 2, h):\n                cs = np.where((grid[r1] == col) & (grid[r2] == col))[0]\n                for i in range(len(cs)):\n                    c1 = int(cs[i])\n                    for c2 in cs[i + 1:]:\n                        c2 = int(c2)\n                        if c2 <= c1 + 1:\n                            continue\n                        if (np.all(grid[r1, c1:c2 + 1] == col) and\n                            np.all(grid[r2, c1:c2 + 1] == col) and\n                            np.all(grid[r1:r2 + 1, c1] == col) and\n                            np.all(grid[r1:r2 + 1, c2] == col)):\n                            inside = grid[r1 + 1:r2, c1 + 1:c2]\n                            if inside.size and len(np.unique(inside)) == 1:\n                                area = (r2 - r1 + 1) * (c2 - c1 + 1)\n                                if best is None or area > best[0]:\n                                    best = (area, r1, r2, c1, c2, col, int(inside[0, 0]))\n\n    _, r1, r2, c1, c2, frame, fill = best\n    out_h, out_w = r2 - r1 - 1, c2 - c1 - 1\n    out = np.full((out_h, out_w), fill, dtype=grid.dtype)\n\n    blocked = np.zeros_like(grid, dtype=bool)\n    blocked[r1:r2 + 1, c1:c2 + 1] = True\n    vis = (grid != bg) & (~blocked)\n\n    groups = []\n\n    for col in np.unique(grid[vis]):\n        pts = [(int(r), int(c), int(grid[r, c])) for r, c in zip(*np.where(vis & (grid == col)))]\n        if pts:\n            groups.append(pts)\n\n    seen = np.zeros_like(grid, dtype=bool)\n    for sr, sc in zip(*np.where(vis)):\n        if seen[sr, sc]:\n            continue\n        stack = [(int(sr), int(sc))]\n        seen[sr, sc] = True\n        pts = []\n        while stack:\n            rr, cc = stack.pop()\n            pts.append((rr, cc, int(grid[rr, cc])))\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                nr, nc = rr + dr, cc + dc\n                if 0 <= nr < h and 0 <= nc < w and vis[nr, nc] and not seen[nr, nc]:\n                    seen[nr, nc] = True\n                    stack.append((nr, nc))\n        if pts:\n            groups.append(pts)\n\n    def has_adjacent(values):\n        s = set(values)\n        return any(v + 1 in s for v in s)\n\n    def alt_row_value(vals, pos, start):\n        vals = sorted(vals)\n        colors = sorted(set(v for _, v in vals))\n        if len(colors) == 1:\n            return colors[0]\n        anchor = vals[-1][1]\n        other = colors[0] if colors[1] == anchor else colors[1]\n        return anchor if (pos - start) % 2 == 0 else other\n\n    def alt_col_value(vals, pos, start, existing):\n        colors = sorted(set(v for _, v in vals))\n        if len(colors) == 1:\n            return colors[0]\n        if existing != fill:\n            anchor = int(existing)\n        else:\n            above = [(r, v) for r, v in vals if r < start]\n            if above:\n                last = max(above)[1]\n                anchor = colors[0] if colors[1] == last else colors[1]\n            else:\n                below = [(r, v) for r, v in vals if r > start]\n                anchor = min(below)[1] if below else vals[0][1]\n        other = colors[0] if colors[1] == anchor else colors[1]\n        return anchor if (pos - start) % 2 == 0 else other\n\n    for pts in groups:\n        rs = [p[0] for p in pts]\n        cs = [p[1] for p in pts]\n        gr1, gr2, gc1, gc2 = min(rs), max(rs), min(cs), max(cs)\n\n        row_vals = {}\n        col_vals = {}\n        for rr, cc, v in pts:\n            row_vals.setdefault(rr, []).append((cc, v))\n            col_vals.setdefault(cc, []).append((rr, v))\n\n        for rr, vals in row_vals.items():\n            if not (r1 < rr < r2):\n                continue\n            if not has_adj