+      "code": "def transform(grid):\n    g = np.array(grid, copy=True)\n    h, w = g.shape\n\n    vals, counts = np.unique(g, return_counts=True)\n    bg = vals[np.argmax(counts)]\n\n    non_bg = [v for v in vals if v != bg]\n    if not non_bg:\n        return g\n\n    # The divider/wall color is the non-background color forming the largest\n    # connected line structure.\n    wall = None\n    best = -1\n    for v in non_bg:\n        n = int(np.sum(g == v))\n        if n > best:\n            best = n\n            wall = v\n\n    out = g.copy()\n    open_cell = (g != wall)\n    seen = np.zeros((h, w), dtype=bool)\n    dirs4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    dirs8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if dr or dc]\n\n    for sr in range(h):\n        for sc in range(w):\n            if seen[sr, sc] or not open_cell[sr, sc]:\n                continue\n\n            comp = []\n            q = [(sr, sc)]\n            seen[sr, sc] = True\n            qi = 0\n            while qi < len(q):\n                r, c = q[qi]\n                qi += 1\n                comp.append((r, c))\n                for dr, dc in dirs4:\n                    nr, nc = r + dr, c + dc\n                    if 0 <= nr < h and 0 <= nc < w and open_cell[nr, nc] and not seen[nr, nc]:\n                        seen[nr, nc] = True\n                        q.append((nr, nc))\n\n            in_comp = np.zeros((h, w), dtype=bool)\n            for r, c in comp:\n                in_comp[r, c] = True\n\n            boundary = []\n            for r, c in comp:\n                b = (r == 0 or r == h - 1 or c == 0 or c == w - 1)\n                if not b:\n                    for dr, dc in dirs8:\n                        nr, nc = r + dr, c + dc\n                        if 0 <= nr < h and 0 <= nc < w and g[nr, nc] == wall:\n                            b = True\n                            break\n                if b:\n                    boundary.append((r, c))\n\n            dist = -np.ones((h, w), dtype=int)\n            frontier = []\n            for p in boundary:\n                dist[p] = 0\n                frontier.append(p)\n\n            qi = 0\n            while qi < len(frontier):\n                r, c = frontier[qi]\n                qi += 1\n                for dr, dc in dirs4:\n                    nr, nc = r + dr, c + dc\n                    if 0 <= nr < h and 0 <= nc < w and in_comp[nr, nc] and dist[nr, nc] < 0:\n                        dist[nr, nc] = dist[r, c] + 1\n                        frontier.append((nr, nc))\n\n            by_depth = {}\n            for r, c in comp:\n                col = g[r, c]\n                if col != bg and col != wall:\n                    d = dist[r, c]\n                    if d not in by_depth:\n                        by_depth[d] = col\n\n            if not by_depth:\n                continue\n\n            palette = []\n            if 0 not in by_depth:\n                palette.append(bg)\n            for d in sorted(by_depth):\n                palette.append(by_depth[d])\n\n            for r, c in comp:\n                out[r, c] = palette[dist[r, c] % len(palette)]\n\n    return out",
