+            tier_click_vocab_only,
+            "CARNOT_ARC_FRONTIER_TIER_CLICK_VOCAB_ONLY",
+            SUBMITTED_FRONTIER_TIER_CLICK_VOCAB_ONLY_ENABLED,
+        )
