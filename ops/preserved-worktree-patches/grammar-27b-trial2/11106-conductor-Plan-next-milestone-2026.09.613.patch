+                            self.structured_evidence_memory.observe_action_result(
+                                self._prev[0],
+                                int(aid),
+                                data,
+                                g1,
+                                level_before=int(self._prev_level),
+                                level_after=int(_level_of(latest)),
+                                provenance={
+                                    "source": "E3AgentPolicy.next_move.after_transition",
+                                    "admitted_world_model_update": True,
+                                },
+                            )
+                        except Exception:
