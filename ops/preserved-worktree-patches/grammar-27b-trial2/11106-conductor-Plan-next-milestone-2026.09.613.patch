+    def _node_on_path_proba(self, node: dict) -> float:
+        if self.online_discriminator is None:
+            return 1.0
+        features = node.get("discriminative_features")
+        if features is None:
+            return 1.0
+        try:
+            return float(self.online_discriminator.proba_features(features))
+        except Exception:
+            return 1.0
