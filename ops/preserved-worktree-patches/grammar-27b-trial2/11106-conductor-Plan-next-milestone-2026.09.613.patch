+    def _apply_amortized_prior_order(
+        self,
+        frame: Any,
+        candidates: Sequence[Mapping[str, Any]],
+        *,
+        path: Sequence[Mapping[str, Any]] | None = None,
+    ) -> list[dict[str, Any]]:
