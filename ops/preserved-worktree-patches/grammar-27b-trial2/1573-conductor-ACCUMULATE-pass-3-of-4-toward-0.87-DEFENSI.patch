+    val = _float_or_none(pass2_artifact.get("val_exact_accuracy"))
+    delta = _float_or_none(pass2_artifact.get("delta_vs_previous"))
+    if val is None or delta is None:
+        return "pass2 did not report positive accumulation; val_exact_accuracy or delta_vs_previous was missing"
+    if delta <= 0:
+        return f"pass2 did not report positive accumulation; delta_vs_previous={delta:.6g}"
+    return "pass2 reported positive accumulation"
