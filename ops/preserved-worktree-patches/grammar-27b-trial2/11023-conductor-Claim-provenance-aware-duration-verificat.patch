+                scalar = _unwrapped_scalar(nested)
+                signal = ""
+                positive: bool | None = None
+                parent = _claim_field_name(path[-1]) if path else ""
+                if key in _INVOCATION_BOOLEAN_FIELDS or (
+                    key == "invoked"
+                    and any(
+                        token in parent for token in ("generation", "inference", "llm", "model")
