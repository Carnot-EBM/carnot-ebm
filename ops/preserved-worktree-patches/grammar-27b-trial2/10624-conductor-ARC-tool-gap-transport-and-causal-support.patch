+def _cell_stratum(cell: Mapping[str, Any]) -> str:
+    return "|".join(
+        str(cell.get(key))
+        for key in (
+            "game",
+            "run",
+            "model",
+            "policy",
+            "budget",
+            "tool_loop_state",
+            "supervisor_state",
+        )
+    )
