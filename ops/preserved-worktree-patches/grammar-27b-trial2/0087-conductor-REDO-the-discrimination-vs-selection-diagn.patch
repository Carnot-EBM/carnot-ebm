+        json.dumps(_to_raw_record(mod.ProblemEvidence("bad", "synthetic", "g99", bad_candidates)))
+        + "\n",
+        encoding="utf-8",
+    )
+    blocked = mod.run_experiment(
+        repo_root=tmp_path,
+        corpus_paths=[Path("low_auroc.jsonl")],
+        min_candidates=4,
+        min_examples=1,
