+    return bool(
+        payload.get("paper_ready_preserved") is True
+        and isinstance(evidence, Mapping)
+        and evidence.get("paper_ready") is True
+        and all(evidence.get(name) is True for name in ("g1", "g2", "g3", "g4"))
+    )
