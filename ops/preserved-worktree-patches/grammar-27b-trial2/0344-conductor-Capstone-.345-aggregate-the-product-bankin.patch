+    verdict = str(payload.get("honest_verdict") or "")
+    return bool(
+        truthy(payload.get("loop_will_not_self_seed"))
+        and truthy(payload.get("supersedes_340_menu"))
+        and "operator_seeding" in verdict
+    )
