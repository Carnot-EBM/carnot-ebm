+
+def certified_abstention_status(exp3767: Mapping[str, Any], exp3771: Mapping[str, Any]) -> str:
+    if not g2_local_reproduced(exp3767):
+        return "skipped"
+    if exp3771 and truthy(exp3771.get("usable_operating_point_exists")):
