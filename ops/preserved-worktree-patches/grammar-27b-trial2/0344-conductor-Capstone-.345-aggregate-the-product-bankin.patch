+    exp3769 = clean_upstreams.get(3769, {})
+    exp3770 = clean_upstreams.get(3770, {})
+    exp3771 = clean_upstreams.get(3771, {})
+    exp3772 = clean_upstreams.get(3772, {})
+    exp3773 = clean_upstreams.get(3773, {})
+    exp3774 = clean_upstreams.get(3774, {})
