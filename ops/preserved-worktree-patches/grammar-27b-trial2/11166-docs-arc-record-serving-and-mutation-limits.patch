ct': 8, 'temperature': 0, 'seed': 42, 'id_slot': 0, 'cache_prompt': True, 'return_tokens': True}, 'prefix')\n    saved = request('/slots/0?action=save', {'filename': 'prefix.bin'}, 'save')\n    if (ROOT / 'prefix.bin').exists():\n        record({'label':'file', 'bytes': (ROOT/'prefix.bin').stat().st_size, 'sha256':hashlib.sha256((ROOT/'prefix.bin').read_bytes()).hexdigest()})\n    prompt_tokens = request('/tokenize', {'content': prefix, 'add_special': True})['tokens'] + first['tokens']\n    payload = {'prompt': prompt_tokens, 'n_predict': 24, 'temperature': 0, 'seed': 42, 'id_slot': 0, 'cache_prompt': True, 'return_tokens': True}\n    baseline = request('/completion', payload, 'baseline_continuation')\n    request('/slots/0?action=erase', {}, 'erase')\n    restored = request('/slots/0?action=restore', {'filename': 'prefix.bin'}, 'restore')\n    same = request('/completion', payload, 'restored_continuation')\n    stop(kill=True)\n    start('restart', '--reasoning-format', 'deepseek', '--reasoning', 'on', '--reasoning-budget', '128')\n    request('/slots', label='empty_after_restart')\n    request('/slots/0?action=restore', {'filename': 'prefix.bin'}, 'restart_restore')\n    restarted = request('/completion', payload, 'restart_continuation')\n    request('/slots/0?action=erase', {}, 'cold_erase')\n    cold = request('/completion', payload, 'cold_continuation')\n    record({'label': 'continuation_comparison', 'same_restore': baseline['tokens'] == same['tokens'], 'same_restart': baseline['tokens'] == restarted['tokens'], 'same_cold': baseline['tokens'] == cold['tokens'], 'prompt_tokens': len(prompt_tokens)})\n    reasoning = request('/v1/chat/completions', {'messages':[{'role':'user','content':'What is 17 multiplied by 3? Think briefly, then answer.'}], 'max_tokens':220, 'temperature':0, 'seed':42}, 'reasoning_extract')\n    msg = reasoning['choices'][0]['message']\n    request('/apply-template', {'messages':[{'role':'user','content':'What is 17 multiplied by 3? Think b