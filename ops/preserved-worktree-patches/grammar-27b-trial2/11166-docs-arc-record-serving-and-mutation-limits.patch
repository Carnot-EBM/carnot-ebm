de']==1 and 'AssertionError' in red['output']\n    event={**item, 'source_sha256':hashlib.sha256(original).hexdigest(), 'red':red, 'cmp':{'command':cmp_cmd,'exit_code':comparison.returncode}, 'green':green, 'assertion_killed':killed}\n    events.append(event)\n    (OUT/'events.json').write_text(json.dumps({'baseline':baseline,'mutations':events},indent=2)+'\\n')\n    print(json.dumps({'name':item['name'], 'red':red['exit_code'],'assertion_killed':killed,'green':green['exit_code']}),flush=True)\n    assert green['exit_code']==0, green['output']\nprint(json.dumps({'planned':len(mutations),'killed':sum(e['assertion_killed'] for e in events),'survivors':[e['name'] for e in events if not e['assertion_killed']]}),flush=True)\n"
