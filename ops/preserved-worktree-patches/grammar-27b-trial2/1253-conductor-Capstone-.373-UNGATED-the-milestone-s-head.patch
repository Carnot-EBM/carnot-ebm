+def _write_default_artifacts(root: Path, payloads: dict[int, JsonDict]) -> None:
+    for experiment_id, payload in payloads.items():
+        _write_json(root / mod.DEFAULT_UPSTREAM_PATHS[experiment_id], payload)
+
