+
+def build_384_estimate(baseline: BaselineContext | None) -> dict[str, Any]:
+    """SCENARIO-LEARN-4139-RFT-OR-DEFER: preserve the .384 convergence estimate."""
+
+    if baseline is None:
+        return {
+            "destination": ".384",
+            "target_val_exact_accuracy": PUBLISHED_TARGET,
