+            },
+        )
+        a3_payload: JsonDict = {
+            "honest_verdict": "success: ft09_L3_offline_reproduced",
+            "target_game": "ft09",
+            "offline_reproduced": True,
+            "reproduced_levels": 1,
+            "reached_level": 3,
