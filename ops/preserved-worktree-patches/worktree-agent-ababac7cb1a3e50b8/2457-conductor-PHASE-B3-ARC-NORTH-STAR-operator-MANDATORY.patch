+        game=game,
+        verifier_accuracy_per_round=rounds,
+        active_dataset_summary=active,
+        world_model_path=repo / WORLD_MODEL_PATHS[game],
+        plan=labels,
+        reproduce_result=reproduce_result,
+        residual_mismatch_class=residual,
