+def _offline_game_id(arc: Any, short: str) -> str:  # pragma: no cover - ARC SDK boundary
+    for env in arc.get_environments():
+        game_id = str(getattr(env, "game_id", "") or "")
+        if game_id == short or game_id.startswith(short + "-"):
+            return game_id
+    return short
