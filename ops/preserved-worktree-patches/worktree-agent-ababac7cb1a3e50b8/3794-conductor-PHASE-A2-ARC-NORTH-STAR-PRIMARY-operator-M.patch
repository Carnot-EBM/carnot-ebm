+    proc = subprocess.run(
+        list(command),
+        cwd=REPO_ROOT,
+        capture_output=True,
+        text=True,
+        timeout=timeout,
+        check=False,
+    )
+    return {
+        "command": " ".join(command),
+        "returncode": int(proc.returncode),
+        "passed": proc.returncode == 0,
+        "stdout_tail": proc.stdout[-2000:],
+        "stderr_tail": proc.stderr[-2000:],
+    }
