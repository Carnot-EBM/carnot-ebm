+                "reproducibility_checksum": artifact["reproducibility_checksum"],
+            },
+            indent=2,
+            sort_keys=True,
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover - CLI shim.
+    raise SystemExit(main())
