+        "principle": (
+            "the A2 SCORED-agent first-win-rate (did the live-integration earn its place "
+            "on the leaderboard path)."
+        )
+    },
+    "flagged_artifacts_handled": {
+        "principle": (
+            "names any flagged_adversarial / positive-control-failed artifact EXCLUDED + "
