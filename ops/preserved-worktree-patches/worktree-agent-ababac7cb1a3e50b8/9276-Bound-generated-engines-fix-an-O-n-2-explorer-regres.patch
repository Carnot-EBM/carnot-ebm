+
+
+def _order_from_info(info):
+    items = []
+    for C in TARGET_COLORS:
+        if C in info:
+            items.append((info[C][1], C))
+    items.sort()
+    order = [C for _, C in items]
+    if not order:
+        order = list(TARGET_COLORS)
+    return order
+
+
+def _get_S(g):
+    H, W = g.shape
+    if H <= 53 or W <= 0:
