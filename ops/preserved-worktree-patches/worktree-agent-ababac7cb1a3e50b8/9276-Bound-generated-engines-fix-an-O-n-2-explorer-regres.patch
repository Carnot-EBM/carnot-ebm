+    if new_w > 0:
+        g[0, W - new_w:] = 4
+
+    return g
+
+
+def is_level_complete(grid):
+    g = np.asarray(grid)
+    if g.ndim != 2 or g.size == 0:
+        return False
+
+    H, W = g.shape
+
+    runs = []
+    for c in range(W - 1):
