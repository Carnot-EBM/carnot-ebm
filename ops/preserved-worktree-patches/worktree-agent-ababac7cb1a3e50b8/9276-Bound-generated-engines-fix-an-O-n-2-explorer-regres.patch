+    clear_bottom = min(H - 1, R + PH - 1)
+    c0 = max(0, K - 2)
+    c1 = min(W - 1, K + 1)
+    if clear_top <= clear_bottom and c0 <= c1:
+        g[clear_top:clear_bottom + 1, c0:c1 + 1] = 0
+
+    def paint(r, c, v):
+        if 0 <= r < H and 0 <= c < W:
+            g[r, c] = v
+
