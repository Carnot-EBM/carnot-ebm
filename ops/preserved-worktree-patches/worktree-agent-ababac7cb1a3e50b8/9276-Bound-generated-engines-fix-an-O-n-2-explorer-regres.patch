+
+        for r in range(24, 28):
+            g[r, 28:40] = 8
+
+        for r in range(36, 40):
+            g[r, 20:40] = 9
+
+        for r in range(56, 60):
+            g[r, 40:44] = 6
+
+        for r in range(60, 63):
+            g[r, 40:44] = 4
+
+        g[63, :] = 14
+        return g
+
+    def _win_pre(g):
