+    for i in range(PH):
+        rr = R + i
+        if not (0 <= rr < H):
+            continue
+
+        if PH >= 4 and (i < 2 or i >= PH - 2):
+            body_cols = [newK - 2, newK - 1]
+        else:
+            body_cols = [newK - 4, newK - 3, newK - 2, newK - 1]
+
+        for cc in body_cols:
