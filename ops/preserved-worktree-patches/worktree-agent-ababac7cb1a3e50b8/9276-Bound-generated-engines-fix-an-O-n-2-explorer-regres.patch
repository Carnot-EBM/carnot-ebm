+    E = x0 - 1
+    for c in range(x0, W):
+        inside_target = False
+        for a, b in aligned:
+            if a <= c <= b:
+                inside_target = True
+                break
+
+        if not inside_target:
+            if g[y + 2, c] == _body_color(y + 2, c) and g[y + 3, c] == _body_color(y + 3, c):
+                E = c
+            else:
