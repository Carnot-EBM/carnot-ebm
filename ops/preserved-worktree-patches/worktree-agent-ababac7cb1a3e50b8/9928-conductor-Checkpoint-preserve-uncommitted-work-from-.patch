-        status:
-          principle: "The family run is terminal, resumable, and never hides a resource block."
-        honest_verdict:
-          principle: "The verdict distinguishes row completion from the presence of useful headroom."
-        verdict_class:
-          principle: "Use the closed enum; baseline qualification alone is null infrastructure."
-        gate_check_summary:
-          principle: "Any blocked outcome names the failed upstream, cache, GPU, model, tokenizer, row, timeout, checkpoint, or exact-check condition and observed value."
-        per_unit_rows:
-          principle: "Every task and seed carries immutable inputs, raw output, parse, exact result, tokens, latency, process, and failures."
-        model_spec_and_identity:
-          principle: "The exact mandated hub ID, GGUF shards, hashes, tokenizer, chat template, quantization, and context are bound."
-        gpu_process_receipts:
-          principle: "Owned process, device, VRAM, CUDA layer offload, timing, and unload evidence prove local GPU inference."
-        prompt_and_decode_contract:
-          principle: "Direct prompt bytes, stop rules, sampling settings, and seed schedule are frozen before inference."
-        raw_model_receipts:
-          principle: "Every raw response is retained before parsing or exact checking."
-        failure_rows:
-          principle: "Timeouts, parse failures, refusals, invalid plans, and resource errors remain charged to the baseline."
-        family_headroom_summary:
-          principle: "Calibration and held exact success and failure modes recompute only from rows."
-        qwen_headroom_ready_score:
-          principle: "This exact binary field is owned here and indicates complete held success in the frozen 20%-80% interval."
-        attack_rows:
-          principle: "Drift, leakage, dropping, fallback, identity, regeneration, aggregate, and mutation attacks fail closed."
-        preconditions_checked:
-          principle: "Upstream gate, files, hashes, GPU, cache, model, tokenizer, timeouts, and protected files are explicit."
-        protected_files_unchanged:
-          principle: "Both protected orchestration files retain their original hashes."
-        inference_substrate:
-          principle: "The task declares live local Qwen3.6 GGUF inference through CUDA llama.cpp."
-        verifier_is_oracle:
-          principle: "The independent exact executor defines plan success."
-        field_provenance:
-          principle: "Every aggregate points to per-unit raw, model, process, and exact-check receipts."
-        duration_s:
-          principle: "Monotonic duration is consistent with the declared live workload."
