+    "SCENARIO-REPORT-4976-MTIME-WINDOW",
+    "SCENARIO-REPORT-4976-BLOCKED-PRECONDITION",
+]
+TERMINAL_PREFIXES = ("success_", "blocked_")
+
+FIELD_PRINCIPLES: dict[str, dict[str, str]] = {
+    "honest_verdict": {
+        "principle": (
+            "terminal prefix; success_v458_stamping_backfilled_and_mtime_window_confirmed "
