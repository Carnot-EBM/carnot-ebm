+        "  - id: exp4422-glyph-rewrite-perception",
+        "    result: 'glyph rewrite banked execution-grounded tr87 progress'",
+        "  - id: exp4423-generic-first-contact-breadth",
+        "    result: 'skipped partial verdict; missing verifier gap logged'",
