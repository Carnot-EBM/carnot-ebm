+        "trusted": not failures,
+        "trust_gate": gate,
+        "trust_failure_reasons": failures,
+        "b1_experiment_id": _experiment_id("B1_AUDIT", b1),
+        "b1_honest_verdict": b1.get("honest_verdict", ""),
