+            "trust_failure_reasons": ["upstream_artifact_missing"],
+        }
+    gate = _trust_gate(b1)
+    failures = _trust_failure_reasons(gate)
+    fork = str(a1.get("fork_verdict") or b1.get("a1_source_fork_verdict") or "")
+    return {
+        "source": "A1",
+        "experiment_id": _experiment_id("A1", a1),
