+def _hash_protected(repo_root: Path) -> dict[str, str]:  # pragma: no cover
+    """Hash both protected orchestration files."""
+
+    return {path.as_posix(): sha256_file(repo_root / path) for path in PROTECTED_RELATIVE_PATHS}
