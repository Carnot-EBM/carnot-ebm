From f4bd7d031493cc3a9e65022eaf58ec66a26eeb65 Mon Sep 17 00:00:00 2001
From: Ian Blenke <ian@blenke.com>
Date: Mon, 8 Jun 2026 02:22:11 -0400
Subject: [PATCH 00904/11362] [outer-loop] Persist verifier artifacts:
 gitignore results/ weights + scaffold verifier_registry.yaml

Operator-directed artifact-persistence layer for the self-improving-verifier program.
(1) .gitignore: results/*.{pt,safetensors,bin,gguf,ckpt} (the prior results/**/*.pt missed
top-level + .safetensors -> 25 small verifier safetensors ~18MB had slipped in; .pt 2.7GB
on disk were already untracked). Stops NEW verifier/abstraction weights from bloating git as
they grow (the 17GB + 765MB git-filter-repo purge history). (2) ops/verifier_registry.yaml:
the diffable single-source-of-truth binding code-commit <-> weights HF id + IPFS CID + sha256
<-> training-data ref <-> eval score <-> lineage, per decentralization rule 3 (weights ->
HF+IPFS, NOT git). Seeded with the production FoVer ensemble (active, 0.9131) + the learned
outcome-verifier (candidate, 0.949 de-risk). The git history of this file = the verifier's
evolution over time; weights live content-addressed on HF/IPFS.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 .gitignore                 | 11 ++++++
 ops/verifier_registry.yaml | 77 ++++++++++++++++++++++++++++++++++++++
 2 files changed, 88 insertions(+)
 create mode 100644 ops/verifier_registry.yaml

diff --git a/.gitignore b/.gitignore
index d6b11dcc74..3ef589c291 100644
--- a/.gitignore
+++ b/.gitignore
@@ -157,3 +157,14 @@ ebt_tmp/
 /ebt_tmp/
 /trm_src/
 /hrm_ckpt/
+
+# Verifier/model weights under results/ -> HuggingFace + IPFS, NOT git (rule 3).
+# results/**/*.pt was added 2026-04-23 but missed top-level + .safetensors/.bin/.gguf
+# in results/ (25 small verifier safetensors, ~18MB, slipped in). These patterns stop
+# NEW verifier/abstraction weights from landing in git as they grow; the binaries live
+# on HF/IPFS keyed by CID, referenced from ops/verifier_registry.yaml. (2026-06-08)
+results/*.pt
+results/*.safetensors
+results/*.bin
+results/*.gguf
+results/*.ckpt
diff --git a/ops/verifier_registry.yaml b/ops/verifier_registry.yaml
new file mode 100644
index 0000000000..b7efdbb0e2
--- /dev/null
+++ b/ops/verifier_registry.yaml
@@ -0,0 +1,77 @@
+# Verifier Registry — the single, diffable source of truth for Carnot's verifiers.
+#
+# WHY: a verifier's value is that it improves over time and expands to new domains
+# (the Phase-3 self-improving-verifier program). Persisting that lineage needs three
+# layers (see ops/known-issues.md + decentralization rule 3):
+#   code + schemas        -> git (python/carnot/verify/, scripts/)
+#   provenance/registry   -> git (THIS file — small, diffable, never-pruned)
+#   weights + big data    -> HuggingFace (Carnot-EBM/*) + IPFS (content-addressed by CID),
+#                            NEVER git. (The conductor once committed 17GB of weights and a
+#                            765MB .pt that had to be purged with git-filter-repo 2026-06-03;
+#                            results/*.{pt,safetensors,bin,gguf} are now gitignored.)
+#
+# THIS FILE binds the three: each entry maps a verifier version to its code commit, its
+# weights' HF id + IPFS CID + sha256, the data it learned from, and its eval score — so a
+# third party can reproduce and verify integrity by hash (the FoVer reproduction-runbook
+# discipline). Versions ACCUMULATE (never-prune); the git history of this file IS the
+# verifier's evolution over time. Retired entries stay with status: retired.
+#
+# PERSISTENCE LOOP (the conductor pattern, extended to the verifier lifecycle):
+#   train -> eval -> push weights to HF + IPFS -> add/update entry here -> commit -> tag.
+#
+# SCHEMA (one entry per verifier/domain version):
+#   - verifier_id:        stable slug
+#     domain:             math_reasoning | code | facts | arc_agi3_<...> | constraint | ...
+#     version:            int (increments; lineage below)
+#     kind:               ensemble | outcome_head | process_verifier | abstraction_library
+#     code_commit:        git sha defining/loading it (python/carnot/verify/...)
+#     code_path:          the module
+#     weights_hf:         HuggingFace repo id (null if pure-code/symbolic, no weights)
+#     weights_cid:        IPFS CID (content-address; integrity + mirror)
+#     weights_sha256:     hash of the artifact
+#     training_data_ref:  ipfs://... or a results/ corpus path (what it learned from)
+#     label_source:       self_consistency | formal_oracle | teacher_llm | human | gold
+#     eval:               {metric: value, n: int, eval_artifact: results/...json}
+#     lineage:            {from: <version|seed>, change: "<one line>"}
+#     status:             active | candidate | retired
+#     notes:              free text
+
+verifiers:
+  # ---- Production deployed verifier (the headline, G2-reproduced) ----
+  - verifier_id: fover_production_ensemble
+    domain: math_reasoning
+    version: 4
+    kind: ensemble                 # the k=15 Tier0r/Tier0u/FR-11 production aggregation
+    code_commit: HEAD              # TODO: pin to the exact commit on next reconcile
+    code_path: python/carnot/eval/verifier_error_independence_scissor_at_scale.py
+    weights_hf: null               # text/structural verifiers + FR-11 memory (mostly code+data)
+    weights_cid: null              # TODO: pin FR-11 memory index CID once externalized
+    weights_sha256: null
+    training_data_ref: data/fover_corpus_v4.json
+    label_source: gold
+    eval: {metric: "fover_dual_condition_auroc", value: 0.9131, n: 6548,
+           eval_artifact: results/experiment_2850_fover_dual_condition_integrity_v4.json}
+    lineage: {from: v3, change: "5-seed dual-condition rescue; CI-reproduced (G2, run 26725185125)"}
+    status: active
+    notes: "The deployed cross-domain verifier; headline. G1-G4 met; frozen 0.9131."
+
+  # ---- Candidate: learned outcome-verifier (the self-improvement-reward path) ----
+  - verifier_id: outcome_verifier_math_proc_plus_sc
+    domain: math_reasoning
+    version: 1
+    kind: outcome_head             # learned: process features + self-consistency -> outcome
+    code_commit: HEAD
+    code_path: scripts/experiments/outcome_verifier_learn_derisk_draft.py
+    weights_hf: null               # de-risk only; logistic head, not yet a published artifact
+    weights_cid: null
+    weights_sha256: null
+    training_data_ref: data/p01_gsm8k_generations.jsonl
+    label_source: gold             # trained on gold-outcomes; self-consistency as a feature
+    eval: {metric: "heldout_outcome_auroc", value: 0.949, n: 720,
+           eval_artifact: results/outcome_verifier_learn_derisk.json}
+    lineage: {from: seed, change: "de-risk: process-only 0.739 + self-consistency -> 0.949"}
+    status: candidate
+    notes: "Correlational de-risk PASSED; causal RFT test underpowered (see known-issues
+            statistical-power discipline). Self-consistency dominates (0.927); verifier +0.02.
+            Promote to active only after a powered (seeded gen, >=100 eval Q, >=3 seed) RFT
+            confirms it teaches."
