+REPO_ROOT = Path(__file__).resolve().parents[2]
+EXPERIMENT = "experiment_4881_archive_449_activate_450"
+EXPERIMENT_ID = 4881
+SCHEMA = "carnot.exp4881.archive_449_activate_450.v1"
+RANDOM_SEED = 20260627
