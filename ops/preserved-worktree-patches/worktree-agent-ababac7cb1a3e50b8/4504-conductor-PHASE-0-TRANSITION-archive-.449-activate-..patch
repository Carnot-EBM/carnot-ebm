+REGISTRY_REL_PATH = Path("ops/arc_solve_registry.yaml")
+CAPSTONE_REL_PATH = Path("results/experiment_4880_capstone_v449.json")
+CORRIGENDUM_REL_PATH = Path("results/arc_fork_probe_accuracy_corrigendum.json")
