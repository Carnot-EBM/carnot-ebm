+                        "cell_identity": cell["cell_identity"],
+                        "arm": cell["arm"],
+                        "fixture_id": cell["fixture_id"],
+                        "family": cell["family"],
+                        **deepcopy(dict(parse_row)),
+                    }
+                )
+    return rows
