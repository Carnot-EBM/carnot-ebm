+def _row_refs(cells: Sequence[Mapping[str, Any]], statuses: set[str]) -> list[JsonDict]:
+    """Flatten selected parser statuses while retaining their cell identity."""
+
+    rows: list[JsonDict] = []
+    for cell in cells:
