+class DeterministicEvidenceClock:
+    """Give unit tests stable nonzero timing receipts without hiding real timing in production."""
+
+    def __init__(self) -> None:
+        self._value = 0.0
+
+    def __call__(self) -> float:
+        self._value += 0.001
+        return self._value
