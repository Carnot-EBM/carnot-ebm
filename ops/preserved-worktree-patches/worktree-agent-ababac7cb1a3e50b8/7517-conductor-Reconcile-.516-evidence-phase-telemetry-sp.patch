+def _git_modified(root: Path, rel_path: Path) -> bool:  # pragma: no cover - live repo helper
+    result = subprocess.run(
+        ["git", "status", "--short", "--", rel_path.as_posix()],
+        cwd=root,
+        check=False,
+        text=True,
+        capture_output=True,
+    )
+    return bool(result.stdout.strip())
