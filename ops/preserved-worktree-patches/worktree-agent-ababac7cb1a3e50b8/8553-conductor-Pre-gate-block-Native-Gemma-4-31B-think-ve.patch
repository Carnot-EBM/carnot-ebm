 from pathlib import Path
 
@@ -1122,3 +1123,80 @@ def test_an_unmeasurable_cross_seed_floor_says_so_instead_of_being_blank() -> No
     assert "not_measurable" not in cs2
     assert cs2["max_win_flips_across_any_seed_pair"] == 1
