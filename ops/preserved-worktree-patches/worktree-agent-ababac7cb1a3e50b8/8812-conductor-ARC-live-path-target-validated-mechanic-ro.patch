+                "route_active": route_active,
+            },
+            "text": text,
+            "latency_s": latency_s,
+        }
+
+    harm = exp6307._baseline_harm([row("missing", "router_off", "")])
+    assert {"cell_key": "missing", "reason": "missing_arm"} in harm["harm_rows"]
