+def test_req_arc_wmte_6307_baseline_harm_edges() -> None:
+    """REQ-ARC-WMTE-6307: harm controls name missing arms, score, invalid, and latency drift."""
+
+    def row(
+        cell_key: str,
+        arm: str,
