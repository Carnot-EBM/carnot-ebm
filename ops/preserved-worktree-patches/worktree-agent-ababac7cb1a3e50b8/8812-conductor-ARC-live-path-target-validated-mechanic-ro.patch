+
+
+def test_req_arc_wmte_6307_blocked_precondition_artifact_is_terminal(tmp_path: Path) -> None:
+    """REQ-ARC-WMTE-6307: missing mandated model writes zero-credit terminal artifact."""
+
+    artifact = exp6307.run(
+        date="20260811",
