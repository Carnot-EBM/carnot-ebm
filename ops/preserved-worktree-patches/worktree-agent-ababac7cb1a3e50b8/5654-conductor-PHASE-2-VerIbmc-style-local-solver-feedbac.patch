+    broken["inference_substrate"] = {
+        "principle": mod.FIELD_PRINCIPLES["inference_substrate"],
+        "value": "legacy_smoke",
+    }
+    with pytest.raises(AssertionError, match="local_sota_gguf"):
+        mod.validate_artifact(broken)
