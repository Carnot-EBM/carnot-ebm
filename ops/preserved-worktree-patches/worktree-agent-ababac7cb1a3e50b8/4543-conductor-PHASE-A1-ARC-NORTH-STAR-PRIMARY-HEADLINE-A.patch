+def test_req_arc_wmte_4892_run_blocks_and_checkpoints_partial(tmp_path: Path) -> None:
+    """SCENARIO-ARC-WMTE-4892-PARTIAL-CHECKPOINT: blocked and partial runs stay schema-valid."""
