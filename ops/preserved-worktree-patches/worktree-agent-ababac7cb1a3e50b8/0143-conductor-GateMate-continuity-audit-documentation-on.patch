+#!/usr/bin/env python3
+"""Entrypoint for Exp 3711 GateMate continuity audit v26."""
+
+from __future__ import annotations
+
+import os
+import sys
+
+sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), "../python")))
+
+from carnot.experiment_3711_gatemate_continuity_audit_v26 import main
+
+
+if __name__ == "__main__":  # pragma: no cover
+    main()
