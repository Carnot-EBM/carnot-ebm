+
+def _a3_no_bank() -> dict[str, Any]:
+    return {
+        "honest_verdict": "complete: sk48_delta_identified_no_bank",
+        "flagged_adversarial": None,
+        "offline_reproduced": False,
+        "reproduced_levels": 0,
+        "reproduction_gate": {
