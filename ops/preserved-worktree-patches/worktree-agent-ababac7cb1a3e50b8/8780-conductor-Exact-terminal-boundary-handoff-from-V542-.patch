+def load_v543_roadmap(root: Path) -> tuple[JsonDict, JsonDict]:
+    next_path = root / V543_NEXT_ROADMAP_RELATIVE_PATH
+    active_path = root / V543_ROADMAP_RELATIVE_PATH
+    next_data = read_yaml_mapping(next_path)
+    active_data = read_yaml_mapping(active_path)
+    if next_data.get("milestone") == MILESTONE_V543:
+        chosen_rel = V543_NEXT_ROADMAP_RELATIVE_PATH
+        data = next_data
+        note = "research-roadmap-next.yaml contains V543; not activated"
+    elif active_data.get("milestone") == MILESTONE_V543:
+        chosen_rel = V543_ROADMAP_RELATIVE_PATH
+        data = active_data
+        note = "active research-roadmap.yaml already contains V543; no activation performed"
+    else:
+        chosen_rel = V543_NEXT_ROADMAP_RELATIVE_PATH if next_data else V543_ROADMAP_RELATIVE_PATH
+        data = next_data or active_data
+        note = "V543 roadmap milestone was not found"
+    return data, {
+        "path": chosen_rel.as_posix(),
+        "sha256": path_sha256(root / chosen_rel),
+        "milestone": data.get("milestone"),
+        "requested_next_path": V543_NEXT_ROADMAP_RELATIVE_PATH.as_posix(),
+        "research_roadmap_next_present": next_path.exists(),
+        "active_roadmap_milestone": active_data.get("milestone"),
