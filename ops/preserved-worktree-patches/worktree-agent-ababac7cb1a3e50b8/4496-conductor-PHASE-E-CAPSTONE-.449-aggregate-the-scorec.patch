+def _sota() -> JsonDict:
+    return {
+        "honest_verdict": "success_sota_ingestion_v450_frontier_mapped",
+        "aimed_at_fork_verdict": "INDUCER_CEILING",
+        "flagged_for_v450": [{"candidate": "test_time_dynamics_adaptation_loop"}],
