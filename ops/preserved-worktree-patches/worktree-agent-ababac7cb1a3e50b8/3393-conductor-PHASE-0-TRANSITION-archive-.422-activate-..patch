+            "status": a5_scorecard.get("status"),
+            "honest_verdict": a5_integration.get("honest_verdict"),
+            "integrated_metric_improved": a5_scorecard.get("integrated_metric_improved") is True,
+            "heldout_solve_rate": heldout_rate,
