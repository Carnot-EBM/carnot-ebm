+def _combined_rows(groups: list[tuple[str, list[JsonDict]]]) -> list[JsonDict]:
+    rows = []
+    for row_type, group in groups:
+        rows.extend({"row_type": row_type, **deepcopy(row)} for row in group)
+    return rows
