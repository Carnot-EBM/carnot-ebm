+    exp5489_ready = bool(artifacts[5489].get("csl_independent_scale_ready"))
+    arc_delta = int(artifacts[5494].get("post_levels_reproduced") or 0) - int(
+        artifacts[5494].get("prior_levels_reproduced") or 0
+    )
+    return {
