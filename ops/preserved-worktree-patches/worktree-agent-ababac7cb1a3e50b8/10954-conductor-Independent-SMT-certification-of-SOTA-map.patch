+
+    pair_by_id = {
+        str(row["pair_id"]): row for row in fixture_checkpoint["pairs"] if isinstance(row, Mapping)
+    }
+    inputs = []
+    for attempt in bank["attempt_rows"]:
+        pair = pair_by_id[str(attempt["pair_id"])]
+        row = {
