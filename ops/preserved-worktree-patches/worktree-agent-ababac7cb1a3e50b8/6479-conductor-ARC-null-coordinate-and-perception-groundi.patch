+            {"game": "sb26", "reproducibility": "reproduced", "levels_reproduced": 2},
+            {"game": "dc22", "reproducibility": "reproduced", "levels_reproduced": dc22_level},
+            {"game": "r11l", "reproducibility": "reproduced", "levels_reproduced": 2},
+        ],
