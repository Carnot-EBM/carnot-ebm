+@dataclass(frozen=True)
+class FeatureRow:
+    """One exact-labeled row with features visible to the online KAN."""
+
+    row_id: str
+    family: str
+    partition: str
+    session_id: str
+    label: int
+    accepted_by_exact_validator: bool
