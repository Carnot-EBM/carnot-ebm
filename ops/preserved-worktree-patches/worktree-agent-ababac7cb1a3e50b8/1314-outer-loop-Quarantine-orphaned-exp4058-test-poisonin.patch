+PLUS_ONE = "```python\ndef transform(grid):\n    return grid + 1\n```"
+PLUS_TWO = "```python\ndef transform(grid):\n    return grid + 2\n```"
+IDENTITY = "```python\ndef transform(grid):\n    return grid\n```"
