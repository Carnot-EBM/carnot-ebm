+def _events_by_id(
+    events: Sequence[exp6318.StreamEvent],
+    event_ids: Sequence[str],
+) -> list[exp6318.StreamEvent]:
+    by_id = {event.event_id: event for event in events}
+    return [by_id[event_id] for event_id in event_ids]
