+
+            ext = np.zeros_like(blocked, dtype=bool)
+            q = []
+            for r in range(r0, r1 + 1):
+                for c in (c0, c1):
+                    if not blocked[r - r0, c - c0] and not ext[r - r0, c - c0]:
+                        ext[r - r0, c - c0] = True
+                        q.append((r, c))
+            for c in range(c0, c1 + 1):
+                for r in (r0, r1):
+                    if not blocked[r - r0, c - c0] and not ext[r - r0, c - c0]:
+                        ext[r - r0, c - c0] = True
+                        q.append((r, c))
+
+            qi = 0
+            while qi < len(q):
+                r, c = q[qi]
+                qi += 1
+                for dr, dc in dirs4:
+                    nr, nc = r + dr, c + dc
+                    if r0 <= nr <= r1 and c0 <= nc <= c1:
+                        rr, cc = nr - r0, nc - c0
+                        if not blocked[rr, cc] and not ext[rr, cc]:
