s host.\n    repl = {}\n    for i, comp in enumerate(comps):\n        host = comp[\"color\"]\n        votes = {}\n        for r, c in comp[\"cells\"]:\n            if g[r, c] == 1:\n                for rr, cc in neigh(r, c):\n                    v = g[rr, cc]\n                    if v != 1 and v != host:\n                        votes[v] = votes.get(v, 0) + 1\n        if votes:\n            repl[i] = max(votes, key=votes.get)\n\n    # Regions without their own marker inherit the strongest replacement from\n    # a neighboring region of the same recovered color, otherwise stay stable.\n    for i, comp in enumerate(comps):\n        if i in repl:\n            continue\n        boundary_votes = {}\n        for r, c in comp[\"cells\"]:\n            for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):\n                if 0 <= rr < h and 0 <= cc < w:\n                    j = comp_id[rr][cc]\n                    if j != i and j in repl:\n                        boundary_votes[repl[j]] = boundary_votes.get(repl[j], 0) + 1\n        repl[i] = max(boundary_votes, key=boundary_votes.get) if boundary_votes else comp[\"color\"]\n\n    out = clean.copy()\n    for i, comp in enumerate(comps):\n        v = repl[i]\n        for r, c in comp[\"cells\"]:\n            out[r, c] = v\n\n    return np.rot90(out, 1) if h != w else out",
