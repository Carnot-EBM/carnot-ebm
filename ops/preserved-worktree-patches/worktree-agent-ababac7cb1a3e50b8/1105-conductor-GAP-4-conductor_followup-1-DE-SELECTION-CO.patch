+
+def _history_iter0_demo_perfect(history: list[dict[str, Any]]) -> bool:
+    for row in history:
+        if int(row.get("iter", -1)) == 0 and row.get("status") == "graded":
+            return float(row.get("demo_fit", 0.0)) >= 1.0
+    return False
