+            stack = [(sr, sc)]
+            seen[sr, sc] = True
+            comp = []
+            while stack:
+                r, c = stack.pop()
+                comp.append((r, c))
+                for dr, dc in dirs4:
+                    nr, nc = r + dr, c + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and grid[nr, nc] == 1:
