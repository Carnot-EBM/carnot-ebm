+            for er, ec in edge:
+                for tr, tc in target:
+                    off_r, off_c = tr - er, tc - ec
+                    if set((rr + off_r, cc + off_c) for rr, cc in edge) == target:
+                        best = [(rr + off_r, cc + off_c) for rr, cc in coords]
+                        break
+                if best is not None:
+                    break
+            if best is not None:
+                break
+
+        if best is not None:
+            for rr, cc in best:
+                if 0 <= rr < h and 0 <= cc < w:
+                    out[rr, cc] = color
+
+    return out
