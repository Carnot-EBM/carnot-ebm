+def reproducibility_checksum(artifact: Mapping[str, Any]) -> str:
+    stable = json.loads(canonical_json(artifact))
+    stable.pop("reproducibility_checksum", None)
+    stable.pop("duration_s", None)
+    return sha256_json(stable)
