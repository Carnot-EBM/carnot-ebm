+def _input_hashes(root: Path, canonical_artifacts: Mapping[str, JsonMap]) -> JsonDict:
+    source_paths = (
+        RESEARCH_COMPLETE_RELATIVE_PATH,
+        CONDUCTOR_LOG_RELATIVE_PATH,
