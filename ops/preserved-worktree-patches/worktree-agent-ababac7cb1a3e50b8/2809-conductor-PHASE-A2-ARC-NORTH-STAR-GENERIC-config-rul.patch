+def _blocked_reproduction(game: str) -> dict[str, Any]:
+    return {
+        "game": game,
+        "claimed_level": CLAIMED_LEVEL,
+        "reached_level": 0,
+        "reproduced": False,
+        "mode": "not_run_precondition_block",
+    }
