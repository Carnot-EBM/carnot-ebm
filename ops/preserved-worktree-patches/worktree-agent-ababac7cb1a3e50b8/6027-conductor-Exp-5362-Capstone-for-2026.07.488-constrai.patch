+def _issue_by_path(issues: Sequence[JsonMap]) -> dict[str, str]:
+    return {
+        str(row["path"]): str(row["classification"])
+        for row in issues
+        if str(row.get("classification")) not in NON_BLOCKING_ISSUE_CLASSIFICATIONS
+    }
