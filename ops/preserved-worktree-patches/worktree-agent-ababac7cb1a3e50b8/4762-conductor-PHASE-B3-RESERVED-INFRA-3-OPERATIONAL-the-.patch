+def test_req_report_4954_spec_declares_relaxed_v456_contract() -> None:
+    """REQ-REPORT-4954: OpenSpec declares the relaxed .456 readiness contract."""
+
+    spec = SPEC_PATH.read_text(encoding="utf-8")
+
+    for ref in mod.SPEC_REFS:
+        assert ref in spec
+    for marker in (
+        str(mod.OUTPUT_REL_PATH),
+        "duration_s",
+        "compute_bound_count>=1",
+        "window_gate_relaxed=true",
