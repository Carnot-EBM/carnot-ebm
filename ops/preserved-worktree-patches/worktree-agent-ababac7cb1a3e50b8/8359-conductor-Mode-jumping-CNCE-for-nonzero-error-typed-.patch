+) -> JsonDict:
+    """Build strict precondition evidence before fitting."""
+
+    spec_text = (REPO_ROOT / SAMPLER_SPEC_RELATIVE_PATH).read_text(encoding="utf-8")
+    retired = retired_parity_scaling_nonreuse_receipt()
+    checks = {
