+def payload_checksum(payload: Mapping[str, Any]) -> str:
+    normalized = dict(payload)
+    normalized["reproducibility_checksum"] = ""
+    return "sha256:" + hashlib.sha256(canonical_json(normalized).encode("utf-8")).hexdigest()
+
