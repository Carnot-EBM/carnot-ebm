+def _model_ids(payload: JsonMap) -> set[str]:
+    ids: set[str] = set()
+    for spec in payload.get("MODEL_SPECS") or []:
+        if isinstance(spec, Mapping) and spec.get("hf_id"):
+            ids.add(str(spec["hf_id"]))
+    for value in payload.get("models_used") or []:
+        ids.add(str(value))
+    return ids
