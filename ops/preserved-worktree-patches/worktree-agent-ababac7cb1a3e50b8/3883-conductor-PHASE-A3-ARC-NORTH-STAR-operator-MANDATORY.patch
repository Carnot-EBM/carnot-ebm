+def select_target(registry_path: Path | None = None) -> tuple[str, dict[str, Any]]:
+    registry = _registry_data(registry_path)
+    re86_level = registry_level(TARGET_GAME, registry_path=registry_path)
+    if re86_level < 1:
+        raise RuntimeError("re86 deepen requires an existing reproduced L1 registry row")
+    skipped = [{"game": "bp35", "reason": "no_grounded_next_level_adapter"}]
+    skipped.extend(
+        {"game": game, "reason": "recently_deepened_or_operator_skip_list"}
+        for game in PROHIBITED_TARGETS
