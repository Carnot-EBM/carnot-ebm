+    (results / "arc_loop_solve_re86.json").write_text(
+        json.dumps(_loop_result()), encoding="utf-8"
+    )
+    calls: list[list[str]] = []
+
+    def fake_run(cmd, cwd, check, text, stdout, stderr):
+        del cwd, check, text, stdout, stderr
