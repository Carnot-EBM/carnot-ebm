+                "server_healthy": True,
+                "row_count": row_count,
+                "samples": [
+                    {"stage": "before", "memory_used_mb": 4, "utilization_pct": 0},
+                    {
+                        "stage": "during",
+                        "memory_used_mb": 21_000,
+                        "utilization_pct": 70,
