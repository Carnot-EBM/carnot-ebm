+        "model_sha256": "sha256:qwen-model",
+        "gguf_shards": [
+            {
+                "path": spec["model_path"],
+                "sha256": "sha256:qwen-model",
+                "byte_count": 22_134_528_992,
+            }
+        ],
+        "quantization": "UD-Q4_K_M",
+        "architecture": "qwen35moe",
+        "context_length": 262_144,
+        "embedded_tokenizer": {
+            "source": "embedded_gguf",
