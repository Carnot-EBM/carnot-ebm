+            gpu_receipts=gpu_receipts,
+            checkpoint_receipts=checkpoint_receipt,
+            preconditions=preconditions,
+            protected_files=protected,
+            tests_run=tests_run,
+            duration_s=time.monotonic() - started,
+        )
