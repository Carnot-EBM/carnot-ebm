+def _gpu_receipts(row_count: int) -> dict:
+    return {
+        "sessions": [
+            {
+                "session_id": "session-1",
+                "pid": 777,
+                "parent_pid": 42,
+                "owned_child": True,
+                "repository_id": mod.QWEN_HUB_ID,
