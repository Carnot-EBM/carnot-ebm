+    tests_run: Sequence[str] = (),
+) -> JsonDict:
+    """Build the terminal Exp5283 artifact from source-verified delta rows."""
+
+    deltas = [dict(row) for row in actionable_deltas]
+    added = len(deltas)
+    references_updated = added > 0
