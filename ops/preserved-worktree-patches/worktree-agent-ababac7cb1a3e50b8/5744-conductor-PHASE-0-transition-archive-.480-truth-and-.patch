+"""Tests for Exp 5257 archive .480 / .481 activation-ready record.
+
+Spec refs: REQ-REPORT-5257, SCENARIO-REPORT-5257,
+SCENARIO-REPORT-5257-BLOCKED-CLOSEOUT.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any
+
+import pytest
+import yaml
+
+from carnot import experiment_5257_archive_480_activate_481 as mod
+
+
+REPO = Path(__file__).resolve().parents[2]
+SPEC_PATH = REPO / "openspec" / "capabilities" / "research-reporting" / "spec.md"
+RESULT_PATH = REPO / mod.RESULT_RELATIVE_PATH
+
+
+def _wrap(value: Any, principle: str = "fixture principle") -> dict[str, Any]:
+    return {"principle": principle, "value": value}
+
+
+def _write_json(path: Path, payload: object) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
+
+def _roadmap(milestone: str, start: int = 5257, stop: int = 5268) -> str:
+    return yaml.safe_dump(
+        {
+            "milestone": milestone,
+            "milestone_title": f"fixture {milestone}",
+            "tasks": [
+                {
+                    "id": f"exp{idx}-fixture-v{milestone.split('.')[-1]}",
+                    "milestone": milestone,
+                    "deliverable": f"results/experiment_{idx}_fixture.json",
+                    "title": f"fixture task {idx}",
+                    "agent_type": "codex",
+                    "model": "gpt-5.5",
+                    "prompt": "fixture REQUIRED ARTIFACT FIELDS:\n- honest_verdict",
+                    "prior_failures": [
+                        {
+                            "experiment_id": f"exp{idx - 1}",
+                            "verdict": "complete: fixture",
+                            "addressed_by": "fixture",
+                            "retire_if_same_verdict": True,
+                        }
+                    ],
+                }
+                for idx in range(start, stop + 1)
+            ],
+        },
+        sort_keys=False,
+    )
+
+
+def _capstone_payload() -> dict[str, Any]:
+    return {
+        "experiment_id": "exp5256-capstone-v480",
+        "honest_verdict": _wrap(
+            "complete: .480 capstone closed with normalizer ready; GAP-4 salvaged clean null; cross-model memory and verifier dose blocked; Token-Guard harmful; HalluHard clean null; ARC delta 0 with patch retired; KAN bounded positive; hardware no-speedup."
+        ),
+        "artifact_normalizer_status": _wrap(
+            "ready: strict_shape_only_normalizer_refuses_missing_evidence"
+        ),
+        "gap4_final_status": _wrap(
+            "salvaged_clean_null: wins=0 losses=0 ties=120 unsafe_missing_receipts=0 pool_retired=false"
+        ),
+        "continuous_self_learning_status": _wrap(
+            "blocked_precondition: cross_model_memory_eligible=False blockers=blocked_llama_cpp_gpu_offload retention=false rollback=false no_model_training=true"
+        ),
+        "verifier_dose_status": _wrap(
+            "blocked_gate: exp5249.cross_model_memory_eligible=false; scheduler_not_run"
+        ),
+        "token_guard_status": _wrap(
+            "clean_negative: harmful_on_bounded_panel accuracy_change=-0.25 unsupported_claim_delta=1.0 deterministic_violation_delta=4.0"
+        ),
+        "halluhard_status": _wrap(
+            "clean_null: typed_provenance_memory citation_support_delta=0.0 repeated_error_delta=0.0 unsupported_claim_rate_no_memory=0.0 unsupported_claim_rate_typed_memory=0.0"
+        ),
+        "arc_level_delta": _wrap(0),
+        "kan_certificate_status": _wrap(
+            "bounded_positive: variables=2 envelopes=2 true_property_certified=true false_property_rejected=true no_hardware_speedup_claim=true"
+        ),
+        "hardware_speedup_claimed": _wrap(False),
+        "status_decisions": {
+            "arc_patch": "retire_current_provenance_patch_after_clean_zero_delta",
+            "hardware": "kv260=reachable polarfire=reachable gatemate=blocked_physical_jtag no_speedup_claim",
+        },
+        "ops_docs_updated": _wrap(False),
+        "flagged_adversarial": False,
+    }
+
+
+def _upstream_payload(number: int) -> dict[str, Any]:
+    payloads: dict[int, dict[str, Any]] = {
+        5245: {"honest_verdict": "blocked_archive_479_activate_480: fixture"},
+        5247: {
+            "honest_verdict": _wrap("complete: normalizer ready"),
+            "artifact_normalizer_ready": True,
+        },
+        5248: {
+            "honest_verdict": _wrap("complete: GAP-4 clean null"),
+            "gap4_final_decision": _wrap("salvaged_clean_null"),
+        },
+        5249: {
+            "honest_verdict": _wrap(
+                "blocked_precondition_cross_model_memory_not_measured: blockers=blocked_llama_cpp_gpu_offload"
+            ),
+            "cross_model_memory_eligible": False,
+        },
+        5250: {"honest_verdict": "blocked_gate_check_failed", "status": "blocked"},
+        5251: {"honest_verdict": _wrap("complete: fragment self-checking was harmful")},
+        5252: {
+            "honest_verdict": _wrap(
+                "complete: typed provenance memory did not reduce hallucination errors"
+            )
+        },
+        5253: {
+            "honest_verdict": _wrap(
+                "complete: level_delta=0 patch_decision=retire_current_provenance_patch"
+            ),
+            "level_delta": _wrap(0),
+            "retire_current_provenance_patch": _wrap(True),
+        },
+        5254: {
+            "honest_verdict": _wrap("complete: bounded two-variable certificate"),
+            "true_property_certified": _wrap(True),
+        },
+        5255: {
+            "honest_verdict": _wrap("complete: no_speedup_claim"),
+            "speedup_claimed": _wrap(False),
+        },
+        5256: _capstone_payload(),
+    }
+    return payloads[number]
+
+
+def _research_complete(has_v480: bool = True) -> str:
+    milestones: list[dict[str, Any]] = [
+        {
+            "id": "2026.07.479",
+            "title": "prior fixture",
+            "completed": "2026-07-04",
+            "finding": "fixture",
+            "tasks": [],
+        }
+    ]
+    if has_v480:
+        milestones.append(
+            {
+                "id": "2026.07.480",
+                "title": "Typed Memory, Receipt Integrity, and Verified Decoding Allocation",
+                "completed": "2026-07-05",
+                "finding": "See conductor log for per-experiment results.",
+                "tasks": [],
+            }
+        )
+    return yaml.safe_dump({"milestones": milestones}, sort_keys=False)
+
+
+def _make_repo(
+    root: Path,
+    *,
+    has_v480_complete: bool = True,
+    active_milestone: str = "2026.07.481",
+    vnext_milestone: str = "2026.07.481",
+    next_file: bool = False,
+    capstone: dict[str, Any] | None = None,
+) -> Path:
+    for source in mod.UPSTREAM_SOURCES:
+        if source.experiment_number == 5246:
+            continue
+        _write_json(root / source.relative_path, _upstream_payload(source.experiment_number))
+    if capstone is not None:
+        _write_json(root / mod.CAPSTONE_RELATIVE_PATH, capstone)
+    (root / "research-complete.yaml").write_text(
+        _research_complete(has_v480_complete), encoding="utf-8"
+    )
+    (root / "research-roadmap.yaml").write_text(_roadmap(active_milestone), encoding="utf-8")
+    if next_file:
+        (root / "research-roadmap-next.yaml").write_text(_roadmap("2026.07.481"), encoding="utf-8")
+    (root / "openspec/change-proposals").mkdir(parents=True, exist_ok=True)
+    (root / "openspec/change-proposals/research-roadmap-vNEXT.md").write_text(
+        f"# Research Roadmap vNEXT: Milestone {vnext_milestone}\n", encoding="utf-8"
+    )
+    (root / "ops").mkdir(parents=True, exist_ok=True)
+    for relative in ("status.md", "changelog.md", "conductor-log.md", "exclusion_manifest.yaml"):
+        (root / "ops" / relative).write_text(
+            "fixture 2026.07.480 normalizer ready GAP-4 salvaged clean null llama.cpp GGUF Token-Guard harmful HalluHard clean null ARC level_delta=0 KAN bounded hardware no-speedup\n",
+            encoding="utf-8",
+        )
+    (root / "scripts").mkdir(parents=True, exist_ok=True)
+    (root / "scripts/research_conductor.py").write_text("# fixture\n", encoding="utf-8")
+    return root
+
+
+def _passed_commands() -> list[mod.CommandResult]:
+    return [
+        mod.CommandResult(
+            (".venv/bin/python", "scripts/exclusion_manifest_lint.py", "research-roadmap.yaml"),
+            0,
+            "clean",
+            "",
+        ),
+        mod.CommandResult(
+            (".venv/bin/python", "scripts/validate_prior_failures.py", "research-roadmap.yaml"),
+            0,
+            "clean",
+            "",
+        ),
+        mod.CommandResult(
+            (".venv/bin/python", "scripts/audit_roadmap_gates.py", "research-roadmap.yaml"),
+            0,
+            "clean",
+            "",
+        ),
+    ]
+
+
+def _failed_commands() -> list[mod.CommandResult]:
+    return [
+        mod.CommandResult(
+            (".venv/bin/python", "scripts/exclusion_manifest_lint.py", "research-roadmap.yaml"),
+            1,
+            "HARD violation",
+            "",
+        )
+    ]
+
+
+def test_req_report_5257_spec_declares_archive_contract() -> None:
+    """REQ-REPORT-5257: OpenSpec anchors the .480 archive and .481 readiness contract."""
+
+    spec = SPEC_PATH.read_text(encoding="utf-8")
+    section = spec[spec.index("REQ-REPORT-5257") : spec.index("REQ-REPORT-5162")]
+
+    for marker in (
+        "REQ-REPORT-5257",
+        "SCENARIO-REPORT-5257",
+        "SCENARIO-REPORT-5257-BLOCKED-CLOSEOUT",
+        str(mod.RESULT_RELATIVE_PATH),
+        "cached_fixture_replay_no_llm",
+        "roadmap_activation_check.activated=false",
+        "Token-Guard/Carnot",
+        "commands_run",
+    ):
+        assert marker in section
+    for field, principle in mod.FIELD_PRINCIPLES.items():
+        assert f"`{field}`" in section
+        assert principle in section
+
+
+def test_scenario_report_5257_already_active_records_no_overwrite(tmp_path: Path) -> None:
+    """SCENARIO-REPORT-5257: already-active .481 produces a complete no-overwrite artifact."""
+
+    root = _make_repo(tmp_path)
+    before = (root / "research-roadmap.yaml").read_text(encoding="utf-8")
+    artifact = mod.build_artifact(
+        root=root,
+        run_date="20260705",
+        duration_s=1.25,
+        validation_results=_passed_commands(),
+        conductor_untouched=True,
+        update_research_complete=False,
+    )
+
+    mod.validate_artifact(artifact)
+    assert (root / "research-roadmap.yaml").read_text(encoding="utf-8") == before
+    assert artifact["milestone_archived"] is True
+    assert artifact["activation_ready"] is True
+    assert artifact["honest_verdict"]["value"].startswith("complete:")
+    assert ".480 archived" in artifact["honest_verdict"]["value"]
+    assert ".481 activation-ready" in artifact["honest_verdict"]["value"]
+    assert artifact["inference_substrate"]["value"] == mod.INFERENCE_SUBSTRATE
+    assert artifact["ops_docs_updated"]["value"] is False
+    assert artifact["research_complete_updated"]["value"] is False
+    assert artifact["exclusions_checked"]["value"] is True
+    assert artifact["roadmap_activation_check"]["activated"] is False
+    assert artifact["roadmap_activation_check"]["active_roadmap_already_481"] is True
+    assert artifact["roadmap_activation_check"]["roadmap_next_present"] is False
+    assert [row["passed"] for row in artifact["commands_run"]] == [True, True, True]
+    assert artifact["closeout_facts"]["artifact_normalizer_ready"] is True
+    assert artifact["closeout_facts"]["gap4_final_decision"] == "salvaged_clean_null"
+    assert artifact["closeout_facts"]["exp5249_runtime_blocked"] is True
+    assert artifact["closeout_facts"]["exp5250_gated_skipped"] is True
+    assert artifact["closeout_facts"]["token_guard_harmful"] is True
+    assert artifact["closeout_facts"]["halluhard_clean_null"] is True
+    assert artifact["closeout_facts"]["arc_level_delta"] == 0
+    assert artifact["closeout_facts"]["arc_patch_retired"] is True
+    assert artifact["closeout_facts"]["kan_bounded_positive"] is True
+    assert artifact["closeout_facts"]["hardware_no_speedup"] is True
+    assert artifact["failed_preconditions"] == []
+    assert artifact["reproducibility_checksum"] == mod.payload_checksum(artifact)
+
+
+def test_scenario_report_5257_blocked_closeout_keeps_failures_visible(tmp_path: Path) -> None:
+    """SCENARIO-REPORT-5257-BLOCKED-CLOSEOUT: contradictory evidence blocks readiness."""
+
+    bad_capstone = _capstone_payload() | {
+        "token_guard_status": _wrap("clean_positive: fixture"),
+        "hardware_speedup_claimed": _wrap(True),
+    }
+    artifact = mod.build_artifact(
+        root=_make_repo(
+            tmp_path,
+            active_milestone="2026.07.480",
+            vnext_milestone="2026.07.482",
+            capstone=bad_capstone,
+        ),
+        run_date="20260705",
+        duration_s=0.5,
+        validation_results=_failed_commands(),
+        conductor_untouched=False,
+        update_research_complete=False,
+    )
+
+    mod.validate_artifact(artifact)
+    assert artifact["milestone_archived"] is False
+    assert artifact["activation_ready"] is False
+    assert artifact["honest_verdict"]["value"].startswith("blocked_")
+    assert artifact["roadmap_activation_check"]["activated"] is False
+    assert (
+        "closeout_token_guard_harmful_expected_True_observed_False"
+        in artifact["failed_preconditions"]
+    )
+    assert (
+        "closeout_hardware_no_speedup_expected_True_observed_False"
+        in artifact["failed_preconditions"]
+    )
+    assert "vnext_missing_2026.07.481" in artifact["failed_preconditions"]
+    assert "active_or_next_roadmap_not_ready_for_481" in artifact["failed_preconditions"]
+    assert (
+        "validation_failed_scripts/exclusion_manifest_lint.py" in artifact["failed_preconditions"]
+    )
+    assert "scripts_research_conductor_py_modified" in artifact["failed_preconditions"]
+    assert artifact["exclusions_checked"]["value"] is False
+
