+        skipped_artifacts:
+          principle: "the artifacts skipped for flagged_adversarial / control-failed / ablation-missing -- the fabrication-gate discipline (never aggregate a flagged number)."
+        next_milestone_fallback:
+          principle: "the .435 direction (D's flagged_for_v435 active-probe methods + B1's reopen list + the strongest open lever) -- the convergence hand-off."
+        random_seed:
+          principle: "determinism precondition for reproducibility."
