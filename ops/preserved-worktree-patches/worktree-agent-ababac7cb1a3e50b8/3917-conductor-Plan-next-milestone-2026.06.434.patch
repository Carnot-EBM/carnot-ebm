+        inference_substrate:
+          principle: "aggregation_from_upstream_artifacts -- reads upstream, no model load (100us floor)."
+        bridge_crossed_for_solve:
+          principle: "the HEADLINE DECISION -- True only if a GENERIC agent banked a NEW level via self-discovery (A1 lp85 L2 | A2 surfaced winner | A4 goal-free L2), offline-reproduced, ablation-controlled; False if only capability/depth grew."
+        a1_lp85_l2_banked:
+          principle: "did A1 bank lp85 L2 via the perception-grounded structural goal (the perception win -> a real multi-level solve)?"
+        a2_surfaced_present_winner:
+          principle: "did A2 surface the present-but-buried winner (precision-at-k up + generic new level + no-surfacing ablation failing)? -- the verifier earning its place."
+        a4_online_driver_beat_frozen:
+          principle: "did the corrected online driver beat frozen by >=+0.05 held-out first-win AND/OR deepen to L2?"
+        b1_silent_bug_reopen_list:
+          principle: "the .428-.433 nulls B1 classified silent_bug_must_reopen -- closed levers that must reopen (trust correction)."
+        reproducible_total_levels_delta:
