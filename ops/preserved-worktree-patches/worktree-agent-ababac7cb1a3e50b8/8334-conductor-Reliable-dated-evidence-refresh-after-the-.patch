+    started = datetime.now(UTC)
+    time.sleep(0.001)
+    finished = datetime.now(UTC)
+    artifact = build_and_write_artifact(
+        root=REPO_ROOT,
+        search_started_at=started.isoformat(timespec="microseconds").replace("+00:00", "Z"),
