+        "schema": "carnot.exp6157.resumable_migration_ledger.v1",
+        "covered_row_count": len(entries),
+        "entries": sorted(entries, key=lambda row: row["migration_key"]),
+    }
+    ledger["content_checksum"] = payload_checksum(ledger)
