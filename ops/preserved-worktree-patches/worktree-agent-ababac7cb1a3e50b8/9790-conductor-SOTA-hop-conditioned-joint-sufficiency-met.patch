+def _extract_between(text: str, start: str, end: str) -> str:
+    start_index = text.find(start)
+    end_index = text.find(end)
+    if start_index < 0 or end_index < 0 or end_index <= start_index:
+        return ""
+    return text[start_index : end_index + len(end)]
