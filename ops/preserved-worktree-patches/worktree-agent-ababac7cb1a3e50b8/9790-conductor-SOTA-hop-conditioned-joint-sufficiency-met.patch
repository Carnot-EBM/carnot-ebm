+            "sha256": "sha256:" + "6" * 64,
+            "source_method_contract_ready_score": 1.0,
+        },
+        "compiler_and_solver_versions": {
+            "compiler": {"name": mod.COMPILER_NAME, "version": mod.COMPILER_VERSION},
