+        "cycle_handling": "reject",
+        "optional_edges_can_satisfy_required_coverage": False,
+        "deterministic_reducer": "joint_sufficiency_reduce.v6574",
+        "release_rule": [
+            "node_ids_unique",
+            "source_byte_spans_match",
+            "relations_whitelisted",
