 ops/conductor-heartbeat.json | 2 +-
 ops/conductor-state.json     | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/ops/conductor-heartbeat.json b/ops/conductor-heartbeat.json
index 3a7d9a8b3f..673c9c808c 100644
--- a/ops/conductor-heartbeat.json
+++ b/ops/conductor-heartbeat.json
@@ -1 +1 @@
-{"pid": 74395, "iteration": 208, "phase": "iteration_start", "last_beat": "2026-06-30T15:47:59Z"}
\ No newline at end of file
+{"pid": 2019592, "iteration": 1, "phase": "iteration_start", "last_beat": "2026-06-30T15:51:58Z"}
\ No newline at end of file
diff --git a/ops/conductor-state.json b/ops/conductor-state.json
index 9e925a0364..138269da99 100644
--- a/ops/conductor-state.json
+++ b/ops/conductor-state.json
@@ -1 +1 @@
-{"pid": 74395, "iteration": 208, "phase": "iteration_start", "started_at": "2026-06-30T15:47:59Z"}
\ No newline at end of file
+{"pid": 2019592, "iteration": 1, "phase": "iteration_start", "started_at": "2026-06-30T15:51:58Z"}
\ No newline at end of file
