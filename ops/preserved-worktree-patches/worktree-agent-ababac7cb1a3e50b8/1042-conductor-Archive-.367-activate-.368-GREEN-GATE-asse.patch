+      "code": "def transform(grid):\n    bg = 8\n\n    mask = (grid != bg)\n    h, w = grid.shape\n    seen = np.zeros((h, w), dtype=bool)\n    comps = []\n\n    for r in range(h):\n        for c in range(w):\n            if mask[r, c] and not seen[r, c]:\n                stack = [(r, c)]\n                seen[r, c] = True\n                cells = []\n                while stack:\n                    x, y = stack.pop()\n                    cells.append((x, y))\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < h and 0 <= ny < w and mask[nx, ny] and not seen[nx, ny]:\n                            seen[nx, ny] = True\n                            stack.append((nx, ny))\n\n                rs = [p[0] for p in cells]\n                cs = [p[1] for p in cells]\n                r0, r1 = min(rs), max(rs)\n                c0, c1 = min(cs), max(cs)\n                sub = grid[r0:r1 + 1, c0:c1 + 1]\n                comps.append((r0, c0, sub))\n\n    def special_pos(sub):\n        vals = sub[(sub != 0) & (sub != 4)]\n        if len(vals) == 0:\n            return None\n        color = vals[0]\n        pos = np.argwhere(sub == color)[0]\n        return int(pos[0]), int(pos[1]), int(color)\n\n    blank = None\n    pattern = None\n    for r0, c0, sub in comps:\n        sp = special_pos(sub)\n        if sp is None:\n            continue\n        if np.any(sub == 4):\n            pattern = (r0, c0, sub, sp)\n        else:\n            blank = (r0, c0, sub, sp)\n\n    _, _, blank_sub, blank_sp = blank\n    _, _, pat_sub, pat_sp = pattern\n\n    out = np.zeros(blank_sub.shape, dtype=grid.dtype)\n    dr = blank_sp[0] - pat_sp[0]\n    dc = blank_sp[1] - pat_sp[1]\n\n    for r in range(pat_sub.shape[0]):\n        for c in range(pat_sub.shape[1]):\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < out.shape[0] and 0 <= nc < out.shape[1]:\n                out[nr, nc] = pat_sub[r, c]\n\n    return out",
