+      "code": "def transform(grid):\n    g = np.array(grid)\n    h, w = g.shape\n\n    sep = None\n    best = -1\n    for c in range(1, 10):\n        full_rows = np.where(np.all(g == c, axis=1))[0]\n        full_cols = np.where(np.all(g == c, axis=0))[0]\n        score = len(full_rows) + len(full_cols)\n        if len(full_rows) and len(full_cols) and score > best:\n            sep = c\n            best = score\n\n    row_lines = list(np.where(np.all(g == sep, axis=1))[0])\n    col_lines = list(np.where(np.all(g == sep, axis=0))[0])\n\n    row_bounds = [-1] + row_lines + [h]\n    col_bounds = [-1] + col_lines + [w]\n\n    candidates = []\n    for i in range(len(row_bounds) - 1):\n        r1, r2 = row_bounds[i] + 1, row_bounds[i + 1]\n        if r1 >= r2:\n            continue\n        for j in range(len(col_bounds) - 1):\n            c1, c2 = col_bounds[j] + 1, col_bounds[j + 1]\n            if c1 >= c2:\n                continue\n\n            block = g[r1:r2, c1:c2]\n            vals = block[block != 0]\n            if vals.size == 0:\n                continue\n\n            colors = np.unique(vals)\n            if len(colors) == 1:\n                candidates.append((colors[0] == sep, -vals.size, block))\n\n    candidates.sort(key=lambda x: (x[0], x[1]))\n    return candidates[0][2].copy()",
