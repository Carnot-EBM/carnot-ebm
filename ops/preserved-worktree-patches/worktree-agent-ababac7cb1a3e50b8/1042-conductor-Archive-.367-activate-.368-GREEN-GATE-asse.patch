+      "code": "def transform(grid):\n    out = grid.copy()\n    h, w = grid.shape\n\n    def comps(mask):\n        seen = np.zeros(mask.shape, dtype=bool)\n        res = []\n        for r in range(mask.shape[0]):\n            for c in range(mask.shape[1]):\n                if mask[r, c] and not seen[r, c]:\n                    stack = [(r, c)]\n                    seen[r, c] = True\n                    cells = []\n                    while stack:\n                        x, y = stack.pop()\n                        cells.append((x, y))\n                        for dx in (-1, 0, 1):\n                            for dy in (-1, 0, 1):\n                                if dx == 0 and dy == 0:\n                                    continue\n                                nx, ny = x + dx, y + dy\n                                if 0 <= nx < mask.shape[0] and 0 <= ny < mask.shape[1] and mask[nx, ny] and not seen[nx, ny]:\n                                    seen[nx, ny] = True\n                                    stack.append((nx, ny))\n                    res.append(cells)\n        return res\n\n    ones = comps(grid == 1)\n    if not ones:\n        return out\n\n    colored = comps((grid != 0) & (grid != 1))\n    if not colored:\n        return out\n\n    key = None\n    for comp in colored:\n        vals = {grid[r, c] for r, c in comp}\n        if len(vals) > 1:\n            key = comp\n            break\n    if key is None:\n        key = max(colored, key=len)\n\n    kr0 = min(r for r, c in key)\n    kc0 = min(c for r, c in key)\n    color_by_pos = {(r - kr0, c - kc0): grid[r, c] for r, c in key}\n\n    obj_info = []\n    for obj in ones:\n        r0 = min(r for r, c in obj)\n        c0 = min(c for r, c in obj)\n        obj_info.append((r0, c0, obj))\n\n    row_starts = sorted(set(r0 for r0, c0, obj in obj_info))\n    col_starts = sorted(set(c0 for r0, c0, obj in obj_info))\n    row_map = {r: i for i, r in enumerate(row_starts)}\n    col_map = {c: i for i, c in enumerate(col_starts)}\n\n    for r0, c0, obj in obj_info:\n        pos = (row_map[r0], col_map[c0])\n        if pos in color_by_pos:\n            rr, cc = zip(*obj)\n            out[rr, cc] = color_by_pos[pos]\n\n    return out",
