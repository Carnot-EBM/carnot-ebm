+    gap4_text = gap4_path.read_text(encoding="utf-8") if gap4_path.exists() else ""
+    gap4_present = gap4_spec_present_from_text(gap4_text)
+    preconditions["gap4_spec_present"] = gap4_present
+    if not gap4_present:
