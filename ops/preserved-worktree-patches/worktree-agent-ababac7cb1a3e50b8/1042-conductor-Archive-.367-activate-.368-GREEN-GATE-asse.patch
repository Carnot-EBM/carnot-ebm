+      "code": "def transform(grid):\n    out = grid.copy()\n    h, w = grid.shape\n\n    seen = np.zeros((h, w), dtype=bool)\n    for r in range(h):\n        for c in range(w):\n            if grid[r, c] != 5 or seen[r, c]:\n                continue\n\n            stack = [(r, c)]\n            seen[r, c] = True\n            cells = []\n            while stack:\n                rr, cc = stack.pop()\n                cells.append((rr, cc))\n                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nr, nc = rr + dr, cc + dc\n                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and grid[nr, nc] == 5:\n                        seen[nr, nc] = True\n                        stack.append((nr, nc))\n\n            rows = [p[0] for p in cells]\n            cols = [p[1] for p in cells]\n            r0, r1 = min(rows), max(rows)\n            c0, c1 = min(cols), max(cols)\n\n            top_gaps = [cc for cc in range(c0, c1 + 1) if grid[r0, cc] == 0]\n            if not top_gaps:\n                continue\n\n            gap = top_gaps[0]\n\n            for rr in range(r0, r1):\n                for cc in range(c0, c1 + 1):\n                    if grid[rr, cc] == 0:\n                        out[rr, cc] = 2\n\n            left_count = sum(1 for cc in range(c0, gap) if grid[r0, cc] == 5)\n            right_count = sum(1 for cc in range(gap + 1, c1 + 1) if grid[r0, cc] == 5)\n\n            line_r = r0 - 1\n            if line_r >= 0:\n                if right_count > left_count:\n                    out[line_r, gap:w] = 2\n                else:\n                    out[line_r, 0:gap + 1] = 2\n\n    return out",
