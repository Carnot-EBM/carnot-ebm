+      "code": "def transform(grid):\n    g = grid\n    vals, counts = np.unique(g[g != 0], return_counts=True)\n    bg_color = vals[np.argmax(counts)]\n\n    # Large solid rectangle gives the output canvas size.\n    mask_bg = (g == bg_color)\n    seen = np.zeros(g.shape, dtype=bool)\n    comps = []\n    H, W = g.shape\n    for r in range(H):\n        for c in range(W):\n            if mask_bg[r, c] and not seen[r, c]:\n                stack = [(r, c)]\n                seen[r, c] = True\n                cells = []\n                while stack:\n                    x, y = stack.pop()\n                    cells.append((x, y))\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < H and 0 <= ny < W and mask_bg[nx, ny] and not seen[nx, ny]:\n                            seen[nx, ny] = True\n                            stack.append((nx, ny))\n                rs = [x for x, y in cells]\n                cs = [y for x, y in cells]\n                comps.append((len(cells), min(rs), max(rs), min(cs), max(cs)))\n\n    big = max(comps, key=lambda x: x[0])\n    out_h = big[2] - big[1] + 1\n    out_w = big[4] - big[3] + 1\n\n    # Key is the nonzero component containing color 2.\n    nz = (g != 0)\n    seen = np.zeros(g.shape, dtype=bool)\n    key = None\n    patterns = []\n    for r in range(H):\n        for c in range(W):\n            if nz[r, c] and not seen[r, c]:\n                stack = [(r, c)]\n                seen[r, c] = True\n                cells = []\n                vals_here = set()\n                while stack:\n                    x, y = stack.pop()\n                    cells.append((x, y))\n                    vals_here.add(g[x, y])\n                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        nx, ny = x + dx, y + dy\n                        if 0 <= nx < H and 0 <= ny < W and nz[nx, ny] and not seen[nx, ny]:\n                            seen[nx, ny] = True\n                            stack.append((nx, ny))\n                rs = [x for x, y in cells]\n                cs = [y for x, y in cells]\n                box = (min(rs), max(rs), min(cs), max(cs), vals_here)\n                if 2 in vals_here:\n                    key = box\n                elif 8 in vals_here and bg_color in vals_here:\n                    patterns.append(box)\n\n    kr0, kr1, kc0, kc1, _ = key\n    key_arr = g[kr0:kr1 + 1, kc0:kc1 + 1]\n    key_mask = (key_arr == 8)\n    kh, kw = key_arr.shape\n\n    # The guide pattern is the small component made from output color and 8.\n    guide = max(patterns, key=lambda b: (b[1] - b[0] + 1) * (b[3] - b[2] + 1))\n    gr0, gr1, gc0, gc1, _ = guide\n    guide_arr = g[gr0:gr1 + 1, gc0:gc1 + 1]\n    gh, gw = guide_arr.shape\n\n    tiles_h = out_h // kh\n    tiles_w = out_w // kw\n    block_h = gh // tiles_h\n    block_w = gw // tiles_w\n\n    out = np.full((out_h, out_w), bg_color, dtype=g.dtype)\n    for tr in range(tiles_h):\n        for tc in range(tiles_w):\n            block = guide_arr[tr * block_h:(tr + 1) * block_h, tc * block_w:(tc + 1) * block_w]\n            if np.any(block == 8):\n                rr = tr * kh\n                cc = tc * kw\n                out[rr:rr + kh, cc:cc + kw][key_mask] = 8\n\n    return out",
