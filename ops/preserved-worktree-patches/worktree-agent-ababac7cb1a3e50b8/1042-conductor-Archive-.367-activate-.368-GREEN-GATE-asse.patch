+def _exp_id_from_artifact_line(line: str) -> str | None:
+    stripped = line.strip()
+    if not stripped.startswith("ARTIFACT  experiment_"):
+        return None
+    return stripped.split("experiment_", 1)[1].split("_", 1)[0]
+
