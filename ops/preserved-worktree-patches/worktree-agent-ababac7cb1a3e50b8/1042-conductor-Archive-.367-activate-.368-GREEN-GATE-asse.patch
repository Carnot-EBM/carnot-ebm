+      "code": "def transform(grid):\n    out = grid.copy()\n    bg = 8\n\n    mask = grid != bg\n    h, w = grid.shape\n    seen = np.zeros((h, w), dtype=bool)\n\n    for sr in range(h):\n        for sc in range(w):\n            if not mask[sr, sc] or seen[sr, sc]:\n                continue\n\n            stack = [(sr, sc)]\n            seen[sr, sc] = True\n            cells = []\n\n            while stack:\n                r, c = stack.pop()\n                cells.append((r, c))\n                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nr, nc = r + dr, c + dc\n                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:\n                        seen[nr, nc] = True\n                        stack.append((nr, nc))\n\n            rs = [r for r, _ in cells]\n            cs = [c for _, c in cells]\n            r0, r1 = min(rs), max(rs)\n            c0, c1 = min(cs), max(cs)\n\n            block = grid[r0:r1 + 1, c0:c1 + 1]\n            colored = (block != 0) & (block != bg)\n            if not colored.any():\n                continue\n\n            prs, pcs = np.where(colored)\n            pr0, pr1 = prs.min(), prs.max()\n            pc0, pc1 = pcs.min(), pcs.max()\n            pattern = block[pr0:pr1 + 1, pc0:pc1 + 1]\n\n            ph, pw = pattern.shape\n            for r in range(r0, r1 + 1):\n                for c in range(c0, c1 + 1):\n                    out[r, c] = pattern[(r - r0) % ph, (c - c0) % pw]\n\n    return out",
