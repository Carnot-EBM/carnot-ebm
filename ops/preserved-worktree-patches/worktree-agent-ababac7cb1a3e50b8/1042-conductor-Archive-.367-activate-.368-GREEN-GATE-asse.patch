+      "code": "def transform(grid):\n    out = grid.copy()\n    pts = np.argwhere(grid != 0)\n\n    if len(pts) < 2:\n        return out\n\n    pts = pts[np.lexsort((pts[:, 1], pts[:, 0]))]\n    diffs = pts[1:] - pts[:-1]\n\n    dr, dc = diffs[0]\n    if not np.all(diffs == diffs[0]):\n        return out\n\n    r, c = pts[-1] + np.array([dr, dc])\n    h, w = out.shape\n\n    while 0 <= r < h and 0 <= c < w:\n        if out[r, c] == 0:\n            out[r, c] = 2\n        r += dr\n        c += dc\n\n    return out",
