+        f"{facts5178.get('pilot_n_candidates')} candidates, hidden={facts5178.get('hidden_state_verifier_accuracy')} "
+        f"vs tuned_sc={facts5178.get('tuned_sc_baseline_accuracy')}, CI={facts5178.get('accuracy_delta_ci95')}; "
