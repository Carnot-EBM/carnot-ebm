+    assert live_path == tmp_path / mod.RESULT_RELATIVE_PATH
+    assert live["reproducibility_checksum"] == mod.payload_checksum(live)
+    assert live["test_exit_codes"] == _test_exit_codes()
+    mod.validate_artifact(live)
