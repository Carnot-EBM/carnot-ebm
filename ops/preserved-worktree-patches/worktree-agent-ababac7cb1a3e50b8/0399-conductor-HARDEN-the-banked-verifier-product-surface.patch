+        "\n".join(json.dumps(candidate) for candidate in _batch_candidates()),
+        encoding="utf-8",
+    )
+    monkeypatch.setattr(
+        "sys.argv",
+        [
+            "carnot",
+            "verify-batch",
+            "--candidates-file",
