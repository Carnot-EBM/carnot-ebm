+    seen: set[str] = set()
+    for candidate in candidates:
+        key = f"{candidate.source}:{candidate.name}"
+        if key in seen:
+            continue
+        seen.add(key)
+        deduped.append(candidate)
+        if len(deduped) >= int(max_subgoals):
