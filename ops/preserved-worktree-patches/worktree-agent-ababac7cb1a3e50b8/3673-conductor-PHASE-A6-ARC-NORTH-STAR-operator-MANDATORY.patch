+    assert spec.loader is not None
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def _install_submitted_config_stub(monkeypatch: Any) -> None:
+    carnot = types.ModuleType("carnot")
+    agentic = types.ModuleType("carnot.agentic")
