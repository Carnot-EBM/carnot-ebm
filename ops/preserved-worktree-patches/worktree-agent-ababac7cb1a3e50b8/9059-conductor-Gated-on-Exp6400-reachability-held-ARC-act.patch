+    rows: list[JsonDict] = []
+    window_index = 0
+    for selected in SELECTED_WINDOWS:
+        for seed in RANDOM_SEEDS:
+            transitions = _transitions_for(str(selected["mechanic"]), seed, window_index)
+            payload = _transition_payload(transitions)
