+
+    bad = dict(valid)
+    bad.pop("status")
+    bad["inference_substrate"] = "wrong"
+    bad["scope_boundary_and_repository_wide_closure_claimed"] = {
+        "repository_wide_closure_claimed": True
+    }
+    bad["field_provenance"] = []
+    bad["honest_verdict"] = "maybe"
