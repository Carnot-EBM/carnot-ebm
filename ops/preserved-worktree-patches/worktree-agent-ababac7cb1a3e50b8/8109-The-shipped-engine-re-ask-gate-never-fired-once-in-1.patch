+    "b_shipped": "nothing set -- the shipped state, unmodified",
+    "c_owns": "CARNOT_ARC_INDUCE_DEFECT_OWNS_ATTEMPTS=1 -- a defect re-ask GRANTS an attempt instead of consuming one"
