+    "results/experiment_5393_overwrite_guidance_tautology_corrigendum_v491.json"
+)
+EXPERIMENT = 5394
+EXPERIMENT_ID = "exp5394-gated-overwrite-pbit-ablation-v491"
+MILESTONE = "2026.07.491"
