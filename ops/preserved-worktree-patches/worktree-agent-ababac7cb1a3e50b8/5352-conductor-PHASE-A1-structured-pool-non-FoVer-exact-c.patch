+def read_jsonl(path: Path) -> list[JsonDict]:
+    if not path.exists():
+        return []
+    rows: list[JsonDict] = []
+    for line in path.read_text(encoding="utf-8").splitlines():
+        if line.strip():
+            parsed = json.loads(line)
+            if isinstance(parsed, dict):
+                rows.append(parsed)
+    return rows
+
