+            if path.exists()
+        }
+    )
+    if governors:
+        return {"governors": governors, "stable_single_governor": len(governors) == 1}
+    return {  # pragma: no cover - host-dependent cpufreq fallback.
+        "blocked_reason": "cpufreq_governor_not_observable"
+    }
