+def _load_payloads(root: Path) -> tuple[dict[str, JsonDict], dict[str, JsonDict]]:
+    payloads = {}
+    metas = {}
+    for task_id, rel in EXPECTED_ARTIFACTS.items():
+        payload, meta = read_json_mapping(root / rel)
+        payloads[task_id] = payload
+        metas[task_id] = meta
+    return payloads, metas
