From 97ba454c8b81dc628d4892a22dc3fa16388c8132 Mon Sep 17 00:00:00 2001
From: Ian Blenke <ian@blenke.com>
Date: Sun, 14 Jun 2026 15:51:34 -0400
Subject: [PATCH 01815/11362] [outer-loop] energy-prior: tested vLLM 4-bit-1GPU
 + transformers 1-GPU -- all released runtimes exhausted

Operator Q 'does vllm support 4bit on one gpu': YES it does, but it's moot for DiffusionGemma:
vLLM 0.23.0 (release AND nightly wheel) has NO native DiffusionGemmaForBlockDiffusion runner
(registry: Gemma1-4 yes, DiffusionGemma no) -> generic transformers backend -> 'input_ids not
found in forward', same error at 4-bit/TP1. transformers single-GPU 4-bit OOMs (~24.3GB needed
> 23.56GB usable). transformers 2-GPU 4-bit hits device_map-plans-on-bf16 (49>48GB) catch-22.
Conclusion: score extraction needs a SOURCE build (vLLM-main or llama.cpp-master have the arch).
Cleanest = llama.cpp-master for the 16.8GB GGUF (fits one GPU with ~7GB headroom).

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 scripts/exp_diffusiongemma_energy_prior_transformers.py | 9 ++++-----
 scripts/exp_diffusiongemma_energy_prior_vllm.py         | 5 +++--
 2 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/scripts/exp_diffusiongemma_energy_prior_transformers.py b/scripts/exp_diffusiongemma_energy_prior_transformers.py
index 45eb32dfd9..edf1e588f0 100644
--- a/scripts/exp_diffusiongemma_energy_prior_transformers.py
+++ b/scripts/exp_diffusiongemma_energy_prior_transformers.py
@@ -45,14 +45,13 @@ def main() -> None:
             bnb_4bit_compute_dtype=torch.bfloat16,
             bnb_4bit_quant_type="nf4",
         )
-        n_gpu = torch.cuda.device_count()
-        # GPUs ONLY -- no 'cpu' key -> no CPU/meta offload (the prior failure mode).
-        max_mem = {i: "22GiB" for i in range(n_gpu)}
+        # Single-GPU 4-bit: ~23GB fits one 3090 (prior attempt was 20MB short -> run with
+        # PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True to defragment). device_map={"":0}
+        # = everything on the one visible GPU, NO offload -> no meta tensors, no bf16 planning.
         model = DiffusionGemmaForBlockDiffusion.from_pretrained(
             REPO,
             quantization_config=bnb,
-            device_map="auto",
-            max_memory=max_mem,
+            device_map={"": 0},
             trust_remote_code=False,
         )
         model.eval()
diff --git a/scripts/exp_diffusiongemma_energy_prior_vllm.py b/scripts/exp_diffusiongemma_energy_prior_vllm.py
index f443a8d03d..a1c6f313d7 100644
--- a/scripts/exp_diffusiongemma_energy_prior_vllm.py
+++ b/scripts/exp_diffusiongemma_energy_prior_vllm.py
@@ -41,10 +41,11 @@ def main() -> None:
         llm = None
         # fp8 TP=2 fits 26B on 2x3090 (~13GB/GPU) with room for a tiny KV cache.
         for kw, tag in [
+            # 4-bit single-GPU (operator question 2026-06-14): 26B bnb-4bit ~13GB fits one 3090.
+            (dict(tensor_parallel_size=1, quantization="bitsandbytes", max_model_len=1024,
+                  gpu_memory_utilization=0.92, enforce_eager=True), "bnb4bit_tp1"),
             (dict(tensor_parallel_size=2, quantization="fp8", max_model_len=1024,
                   gpu_memory_utilization=0.88, enforce_eager=True), "fp8_tp2"),
-            (dict(tensor_parallel_size=2, max_model_len=512, gpu_memory_utilization=0.92,
-                  enforce_eager=True), "bf16_tp2"),
         ]:
             try:
                 llm = LLM(model=REPO, dtype="auto", trust_remote_code=False, **kw)
-- 
