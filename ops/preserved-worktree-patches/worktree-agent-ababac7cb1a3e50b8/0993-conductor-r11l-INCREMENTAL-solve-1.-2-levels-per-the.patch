+        fail_zero_based_levels={2},
+    )
+
+    solved = mod.solve_incremental_levels(env, FakeAction, FakeState, budget=30, stop_after_level=3)
+    artifact = mod.build_result_artifact(
+        solved,
+        game="r11l-495a7899",
+        budget=30,
