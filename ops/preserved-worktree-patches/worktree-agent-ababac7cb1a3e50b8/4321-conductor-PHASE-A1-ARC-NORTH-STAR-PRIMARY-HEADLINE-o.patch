+            )
+        )
+        ordered = [row for _index, row in ranked]
+        ordered_keys = [(row.get("action"), repr(row.get("data"))) for row in ordered]
+        if ordered_keys != original_keys:
+            self._proposal_changes += 1
+        return ordered
