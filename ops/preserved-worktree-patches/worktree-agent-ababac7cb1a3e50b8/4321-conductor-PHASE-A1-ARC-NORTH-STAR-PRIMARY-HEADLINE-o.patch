+    ) -> PriorScore:
+        scores, _context, _hit = self._scores_for_path(path)
+        family = first_contact_family(candidate)
+        return PriorScore(family=family, score=float(scores.get(family, 0.0)))
+
+    def rank_candidates(
+        self,
+        _frame: Any,
+        candidates: Sequence[Mapping[str, Any]],
+        *,
