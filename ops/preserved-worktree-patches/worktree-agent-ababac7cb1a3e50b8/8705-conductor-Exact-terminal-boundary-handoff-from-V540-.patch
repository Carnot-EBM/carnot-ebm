+def _expected_route(task_id: str) -> tuple[str, str | None]:
+    if task_id in CODEX_TASK_IDS:
+        return "codex", "gpt-5.5"
+    if task_id in OPUS_TASK_IDS:
+        return "default_or_claude", "opus"
+    return "default", None
