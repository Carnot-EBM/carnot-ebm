+        return probe_oracle(
+            corpus_key=LIVECODEBENCH_KEY,
+            evaluation_corpus=LIVECODEBENCH_CORPUS,
+            tasks=tasks[:probe_task_count],
+            legacy_by_task=legacy_by_task,
+            k=k,
