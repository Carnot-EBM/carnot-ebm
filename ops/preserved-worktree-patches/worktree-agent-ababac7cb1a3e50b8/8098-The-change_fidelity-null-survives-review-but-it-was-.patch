+                4,
+            ),
+        },
+        "probe_depth_reached_pooled_auc": round(
+            auc([r["probe_depth_reached"] for r in rows], lab), 4
+        ),
+        "shipped_gate_trust_energy_pooled_auc": round(
+            auc([r["trust_energy"] for r in rows], lab), 4
