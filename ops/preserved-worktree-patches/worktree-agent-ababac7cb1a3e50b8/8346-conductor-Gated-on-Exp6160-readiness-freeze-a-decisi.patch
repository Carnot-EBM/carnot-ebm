+def _structured_gate(
+    preconditions: Mapping[str, Any],
+    upstream: Mapping[str, Any],
+    exp6147_artifact: Mapping[str, Any],
+    exp6159_artifact: Mapping[str, Any],
+    exp6160_artifact: Mapping[str, Any],
