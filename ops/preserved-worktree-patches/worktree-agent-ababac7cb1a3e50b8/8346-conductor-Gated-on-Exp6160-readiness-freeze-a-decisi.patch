+    blockers = sorted(name for name, ok in checks.items() if ok is not True)
+    return {
+        "schema": SCHEMA + ".structured_gate",
+        "run_date": RUN_DATE,
+        "checks": checks,
+        "blockers": blockers,
+        "calibration_permitted": not blockers,
