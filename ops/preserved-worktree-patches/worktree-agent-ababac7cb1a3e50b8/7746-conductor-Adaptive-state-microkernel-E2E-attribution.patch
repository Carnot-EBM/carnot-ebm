+    rows = delta_str.strip().split('\n')
+    for row_line in rows:
+        if not row_line:
+            continue
+        parts = row_line.split('r')
+        if len(parts) != 2:
+            continue
+        row_idx = int(parts[0][1:])
+        runs = parse_runs(parts[1])
+        col = 0
+        for val, cnt in runs:
+            grid[row_idx, col:col+cnt] = val
+            col += cnt
+    return grid
