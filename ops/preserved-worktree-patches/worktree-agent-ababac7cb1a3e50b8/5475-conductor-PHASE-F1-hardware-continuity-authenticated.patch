+            {
+                mod.GATEMATE_DETECT_COMMAND: [
+                    _probe(
+                        mod.GATEMATE_DETECT_COMMAND,
+                        stdout="IDCode : 0x20000001 colognechip GateMate Series GM1Ax\n",
