+        "blocker": str(blocker),
+        "selected_game": str(game or ""),
+        "selected_level": str(selected_level or ""),
+        "target_level": int(max(0, target_level)),
+        "prior_levels_reproduced": int(max(0, prior)),
+        "registry_before_levels": int(total),
+        "selection_reason": str(blocker),
+    }
+
