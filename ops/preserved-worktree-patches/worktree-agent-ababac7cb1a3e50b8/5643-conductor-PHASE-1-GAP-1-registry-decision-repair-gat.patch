+    bad_tests = artifact | {
+        "tests_run": {
+            "value": [{"command": "pytest"}],
+            "principle": mod.FIELD_PRINCIPLES["tests_run"],
+        }
+    }
+    bad_principle = artifact | {
+        "ops_docs_updated": {
+            "value": False,
+            "principle": "wrong principle",
+        }
+    }
+    bad_nulls = artifact | {
+        "promoted_registry_path": {
+            "value": "ops/verifier_registry.yaml",
