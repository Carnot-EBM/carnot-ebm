+REQUIRED_ARTIFACT_FIELDS = tuple(FIELD_PRINCIPLES)
+
+
+def _checksum(payload: Mapping[str, Any]) -> str:
+    blob = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    return "sha256:" + hashlib.sha256(blob).hexdigest()
+
