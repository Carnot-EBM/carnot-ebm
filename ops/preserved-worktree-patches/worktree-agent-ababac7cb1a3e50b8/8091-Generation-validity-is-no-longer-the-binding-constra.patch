+        "returns_none_literal",
+        "engine_returned_none",
+        "engine_wrong_shape",
+        "goal_raised",
+        "goal_not_boolean",
+        "truncated_before_required_symbols",
+    }
+    n_validity = sum(v for c, v in cnt31.items() if c in validity_classes)
+    out["headline"] = {
+        "n_31B_candidates": len(prim31),
