+    try:
+        proc = subprocess.run(
+            ["codex", "exec", "--dangerously-bypass-approvals-and-sandbox", "--color", "never",
+             "--model", model, "--cd", str(PROJECT_ROOT), "--ephemeral", "-"],
+            input=f"{prompt}\n\n---\n{body}",
+            capture_output=True,
+            text=True,
