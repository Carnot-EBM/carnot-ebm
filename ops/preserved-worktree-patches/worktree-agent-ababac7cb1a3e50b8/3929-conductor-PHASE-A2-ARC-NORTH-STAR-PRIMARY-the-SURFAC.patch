+def _precision_at_k(ranks: Sequence[int | None], *, k: int) -> JsonDict:
+    total = len(ranks)
+    hits = sum(1 for rank in ranks if rank is not None and int(rank) < int(k))
+    return {
+        "k": int(k),
+        "hits": int(hits),
+        "total": int(total),
+        "precision": round(float(hits) / float(total), 6) if total else 0.0,
+    }
