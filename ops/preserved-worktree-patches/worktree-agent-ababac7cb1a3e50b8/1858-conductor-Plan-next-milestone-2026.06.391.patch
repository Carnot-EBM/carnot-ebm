+        oracle_at_k:
+          principle: "The positive-control ceiling (any candidate exactly correct) -- if oracle@K ~= vote the null is uninformative (FALSE_NEGATIVE_RISK), not a verifier failure."
+        matched_control_delta:
+          principle: "verifier@1 minus the budget-matched no-verifier control -- isolates the verifier's contribution from the candidate budget (arXiv:2511.02886)."
+        verifier_is_oracle:
