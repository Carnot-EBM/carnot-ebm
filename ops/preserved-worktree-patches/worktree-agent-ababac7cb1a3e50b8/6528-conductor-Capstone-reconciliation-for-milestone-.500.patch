+    _modification_status,
+    path_sha256,
+    payload_checksum,
+    read_json_mapping,
+    write_json,
+)
+
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+RESULT_RELATIVE_PATH = Path("results/experiment_5522_capstone_v500.json")
