+        proxy_artifact=_proxy(
+            first_win_rate=0.12,
+            ci_low=0.02,
+            ci_high=0.14,
+            attempts=125,
+            multi_level_rate=0.08,
+        ),
+        replay_floor=_floor(ready=True),
