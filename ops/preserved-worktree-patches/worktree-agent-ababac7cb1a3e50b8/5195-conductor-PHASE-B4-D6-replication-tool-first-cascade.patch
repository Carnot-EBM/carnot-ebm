+    artifact: JsonDict = {
+        "schema": SCHEMA,
+        "experiment": EXPERIMENT_NAME,
+        "experiment_id": EXPERIMENT_ID,
+        "spec_refs": list(SPEC_REFS),
+        "result_path": artifact_path.as_posix(),
+        "honest_verdict": honest_verdict,
