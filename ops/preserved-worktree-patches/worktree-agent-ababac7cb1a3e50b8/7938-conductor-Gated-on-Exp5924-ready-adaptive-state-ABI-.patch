+            mod.validate_artifact(broken)
+    bad_substrate = deepcopy(artifact)
+    bad_substrate["inference_substrate"] = "live_llm"
+    with pytest.raises(ValueError, match="inference_substrate"):
+        mod.validate_artifact(bad_substrate)
