+def _base_state(active_capacity: int, quarantine_capacity: int) -> JsonDict:
+    return {
+        "abi_version": ABI_VERSION,
+        "active": [],
+        "active_capacity": active_capacity,
+        "capacity_evictions": [],
+        "quarantine": [],
+        "quarantine_capacity": quarantine_capacity,
+        "rejected": [],
+        "schema": STATE_SCHEMA,
+        "superseded": [],
+        "transactions": {},
+        "version": 0,
+    }
+
