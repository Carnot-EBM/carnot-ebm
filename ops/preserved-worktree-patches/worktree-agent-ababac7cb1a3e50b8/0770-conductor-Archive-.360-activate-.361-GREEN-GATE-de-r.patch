+@dataclass(frozen=True)
+class CommandResult:
+    """Captured subprocess output for one required command."""
+
+    command: list[str]
+    exit_code: int
+    stdout: str
+    stderr: str
+
+
+def yaml_single_quote(value: str) -> str:
+    """Render a YAML single-quoted scalar."""
+
