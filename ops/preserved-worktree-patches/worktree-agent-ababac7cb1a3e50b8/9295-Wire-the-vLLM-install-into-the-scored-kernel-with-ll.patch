From c11247b3391a938001d3fbbe62eb3b2f772b1f3b Mon Sep 17 00:00:00 2001
From: Ian Blenke <ian@blenke.com>
Date: Tue, 18 Aug 2026 16:11:02 -0400
Subject: [PATCH 09295/11362] Wire the vLLM install into the scored kernel,
 with llama.cpp as the fallback

Three fixes the backend needed before a save-run could mean anything.

INSTALL. The wheels dataset was attached but nothing installed it, so the
backend would have selected vLLM and then failed to import it. Offline
--no-index install from the attached closure, measured at 108 s.

FALLBACK RATHER THAN FAILURE. If the install fails or the wheels are missing,
the kernel unsets the backend env and continues on llama.cpp, which is fully
attached and functional. A throughput regression is an acceptable outcome for a
scored run; a half-installed generator is not.

WRONG BINARY DATASET. The metadata still named carnot-llamacpp-blackwell-nvfp4,
the CUDA-13 build that died on this image with a glibc symbol mismatch
(GLIBC_2.38/GLIBCXX_3.4.32 against the image's 2.34/3.4.30). Replaced with
carnot-llamacpp-kaggle-blackwell, the container-built one verified against that
floor and proven working in kernel v22. Had the vLLM path failed over, it would
have fallen back to a binary that cannot start.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JntPrUGLNesPcJH1pyfFYw
---
 .../submission_kernel/kernel-metadata.json    |  6 ++--
 scripts/kaggle/submission_kernel/main.py      | 30 ++++++++++++++++++-
 2 files changed, 33 insertions(+), 3 deletions(-)

diff --git a/scripts/kaggle/submission_kernel/kernel-metadata.json b/scripts/kaggle/submission_kernel/kernel-metadata.json
index 50f0e49daf..ace6a503bd 100644
--- a/scripts/kaggle/submission_kernel/kernel-metadata.json
+++ b/scripts/kaggle/submission_kernel/kernel-metadata.json
@@ -10,8 +10,10 @@
   "enable_internet": false,
   "dataset_sources": [
     "iancblenke/carnot-agent-code",
-    "iancblenke/carnot-llamacpp-blackwell-nvfp4",
-    "iancblenke/carnot-qwen38-27b-nvfp4-mtp"
+    "iancblenke/carnot-llamacpp-kaggle-blackwell",
+    "iancblenke/carnot-qwen38-27b-nvfp4-mtp",
+    "iancblenke/carnot-vllm-wheels-py312",
+    "iancblenke/carnot-qwen38-27b-nvfp4-safetensors"
   ],
   "competition_sources": [
     "arc-prize-2026-arc-agi-3"
diff --git a/scripts/kaggle/submission_kernel/main.py b/scripts/kaggle/submission_kernel/main.py
index 7b6847e7f7..a50e196970 100644
--- a/scripts/kaggle/submission_kernel/main.py
+++ b/scripts/kaggle/submission_kernel/main.py
@@ -290,7 +290,35 @@ if _vllm_cfg is not None:
                 (_ldl / _n).symlink_to(_src)
         os.environ["LIBRARY_PATH"] = f"{_ldl}:{_cu}/lib:" + os.environ.get("LIBRARY_PATH", "")
         os.environ["LD_LIBRARY_PATH"] = f"{_cu}/lib:" + os.environ.get("LD_LIBRARY_PATH", "")
-    print(f"LLM BACKEND: vllm (model={_vllm_cfg.parent}, cuda_home={_cu})", flush=True)
+    # OFFLINE INSTALL. enable_internet is false, so vLLM comes from the attached wheel closure
+    # (196 wheels, measured 108 s). Resolved in a glibc-2.31 container against python 3.12 so
+    # every wheel is compatible with this image; --no-index makes a missing wheel fail loudly
+    # here rather than silently reaching for PyPI.
+    _whl = next(iter(inp.rglob("vllm-*.whl")), None)
+    if _whl is not None:
+        _t0 = time.time()
+        _pip = subprocess.run(
+            [sys.executable, "-m", "pip", "install", "--no-index",
+             f"--find-links={_whl.parent}", "vllm"],
+            capture_output=True, text=True, timeout=3600,
+        )
+        print(f"LLM BACKEND: vllm pip install rc={_pip.returncode} in {time.time()-_t0:.0f}s",
+              flush=True)
+        if _pip.returncode != 0:
+            # Fall back to llama.cpp rather than proceeding with a half-installed backend: the
+            # GGUF path below is fully functional and attached, so a failed install costs
+            # throughput, not the run.
+            print(f"LLM BACKEND: vllm install FAILED, falling back to llama.cpp\n"
+                  f"{_pip.stderr[-1500:]}", flush=True)
+            os.environ.pop("CARNOT_ARC_LLM_BACKEND", None)
+            os.environ.pop("CARNOT_ARC_VLLM_MODEL_DIR", None)
+    else:
+        print("LLM BACKEND: vllm selected but NO WHEELS attached; falling back to llama.cpp",
+              flush=True)
+        os.environ.pop("CARNOT_ARC_LLM_BACKEND", None)
+        os.environ.pop("CARNOT_ARC_VLLM_MODEL_DIR", None)
+    if os.environ.get("CARNOT_ARC_LLM_BACKEND") == "vllm":
+        print(f"LLM BACKEND: vllm (model={_vllm_cfg.parent}, cuda_home={_cu})", flush=True)
 else:
     print("LLM BACKEND: llama.cpp (no safetensors model dir attached)", flush=True)
 
