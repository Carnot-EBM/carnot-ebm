+        except Exception:
+            return 1000.0
+        stats["verifier_calls"] = int(stats["verifier_calls"]) + 1
+        stats["counterexample_rounds"] = max(
+            int(stats["counterexample_rounds"]),
+            int(result.get("counterexample_rounds") or 0),
