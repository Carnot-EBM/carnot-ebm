+def _load_roadmap(repo_root: Path) -> JsonDict:
+    import yaml
+
+    value = yaml.safe_load((repo_root / "research-roadmap.yaml").read_text(encoding="utf-8"))
+    return dict(value) if isinstance(value, Mapping) else {}
+
