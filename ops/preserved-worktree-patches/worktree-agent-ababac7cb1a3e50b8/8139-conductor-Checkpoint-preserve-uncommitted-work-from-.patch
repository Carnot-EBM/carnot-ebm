+            new_grid[28:32, 48:52] = 1
+            new_grid[24:28, 48:52] = 0
+        elif np.all(new_grid[24:28, 48:52] == 0):
+            new_grid[24:28, 48:52] = 1
+            new_grid[28:32, 48:52] = 0
+
+    elif action == 3:
+        # ACTION 3 changes colors of a region around row 24-27, col 44-49.
