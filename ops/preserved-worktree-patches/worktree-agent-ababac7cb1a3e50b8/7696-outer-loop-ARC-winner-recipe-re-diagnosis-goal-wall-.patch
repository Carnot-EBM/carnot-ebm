+def _has_unsafe(payload: JsonMap) -> bool:
+    for key in ("unsafe_accept_count", "unsafe_transfer_count"):
+        value = payload.get(key)
+        if isinstance(value, int | float) and value > 0:
+            return True
+    return False
+
