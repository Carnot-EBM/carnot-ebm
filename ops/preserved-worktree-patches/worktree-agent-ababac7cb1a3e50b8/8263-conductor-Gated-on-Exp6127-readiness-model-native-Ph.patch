+def reproducibility_checksum(artifact: Mapping[str, Any]) -> str:
+    stable = {
+        field: artifact.get(field)
+        for field in REQUIRED_ARTIFACT_FIELDS
+        if field
+        not in {
+            "duration_s",
+            "test_exit_codes",
+            "status",
+            "honest_verdict",
+            "reproducibility_checksum",
+        }
+    }
+    return sha256_json(stable)
