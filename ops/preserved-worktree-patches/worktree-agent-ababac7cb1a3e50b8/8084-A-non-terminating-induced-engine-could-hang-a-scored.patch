+    try:
+        payload = json.loads((proc.stdout or "").strip().splitlines()[-1])
+        return [_defect_from_dict(d) for d in payload["defects"]]
+    except Exception:  # noqa: BLE001 - unreadable result; do not guess a verdict
+        return None
