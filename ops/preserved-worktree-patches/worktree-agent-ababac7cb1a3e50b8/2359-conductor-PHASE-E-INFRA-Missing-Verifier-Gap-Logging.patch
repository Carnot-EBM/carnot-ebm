+        "failure_mode": str(upstream.get("failure_mode", "")),
+        "missing_discriminator": str(upstream.get("missing_discriminator", "")),
+        "candidate_design": str(upstream.get("candidate_design", "")),
+        "priority": str(upstream.get("priority", "high")),
+    }
