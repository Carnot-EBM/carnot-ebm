+        f"{_int(close_state.get('generic_loo_solve_count_v3'))}_levels_"
+        f"{_int(close_state.get('reproducible_total_levels'))}_games_"
+        f"{_int(close_state.get('reproducible_total_games'))}_zero_new_levels_open_gaps_3"
+    )
