+def _isolated_subprocess_env() -> dict[str, str]:
+    """Keep coverage control in the parent while preserving the runtime environment."""
+
+    return {
+        key: value
+        for key, value in os.environ.items()
+        if not key.startswith(("COV_CORE_", "COVERAGE_"))
+    }
