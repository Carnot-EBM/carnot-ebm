+def build_item_bank() -> list[BankCase]:
+    """Return the frozen 120-case CCTU-style bank."""
+
+    cases: list[BankCase] = []
+    for category in REQUIRED_TAXONOMY:
+        for index in range(15):
+            cases.append(_build_case(category, index))
+    return cases
