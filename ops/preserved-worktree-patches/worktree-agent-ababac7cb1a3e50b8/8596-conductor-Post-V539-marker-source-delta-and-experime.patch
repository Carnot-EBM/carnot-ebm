+    missing = deepcopy(report)
+    del missing["status"]
+    assert "missing:status" in mod.validate_report(missing)
+
+    for field, value, error in (
+        ("inference_substrate", "wrong", "inference_substrate"),
+        ("verifier_is_oracle", True, "verifier_is_oracle"),
