From 614c69522d94d92014a67c19ddc990c2f62bcdc0 Mon Sep 17 00:00:00 2001
From: Ian Blenke <ian@blenke.com>
Date: Fri, 19 Jun 2026 22:38:59 -0400
Subject: [PATCH 02953/11362] [outer-loop] variant probe: lower budget
 3000->1200 so the overnight sweep covers all 16 games (lf52 0/3 at 3000
 showed budget isn't the limiter)

---
 scripts/arc_variant_transfer_probe.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/scripts/arc_variant_transfer_probe.py b/scripts/arc_variant_transfer_probe.py
index 19f7b353dd..94f98b27a8 100644
--- a/scripts/arc_variant_transfer_probe.py
+++ b/scripts/arc_variant_transfer_probe.py
@@ -41,7 +41,7 @@ def main() -> int:
                 t = time.time()
                 # bounded so the overnight sweep finishes; a solve within this budget == EASILY re-derived
                 # (robust), a no-solve == the variant is harder for the generic solver (layout-sensitive).
-                traj, lvl = graph_explore_solve_v2(env, 0, max_expansions=3000, max_depth=40)
+                traj, lvl = graph_explore_solve_v2(env, 0, max_expansions=1200, max_depth=30)
                 res[label] = {"solved": bool(traj and lvl >= 1), "level": int(lvl),
                               "moves": len(traj) if traj else 0, "s": round(time.time() - t, 1)}
             except Exception as e:
