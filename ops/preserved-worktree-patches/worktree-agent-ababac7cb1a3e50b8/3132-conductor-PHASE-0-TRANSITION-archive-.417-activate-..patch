+        "median_actions_baseline": 7760.0,
+        "median_actions_best_lever": {
+            "lever": "none_clean_equal_solve_rate",
+            "median_actions": 7760.0,
+            "reason": "no_clean_lever_beat_7760_at_equal_or_better_solve_rate",
+        },
+        "per_lever_scorecard": [
