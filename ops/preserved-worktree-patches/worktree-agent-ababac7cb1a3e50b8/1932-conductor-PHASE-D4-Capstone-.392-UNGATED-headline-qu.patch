+def diffusiongemma_resolvable(arc_gate: Mapping[str, Any], code: Mapping[str, Any]) -> bool:
+    return bool(arc_gate.get("oracle_distinct_beats_vote")) or bool(
+        code.get("code_oracle_distinct_beats_vote")
+    )
+
