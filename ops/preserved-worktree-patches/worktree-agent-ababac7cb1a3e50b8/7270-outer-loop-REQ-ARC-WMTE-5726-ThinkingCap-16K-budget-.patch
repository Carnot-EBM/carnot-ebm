+def log(m: str) -> None:
+    print(f"[{time.strftime('%H:%M:%S')}] {m}", flush=True)
+
+
+def _gpu_mem_used_mib(idx: int) -> Optional[int]:
+    try:
+        out = subprocess.run(
+            [
+                "nvidia-smi",
+                "--query-gpu=memory.used",
+                "--format=csv,noheader,nounits",
+                "-i",
+                str(idx),
+            ],
+            capture_output=True,
+            text=True,
+            timeout=15,
+        )
+        return int(out.stdout.strip().splitlines()[0])
+    except Exception:
+        return None
