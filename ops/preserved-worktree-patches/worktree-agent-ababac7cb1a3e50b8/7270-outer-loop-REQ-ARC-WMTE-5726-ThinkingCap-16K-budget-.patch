+        try:
+            _wm.unlink()
+        except FileNotFoundError:
+            pass
+        induce_ok, induce_detail = _induce_no_fence(prop, game, list(window), int(cell))
+        try:
+            engine, is_done = load_engine(game)
+        except Exception as exc:
