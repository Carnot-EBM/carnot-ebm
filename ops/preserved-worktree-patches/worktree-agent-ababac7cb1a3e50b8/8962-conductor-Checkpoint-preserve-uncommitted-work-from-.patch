+++ b/ops/conductor-heartbeat.json
@@ -1 +1 @@
-{"pid": 920825, "iteration": 34, "phase": "iteration_start", "last_beat": "2026-08-12T22:49:15Z"}
\ No newline at end of file
+{"pid": 1288573, "iteration": 1, "phase": "iteration_start", "last_beat": "2026-08-12T23:37:55Z"}
\ No newline at end of file
diff --git a/ops/conductor-state.json b/ops/conductor-state.json
index 88ddd5fcc3..fb9f7491df 100644
--- a/ops/conductor-state.json
+++ b/ops/conductor-state.json
@@ -1 +1 @@
-{"pid": 920825, "iteration": 34, "phase": "iteration_start", "started_at": "2026-08-12T22:49:15Z"}
\ No newline at end of file
+{"pid": 1288573, "iteration": 1, "phase": "iteration_start", "started_at": "2026-08-12T23:37:55Z"}
\ No newline at end of file
