+def build_blocked_artifact(
+    reason: str,
+    *,
+    facts_route_retired: bool,
+    exclusion_manifest_parses: bool,
+    research_complete_yaml_parses: bool,
+    core_pretest_green: bool,
+    live_model_modules_importable: bool,
