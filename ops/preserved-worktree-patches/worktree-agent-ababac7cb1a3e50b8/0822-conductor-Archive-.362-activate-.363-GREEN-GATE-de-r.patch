+    summary_result: CommandResult | None,
+    core_pretest_result: CommandResult | None,
+    live_model_import_result: CommandResult | None,
+) -> JsonDict:
+    payload: JsonDict = {
+        "schema": "carnot.archive_activation.v362_to_v363_3924.v1",
+        "experiment_id": "exp3924",
+        "task_id": "exp3924-archive-v362-activate-v363-retire-facts",
