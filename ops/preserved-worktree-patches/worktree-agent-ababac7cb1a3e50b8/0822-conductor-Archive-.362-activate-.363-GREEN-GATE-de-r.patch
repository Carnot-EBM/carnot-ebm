+
+def append_exclusion_manifest_record(text: str) -> str:
+    """Append the facts retirement entry once while preserving manifest shape."""
+
+    if RETIREMENT_MARKER in text:
+        return text
+    entry = build_exclusion_manifest_entry()
+    if "retired_experiments:" not in text:
+        return f"{text.rstrip()}\n\nretired_experiments:\n{entry}"
+    return f"{text.rstrip()}\n{entry}"
+
+
+def facts_route_retired_in_manifest(text: str) -> bool:
+    """Return true when the manifest contains the required facts retirement entry."""
+
+    return (
+        RETIREMENT_MARKER in text
+        and "experiment_id: 3920" in text
+        and "exp3862/exp3886/exp3896/exp3920" in text
+        and "retire_if_same_verdict" in text
+    )
+
+
+def build_research_complete_block(
+    task_verdicts: Mapping[str, str],
+    comparator_flaw: str,
+) -> str:
+    """Build the append-only `.362` archive record."""
+
+    finding = (
+        ".362 recovered the .361 infra wash and landed the offline proof record: "
+        "exp3916 made the accuracy axis genuine with MOAT_SURVIVES, but exp3917 "
+        "used a below-chance LLM judge and therefore made the efficiency verdict "
+        "a strawman; exp3918 had escalation_fraction=0.0, exp3920 blocked and "
+        "flagged the fourth facts attempt, and exp3922 was flagged at duration_s=0.0."
+    )
+    lines = [
+        f"- id: {ARCHIVED_MILESTONE}",
+        f"  {ARCHIVE_MARKER}",
+        f"  title: {yaml_single_quote('Archive .362 and activate .363 with facts route retirement')}",
+        "  doc: openspec/change-proposals/research-roadmap-vNEXT.md",
+        "  completed: '2026-06-07'",
+        f"  finding: {yaml_single_quote(finding)}",
+        "  activation_recorded: exp3924-archive-v362-activate-v363-retire-facts",
+        "  facts_route_retired: true",
+        f"  retired_scope: {yaml_single_quote(RETIREMENT_SCOPE)}",
+        f"  n362_comparator_flaw_recorded: {yaml_single_quote(comparator_flaw)}",
+        "  tasks:",
+    ]
+    for task in V362_TASKS:
+        task_id = str(task["id"])
+        result = task_verdicts.get(task_id, "missing")
+        lines.extend(
+            [
+                f"  - id: {task_id}",
+                f"    title: {yaml_single_quote(str(task['title']))}",
+                f"    deliverable: {task['deliverable']}",
+                f"    result: {yaml_single_quote(result)}",
+            ]
+        )
+    return "\n".join(lines) + "\n"
+
+
+def append_research_complete_record(
+    text: str,
+    task_verdicts: Mapping[str, str],
+    comparator_flaw: str,
+) -> str:
+    """Append the `.362` archive record once, preserving existing content."""
+
+    if ARCHIVE_MARKER in text:
+        return text
+    return f"{text.rstrip()}\n{build_research_complete_block(task_verdicts, comparator_flaw)}"
+
+
+def terminal_verdict() -> str:
+    """Return the complete-path verdict."""
+
+    return "complete: archived_v362_v363_active_facts_retired_comparator_flaw_recorded_green_gates"
+
