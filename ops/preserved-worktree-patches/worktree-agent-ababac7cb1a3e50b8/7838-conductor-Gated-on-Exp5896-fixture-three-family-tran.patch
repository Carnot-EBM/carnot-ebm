+        hf_id = str(attempt.get("hf_id"))
+        if hf_id in MANDATED_MODEL_IDS and attempt.get("model_used") and not attempt.get("blocker"):
+            if hf_id not in seen:
+                seen.append(hf_id)
+    return seen
