+def ensure_gap_logged(repo: Path, artifact: Mapping[str, Any]) -> None:
+    """REQ-LEARN-4370-7: append unreduced held-out levels to the gap ledger."""
+
+    gaps = artifact.get("missing_verifier_gaps")
