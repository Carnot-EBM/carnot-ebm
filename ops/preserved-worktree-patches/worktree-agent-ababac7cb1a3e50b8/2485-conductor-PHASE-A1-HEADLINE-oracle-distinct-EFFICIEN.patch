+    assert exp.GAP_ID in gap_text
+    assert "alpha:L1" in gap_text
+    exp.ensure_gap_logged(tmp_path, null_artifact)
+    assert (tmp_path / "ops" / "verifier_gaps.md").read_text(encoding="utf-8") == gap_text
