+                f'milestone_doc: "{mod.NEXT_MILESTONE_DOC}"',
+                "tasks:",
+                "  - id: exp5083-phase0-archive-466-activate-467",
+                f"    deliverable: {mod.RESULT_RELATIVE_PATH}",
+                "",
+            ]
+        ),
