+        {
+            "attack_id": "favorable_block_selection",
+            "expected": list(BLOCK_SIZES),
+            "observed": sorted({int(row["block_size"]) for row in partition_rows}),
+            "passed": sorted({int(row["block_size"]) for row in partition_rows})
+            == list(BLOCK_SIZES),
