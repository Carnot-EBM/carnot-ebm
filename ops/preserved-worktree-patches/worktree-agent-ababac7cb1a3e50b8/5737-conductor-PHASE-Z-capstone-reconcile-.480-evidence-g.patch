+        "arc_patch": "retire_current_provenance_patch_after_clean_zero_delta",
+        "kan_certificate": _kan_status(payloads[5254]),
+        "hardware": "kv260=reachable polarfire=reachable gatemate=blocked_physical_jtag no_speedup_claim",
