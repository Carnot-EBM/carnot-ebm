+def test_scenario_report_6185_acceptance_requires_date_authority_and_mapping(
+    tmp_path: Path,
+) -> None:
+    """SCENARIO-REPORT-6185-BOUNDED-DATED-SOURCE: accepted rows are bounded."""
+
+    root = _make_repo(tmp_path, _references())
+    artifact = mod.build_and_write_artifact(
+        root=root,
+        search_started_at=START,
+        search_finished_at=FINISH,
+        accepted_candidates=[_accepted_fixture()],
