+def test_req_report_6185_spec_declares_exact_marker_contract() -> None:
+    """REQ-REPORT-6185: OpenSpec names the V536 ingestion contract."""
+
+    spec = SPEC_PATH.read_text(encoding="utf-8")
+    section = spec[spec.index("### REQ-REPORT-6185") :]
+
+    for marker in (
+        "REQ-REPORT-6185",
+        "SCENARIO-REPORT-6185-EXACT-MARKER",
+        "SCENARIO-REPORT-6185-BOUNDED-DATED-SOURCE",
+        "SCENARIO-REPORT-6185-DEDUPLICATE-AND-GUARD-SCOPE",
+        "SCENARIO-REPORT-6185-ZERO-DELTA",
+        "SCENARIO-REPORT-6185-SCHEMA",
+        "V536-PLANNER-REFRESH-20260807-END",
+        str(mod.RESULT_RELATIVE_PATH),
+        mod.INFERENCE_SUBSTRATE,
+    ):
+        assert marker in section
+    for field in mod.REQUIRED_ARTIFACT_FIELDS:
+        assert f"`{field}`" in section
+
