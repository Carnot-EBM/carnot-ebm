+#!/usr/bin/env python3
+"""Run the task-owned Exp6826 sealed adoption synthesis."""
+
+from carnot.experiment_6826_selective_arbiter_sealed_adoption import main
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
