+    cold_all = cold_all if isinstance(cold_all, list) else []
+    cold_rows = _cold_rows(sources.get("exp6824", {}))
+    cold_audits = [
+        row
+        for row in cold_all
+        if isinstance(row, dict) and row.get("row_type") == "row_fault_audit"
+    ]
