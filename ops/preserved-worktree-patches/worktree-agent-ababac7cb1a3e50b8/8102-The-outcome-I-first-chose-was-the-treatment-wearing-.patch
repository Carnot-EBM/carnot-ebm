diff --git a/results/arc_goal_defect_reask_ab_20260801/pre/circularity_gap.json b/results/arc_goal_defect_reask_ab_20260801/pre/circularity_gap.json
new file mode 100644
index 0000000000..ad4f871401
--- /dev/null
+++ b/results/arc_goal_defect_reask_ab_20260801/pre/circularity_gap.json
@@ -0,0 +1,11 @@
+{
+ "what_this_is": "the size of the generalization gap between the treatment's probe set (SHOWN frames) and the primary outcome's scoring set (HELD-OUT frames), measured on the 115 frozen engines rather than asserted.",
+ "n": 115,
+ "constant_on_both": 103,
+ "constant_on_shown_only": 6,
+ "constant_on_heldout_only": 0,
+ "constant_on_neither": 6,
+ "agreement_rate": 0.9478,
+ "disagreement_rate": 0.0522,
+ "reading": "`constant_on_shown_only` is the slice where the gate REJECTS a predicate that would have scored positively on the primary -- the false-positive cost, arising purely because the two frame sets differ. `constant_on_heldout_only` is the reverse: the gate keeps a predicate the primary then scores as a failure. Both are non-zero, which is what makes the primary something the treatment does not mechanically determine. But the agreement rate is high, so the primary and the treatment are strongly correlated and the primary must NOT be presented as an independent construct. It is a generalization test with a thin gap, and the thinness is quantified here rather than glossed."
+}
\ No newline at end of file
diff --git a/results/arc_goal_defect_reask_ab_20260801/pre/detector_coverage.json b/results/arc_goal_defect_reask_ab_20260801/pre/detector_coverage.json
new file mode 100644
index 0000000000..3c7409f322
--- /dev/null
+++ b/results/arc_goal_defect_reask_ab_20260801/pre/detector_coverage.json
@@ -0,0 +1,23 @@
+{
+ "what_this_is": "OBSERVATIONAL detector coverage over 115 frozen engines. It measures what the accept check would REJECT, not whether the re-ask then helps.",
+ "n_scored": 115,
+ "n_would_be_rejected": 109,
+ "rejection_rate": 0.9478,
+ "defect_kinds": {
+  "goal_constant": 109,
+  "goal_missing_return": 3,
+  "goal_raises": 1
+ },
+ "inert_when_flag_off": 0,
+ "cross_tab_vs_primary_outcome": {
+  "rejected_and_non_discriminating_TP": 103,
+  "rejected_but_discriminating_FP": 6,
+  "kept_and_non_discriminating_FN": 0,
+  "kept_and_discriminating_TN": 6,
+  "reading": "FP is the cost that matters: a predicate the gate throws away even though it DID discriminate on held-out frames. Each FP is one wasted sample, bounded, and the re-ask can only replace it -- but a large FP count would mean the gate is not selective, it is just re-rolling everything."
+ },
+ "vs_the_syntactic_estimate": {
+  "taxonomy_estimate": "37 of 71 (52%), from A_DECLINED (34) + D_NO_PREDICATE (3)",
+  "why_this_can_differ": "goal_constant is a RUNTIME probe over observed frames, so a whole-board trope (C_UNIFORMITY) or a colour-elimination predicate (B_COLOUR_ELIMINATION) is caught too -- constant for a different reason, but just as uninformative to the search."
+ }
+}
