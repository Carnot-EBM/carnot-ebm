+            {
+                **dict(source),
+                "after_sha256": after,
+                "unchanged": after == source["before_sha256"],
+            }
+        )
+    return {
+        "rows": closed,
+        "all_unchanged": all(row["unchanged"] for row in closed),
+        "model_weight_mutation_count": sum(
+            1 for row in closed if row["name"] == "generator_model_weights" and not row["unchanged"]
+        ),
