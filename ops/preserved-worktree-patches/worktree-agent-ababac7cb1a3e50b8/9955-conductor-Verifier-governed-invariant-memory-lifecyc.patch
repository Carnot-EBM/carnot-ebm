+        "generator_model_weights": generator_model_path,
+    }
+    return [
+        {
+            "name": name,
+            "path": str(path),
+            "before_sha256": sha256_file(path),
+            "size_bytes": path.stat().st_size,
+        }
+        for name, path in paths.items()
+    ]
+
+
+def _close_hash_rows(rows: Sequence[Mapping[str, Any]]) -> JsonDict:
