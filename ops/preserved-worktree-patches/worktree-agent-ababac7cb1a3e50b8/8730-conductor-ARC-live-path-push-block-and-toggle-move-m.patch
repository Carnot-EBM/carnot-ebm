+            "changed_cells": int(np.sum(np.asarray(t.grid) != np.asarray(t.next_grid))),
+        }
+        for t in transitions
+    ]
+    return {
+        "target": "synthetic_push_block_mechanic_canary",
+        "transition_count": len(transitions),
+        "history_sha256": sha256_json(payload),
+        "rows": payload,
+    }
