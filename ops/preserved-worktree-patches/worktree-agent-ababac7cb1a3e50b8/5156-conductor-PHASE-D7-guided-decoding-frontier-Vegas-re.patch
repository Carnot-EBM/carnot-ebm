+        "prompt_hash": _prompt_hash(candidate),
+        "model_id": str(candidate.get("model_id") or ""),
+        "answer": _candidate_answer(candidate),
+    }
+    return "sha256:" + _sha256_text(_json_dumps(basis))
+
+
+def _is_correct(answer: str | None, gold: Any) -> int:
