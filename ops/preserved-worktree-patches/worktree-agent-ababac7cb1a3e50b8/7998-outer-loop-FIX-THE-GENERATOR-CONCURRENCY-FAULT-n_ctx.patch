+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument(
+        "--rows",
+        default=(
+            "results/early_stop_sweep_20260726/rows_exact_attribution.json,"
+            "results/early_stop_sweep_20260726/rows_exact_attribution_b2000.json"
