+
+    # ---- PART D -------------------------------------------------------------------
+    part_d: dict[str, Any] = {"skipped": True}
+    if do_live:
+        part_d = probe_nav_failure_reasons(
+            [
+                ("vc33", 20260724, 2000),
+                ("r11l", 20260724, 2000),
+                ("tu93", 20260724, 2000),
+                ("dc22", 20260724, 2000),
+                ("lp85", 20260724, 2000),
+                ("sc25", 20260724, 2000),
+            ]
+        )
