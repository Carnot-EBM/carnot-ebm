+TEST_PRECONDITION_OVERRIDES = {
+    "planning_date_matches": True,
+    "procedural_memory_stream_ready": True,
+    "six_frozen_orders": True,
+    "exact_model_specs": True,
+    "cached_ggufs_with_hashes": True,
