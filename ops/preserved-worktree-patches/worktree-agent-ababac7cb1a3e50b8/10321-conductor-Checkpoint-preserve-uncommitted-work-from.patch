+def _gate_summary(checks: Mapping[str, bool]) -> JsonDict:
+    failures = [
+        {"check": name, "expected": True, "observed": value}
+        for name, value in checks.items()
+        if value is not True
+    ]
+    return {
+        "checks": dict(checks),
+        "failed_checks": [row["check"] for row in failures],
+        "failures": failures,
+    }
