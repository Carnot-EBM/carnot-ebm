+            prefer_low_recent_action: bool = False,
+        ) -> bool:
+            for candidate in ranked_pool(pool, prefer_low_recent_action=prefer_low_recent_action):
+                if add(candidate, category, allow_failed_signature=allow_failed_signature):
+                    return True
+            return False
