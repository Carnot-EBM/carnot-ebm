+            "lp85",
+            proposer=object(),
+            target_levels=1,
+            value_head=None,
+            candidate_router=None,
+        )
+        assert p._candidate_router_load_diagnostics == {
+            "loaded": False,
+            "caller_supplied": True,
+        }
+
+    def test_caller_supplied_frame_change_scorer_skips_the_loader(self):
+        class FakeScorer:
+            pass
+
+        p = E3AgentPolicy(
+            "lp85",
+            proposer=object(),
+            target_levels=1,
+            value_head=None,
+            frame_change_scorer=FakeScorer(),
