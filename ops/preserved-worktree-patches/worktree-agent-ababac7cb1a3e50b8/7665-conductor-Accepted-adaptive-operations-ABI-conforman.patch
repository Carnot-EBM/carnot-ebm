+        proposer = _FakeProposer(["TOOL: inspect_cell 1 1", "commit now", '{"a":1}]'])
+        _patch(monkeypatch, proposer)
+        seq, transcript = decide_sequence(
+            np.zeros((8, 8), dtype=int), [], [1, 6], proposer, max_turns=4, max_seq=5
