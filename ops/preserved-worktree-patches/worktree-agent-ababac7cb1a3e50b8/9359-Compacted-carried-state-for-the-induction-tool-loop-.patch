+def _carried_messages(payload):
+    """The carried-state user messages inside one request payload."""
+    return [
+        m
+        for m in payload["messages"]
+        if m.get("role") == "user" and compact_mod.CARRIED_STATE_KIND in str(m.get("content"))
+    ]
