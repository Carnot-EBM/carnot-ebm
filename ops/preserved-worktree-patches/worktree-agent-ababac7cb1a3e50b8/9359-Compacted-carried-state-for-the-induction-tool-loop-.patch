+    assert state["candidates"][0]["idx"] == 0
+    assert state["candidates"][0]["code_sha8"] == compact_mod.code_sha8(IDENTITY_CODE)
+    assert state["best"]["code"] == IDENTITY_CODE  # the seed floor, verbatim
