+def _empty_leak_recheck() -> dict[str, Any]:
+    return {
+        "status": "not_run",
+        "fresh_heldout_n": 0,
+        "unmasked_auroc": 0.0,
+        "answer_masked_auroc": 0.0,
+        "scorer_leak_recheck_passed": False,
