+        "status": "not_run",
+        "benchmark_n": 0,
+        "condition_accuracy": {},
+        "condition_pass_counts": {},
+        "best_control": "",
+        "carnot_minus_best_control_delta": 0.0,
+        "adaptive_ci95": [0.0, 0.0],
+        "adaptive_guidance_beats_control": False,
+        "bootstrap_resamples": DEFAULT_BOOTSTRAP_RESAMPLES,
+    }
