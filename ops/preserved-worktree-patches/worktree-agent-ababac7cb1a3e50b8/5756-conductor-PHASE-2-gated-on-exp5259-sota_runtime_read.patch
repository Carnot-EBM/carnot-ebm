+def render_prompt(fixture: HallucinationFixture) -> str:
+    """Render the local verdict prompt without exposing the fixture label."""
+
+    return (
+        "Use only the evidence below. Reply with exactly SUPPORTED or UNSUPPORTED.\n\n"
