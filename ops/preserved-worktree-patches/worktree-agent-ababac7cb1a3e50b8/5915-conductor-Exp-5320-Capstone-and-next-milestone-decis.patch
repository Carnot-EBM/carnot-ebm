+
+EXPECTED_ARTIFACTS = (
+    EXP5307,
+    EXP5308,
+    EXP5309,
+    EXP5310,
+    EXP5311,
+    EXP5312,
+    EXP5313,
+    EXP5314,
+    EXP5315,
+    EXP5316,
+    EXP5317,
+    EXP5318,
+    EXP5319,
+)
