+TERMINAL_PREFIXES = ("complete:", "blocked_")
+
+SPEC_REFS = (
+    "REQ-CAPSTONE-5320",
+    "SCENARIO-CAPSTONE-5320",
+    "SCENARIO-CAPSTONE-5320-BLOCKED-MISSING-INPUT",
