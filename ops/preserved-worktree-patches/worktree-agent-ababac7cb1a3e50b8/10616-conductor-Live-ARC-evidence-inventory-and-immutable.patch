+                    "policy": None,
+                    "supervisor_state": "unobserved",
+                    "tool_loop_state": "off_or_unobserved",
+                },
+                "read_only_commands": exp.READ_ONLY_PROCESS_COMMANDS,
+                "observation_role": "in_flight_process",
+            }
+        ],
+    )
+
