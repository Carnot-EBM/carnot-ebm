-                if (Path(b) / "nvidia" / "cu13" / "bin" / "nvcc").exists()), None)
-    if _cu is not None:
-        os.environ["CUDA_HOME"] = os.environ["CUDA_PATH"] = str(_cu)
-        os.environ["PATH"] = f"{_cu}/bin:" + os.environ.get("PATH", "")
