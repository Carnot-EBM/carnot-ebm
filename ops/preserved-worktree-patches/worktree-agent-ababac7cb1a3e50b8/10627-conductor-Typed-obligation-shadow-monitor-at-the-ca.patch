+
+    monkeypatch.delenv("CARNOT_ARC_TYPED_OBLIGATION_SHADOW_MONITOR", raising=False)
+    policy = E3AgentPolicy("lp85", proposer=object(), target_levels=2, value_head=None)
+    move = (6, {"x": 1, "y": 2})
+
+    assert policy._typed_arc_shadow_monitor is None
