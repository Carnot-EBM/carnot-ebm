+    return {
+        "event_id": event.event_id,
+        "outcome_hash": event.outcome_hash,
+        "accepted": event.accepted,
+        "python_z3_agree": event.verifier_agrees,
+        "verifier_backend": "exp6145_python_z3_exact_sidecar",
+        "verified_after_outcome": True,
+    }
