From: Ian Blenke <ian@blenke.com>
Date: Sun, 23 Aug 2026 10:15:14 -0400
Subject: [PATCH 09679/11362] [conductor] Checkpoint: preserve uncommitted work
 (self-heal failed)

Co-Authored-By: Codex CLI <noreply@openai.com>
---
 python/carnot/pipeline/gpu_zombie_killer.py | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/python/carnot/pipeline/gpu_zombie_killer.py b/python/carnot/pipeline/gpu_zombie_killer.py
index a28fa61daa..ded6ebbae1 100644
--- a/python/carnot/pipeline/gpu_zombie_killer.py
+++ b/python/carnot/pipeline/gpu_zombie_killer.py
@@ -297,6 +297,15 @@ def kill_gpu_zombies(
     for pid in result.pids_found:
         if pid in effective_excludes:
             continue
+        if _pid_is_protected_server(pid):
+            result.pids_skipped_protected.append(pid)
+            _log.info(
+                "kill_gpu_zombies: SKIP protected server PID %d (gpu=%d) — "
+                "REQ-INFRA-079; a live server is not a zombie",
+                pid,
+                gpu_index,
+            )
+            continue
         kill_targets.append(pid)
     result.kill_attempted = bool(kill_targets)
 
