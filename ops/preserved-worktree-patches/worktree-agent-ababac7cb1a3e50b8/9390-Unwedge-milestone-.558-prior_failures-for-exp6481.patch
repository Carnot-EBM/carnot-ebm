+++ b/research-roadmap-next.yaml
@@ -107,6 +107,32 @@ tasks:
       Do NOT push. Do NOT modify scripts/research_conductor.py.
 
   - id: exp6481-monotonic-phase-concurrency-receipt-contract
+    prior_failures:
+      - experiment_id: exp6437-generation-to-verdict-receipt-replay-contract
+        verdict: blocked_gate_check_failed
