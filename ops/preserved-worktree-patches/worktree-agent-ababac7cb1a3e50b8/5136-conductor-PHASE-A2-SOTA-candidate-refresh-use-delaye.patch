+GATE_STATE_RELATIVE_PATH = "results/experiment_5057_gate_state_preflight_v465.json"
+FROZEN_CANDIDATE_CACHE_RELATIVE_PATH = (
+    "results/experiment_5029_shared_logprob_candidate_cache_v2_musr.jsonl"
+)
