+        artifact_path=tmp_path / mod.RESULT_RELATIVE_PATH,
+        cache_path=tmp_path / mod.CACHE_RELATIVE_PATH,
+        gate_state={},
+        duration_s=0.0,
+        reason="sota_models_unavailable",
