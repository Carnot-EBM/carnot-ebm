+        return "disqualified"
+    classes = (
+        "circular_positive",
+        "disqualified",
+        "blocked",
+        "partial",
+        "positive",
+        "null",
+    )
+    for klass in classes:
+        if text.startswith((f"{klass}_", f"{klass}:")):
+            return klass
+        if re.match(rf"^(?:complete|success|passed|shipped)[ :_]+{klass}(?:[ :_]|$)", text):
+            return klass
+    return None
+
