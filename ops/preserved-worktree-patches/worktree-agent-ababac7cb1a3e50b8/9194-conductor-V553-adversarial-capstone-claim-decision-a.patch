+def _gate_states(payload: Mapping[str, Any]) -> JsonDict:
+    gates: JsonDict = {}
+    for key, value in payload.items():
+        if key.endswith("_ready_score") or key.endswith("_claim_eligibility"):
+            gates[key] = value
+    if "status" in payload:
+        gates["status"] = payload.get("status")
+    return gates
