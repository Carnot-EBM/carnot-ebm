+def test_req_arc_wmte_4781_bounded_result_and_validation_edges() -> None:
+    """REQ-ARC-WMTE-4781: failed gates and malformed artifacts fail closed."""
+
+    seeds = list(range(4781, 4791))
+    metrics = mod.evaluate_dataset(
+        _fixture_dataset(),
