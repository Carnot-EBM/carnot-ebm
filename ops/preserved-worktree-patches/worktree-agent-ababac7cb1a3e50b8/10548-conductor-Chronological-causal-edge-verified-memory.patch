+    assert revise["effect"]["revision"] == 2
+    assert deleted["inverse"]["kind"] == "restore"
+    assert restored["inverse"]["kind"] == "soft_delete"
+    for receipt in (add, retrieve, filtered, revise, deleted, restored):
