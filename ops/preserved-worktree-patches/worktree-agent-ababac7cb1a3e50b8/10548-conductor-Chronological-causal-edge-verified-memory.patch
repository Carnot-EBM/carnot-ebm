+            "a",
+            expected_revision=2,
+        )
+    )
+    restored = memory.apply(
+        _operation(
+            "op7",
+            stream.OperationKind.RESTORE,
+            "a",
+            expected_revision=3,
+            authority=stream.RESTORE_AUTHORITY,
+        )
+    )
