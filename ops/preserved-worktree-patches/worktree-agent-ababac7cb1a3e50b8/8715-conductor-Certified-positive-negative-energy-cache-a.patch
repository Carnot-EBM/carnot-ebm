+
+def _paper_receipts() -> JsonDict:
+    return {
+        "local_reference_path": "research-references.md",
+        "local_reference_sha256": sha256_file(REPO_ROOT / "research-references.md"),
+        "mechanisms": {
+            "eb_cap": {
