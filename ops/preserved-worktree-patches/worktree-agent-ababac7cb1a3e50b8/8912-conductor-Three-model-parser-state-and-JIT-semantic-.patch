+        for arm_index, arm in enumerate(ARMS):
+            seed = RANDOM_SEEDS[model_index % len(RANDOM_SEEDS)] + (arm_index * 100)
+            path = raw_dir / f"{model_slug(model_id)}.{arm}.raw.json"
+            raw_paths[model_id][arm] = {
