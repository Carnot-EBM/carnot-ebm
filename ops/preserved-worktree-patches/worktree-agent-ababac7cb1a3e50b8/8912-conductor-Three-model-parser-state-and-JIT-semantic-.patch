+
+    fixture_payload = [
+        {
+            "family": fixture.family,
+            "split": fixture.split,
+            "contract": fixture.contract,
+            "fallback_sha256": "sha256:" + exp6326.sha256_text(fixture.fallback_program),
+        }
+        for fixture in fixtures
