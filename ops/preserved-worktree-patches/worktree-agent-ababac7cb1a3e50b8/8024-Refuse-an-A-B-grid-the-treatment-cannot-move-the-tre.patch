+def _state(path: str) -> tuple:
+    if not os.path.exists(path):
+        return None, False
+    with open(path) as fh:
+        d = json.load(fh)
+    res = d.get("result") or {}
+    return res.get("action_trace"), (d.get("status") == "ok" and not res.get("timed_out"))
