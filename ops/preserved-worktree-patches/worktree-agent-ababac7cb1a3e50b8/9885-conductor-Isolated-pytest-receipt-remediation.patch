+                "verdict_class": "blocked",
+                "validation_errors": errors,
+            },
+            "pytest_receipt_remediation_ready_score": 0.0,
+            "terminal_validation_failure": {
+                "raw_suite_receipt_recoverable": True,
+                "validation_errors": errors,
+            },
+        }
