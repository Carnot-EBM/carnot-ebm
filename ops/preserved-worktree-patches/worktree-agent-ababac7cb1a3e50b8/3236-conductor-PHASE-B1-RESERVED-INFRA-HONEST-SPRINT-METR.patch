+  "field_principles": {
+    "generic_transfer_rate_over_variants": {
+      "principle": "the held-out-proxy generalization rate -- the REAL leaderboard signal that ends the single-number mirage (GAP-LIVE-INTEGRATION)."
+    },
+    "honest_verdict": {
