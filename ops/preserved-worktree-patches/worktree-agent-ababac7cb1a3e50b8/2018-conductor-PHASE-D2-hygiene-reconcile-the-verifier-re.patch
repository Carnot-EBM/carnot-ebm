+def test_req_4266_blocked_precondition_stops_without_fabricating(tmp_path: Path) -> None:
+    """REQ-VERIFY-4266: missing .394 artifacts produce blocked_v394_artifacts_missing."""
+
+    (tmp_path / "ops").mkdir()
