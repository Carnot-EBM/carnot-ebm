+def test_req_4266_ledgers_record_hardened_state_and_missing_verifier_gaps() -> None:
+    """REQ-VERIFY-4266: registry and gaps carry the .394 truth."""
+
+    guard = exp4266.run_gap4_regression_guard(REPO_ROOT)
