@@ -178,27 +178,46 @@ def _tr87():
     def _val(s):
         return int(s.name[-1])                          # glyph value = trailing digit of the sprite name
 
+    def _level_flag(game, name):
+        try:
+            return bool(game.current_level.get_data(name))
+        except Exception:
