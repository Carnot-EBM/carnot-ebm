+        lines.extend(
+            [
+                (
+                    f"- **{finding['title']}** - arXiv:2607.14004, "
+                    f"{finding['url']}. Carnot hook: {finding['carnot_hook']} "
+                    f"Target: {targets}. Substrate: {finding['substrate']}. "
