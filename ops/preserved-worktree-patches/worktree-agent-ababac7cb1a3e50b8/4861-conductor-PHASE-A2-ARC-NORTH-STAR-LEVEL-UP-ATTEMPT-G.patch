+def test_scenario_arc_wmte_4981_run_experiment_writes_no_delta_artifact(
+    tmp_path: Path, monkeypatch
+) -> None:
+    """SCENARIO-ARC-WMTE-4981-NO-GROUNDED-DELTA: runner stops before dry search."""
