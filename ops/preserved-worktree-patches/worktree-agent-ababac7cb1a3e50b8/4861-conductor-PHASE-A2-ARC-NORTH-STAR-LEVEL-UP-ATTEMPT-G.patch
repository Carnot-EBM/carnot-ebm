+    }
+
+
+def _dead_ends(row: Mapping[str, Any]) -> list[str]:
+    values = row.get("dead_ends") or []
+    if not isinstance(values, list):
+        values = [values]
+    rendered: list[str] = []
+    for value in values:
+        if isinstance(value, Mapping):
+            rendered.extend(f"{key}: {item}" for key, item in value.items())
+        else:
+            rendered.append(str(value))
+    return rendered
+
+
+def _has_recorded_next_level_dead_end(game: str, row: Mapping[str, Any]) -> bool:
+    blocking_phrases = (
+        "no grounded l",
+        "no_grounded_l",
+        "no grounded next-level",
+        "no_grounded_next_level",
+        "duplicate_depth",
+        "same-depth",
+        "no-bank",
+        "replays to l",
+    )
+    for item in _dead_ends(row):
+        lowered = item.lower()
+        if lowered.startswith(f"exp{EXPERIMENT_ID} "):
+            continue
+        if "retired" in lowered or "filled" in lowered:
+            continue
+        if lowered.startswith(f"{game}:"):
+            return True
+        if not any(phrase in lowered for phrase in blocking_phrases):
+            continue
+        if lowered.startswith(f"{game}:") or (lowered.startswith("exp") and game in lowered):
+            return True
+    return False
