+        summary = summarize_targeted_transitions(
+            game=game,
+            target_actions=TARGET_GAP_ACTIONS[game],
+            transitions=[],
+            dataset_path=dataset_path.relative_to(repo),
+            dataset_sha256=dataset_sha,
+            collection_error=repr(exc)[:240],
+        )
+        return summary, []
