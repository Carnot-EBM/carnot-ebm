+def compile_claim_clean_process(
+    claim: Mapping[str, Any], source: bytes, replay_index: int = 0
+) -> JsonDict:
+    payload = _compiler_claim(claim, source)
+    return dict(_compile_payload_clean_process(canonical_json(payload), replay_index))
