From 602fad31e1488c7a92a03681b6e0e56c13da8742 Mon Sep 17 00:00:00 2001
From: Ian Blenke <ian@blenke.com>
Date: Fri, 31 Jul 2026 13:59:22 -0400
Subject: [PATCH 08066/11362] [outer-loop] security audit: confirm the gitleaks
 baseline by re-scan (544 -> 170)

Full-history re-scan across all 21,323 commits with the new config in place
returned exactly 170 findings, down from 544. Replaces the predicted "~166" in
the config with the MEASURED 170, since that number is the drift-detection
threshold and a guessed threshold is not one.

Every one of the 170 was diffed against the original 544 and confirmed to be the
same benign content. Four were not in the first scan verbatim; all four turned
out to be the SAME file:line at a different commit --
`private_key: Ed25519PrivateKey` (a type annotation) and
`"access_outcome": "excluded_by_exp5853_disqualification"` x3. Zero real
secrets, confirming the audit's headline against the post-change config rather
than only the pre-change one.

Also removes a stale "rise above ~60" line that predated the decision to drop
the unsafe value-shape allowlist; leaving two different thresholds in one file
is how the next reader ends up triaging against the wrong one.
---
 .gitleaks.toml | 15 +++++++++++----
 1 file changed, 11 insertions(+), 4 deletions(-)

diff --git a/.gitleaks.toml b/.gitleaks.toml
index 0aacc6706e..6de4f3de71 100644
--- a/.gitleaks.toml
+++ b/.gitleaks.toml
@@ -87,9 +87,17 @@ targetRules = ["generic-api-key"]
 #    60  assorted prose, HTTP response captures (x-amz-apigw-id request trace
 #        ids from a 429 body), and type annotations
 #
-# EXPECTED RESIDUAL AFTER THESE RULES: ~166 findings (544 minus the 378 cache
-# hits), all reviewed 2026-07-31 and benign. Not driven lower -- see the
-# ATTEMPTED AND REJECTED note below for why the obvious next step is unsafe.
+# EXPECTED RESIDUAL AFTER THESE RULES: 170 findings. MEASURED, not predicted --
+# a full-history re-scan on 2026-07-31 with these rules in place returned exactly
+# 170 (544 before, 374 suppressed). Every one was diffed against the original
+# 544 and confirmed to be the same benign content; the 4 that were not in the
+# first scan verbatim are the SAME file:line at a different commit (a
+# `private_key: Ed25519PrivateKey` type annotation, and an
+# `"access_outcome": "excluded_by_..."` enum x3).
+#
+# TREAT A RISE ABOVE 170 AS SOMETHING TO TRIAGE, not as noise to re-suppress.
+# Not driven lower -- see the ATTEMPTED AND REJECTED note below for why the
+# obvious next step is unsafe.
 
 [[allowlists]]
 description = "Content-hash item keys in detector cache/manifest JSONL (378 of 544)"
@@ -131,7 +139,6 @@ targetRules = ["generic-api-key"]
 # that silently rots as history is rewritten, or regexes broad enough to hide a
 # real key. A short, stable, human-reviewable residual is the safer end state.
 #
-# TREAT A RISE ABOVE ~60 AS SOMETHING TO TRIAGE, not as noise to re-suppress.
 # And per the rule at the top of this file: when gitleaks finds a REAL secret,
 # do not allowlist it -- rotate it, purge it from history, and force-push.
 
-- 
