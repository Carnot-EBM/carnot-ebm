+    assert cs["sota_ingestion"]["methods_mapped_count"] == 8
+    assert cs["sota_ingestion"]["included"] is True
+
+    hw = cs["hardware"]
+    assert hw["kv260_terminal"] is True
+    assert "blocked" in hw["gatemate_step"]
