+def test_req_capstone_4978_spec_declares_final_scorecard_contract() -> None:
+    """REQ-CAPSTONE-4978: OpenSpec declares the final .458 capstone contract."""
+
+    spec = SPEC_PATH.read_text(encoding="utf-8")
+    section = spec[spec.index("REQ-CAPSTONE-4978") :]
+
+    for ref in mod.SPEC_REFS:
+        assert ref in section
+    assert mod.RESULT_RELATIVE_PATH in section
+    for source in mod.UPSTREAM_SOURCES.values():
+        assert source.relative_path in section
+    for field in mod.REQUIRED_FIELDS:
+        assert field in section
+    for field, principle in mod.FIELD_PRINCIPLES.items():
+        assert field in section
+        assert principle["principle"] in section
+
