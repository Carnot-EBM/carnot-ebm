+def _extended_backlog(d: Mapping[str, Any] | None) -> list[str]:
+    if d is None:
+        return []
+    turnkey = _mapping(d.get("turnkey_spec"))
+    extension = _mapping(turnkey.get("sota_backlog_extension_v458")) or _mapping(
+        turnkey.get("sota_backlog_extension")
+    )
+    new_ids = extension.get("new_arxiv_ids")
+    if isinstance(new_ids, list):
+        return [str(value) for value in new_ids if str(value)]
+    cited = [str(value) for value in d.get("arxiv_ids_cited", [])]
+    return [arxiv_id for arxiv_id in ("2504.01005", "2504.00891", "2509.24460") if arxiv_id in cited]
