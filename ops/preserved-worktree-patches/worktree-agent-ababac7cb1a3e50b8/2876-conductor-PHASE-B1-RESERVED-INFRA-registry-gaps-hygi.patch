+        for field in (
+            "sc25_resolved_generically",
+            "sc25_cast_grid_resolved_generically",
+            "cast_grid_phase_fsm_resolved_generically",
+        )
+    )
+    return bool(closure_flag and payload.get("offline_reproduced") is True and _sc25_levels(payload) >= 1)
