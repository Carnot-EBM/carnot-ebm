+def reconcile_gaps_text(gaps_text: str, gap_entries: list[dict[str, Any]]) -> tuple[str, list[str], list[str]]:
+    updated = gaps_text
+    filled: list[str] = []
+    open_ids: list[str] = []
+    for gap in gap_entries:
+        gap_id = str(gap["gap_id"])
+        if str(gap.get("status", "")).startswith("filled"):
