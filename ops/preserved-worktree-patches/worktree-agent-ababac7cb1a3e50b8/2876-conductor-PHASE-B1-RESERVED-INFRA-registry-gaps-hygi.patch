+def _resolve_artifact_path(root: Path, pattern: str) -> str:
+    if "*" not in pattern:
+        return pattern
+    matches = sorted(root.glob(pattern))
+    if matches:
+        return matches[0].relative_to(root).as_posix()
+    return pattern
