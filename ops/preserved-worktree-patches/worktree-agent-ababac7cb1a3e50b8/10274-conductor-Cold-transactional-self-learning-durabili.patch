+            "passed": isinstance(rows, list) and len(rows) > 0,
+        },
+        "raw_rows_complete": {
+            "expected": EXPECTED_ROW_COUNT,
+            "observed": len(rows) if isinstance(rows, list) else 0,
+            "passed": isinstance(rows, list) and len(rows) == EXPECTED_ROW_COUNT,
+        },
+        "all_six_orders": {
