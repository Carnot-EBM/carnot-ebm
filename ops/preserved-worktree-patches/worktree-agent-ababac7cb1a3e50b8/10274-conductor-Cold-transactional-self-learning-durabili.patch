+            "passed": [row.get("order_hash") for row in protocol_orders]
+            == [row.get("order_hash") for row in fixture_orders],
+        }
+    return {
+        "checks": checks,
+        "all_passed": all(row["passed"] is True for row in checks.values()),
+        "process": {
+            "pid": os.getpid(),
+            "python": sys.version.split()[0],
