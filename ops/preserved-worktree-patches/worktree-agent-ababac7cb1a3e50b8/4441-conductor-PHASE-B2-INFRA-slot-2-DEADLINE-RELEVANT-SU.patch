+def test_req_capstone_4866_spec_declares_reverification_contract() -> None:
+    """REQ-CAPSTONE-4866: OpenSpec declares the re-verification contract first."""
+
+    spec = SPEC_PATH.read_text(encoding="utf-8")
+
+    for marker in (
+        "REQ-CAPSTONE-4866",
+        "SCENARIO-CAPSTONE-4866",
+        "SCENARIO-CAPSTONE-4866-BLOCKED-PRECONDITION",
+        "SCENARIO-CAPSTONE-4866-FIELD-PRINCIPLES",
+        mod.RESULT_RELATIVE_PATH,
+        mod.PRIOR_READY_RELATIVE_PATH,
+        "ready_package_regression_check",
+        "success_submission_package_ready",
+    ):
+        assert marker in spec
+    for field, principle in mod.FIELD_PRINCIPLES.items():
+        assert field in spec
+        assert principle["principle"] in spec
+
