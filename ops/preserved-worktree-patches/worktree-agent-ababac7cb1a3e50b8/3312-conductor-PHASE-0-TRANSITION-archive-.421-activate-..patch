+            "path": str(A1_VERIFIER_ROUTER_REL_PATH),
+            "fields_imported": [
+                "generic_transfer_delta",
+                "random_router_control_passed",
+                "false_negative_risk_checked",
+                "flagged_adversarial",
+            ],
+            "sha256": file_sha256(root / A1_VERIFIER_ROUTER_REL_PATH),
+        },
