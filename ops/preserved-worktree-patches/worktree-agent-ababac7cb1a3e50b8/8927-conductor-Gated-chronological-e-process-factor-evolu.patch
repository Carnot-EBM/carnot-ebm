+def factor_count_for(arm: str, event_index: int) -> int:
+    """Return bounded factor count before one event."""
+
+    if arm == FROZEN_ARM:
+        return 0
+    if arm == FIXED_ARM:
+        return min(2, max(0, event_index - 1))
+    return min(3, max(0, event_index))
