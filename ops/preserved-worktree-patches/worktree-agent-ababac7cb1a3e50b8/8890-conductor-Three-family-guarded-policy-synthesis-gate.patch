+def _fake_model_file(tmp_path: Path, hf_id: str, filename: str) -> Path:
+    revision = "rev-" + mod.model_slug(hf_id)
+    path = tmp_path / "hub" / f"models--{hf_id.replace('/', '--')}" / "snapshots" / revision
