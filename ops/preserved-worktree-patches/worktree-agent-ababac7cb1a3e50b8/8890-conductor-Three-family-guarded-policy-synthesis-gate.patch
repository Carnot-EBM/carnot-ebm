+
+    host_ok = (
+        bool(host.get("cuda_devices", {}).get("available"))
+        and int(host.get("cuda_devices", {}).get("count") or 0) >= 2
+        and bool(host.get("llama_cpp_cli", {}).get("exists"))
+        and bool(host.get("llama_cpp_gpu_offload", {}).get("available"))
+    )
