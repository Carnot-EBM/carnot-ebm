From 38a7a0b13e5a7fd75b3f9b79b9c2c29d84dcf98a Mon Sep 17 00:00:00 2001
From: Ian Blenke <ian@blenke.com>
Date: Sat, 8 Aug 2026 04:15:06 -0400
Subject: [PATCH 08522/11362] Fix exp6199's induce timeout: pass it to the
 constructor, not an env var

Root-cause found after TWO reruns still showed 100% think-arm timeout at
~600s despite CARNOT_ARC_INDUCE_TIMEOUT=1500 being set on the process both
times. LocalGGUFProposer.timeout is a plain dataclass field (default 300s)
-- it never reads CARNOT_ARC_INDUCE_TIMEOUT at all; that's a separate,
unrelated helper function used by other call sites. The env var was a
complete no-op here. tries=2 retry attempts x the 300s per-attempt default
is exactly the ~600s ceiling every think-arm row hit in both prior runs,
even after the conductor and its timers were stopped and GPU 1 was fully
dedicated -- ruling out contention/crash as the cause of that specific
symptom.

Adds INDUCE_TIMEOUT_S = 1500 and passes timeout=INDUCE_TIMEOUT_S explicitly
to the LocalGGUFProposer(...) constructor. This is the actual fix; the
previous two runs' "think_mode_mechanism_inert_no_reasoning_trace_ever_
engaged" verdict was never a real measurement of gemma's think-mode
behavior -- every attempt was cut off at 600s before generation could
possibly complete a 16384-token think-mode response.

Not committing the stale results/experiment_6199_gemma_think_mode_ab.json
in the working tree -- it holds the second (still timeout-truncated) run's
misleading verdict and will be overwritten by the next run.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JntPrUGLNesPcJH1pyfFYw
---
 python/carnot/experiment_6199_gemma_think_mode_ab.py | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/python/carnot/experiment_6199_gemma_think_mode_ab.py b/python/carnot/experiment_6199_gemma_think_mode_ab.py
index 4bd5863c6e..0cd7ea0355 100644
--- a/python/carnot/experiment_6199_gemma_think_mode_ab.py
+++ b/python/carnot/experiment_6199_gemma_think_mode_ab.py
@@ -103,6 +103,14 @@ SERVER_PORT = 8940  # non-default, avoids colliding with any conductor-owned war
 # value results/experiment_6091_refine_engine_visible_ab.json's completed rerun (this session)
 # measured as non-truncating for gemma at this budget class.
 SHARED_MAX_TOKENS = 16384
+# HTTP timeout per induce attempt, in seconds. `LocalGGUFProposer.timeout` is a plain dataclass
+# field (default 300s) -- it does NOT read CARNOT_ARC_INDUCE_TIMEOUT, that is a separate,
+# unrelated helper used by other call sites. An env var alone does nothing here; this value
+# must be passed explicitly to the constructor. 300s x 2 retry attempts is why every think-arm
+# row in the first two runs of this experiment timed out at ~600s even after CARNOT_ARC_INDUCE_
+# TIMEOUT=1500 was set on the process -- the override never reached this field. 1500 gives a
+# full 16384-token think-mode completion (~800s at ~20 tok/s single-card decode) real headroom.
+INDUCE_TIMEOUT_S = 1500
 REASONING_TAGS = ("<think", "</think", "<thinking", "<reasoning")
 
 MODEL_SPECS = [
@@ -451,6 +459,7 @@ def build_artifact(*, roster: tuple[str, ...] = DEFAULT_ROSTER, root: Path = REP
         kv_quant="q8_0",
         max_tokens=SHARED_MAX_TOKENS,
         no_think_prefix="",
+        timeout=INDUCE_TIMEOUT_S,
     )
     try:
         server_up = prop._ensure_server()
