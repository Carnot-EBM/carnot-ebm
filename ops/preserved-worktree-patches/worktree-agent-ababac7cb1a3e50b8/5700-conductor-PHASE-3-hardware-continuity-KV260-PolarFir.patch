index 0000000000..0975deb8d4
--- /dev/null
+++ b/tests/python/test_experiment_5243_hardware_continuity_kan_pbit_boundary_v479.py
@@ -0,0 +1,343 @@
+"""Tests for Exp 5243 hardware continuity plus KAN/p-bit boundary plan.
+
+Spec refs: REQ-HW-5243, SCENARIO-HW-5243.
+"""
+
+from __future__ import annotations
+
+import copy
+import json
+from pathlib import Path
+
+import pytest
+
+from carnot import experiment_5243_hardware_continuity_kan_pbit_boundary_v479 as mod
+
+
+REPO = Path(__file__).resolve().parents[2]
+SPEC_PATH = REPO / "openspec/capabilities/fpga/spec.md"
+RESULT_PATH = REPO / mod.RESULT_RELATIVE_PATH
+
+
+class RecordingRunner:
+    """SCENARIO-HW-5243 command runner with deterministic board transcripts."""
+
+    def __init__(self, probes: dict[tuple[str, ...], list[mod.CommandProbe]]) -> None:
+        self.probes = {command: list(values) for command, values in probes.items()}
+        self.commands: list[tuple[str, ...]] = []
+
+    def __call__(self, command: tuple[str, ...], timeout_s: float = 60.0) -> mod.CommandProbe:
+        assert timeout_s > 0.0
+        command = tuple(command)
+        self.commands.append(command)
+        if command not in self.probes or not self.probes[command]:
+            raise AssertionError(f"unexpected command: {command!r}")
+        return self.probes[command].pop(0)
+
+
+class StepClock:
+    """Deterministic clock for stable duration and checksum tests."""
+
+    def __init__(self) -> None:
+        self.value = 5243.0
+
+    def __call__(self) -> float:
+        self.value += 0.25
+        return self.value
+
+
+def _value(artifact: dict[str, object], field: str) -> object:
+    wrapped = artifact[field]
+    assert isinstance(wrapped, dict)
+    return wrapped["value"]
+
+
+def _probe(
+    command: tuple[str, ...],
+    *,
+    exit_code: int = 0,
+    stdout: str = "",
+    stderr: str = "",
+    duration_s: float = 0.01,
+) -> mod.CommandProbe:
+    return mod.CommandProbe(command, exit_code, stdout, stderr, duration_s)
+
+
+def _smoke_stdout(board: str, *, workload_hash: str | None = None, ok: bool = True) -> str:
+    return (
+        json.dumps(
+            {
+                "board": board,
+                "workload_sha256": workload_hash or mod.HASH_SMOKE_WORKLOAD_HASH,
+                "executable_sha256": mod.HASH_SMOKE_EXECUTABLE_HASH,
+                "correctness": {"energy_matches_expected": ok},
+                "energy": mod.HASH_SMOKE_EXPECTED_ENERGY if ok else 999,
+                "inference_substrate": mod.INFERENCE_SUBSTRATE,
+            },
+            sort_keys=True,
+        )
+        + "\n"
+    )
+
+
+def _runner(
+    *,
+    kv260_exit: int = 0,
+    kv260_stderr: str = "",
+    kv260_smoke_stdout: str | None = None,
+    polarfire_exit: int = 0,
+    polarfire_stderr: str = "",
+    polarfire_smoke_stdout: str | None = None,
+) -> RecordingRunner:
+    probes: dict[tuple[str, ...], list[mod.CommandProbe]] = {
+        mod.KV260_SSH_COMMAND: [
+            _probe(
+                mod.KV260_SSH_COMMAND,
+                exit_code=kv260_exit,
+                stderr=kv260_stderr,
+                duration_s=0.2,
+            )
+        ],
+        mod.POLARFIRE_SSH_COMMAND: [
+            _probe(
+                mod.POLARFIRE_SSH_COMMAND,
+                exit_code=polarfire_exit,
+                stderr=polarfire_stderr,
+                duration_s=0.3,
+            )
+        ],
+    }
+    if kv260_exit == 0:
+        probes[mod.KV260_HASH_SMOKE_COMMAND] = [
+            _probe(
+                mod.KV260_HASH_SMOKE_COMMAND,
+                stdout=kv260_smoke_stdout or _smoke_stdout("kv260"),
+                duration_s=0.4,
+            )
+        ]
+    if polarfire_exit == 0:
+        probes[mod.POLARFIRE_HASH_SMOKE_COMMAND] = [
+            _probe(
+                mod.POLARFIRE_HASH_SMOKE_COMMAND,
+                stdout=polarfire_smoke_stdout or _smoke_stdout("polarfire"),
+                duration_s=0.5,
+            )
+        ]
+    return RecordingRunner(probes)
+
+
+def _success_artifact() -> dict[str, object]:
+    return mod.build_artifact(
+        command_runner=_runner(),
+        clock=StepClock(),
+        run_date="20260704",
+        note_written=True,
+    )
+
+
+def test_req_hw_5243_spec_declares_wrapped_artifact_contract() -> None:
+    """REQ-HW-5243: OpenSpec anchors the v479 SSH/hash boundary contract."""
+
+    spec = SPEC_PATH.read_text(encoding="utf-8")
+    section = spec[spec.index("### REQ-HW-5243") : spec.index("### SCENARIO-HW-4910")]
+
+    for marker in (
+        "REQ-HW-5243",
+        "SCENARIO-HW-5243",
+        str(mod.RESULT_RELATIVE_PATH),
+        mod.INFERENCE_SUBSTRATE,
+        "kv260_ssh_only_confirmed",
+        "polarfire_status",
+        "blocked substatus",
+        "physical_setup_changed",
+        "safe_commands_run",
+        "speedup_claimed=false",
+        "Extropic TSU references remain watch-only",
+    ):
+        assert marker in section
+    for field in mod.REQUIRED_WRAPPED_FIELDS:
+        assert f"`{field}`" in section
+
+
+def test_scenario_hw_5243_success_path_runs_only_ssh_hash_commands() -> None:
+    """SCENARIO-HW-5243: reachable boards use only SSH reachability/hash smokes."""
+
+    runner = _runner()
+    artifact = mod.build_artifact(
+        command_runner=runner,
+        clock=StepClock(),
+        run_date="20260704",
+        note_written=True,
+    )
+
+    assert runner.commands == [
+        mod.KV260_SSH_COMMAND,
+        mod.KV260_HASH_SMOKE_COMMAND,
+        mod.POLARFIRE_SSH_COMMAND,
+        mod.POLARFIRE_HASH_SMOKE_COMMAND,
+    ]
+    assert _value(artifact, "kv260_status") == "reachable"
+    assert _value(artifact, "kv260_ssh_only_confirmed") is True
+    assert _value(artifact, "polarfire_status") == "reachable"
+    assert _value(artifact, "gatemate_status") == "blocked_physical_jtag"
+    assert _value(artifact, "physical_setup_changed") is False
+    assert _value(artifact, "speedup_claimed") is False
+    assert _value(artifact, "kan_pbit_boundary_note_path") == str(mod.BOUNDARY_NOTE_RELATIVE_PATH)
+    assert len(_value(artifact, "safe_commands_run")) == 4
+    assert _value(artifact, "inference_substrate") == mod.INFERENCE_SUBSTRATE
+    assert _value(artifact, "honest_verdict").startswith("complete:")
+    assert "kv260=reachable" in _value(artifact, "honest_verdict")
+    assert "polarfire=reachable" in _value(artifact, "honest_verdict")
+    assert "gatemate=blocked_physical_jtag" in _value(artifact, "honest_verdict")
+    assert "no_speedup" in _value(artifact, "honest_verdict")
+    assert artifact["gatemate_carry_forward"]["timestamp"] == "20260704"
+    assert "/dev/mmcblk" not in json.dumps(artifact).lower()
+    mod.validate_artifact(artifact)
+
+
+def test_polarfire_block_records_exact_command_and_error() -> None:
+    """REQ-HW-5243: unreachable PolarFire emits exact blocked command/error."""
+
+    runner = _runner(
+        polarfire_exit=255,
+        polarfire_stderr="ssh: connect to host polarfire port 22: No route to host\n",
+    )
+    artifact = mod.build_artifact(
+        command_runner=runner,
+        clock=StepClock(),
+        run_date="20260704",
+        note_written=True,
+    )
+    commands = _value(artifact, "safe_commands_run")
+    assert isinstance(commands, list)
+    polarfire_ssh = commands[-1]
+
+    assert runner.commands == [
+        mod.KV260_SSH_COMMAND,
+        mod.KV260_HASH_SMOKE_COMMAND,
+        mod.POLARFIRE_SSH_COMMAND,
+    ]
+    assert _value(artifact, "polarfire_status") == "blocked"
+    assert artifact["polarfire_blocked_substatus"]["command"] == mod.command_to_string(
+        mod.POLARFIRE_SSH_COMMAND
+    )
+    assert artifact["polarfire_blocked_substatus"]["error"] == (
+        "ssh: connect to host polarfire port 22: No route to host\n"
+    )
+    assert polarfire_ssh["passed"] is False
+    assert polarfire_ssh["error"] == artifact["polarfire_blocked_substatus"]["error"]
+    assert "polarfire=blocked" in _value(artifact, "honest_verdict")
+    mod.validate_artifact(artifact)
+
+
+def test_kv260_block_skips_hash_smoke_but_keeps_ssh_only_discipline() -> None:
+    """REQ-HW-5243: KV260 blockers are SSH blockers, not host-storage blockers."""
+
+    runner = _runner(kv260_exit=255, kv260_stderr="ssh: connect to host kria port 22: timeout\n")
+    artifact = mod.build_artifact(
+        command_runner=runner,
+        clock=StepClock(),
+        run_date="20260704",
+        note_written=True,
+    )
+
+    assert runner.commands == [
+        mod.KV260_SSH_COMMAND,
+        mod.POLARFIRE_SSH_COMMAND,
+        mod.POLARFIRE_HASH_SMOKE_COMMAND,
+    ]
+    assert _value(artifact, "kv260_status") == "blocked"
+    assert _value(artifact, "kv260_ssh_only_confirmed") is True
+    assert artifact["kv260_blocked_substatus"]["command"] == mod.command_to_string(
+        mod.KV260_SSH_COMMAND
+    )
+    assert "timeout" in artifact["kv260_blocked_substatus"]["error"]
+    assert "kv260=blocked" in _value(artifact, "honest_verdict")
+    mod.validate_artifact(artifact)
+
+
+def test_hash_smoke_mismatch_blocks_board_status_without_speedup_claim() -> None:
+    """REQ-HW-5243: SSH reachability alone is not inflated into hash continuity."""
+
+    artifact = mod.build_artifact(
+        command_runner=_runner(kv260_smoke_stdout=_smoke_stdout("kv260", workload_hash="bad")),
+        clock=StepClock(),
+        run_date="20260704",
+        note_written=True,
+    )
+
+    assert _value(artifact, "kv260_status") == "blocked"
+    assert artifact["board_hash_smokes"]["kv260"]["hash_verified"] is False
+    assert artifact["board_hash_smokes"]["kv260"]["correctness_ok"] is True
+    assert _value(artifact, "speedup_claimed") is False
+    mod.validate_artifact(artifact)
+
+
+def test_boundary_note_writer_records_kan_pbit_speedup_preconditions(tmp_path: Path) -> None:
+    """SCENARIO-HW-5243: note states the workload evidence needed before speedup."""
+
+    artifact_path = mod.run_experiment(
+        repo_root=tmp_path,
+        command_runner=_runner(),
+        clock=StepClock(),
+        run_date="20260704",
+    )
+    payload = json.loads(artifact_path.read_text(encoding="utf-8"))
