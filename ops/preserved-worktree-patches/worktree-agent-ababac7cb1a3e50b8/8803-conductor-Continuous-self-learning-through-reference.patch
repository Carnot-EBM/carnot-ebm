+def _continuous_relaxation_receipt() -> JsonDict:
+    path = REPO_ROOT / EXP6287_RELATIVE_PATH
+    terminal_class = "missing"
+    if path.exists():
+        payload = json.loads(path.read_text(encoding="utf-8"))
