+def build_artifact(
+    *,
+    date: str,
+    result_path: Path,
+    duration_s: float,
+    test_exit_codes: Mapping[str, int | None] | None = None,
+) -> JsonDict:
+    """Run the sealed stream and return the artifact payload."""
+
+    result_path.parent.mkdir(parents=True, exist_ok=True)
