+@dataclass(frozen=True)
+class StreamEvent:
+    """One bounded ASP event whose target is hidden until exact validation."""
+
+    event_id: str
+    chronological_index: int
+    partition: str
+    family: str
+    template_id: str
+    features: tuple[int, ...]
