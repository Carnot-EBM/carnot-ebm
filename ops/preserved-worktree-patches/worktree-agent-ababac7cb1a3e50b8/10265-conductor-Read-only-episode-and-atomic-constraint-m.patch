+    broken = deepcopy(payload)
+    broken["reproducibility_checksum"] = "sha256:bad"
+    assert "reproducibility_checksum mismatch" in mod.validate_artifact(broken)
+    broken = deepcopy(payload)
+    broken["inference_substrate"] = "live_llm_inference"
