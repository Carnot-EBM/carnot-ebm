+
+
+def test_scenario_cl_6748_owned_precondition_block_is_complete(tmp_path: Path) -> None:
+    """SCENARIO-CL-6748-ARTIFACT: missing owned resources emit a complete block."""
+
+    artifact = mod.run_fixture(
