+        _attack_row("missing_raw_path", missing_paths == 0, missing_paths, 0),
+        _attack_row("missing_unload", not missing_unload, missing_unload, []),
+        _attack_row("reused_process", reused_pids == 0, reused_pids, 0),
+        _attack_row(
