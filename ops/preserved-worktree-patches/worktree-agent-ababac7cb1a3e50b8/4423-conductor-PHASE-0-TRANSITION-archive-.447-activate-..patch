+        )
+    },
+    "wall_is_guidance_not_coverage": {
+        "principle": (
+            "true -- macro-vocab + click-heatmap retirements prove the vocabulary is sufficient; "
+            "the .448 planner must NOT re-propose coverage/vocabulary levers."
