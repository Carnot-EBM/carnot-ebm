+    assert refreshed.count("2026-06-13 Exp 4121") == 1
+    assert "## Existing\nBody." in refreshed
+    assert no_heading.rstrip().endswith("selector/RFT work should stay blocked.")
+    assert marker_at_end.count("2026-06-13 Exp 4121") == 1
