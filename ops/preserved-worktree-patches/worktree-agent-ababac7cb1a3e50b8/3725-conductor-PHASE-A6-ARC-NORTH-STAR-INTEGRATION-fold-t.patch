+            "complete: integration_unchanged_both_levers_null."
+        )
+    },
+    "inference_substrate": {"principle": INFERENCE_SUBSTRATE},
+    "verifier_is_oracle": {
+        "principle": (
+            "MUST be false -- the integrated value-routing/QD signals are "
