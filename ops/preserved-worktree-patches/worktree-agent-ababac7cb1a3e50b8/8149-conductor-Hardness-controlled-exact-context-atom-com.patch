+def _make_atom(
+    kind: str,
+    payload: Mapping[str, Any],
+    schema: Mapping[str, Any],
+    derivation: str,
+) -> JsonDict:
+    atom = exp5935._make_atom(kind, payload, schema)
+    atom["public_derivation"] = derivation
+    return atom
