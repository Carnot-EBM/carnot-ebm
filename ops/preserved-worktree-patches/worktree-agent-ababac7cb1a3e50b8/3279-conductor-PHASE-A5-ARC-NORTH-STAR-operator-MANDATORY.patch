+def check_preconditions(
+    root: Path | str = REPO_ROOT,
+) -> dict[str, Any]:  # pragma: no cover - SDK boundary
+    root_path = Path(root)
+    spec_path = root_path / "openspec" / "capabilities" / "arc-world-model-trust-energy" / "spec.md"
+    spec_text = spec_path.read_text(encoding="utf-8") if spec_path.exists() else ""
+    checks: dict[str, Any] = {
+        "agents_md_read": (root_path / "AGENTS.md").exists(),
+        "codex_md_read": (root_path / "CODEX.md").exists() or (root_path / "OPENCODE.md").exists(),
+        "offline_arcade_import": False,
+        "a1_artifact_present": (
+            root_path / UPSTREAM_ARTIFACTS["a1_verifier_router_generic_transfer"]
+        ).exists(),
+        "a2_artifact_present": (
+            root_path / UPSTREAM_ARTIFACTS["a2_executable_world_model_proposer"]
+        ).exists(),
+        "a4_artifact_present": (
+            root_path / UPSTREAM_ARTIFACTS["a4_hidden_field_state_probe"]
+        ).exists(),
+        "spec_has_req_4560": "REQ-ARC-WMTE-4560" in spec_text,
+        "leaderboard_submission": False,
+    }
+    try:
+        from carnot.agentic import arc_solver_kit
+
+        arc_solver_kit.offline_arcade()
+        checks["offline_arcade_import"] = True
+    except Exception as exc:
+        checks["offline_arcade_error"] = repr(exc)
+    checks["ok"] = bool(checks["offline_arcade_import"])
+    return checks
+
