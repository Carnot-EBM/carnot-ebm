+def _blocked_delta(verdict: str) -> dict[str, Any]:
+    return {
+        "status": verdict,
+        "n": 0,
+        "guided_pass_rate": None,
+        "unguided_pass_rate": None,
+        "delta": None,
+        "ci95": None,
+    }
