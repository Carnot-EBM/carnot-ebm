+++ b/scripts/experiments/experiment_3857_archive_v355_activate_v356.py
@@ -0,0 +1,28 @@
+#!/usr/bin/env python3
+"""Run Exp 3857 .355 wipeout archive and .356 activation."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import sys
+
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+PYTHON_ROOT = REPO_ROOT / "python"
+for path in (REPO_ROOT, PYTHON_ROOT):
+    if str(path) not in sys.path:
+        sys.path.insert(0, str(path))
+
+from carnot.reporting.archive_v355_activate_v356_3857 import run  # noqa: E402
+
+
+def main() -> int:
+    output_path = run(REPO_ROOT)
+    payload = json.loads(output_path.read_text(encoding="utf-8"))
+    print(json.dumps(payload, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
diff --git a/tests/python/test_experiment_3857_archive_v355_activate_v356.py b/tests/python/test_experiment_3857_archive_v355_activate_v356.py
