+PRIOR_BEST_LEVELS = {"lp85": 5, "tu93": 4, "tn36": 7, "tr87": 6}
+TARGET_LEVELS = {"lp85": 6, "tu93": 5, "tn36": 8, "tr87": 7}
+PRIOR_REPRODUCIBLE_TOTAL_LEVELS = 34
+DEFAULT_TARGET_WALL_TIME_S = 30.0
+RESULT_RELATIVE_PATH = "results/experiment_4383_e3_deeper_high_headroom_lookahead.json"
+RESULT_PATH = REPO / RESULT_RELATIVE_PATH
+REGISTRY_RELATIVE_PATH = "ops/arc_solve_registry.yaml"
+WORLD_MODEL_PATHS = {
+    "lp85": "python/carnot/agentic/arc_game_adapters.py",
+    "tu93": "python/carnot/agentic/arc_game_adapters.py",
+    "tn36": "scripts/arc3_tn36_offline_solver.py",
+    "tr87": "python/carnot/agentic/arc_game_adapters.py",
+}
+DEFAULT_WORLD_MODEL_PATHS = (
+    "python/carnot/experiment_4383_e3_deeper_high_headroom_lookahead.py",
+    WORLD_MODEL_PATHS["lp85"],
+    WORLD_MODEL_PATHS["tn36"],
+    "python/carnot/agentic/arc_solver_kit.py",
+    "scripts/arc_loop_solve.py",
+)
+TARGET_GAPS = {
+    "lp85": "lp85_l6_permutation_bfs_no_new_reproduction_gap",
+    "tu93": "tu93_l5_fresh_env_branch_mode_no_new_reproduction_gap",
+    "tn36": "tn36_l8_program_editor_object_control_gap_sxhtkytekm_palette_population",
+    "tr87": "tr87_l7_no_offline_level_available_or_no_new_reproduction_gap",
+}
+
+REQUIRED_ARTIFACT_FIELDS = (
+    "honest_verdict",
+    "per_target_scorecard",
+    "reproducible_total_levels",
+    "new_levels_reproduced",
+    "world_model_paths",
+    "verifier_is_oracle",
+    "preconditions_checked",
