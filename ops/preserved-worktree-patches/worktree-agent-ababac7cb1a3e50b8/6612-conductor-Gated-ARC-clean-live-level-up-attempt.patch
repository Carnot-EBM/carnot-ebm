+def write_trajectory_log(path: Path, log: Mapping[str, Any]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(log, indent=2, sort_keys=True) + "\n", encoding="utf-8")
