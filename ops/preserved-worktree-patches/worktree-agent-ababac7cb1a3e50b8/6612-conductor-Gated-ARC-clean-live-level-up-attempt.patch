@@ -0,0 +1,526 @@
+"""Tests for Exp5548 clean no-LLM ARC live level-up attempt.
+
+Spec refs: REQ-ARC-FCP-5548,
+SCENARIO-ARC-FCP-5548.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any
+
+import pytest
+import yaml
+
+from carnot import experiment_5548_arc_clean_live_levelup as exp5548
+
+
+pytestmark = pytest.mark.memory_watchdog_skip
+
+REPO = Path(__file__).resolve().parents[2]
+SPEC_PATH = REPO / "openspec" / "capabilities" / "arc-human-replay-frame-change" / "spec.md"
+
+
+def _registry(*, g50t_levels: int = 2, total: int = 69) -> dict[str, Any]:
+    return {
+        "reproducible_total_levels": total,
+        "games": [
+            {"game": "sb26", "reproducibility": "reproduced", "levels_reproduced": 2},
+            {"game": "g50t", "reproducibility": "reproduced", "levels_reproduced": g50t_levels},
+            {"game": "lf52", "reproducibility": "reproduced", "levels_reproduced": 2},
+        ],
+    }
+
+
+def _precheck(*, ready: bool = True, game: str = "g50t", level: str = "L3") -> dict[str, Any]:
+    return {
+        "experiment": "experiment_5547_arc_no_llm_substrate_precheck",
+        "arc_clean_precheck_ready": ready,
+        "selected_game": game,
+        "selected_level": level,
+        "random_seed": 5547,
+        "repeated_coordinate_suppression_enabled": True,
+        "llm_strategy_proposer_used": False,
+        "no_model_specs_required": True,
+        "inference_substrate": "offline_arcade_live_agent_runtime_self_discovery_no_llm",
+        "solve_provenance": "live_agent_self_discovery",
+        "strategy_probe": {
+            "diagnostics": {
+                "strategy_portfolio": [
+                    {"name": "salience_first", "score_field": "salience_score", "bound": 1},
+                    {"name": "action_effect_memory", "score_field": "effect_score", "bound": 1},
+                    {
+                        "name": "verifier_router_candidate_ranking",
+                        "score_field": "verifier_score",
+                        "bound": 1,
+                    },
+                    {
+                        "name": "conservative_reset_reinduction",
+                        "score_field": "reset_score",
+                        "bound": 1,
+                    },
+                ]
+            }
+        },
+    }
+
+
+def _target() -> dict[str, Any]:
+    return exp5548.select_target_from_precheck(_precheck(), _registry())
+
+
+def _null_attempt() -> dict[str, Any]:
+    action_rows = [
+        {
+            "step": 1,
+            "action": 6,
+            "data": {"x": 10, "y": 10},
+            "label": "A6@10,10",
+            "strategy": "salience_first",
+            "level_before": 2,
+            "level_after": 2,
+        },
+        {
+            "step": 2,
+            "action": 6,
+            "data": {"x": 14, "y": 10},
+            "label": "A6@14,10",
+            "strategy": "action_effect_memory",
+            "level_before": 2,
+            "level_after": 2,
+        },
+        {
+            "step": 3,
+            "action": 6,
+            "data": {"x": 10, "y": 10},
+            "label": "A6@10,10-again",
+            "strategy": "verifier_router_candidate_ranking",
+            "level_before": 2,
+            "level_after": 2,
+        },
+    ]
+    return {
+        "attempts": len(action_rows),
+        "post_levels_reproduced": 2,
+        "offline_reproduced": False,
+        "reproduced_levels": 0,
+        "action_rows": action_rows,
+        "proposed_action_rows": [{"action": 6, "data": {"x": 10, "y": 10}}],
+        "observations": [{"step": 0, "event": "reset", "level": 2}],
+        "verifier_routes": [{"step": 1, "route": "candidate_router.rank"}],
+        "suppression_events": [{"step": 1, "suppressed_coordinate_count": 2}],
+        "level_counter_changes": [],
+        "reproduction_gate": {"reproduced": False, "reached_level": 2},
+        "verifier_feedback": {"reproduction_gate": {"reproduced": False}},
+        "solution_labels": [],
+        "failure_mode": "bounded_budget_no_target_level_reproduction",
+        "terminal_state": {
+            "status": "budget_exhausted",
+            "max_level": 2,
+            "target_level": 3,
+        },
+        "offline_bfs_used": False,
+        "game_source_read": False,
+        "hand_built_per_game_adapter_used": False,
+        "llm_strategy_proposer_used": False,
+    }
+
+
+def _success_attempt() -> dict[str, Any]:
+    return {
+        **_null_attempt(),
+        "attempts": 4,
+        "post_levels_reproduced": 3,
+        "offline_reproduced": True,
+        "reproduced_levels": 1,
+        "action_rows": [
+            *_null_attempt()["action_rows"],
+            {
+                "step": 4,
+                "action": 6,
+                "data": {"x": 20, "y": 10},
+                "label": "A6@20,10",
+                "strategy": "conservative_reset_reinduction",
+                "level_before": 2,
+                "level_after": 3,
+            },
+        ],
+        "level_counter_changes": [{"step": 4, "level_before": 2, "level_after": 3}],
+        "reproduction_gate": {"reproduced": True, "claimed_level": 3, "reached_level": 3},
+        "verifier_feedback": {
+            "reproduction_gate": {"reproduced": True, "claimed_level": 3, "reached_level": 3}
+        },
+        "solution_labels": ['{"action":6,"data":{"x":20,"y":10}}'],
+        "failure_mode": "",
+        "terminal_state": {"status": "reproduced", "max_level": 3, "target_level": 3},
+    }
+
+
+def _tmp_ready_root(tmp_path: Path, *, registry: dict[str, Any] | None = None) -> Path:
+    root = tmp_path
+    (root / "openspec" / "capabilities" / "arc-human-replay-frame-change").mkdir(parents=True)
+    (root / "ops").mkdir()
+    (root / "results").mkdir()
+    (root / "AGENTS.md").write_text("# AGENTS\n", encoding="utf-8")
+    (root / "CODEX.md").write_text("# CODEX\n", encoding="utf-8")
+    (root / "CLAUDE.md").write_text("# CLAUDE\nARC\n", encoding="utf-8")
+    (root / exp5548.SPEC_RELATIVE_PATH).write_text(
+        "REQ-ARC-FCP-5548\nSCENARIO-ARC-FCP-5548\n",
+        encoding="utf-8",
+    )
+    (root / exp5548.REGISTRY_RELATIVE_PATH).write_text(
+        yaml.safe_dump(registry or _registry()),
+        encoding="utf-8",
+    )
+    (root / exp5548.UPSTREAM_RELATIVE_PATH).write_text(
+        json.dumps(_precheck()),
+        encoding="utf-8",
+    )
+    return root
+
+
+def test_req_arc_fcp_5548_spec_declares_clean_live_artifact_fields() -> None:
+    """REQ-ARC-FCP-5548: OpenSpec anchors the clean live-attempt contract."""
+
+    spec = SPEC_PATH.read_text(encoding="utf-8")
+
+    assert "REQ-ARC-FCP-5548" in spec
+    assert "SCENARIO-ARC-FCP-5548" in spec
+    assert exp5548.RESULT_RELATIVE_PATH in spec
+    for field, principle in exp5548.FIELD_PRINCIPLES.items():
+        assert f"`{field}`" in spec
+        assert principle in spec
+
+
+def test_scenario_arc_fcp_5548_uses_precheck_target_and_rotates_duplicates() -> None:
+    """SCENARIO-ARC-FCP-5548: Exp5547 target is reused unless already banked."""
+
+    selected = exp5548.select_target_from_precheck(_precheck(), _registry())
+    rotated = exp5548.select_target_from_precheck(_precheck(), _registry(g50t_levels=3))
+    not_ready = exp5548.select_target_from_precheck(_precheck(ready=False), _registry())
+    malformed = exp5548.select_target_from_precheck(_precheck(level="bad"), _registry())
+
+    assert selected["blocked"] is False
+    assert selected["selected_game"] == "g50t"
+    assert selected["selected_level"] == "L3"
+    assert selected["target_level"] == 3
+    assert selected["target_rotation"]["rotated"] is False
+    assert rotated["selected_game"] == "lf52"
+    assert rotated["selected_level"] == "L3"
+    assert rotated["target_rotation"]["rotated"] is True
+    assert rotated["target_rotation"]["reason"] == (
+        "exp5547_target_already_banked_rotated_to_adjacent_frontier"
+    )
+    assert not_ready["blocked"] is True
+    assert not_ready["blocker"] == "exp5547_precheck_not_ready"
+    assert malformed["blocker"] == "exp5547_selected_level_malformed"
+
+
+def test_scenario_arc_fcp_5548_artifact_gates_null_and_success(tmp_path: Path) -> None:
+    """SCENARIO-ARC-FCP-5548: only reproduced self-discovery can bank a level."""
+
+    null_artifact = exp5548.build_artifact(
+        target=_target(),
+        attempt=_null_attempt(),
+        registry_updated=False,
+        trajectory_path="results/null-5548.json",
+        precheck=_precheck(),
+        preconditions_checked={"unit": True},
+        tests_run=["unit"],
+        duration_s=0.1,
+        attempt_budget=3,
