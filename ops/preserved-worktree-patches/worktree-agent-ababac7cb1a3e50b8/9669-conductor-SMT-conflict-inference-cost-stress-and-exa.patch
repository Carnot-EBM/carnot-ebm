+            "conflict_stratum": conflict.get("conflict_stratum"),
+            "fixture_row_hash": row.get("source_row_hash"),
+            "spec_refs": ["REQ-BENCH-6546", "SCENARIO-BENCH-6546-CHALLENGE"],
