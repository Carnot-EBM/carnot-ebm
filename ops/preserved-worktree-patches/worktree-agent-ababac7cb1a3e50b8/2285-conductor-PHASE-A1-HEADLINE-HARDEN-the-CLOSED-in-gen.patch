+    check = check_second_corpus_available(
+        items=items,
+        corpus_path=Path(second_corpus_path),
+        min_tasks_per_seed=int(max_tasks_per_seed),
+        seeds=seeds,
+        baseline_corpus_checksum=_exp4315_corpus_checksum(),
+    )
+    return list(items), check
