ved` = "HARD gate -- the energy prior must NOT drop solve-rate."; `chosen_submitted_config` = "what (if anything) is recommended for SUBMITTED_AGENT_CONFIG (enable the goal-energy proposal prior) -- the A6 input; 'unchanged' if null."; `missing_verifier_gaps` = "if no value, which class the energy prior still cannot reach -- the Missing-Verifier Gap Logging entry."; `offline_reproduced` = "any newly-solved variant must offline-reproduce to count."; `random_seed` = "determinism precondition for reproducibility."; `reproducibility_checksum` = "content-addressed hash catches silent drift on replay."; `preconditions_checked` = "records resources verified (offline arcade, goal_distance importable); pre-empts missing-resource fabrication."
