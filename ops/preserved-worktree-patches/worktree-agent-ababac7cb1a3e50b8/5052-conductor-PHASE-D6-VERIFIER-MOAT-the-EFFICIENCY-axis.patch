+@dataclass(frozen=True)
+class PreconditionCheck:
+    """One checked resource recorded before Exp 5034 can claim a result."""
+
+    resource: str
+    available: bool
+    detail: str
+    path: str | None = None
+
+    def as_dict(self) -> JsonDict:
