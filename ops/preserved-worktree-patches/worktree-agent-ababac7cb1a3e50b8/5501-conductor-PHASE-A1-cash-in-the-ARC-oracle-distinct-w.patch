+class BlockedRun(RuntimeError):
+    """Expected precondition failure that still writes a terminal artifact."""
+
+
+@dataclass(frozen=True)
+class Preconditions:
+    exp5160_artifact: dict[str, Any]
+    original_payload: dict[str, Any]
