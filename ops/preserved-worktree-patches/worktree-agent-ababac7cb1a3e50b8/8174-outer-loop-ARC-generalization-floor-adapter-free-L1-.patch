+            "rows": sorted(long_out, key=lambda r: str(r.get("game"))),
+        },
+        # ---- WHY THE SCORED-PATH NULL LOOKS THE WAY IT DOES ----------------------------------
+        # A static, grep-verifiable fact about the code, recorded next to the measurement because
