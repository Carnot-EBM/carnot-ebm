+                pass
+
+    payload = {
+        "experiment": 6093,
+        "experiment_id": "experiment_6093_arc_heldout_identity_generalization",
+        "title": (
+            "Leave-one-game-out adapter-free / held-out-identity measurement on the two "
+            "canonical ARC live entrypoints"
