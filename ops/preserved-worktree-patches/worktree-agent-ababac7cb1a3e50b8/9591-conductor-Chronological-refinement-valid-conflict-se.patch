+    "--include=python/carnot/experiment_6522_chronological_conflict_self_learning.py "
+    "-m pytest tests/python/test_experiment_6522_chronological_conflict_self_learning.py "
+    "-q --no-cov -n 0"
+)
+COVERAGE_REPORT_COMMAND = (
