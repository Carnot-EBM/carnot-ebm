+REPO = Path(__file__).resolve().parents[2]
+SPEC = REPO / mod.SPEC_RELATIVE_PATH
+
+FOCUSED_COMMAND = (
+    ".venv/bin/pytest "
+    "tests/python/test_experiment_6522_chronological_conflict_self_learning.py "
+    "-q --no-cov -n 0"
+)
+COVERAGE_RUN_COMMAND = (
