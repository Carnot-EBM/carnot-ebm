+        n_ctx=cfg["n_ctx"],
+        extra_server_args=cfg["extra_server_args"],
+        max_tokens=8192,  # overridden per-cell by run_reason_cell (reason=8192)
+        timeout=cfg["timeout"],
+        use_chat_template=True,
+    )
