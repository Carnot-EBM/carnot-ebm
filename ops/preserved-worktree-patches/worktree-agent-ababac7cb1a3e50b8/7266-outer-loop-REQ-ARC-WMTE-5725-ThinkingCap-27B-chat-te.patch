+    rows, pre = run_all(pre)
+    art = build_artifact(rows, pre, time.time() - t0)
+    ARTIFACT.write_text(json.dumps(art, indent=2))
+    log(f"WROTE {ARTIFACT.name}: {art['honest_verdict']}")
+    log(f"DONE total {time.time() - t0:.0f}s")
