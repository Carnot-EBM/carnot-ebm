+        "energy_minus_accuracy_delta": -0.15765776352537078,
+        "energy_minus_accuracy_delta_ci95": [-0.47765014592872246, 0.004044943820224719],
+        "n_effective_games": 5,
+        "min_heldout_games": 5,
