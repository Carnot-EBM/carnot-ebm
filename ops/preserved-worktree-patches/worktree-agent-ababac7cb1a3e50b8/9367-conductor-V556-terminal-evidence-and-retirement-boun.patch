+        "zero_byte_paths": [str(row["path"]) for row in zero],
+        "rows": [
+            {
+                "task_id": row["task_id"],
+                "path": row["path"],
+                "exists": row["exists"],
+                "bytes": row["bytes"],
+                "sha256": row["sha256"],
