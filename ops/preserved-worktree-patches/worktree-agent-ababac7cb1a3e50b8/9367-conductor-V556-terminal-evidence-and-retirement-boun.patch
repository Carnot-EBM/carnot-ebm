+def retirement_boundary_rows(
+    rows: Sequence[Mapping[str, Any]],
+) -> list[JsonDict]:
+    by_task = {str(row["task_id"]): row for row in rows}
+    out: list[JsonDict] = []
+    for candidate in RETIREMENT_CANDIDATES:
