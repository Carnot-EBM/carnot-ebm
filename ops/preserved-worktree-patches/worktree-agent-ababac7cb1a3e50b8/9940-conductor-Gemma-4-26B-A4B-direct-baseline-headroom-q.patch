+def assemble_artifact(
+    *,
+    run_date: str,
+    exp6604_artifact: Mapping[str, Any],
+    prompt_contract: Mapping[str, Any],
+    per_unit_rows: Sequence[Mapping[str, Any]],
+    model_identity: Mapping[str, Any],
+    gpu_receipts: Mapping[str, Any],
