+class _NoOpProposer:
+    def induce(self, *_args: Any, **_kwargs: Any) -> tuple[bool, str]:  # pragma: no cover
+        return False, "disabled_exp4617_no_live_llm"
+
+    def world_model_candidates(self, _game: str) -> list[Any]:  # pragma: no cover
+        return []
