+        "preconditions_checked must have exactly the required fields",
+    )
+    expected_true = {
+        "agents_md_read": "AGENTS.md",
+        "codex_md_read": "CODEX.md",
+        "sweep_clusters_help_exit_0": "sweep_clusters.py --help",
