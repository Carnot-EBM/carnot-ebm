+            "ready_score": _mapping_or_empty(raw.get("artifact_isolation")).get("ready_score"),
+            "repository_wide_closure_claimed": _mapping_or_empty(raw.get("artifact_isolation")).get(
+                "repository_wide_closure_claimed"
