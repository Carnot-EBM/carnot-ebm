+                    "structured_over_none_accuracy_lower_bound": 0.0,
+                },
+            }
+        )
+    with pytest.raises(ValueError, match="reproducibility_checksum"):
+        mod.validate_artifact({**artifact, "reproducibility_checksum": "sha256:bad"})
