+def _first_precondition_failure(preconds: Mapping[str, Any]) -> str | None:
+    for key, value in preconds.items():
+        if key == "ok":
+            continue
+        if isinstance(value, Mapping) and not value.get("ok"):
+            return str(key)
+        if not isinstance(value, Mapping) and not value:
+            return str(key)
+    return None
