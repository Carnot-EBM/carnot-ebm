+        }
+        for field in REQUIRED_ARTIFACT_FIELDS
+    }
+    for field, principle in REQUIRED_FIELD_PROVENANCE.items():
+        provenance[field] = {
+            **principle,
+            "satisfied_by": "REQ-ARC-LRHL-5916 principle-annotated artifact contract",
+        }
