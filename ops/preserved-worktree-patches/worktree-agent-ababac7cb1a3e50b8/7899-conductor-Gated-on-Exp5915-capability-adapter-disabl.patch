+def live_metrics(rows: Sequence[Mapping[str, Any]]) -> dict[str, Any]:
+    metrics = live_ab.live_metrics(rows)
+    for arm in ARM_NAMES:
+        arm_rows = [row for row in rows if row.get("arm") == arm]
+        correct = sum(
+            1
