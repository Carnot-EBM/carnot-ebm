+def _counterbalanced_orders() -> list[list[str]]:
+    arms = list(ARM_NAMES)
+    rng = random.Random(RANDOM_SEEDS[0])
+    orders = []
+    for index in range(3):
+        rotated = arms[index:] + arms[:index]
+        rng.shuffle(rotated)
+        orders.append(rotated)
+    return orders
