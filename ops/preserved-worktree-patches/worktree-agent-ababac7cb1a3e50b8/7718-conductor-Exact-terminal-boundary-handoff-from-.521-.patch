+    path.parent.mkdir(parents=True, exist_ok=True)
+    if path.exists():
+        existing = path.read_text(encoding="utf-8")
+        separator = "" if existing.endswith("\n") else "\n"
+        path.write_text(existing + separator + _completion_block_text(), encoding="utf-8")
+    else:
