+def _exact_task_matrix(
+    task_rows: Sequence[JsonMap],
+    metadata: Mapping[str, JsonMap],
+    payloads: Mapping[str, JsonMap],
+    conductor: Mapping[str, JsonMap],
+) -> dict[str, JsonDict]:
