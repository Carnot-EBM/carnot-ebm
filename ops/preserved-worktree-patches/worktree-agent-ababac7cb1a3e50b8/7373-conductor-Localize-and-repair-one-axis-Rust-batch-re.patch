+def _exp5739_first_restart_failure_item() -> dict:
+    protocol = exp5739.preregistered_protocol()
+    workload = [
+        row
+        for row in exp5739.build_workload_manifest()
+        if row["size"] == 96 and row["family"] == "ferromagnetic_ring_easy"
