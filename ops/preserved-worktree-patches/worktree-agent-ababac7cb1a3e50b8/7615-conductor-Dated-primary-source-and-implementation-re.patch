+"""Tests for Exp5838 V520 source-delta ingestion.
+
+Spec refs: REQ-REPORT-5838, SCENARIO-REPORT-5838-ZERO-FINDING,
+SCENARIO-REPORT-5838-ACCEPT-BOUNDED-DELTA,
+SCENARIO-REPORT-5838-BLOCKED-PRECONDITION,
+SCENARIO-REPORT-5838-CLOSED-SCOPE-IMMUTABILITY,
+SCENARIO-REPORT-5838-SCHEMA.
+"""
+
+from __future__ import annotations
+
+import json
+import runpy
+from pathlib import Path
+
+import pytest
+import yaml
+
+from carnot import experiment_5838_v520_source_delta_ingestion as mod
+
+
+REPO = Path(__file__).resolve().parents[2]
+SPEC_PATH = REPO / "openspec/capabilities/research-reporting/spec.md"
+START = "2026-07-23T13:00:00Z"
+FINISH = "2026-07-23T13:01:13Z"
+
+
+def _roadmap() -> str:
+    tasks = []
+    for task_id in mod.ALLOCATED_TARGET_EXPERIMENTS | {
+        "exp5837-transition-v520",
+        "exp5838-v520-source-delta-ingestion",
+        "exp5848-capstone-v520",
+    }:
+        row = {
+            "id": task_id,
+            "milestone": mod.MILESTONE,
+            "title": task_id,
+            "deliverable": f"results/{task_id}.json",
+        }
+        if task_id in {
+            "exp5840-exact-counterfactual-embedding-fixture",
+            "exp5841-sota-comparative-embedding-corpus",
+            "exp5842-cross-family-comparative-energy-verifier",
+            "exp5843-sparse-oracle-continuous-learning",
+            "exp5846-bounded-adaptive-memory-microkernel",
+            "exp5847-attached-board-memory-receipts",
+        }:
+            row["gated_on"] = [
+                {
+                    "upstream": "exp5839-v519-evidence-qualification",
+                    "artifact_field": "constraint_stream_qualified_score",
+                    "op": "==",
+                    "value": 1.0,
+                }
+            ]
+        tasks.append(row)
+    tasks.sort(key=lambda row: row["id"])
+    return yaml.safe_dump({"milestone": mod.MILESTONE, "tasks": tasks}, sort_keys=False)
+
+
+def _planner_references() -> str:
+    return (
+        "## V520 Planner Refresh - 20260723\n\n"
+        "- **Learning from World Feedback** - arXiv:2607.16591.\n"
+        "- **Planning with Transformers: Chain of Computation and Structured "
+        "Context Windows** - arXiv:2607.17710.\n"
+        "- **Ask the World Before Acting** - arXiv:2606.31422.\n"
+        "- **Write-Protected Discrete Bottlenecks** - arXiv:2607.08312.\n"
+        "- **Rethinking Transfer in Continual Learning** - arXiv:2607.15587.\n"
+        "- **Equilibrium-Based Thermodynamic Computing Blueprint** - arXiv:2607.16183.\n"
+        "<!-- V520-PLANNER-REFRESH-20260723-END -->\n"
+    )
+
+
+def _accepted_fixture() -> mod.JsonDict:
+    return {
+        "source_id": "post_v520_fixture_2607_99999",
+        "classification": "accepted",
+        "title": "Post-V520 Fixture for Bounded Memory Admission Receipts",
+        "url": "https://arxiv.org/abs/2607.99999",
+        "publication_date": "2026-07-23",
+        "source_date": "2026-07-23",
+        "search_timestamp": START,
+        "receipt_id": "arxiv_fixture_post_v520",
+        "query": 'all:"bounded memory admission"',
+        "access_outcome": "reachable_fixture",
+        "target_experiment": "exp5839-v519-evidence-qualification",
+        "source_hook": "Add a leakage audit before row-level lifecycle promotion.",
+        "authority_boundary": (
+            "Adds a bounded qualification control inside Exp5839 only; exact "
+            "solvers still own semantic correctness and no roadmap identity changes."
+        ),
+        "post_marker_or_newly_actionable": True,
+        "reason": (
+            "Fixture accepted finding stays inside Exp5839 and does not alter IDs, "
+            "gates, mandatory SOTA models, closed scopes, hardware claims, or "
+            "headline authority."
+        ),
+    }
+
+
+def _ordered_candidates(artifact: mod.JsonDict) -> list[mod.JsonDict]:
+    classes = artifact["finding_classification"]
+    return (
+        classes["accepted"]
+        + classes["duplicate"]
+        + classes["watch_only"]
+        + classes["excluded"]
+        + classes["inaccessible"]
+    )
+
+
+def _make_repo(root: Path, references_text: str, *, with_next: bool = False) -> Path:
+    root.mkdir(parents=True, exist_ok=True)
+    (root / mod.RESEARCH_REFERENCES_RELATIVE_PATH).write_text(
+        references_text,
+        encoding="utf-8",
+    )
+    (root / mod.ROADMAP_RELATIVE_PATH).write_text(_roadmap(), encoding="utf-8")
+    if with_next:
+        (root / mod.ROADMAP_NEXT_RELATIVE_PATH).write_text(_roadmap(), encoding="utf-8")
+    (root / "openspec/change-proposals").mkdir(parents=True, exist_ok=True)
+    (root / mod.VNEXT_RELATIVE_PATH).write_text(
+        "# Research Roadmap vNEXT\n\n"
+        "**Milestone:** `2026.07.520`\n\n"
+        "Exp5838 preserves V520 task identity and gate structure.\n",
+        encoding="utf-8",
+    )
+    (root / "openspec/capabilities/research-reporting").mkdir(parents=True, exist_ok=True)
+    (root / mod.SPEC_RELATIVE_PATH).write_text(
+        "\n".join(mod.SPEC_REFS) + "\n",
+        encoding="utf-8",
+    )
+    (root / "ops").mkdir(parents=True, exist_ok=True)
+    (root / mod.EXCLUSION_MANIFEST_RELATIVE_PATH).write_text(
+        (
+            "retired_extras:\n"
+            "- id: finite_id_generated_answer_transport_closed\n"
+            "  reason: finite-ID generated-answer transport remains retired\n"
+            "- id: phase_d_closed\n"
+            "  reason: external generated-text/logprob PHASE D remains closed\n"
+            "- id: tempering_closed\n"
+            "  reason: tempering remains closed\n"
+            "- id: arc_cegis_public_closed\n"
+            "  reason: ARC CEGIS and public solves remain closed\n"
+            "- id: unchanged_board_probe_closed\n"
+            "  reason: unchanged board probes remain closed\n"
+            "- id: tsu_kona_execution_closed\n"
+            "  reason: TSU and Kona execution require authenticated local receipts\n"
+        ),
+        encoding="utf-8",
+    )
+    (root / mod.KNOWN_ISSUES_RELATIVE_PATH).write_text(
+        "Finite-ID generated-answer transport, external generated-text/logprob PHASE D, "
+        "tempering, ARC CEGIS, public solves, unchanged board probes, TSU execution, "
+        "and Kona execution remain closed.\n",
+        encoding="utf-8",
+    )
+    (root / "scripts").mkdir(parents=True, exist_ok=True)
+    (root / mod.CONDUCTOR_RELATIVE_PATH).write_text("# conductor fixture\n", encoding="utf-8")
+    (root / "results").mkdir(parents=True, exist_ok=True)
+    return root
+
+
+def test_req_report_5838_spec_declares_v520_source_refresh_contract() -> None:
+    """REQ-REPORT-5838: OpenSpec names the V520 field and source contract."""
+
+    spec = SPEC_PATH.read_text(encoding="utf-8")
+    section = spec[spec.index("### REQ-REPORT-5838") :]
+    normalized = " ".join(section.split())
+
+    for marker in (
+        "REQ-REPORT-5838",
+        "SCENARIO-REPORT-5838-ZERO-FINDING",
+        "SCENARIO-REPORT-5838-ACCEPT-BOUNDED-DELTA",
+        "SCENARIO-REPORT-5838-BLOCKED-PRECONDITION",
+        "SCENARIO-REPORT-5838-CLOSED-SCOPE-IMMUTABILITY",
+        "SCENARIO-REPORT-5838-SCHEMA",
+        str(mod.RESULT_RELATIVE_PATH),
+        mod.PLANNER_MARKER,
+        mod.INFERENCE_SUBSTRATE,
+        "`planner_marker_and_search_window`",
+        "`source_receipts`",
+        "`citation_trail_receipts`",
+        "`roadmap_immutability_receipts`",
+    ):
+        assert marker in section
+    for field, principle in mod.REQUIRED_FIELD_PRINCIPLES.items():
+        assert f"`{field}`" in section
+        assert " ".join(principle.split()) in normalized
+
+
+def test_scenario_report_5838_zero_finding_keeps_references_unchanged(
+    tmp_path: Path,
+) -> None:
+    """SCENARIO-REPORT-5838-ZERO-FINDING: zero accepted deltas are complete."""
+
+    root = _make_repo(tmp_path, _planner_references())
+
+    artifact = mod.build_and_write_artifact(
+        root=root,
+        search_started_at=START,
+        search_finished_at=FINISH,
+        accepted_findings=[],
+        test_commands=["unit"],
+        test_exit_codes={"unit": 0},
+        duration_s=73.0,
+    )
+
+    mod.validate_artifact(artifact)
+    references = (root / mod.RESEARCH_REFERENCES_RELATIVE_PATH).read_text(encoding="utf-8")
+    result_text = (root / mod.RESULT_RELATIVE_PATH).read_text(encoding="utf-8")
+
+    assert result_text.endswith("\n")
+    assert mod.EXECUTION_REFRESH_HEADING not in references
+    assert artifact["status"] == "complete"
+    assert artifact["finding_classification"]["accepted"] == []
+    assert artifact["accepted_finding_count"] == 0
+    assert artifact["references_modified"] is False
+    assert artifact["planner_marker_and_search_window"]["boundary_marker"] == mod.PLANNER_MARKER
+    assert artifact["preconditions_checked"]["network_search_available"] is True
+    assert artifact["preconditions_checked"]["research_roadmap_next_read"] is False
+    assert artifact["roadmap_immutability_receipts"]["roadmap_ids_unchanged"] is True
+    assert artifact["roadmap_immutability_receipts"]["gates_unchanged"] is True
+    assert artifact["roadmap_immutability_receipts"]["closed_scopes_reopened"] is False
+    assert artifact["roadmap_immutability_receipts"]["hardware_claim_changed"] is False
+    assert artifact["roadmap_immutability_receipts"]["headline_claim_changed"] is False
+    assert artifact["inference_substrate"] == mod.INFERENCE_SUBSTRATE
+    assert artifact["honest_verdict"].startswith("complete: no accepted")
+
+
+def test_scenario_report_5838_accept_delta_appends_once(tmp_path: Path) -> None:
+    """SCENARIO-REPORT-5838-ACCEPT-BOUNDED-DELTA: accepted controls append once."""
+
+    root = _make_repo(tmp_path, _planner_references(), with_next=True)
+
+    artifact = mod.build_and_write_artifact(
+        root=root,
+        search_started_at=START,
+        search_finished_at=FINISH,
+        accepted_findings=[_accepted_fixture()],
+        duration_s=73.0,
+    )
+
+    mod.validate_artifact(artifact)
+    references = (root / mod.RESEARCH_REFERENCES_RELATIVE_PATH).read_text(encoding="utf-8")
+
+    assert references.count(mod.EXECUTION_REFRESH_HEADING) == 1
+    assert "Post-V520 Fixture" in references
+    assert "exp5839-v519-evidence-qualification" in references
+    assert references.index(mod.EXECUTION_REFRESH_HEADING) > references.index(
+        mod.PLANNER_HEADING
+    )
+    assert artifact["accepted_finding_count"] == 1
+    assert artifact["finding_classification"]["accepted"][0]["target_experiment"] == (
+        "exp5839-v519-evidence-qualification"
+    )
+    assert artifact["references_modified"] is True
+    assert artifact["roadmap_immutability_receipts"]["roadmap_ids_unchanged"] is True
+    assert artifact["roadmap_immutability_receipts"]["gates_unchanged"] is True
+    assert artifact["honest_verdict"].startswith("complete: accepted 1")
+    assert artifact["field_provenance"]["accepted_findings"][0]["source_id"] == (
+        "post_v520_fixture_2607_99999"
+    )
+
+    second = mod.build_and_write_artifact(
+        root=root,
+        search_started_at="2026-07-23T13:02:00Z",
+        search_finished_at="2026-07-23T13:02:01Z",
+        accepted_findings=[_accepted_fixture()],
+        duration_s=1.0,
+    )
+    references_second = (root / mod.RESEARCH_REFERENCES_RELATIVE_PATH).read_text(
+        encoding="utf-8"
+    )
+    assert references_second.count(mod.EXECUTION_REFRESH_HEADING) == 1
+    assert second["references_modified"] is False
+
+
+def test_scenario_report_5838_blocked_preconditions(tmp_path: Path) -> None:
+    """SCENARIO-REPORT-5838-BLOCKED-PRECONDITION: stale marker/routes fail closed."""
+
+    references_text = "## V518 Planner Refresh - 20260723\nKnown references only.\n"
+    root = _make_repo(tmp_path, references_text)
+
+    artifact = mod.build_and_write_artifact(
+        root=root,
+        search_started_at=START,
+        search_finished_at=FINISH,
+        accepted_findings=[_accepted_fixture()],
+        duration_s=73.0,
+    )
+
+    mod.validate_artifact(artifact)
