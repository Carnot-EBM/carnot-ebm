+   ],
+   "why_that_is_vacuous": "those engines' keyboard actions are no-ops, so banning them cannot lose anything and an identical state set is GUARANTEED, not evidence.",
+   "the_only_non_vacuous_row": "dc22 -- bans 1, 2, 5 while 3 and 4 stay productive",
+   "non_vacuous_n": 1,
+   "the_session_report_said_three_games_ban_all_five": "it is FIVE. Corrected here."
+  },
+  "THE_CONSTRUCTED_COUNTEREXAMPLE": {
+   "why_it_was_needed": "the risk the harness's own docstring names -- an action inert early and productive later -- does not occur in the 25-game corpus, so it had to be built.",
+   "the_ban_rule_is_ABSORBING_by_construction": {
+    "rule": "kept = [a for a in keys if key_new[a] > 0 or key_calls[a] == 0]",
+    "why_it_cannot_recover": "a banned action is never emitted again, so key_new[a] can never grow. There is no un-ban path in the expression."
+   },
+   "fixture": {
+    "shape": "actions 1-4 fill the row up to gate_depth; action 5 is inert until then, and is the ONLY action that can extend past it",
+    "gate_depth": 4,
+    "width": 8,
+    "warmup_expansions": 3
+   },
+   "result": {
+    "states_lost": 1024,
+    "states_gained": 0,
+    "state_sets_identical": false,
+    "states_still_lost_at_5x_expansions": 1024,
+    "loss_is_permanent_not_a_frontier_delay": true,
+    "action_5_was_banned": true
+   },
+   "verdict": "the inert-keyboard ban is NOT lossless in general. On a mechanic where an action is inert before a gate and the only way forward after it, the ban fires during the inert phase and is never lifted, so every state past the gate becomes unreachable -- and stays unreachable at 5x the expansion budget. The 26-game corpus agreed only because no game in it has that shape: 5 of the 6 deep-tested games ban ALL FIVE keyboard actions (no-ops, so the ban is free) and just one, dc22, exercises the lever at all.",
+   "artifact": "scratchpad/p3/p3_inert_keyboard_adversarial.json"
+  },
+  "restated": "L1 = dedup (safe by construction) + an INDUCTIVE ban with ~1 game of non-vacuous support and a constructed counterexample that loses 75% of reachable states permanently. The two halves must be separable, and only the dedup half may be called safe. Dedup alone accounts for 1.095-1.433x of the call reduction on the deep-tested games, so the safe half carries most of the (already small) win.",
+  "if_the_ban_ever_ships": "it needs an un-ban path -- re-probe a banned action every K expansions, or require N distinct non-responding states before banning -- because as written a single inert phase removes the action for the rest of the search."
+ },
+ "CORRECTION_4_plan_preservation_is_verified_on_two_rows": {
+  "the_claim_as_published": "all five arms keep the 11-step plan",
+  "what_is_actually_verified": {
+   "ka59_plan_length_11_across_all_five_arms": true,
+   "rows_with_a_non_null_L1_goal_preserved_flag": [
+    "m0r0"
+   ],
+   "every_other_row": "state-partition / accept-sequence identity only, with no goal reached inside the 1500-expansion cap -- so those rows say nothing about plan preservation."
+  },
+  "restated": "plan/goal preservation is verified on ka59 (length 11, all arms) and m0r0. The other 24 rows are state-set identity. The distinction matters because a pruned candidate set can preserve the explored set at a shallow cap and still lose the goal deeper."
+ },
+ "CORRECTION_5_one_statistical_basis_per_sentence": {
+  "what_was_published": "'1.15x median (range 1.007-1.461)' -- the median over all 25 numeric rows including seven at exactly 1.0, but the range excluding those seven. Two denominators in one sentence, in the direction that flatters the lever's floor.",
+  "corrected_all_numeric_rows": {
