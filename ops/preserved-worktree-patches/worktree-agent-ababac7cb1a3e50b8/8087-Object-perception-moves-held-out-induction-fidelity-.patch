+        
+        # Check connectivity
+        start_node = cells[0]
+        visited = set()
+        stack = [start_node]
+        
+        while stack:
+            curr = stack.pop()
+            curr_tuple = tuple(curr)
+            if curr_tuple not in visited:
+                visited.add(curr_tuple)
+                # Find neighbors of the same color
+                for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:
