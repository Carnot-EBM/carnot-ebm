+          principle: "Each attempted tracked write is named with before and after hashes."
+        active_worktree_unchanged:
+          principle: "The user's tracked hashes and pre-existing dirty state survive the run unchanged."
+        suite_truth_baseline:
+          principle: "GREEN or RED follows from test rows, exit, collection, mutation, and cleanup."
+        full_suite_baseline_ready_score:
+          principle: "This binary field means the suite truth was measured, even when the truth is RED."
+        low_cadence_ownership_contract:
+          principle: "The full suite remains outside per-experiment launch checks."
+        attack_rows:
+          principle: "Partial, mutating, leaked, and falsely green runs fail closed."
+        preconditions_checked:
+          principle: "Resources, versions, dirty state, ownership, and safe paths are explicit."
+        protected_files_unchanged:
