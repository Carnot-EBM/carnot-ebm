+  - id: exp6586-isolated-full-suite-truth-baseline
+    milestone: "2026.08.573"
+    deliverable: results/experiment_6586_isolated_full_suite_truth_baseline.json
+    title: "Isolated repo-wide suite truth baseline and mutation audit"
+    priority: critical
