+        duration_s:
+          principle: "Monotonic duration exposes collection-only or truncated execution."
+        tests_run:
+          principle: "Focused validation commands are separate from the measured full-suite command."
+        reproducibility_checksum:
+          principle: "A final hash protects the baseline record."
