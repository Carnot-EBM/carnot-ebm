+    assert details["extropic_writing"]["status"] == "ok"
+    assert details["logical_intelligence"]["status"] == "ok"
+    assert "HTTP 429" in details["semantic_scholar"]["result"]
+    assert "2507.02092" in details["semantic_scholar"]["queries"][0]
