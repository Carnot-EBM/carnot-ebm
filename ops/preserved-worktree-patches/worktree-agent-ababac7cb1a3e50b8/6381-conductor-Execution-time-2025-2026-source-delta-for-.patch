+def test_scenario_report_5469_appends_refresh_section_idempotently() -> None:
+    """SCENARIO-REPORT-5469-APPEND-DELTAS: references append once."""
+
+    artifact = mod.build_artifact()
+    original = "# Research References\n\n### V497 Planner Refresh - 20260709\nOld V497 section.\n"
+
+    updated = mod.append_refresh_section(original, artifact)
+    second = mod.append_refresh_section(updated, artifact)
+
+    assert updated == second
+    assert updated.startswith(original)
+    assert updated.count(mod.REFRESH_HEADING) == 1
+    assert "Pitwall" in updated
+    assert "LatentGym" in updated
+    assert "No active `.497` roadmap edit is required" in updated
+    assert "No closed scope was reopened" in updated
+    assert mod.REFRESH_END_MARKER in updated
+
+
+def test_scenario_report_5469_no_new_delta_leaves_references_unchanged() -> None:
+    """SCENARIO-REPORT-5469-NO-NEW-DELTA: zero-new refresh does not churn references."""
