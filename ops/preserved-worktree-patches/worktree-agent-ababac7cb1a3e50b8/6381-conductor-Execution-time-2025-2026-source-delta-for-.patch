+    assert "non-local TSU" in watch_text
+    assert "Kona or Aleph" in watch_text
+    assert "GRPO" in watch_text
+    assert "broad RL" in watch_text
+    assert "logprob" in watch_text
+    assert "hardware speedup" in watch_text
