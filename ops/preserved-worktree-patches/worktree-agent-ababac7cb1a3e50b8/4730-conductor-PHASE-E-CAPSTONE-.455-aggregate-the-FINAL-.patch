+def _headline(
+    total: int,
+    banks: Mapping[str, Any],
+    heldout: Mapping[str, Any],
+    package: Mapping[str, Any],
+    pivot: Mapping[str, Any],
+) -> str:
+    counted = banks.get("counted") if isinstance(banks.get("counted"), list) else []
+    bank_text = "no trusted A1/A2 banks counted" if not counted else f"{len(counted)} trusted banks counted"
+    package_text = "package ready" if package.get("ready") is True else "package not ready"
+    pivot_text = (
+        "post-6/30 verifier-moat pivot executable 7/1"
+        if pivot.get("pivot_executable_on_7_1") is True
+        else "post-6/30 verifier-moat pivot not trusted executable"
+    )
+    return (
+        f".455 final submission readiness: locked ~0.05 agent + FoVer paper ready for "
+        f"6/30 at {total} reproducible levels, {bank_text}; held-out first-win "
+        f"{_rate_slug(heldout)} with flag_resolved={heldout.get('flag_resolved') is True}; "
+        f"{package_text}; {pivot_text}; ARC wall remains WALL_IS_HIDDEN_STATE closed."
+    )
