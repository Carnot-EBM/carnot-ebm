+        "moat_proven_claimed": False,
+        "arxiv_ids_cited": ["2605.18871", "2504.16828", "2502.01989"],
+    }
+
+
+def _audit(*, banks_trustworthy: bool = True, pivot_trustworthy: bool = True) -> JsonDict:
+    return {
