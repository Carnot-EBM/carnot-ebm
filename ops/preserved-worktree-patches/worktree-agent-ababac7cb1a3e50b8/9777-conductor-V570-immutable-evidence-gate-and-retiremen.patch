+        if isinstance(task, Mapping)
+    }
+    retired = _retired_experiment_ids(_load_yaml(repo_root / EXCLUSION_MANIFEST_RELATIVE_PATH))
+    return roadmap, fields_by_task, retired, _retired_dependency_ids(roadmap, retired)
