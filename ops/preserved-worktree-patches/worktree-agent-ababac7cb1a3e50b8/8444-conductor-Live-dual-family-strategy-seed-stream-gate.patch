+class StrategyGenerationBackend(Protocol):
+    def generate(
+        self,
+        *,
+        model_spec: JsonDict,
+        public_tasks: list[JsonDict],
+        sample_plan: list[JsonDict],
+        generation_config: JsonDict,
+    ) -> JsonDict:
+        """Return raw generation rows for the model-specific sample plan."""
