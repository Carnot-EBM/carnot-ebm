+        "same_decision_visible_before_generation_count": 0,
+        "all_commits_after_outcome": all(
+            bool(row.get("commit_after_outcome"))
+            for row in receipts
+            if row.get("action") == "commit"
+        ),
+        "sample_receipts": receipts[:8],
+    }
