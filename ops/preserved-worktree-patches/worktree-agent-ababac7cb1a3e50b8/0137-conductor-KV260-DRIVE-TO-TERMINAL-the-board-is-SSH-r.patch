+    "ConnectTimeout=5",
+    "-o",
+    "BatchMode=yes",
+    "kria",
+    "true",
+)
+KV260_LISTAPPS_COMMAND = ("ssh", "kria", "xmutil listapps")
+KV260_LOADAPP_COMMAND = ("ssh", "kria", "xmutil loadapp carnot_ising_v2_n64")
+KV260_LISTAPPS_SUDO_COMMAND = ("ssh", "kria", "sudo xmutil listapps")
+KV260_LOADAPP_SUDO_COMMAND = (
+    "ssh",
