+def _truthy_multi_level(attempt: Mapping[str, Any]) -> bool:
+    if not _truthy_first_win(attempt):
+        return False
+    try:
+        return int(attempt.get("reached_level") or 0) >= 2
+    except (TypeError, ValueError):
+        return False
