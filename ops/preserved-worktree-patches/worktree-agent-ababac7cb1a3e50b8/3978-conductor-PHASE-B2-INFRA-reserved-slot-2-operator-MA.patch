+def _iter_real_fields(value: Any, path: tuple[str, ...] = ()) -> list[tuple[tuple[str, ...], Any]]:
+    """Walk artifact fields while skipping metadata principle prose."""
+    rows: list[tuple[tuple[str, ...], Any]] = []
