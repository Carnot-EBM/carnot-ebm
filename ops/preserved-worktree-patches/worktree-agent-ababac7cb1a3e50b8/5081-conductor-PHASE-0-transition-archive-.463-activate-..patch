+def _runner(calls: list[list[str]], *, pretest_ok: bool = True):
+    def run(command: list[str], _root: Path) -> mod.CommandResult:
+        calls.append(command)
+        return mod.CommandResult(command, 0 if pretest_ok else 1, "passed", "failed")
+
+    return run
+
