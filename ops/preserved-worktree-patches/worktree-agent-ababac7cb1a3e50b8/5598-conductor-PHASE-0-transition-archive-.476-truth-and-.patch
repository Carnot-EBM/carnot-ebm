+            5207 if active else 5193,
+            5219 if active else 5206,
+        ),
+        encoding="utf-8",
+    )
+    if next_file:
+        (root / "research-roadmap-next.yaml").write_text(
+            _roadmap("2026.07.477", 5207, 5219), encoding="utf-8"
+        )
