+def candidate_mode_matrix(template_metadata: Mapping[str, Any]) -> list[JsonDict]:
+    """Preregister bounded per-family modes for the downstream real-GGUF canary."""
+
+    modes: list[JsonDict] = []
+    for hf_id in MANDATED_MODEL_IDS:
