+REPO = Path(__file__).resolve().parents[2]
+SPEC = REPO / "openspec/capabilities/verifiable-reasoning/spec.md"
+TEST_COMMAND = (
+    ".venv/bin/pytest "
+    "tests/python/test_experiment_6126_phase_d_exp6115_transport_forensics.py "
