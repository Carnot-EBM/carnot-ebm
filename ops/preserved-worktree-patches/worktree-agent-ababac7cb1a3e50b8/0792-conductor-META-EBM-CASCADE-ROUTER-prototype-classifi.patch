+    with pytest.raises(ValueError, match="bare ints"):
+        exp3918.validate_artifact(dict(complete, n_calibration=10.0))
+    with pytest.raises(ValueError, match="positive"):
+        exp3918.validate_artifact(dict(complete, n_heldout=0))
