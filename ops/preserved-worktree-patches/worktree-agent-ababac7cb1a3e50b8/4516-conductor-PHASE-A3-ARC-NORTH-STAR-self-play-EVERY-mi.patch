diff --git a/tests/python/test_experiment_4885_self_play_verifier_checkpoint.py b/tests/python/test_experiment_4885_self_play_verifier_checkpoint.py
new file mode 100644
index 0000000000..a669b0ee51
--- /dev/null
+++ b/tests/python/test_experiment_4885_self_play_verifier_checkpoint.py
@@ -0,0 +1,363 @@
+"""Tests for Exp 4885 ARC self-play verifier checkpoint refresh.
+
+Spec refs: REQ-ARC-WMTE-4885,
+SCENARIO-ARC-WMTE-4885-CHECKPOINT-REFRESHED,
+SCENARIO-ARC-WMTE-4885-RESIDUAL-NO-FABRICATION,
+SCENARIO-ARC-WMTE-4885-BLOCKED-PRECONDITION.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from carnot import experiment_4874_self_play_verifier_checkpoint as exp4874
+from carnot import experiment_4885_self_play_verifier_checkpoint as exp4885
+
+
+REPO = Path(__file__).resolve().parents[2]
+SPEC_PATH = REPO / "openspec" / "capabilities" / "arc-world-model-trust-energy" / "spec.md"
+
+
+def _loop_result(game: str, reached_level: int = 2, reproduced: bool = True) -> dict[str, object]:
+    return {
+        "game": game,
+        "reached_level": reached_level,
+        "offline_reproduced": reproduced,
+        "reproduced_levels": reached_level if reproduced else 0,
+        "states_expanded": 61,
+        "learned_verifier_checkpoint": f"models/arc_verifier_{game}.json",
+        "solve_provenance": "live_agent_self_discovery",
+        "reproduction_gate": {
+            "game": game,
+            "claimed_level": reached_level,
+            "reached_level": reached_level,
+            "reproduced": reproduced,
+        },
+    }
+
+
+def _success_artifact(tmp_path: Path, monkeypatch) -> dict[str, object]:
+    ckpt = tmp_path / "models" / "arc_verifier_ls20.json"
+    ckpt.parent.mkdir()
+    ckpt.write_text('{"ok": true}\n', encoding="utf-8")
+    before_ns = ckpt.stat().st_mtime_ns - 1
+    monkeypatch.setattr(exp4885, "REPO", tmp_path)
+
+    summary = exp4885.summarize_loop_result(
+        game="ls20",
+        loop_result=_loop_result("ls20"),
+        loop_result_path="results/arc_loop_solve_ls20.json",
+        checkpoint_mtime_before_ns=before_ns,
+    )
+    return exp4885.build_artifact(
+        target_selection={
+            "game": "ls20",
+            "prior_level": 2,
+            "banked": True,
+            "reason": "rotated_banked_target_warm_start_ls20",
+        },
+        loop_summary=summary,
+        preconditions_checked={
+            "offline_arcade": {"ok": True},
+            "registry_loadable": {"ok": True},
+            "target_banked": {"ok": True, "game": "ls20"},
+            "checkpoint_existing": {"ok": True, "path": "models/arc_verifier_ls20.json"},
+            "target_rotation": {"ok": True, "game": "ls20", "rotated_off": "re86"},
+        },
+    )
+
+
+def test_req_arc_wmte_4885_spec_declares_required_contract() -> None:
+    """REQ-ARC-WMTE-4885: OpenSpec anchors the 4885 checkpoint contract."""
+
+    spec = SPEC_PATH.read_text(encoding="utf-8")
+
+    for ref in exp4885.SPEC_REFS:
+        assert ref in spec
+    assert exp4885.RESULT_RELATIVE_PATH in spec
+    for field, principle in exp4885.FIELD_PRINCIPLES.items():
+        assert field in spec
+        assert principle in spec
+
+
+def test_scenario_arc_wmte_4885_checkpoint_refreshed_success(
+    tmp_path: Path, monkeypatch
+) -> None:
+    """SCENARIO-ARC-WMTE-4885-CHECKPOINT-REFRESHED: ls20 gate plus mtime succeeds."""
+
+    artifact = _success_artifact(tmp_path, monkeypatch)
+
+    assert artifact["experiment"] == exp4885.EXPERIMENT
+    assert artifact["schema"] == exp4885.SCHEMA
+    assert artifact["spec_refs"] == exp4885.SPEC_REFS
+    assert artifact["random_seed"] == exp4885.RANDOM_SEED
+    assert artifact["field_principles"] == exp4885.FIELD_PRINCIPLES
+    assert artifact["honest_verdict"] == "success_self_play_checkpoint_refreshed"
+    assert artifact["verifier_checkpoint_refreshed"] is True
+    assert artifact["checkpoint_path"] == "models/arc_verifier_ls20.json"
+    assert artifact["target_game"] == "ls20"
+    assert artifact["inference_substrate"] == "live_llm_inference"
+    assert artifact["solve_provenance"] == "live_agent_self_discovery"
+    assert artifact["offline_reproduced"] is True
+    assert artifact["reproduced_levels"] == 2
+    assert artifact["states_expanded"] == 61
+    assert artifact["search_state_count"] == 61
+    assert artifact["self_play_residual"] == "checkpoint_refreshed_gate_passed"
+    assert int(artifact["checkpoint_mtime_after_ns"]) > int(artifact["checkpoint_mtime_before_ns"])
+    assert artifact["checkpoint_mtime_delta_ns"] > 0
+    assert artifact["schema_errors"] == []
+    assert exp4885.artifact_schema_errors(artifact) == []
+
+
+def test_scenario_arc_wmte_4885_residual_and_blocked_paths(
+    tmp_path: Path, monkeypatch
+) -> None:
+    """SCENARIO-ARC-WMTE-4885-RESIDUAL-NO-FABRICATION: failures stay residuals."""
+
+    monkeypatch.setattr(exp4885, "REPO", tmp_path)
+    failed = _loop_result("ls20", reached_level=0, reproduced=False)
+    failed["learned_verifier_checkpoint"] = None
+
+    summary = exp4885.summarize_loop_result(
+        game="ls20",
+        loop_result=failed,
+        loop_result_path="results/arc_loop_solve_ls20.json",
+        checkpoint_mtime_before_ns=123,
+    )
+    artifact = exp4885.build_artifact(
+        target_selection={
+            "game": "ls20",
+            "prior_level": 2,
+            "banked": True,
+            "reason": "rotated_banked_target_warm_start_ls20",
+        },
+        loop_summary=summary,
+        preconditions_checked={
+            "offline_arcade": {"ok": True},
+            "registry_loadable": {"ok": True},
+            "checkpoint_existing": {"ok": False},
+            "target_rotation": {"ok": True, "game": "ls20", "rotated_off": "re86"},
+        },
+    )
+    blocked = exp4885.build_blocked_artifact(
+        reason="checkpoint_missing",
+        preconditions_checked={
+            "offline_arcade": {"ok": True},
+            "registry_loadable": {"ok": True},
+            "target_banked": {"ok": True, "game": "ls20", "prior_level": 2},
+            "checkpoint_existing": {"ok": False, "path": "models/arc_verifier_ls20.json"},
+            "target_rotation": {"ok": True, "game": "ls20", "rotated_off": "re86"},
+        },
+        target_game="ls20",
+    )
+    missing = exp4885.summarize_loop_result(
+        game="ls20",
+        loop_result=None,
+        loop_result_path="results/arc_loop_solve_ls20.json",
+        checkpoint_mtime_before_ns="bad",
+    )
+
+    assert artifact["honest_verdict"] == "complete_ls20_self_play_residual_reproduction_gate_failed"
+    assert artifact["verifier_checkpoint_refreshed"] is False
+    assert artifact["checkpoint_path"] is None
+    assert artifact["checkpoint_mtime_after_ns"] is None
+    assert artifact["checkpoint_mtime_delta_ns"] is None
+    assert artifact["schema_errors"] == []
+    assert blocked["honest_verdict"] == "blocked_checkpoint_missing"
+    assert blocked["target_game"] == "ls20"
+    assert blocked["verifier_checkpoint_refreshed"] is False
+    assert blocked["schema_errors"] == []
+    assert missing["self_play_residual"] == "loop_result_missing"
+    assert missing["checkpoint_mtime_before_ns"] is None
+    assert missing["search_state_count"] == 0
+
+
+def test_req_arc_wmte_4885_schema_rejects_stale_metadata_and_re86_success(
+    tmp_path: Path, monkeypatch
+) -> None:
+    """REQ-ARC-WMTE-4885: schema rejects stale identity and prior-target success."""
+
+    artifact = _success_artifact(tmp_path, monkeypatch)
+
+    for field, old_value, expected in (
+        ("experiment", exp4874.EXPERIMENT, "experiment_mismatch"),
+        ("schema", exp4874.SCHEMA, "schema_mismatch"),
+        ("spec_refs", exp4874.SPEC_REFS, "spec_refs_mismatch"),
+        ("random_seed", exp4874.RANDOM_SEED, "random_seed_mismatch"),
+    ):
+        stale = dict(artifact)
+        stale[field] = old_value
+        stale["reproducibility_checksum"] = exp4885.stable_checksum(stale)
+        assert expected in exp4885.artifact_schema_errors(stale)
+
+    wrong_verdict = dict(artifact, honest_verdict="success_ls20_L2_checkpoint_refreshed")
+    wrong_verdict["reproducibility_checksum"] = exp4885.stable_checksum(wrong_verdict)
+    assert "success_verdict_mismatch" in exp4885.artifact_schema_errors(wrong_verdict)
+
+    bad_principle = dict(artifact, field_principles={})
+    bad_principle["reproducibility_checksum"] = exp4885.stable_checksum(bad_principle)
+    assert "missing_principle:target_game" in exp4885.artifact_schema_errors(bad_principle)
+
+    missing_result_path = dict(artifact)
+    missing_result_path.pop("result_path")
+    missing_result_path["reproducibility_checksum"] = exp4885.stable_checksum(
+        missing_result_path
+    )
+    result_path_errors = exp4885.artifact_schema_errors(missing_result_path)
+    assert "missing_field:result_path" in result_path_errors
+    assert "result_path_mismatch" in result_path_errors
+
+    monkeypatch.setattr(
+        exp4885,
+        "REQUIRED_FIELDS",
+        exp4885.REQUIRED_FIELDS + ("exp4885_only_field",),
+    )
+    exp4885_only_missing = dict(artifact)
+    exp4885_only_missing["reproducibility_checksum"] = exp4885.stable_checksum(
+        exp4885_only_missing
+    )
+    assert "missing_field:exp4885_only_field" in exp4885.artifact_schema_errors(
+        exp4885_only_missing
+    )
+
+    missing_checkpoint_check = dict(artifact, preconditions_checked={})
+    missing_checkpoint_check["reproducibility_checksum"] = exp4885.stable_checksum(
+        missing_checkpoint_check
+    )
+    assert "preconditions_missing_checkpoint_check" in exp4885.artifact_schema_errors(
+        missing_checkpoint_check
+    )
+
+    success_without_gate = dict(artifact, reproduced_levels="bad")
+    success_without_gate["reproducibility_checksum"] = exp4885.stable_checksum(
+        success_without_gate
+    )
