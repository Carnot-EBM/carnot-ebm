+def _rate_limits(source_receipts: Sequence[JsonDict]) -> list[JsonDict]:
+    return [
+        {
+            "receipt_id": row["receipt_id"],
+            "source_family": row["source_family"],
+            "rate_limit": row["rate_limit"],
+        }
+        for row in source_receipts
+        if "rate_limit" in row
