+def _roadmap() -> str:
+    tasks = [
+        {
+            "id": mod.EXPERIMENT_ID,
+            "milestone": mod.MILESTONE,
+            "title": "source refresh",
+            "deliverable": mod.RESULT_RELATIVE_PATH.as_posix(),
+            "model": "gpt-5.5",
