+
+REQUIRED_FIELDS = (
+    "schema",
+    "experiment",
+    "experiment_id",
+    "spec_refs",
+    "result_path",
+    "archived_milestone",
+    "activated_milestone",
+    "honest_verdict",
+    "inference_substrate",
+    "arc_sprint_retired",
+    "phase_d_unlocked_majority_lever",
+    "arc_deliverable_locked",
+    "reproducible_total_levels",
+    "preconditions_checked",
+    "pretest_gate",
