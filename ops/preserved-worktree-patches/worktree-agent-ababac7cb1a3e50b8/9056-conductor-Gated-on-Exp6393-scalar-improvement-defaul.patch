+        capture_output=True,
+        text=True,
+        timeout=10,
+        check=False,
+    )
+    rows: list[JsonDict] = []
+    for line in proc.stdout.splitlines():
+        parts = [part.strip() for part in line.split(",", 4)]
+        if len(parts) != 5:
+            continue
+        index, name, total, used, util = parts
+        rows.append(
+            {
+                "index": int(index),
+                "name": name,
+                "memory_total_mib": int(total),
+                "memory_used_mib": int(used),
+                "utilization_gpu_pct": int(util),
+            }
+        )
+    return rows
