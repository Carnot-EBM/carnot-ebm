+FAILURE_CATEGORIES = (
+    "prompt_contract_miss",
+    "grammar_runtime_unavailable",
+    "grammar_mask_not_applied",
+    "max_tokens_truncation",
+    "json_extraction_failure",
+    "json_schema_invalid",
+    "required_field_missing",
