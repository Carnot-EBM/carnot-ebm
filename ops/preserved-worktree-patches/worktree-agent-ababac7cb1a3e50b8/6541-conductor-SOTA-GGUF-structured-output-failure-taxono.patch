+    "model_specs",
+    "smoke_models_used",
+    "fixture_rows_checked",
+    "live_rows_checked",
+    "failure_taxonomy_counts",
+    "prompt_prefix_hashes",
+    "grammar_runtime_available",
+    "grammar_mask_applied",
+    "truncation_detected",
+    "json_extraction_success_rate",
+    "schema_validity_rate",
+    "exact_validator_handoff_ready",
