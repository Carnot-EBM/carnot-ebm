+    pol.pi = 0
+    pol.phase = "execute"
+    pol.induced = True
+    frames = [_Frame(_grid(9))]
+    pol.next_move(frames, frames[-1])
+    pol.next_move(frames, frames[-1])
+
+    s = pol.action_provenance().summary()
