+def _existing_execution_findings(references_text: str) -> list[JsonDict]:
+    section = _execution_section(references_text)
+    return [
+        _clone_json(finding)
+        for finding in CANDIDATE_FINDINGS
+        if section and _finding_present(section, finding)
+    ]
