+    assert "lazy_identity_deq_2607_11116" in suppressed_ids
+    assert artifact["honest_verdict"].startswith("complete:")
+
+
+def test_scenario_report_5604_missing_planner_marker_blocks_append(tmp_path: Path) -> None:
