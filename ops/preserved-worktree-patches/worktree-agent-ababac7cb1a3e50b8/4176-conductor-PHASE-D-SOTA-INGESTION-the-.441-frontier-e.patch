+
+def source_set_checksum(
+    citations: JsonMap,
+    methods: Sequence[JsonMap],
+    flags: Sequence[JsonMap],
+    s1_context: JsonMap,
+) -> str:
+    payload = json.dumps(
+        {
+            "citations": citations,
+            "flags": list(flags),
+            "methods": list(methods),
+            "s1_context": s1_context,
+        },
+        sort_keys=True,
+        separators=(",", ":"),
+    ).encode("utf-8")
+    return "sha256:" + hashlib.sha256(payload).hexdigest()
