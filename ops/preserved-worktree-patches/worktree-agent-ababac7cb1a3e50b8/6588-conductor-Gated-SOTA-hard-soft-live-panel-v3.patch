+
+    assert artifact["rows_emitted"] == 4
+    assert len(artifact["extra_emitted_rows"]) == 1
+    assert artifact["parse_failures"] == [
+        {"parse_status": "runtime_error", "detail": "unit_runtime_warning"}
+    ]
