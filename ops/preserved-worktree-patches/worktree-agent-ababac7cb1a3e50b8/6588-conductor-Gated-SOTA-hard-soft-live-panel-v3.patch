+def run_live_local_sota_panel(
+    *,
+    model_specs: Sequence[Mapping[str, Any]],
+    prompt: str,
+    prompt_hash: str,
+    grammar_backend: str,
+    pair_resolver: PairResolver,
+    max_live_models: int,
+) -> list[JsonDict]:  # pragma: no cover
+    """Run bounded local GGUF calls for one or two mandated SOTA models."""
