+def _memorizing_hypothesis(rows: Sequence[Mapping[str, Any]]) -> dict[str, Any]:
+    predictions = {
+        _row_id(row): (
+            _successor(row)
+            if row.get("split") == "seen"
+            else sha256_json({"memorized_seen_only": _row_id(row)})
+        )
+        for row in rows
+    }
+    return {
+        "model_id": "memorizing_canary",
+        "immutable": True,
