+def test_sidecar_and_mapping_fail_closed_edges(tmp_path: Path) -> None:
+    """REQ-VERIFY-6888 rejects sealed, family, offset, and row-shape drift."""
+
+    path = tmp_path / "held.json"
+    path.write_text("{}", encoding="utf-8")
