+                else "conductor_structured_gate_receipt"
+                if terminal == "skipped"
+                else "declared_path_absent"
+            ),
+            "conductor_receipt": receipt,
+            "same_number_alias_candidates_ignored": _ignored_same_number_aliases(
+                root, task_id, rel_path
