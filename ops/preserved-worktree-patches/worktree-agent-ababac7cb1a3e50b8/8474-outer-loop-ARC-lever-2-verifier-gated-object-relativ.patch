index fa8066fb1a..ec2315d8ec 100644
--- a/python/carnot/agentic/arc_solver_kit.py
+++ b/python/carnot/agentic/arc_solver_kit.py
@@ -6058,3 +6058,137 @@ def bisect_death_prefix(
         "evaluations": evaluations,
