From 1d1ca6bd8c0d799ff3f6a5ff6a2941442aef2f4a Mon Sep 17 00:00:00 2001
From: Ian Blenke <ian@blenke.com>
Date: Sun, 30 Aug 2026 08:37:30 -0400
Subject: [PATCH 10380/11362] Worker walk: prefer the busiest descendant, not
 the first match

A bug in the fix I shipped an hour ago (c31544e0a4), found by reading its own
output. The launcher itself appears in nvidia-smi's GPU-holder list for the
leaderboard eval, and a pid is a descendant of itself at zero hops -- so
"first descendant" matched the SUPERVISOR at 1.2% CPU over its own worker at
629%, reproducing the exact misreading the walk was written to end.

Measured before and after on the live run:

  before:  worker 3452377 cpu 1.2%   | <a stale line from the launcher's log>
  after:   worker 3452459 cpu 623%   | task 348432 | n_decoded = 8217, tg = 27.45 t/s

Now collects every descendant holder and returns the one with the highest CPU.
20 tests; the "back to first-match" mutation is RED. Restores byte-identical.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JntPrUGLNesPcJH1pyfFYw
---
 scripts/outer_loop_dashboard.py           | 22 +++++++++++++++---
 tests/python/test_outer_loop_dashboard.py | 27 +++++++++++++++++++++++
 2 files changed, 46 insertions(+), 3 deletions(-)

diff --git a/scripts/outer_loop_dashboard.py b/scripts/outer_loop_dashboard.py
index 4c768c46f2..e07f72d5fe 100755
--- a/scripts/outer_loop_dashboard.py
+++ b/scripts/outer_loop_dashboard.py
@@ -266,17 +266,33 @@ def gpu_worker_for(pid: int) -> int | None:
         head = row.split(",")[0].strip()
         if head.isdigit():
             holders.append(int(head))
+    # PREFER THE BUSIEST DESCENDANT, NOT THE FIRST MATCH. The launcher itself can appear in
+    # nvidia-smi's holder list -- it does for the leaderboard eval -- so "first descendant" picked
+    # the supervisor at 1.2% CPU over its own worker at 629%, reproducing the exact misreading
+    # this walk was written to end. `pid` is a descendant of itself for zero hops, which is why
+    # the naive version matched it.
+    matches = []
     for holder in holders:
         cur, hops = holder, 0
-        while cur > 1 and hops < 6:  # bounded: a cycle in ppid would otherwise hang the report
+        while cur > 1 and hops < 6:  # bounded: a ppid cycle would otherwise hang the report
             if cur == pid:
-                return holder
+                matches.append(holder)
+                break
             try:
                 cur = int(Path(f"/proc/{cur}/stat").read_text().split()[3])
             except (OSError, IndexError, ValueError):
                 break
             hops += 1
-    return None
+    if not matches:
+        return None
+
+    def _cpu(candidate: int) -> float:
+        try:
+            return float(_run("ps", "-o", "%cpu=", "-p", str(candidate)).strip() or 0.0)
+        except ValueError:
+            return 0.0
+
+    return max(matches, key=_cpu)
 
 
 def worker_progress(worker: int) -> str:
diff --git a/tests/python/test_outer_loop_dashboard.py b/tests/python/test_outer_loop_dashboard.py
index 61c4fd223f..ec6b9b7b5e 100644
--- a/tests/python/test_outer_loop_dashboard.py
+++ b/tests/python/test_outer_loop_dashboard.py
@@ -272,3 +272,30 @@ def test_a_job_with_no_gpu_worker_says_so(monkeypatch) -> None:
     monkeypatch.setattr(m, "_run", lambda *a: "")
     monkeypatch.setattr(m, "pid_alive", lambda pid: True)
     assert "no GPU worker" in m.render([("j", os.getpid(), None)])
+
+
+def test_the_walk_prefers_the_busiest_descendant_not_the_first(monkeypatch) -> None:
+    """The launcher can itself appear in nvidia-smi's holder list.
+
+    It does for the leaderboard eval, so "first descendant" picked the supervisor at 1.2% CPU
+    over its own worker at 629% -- reproducing the exact misreading the walk was written to end.
+    A pid is a descendant of itself at zero hops, which is why the naive version matched it.
+    """
+    m = _module()
+    monkeypatch.setattr(
+        m,
+        "_run",
+        lambda *a: (
+            "500, 100 MiB\n600, 17884 MiB"
+            if a[0] == "nvidia-smi"
+            else ("1.2" if a[-1] == "500" else "629.0")
+        ),
+    )
+    stats = {500: "500 (x) S 1", 600: "600 (x) R 500"}
+
+    def fake_read(self, **kwargs):
+        return stats[int(str(self).split("/")[2])]
+
+    monkeypatch.setattr(m.Path, "read_text", fake_read, raising=False)
+    # 500 is the launcher (a holder, and its own descendant); 600 is its busy worker.
+    assert m.gpu_worker_for(500) == 600
