+def _probe(
+    command: tuple[str, ...],
+    exit_code: int = 0,
+    stdout: str = "",
+    stderr: str = "",
+    duration_s: float = 0.01,
+) -> mod.CommandProbe:
+    return mod.CommandProbe(command, exit_code, stdout, stderr, duration_s)
+
