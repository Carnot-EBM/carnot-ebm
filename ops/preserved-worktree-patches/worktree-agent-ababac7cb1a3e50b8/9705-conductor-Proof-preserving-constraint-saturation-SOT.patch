+            "after_sha256": after.get(path, "missing"),
+            "unchanged": before.get(path, "missing") == after.get(path, "missing"),
+        }
+        for path in sorted(set(before) | set(after))
+    ]
+    return {"all_unchanged": all(row["unchanged"] for row in rows), "rows": rows}
