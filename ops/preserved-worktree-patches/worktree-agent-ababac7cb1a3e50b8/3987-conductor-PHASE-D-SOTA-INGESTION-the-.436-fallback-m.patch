+def test_scenario_arc_wmte_4734_note_round_trips_and_maps_methods() -> None:
+    """SCENARIO-ARC-WMTE-4734: note embeds JSON and cites mapped methods."""
+
+    artifact = mod.artifact_from_note(mod.RESEARCH_NOTE)
