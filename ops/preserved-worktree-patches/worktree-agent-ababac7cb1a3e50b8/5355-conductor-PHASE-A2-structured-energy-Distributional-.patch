+@dataclass(frozen=True)
+class PoolBundle:
+    source_artifact: JsonDict
+    source_pool_path: str
+    model_specs: list[JsonDict]
+    rows: list[JsonDict]
+
+
+@dataclass(frozen=True)
+class CandidateExample:
+    task_id: str
+    family: str
+    candidate_id: str
+    label: bool
+    raw_length: float
+    answer_size: float
+    parse_ok: bool
+    deterministic_penalty: float
