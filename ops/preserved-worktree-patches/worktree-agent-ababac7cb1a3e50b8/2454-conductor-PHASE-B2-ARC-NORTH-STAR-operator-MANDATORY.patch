+    if min_y < INITIAL_SELECTED_TOP:
+        return 2
+    if min_y > INITIAL_SELECTED_TOP:
+        return 1
+    if min_x < INITIAL_SELECTED_LEFT:
+        return 4
+    if min_x > INITIAL_SELECTED_LEFT:
+        return 3
+    return None
+
