+    artifact = exp.run_experiment(random_seed=4362, round_budget=1)
+
+    assert calls == ["ka59"]
+    assert artifact["honest_verdict"] == "success_e3_ar25_ka59_1_reproduced"
+    assert artifact["new_levels_reproduced"] == 1
