+    duplicate_mechanism = deepcopy(accepted)
+    duplicate_mechanism["stable_id"] = "mechanism:repeat"
+    duplicate_mechanism["work_identity"] = "mechanism:repeat"
+    duplicate_mechanism["mechanism"] = "active_reward_machine_inference"
