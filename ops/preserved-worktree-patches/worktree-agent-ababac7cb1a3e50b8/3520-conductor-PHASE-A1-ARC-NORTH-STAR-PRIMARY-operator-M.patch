+@dataclass(frozen=True)
+class ChangeWeightedConsistency:
+    """REQ-ARC-WMTE-4604: score only real grid-changing cells."""
+
+    n: int
+    n_changing_transitions: int
+    true_changed_cells: int
+    correct_changed_cells: int
