+    note_path.parent.mkdir(parents=True, exist_ok=True)
+    artifact_path.parent.mkdir(parents=True, exist_ok=True)
+    note_path.write_text(NOTE_MARKDOWN + "\n", encoding="utf-8")
+    artifact_path.write_text(
