+def _risk_rows(risks: Sequence[Any]) -> list[JsonDict]:
+    rows: list[JsonDict] = []
+    for risk in risks:
+        try:
+            rows.append(asdict(risk))
+        except TypeError:
+            rows.append({"repr": repr(risk)})
+    return rows
