+def _gate_expression(task_id: str, gate: JsonMap) -> str:
+    return (
+        f"gate:{task_id}:{gate.get('upstream')}.{gate.get('artifact_field')}"
+        f"{gate.get('op')}{json.dumps(gate.get('value'), sort_keys=True)}"
+    )
