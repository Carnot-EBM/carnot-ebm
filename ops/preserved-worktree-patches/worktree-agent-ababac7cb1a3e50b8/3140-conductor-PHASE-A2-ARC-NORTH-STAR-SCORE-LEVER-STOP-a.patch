+STOP_AT_SCORED_TARGET_LEVELS = 1
+RUN_TO_COMPLETION_CONTROL_TARGET_LEVELS = 5
+SUBMITTED_AGENT_CONFIG_BASELINE = {
+    "policy": "E3AgentPolicy",
+    "cascade": True,
+    "value_weight": 0.0,
+    "target_levels": STOP_AT_SCORED_TARGET_LEVELS,
