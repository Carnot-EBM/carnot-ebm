+}
+REQUIRED_ARTIFACT_FIELDS = tuple(FIELD_PRINCIPLES)
+REPORTED_SIDE_BY_SIDE = [
+    "offline_to_live_transfer_ratio",
+    "offline_auroc_component",
+    "live_lift_component",
