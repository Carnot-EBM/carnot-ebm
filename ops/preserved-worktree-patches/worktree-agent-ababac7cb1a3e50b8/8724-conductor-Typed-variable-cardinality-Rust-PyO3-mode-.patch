+fn complete_no_self_proposal(n: usize) -> Vec<Vec<f64>> {
+    let off_diagonal = 1.0 / (n - 1) as f64;
+    (0..n)
+        .map(|i| {
+            (0..n)
+                .map(|j| if i == j { 0.0 } else { off_diagonal })
+                .collect()
+        })
+        .collect()
+}
