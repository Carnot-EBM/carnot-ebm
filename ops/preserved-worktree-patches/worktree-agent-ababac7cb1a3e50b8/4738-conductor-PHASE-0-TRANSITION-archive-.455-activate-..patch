+
+def _first_corrigendum(artifact: Mapping[str, Any], kind: str) -> Mapping[str, Any]:
+    for item in _list(artifact.get("corrigendum_pending")):
+        row = _mapping(item)
+        if row.get("kind") == kind:
+            return row
+    return {}
+
+
