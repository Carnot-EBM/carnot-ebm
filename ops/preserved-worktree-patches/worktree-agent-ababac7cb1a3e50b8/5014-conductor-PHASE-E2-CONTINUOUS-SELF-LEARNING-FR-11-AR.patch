+    unresolved = exp5025.build_artifact(
+        target_selection={
+            "game": "lf52",
+            "prior_level": 2,
+            "banked": True,
+            "reason": "preferred_banked_target_lf52",
+        },
+        loop_summary={
+            **summary,
+            "offline_reproduced": True,
+            "reproduced_levels": 2,
+            "learned_verifier_checkpoint": "models/arc_verifier_lf52.json",
+            "checkpoint_mtime_before_ns": "1",
+            "checkpoint_mtime_after_ns": "2",
+            "checkpoint_mtime_delta_ns": 1,
+            "self_play_residual": "checkpoint_refreshed_gate_passed",
