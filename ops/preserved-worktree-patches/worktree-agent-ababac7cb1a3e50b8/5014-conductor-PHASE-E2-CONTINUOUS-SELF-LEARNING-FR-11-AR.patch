+"""Tests for Exp 5025 ARC self-play verifier checkpoint refresh.
+
+Spec refs: REQ-LEARN-5025,
+SCENARIO-LEARN-5025-CHECKPOINT-REFRESHED,
+SCENARIO-LEARN-5025-SUBSTRATE-FIX,
+SCENARIO-LEARN-5025-RESIDUAL-NO-FABRICATION,
+SCENARIO-LEARN-5025-BLOCKED-PRECONDITION.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import scripts.adversarial_verify as av
+from carnot import experiment_5011_self_play_verifier_checkpoint as exp5011
+from carnot import experiment_5025_self_play_verifier_checkpoint as exp5025
+
+
+REPO = Path(__file__).resolve().parents[2]
+SPEC_PATH = REPO / "openspec" / "capabilities" / "self-learning" / "spec.md"
+
+
+def _loop_result(game: str, reached_level: int = 2, reproduced: bool = True) -> dict[str, object]:
+    return {
+        "game": game,
+        "reached_level": reached_level,
+        "offline_reproduced": reproduced,
+        "reproduced_levels": reached_level if reproduced else 0,
+        "states_expanded": 21,
+        "learned_verifier_checkpoint": f"models/arc_verifier_{game}.json",
+        "solve_provenance": "live_agent_self_discovery",
+        "reproduction_gate": {
+            "game": game,
+            "claimed_level": reached_level,
+            "reached_level": reached_level,
+            "reproduced": reproduced,
+            "mode": "offline_reproduction_gate_no_quota",
+        },
+    }
+
+
+def _preconditions(game: str = "lf52", *, ok: bool = True) -> dict[str, object]:
+    return {
+        "ok": ok,
+        "offline_arcade": {"ok": True},
+        "registry_loadable": {"ok": True, "path": "ops/arc_solve_registry.yaml"},
+        "target_banked": {"ok": True, "game": game, "prior_level": 2},
+        "checkpoint_existing": {"ok": True, "path": f"models/arc_verifier_{game}.json"},
+        "target_rotation": {
+            "ok": game not in exp5025.DISALLOWED_TARGET_GAMES,
+            "game": game,
+            "rotated_off": list(exp5025.DISALLOWED_TARGET_GAMES),
+        },
+        "target_selection": {
+            "game": game,
+            "prior_level": 2,
+            "banked": True,
+            "reason": "preferred_banked_target_lf52",
+        },
+    }
+
+
+def _success_artifact(tmp_path: Path, monkeypatch) -> dict[str, object]:
+    ckpt = tmp_path / "models" / "arc_verifier_lf52.json"
+    ckpt.parent.mkdir()
+    ckpt.write_text('{"ok": true}\n', encoding="utf-8")
+    before_ns = ckpt.stat().st_mtime_ns - 1
+    monkeypatch.setattr(exp5025, "REPO", tmp_path)
+
+    summary = exp5025.summarize_loop_result(
+        game="lf52",
+        loop_result=_loop_result("lf52"),
+        loop_result_path="results/arc_loop_solve_lf52.json",
+        checkpoint_mtime_before_ns=before_ns,
+    )
+    return exp5025.build_artifact(
+        target_selection={
+            "game": "lf52",
+            "prior_level": 2,
+            "banked": True,
+            "reason": "preferred_banked_target_lf52",
+        },
+        loop_summary=summary,
+        preconditions_checked=_preconditions("lf52"),
+        duration_s=2.0,
+        flag_resolved=True,
+    )
+
+
+def test_req_learn_5025_spec_declares_required_contract() -> None:
+    """REQ-LEARN-5025: OpenSpec anchors the preferred lf52 checkpoint contract."""
+
+    spec = SPEC_PATH.read_text(encoding="utf-8")
+
+    assert exp5025._target_game(None) == "lf52"
+    assert exp5025._target_game("ls20") == "ls20"
+    assert exp5025._rotation_ok("lf52") is True
+    assert exp5025._rotation_ok("r11l") is False
+    assert exp5025._rotation_ok("su15") is False
+    assert exp5025._rotation_ok("ls20") is False
+    for ref in exp5025.SPEC_REFS:
+        assert ref in spec
+    assert exp5025.RESULT_RELATIVE_PATH in spec
+    for field, principle in exp5025.FIELD_PRINCIPLES.items():
+        assert field in spec
+        assert principle in spec
+
+
+def test_scenario_learn_5025_checkpoint_refreshed_success(tmp_path: Path, monkeypatch) -> None:
+    """SCENARIO-LEARN-5025-CHECKPOINT-REFRESHED: lf52 checkpoint refresh succeeds."""
+
+    artifact = _success_artifact(tmp_path, monkeypatch)
+
+    assert artifact["experiment"] == exp5025.EXPERIMENT
+    assert artifact["schema"] == exp5025.SCHEMA
+    assert artifact["spec_refs"] == exp5025.SPEC_REFS
+    assert artifact["random_seed"] == exp5025.RANDOM_SEED
+    assert artifact["field_principles"] == exp5025.FIELD_PRINCIPLES
+    assert artifact["honest_verdict"] == exp5025.SUCCESS_VERDICT
+    assert artifact["verifier_checkpoint_refreshed"] is True
+    assert artifact["checkpoint_path"] == "models/arc_verifier_lf52.json"
+    assert artifact["target_game"] == "lf52"
+    assert artifact["inference_substrate"] == exp5025.INFERENCE_SUBSTRATE
+    assert artifact["duration_s"] == 2.0
+    assert artifact["flag_resolved"] is True
+    assert artifact["solve_provenance"] == "live_agent_self_discovery"
+    assert artifact["offline_reproduced"] is True
+    assert artifact["reproduced_levels"] == 2
+    assert artifact["states_expanded"] == 21
+    assert artifact["self_play_residual"] == "checkpoint_refreshed_gate_passed"
+    assert int(artifact["checkpoint_mtime_after_ns"]) > int(artifact["checkpoint_mtime_before_ns"])
+    assert artifact["checkpoint_mtime_delta_ns"] > 0
+    assert artifact["schema_errors"] == []
+    assert exp5025.artifact_schema_errors(artifact) == []
+
+
+def test_scenario_learn_5025_substrate_fix_avoids_duration_too_short(
+    tmp_path: Path, monkeypatch
+) -> None:
+    """SCENARIO-LEARN-5025-SUBSTRATE-FIX: offline gate uses verifier substrate."""
+
+    artifact = _success_artifact(tmp_path, monkeypatch)
+
+    floor = av.duration_floor_for_artifact(artifact)
+    flags: list[object] = []
+    av.check_duration_vs_claim(artifact, flags)
+
+    assert floor == {
+        "substrate": exp5025.INFERENCE_SUBSTRATE,
+        "min_duration_s": 1.0,
+        "reason": "verifier_scoring",
+    }
+    assert [getattr(flag, "kind", None) for flag in flags] == []
+
+    out = tmp_path / "artifact.json"
+    exp5025.write_artifact(artifact, out)
+    report = av.verify_artifact(out)
+    critical = [flag for flag in report["flags"] if flag.get("severity") == "critical"]
+    assert [flag["kind"] for flag in critical] == []
+
