+def test_req_learn_5025_schema_rejects_stale_metadata_and_bad_substrate(
+    tmp_path: Path, monkeypatch
+) -> None:
+    """REQ-LEARN-5025: schema rejects stale identity, targets, and substrate drift."""
+
+    artifact = _success_artifact(tmp_path, monkeypatch)
+
+    for field, old_value, expected in (
+        ("experiment", exp5011.EXPERIMENT, "experiment_mismatch"),
+        ("schema", exp5011.SCHEMA, "schema_mismatch"),
+        ("spec_refs", exp5011.SPEC_REFS, "spec_refs_mismatch"),
+        ("random_seed", exp5011.RANDOM_SEED, "random_seed_mismatch"),
+    ):
+        stale = dict(artifact)
+        stale[field] = old_value
+        stale["reproducibility_checksum"] = exp5025.stable_checksum(stale)
+        assert expected in exp5025.artifact_schema_errors(stale)
+
+    too_fast = dict(artifact, duration_s=0.25)
+    too_fast["reproducibility_checksum"] = exp5025.stable_checksum(too_fast)
+    assert "duration_too_short_for_verifier_ensemble" in exp5025.artifact_schema_errors(
+        too_fast
+    )
+
+    live_too_fast = dict(artifact, inference_substrate="live_llm_inference", duration_s=2.5)
+    live_too_fast["reproducibility_checksum"] = exp5025.stable_checksum(live_too_fast)
+    live_errors = exp5025.artifact_schema_errors(live_too_fast)
+    assert "inference_substrate_mismatch" in live_errors
+    assert "duration_too_short_for_live_llm_inference" in live_errors
+
+    unknown_substrate = dict(artifact, inference_substrate="deterministic_verifier")
+    unknown_substrate["reproducibility_checksum"] = exp5025.stable_checksum(unknown_substrate)
+    assert "unknown_inference_substrate" in exp5025.artifact_schema_errors(unknown_substrate)
+
+    for target in ("r11l", "su15", "ls20"):
+        rotation_violation = dict(artifact, target_game=target)
+        rotation_violation["reproducibility_checksum"] = exp5025.stable_checksum(
+            rotation_violation
+        )
+        assert "success_target_rotation_violation" in exp5025.artifact_schema_errors(
+            rotation_violation
+        )
+
