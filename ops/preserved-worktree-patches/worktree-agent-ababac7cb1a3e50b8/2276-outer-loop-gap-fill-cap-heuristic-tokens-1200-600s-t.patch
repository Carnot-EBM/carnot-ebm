From c47d52bbe203128a94c7e4973d838aa2c9d34089 Mon Sep 17 00:00:00 2001
From: Ian Blenke <ian@blenke.com>
Date: Wed, 17 Jun 2026 05:32:50 -0400
Subject: [PATCH 02276/11362] [outer-loop] gap-fill: cap heuristic tokens 1200
 + 600s timeout (heuristics are small; dense-31B timed out)

---
 scripts/arc_gap_fill.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/scripts/arc_gap_fill.py b/scripts/arc_gap_fill.py
index 7334a2ab9f..0eb7a57db4 100644
--- a/scripts/arc_gap_fill.py
+++ b/scripts/arc_gap_fill.py
@@ -102,7 +102,8 @@ def main() -> int:
         print("  REUSING pre-generated heuristic (autolearning; no LLM call)", flush=True)
     else:
         reused = False
-        proposer = e3.LocalGGUFProposer(repo_substr=args.repo)
+        # a goal-distance heuristic is small (~1k tokens) -> cap tokens (faster) + headroom timeout
+        proposer = e3.LocalGGUFProposer(repo_substr=args.repo, max_tokens=1200, timeout=600)
         ok, code = proposer.generate(gap_fill_prompt(game, trans, win),
                                      required=("goal_distance",), validate=_validate)
         if not ok:
