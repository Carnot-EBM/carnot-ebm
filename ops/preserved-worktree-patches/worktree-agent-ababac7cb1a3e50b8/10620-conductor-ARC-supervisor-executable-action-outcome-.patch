+def _ids(prefix: str) -> dict[str, str]:
+    return {
+        key: f"sha256:{prefix}{index:062d}"
+        for index, key in enumerate(
+            ("proposal_id", "application_id", "environment_step_id", "outcome_id"),
+            start=1,
+        )
+    }
