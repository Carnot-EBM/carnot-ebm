+                for field in (
+                    "certified_selection_run_complete_score",
+                    "certified_energy_positive_score",
+                    "verdict_class",
+                    "honest_verdict",
+                )
+            },
+            sort_keys=True,
+        )
+    )
+    return 0
+
+
