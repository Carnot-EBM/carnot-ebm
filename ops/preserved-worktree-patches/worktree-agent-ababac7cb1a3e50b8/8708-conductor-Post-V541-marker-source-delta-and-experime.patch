+def test_scenario_infra_6273_validation_is_machine_checkable() -> None:
+    """SCENARIO-INFRA-6273-5: malformed artifacts fail validation."""
+
+    report = mod.build_report(
+        REPO,
+        date="20260810",
+        source_receipts=mod.DEFAULT_SOURCE_CHANNEL_RECEIPTS,
