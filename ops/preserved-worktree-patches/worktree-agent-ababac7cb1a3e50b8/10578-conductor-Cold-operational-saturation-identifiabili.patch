+
+    fixture, corpus, fixture_bytes, corpus_bytes = source_payloads
+    attacks = exp.run_attack_suite(fixture, corpus, recomputed)
+    assert {row["attack_id"] for row in attacks} == set(exp.ATTACK_IDS)
