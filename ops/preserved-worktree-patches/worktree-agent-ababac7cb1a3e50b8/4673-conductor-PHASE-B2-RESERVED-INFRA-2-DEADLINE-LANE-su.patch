+        "ok": False,
+        "frozen_stack_loads": False,
+        "blocked_resource": blocked_resource,
+        "peak_vram_gb": 0.0,
+        "fits_16gb": False,
+        "limit_gb": VRAM_LIMIT_GB,
+        "server_reachable": False,
+        "igpu_hip_server_present": False,
+        "generator_backend": None,
