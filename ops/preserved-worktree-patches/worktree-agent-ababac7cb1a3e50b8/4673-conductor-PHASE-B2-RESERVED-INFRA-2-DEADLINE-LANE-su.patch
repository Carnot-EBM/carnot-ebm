+        "dry_build_ran": False,
+        "package_builds": False,
+        "entrypoint_compiles": False,
+        "manifest_present": False,
+        "kernel_main_present": False,
+        "submitted_to_leaderboard": False,
+        "blocked_resource": blocked_resource,
+        "package_sha256": "",
+        "files": [],
+        "file_hashes": {},
+    }
+
+
+def blocked_vram_breakdown(blocked_resource: str) -> JsonDict:
+    return {
+        "vram_estimate_gb": 0.0,
+        "fits_16gb": False,
+        "limit_gb": VRAM_LIMIT_GB,
+        "blocked_resource": blocked_resource,
