+def validate_report(report: Mapping[str, Any]) -> list[str]:
+    errors: list[str] = []
+    for field in REQUIRED_ARTIFACT_FIELDS:
+        if field not in report:
+            errors.append(f"missing:{field}")
+    if errors:
