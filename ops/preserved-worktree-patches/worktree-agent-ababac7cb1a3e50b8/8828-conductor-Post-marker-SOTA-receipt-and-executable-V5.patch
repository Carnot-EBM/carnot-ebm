+def git_status(root: Path) -> list[str]:
+    try:
+        proc = subprocess.run(
+            ("git", "status", "--short"),
+            cwd=root,
+            text=True,
+            capture_output=True,
+            timeout=30,
+            check=False,
+        )
+    except Exception:  # pragma: no cover
+        return []
+    return [line for line in proc.stdout.splitlines() if line.strip()]
