+    fake_git = FakeGit(
+        activation="2026-07-01 10:00:00 +0000",
+        path_times={
+            "results/experiment_30_live.json": "2026-07-01 10:05:00 +0000",
+            "results/experiment_31_audit.json": "2026-07-01 10:09:00 +0000",
