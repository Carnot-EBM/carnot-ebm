+    "REQ-CAPSTONE-5014",
+    "SCENARIO-CAPSTONE-5014",
+    "SCENARIO-CAPSTONE-5014-BLOCKED-PRECONDITION",
+    "SCENARIO-CAPSTONE-5014-FIELD-PRINCIPLES",
+]
+TERMINAL_PREFIXES = (
+    "complete_",
+    "success_",
+    "passed_",
+    "shipped_",
+    "blocked_",
+)
