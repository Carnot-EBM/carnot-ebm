+def _command_check(result: CommandResult) -> JsonDict:
+    return {
+        "command": result.command,
+        "exit_code": result.exit_code,
+        "green": result.exit_code == 0,
+        "stdout_tail": result.stdout[-1000:],
+        "stderr_tail": result.stderr[-1000:],
+    }
