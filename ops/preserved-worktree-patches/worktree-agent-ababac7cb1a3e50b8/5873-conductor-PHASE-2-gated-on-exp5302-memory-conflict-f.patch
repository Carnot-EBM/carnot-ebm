+        "exp5302_memory_policy_candidate_ready": gate_ready,
+        "exp5302_honest_verdict": _wrapped_or_raw(candidate.get("honest_verdict")),
+    }
+    if gate_ready:
+        evaluation = evaluate_stress_panel(panel, candidate)
