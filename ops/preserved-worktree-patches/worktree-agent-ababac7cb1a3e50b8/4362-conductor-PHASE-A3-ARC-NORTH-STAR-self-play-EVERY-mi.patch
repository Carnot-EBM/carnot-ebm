+"""Tests for Exp 4843 ARC self-play verifier checkpoint refresh.
+
+Spec refs: REQ-ARC-WMTE-4843,
+SCENARIO-ARC-WMTE-4843-CHECKPOINT-REFRESHED,
+SCENARIO-ARC-WMTE-4843-RESIDUAL-NO-FABRICATION,
+SCENARIO-ARC-WMTE-4843-BLOCKED-PRECONDITION.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from carnot import experiment_4833_self_play_verifier_checkpoint as exp4833
+from carnot import experiment_4843_self_play_verifier_checkpoint as exp4843
+
+
+REPO = Path(__file__).resolve().parents[2]
+SPEC_PATH = REPO / "openspec" / "capabilities" / "arc-world-model-trust-energy" / "spec.md"
+
+
+def _loop_result(game: str, reached_level: int = 2, reproduced: bool = True) -> dict[str, object]:
+    return {
+        "game": game,
+        "reached_level": reached_level,
+        "offline_reproduced": reproduced,
+        "reproduced_levels": reached_level if reproduced else 0,
+        "states_expanded": 73,
+        "learned_verifier_checkpoint": f"models/arc_verifier_{game}.json",
+        "solve_provenance": "live_agent_self_discovery",
+        "reproduction_gate": {
+            "game": game,
+            "claimed_level": reached_level,
+            "reached_level": reached_level,
+            "reproduced": reproduced,
+        },
+    }
+
+
+def _success_artifact(tmp_path: Path, monkeypatch) -> dict[str, object]:
+    ckpt = tmp_path / "models" / "arc_verifier_re86.json"
+    ckpt.parent.mkdir()
+    ckpt.write_text('{"ok": true}\n', encoding="utf-8")
+    before_ns = ckpt.stat().st_mtime_ns - 1
+    monkeypatch.setattr(exp4843, "REPO", tmp_path)
+
+    summary = exp4843.summarize_loop_result(
+        game="re86",
+        loop_result=_loop_result("re86"),
+        loop_result_path="results/arc_loop_solve_re86.json",
+        checkpoint_mtime_before_ns=before_ns,
+    )
+    return exp4843.build_artifact(
+        target_selection={
+            "game": "re86",
+            "prior_level": 2,
+            "banked": True,
+            "reason": "preferred_banked_target",
+        },
+        loop_summary=summary,
+        preconditions_checked={
+            "offline_arcade": {"ok": True},
+            "registry_loadable": {"ok": True},
+            "target_banked": {"ok": True, "game": "re86"},
+        },
+    )
+
+
+def test_req_arc_wmte_4843_spec_declares_contract() -> None:
+    """REQ-ARC-WMTE-4843: OpenSpec declares the 4843 artifact contract."""
+
+    spec = SPEC_PATH.read_text(encoding="utf-8")
+
+    for ref in exp4843.SPEC_REFS:
+        assert ref in spec
+    assert exp4843.RESULT_RELATIVE_PATH in spec
+    assert "checkpoint_mtime_delta_ns" in spec
+    assert "search_state_count" in spec
+    for field, principle in exp4843.FIELD_PRINCIPLES.items():
+        assert field in spec
+        assert principle in spec
+
+
+def test_scenario_arc_wmte_4843_checkpoint_refreshed_success(tmp_path: Path, monkeypatch) -> None:
+    """SCENARIO-ARC-WMTE-4843-CHECKPOINT-REFRESHED: mtime advance plus gate green succeeds."""
+
+    artifact = _success_artifact(tmp_path, monkeypatch)
+
+    assert artifact["experiment"] == exp4843.EXPERIMENT
+    assert artifact["schema"] == exp4843.SCHEMA
+    assert artifact["spec_refs"] == exp4843.SPEC_REFS
+    assert artifact["random_seed"] == exp4843.RANDOM_SEED
+    assert artifact["field_principles"] == exp4843.FIELD_PRINCIPLES
+    assert artifact["honest_verdict"] == "success_re86_L2_checkpoint_refreshed"
+    assert artifact["verifier_checkpoint_refreshed"] is True
+    assert artifact["inference_substrate"] == "live_llm_inference"
+    assert artifact["solve_provenance"] == "live_agent_self_discovery"
+    assert artifact["offline_reproduced"] is True
+    assert artifact["reproduced_levels"] == 2
+    assert artifact["states_expanded"] == 73
+    assert artifact["search_state_count"] == 73
+    assert artifact["self_play_residual"] == "checkpoint_refreshed_gate_passed"
+    assert int(artifact["checkpoint_mtime_after_ns"]) > int(artifact["checkpoint_mtime_before_ns"])
+    assert artifact["checkpoint_mtime_delta_ns"] > 0
+    assert artifact["schema_errors"] == []
+    assert exp4843.artifact_schema_errors(artifact) == []
+
+
+def test_scenario_arc_wmte_4843_residual_and_blocked_paths(
+    tmp_path: Path, monkeypatch
+) -> None:
+    """SCENARIO-ARC-WMTE-4843-RESIDUAL-NO-FABRICATION: failed gates stay residuals."""
+
+    monkeypatch.setattr(exp4843, "REPO", tmp_path)
+    failed = _loop_result("re86", reached_level=0, reproduced=False)
+    failed["learned_verifier_checkpoint"] = None
+
+    summary = exp4843.summarize_loop_result(
+        game="re86",
+        loop_result=failed,
+        loop_result_path="results/arc_loop_solve_re86.json",
+        checkpoint_mtime_before_ns=123,
+    )
+    artifact = exp4843.build_artifact(
+        target_selection={
+            "game": "re86",
+            "prior_level": 2,
+            "banked": True,
+            "reason": "preferred_banked_target",
+        },
+        loop_summary=summary,
+        preconditions_checked={"offline_arcade": {"ok": True}, "registry_loadable": {"ok": True}},
+    )
+    blocked = exp4843.build_blocked_artifact(
+        reason="target_not_banked",
+        preconditions_checked={
+            "offline_arcade": {"ok": True},
+            "registry_loadable": {"ok": True},
+            "target_banked": {"ok": False, "game": "sb26", "prior_level": 0},
+        },
+        target_game="sb26",
+    )
+    missing = exp4843.summarize_loop_result(
+        game="re86",
+        loop_result=None,
+        loop_result_path="results/arc_loop_solve_re86.json",
+        checkpoint_mtime_before_ns="bad",
+    )
+
+    assert artifact["honest_verdict"] == "complete_re86_self_play_residual_reproduction_gate_failed"
+    assert artifact["verifier_checkpoint_refreshed"] is False
+    assert artifact["checkpoint_path"] is None
+    assert artifact["checkpoint_mtime_after_ns"] is None
+    assert artifact["checkpoint_mtime_delta_ns"] is None
+    assert artifact["search_state_count"] == 73
+    assert artifact["schema_errors"] == []
+    assert blocked["honest_verdict"] == "blocked_target_not_banked"
+    assert blocked["target_game"] == "sb26"
+    assert blocked["search_state_count"] == 0
+    assert blocked["schema_errors"] == []
+    assert missing["self_play_residual"] == "loop_result_missing"
+    assert missing["checkpoint_mtime_before_ns"] is None
+    assert missing["search_state_count"] == 0
+
+
+def test_req_arc_wmte_4843_schema_rejects_stale_4833_metadata(
+    tmp_path: Path, monkeypatch
+) -> None:
+    """REQ-ARC-WMTE-4843: schema prevents accidental reuse of the 4833 identity."""
+
+    artifact = _success_artifact(tmp_path, monkeypatch)
+
+    for field, old_value, expected in (
+        ("experiment", exp4833.EXPERIMENT, "experiment_mismatch"),
+        ("schema", exp4833.SCHEMA, "schema_mismatch"),
+        ("spec_refs", exp4833.SPEC_REFS, "spec_refs_mismatch"),
+        ("random_seed", exp4833.RANDOM_SEED, "random_seed_mismatch"),
+    ):
+        stale = dict(artifact)
+        stale[field] = old_value
+        stale["reproducibility_checksum"] = exp4843.stable_checksum(stale)
+        assert expected in exp4843.artifact_schema_errors(stale)
+
+
+def test_req_arc_wmte_4843_io_helpers_and_precondition_failure(
+    tmp_path: Path, monkeypatch
+) -> None:
+    """REQ-ARC-WMTE-4843: helper IO paths are deterministic and fail closed."""
+
+    monkeypatch.setattr(exp4843, "REPO", tmp_path)
+    missing = tmp_path / "missing.json"
+    present = tmp_path / "results" / "loop.json"
+    present.parent.mkdir()
+    present.write_text(json.dumps(_loop_result("re86")), encoding="utf-8")
+    list_payload = tmp_path / "results" / "list.json"
+    list_payload.write_text("[]", encoding="utf-8")
+
+    assert exp4843._read_loop_result(missing) is None  # noqa: SLF001
+    assert exp4843._read_loop_result(list_payload) is None  # noqa: SLF001
+    assert exp4843._read_loop_result(present)["game"] == "re86"  # noqa: SLF001
+    assert exp4843._relative_path(present) == "results/loop.json"  # noqa: SLF001
+    assert exp4843._relative_path(Path("/outside.json")) == "/outside.json"  # noqa: SLF001
+    assert exp4843._precondition_failure({"offline_arcade": {"ok": False}}) == "offline_arcade_missing"  # noqa: SLF001
+    assert exp4843._precondition_failure(  # noqa: SLF001
+        {"offline_arcade": {"ok": True}, "registry_loadable": {"ok": False}}
+    ) == "registry_missing"
+    assert exp4843._precondition_failure(  # noqa: SLF001
+        {
+            "offline_arcade": {"ok": True},
+            "registry_loadable": {"ok": True},
+            "target_banked": {"ok": False},
+        }
+    ) == "target_not_banked"
+    assert exp4843._precondition_failure(  # noqa: SLF001
+        {
+            "offline_arcade": {"ok": True},
+            "registry_loadable": {"ok": True},
+            "target_banked": {"ok": True},
+        }
+    ) is None
+
+
+def test_req_arc_wmte_4843_main_writes_terminal_and_blocked_artifacts(
+    tmp_path: Path, monkeypatch
+) -> None:
+    """REQ-ARC-WMTE-4843: main writes the 4843 artifact path from loop output."""
+
+    (tmp_path / "results").mkdir()
+    (tmp_path / "models").mkdir()
+    ckpt = tmp_path / "models" / "arc_verifier_re86.json"
+    ckpt.write_text("{}", encoding="utf-8")
+    before_ns = ckpt.stat().st_mtime_ns - 1
+    loop_path = tmp_path / "results" / "arc_loop_solve_re86.json"
+    loop_path.write_text(json.dumps(_loop_result("re86")), encoding="utf-8")
+
+    monkeypatch.setattr(exp4843, "REPO", tmp_path)
+    monkeypatch.setattr(exp4843, "RESULTS", tmp_path / "results")
+    monkeypatch.setattr(exp4843, "ARTIFACT", tmp_path / exp4843.RESULT_RELATIVE_PATH)
+    monkeypatch.setattr(
+        exp4843,
+        "check_preconditions",
+        lambda game=None: {
+            "ok": True,
+            "offline_arcade": {"ok": True},
+            "registry_loadable": {"ok": True},
+            "target_banked": {"ok": True, "game": "re86", "prior_level": 2},
+            "target_selection": {
+                "game": "re86",
+                "prior_level": 2,
+                "banked": True,
+                "reason": "preferred_banked_target",
+            },
+        },
+    )
+
+    assert exp4843.main(["--game", "re86", "--checkpoint-mtime-before-ns", str(before_ns)]) == 0
+    written = json.loads((tmp_path / exp4843.RESULT_RELATIVE_PATH).read_text(encoding="utf-8"))
+    assert written["experiment"] == exp4843.EXPERIMENT
+    assert written["honest_verdict"] == "success_re86_L2_checkpoint_refreshed"
+    assert written["search_state_count"] == 73
+    assert written["schema_errors"] == []
+
+    blocked_path = tmp_path / "blocked" / exp4843.RESULT_RELATIVE_PATH
+    monkeypatch.setattr(exp4843, "ARTIFACT", blocked_path)
+    monkeypatch.setattr(
+        exp4843,
+        "check_preconditions",
+        lambda game=None: {
+            "ok": False,
+            "offline_arcade": {"ok": True},
+            "registry_loadable": {"ok": True},
+            "target_banked": {"ok": False, "game": "missing", "prior_level": 0},
+            "target_selection": {
+                "game": "missing",
+                "prior_level": 0,
+                "banked": False,
+                "reason": "preferred_target_not_banked",
+            },
+        },
+    )
+
+    assert exp4843.main(["--game", "missing"]) == 0
+    blocked = json.loads(blocked_path.read_text(encoding="utf-8"))
+    assert blocked["honest_verdict"] == "blocked_target_not_banked"
+    assert blocked["verifier_checkpoint_refreshed"] is False
+    assert blocked["search_state_count"] == 0
