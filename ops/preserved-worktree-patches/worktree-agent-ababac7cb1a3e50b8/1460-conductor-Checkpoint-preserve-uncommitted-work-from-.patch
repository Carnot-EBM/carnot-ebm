 ops/conductor-heartbeat.json | 2 +-
 ops/conductor-state.json     | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/ops/conductor-heartbeat.json b/ops/conductor-heartbeat.json
index 52d114ff80..76d1c37267 100644
--- a/ops/conductor-heartbeat.json
+++ b/ops/conductor-heartbeat.json
@@ -1 +1 @@
-{"pid": 2240979, "iteration": 178, "phase": "iteration_start", "last_beat": "2026-06-12T16:25:10Z"}
\ No newline at end of file
+{"pid": 1951, "iteration": 1, "phase": "iteration_start", "last_beat": "2026-06-12T16:36:26Z"}
\ No newline at end of file
diff --git a/ops/conductor-state.json b/ops/conductor-state.json
index 29ece4fa0c..f886f140e9 100644
--- a/ops/conductor-state.json
+++ b/ops/conductor-state.json
@@ -1 +1 @@
-{"pid": 2240979, "iteration": 178, "phase": "iteration_start", "started_at": "2026-06-12T16:25:10Z"}
\ No newline at end of file
+{"pid": 1951, "iteration": 1, "phase": "iteration_start", "started_at": "2026-06-12T16:36:26Z"}
\ No newline at end of file
