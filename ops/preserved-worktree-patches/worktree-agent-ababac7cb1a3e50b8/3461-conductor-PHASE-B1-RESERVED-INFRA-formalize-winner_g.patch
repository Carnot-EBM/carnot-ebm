+            "inference_substrate": "wrong",
+            "winner_generated_rate": "0.5",
+            "generation_vs_ranking_gap": "0.25",
+            "winner_generated_count": "2",
+            "metric_wired_into_capstone": [],
+            "leaderboard_submission": True,
+            "tests_added_pass": [],
+            "preconditions_checked": [],
