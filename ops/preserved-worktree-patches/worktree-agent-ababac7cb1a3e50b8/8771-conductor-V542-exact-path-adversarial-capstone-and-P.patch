+def git_status_lines(root: Path) -> list[str]:  # pragma: no cover
+    try:
+        proc = subprocess.run(
+            ["git", "status", "--short", "--untracked-files=all"],
+            cwd=root,
+            text=True,
+            capture_output=True,
+            check=False,
+            timeout=60,
+        )
+    except (FileNotFoundError, subprocess.TimeoutExpired):
+        return []
+    return [line for line in proc.stdout.splitlines() if line]
