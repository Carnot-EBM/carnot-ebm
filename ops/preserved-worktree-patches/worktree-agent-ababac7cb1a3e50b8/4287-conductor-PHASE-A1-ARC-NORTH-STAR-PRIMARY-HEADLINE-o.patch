+        def _energy(grid: Any) -> float:
+            try:
+                if is_done(grid):
+                    return 0.0
+            except Exception:
+                pass
+            if exemplar_arr is not None:
+                g = np.asarray(grid)
+                if g.shape != exemplar_arr.shape:
+                    return scale
