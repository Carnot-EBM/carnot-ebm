+        all(value != "missing" for value in (hashes[name]["sha256"] for name in paths))
+        and exp6813.get("compiler_artifact_sha256") == hashes["exp6811"]["sha256"]
+        and exp6813.get("source_artifact_sha256") == hashes["exp6812"]["sha256"]
