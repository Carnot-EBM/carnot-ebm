+    completed = exp6813.get("selective_arbiter_ab_completed") is True
+    checks = [
+        _check_row(
+            "raw_byte_manifests_readable",
+            {"cell_count": 288, "hashes_valid": True},
+            {"cell_count": len(raw_ids), "failures": raw_failures[:3]},
