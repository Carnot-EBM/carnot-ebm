+}
+
+REQUIRED_FIELDS = (
+    "honest_verdict",
+    "online_adaptation_helps",
+    "static_cross_family_delta",
+    "online_cross_family_delta",
+    "tier2_cross_family_delta",
+    "adaptive_minus_static_ci95",
