+
+    bad = copy.deepcopy(report)
+    bad["honest_verdict"] = "ok"
+    bad["reproducibility_checksum"] = mod.payload_checksum(bad)
+    assert "honest_verdict lacks terminal prefix" in mod.validate_report(bad)
+
+    bad = copy.deepcopy(report)
