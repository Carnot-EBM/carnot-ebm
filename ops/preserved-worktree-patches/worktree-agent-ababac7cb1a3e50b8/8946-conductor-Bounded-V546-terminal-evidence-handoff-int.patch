+
+    bad = copy.deepcopy(report)
+    bad["llm_call_count"] = {"value": 0}
+    bad["reproducibility_checksum"] = mod.payload_checksum(bad)
+    assert "llm_call_count must be bare 0" in mod.validate_report(bad)
+
+    bad = copy.deepcopy(report)
