+    if not isinstance(payload, Mapping):
+        return {"status": "missing", "flagged_for_v392": ""}
+    methods = payload.get("methods_mapped")
+    first = (
+        methods[0]
+        if isinstance(methods, list) and methods and isinstance(methods[0], Mapping)
+        else {}
+    )
+    return {
