+def _expect_validation_error(artifact: JsonDict, mutator: Any, match: str) -> None:
+    mutated = json.loads(json.dumps(artifact))
+    mutator(mutated)
+    with pytest.raises(ValueError, match=match):
+        mod.validate_artifact(mutated)
+
