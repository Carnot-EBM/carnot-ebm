+    "world_model_paths": "list[str]: the repaired world-model paths + the adaptive-test paths (the deliverables).",
+    "verifier_is_oracle": (
+        "BARE bool=true -- the SOLVEs are execution-grounded; ARC progress, NOT a moat headline."
