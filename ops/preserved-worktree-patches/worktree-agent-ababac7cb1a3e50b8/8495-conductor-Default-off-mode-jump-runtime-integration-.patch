+        seed=6208,
+        return_trace=True,
+        root=root,
+    )
+    samples_match = bool(np.array_equal(rust["samples"], fallback["samples"]))
+    return {
+        "seed": 6208,
+        "sample_count": PARITY_SAMPLE_COUNT,
+        "burn_in": PARITY_BURN_IN,
+        "rust_active_backend": rust["receipt"]["active_backend"],
