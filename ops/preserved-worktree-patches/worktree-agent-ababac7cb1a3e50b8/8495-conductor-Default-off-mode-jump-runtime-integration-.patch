+@contextmanager
+def _without_sampler_env() -> Any:
+    keys = ("CARNOT_BACKEND", "CARNOT_SAMPLER", FEATURE_ENV_VAR)
+    old = {key: os.environ.get(key) for key in keys}
+    for key in keys:
+        os.environ.pop(key, None)
+    try:
+        yield
+    finally:
+        for key, value in old.items():
+            if value is None:
+                os.environ.pop(key, None)
+            else:
+                os.environ[key] = value
+
