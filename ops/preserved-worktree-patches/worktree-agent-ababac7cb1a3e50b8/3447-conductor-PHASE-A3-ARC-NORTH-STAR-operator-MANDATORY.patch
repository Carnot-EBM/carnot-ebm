+        "leaderboard_submission": False,
+        "required_commands": [
+            '.venv/bin/python -c "from carnot.agentic import arc_solver_kit as k; '
+            'k.offline_arcade()"',
+            '.venv/bin/python -c "from carnot.agentic.arc_goal_distance import '
+            'make_goal_distance, calibrate_avatar_goal"',
