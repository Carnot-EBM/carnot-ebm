+    assert "paired_ci95" in mod.artifact_schema_errors({**success, "paired_ci95": [0.0]})
+    assert "model_specs" in mod.artifact_schema_errors({**success, "model_specs": []})
+    assert "split_diagnostics" in mod.artifact_schema_errors(
