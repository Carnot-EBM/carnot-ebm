+                        "fixture_id": window.fixture_id,
+                        "held_game_id": window.held_game_id,
+                        "mechanic": window.mechanic,
+                        "seed": window.seed,
+                        "starting_history_hash": window.starting_history_hash,
+                        "transition_payload_hash": exp6307._history_hash(window.transitions),
