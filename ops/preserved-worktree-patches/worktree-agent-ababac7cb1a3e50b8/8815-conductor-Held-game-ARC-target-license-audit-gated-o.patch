+        path = REPO_ROOT / rel
+        payload = json.loads(path.read_text(encoding="utf-8")) if path.is_file() else {}
+        if rel == UPSTREAM_RELATIVE_PATH:
+            payload = dict(upstream)
+        rows.append(
+            {
+                "path": rel.as_posix(),
+                "exists": path.is_file(),
+                "sha256": sha256_file(path) if path.is_file() else None,
