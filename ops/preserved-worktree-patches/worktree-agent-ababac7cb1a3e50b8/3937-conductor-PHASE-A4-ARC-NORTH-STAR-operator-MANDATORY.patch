+
+# ─── 2. Load Carnot agentic stack ─────────────────────────────────────────────
+from carnot.agentic import arc_solver_kit as kit  # noqa: E402
+from carnot.agentic.arc_agi3_live_adapter import (  # noqa: E402
+    ArcAction,
