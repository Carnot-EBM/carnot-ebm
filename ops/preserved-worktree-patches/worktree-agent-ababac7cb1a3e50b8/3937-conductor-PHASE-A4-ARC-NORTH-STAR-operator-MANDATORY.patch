+    assert "goal-free online action-learning driver" in spec
+    for field in (
+        "online_warm_first_win",
+        "online_scratch_first_win",
+        "frozen_first_win",
+        "online_warm_vs_frozen_delta",
+        "cpu_train_step_ms",
