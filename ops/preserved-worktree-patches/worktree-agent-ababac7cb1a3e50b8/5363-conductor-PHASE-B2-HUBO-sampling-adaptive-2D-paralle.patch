+COMPLETE_VERDICT = "complete_adaptive_2dpt_ready_exact_checked_cpu"
+NOT_READY_VERDICT = "complete_adaptive_2dpt_not_ready_no_harmful_regression"
+BLOCKED_VERDICT = "blocked_adaptive_2dpt_exact_label_check_failed"
