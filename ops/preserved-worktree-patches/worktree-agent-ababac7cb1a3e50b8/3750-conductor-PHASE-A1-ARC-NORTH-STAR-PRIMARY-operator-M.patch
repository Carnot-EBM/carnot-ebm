+def _qwen_cache_present() -> bool:  # pragma: no cover - filesystem boundary.
+    cache = Path.home() / ".cache" / "huggingface" / "hub" / "models--unsloth--Qwen3.5-9B-MTP-GGUF"
+    return cache.is_dir() and any(cache.iterdir())
