+def _upstream_or_fallback(
+    upstream_gaps: Any,
+    evidence_path: str,
+    fallback: dict[str, Any],
+) -> list[dict[str, Any]]:
+    valid = [
+        _normalize_upstream_gap(upstream, evidence_path)
+        for upstream in upstream_gaps
+        if isinstance(upstream, Mapping)
+    ]
+    return valid or [fallback]
