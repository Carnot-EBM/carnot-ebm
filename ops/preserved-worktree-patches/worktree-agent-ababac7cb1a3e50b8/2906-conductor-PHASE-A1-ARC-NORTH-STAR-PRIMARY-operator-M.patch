+def _load_registry(root: Path) -> dict[str, Any]:
+    path = Path(root) / REGISTRY_RELATIVE_PATH
+    if not path.exists():
+        return {"games": []}
+    try:
+        data = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
+    except yaml.YAMLError:
+        return {"games": []}
+    return data if isinstance(data, dict) else {"games": []}
