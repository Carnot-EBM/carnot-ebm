+++ b/tests/python/test_experiment_4863_self_play_verifier_checkpoint.py
@@ -0,0 +1,333 @@
+"""Tests for Exp 4863 ARC self-play verifier checkpoint refresh.
+
+Spec refs: REQ-ARC-WMTE-4863,
+SCENARIO-ARC-WMTE-4863-CHECKPOINT-REFRESHED,
+SCENARIO-ARC-WMTE-4863-RESIDUAL-NO-FABRICATION,
+SCENARIO-ARC-WMTE-4863-BLOCKED-PRECONDITION.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from carnot import experiment_4853_self_play_verifier_checkpoint as exp4853
+from carnot import experiment_4863_self_play_verifier_checkpoint as exp4863
+
+
+REPO = Path(__file__).resolve().parents[2]
+SPEC_PATH = REPO / "openspec" / "capabilities" / "arc-world-model-trust-energy" / "spec.md"
+
+
+def _loop_result(game: str, reached_level: int = 2, reproduced: bool = True) -> dict[str, object]:
+    return {
+        "game": game,
+        "reached_level": reached_level,
+        "offline_reproduced": reproduced,
+        "reproduced_levels": reached_level if reproduced else 0,
+        "states_expanded": 59,
+        "learned_verifier_checkpoint": f"models/arc_verifier_{game}.json",
+        "solve_provenance": "live_agent_self_discovery",
+        "reproduction_gate": {
+            "game": game,
+            "claimed_level": reached_level,
+            "reached_level": reached_level,
+            "reproduced": reproduced,
+        },
+    }
+
+
+def _success_artifact(tmp_path: Path, monkeypatch) -> dict[str, object]:
+    ckpt = tmp_path / "models" / "arc_verifier_re86.json"
+    ckpt.parent.mkdir()
+    ckpt.write_text('{"ok": true}\n', encoding="utf-8")
+    before_ns = ckpt.stat().st_mtime_ns - 1
+    monkeypatch.setattr(exp4863, "REPO", tmp_path)
+
+    summary = exp4863.summarize_loop_result(
+        game="re86",
+        loop_result=_loop_result("re86"),
+        loop_result_path="results/arc_loop_solve_re86.json",
+        checkpoint_mtime_before_ns=before_ns,
+    )
+    return exp4863.build_artifact(
+        target_selection={
+            "game": "re86",
+            "prior_level": 2,
+            "banked": True,
+            "reason": "preferred_banked_target",
+        },
+        loop_summary=summary,
+        preconditions_checked={
+            "offline_arcade": {"ok": True},
+            "registry_loadable": {"ok": True},
+            "target_banked": {"ok": True, "game": "re86"},
+            "checkpoint_existing": {"ok": True, "path": "models/arc_verifier_re86.json"},
+        },
+    )
+
+
+def test_req_arc_wmte_4863_spec_declares_required_contract() -> None:
+    """REQ-ARC-WMTE-4863: OpenSpec anchors the 4863 checkpoint contract."""
+
+    spec = SPEC_PATH.read_text(encoding="utf-8")
+
+    for ref in exp4863.SPEC_REFS:
+        assert ref in spec
+    assert exp4863.RESULT_RELATIVE_PATH in spec
+    for field, principle in exp4863.FIELD_PRINCIPLES.items():
+        assert field in spec
+        assert principle in spec
+
+
+def test_scenario_arc_wmte_4863_checkpoint_refreshed_success(tmp_path: Path, monkeypatch) -> None:
+    """SCENARIO-ARC-WMTE-4863-CHECKPOINT-REFRESHED: green gate plus mtime succeeds."""
+
+    artifact = _success_artifact(tmp_path, monkeypatch)
+
+    assert artifact["experiment"] == exp4863.EXPERIMENT
+    assert artifact["schema"] == exp4863.SCHEMA
+    assert artifact["spec_refs"] == exp4863.SPEC_REFS
+    assert artifact["random_seed"] == exp4863.RANDOM_SEED
+    assert artifact["field_principles"] == exp4863.FIELD_PRINCIPLES
+    assert artifact["honest_verdict"] == "success_self_play_checkpoint_refreshed"
+    assert artifact["verifier_checkpoint_refreshed"] is True
+    assert artifact["checkpoint_path"] == "models/arc_verifier_re86.json"
+    assert artifact["inference_substrate"] == "live_llm_inference"
+    assert artifact["solve_provenance"] == "live_agent_self_discovery"
+    assert artifact["offline_reproduced"] is True
+    assert artifact["reproduced_levels"] == 2
+    assert artifact["states_expanded"] == 59
+    assert artifact["search_state_count"] == 59
+    assert artifact["self_play_residual"] == "checkpoint_refreshed_gate_passed"
+    assert int(artifact["checkpoint_mtime_after_ns"]) > int(artifact["checkpoint_mtime_before_ns"])
+    assert artifact["checkpoint_mtime_delta_ns"] > 0
+    assert artifact["schema_errors"] == []
+    assert exp4863.artifact_schema_errors(artifact) == []
+
+
+def test_scenario_arc_wmte_4863_residual_and_blocked_paths(
+    tmp_path: Path, monkeypatch
+) -> None:
+    """SCENARIO-ARC-WMTE-4863-RESIDUAL-NO-FABRICATION: failures stay residuals."""
+
+    monkeypatch.setattr(exp4863, "REPO", tmp_path)
+    failed = _loop_result("re86", reached_level=0, reproduced=False)
+    failed["learned_verifier_checkpoint"] = None
+
+    summary = exp4863.summarize_loop_result(
+        game="re86",
+        loop_result=failed,
+        loop_result_path="results/arc_loop_solve_re86.json",
+        checkpoint_mtime_before_ns=123,
+    )
+    artifact = exp4863.build_artifact(
+        target_selection={
+            "game": "re86",
+            "prior_level": 2,
+            "banked": True,
+            "reason": "preferred_banked_target",
+        },
+        loop_summary=summary,
+        preconditions_checked={
+            "offline_arcade": {"ok": True},
+            "registry_loadable": {"ok": True},
+            "checkpoint_existing": {"ok": False},
+        },
+    )
+    blocked = exp4863.build_blocked_artifact(
+        reason="checkpoint_missing",
+        preconditions_checked={
+            "offline_arcade": {"ok": True},
+            "registry_loadable": {"ok": True},
+            "target_banked": {"ok": True, "game": "re86", "prior_level": 2},
+            "checkpoint_existing": {"ok": False, "path": "models/arc_verifier_re86.json"},
+        },
+        target_game="re86",
+    )
+    missing = exp4863.summarize_loop_result(
+        game="re86",
+        loop_result=None,
+        loop_result_path="results/arc_loop_solve_re86.json",
+        checkpoint_mtime_before_ns="bad",
+    )
+
+    assert artifact["honest_verdict"] == "complete_re86_self_play_residual_reproduction_gate_failed"
+    assert artifact["verifier_checkpoint_refreshed"] is False
+    assert artifact["checkpoint_path"] is None
+    assert artifact["checkpoint_mtime_after_ns"] is None
+    assert artifact["checkpoint_mtime_delta_ns"] is None
+    assert artifact["schema_errors"] == []
+    assert blocked["honest_verdict"] == "blocked_checkpoint_missing"
+    assert blocked["target_game"] == "re86"
+    assert blocked["verifier_checkpoint_refreshed"] is False
+    assert blocked["schema_errors"] == []
+    assert missing["self_play_residual"] == "loop_result_missing"
+    assert missing["checkpoint_mtime_before_ns"] is None
+    assert missing["search_state_count"] == 0
+
+
+def test_req_arc_wmte_4863_schema_rejects_stale_metadata_and_bad_success(
+    tmp_path: Path, monkeypatch
+) -> None:
+    """REQ-ARC-WMTE-4863: schema rejects stale identity and fabricated success."""
+
+    artifact = _success_artifact(tmp_path, monkeypatch)
+
+    for field, old_value, expected in (
+        ("experiment", exp4853.EXPERIMENT, "experiment_mismatch"),
+        ("schema", exp4853.SCHEMA, "schema_mismatch"),
+        ("spec_refs", exp4853.SPEC_REFS, "spec_refs_mismatch"),
+        ("random_seed", exp4853.RANDOM_SEED, "random_seed_mismatch"),
+    ):
+        stale = dict(artifact)
+        stale[field] = old_value
+        stale["reproducibility_checksum"] = exp4863.stable_checksum(stale)
+        assert expected in exp4863.artifact_schema_errors(stale)
+
+    wrong_verdict = dict(artifact, honest_verdict="success_re86_L2_checkpoint_refreshed")
+    wrong_verdict["reproducibility_checksum"] = exp4863.stable_checksum(wrong_verdict)
+    assert "success_verdict_mismatch" in exp4863.artifact_schema_errors(wrong_verdict)
+
+    bad_principle = dict(artifact, field_principles={})
+    bad_principle["reproducibility_checksum"] = exp4863.stable_checksum(bad_principle)
+    assert "missing_principle:checkpoint_path" in exp4863.artifact_schema_errors(bad_principle)
+
+    missing_result_path = dict(artifact)
+    missing_result_path.pop("result_path")
+    missing_result_path["reproducibility_checksum"] = exp4863.stable_checksum(missing_result_path)
+    result_path_errors = exp4863.artifact_schema_errors(missing_result_path)
+    assert "missing_field:result_path" in result_path_errors
+    assert "result_path_mismatch" in result_path_errors
+
+    monkeypatch.setattr(
+        exp4863,
+        "REQUIRED_FIELDS",
+        exp4863.REQUIRED_FIELDS + ("exp4863_only_field",),
+    )
+    exp4863_only_missing = dict(artifact)
+    exp4863_only_missing["reproducibility_checksum"] = exp4863.stable_checksum(
+        exp4863_only_missing
+    )
+    assert "missing_field:exp4863_only_field" in exp4863.artifact_schema_errors(
+        exp4863_only_missing
+    )
+
+    missing_checkpoint_check = dict(artifact, preconditions_checked={})
+    missing_checkpoint_check["reproducibility_checksum"] = exp4863.stable_checksum(
+        missing_checkpoint_check
+    )
+    assert "preconditions_missing_checkpoint_check" in exp4863.artifact_schema_errors(
+        missing_checkpoint_check
+    )
+
+    success_without_gate = dict(artifact, reproduced_levels="bad")
+    success_without_gate["reproducibility_checksum"] = exp4863.stable_checksum(
+        success_without_gate
+    )
+    assert "success_verdict_without_gate" in exp4863.artifact_schema_errors(
+        success_without_gate
+    )
+
+
+def test_req_arc_wmte_4863_helpers_and_main_write_artifacts(
+    tmp_path: Path, monkeypatch
+) -> None:
+    """REQ-ARC-WMTE-4863: IO helpers and main write terminal artifacts."""
+
+    (tmp_path / "results").mkdir()
+    (tmp_path / "models").mkdir()
+    ckpt = tmp_path / "models" / "arc_verifier_re86.json"
+    ckpt.write_text("{}", encoding="utf-8")
+    before_ns = ckpt.stat().st_mtime_ns - 1
+    loop_path = tmp_path / "results" / "arc_loop_solve_re86.json"
+    loop_path.write_text(json.dumps(_loop_result("re86")), encoding="utf-8")
+    list_payload = tmp_path / "results" / "list.json"
+    list_payload.write_text("[]", encoding="utf-8")
+
+    monkeypatch.setattr(exp4863, "REPO", tmp_path)
+    monkeypatch.setattr(exp4863, "RESULTS", tmp_path / "results")
+    monkeypatch.setattr(exp4863, "ARTIFACT", tmp_path / exp4863.RESULT_RELATIVE_PATH)
+    monkeypatch.setattr(
+        exp4863,
+        "check_preconditions",
+        lambda game=None: {
+            "ok": True,
+            "offline_arcade": {"ok": True},
+            "registry_loadable": {"ok": True},
+            "target_banked": {"ok": True, "game": "re86", "prior_level": 2},
+            "checkpoint_existing": {"ok": True, "path": "models/arc_verifier_re86.json"},
+            "target_selection": {
+                "game": "re86",
+                "prior_level": 2,
+                "banked": True,
+                "reason": "preferred_banked_target",
+            },
+        },
+    )
+
+    assert exp4863._read_loop_result(tmp_path / "missing.json") is None  # noqa: SLF001
+    assert exp4863._read_loop_result(list_payload) is None  # noqa: SLF001
+    assert exp4863._read_loop_result(loop_path)["game"] == "re86"  # noqa: SLF001
+    assert exp4863._relative_path(loop_path) == "results/arc_loop_solve_re86.json"  # noqa: SLF001
+    assert exp4863._relative_path(Path("/outside.json")) == "/outside.json"  # noqa: SLF001
+    assert exp4863._precondition_failure(  # noqa: SLF001
+        {
+            "offline_arcade": {"ok": False},
+            "registry_loadable": {"ok": True},
+            "target_banked": {"ok": True},
+            "checkpoint_existing": {"ok": False},
+        }
+    ) == "offline_arcade_missing"
+    assert exp4863._precondition_failure(  # noqa: SLF001
+        {
+            "offline_arcade": {"ok": True},
+            "registry_loadable": {"ok": True},
+            "target_banked": {"ok": True},
+            "checkpoint_existing": {"ok": False},
+        }
+    ) == "checkpoint_missing"
+    assert exp4863._precondition_failure(  # noqa: SLF001
+        {
+            "offline_arcade": {"ok": True},
+            "registry_loadable": {"ok": True},
+            "target_banked": {"ok": True},
+            "checkpoint_existing": {"ok": True},
+        }
+    ) is None
+    monkeypatch.setattr(exp4863.previous, "_precondition_failure", lambda preconditions: None)
+    assert exp4863._precondition_failure(  # noqa: SLF001
+        {"checkpoint_existing": {"ok": False}}
+    ) == "checkpoint_missing"
+
+    assert exp4863.main(["--game", "re86", "--checkpoint-mtime-before-ns", str(before_ns)]) == 0
+    written = json.loads((tmp_path / exp4863.RESULT_RELATIVE_PATH).read_text(encoding="utf-8"))
+    assert written["honest_verdict"] == "success_self_play_checkpoint_refreshed"
+    assert written["checkpoint_path"] == "models/arc_verifier_re86.json"
+    assert written["schema_errors"] == []
+
+    blocked_path = tmp_path / "blocked" / exp4863.RESULT_RELATIVE_PATH
+    monkeypatch.setattr(exp4863, "ARTIFACT", blocked_path)
+    monkeypatch.setattr(
+        exp4863,
+        "check_preconditions",
+        lambda game=None: {
+            "ok": False,
+            "offline_arcade": {"ok": True},
+            "registry_loadable": {"ok": True},
+            "target_banked": {"ok": True, "game": "re86", "prior_level": 2},
+            "checkpoint_existing": {"ok": False, "path": "models/arc_verifier_re86.json"},
+            "target_selection": {
+                "game": "re86",
+                "prior_level": 2,
+                "banked": True,
+                "reason": "preferred_banked_target",
+            },
+        },
+    )
+
+    assert exp4863.main(["--game", "re86"]) == 0
+    blocked = json.loads(blocked_path.read_text(encoding="utf-8"))
+    assert blocked["honest_verdict"] == "blocked_checkpoint_missing"
+    assert blocked["checkpoint_path"] is None
+    assert blocked["schema_errors"] == []
