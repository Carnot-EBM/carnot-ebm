+        "live_solve_rate_search_baseline": 0.0,
+        "solve_rate_delta": 0.25,
+        "first_win_rate_delta": 0.0,
+        "qd_lift_ci": {"ci95": [0.10, 0.40], "point": 0.25},
+        "random_mutation_ablation_passed": False,
+        "random_seed": RANDOM_SEED,
