+    missing_critical = _flag_kind(missing_flags, av.QD_WITHOUT_RANDOM_MUTATION_ABLATION_KIND)
+    missing_warn = _flag_kind(missing_flags, av.QD_RANDOM_MUTATION_ABLATION_OMITTED_KIND)
