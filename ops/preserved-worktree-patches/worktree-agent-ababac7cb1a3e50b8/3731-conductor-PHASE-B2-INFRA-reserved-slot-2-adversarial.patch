+REPO = Path(__file__).resolve().parents[2]
+SPEC_PATH = REPO / "openspec" / "capabilities" / "arc-world-model-trust-energy" / "spec.md"
+A1_PATH = REPO / "results" / "experiment_4652_value_routing_cost_fix_live.json"
