+    if meta.get("loadable") is not True:
+        return ["exp5474_missing_or_unloadable"]
+    failures: list[str] = []
+    if exp5474.get("milestone") != PREVIOUS_MILESTONE:
+        failures.append(
+            f"exp5474_milestone_expected_{PREVIOUS_MILESTONE}_observed_{exp5474.get('milestone')}"
