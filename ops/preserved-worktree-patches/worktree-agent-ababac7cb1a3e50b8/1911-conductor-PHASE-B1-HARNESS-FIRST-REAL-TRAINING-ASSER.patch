+def test_scenario_code_4234_base_blocker_forbids_qwen_substitute(tmp_path: Path) -> None:
+    """SCENARIO-CODE-4234-BLOCKED-PRECONDITION: missing approved Gemma base blocks."""
+
+    stable = _stable_checkpoint(tmp_path)
