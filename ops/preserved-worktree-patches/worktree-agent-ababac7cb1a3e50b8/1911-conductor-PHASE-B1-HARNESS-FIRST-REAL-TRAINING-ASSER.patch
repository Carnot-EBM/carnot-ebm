+    assert "REQ-CODE-4234" in spec
+    assert "SCENARIO-CODE-4234-BLOCKED-PRECONDITION" in spec
+    assert "SCENARIO-CODE-4234-REAL-TRAINING" in spec
+    for field in exp4234.REQUIRED_ARTIFACT_FIELDS:
