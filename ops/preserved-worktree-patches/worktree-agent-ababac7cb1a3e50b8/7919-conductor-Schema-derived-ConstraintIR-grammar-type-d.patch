+                "name": "rule.define",
+                "kind": "composition",
+                "required_keys": ["id", "variables", "body", "head"],
+                "defines": ["rule", "rule.variables"],
+                "uses": ["predicate", "domain"],
+            },
+            {
+                "name": "query.define",
+                "kind": "composition",
+                "required_keys": ["vars", "where"],
