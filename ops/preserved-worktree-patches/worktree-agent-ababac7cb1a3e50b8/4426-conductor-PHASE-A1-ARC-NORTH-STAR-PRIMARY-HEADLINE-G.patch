+    soft_elapsed_budget_s: float = DEFAULT_SOFT_ELAPSED_BUDGET_S,
+    heldout_games: Sequence[str] = HELDOUT_GAMES,
+) -> JsonDict:
+    rows = {str(k): dict(v) for k, v in per_game_fork.items()}
