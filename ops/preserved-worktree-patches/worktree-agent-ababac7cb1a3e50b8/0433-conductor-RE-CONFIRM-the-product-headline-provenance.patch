+    )
+    assert exp3799.terminal_status("not_yet_headline_eligible") == "not_yet_eligible"
+
+
+def test_exp2090_missing_and_fallback_fields_are_explicit(tmp_path):
+    """Exp 2090 fallbacks stay explicit and sanitized.
