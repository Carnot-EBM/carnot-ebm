+    if [str(row.get("hf_id") or "") for row in model_specs] == list(MANDATED_MODEL_HF_IDS):
+        return [dict(row) for row in model_specs]
+    return [{"hf_id": model_id, "cached_activation_only": True} for model_id in MANDATED_MODEL_HF_IDS]
