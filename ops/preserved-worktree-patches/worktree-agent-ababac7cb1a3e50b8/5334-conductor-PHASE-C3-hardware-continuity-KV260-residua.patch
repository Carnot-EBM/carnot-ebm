+def run_experiment(
+    *,
+    repo_root: str | Path = ".",
+    command_runner: CommandRunner = run_command,
+    clock: Clock = time.perf_counter,
+    run_date: str = "20260701",
+    tests_run: Sequence[str] | None = None,
+) -> Path:
+    prepend_oss_cad_suite()
+    artifact = build_artifact(
+        repo_root=repo_root,
+        command_runner=command_runner,
+        clock=clock,
+        run_date=run_date,
+        tests_run=tests_run,
+    )
