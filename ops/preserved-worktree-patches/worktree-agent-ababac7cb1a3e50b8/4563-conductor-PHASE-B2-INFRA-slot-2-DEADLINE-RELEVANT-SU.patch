+def test_scenario_capstone_4898_missing_model_path_blocks_without_submit_claim() -> None:
+    """SCENARIO-CAPSTONE-4898-BLOCKED-PRECONDITION: missing frozen GGUF/server blocks."""
+
+    artifact = mod.build_artifact(
+        preconditions_checked=_preconditions(True),
+        package_builds=_package_builds(True),
