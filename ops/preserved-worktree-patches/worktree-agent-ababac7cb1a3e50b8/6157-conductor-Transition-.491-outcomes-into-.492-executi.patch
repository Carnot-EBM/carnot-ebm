+    (git_repo / mod.ROADMAP_RELATIVE_PATH).write_text("milestone: 2026.07.492\n", encoding="utf-8")
+    assert mod.git_path_modified(git_repo, mod.ROADMAP_RELATIVE_PATH) is True
