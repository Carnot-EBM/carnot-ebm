+    assert mod.extract_roadmap_tasks({"tasks": [{"id": "x"}, "bad"]}) == ["x"]
+    assert mod.path_sha256(tmp_path / "missing") is None
+    assert mod.git_path_modified(tmp_path, mod.ROADMAP_RELATIVE_PATH) is False
