+program        := policy_header states_line actions_line rule_line+ end_line
+policy_header  := "policy" IDENT
+states_line    := "states:" IDENT ("," IDENT)* ";"
+actions_line   := "actions:" IDENT ("," IDENT)* ";"
+rule_line      := "rule" STATE "->" ACTION ";"
