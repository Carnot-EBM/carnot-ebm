+def _model_revision(path: str | None) -> str | None:
+    if not path:
+        return None
+    parts = Path(path).parts
+    if "snapshots" in parts:
+        idx = parts.index("snapshots")
+        if idx + 1 < len(parts):
+            return parts[idx + 1]
+    return None
+
