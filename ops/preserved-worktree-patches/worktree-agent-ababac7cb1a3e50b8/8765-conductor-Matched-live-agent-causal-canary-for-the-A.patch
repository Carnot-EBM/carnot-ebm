+def _quant_from_path(path: str | None) -> str:
+    name = Path(path or "").name
+    for token in ("UD-Q4_K_M", "Q4_K_M", "UD-Q5_K_M", "Q5_K_M", "Q8_0"):
+        if token.lower() in name.lower():
+            return token
+    return PREFERRED_QUANT
