 .../carnot/agentic/arc_competition_agent.py   | 13 ++++-
 .../agentic/arc_executable_world_model.py     | 18 ++++++-
 scripts/arc_e3_cellrecall_gate_probe.py       | 48 +++++++++++++++++++
