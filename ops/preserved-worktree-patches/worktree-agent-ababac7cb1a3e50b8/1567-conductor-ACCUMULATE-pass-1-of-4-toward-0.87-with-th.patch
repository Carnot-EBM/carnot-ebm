+def lr_continued_not_rewarmed(first_lr: float | None) -> bool:
+    """REQ-LEARN-4135: reject the known fresh-warmup LR reset."""
+
+    if first_lr is None:
+        return False
+    return not math.isclose(first_lr, exp4126.FRESH_WARMUP_FIRST_LR, rel_tol=0.0, abs_tol=1e-12)
+
