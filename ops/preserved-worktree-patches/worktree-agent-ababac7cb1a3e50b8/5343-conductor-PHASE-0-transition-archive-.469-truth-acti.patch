+        _task_yaml() if active_valid else _task_yaml("2026.07.469", last=5124),
+        encoding="utf-8",
+    )
+    capstone = _capstone_payload()
+    _write_json(root / mod.CAPSTONE_RELATIVE_PATH, capstone)
+    for row in capstone["artifacts_read"]:
