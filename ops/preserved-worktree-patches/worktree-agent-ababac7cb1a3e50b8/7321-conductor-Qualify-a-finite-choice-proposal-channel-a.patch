+        },
+        "n_gpu_layers_offloaded": {
+            hf_id: int(receipts_by_model.get(hf_id, {}).get("n_gpu_layers_offloaded") or 0)
+            for hf_id in MANDATED_MODEL_IDS
+        },
+        "gpu_memory_receipts": {
