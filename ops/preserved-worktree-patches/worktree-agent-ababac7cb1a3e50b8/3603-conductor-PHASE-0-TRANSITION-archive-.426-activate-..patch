+            "available": True,
+            "parses": False,
+            "milestone": None,
+            "error": str(exc),
+        }
+    milestone = loaded.get("milestone") if isinstance(loaded, Mapping) else None
+    return {
+        "path": str(path),
+        "available": True,
+        "parses": True,
+        "milestone": str(milestone) if milestone is not None else None,
+    }
+
