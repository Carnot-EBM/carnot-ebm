+            resumed.write_terminal_unit("u1", {"value": stage})
+            receipt = resumed.finalize(_payload(f"{stage}_resumed"))
+            assert receipt["atomic_replace"] is True
+            loaded = json.loads((tmp_path / "final.json").read_text(encoding="utf-8"))
