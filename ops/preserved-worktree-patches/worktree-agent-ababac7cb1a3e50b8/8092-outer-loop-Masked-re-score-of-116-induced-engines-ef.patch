+#!/usr/bin/env python3
+"""Assemble the scored artifact from the frozen raw re-score + analysis. Pure arithmetic."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import pathlib
+import subprocess
+import time
+
+REPO = pathlib.Path("/home/ianblenke/github.com/ianblenke/carnot")
+OUT = REPO / "results" / "arc_hud_masked_rescore_20260801"
+AB = REPO / "results" / "arc_object_perception_ab_change_fidelity_20260801"
+CAP = REPO / "results" / "arc_hud_mask_capture_20260801"
+
+
+def sha(p: pathlib.Path) -> str:
+    return "sha256:" + hashlib.sha256(p.read_bytes()).hexdigest()
+
+
+def sign_str(st: dict) -> str:
+    """ "+15/-3/=2" -- positives, negatives, dropped ties, in the sign test's own vocabulary."""
+    return f"+{st['n_positive']}/-{st['n_negative']}/={st['n_ties']}"
+
+
+ARM_NAMES = (
+    "unmasked",
+    "default_swallow_full",
+    "default_swallow_slice",
+    "default_forced_guard_bypassed",
+    "conditional_swallow_full",
+    "conditional_swallow_slice",
+    "conditional_forced_guard_bypassed",
+)
+_CMP = ("change_fidelity", "hud_mask_status", "hud_mask_cells", "n_changing")
+
+
+def arm_redundancy(cells: list[dict], label: str) -> dict:
+    """WHICH OF THE SEVEN ARMS ARE ACTUALLY DISTINCT ON THIS CORPUS.
+
+    Added after adversarial review. Reporting seven arms when several are byte-identical is the
+    A/B's own "second column of identical numbers wearing a different name" failure committed
+    one level up -- it makes a single measurement look like several agreeing ones. So the
+    redundancy is MEASURED and stated rather than left for a reader to discover by diffing.
+    """
+    ok = [c for c in cells if c.get("status") == "ok"]
+
+    def sig(arm: str) -> list:
+        return [tuple((c.get("arms") or {}).get(arm, {}).get(f) for f in _CMP) for c in ok]
+
+    sigs = {a: sig(a) for a in ARM_NAMES}
+    groups: list[list[str]] = []
+    for a in ARM_NAMES:
+        for g in groups:
+            if sigs[a] == sigs[g[0]]:
+                g.append(a)
+                break
+        else:
+            groups.append([a])
+    return {
+        "corpus": label,
+        "n_units": len(ok),
+        "n_arms_reported": len(ARM_NAMES),
+        "n_arms_DISTINCT": len(groups),
+        "identical_arm_groups": groups,
+    }
+
+
+def main() -> int:  # noqa: C901
+    raw = json.loads((OUT / "rescore_masked_raw.json").read_text())
+    an = json.loads((OUT / "analysis.json").read_text())
+    det = json.loads((OUT / "determinism_witness.json").read_text())
+    q1, q2, q3 = (
+        an["Q1_does_the_degeneracy_die"],
+        an["Q2_does_the_object_perception_effect_survive"],
+        an["Q3_does_masking_change_what_the_metric_means"],
+    )
+    q3b = an["Q3b_rank_stability_the_same_question_where_n_is_not_2"]
+    arms = q2["arms"]
+    head = arms["default_swallow_full"]
+    cond = arms["conditional_swallow_full"]
+    un = arms["unmasked"]
+    git_head = subprocess.run(  # noqa: S603
+        ["git", "-C", str(REPO), "rev-parse", "HEAD"], capture_output=True, text=True, check=False
+    ).stdout.strip()
+
+    tn_perfect = [c for c in q1["perfect_candidates"]]
+    ab_tn36 = [c for c in raw["ab_cells"] if c.get("game") == "tn36" and c.get("status") == "ok"]
+    ab_perfect = [
+        c
+        for c in raw["ab_cells"]
+        if c.get("status") == "ok" and c["arms"]["unmasked"]["change_fidelity"] >= 0.999
+    ]
+
+    def slim(c: dict) -> dict:
+        keep = (
+            "change_fidelity",
+            "accuracy",
+            "n",
+            "n_changing",
+            "correct_changed_cells",
+            "spurious_changed_cells",
+            "hud_mask_status",
+            "hud_mask_cells",
+        )
+        return {
+            "cell": c["cell"],
+            **{
+                a: {k: c["arms"][a][k] for k in keep}
+                for a in ("unmasked", "conditional_swallow_full")
+            },
+        }
+
+    _ab_def = q3b["ab_116_engines"]["default_swallow_full"]
+    n_moved_ab = _ab_def["n_units_whose_score_moved_at_all"]
+    n_masked_ab = _ab_def["n_units_masked"]
+
+    art = {
+        "experiment": "arc_hud_masked_rescore_20260801",
+        "schema": "carnot.arc.hud_masked_rescore.v1",
+        "title": (
+            "Re-score of 116 induced world-model engines with compare-time HUD masking ON, "
+            "and of the 31 best-of-N candidates that carry plan_found"
+        ),
+        "run_date": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        "git_head": git_head,
+        "requirement": "REQ-ARC-WMTE-6010 / 6015 / 6017",
+        "milestone": "outer-loop 2026-08-01",
+        # ---------------------------------------------------------------------------
+        "honest_verdict": (
+            "complete_masked_rescore_effect_survives_p_0_0075_but_the_p_gain_is_a_lost_negative_"
+            "game_not_new_evidence_and_the_tn36_degeneracy_does_not_die_because_the_shipped_guard_"
+            "refuses_that_mask_and_forcing_it_deletes_the_whole_corpus\n\n"
+            "THE HEADLINE, WHICH IS NOT THE ONE THE TASK EXPECTED. Masking does NOT fix the "
+            "degeneracy, and the reason is not that the mask is wrong -- it is that on tn36's "
+            "best-of-N window there is nothing else to measure. All 25 changed cells across all "
+            "25 changing transitions of that corpus lie inside row 1, one cell per transition. "
+            "So the six perfect-1.0 bar-tickers are a perfect model of that corpus, the metric "
+            "was indeed measuring the HUD, and masking the HUD leaves a corpus with zero "
+            "dynamics. change_fidelity then reads 0.0 for ALL EIGHT tn36 candidates -- including "
+            "the single PLANNABLE one, which falls from 0.235294 to 0.0 alongside the tickers. "
+            "The degeneracy dies by the metric becoming undefined, not by the metric becoming "
+            "discriminating. This is a CORPUS defect, not a masking switch.\n\n"
+            "AND THE SHIPPED GUARD ALREADY REFUSES IT, CORRECTLY. Two independent shipped "
+            "mechanisms both decline to apply that mask, neither of which was touched here: the "
+            "capture artifact WITHHELD tn36 row 1 from the default mask at its stage-2 gate (so "
+            "the default arm resolves `unresolved` and the six stay at 1.0), and when the "
+            "withheld band is folded in anyway, REQ-ARC-WMTE-6015's swallow guard refuses it "
