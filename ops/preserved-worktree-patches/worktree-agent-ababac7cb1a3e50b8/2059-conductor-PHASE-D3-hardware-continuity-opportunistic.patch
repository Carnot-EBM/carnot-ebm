+
+import json
+import sys
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(REPO_ROOT / "python"))
+
+
+def main() -> None:
+    from carnot.experiment_4278_hardware_continuity import run_experiment
