+def _live_artifact(rows: list[dict[str, Any]]) -> dict[str, Any]:
+    return {
+        "schema": "arc_scored_path_lever_harness.rows.v1",
+        "canonical_entrypoint": "E3AgentPolicy",
+        "rows": rows,
+        "arms_used": ["E3_default_llmon"],
+        "budget": 2000,
+    }
