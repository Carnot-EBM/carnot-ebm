+        prompt_token_count=1,
+        requested_output_tokens=1,
+        n_ctx=8,
+        output_dir=tmp_path,
+        timeout_s=5,
+        source_hash="sha256:source",
+        dispatcher="fixture",
+        env_allowlist={},
