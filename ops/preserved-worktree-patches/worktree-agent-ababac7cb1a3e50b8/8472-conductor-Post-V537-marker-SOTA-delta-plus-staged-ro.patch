+
+def _fake_runner(argv: tuple[str, ...], _root: Path) -> mod.JsonDict:
+    return {
+        "command": " ".join(argv),
+        "exit_code": 0,
+        "classification": "passed",
+        "stdout_tail": "",
+        "stderr_tail": "",
+    }
