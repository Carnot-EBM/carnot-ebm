+def _expected_unit_keys() -> set[tuple[str, str, int, int, str]]:
+    return {
+        (fixture.fixture_id, fixture.regime, horizon, seed, arm)
+        for fixture in build_fixtures()
+        for horizon in HORIZONS
+        for seed in HELD_SEEDS
+        for arm in ARMS
+    }
