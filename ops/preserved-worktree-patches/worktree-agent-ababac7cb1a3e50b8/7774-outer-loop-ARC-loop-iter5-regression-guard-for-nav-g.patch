From 8d15c8bacff493a2171506fcc4de4da5e6a996d9 Mon Sep 17 00:00:00 2001
From: Ian Blenke <ian@blenke.com>
Date: Fri, 24 Jul 2026 03:57:49 -0400
Subject: [PATCH 07774/11362] [outer-loop] ARC loop iter5: regression guard for
 nav goal-energy wiring (REQ-ARC-WMTE-5845)

Verified iter4 engages live (plan_in_model keeps goal_energy in its signature so
_planner_accepts_goal_energy returns True -> the nav best-first override is forwarded).
Added a lightweight regression guard so dropping goal_energy/diagnostics/max_nodes from
plan_in_model's signature (which would silently degrade the nav path to plain BFS) fails
CI. No new tractable improvement this cycle.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JntPrUGLNesPcJH1pyfFYw
---
 .../python/test_plan_in_model_component_unpack.py | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/tests/python/test_plan_in_model_component_unpack.py b/tests/python/test_plan_in_model_component_unpack.py
index b2321c0169..92eb59047b 100644
--- a/tests/python/test_plan_in_model_component_unpack.py
+++ b/tests/python/test_plan_in_model_component_unpack.py
@@ -33,3 +33,18 @@ def test_model_candidates_handles_component_grid_without_crashing():
 def test_model_candidates_empty_on_blank_grid():
     cands = _model_candidates(np.zeros((8, 8), dtype=np.int16))
     assert [c["action"] for c in cands] == [1, 2, 3, 4, 5]  # no components -> only directional/confirm
+
+
+def test_plan_in_model_keeps_goal_energy_and_diagnostics_params():
+    # Regression guard for the REQ-ARC-WMTE-5845 nav goal-energy wiring: E3AgentPolicy._call_plan_in_model
+    # only forwards goal_energy/diagnostics when the planner's signature accepts them
+    # (_planner_accepts_goal_energy). If someone drops these params from plan_in_model, the nav best-first
+    # override would silently degrade to plain BFS -- this catches that.
+    import inspect
+
+    from carnot.agentic.arc_executable_world_model import plan_in_model
+
+    params = inspect.signature(plan_in_model).parameters
+    assert "goal_energy" in params
+    assert "diagnostics" in params
+    assert "max_nodes" in params
