+def source_context(root: Path) -> JsonDict:
+    paths = [
+        ROADMAP_RELATIVE_PATH,
+        VNEXT_RELATIVE_PATH,
+        Path("ops/conductor-log.md"),
+        Path("ops/status.md"),
+        Path("ops/changelog.md"),
+        Path("ops/exclusion_manifest.yaml"),
+    ]
+    return {
+        str(path): {
+            "exists": (root / path).exists(),
+            "sha256": file_sha256(root / path),
+        }
+        for path in paths
+    }
+
