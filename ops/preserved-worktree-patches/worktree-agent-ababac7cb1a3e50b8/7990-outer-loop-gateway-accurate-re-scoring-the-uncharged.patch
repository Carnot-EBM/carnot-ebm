+    for level_offline in ([15, 42], [15, 42, 300], [5], [5, 5, 5, 5]):
+        for n_resets in (0, 1, 13, 115):
+            dp, _ = worst_case_allocation(baselines, level_offline, n_resets, 100)
+            gr, _ = greedy_worst_case(baselines, level_offline, n_resets, 100)
+            assert dp <= gr + 1e-9
