):\n        key = (r, c)\n        if key not in parent:\n            parent[key] = par\n            center_ok[key] = center\n            queue.append(key)\n\n    for r, c in seeds:\n        stopped = False\n        for cc in range(c, w):\n            if blockers[r, cc]:\n                add_blocker(r, cc, None, not stopped)\n                if not stopped and right_gate(r, cc):\n                    stopped = True\n            elif not stopped:\n                out[r, cc] = 1\n\n    head = 0\n    while head < len(queue):\n        r, c = queue[head]\n        head += 1\n        cur = (r, c)\n\n        for dr in (-1, 0, 1):\n            rr = r + dr\n            if rr < 0 or rr >= h:\n                continue\n\n            if dr == 0 and not center_ok.get(cur, True):\n                continue\n\n            if dr != 0 and c - 1 >= 0 and blockers[rr, c - 1]:\n                left = (rr, c - 1)\n                if left not in parent or parent.get(cur) == left:\n                    continue\n\n            c0 = max(0, c - 1)\n            c1 = min(w - 1, c + 1)\n            if dr == 0 and right_gate(r, c):\n                c1 = min(c1, c)\n\n            for cc in range(c0, c1 + 1):\n                if blockers[rr, cc]:\n                    add_blocker(rr, cc, cur, True)\n                else:\n                    out[rr, cc] = 1\n\n    return out\n```", "source_artifact": "/home/ianblenke/github.com/ianblenke/carnot/results/arc3_gap4_induced_programs.json", "source_model": "codex", "task": "79fb03f4", "verifier_certification": {"demo_fit": 1.0, "demo_perfect": true, "execution_validated": true, "pred_hash": "657e887892c1f386304b16669180109afa16ef11"}}
