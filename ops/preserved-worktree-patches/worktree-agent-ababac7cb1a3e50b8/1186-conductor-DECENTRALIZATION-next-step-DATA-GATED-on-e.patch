dtype)\n    dr = blank_sp[0] - pat_sp[0]\n    dc = blank_sp[1] - pat_sp[1]\n\n    for r in range(pat_sub.shape[0]):\n        for c in range(pat_sub.shape[1]):\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < out.shape[0] and 0 <= nc < out.shape[1]:\n                out[nr, nc] = pat_sub[r, c]\n\n    return out\n```", "source_artifact": "/home/ianblenke/github.com/ianblenke/carnot/results/arc3_gap4_induced_programs.json", "source_model": "codex", "task": "2f0c5170", "verifier_certification": {"demo_fit": 1.0, "demo_perfect": true, "execution_validated": true, "pred_hash": "96c9d3e703dded91151b791709624f8d5e5424cf"}}
