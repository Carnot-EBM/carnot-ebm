p.argmax(counts)]\n\n    sep_col = None\n    for c in range(w):\n        if np.all(grid[:, c] == grid[0, c]) and grid[0, c] != bg and grid[0, c] != 0:\n            sep_col = c\n            break\n\n    if sep_col is None:\n        return out\n\n    left = grid[:, :sep_col]\n    out[:, :sep_col] = bg\n\n    seen = np.zeros((h, sep_col), dtype=bool)\n\n    for r in range(h):\n        for c in range(sep_col):\n            if left[r, c] != 0 or seen[r, c]:\n                continue\n\n            stack = [(r, c)]\n            seen[r, c] = True\n            comp = []\n\n            while stack:\n                rr, cc = stack.pop()\n                comp.append((rr, cc))\n                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nr, nc = rr + dr, cc + dc\n                    if 0 <= nr < h and 0 <= nc < sep_col and not seen[nr, nc] and left[nr, nc] == 0:\n                        seen[nr, nc] = True\n                        stack.append((nr, nc))\n\n            max_c = max(cc for _, cc in comp)\n            shift = (sep_col - 1) - max_c\n\n            for rr, cc in comp:\n                out[rr, cc + shift] = 0\n\n    for r in range(h):\n        if sep_col - 1 >= 1 and out[r, sep_col - 1] == 0 and out[r, sep_col - 2] == bg:\n            out[r, sep_col + 1:] = 2\n\n    return out\n```", "source_artifact": "/home/ianblenke/github.com/ianblenke/carnot/results/arc3_gap4_arc2_induced_programs.json", "source_model": "codex", "task": "6e453dd6", "verifier_certification": {"demo_fit": 1.0, "demo_perfect": true, "execution_validated": true, "pred_hash": "093ae93e11a2a292a16f3989d6ae108ca315dadd"}}
