hars": 7854, "quality_score": 1.0}, "response": "```python\ndef transform(grid):\n    out = grid.copy()\n    H, W = grid.shape\n\n    # Find the full separator row/column.\n    sep_rows = [r for r in range(H) if len(set(grid[r, :].tolist())) == 1]\n    sep_cols = [c for c in range(W) if len(set(grid[:, c].tolist())) == 1]\n    sr = sep_rows[0]\n    sc = sep_cols[0]\n\n    bg = 4\n    mark = 2\n\n    # Source pattern is the non-background object in the top-left quadrant.\n    tl = grid[:sr, :sc]\n    pts = [(r, c) for r in range(tl.shape[0]) for c in range(tl.shape[1]) if tl[r, c] != bg]\n    r0, r1 = min(r for r, c in pts), max(r for r, c in pts)\n    c0, c1 = min(c for r, c in pts), max(c for r, c in pts)\n    patch = tl[r0:r1 + 1, c0:c1 + 1]\n\n    # Bounding box of the marker color inside the source patch.\n    mpts = [(r, c) for r in range(patch.shape[0]) for c in range(patch.shape[1]) if patch[r, c] == mark]\n    mr0, mr1 = min(r for r, c in mpts), max(r for r, c in mpts)\n    mc0, mc1 = min(c for r, c in mpts), max(c for r, c in mpts)\n    mh = mr1 - mr0 + 1\n    mw = mc1 - mc0 + 1\n\n    def orient(p, where):\n        if where == \"tr\":\n            return p[:, ::-1]\n        if where == \"bl\":\n            return p[::-1, :]\n        if where == \"br\":\n            return p[::-1, ::-1]\n        return p\n\n    def marker_bbox(p):\n        ps = [(r, c) for r in range(p.shape[0]) for c in range(p.shape[1]) if p[r, c] == mark]\n        return min(r for r, c in ps), max(r for r, c in ps), min(c for r, c in ps), max(c for r, c in ps)\n\n    def resize_nearest(p, num_h, den_h, num_w, den_w):\n        nh = p.shape[0] * num_h // den_h\n        nw = p.shape[1] * num_w // den_w\n        res = np.full((nh, nw), bg, dtype=grid.dtype)\n        for r in range(nh):\n            srp = min((r * den_h) // num_h, p.shape[0] - 1)\n            for c in range(nw):\n                scp = min((c * den_w) // num_w, p.shape[1] - 1)\n                res[r, c] = p[srp, scp]\n        return res\n\n    targets = [\n        (\"tr\", 0, sr, sc + 1, W),\n        (\"bl\", sr + 1, H, 0, sc),\n        (\"br\", sr + 1, H, sc + 1, W),\n    ]\n\n    for name, ra, rb, ca, cb in targets:\n        q = grid[ra:rb, ca:cb]\n        spts = [(r, c) for r in range(q.shape[0]) for c in range(q.shape[1]) if q[r, c] == mark]\n        if not spts:\n            continue\n\n        sr0, sr1 = min(r for r, c in spts), max(r for r, c in spts)\n        sc0, sc1 = min(c for r, c in spts), max(c for r, c in spts)\n        sh = sr1 - sr0 + 1\n        sw = sc1 - sc0 + 1\n\n        p = orient(patch, name)\n        pr0, pr1, pc0, pc1 = marker_bbox(p)\n\n        p = resize_nearest(p, sh, mh, sw, mw)\n        pr0 = pr0 * sh // mh\n        pc0 = pc0 * sw // mw\n\n        top = ra + sr0 - pr0\n        left = ca + sc0 - pc0\n\n        for r in range(p.shape[0]):\n            for c in range(p.shape[1]):\n                rr, cc = top + r, left + c\n                if 0 <= rr < H and 0 <= cc < W and p[r, c] != bg:\n                    out[rr, cc] = p[r, c]\n\n    return out\n```", "source_artifact": "/home/ianblenke/github.com/ianblenke/carnot/results/arc3_gap4_arc2_induced_programs.json", "source_model": "codex", "task": "b10624e5", "verifier_certification": {"demo_fit": 1.0, "demo_perfect": true, "execution_validated": true, "pred_hash": "9993471e6d4389d20bb5ed1e9329e2f357f72a1e"}}
