rue\n        return False\n\n    def col_support(c, a, b):\n        for rr in (a, a + 1, b - 1, b):\n            if 0 <= rr < h:\n                for cc in range(max(0, c - 2), min(w, c + 3)):\n                    if cc != c and fg[rr, cc]:\n                        return True\n        return False\n\n    for r in range(h):\n        xs = np.flatnonzero(out[r] == col)\n        if len(xs) < 2:\n            continue\n        for a, b in zip(xs[:-1], xs[1:]):\n            if 1 < b - a <= 4 and row_support(r, a, b):\n                out[r, a:b + 1] = col\n\n    for c in range(w):\n        ys = np.flatnonzero(out[:, c] == col)\n        if len(ys) < 2:\n            continue\n        for a, b in zip(ys[:-1], ys[1:]):\n            if 1 < b - a <= 5 and col_support(c, a, b):\n                out[a:b + 1, c] = col\n\n    return out\n```", "source_artifact": "/home/ianblenke/github.com/ianblenke/carnot/results/arc3_gap4_arc2_induced_programs.json", "source_model": "codex", "task": "7b80bb43", "verifier_certification": {"demo_fit": 1.0, "demo_perfect": true, "execution_validated": true, "pred_hash": "c0b47071c02ddcd09621c1c1b25d856f06718aca"}}
