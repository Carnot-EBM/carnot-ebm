+def _program_payload() -> dict[str, object]:
+    return {
+        "programs": [
+            {
+                "task": "T1",
+                "code": "def transform(grid):\n    return grid + 1\n",
+                "demo_fit": 1.0,
+                "demo_perfect": True,
