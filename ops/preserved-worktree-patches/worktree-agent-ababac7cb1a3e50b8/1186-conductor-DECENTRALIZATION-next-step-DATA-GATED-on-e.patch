          seen[nx, ny] = True\n                            stack.append((nx, ny))\n                rs = [x for x, y in cells]\n                cs = [y for x, y in cells]\n                box = (min(rs), max(rs), min(cs), max(cs), vals_here)\n                if 2 in vals_here:\n                    key = box\n                elif 8 in vals_here and bg_color in vals_here:\n                    patterns.append(box)\n\n    kr0, kr1, kc0, kc1, _ = key\n    key_arr = g[kr0:kr1 + 1, kc0:kc1 + 1]\n    key_mask = (key_arr == 8)\n    kh, kw = key_arr.shape\n\n    # The guide pattern is the small component made from output color and 8.\n    guide = max(patterns, key=lambda b: (b[1] - b[0] + 1) * (b[3] - b[2] + 1))\n    gr0, gr1, gc0, gc1, _ = guide\n    guide_arr = g[gr0:gr1 + 1, gc0:gc1 + 1]\n    gh, gw = guide_arr.shape\n\n    tiles_h = out_h // kh\n    tiles_w = out_w // kw\n    block_h = gh // tiles_h\n    block_w = gw // tiles_w\n\n    out = np.full((out_h, out_w), bg_color, dtype=g.dtype)\n    for tr in range(tiles_h):\n        for tc in range(tiles_w):\n            block = guide_arr[tr * block_h:(tr + 1) * block_h, tc * block_w:(tc + 1) * block_w]\n            if np.any(block == 8):\n                rr = tr * kh\n                cc = tc * kw\n                out[rr:rr + kh, cc:cc + kw][key_mask] = 8\n\n    return out\n```", "source_artifact": "/home/ianblenke/github.com/ianblenke/carnot/results/arc3_gap4_induced_programs.json", "source_model": "codex", "task": "5833af48", "verifier_certification": {"demo_fit": 1.0, "demo_perfect": true, "execution_validated": true, "pred_hash": "7c104bb7f1cfe4177379346bb41565bd5d5aacab"}}
