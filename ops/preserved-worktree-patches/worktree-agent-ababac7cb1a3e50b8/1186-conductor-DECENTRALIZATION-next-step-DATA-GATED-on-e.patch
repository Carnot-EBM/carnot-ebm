        above = [x for x in centers.get(r - 1, []) if lo <= x <= hi and grid[r, x] != 0]\n            below = [x for x in centers.get(r + 1, []) if lo <= x <= hi and grid[r, x] != 0]\n\n            sides = []\n            doubled = bool(above and below)\n\n            if above and below:\n                mina, maxa = min(above), max(above)\n                minb, maxb = min(below), max(below)\n\n                if mina < minb and maxa > maxb:\n                    sides = [\"left\", \"right\"]\n                elif mina > minb and maxa < maxb:\n                    sides = []\n                elif mina < minb and maxa <= maxb:\n                    sides = [\"left\"]\n                elif mina >= minb and maxa > maxb:\n                    sides = [\"right\"]\n\n            elif above and not below:\n                sides = [\"left\"]\n                if hi == w - 1:\n                    sides.append(\"right\")\n\n            elif not above and not below:\n                if grid[r, lo] == 3:\n                    sides.append(\"left\")\n                if hi != lo and grid[r, hi] == 3:\n                    sides.append(\"right\")\n\n            for side in sides:\n                if side == \"left\":\n                    out[r, lo] = 3\n                    if doubled and lo == 0 and hi == w - 1 and lo + 1 <= hi:\n                        out[r, lo + 1] = 3\n                else:\n                    out[r, hi] = 3\n                    if doubled and lo == 0 and hi == w - 1 and hi - 1 >= lo:\n                        out[r, hi - 1] = 3\n\n    return out\n```", "source_artifact": "/home/ianblenke/github.com/ianblenke/carnot/results/arc3_gap4_arc2_induced_programs.json", "source_model": "codex", "task": "2b83f449", "verifier_certification": {"demo_fit": 1.0, "demo_perfect": true, "execution_validated": true, "pred_hash": "730966c5b005f015439a653033c3aea2677063ad"}}
