grid):\n    out = grid.copy()\n    h, w = grid.shape\n\n    centers = []\n    for r in range(h - 2):\n        for c in range(w - 2):\n            b = grid[r:r+3, c:c+3]\n            if (b[0,0] == 3 and b[0,1] == 3 and b[0,2] == 3 and\n                b[1,0] == 3 and b[1,1] == 2 and b[1,2] == 3 and\n                b[2,0] == 3 and b[2,1] == 3 and b[2,2] == 3):\n                centers.append((r + 1, c + 1))\n\n    def is_two_row(r):\n        return all(grid[r, c] in (2, 3) for c in range(w)) and any(grid[r, c] == 2 for c in range(w))\n\n    def is_two_col(c):\n        return all(grid[r, c] in (2, 3) for r in range(h)) and any(grid[r, c] == 2 for r in range(h))\n\n    two_rows = [r for r in range(h) if is_two_row(r)]\n    two_cols = [c for c in range(w) if is_two_col(c)]\n\n    def stamp_ring(cr, cc):\n        for dr in (-1, 0, 1):\n            for dc in (-1, 0, 1):\n                if dr == 0 and dc == 0:\n                    continue\n                nr, nc = cr + dr, cc + dc\n                if 0 <= nr < h and 0 <= nc < w and grid[nr, nc] != 3:\n                    out[nr, nc] = 1\n\n    for r, c in centers:\n        if r in two_rows:\n            for rr in range(h):\n                if out[rr, c] == 0:\n                    out[rr, c] = 1\n            for rr in two_rows:\n                if rr != r:\n                    stamp_ring(rr, c)\n\n        if c in two_cols:\n            for cc in range(w):\n                if out[r, cc] == 0:\n                    out[r, cc] = 1\n            for cc in two_cols:\n                if cc != c:\n                    stamp_ring(r, cc)\n\n    return out\n```", "source_artifact": "/home/ianblenke/github.com/ianblenke/carnot/results/arc3_gap4_induced_programs.json", "source_model": "codex", "task": "ac3e2b04", "verifier_certification": {"demo_fit": 1.0, "demo_perfect": true, "execution_validated": true, "pred_hash": "ada78ace0374576d7c4524cb84fce1f818d529bc"}}
