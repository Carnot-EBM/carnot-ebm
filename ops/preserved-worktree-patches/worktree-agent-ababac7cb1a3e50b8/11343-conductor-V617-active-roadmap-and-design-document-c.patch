+        "## 7. Phases and Exact Task Contract\n"
+        "| no task rows |\n"
+        "### Phase I\n"
+    )
+    with pytest.raises(ValueError, match="task table"):
+        mod.parse_markdown_contract(empty)
+    with pytest.raises(ValueError, match="structured gate"):
