+    p1_positive_control_passed: bool = True,
+    p1_blocked: bool = False,
+) -> dict[int, dict[str, object]]:
+    p1_verdict = (
+        "blocked: thesis_a_p1_v3_no_free_gpu"
+        if p1_blocked
