+    verifier_product = verifier_product_banked(exp3779)
+    anomaly = anomaly_escalation_prototyped(exp3780)
+    edlm = edlm_seed_scaffolded(exp3781)
+    fr11 = fr11_v18_self_learning(exp3778)
