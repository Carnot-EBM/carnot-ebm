+def payload_checksum(report: Mapping[str, Any]) -> str:
+    normalized = json.loads(canonical_json(report))
+    normalized["duration_s"] = 0.0
+    normalized["reproducibility_checksum"] = ""
+    return payload_sha256(normalized)
+
