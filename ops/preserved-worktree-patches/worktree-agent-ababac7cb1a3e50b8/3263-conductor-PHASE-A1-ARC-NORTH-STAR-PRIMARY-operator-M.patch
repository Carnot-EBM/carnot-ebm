+if str(PYTHON_ROOT) not in sys.path:  # pragma: no cover - direct script guard
+    sys.path.insert(0, str(PYTHON_ROOT))
+if str(REPO_ROOT) not in sys.path:  # pragma: no cover - direct script guard
