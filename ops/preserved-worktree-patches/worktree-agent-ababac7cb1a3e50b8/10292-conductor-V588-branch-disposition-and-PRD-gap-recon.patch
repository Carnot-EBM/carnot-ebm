+import numpy as np
+
+def engine(grid, action, data):
+    g = np.array(grid, dtype=int)
+    H, W = g.shape
+    if action == 4:
+        # find color-9 object
+        mask = (g == 9)
+        if mask.any():
+            rows = np.where(mask.any(axis=1))[0]
+            cols = np.where(mask.any(axis=0))[0]
+            r0, r1 = rows.min(), rows.max()
+            c0, c1 = cols.min(), cols.max()
+            block = g[r0:r1+1, c0:c1+1].copy()
+            # move right by 4
+            shift = 4
+            nc0 = c0 + shift
+            nc1 = c1 + shift
