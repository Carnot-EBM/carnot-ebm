+def _git_modified(root: Path, rel_path: Path) -> bool:  # pragma: no cover
+    result = subprocess.run(
+        ["git", "status", "--short", "--", rel_path.as_posix()],
+        cwd=root,
+        text=True,
+        capture_output=True,
+        check=False,
