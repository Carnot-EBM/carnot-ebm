+
+def hardware_continuity(payload: Mapping[str, Any] | None, *, was_skipped: bool) -> JsonDict:
+    if was_skipped:
+        return {"status": "skipped_flagged_adversarial", "kv260_reachable": False}
+    if not isinstance(payload, Mapping):
