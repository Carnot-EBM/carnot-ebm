+
+def registry_hygiene(payload: Mapping[str, Any] | None, *, was_skipped: bool) -> JsonDict:
+    if was_skipped:
+        return {"status": "skipped_flagged_adversarial", "regression_guard_passed": False}
+    if not isinstance(payload, Mapping):
