+def test_scenario_bench_6542_attack_helpers_fail_closed(tmp_path: Path) -> None:
+    """SCENARIO-BENCH-6542-ATTACKS: tampering, gaps, and inherited totals are detected."""
+
+    artifact = _artifact(tmp_path)
