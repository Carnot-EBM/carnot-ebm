+
+def build_upstream_corruption_boundary(source_root: Path) -> JsonDict:
+    readme = _read_text(source_root / "README.md")
+    return {
+        "sqlite_corruption_warning_present": "sqlite" in readme.lower()
+        and "corrupt" in readme.lower(),
