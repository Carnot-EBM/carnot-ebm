+        "license": "MIT" if "MIT" in license_text else "unknown",
+        "license_verified": "MIT" in license_text,
+        "data_schema_path": "data/problems/README.md",
+        "data_schema_verified": all(
+            token in schema_text
+            for token in (
+                "problem_id",
+                "domain",
+                "split",
+                "entities",
+                "turns",
+                "cumulative_constraints",
+                "gold_solution",
+                "is_satisfiable",
+            )
