+
+SPEC_REFS = (
+    "REQ-LEARN-5382",
+    "SCENARIO-LEARN-5382-GATE",
+    "SCENARIO-LEARN-5382-IDENTICAL-TASKS",
+    "SCENARIO-LEARN-5382-SAFETY",
+)
+
