+    assert polarfire["status"] == "blocked_polarfire_ssh_unreachable"
+    assert gatemate["status"] == "blocked_gatemate_physical_jtag_setup_unchanged"
+    assert "kv260.local" in blockers["KV260"]["stderr"]
+    assert "mpfs-disco-kit.local" in blockers["PolarFire"]["stderr"]
