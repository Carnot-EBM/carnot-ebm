+ARM_SOURCE_TO_META = {
+    "D1_LORA_EBM": ("D1", "LoRA-EBM", "MuSR"),
+    "D2_UPRM": ("D2", "uPRM", "MuSR"),
+    "D3_EBRM": ("D3", "EBRM", "MuSR"),
