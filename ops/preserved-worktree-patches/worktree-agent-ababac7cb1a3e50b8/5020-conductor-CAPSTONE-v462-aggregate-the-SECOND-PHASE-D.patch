+            "conditions_satisfied_off_arc": (
+                d5.get("diffusiongemma_gate_conditions_satisfied_off_arc") is True
+            ),
+            "activation": str(d5.get("diffusiongemma_activation") or "operator_gated"),
+            "operator_gated": True,
+            "autonomously_flipped_to_met": False,
