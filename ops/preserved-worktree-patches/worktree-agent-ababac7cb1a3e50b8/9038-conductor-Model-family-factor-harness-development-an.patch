+
+    direct_bad = mod.preconditions_checked(
+        date="20260813",
+        gate={"gate_passed": False},
+        model_resolution=missing,
+        host=_host(),
+        split={
+            "disjointness": {"disjoint": False},
+            "development_manifest": {"events": []},
+            "held_manifest": {"redacted_for_selection": False},
