+#!/usr/bin/env python3
+"""Entrypoint for Exp 3806 KV260 opportunistic terminal-state audit."""
+
+from __future__ import annotations
+
+import os
+import sys
+
+sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), "../python")))
+
+from carnot.experiment_3806_kv260_opportunistic_continuity_audit import main
+
+
+if __name__ == "__main__":  # pragma: no cover
+    main()
diff --git a/tests/python/test_experiment_3806_kv260_opportunistic_continuity_audit.py b/tests/python/test_experiment_3806_kv260_opportunistic_continuity_audit.py
