+
+def _sample_pairs() -> list[dict[str, object]]:
+    rows = json.loads((REPO / corpus5566.RESULT_RELATIVE_PATH).read_text())["corpus_rows"]
+    return mod.sample_independent_pairs(rows, n=mod.MIN_INDEPENDENT_INSTANCES)
