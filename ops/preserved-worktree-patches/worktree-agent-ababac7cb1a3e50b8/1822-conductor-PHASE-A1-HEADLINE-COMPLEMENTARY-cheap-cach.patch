+def _norm_hamming(cand: list[list[int]], pred: list[list[int]]) -> float:
+    ch, cw = _grid_shape(cand)
+    ph, pw = _grid_shape(pred)
+    c_size = max(1, ch * cw)
+    p_size = max(1, ph * pw)
+    if (ch, cw) != (ph, pw):
+        return 2.0
+    diff = 0
+    for r in range(ch):
+        for c in range(cw):
+            diff += int(cand[r][c] != pred[r][c])
+    return diff / max(1, c_size)
+
