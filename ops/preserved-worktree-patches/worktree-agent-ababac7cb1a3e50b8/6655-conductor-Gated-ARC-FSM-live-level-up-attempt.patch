+def _checksum_looks_valid(value: Any) -> bool:
+    if not isinstance(value, str) or not value.startswith("sha256:"):
+        return False
+    digest = value.removeprefix("sha256:")
+    return len(digest) == 64 and all(ch in "0123456789abcdef" for ch in digest)
+
