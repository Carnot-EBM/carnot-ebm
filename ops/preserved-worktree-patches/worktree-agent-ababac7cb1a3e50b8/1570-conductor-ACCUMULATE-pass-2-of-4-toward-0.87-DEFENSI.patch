+    """REQ-LEARN-4136: positive pass1 still honors runtime and LR gates."""
+
+    _make_ready_repo(tmp_path)
+    pass1 = _write_pass1_artifact(
+        tmp_path / "results" / "experiment_4135_sudoku_accumulate_pass1_fixed_lr.json",
+        val=0.35,
+        delta=0.072,
+    )
