+    assert artifact["per_model_runtime_matrix"]["value"]["flagship_moe"][
+        "timeout_class"
+    ] == "not_attempted_preconditions_failed"
+    assert artifact["per_model_runtime_matrix"]["value"]["flagship_dense"][
