+def _write_a1_prior(root: Path, *, passed: bool) -> None:
+    path = root / mod.A1_PRIOR_RELATIVE_PATH
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(_a1_prior_payload(passed=passed)), encoding="utf-8")
+
