+def _spec(hf_id: str, path: Path, active_params_b: float) -> dict[str, Any]:
+    return {
+        "name": hf_id.rsplit("/", 1)[-1].removesuffix("-GGUF"),
+        "hf_id": hf_id,
+        "model_path": str(path),
+        "active_params_b": active_params_b,
+    }
+
