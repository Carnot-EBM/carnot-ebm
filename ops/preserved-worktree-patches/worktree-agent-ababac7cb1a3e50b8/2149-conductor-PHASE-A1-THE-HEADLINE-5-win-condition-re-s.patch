+"""Tests for Exp 4303 ARC verifier efficiency iso-FLOPs rerun.
+
+Spec refs: REQ-VERIFY-4303, SCENARIO-VERIFY-4303.
+"""
+
+from __future__ import annotations
+
+import gzip
+import itertools
+import json
