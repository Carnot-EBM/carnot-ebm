+    bad_model = deepcopy(artifact)
+    bad_model["MODEL_SPECS"][0]["hf_id"] = "Qwen/Qwen3.5-0.8B"
+    bad_model["reproducibility_checksum"] = mod.reproducibility_checksum(bad_model)
