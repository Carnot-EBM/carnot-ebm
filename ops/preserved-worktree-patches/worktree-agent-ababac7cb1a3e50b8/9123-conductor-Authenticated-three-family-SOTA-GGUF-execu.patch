+                "process_end_monotonic_ns": ended,
+            },
+            "gpu_samples": samples,
+            "error": "%s: %s" % (type(exc).__name__, exc),
+            "legacy_model_smoke_only": False,
+            "inherited_upstream_receipt": False,
