+    load_start = time.monotonic_ns()
+    llm = Llama(
+        model_path=model_path,
+        n_ctx=int(sampling["n_ctx"]),
+        n_gpu_layers=int(sampling["n_gpu_layers"]),
+        main_gpu=0,
