+SPEC_REFS = ("REQ-VERIFY-5274", "SCENARIO-VERIFY-5274")
+INFERENCE_SUBSTRATE = "live_llm_inference_local_gguf_sota"
+TERMINAL_PREFIXES = ("complete:", "blocked_")
+GGUF_GENERATION_CONFIG = {
