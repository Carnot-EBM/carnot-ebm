+    "fixture_checksums",
+)
+
+MANDATED_MODEL_SPECS: tuple[JsonDict, ...] = (
+    {
+        "slot": "flagship_moe",
+        "hf_id": "unsloth/Qwen3.6-35B-A3B-GGUF",
+        "role": "flagship_moe",
+        "quantization": "Q4_K_M",
+        "required": True,
+    },
+    {
