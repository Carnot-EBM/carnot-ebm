+        "scoring cannot silently drift from the gated fixture."
+    ),
+    "commands_run": "Commands run to create and validate the artifact, with outcomes.",
+}
+
+REQUIRED_ARTIFACT_FIELDS = (
+    "honest_verdict",
+    "inference_substrate",
+    "preconditions_checked",
+    "MODEL_SPECS",
+    "solver_extraction_improved",
+    "validity_rate",
+    "baseline_validity",
