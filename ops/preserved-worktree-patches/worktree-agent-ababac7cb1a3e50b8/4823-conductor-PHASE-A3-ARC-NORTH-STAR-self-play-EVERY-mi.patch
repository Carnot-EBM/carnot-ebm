diff --git a/tests/python/test_experiment_4971_self_play_verifier_checkpoint.py b/tests/python/test_experiment_4971_self_play_verifier_checkpoint.py
new file mode 100644
index 0000000000..e67d3032b5
--- /dev/null
+++ b/tests/python/test_experiment_4971_self_play_verifier_checkpoint.py
@@ -0,0 +1,342 @@
+"""Tests for Exp 4971 ARC self-play verifier checkpoint refresh.
+
+Spec refs: REQ-LEARN-4971,
+SCENARIO-LEARN-4971-CHECKPOINT-REFRESHED,
+SCENARIO-LEARN-4971-SUBSTRATE-FIX,
+SCENARIO-LEARN-4971-RESIDUAL-NO-FABRICATION,
+SCENARIO-LEARN-4971-BLOCKED-PRECONDITION.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import scripts.adversarial_verify as av
+from carnot import experiment_4960_self_play_verifier_checkpoint as exp4960
+from carnot import experiment_4971_self_play_verifier_checkpoint as exp4971
+
+
+REPO = Path(__file__).resolve().parents[2]
+SPEC_PATH = REPO / "openspec" / "capabilities" / "self-learning" / "spec.md"
+
+
+def _loop_result(game: str, reached_level: int = 2, reproduced: bool = True) -> dict[str, object]:
+    return {
+        "game": game,
+        "reached_level": reached_level,
+        "offline_reproduced": reproduced,
+        "reproduced_levels": reached_level if reproduced else 0,
+        "states_expanded": 91,
+        "learned_verifier_checkpoint": f"models/arc_verifier_{game}.json",
+        "solve_provenance": "live_agent_self_discovery",
+        "reproduction_gate": {
+            "game": game,
+            "claimed_level": reached_level,
+            "reached_level": reached_level,
+            "reproduced": reproduced,
+            "mode": "offline_reproduction_gate_no_quota",
+        },
+    }
+
+
+def _preconditions(game: str = "ft09", *, ok: bool = True) -> dict[str, object]:
+    return {
+        "ok": ok,
+        "offline_arcade": {"ok": True},
+        "registry_loadable": {"ok": True, "path": "ops/arc_solve_registry.yaml"},
+        "target_banked": {"ok": True, "game": game, "prior_level": 2},
+        "checkpoint_existing": {"ok": True, "path": f"models/arc_verifier_{game}.json"},
+        "target_rotation": {
+            "ok": True,
+            "game": game,
+            "rotated_off": list(exp4971.DISALLOWED_TARGET_GAMES),
+        },
+        "target_selection": {
+            "game": game,
+            "prior_level": 2,
+            "banked": True,
+            "reason": f"rotated_banked_target_warm_start_{game}",
+        },
+    }
+
+
+def _success_artifact(tmp_path: Path, monkeypatch) -> dict[str, object]:
+    ckpt = tmp_path / "models" / "arc_verifier_ft09.json"
+    ckpt.parent.mkdir()
+    ckpt.write_text('{"ok": true}\n', encoding="utf-8")
+    before_ns = ckpt.stat().st_mtime_ns - 1
+    monkeypatch.setattr(exp4971, "REPO", tmp_path)
+
+    summary = exp4971.summarize_loop_result(
+        game="ft09",
+        loop_result=_loop_result("ft09"),
+        loop_result_path="results/arc_loop_solve_ft09.json",
+        checkpoint_mtime_before_ns=before_ns,
+    )
+    return exp4971.build_artifact(
+        target_selection={
+            "game": "ft09",
+            "prior_level": 2,
+            "banked": True,
+            "reason": "rotated_banked_target_warm_start_ft09",
+        },
+        loop_summary=summary,
+        preconditions_checked=_preconditions("ft09"),
+        duration_s=2.75,
+        flag_resolved=True,
+    )
+
+
+def test_req_learn_4971_spec_declares_required_contract() -> None:
+    """REQ-LEARN-4971: OpenSpec anchors the rotated ft09 checkpoint contract."""
+
+    spec = SPEC_PATH.read_text(encoding="utf-8")
+
+    assert exp4971._target_game(None) == "ft09"
+    assert exp4971._target_game("su15") == "su15"
+    assert exp4971._rotation_ok("ft09") is True
+    assert exp4971._rotation_ok("dc22") is False
+    for ref in exp4971.SPEC_REFS:
+        assert ref in spec
+    assert exp4971.RESULT_RELATIVE_PATH in spec
+    for field, principle in exp4971.FIELD_PRINCIPLES.items():
+        assert field in spec
+        assert principle in spec
+
+
+def test_scenario_learn_4971_checkpoint_refreshed_success(
+    tmp_path: Path, monkeypatch
+) -> None:
+    """SCENARIO-LEARN-4971-CHECKPOINT-REFRESHED: ft09 checkpoint refresh succeeds."""
+
+    artifact = _success_artifact(tmp_path, monkeypatch)
+
+    assert artifact["experiment"] == exp4971.EXPERIMENT
+    assert artifact["schema"] == exp4971.SCHEMA
+    assert artifact["spec_refs"] == exp4971.SPEC_REFS
+    assert artifact["random_seed"] == exp4971.RANDOM_SEED
+    assert artifact["field_principles"] == exp4971.FIELD_PRINCIPLES
+    assert artifact["honest_verdict"] == exp4971.SUCCESS_VERDICT
+    assert artifact["verifier_checkpoint_refreshed"] is True
+    assert artifact["checkpoint_path"] == "models/arc_verifier_ft09.json"
+    assert artifact["target_game"] == "ft09"
+    assert artifact["inference_substrate"] == exp4971.INFERENCE_SUBSTRATE
+    assert artifact["duration_s"] == 2.75
+    assert artifact["flag_resolved"] is True
+    assert artifact["solve_provenance"] == "live_agent_self_discovery"
+    assert artifact["offline_reproduced"] is True
+    assert artifact["reproduced_levels"] == 2
+    assert artifact["states_expanded"] == 91
+    assert "search_state_count" not in artifact
+    assert artifact["self_play_residual"] == "checkpoint_refreshed_gate_passed"
+    assert int(artifact["checkpoint_mtime_after_ns"]) > int(artifact["checkpoint_mtime_before_ns"])
+    assert artifact["checkpoint_mtime_delta_ns"] > 0
+    assert artifact["schema_errors"] == []
+    assert exp4971.artifact_schema_errors(artifact) == []
+
+
+def test_scenario_learn_4971_substrate_fix_avoids_duration_too_short(
+    tmp_path: Path, monkeypatch
+) -> None:
+    """SCENARIO-LEARN-4971-SUBSTRATE-FIX: offline gate uses verifier substrate."""
+
+    artifact = _success_artifact(tmp_path, monkeypatch)
+
+    floor = av.duration_floor_for_artifact(artifact)
+    flags: list[object] = []
+    av.check_duration_vs_claim(artifact, flags)
+
+    assert floor == {
+        "substrate": exp4971.INFERENCE_SUBSTRATE,
+        "min_duration_s": 1.0,
+        "reason": "verifier_scoring",
+    }
+    assert [getattr(flag, "kind", None) for flag in flags] == []
+
+    out = tmp_path / "artifact.json"
+    exp4971.write_artifact(artifact, out)
+    report = av.verify_artifact(out)
+    critical = [flag for flag in report["flags"] if flag.get("severity") == "critical"]
+    assert [flag["kind"] for flag in critical] == []
+
+
+def test_scenario_learn_4971_residual_and_blocked_paths(
+    tmp_path: Path, monkeypatch
+) -> None:
+    """SCENARIO-LEARN-4971-RESIDUAL-NO-FABRICATION: failures stay residuals."""
+
+    monkeypatch.setattr(exp4971, "REPO", tmp_path)
+    failed = _loop_result("ft09", reached_level=0, reproduced=False)
+    failed["learned_verifier_checkpoint"] = None
+
+    summary = exp4971.summarize_loop_result(
+        game="ft09",
+        loop_result=failed,
+        loop_result_path="results/arc_loop_solve_ft09.json",
+        checkpoint_mtime_before_ns=123,
+    )
+    residual = exp4971.build_artifact(
+        target_selection={
+            "game": "ft09",
+            "prior_level": 2,
+            "banked": True,
+            "reason": "rotated_banked_target_warm_start_ft09",
+        },
+        loop_summary=summary,
+        preconditions_checked={**_preconditions("ft09"), "checkpoint_existing": {"ok": False}},
+        duration_s=1.1,
+        flag_resolved=True,
+    )
+    unresolved = exp4971.build_artifact(
+        target_selection={
+            "game": "ft09",
+            "prior_level": 2,
+            "banked": True,
+            "reason": "rotated_banked_target_warm_start_ft09",
+        },
+        loop_summary={
+            **summary,
+            "offline_reproduced": True,
+            "reproduced_levels": 2,
+            "learned_verifier_checkpoint": "models/arc_verifier_ft09.json",
+            "checkpoint_mtime_before_ns": "1",
+            "checkpoint_mtime_after_ns": "2",
+            "checkpoint_mtime_delta_ns": 1,
+            "self_play_residual": "checkpoint_refreshed_gate_passed",
+        },
+        preconditions_checked=_preconditions("ft09"),
+        duration_s=1.1,
+        flag_resolved=False,
+    )
+    blocked = exp4971.build_blocked_artifact(
+        reason="checkpoint_missing",
+        preconditions_checked={
+            **_preconditions("ft09", ok=False),
+            "checkpoint_existing": {"ok": False, "path": "models/arc_verifier_ft09.json"},
+        },
+        target_game="ft09",
+        duration_s=1.0,
+        flag_resolved=True,
+    )
+    missing = exp4971.summarize_loop_result(
+        game="ft09",
+        loop_result=None,
+        loop_result_path="results/arc_loop_solve_ft09.json",
+        checkpoint_mtime_before_ns="bad",
+    )
+
+    assert residual["honest_verdict"] == "complete_ft09_self_play_residual_reproduction_gate_failed"
+    assert residual["verifier_checkpoint_refreshed"] is False
+    assert residual["checkpoint_path"] is None
+    assert residual["checkpoint_mtime_after_ns"] is None
+    assert residual["checkpoint_mtime_delta_ns"] is None
+    assert residual["flag_resolved"] is True
+    assert residual["schema_errors"] == []
+    assert unresolved["flag_resolved"] is False
+    assert unresolved["honest_verdict"] != exp4971.SUCCESS_VERDICT
+    assert "success_verdict_without_gate" not in unresolved["schema_errors"]
+    assert blocked["honest_verdict"] == "blocked_checkpoint_missing"
+    assert blocked["target_game"] == "ft09"
+    assert blocked["verifier_checkpoint_refreshed"] is False
+    assert blocked["schema_errors"] == []
+    assert missing["self_play_residual"] == "loop_result_missing"
+    assert missing["checkpoint_mtime_before_ns"] is None
+    assert missing["search_state_count"] == 0
+
+
+def test_req_learn_4971_schema_rejects_stale_metadata_and_bad_substrate(
+    tmp_path: Path, monkeypatch
+) -> None:
+    """REQ-LEARN-4971: schema rejects stale identity, targets, and substrate drift."""
+
+    artifact = _success_artifact(tmp_path, monkeypatch)
+
+    for field, old_value, expected in (
+        ("experiment", exp4960.EXPERIMENT, "experiment_mismatch"),
+        ("schema", exp4960.SCHEMA, "schema_mismatch"),
+        ("spec_refs", exp4960.SPEC_REFS, "spec_refs_mismatch"),
+        ("random_seed", exp4960.RANDOM_SEED, "random_seed_mismatch"),
+    ):
+        stale = dict(artifact)
+        stale[field] = old_value
+        stale["reproducibility_checksum"] = exp4971.stable_checksum(stale)
+        assert expected in exp4971.artifact_schema_errors(stale)
+
