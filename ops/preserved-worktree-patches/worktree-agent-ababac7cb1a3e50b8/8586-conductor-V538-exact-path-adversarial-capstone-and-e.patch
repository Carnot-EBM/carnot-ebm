+def _conductor_log() -> str:
+    lines = []
+    for task_id, _track, _deliverable in UPSTREAM_TASKS:
+        status = "GATE_BLOCK" if task_id.startswith(("exp6217", "exp622")) else "OK"
+        lines.append(
+            f"| 2026-08-09 12:00 UTC | {task_id.replace('-', ' ')[:52]} | {status} | fixture |"
+        )
+    return "\n".join(lines)
