+FIELD_PRINCIPLES = {
+    "honest_verdict": {
+        "principle": (
+            "terminal prefix; success: diversity_floor_transfer_firstwin_up_<n> OR "
+            "complete: diversity_floor_no_transfer_honest_null_gap_sharpened."
+        )
