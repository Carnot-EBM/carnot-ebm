+def test_req_report_6952_missing_core_contract_blocks(tmp_path: Path) -> None:
+    """REQ-REPORT-6952 writes a complete blocked shape for a missing contract."""
+
+    artifact = exp.build_artifact(tmp_path, "20260903")
+
