+def _source_hashes(root: Path, tasks: Sequence[Mapping[str, Any]]) -> JsonDict:
+    """Hash contracts, verifiers, registry, manifest, and every available V608 input."""
+
+    paths = {
+        DESIGN_PATH,
+        ROADMAP_PATH,
+        CONDUCTOR_LOG_PATH,
+        EXCLUSION_PATH,
