+    for status in mod.ORACLE_DISTINCT_STATUSES | mod.VERIFIER_AS_REWARD_STATUSES:
+        assert status in spec
+    for field in mod.REQUIRED_ARTIFACT_FIELDS:
+        assert field in spec
+        assert mod.FIELD_PRINCIPLES[field] in spec
