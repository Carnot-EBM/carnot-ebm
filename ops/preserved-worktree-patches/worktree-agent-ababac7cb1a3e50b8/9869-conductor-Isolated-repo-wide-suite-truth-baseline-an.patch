+def timeout_row(timeout_s: float) -> JsonDict:
+    """Keep a suite-level timeout as one explicit recheckable row."""
+
+    return {
+        "nodeid": "__suite__",
+        "outcome": "timed_out",
+        "phase": "suite",
+        "longrepr": f"repository-wide suite exceeded {timeout_s:.3f} seconds",
+    }
