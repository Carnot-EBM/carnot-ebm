+        "family_summaries": [],
+        "collection_receipt": {},
+        "suite_command_receipt": {},
+        "disposable_checkout_receipt": {},
+        "mutation_rows": [],
+        "active_worktree_unchanged": {"unchanged": None},
+        "suite_truth_baseline": {
