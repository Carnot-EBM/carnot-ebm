+def test_req_arc_wmte_4805_defensive_edges(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """REQ-ARC-WMTE-4805: malformed null evidence is not trusted."""
