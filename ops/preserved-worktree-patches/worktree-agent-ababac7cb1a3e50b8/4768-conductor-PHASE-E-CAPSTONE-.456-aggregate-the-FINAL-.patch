+def _reserved_lanes(clean: Mapping[str, Mapping[str, Any]], b3_window: Mapping[str, Any]) -> JsonDict:
+    c = clean.get("C_KV260")
+    c_ok = bool(c and c.get("kv260_ssh_reachable") is True)
