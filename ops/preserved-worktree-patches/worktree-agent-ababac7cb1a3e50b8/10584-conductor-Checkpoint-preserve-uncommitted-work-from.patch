-- id: exp6836-typed-obligation-program-fixture
-  title: Typed obligation program and matched candidate fixture
-  track: verification
-  priority: critical
-  agent_type: codex
-  model: gpt-5.5
-  requires_gpu: false
-  max_turns: 50
-  estimated_wall_time_min: 180
-  per_unit_rows: true
