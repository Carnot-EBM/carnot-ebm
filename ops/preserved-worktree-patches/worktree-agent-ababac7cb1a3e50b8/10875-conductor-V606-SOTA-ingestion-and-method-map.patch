+def query_rows() -> list[JsonDict]:
+    """Join the frozen query plan to the retained terminal receipts."""
+
+    rows = []
+    for planned in frozen_query_plan():
+        row = deepcopy(planned)
+        row.update(_QUERY_RESULTS[planned["query_id"]])
+        row["terminal"] = True
+        rows.append(row)
+    return rows
