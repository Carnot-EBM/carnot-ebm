+ANSWER_RE = re.compile(r"(?im)^\s*ANSWER\s*:\s*(?P<answer>.+?)\s*$")
+OFFLOAD_RE = re.compile(r"offloaded\s+(?P<offloaded>\d+)\s*/\s*(?P<total>\d+)\s+layers", re.I)
+QUANT_RE = re.compile(
+    r"(UD-)?(?:Q\d(?:_K_[A-Z]+|_[0-9A-Z]+)?|IQ\d_[A-Z]+|BF16|F16)",
+    re.I,
+)
