+    if _ready_score(artifact) == 1.0:
+        return (
+            "complete_ready",
+            "complete_ready: coordinate_router_progress_qualified_for_next_gate_no_level_claim",
+        )
+    return (  # pragma: no cover - tested through positive/underpowered gates
