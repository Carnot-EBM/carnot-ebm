+            "spec": SPEC_RELATIVE_PATH.as_posix(),
+            "module": MODULE_RELATIVE_PATH.as_posix(),
+            "test": TEST_RELATIVE_PATH.as_posix(),
+            "source_hashes": source_hashes,
+            "spec_refs": ["REQ-BENCH-6519"],
+        }
+        for field in REQUIRED_ARTIFACT_FIELDS
+    }
