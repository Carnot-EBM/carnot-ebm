+    first["details"]["changed"] = True
+    assert "event_checksum_mismatch" in lease_api._history_errors([first])
+
+    malformed = deepcopy(base)
+    malformed.update(
+        {
+            "schema": "wrong",
+            "phase": "wrong",
+            "owner": {"pid": 0, "pid_start_ticks": -1, "token_digest": "wrong"},
+            "heartbeat_monotonic_ns": "wrong",
+        }
