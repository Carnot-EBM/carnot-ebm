+def test_scenario_infra_6633_rejects_malformed_journal_variants(tmp_path: Path) -> None:
+    """SCENARIO-INFRA-6633-FAIL-CLOSED covers every structural evidence check."""
+
+    lease = _acquire(tmp_path / "base")
