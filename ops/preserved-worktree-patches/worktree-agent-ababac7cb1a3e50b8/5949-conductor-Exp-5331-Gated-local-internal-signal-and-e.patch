+OPTION_TERMS_RE = re.compile(
+    r"logprob|logit|probab|token|timing|perf|attention|hidden|embedding|slots|props|"
+    r"metrics|completion",
+    re.IGNORECASE,
+)
+TOKEN_PROBABILITY_PATTERNS = (
