+def _research_complete_block_count(root: Path) -> int:
+    path = root / RESEARCH_COMPLETE_RELATIVE_PATH
+    if not path.exists():
+        return 0
+    text = path.read_text(encoding="utf-8", errors="replace")
+    return len(re.findall(r"(?m)^-\s+id:\s+2026\.07\.513\s*$", text))
+
