+def _check_resource(
+    repo_root: Path,
+    resource: str,
+    path: str,
+    loader: Callable[[Path], Any],
+) -> dict[str, Any]:
+    full_path = repo_root / path
+    try:
+        loader(full_path)
+    except Exception as exc:
+        return {
+            "resource": resource,
+            "path": path,
+            "available": False,
+            "error": f"{type(exc).__name__}: {exc}",
+        }
+    return {"resource": resource, "path": path, "available": True, "error": ""}
