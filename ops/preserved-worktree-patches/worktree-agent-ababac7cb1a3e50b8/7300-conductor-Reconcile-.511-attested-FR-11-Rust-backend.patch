+def _path_is_problematic(artifact: Mapping[str, Any], rel_path: Path) -> bool:
+    path = rel_path.as_posix()
+    return path in set(artifact.get("missing_artifacts", [])) or path in set(
+        artifact.get("malformed_artifacts", [])
+    )
