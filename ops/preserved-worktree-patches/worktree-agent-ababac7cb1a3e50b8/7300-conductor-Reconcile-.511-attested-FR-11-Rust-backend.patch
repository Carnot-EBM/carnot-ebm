+        checks["offline_arcade_makes_env"] = False
+        try:
+            env = arc.make(DEFAULT_ROSTER[0], scorecard_id=arc.open_scorecard())
+            env.reset()
+            checks["offline_arcade_makes_env"] = True
+        except Exception:
