+    audit_games: int = 18,
+) -> dict[str, JsonDict]:
+    return {
+        "4421_config_rule": {
+            "experiment": "experiment_4421_config_rule_solve_unseen",
+            "honest_verdict": "success_s5i5_L1_offline_reproduced",
