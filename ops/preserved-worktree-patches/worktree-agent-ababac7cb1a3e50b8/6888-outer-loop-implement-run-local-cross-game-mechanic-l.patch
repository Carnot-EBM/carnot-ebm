+
+    # Flag OFF (default): no ledger interaction at all.
+    monkeypatch.delenv("CARNOT_ARC_RUN_LOCAL_ADAPTATION", raising=False)
+    policy_off = E3AgentPolicy("offtest", proposer=None, value_head=lambda _f: 0.0)
