+
+    def parity_check(_root: Path) -> JsonDict:
+        calls.append("parity")
+        return _parity(True)
+
+    def proxy_runner(_root: Path, parity_test: JsonDict) -> JsonDict:
+        calls.append("proxy")
+        assert parity_test["passed"] is True
+        return _proxy(first_win_rate=0.04, ci_lower=0.0, attempts=100)
+
+    artifact = mod.run(
+        root=tmp_path,
