+def default_reproduce_plan(solution: Sequence[str], claimed_level: int) -> dict[str, Any]:  # pragma: no cover
+    return dict(
+        kit.reproduce(
+            TARGET_GAME,
+            [str(label) for label in solution],
+            apply_sc25_label,
+            warmup_label="warmup",
+            claimed_level=int(claimed_level),
+        )
+    )
