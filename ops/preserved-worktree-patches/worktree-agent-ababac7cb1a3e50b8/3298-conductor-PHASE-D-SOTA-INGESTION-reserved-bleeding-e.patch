+        _require(row.get(key) is False, f"preconditions_checked must record no {label}")
+
+    _require(
+        row.get("sweep_clusters_urls") == SWEEP_CLUSTER_URLS,
+        "preconditions_checked must record the focused cluster 0/6 URLs",
+    )
+    _require(
