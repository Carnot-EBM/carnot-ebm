From 9f5fd622b5dfb07298fb48ce2e9baa7af344ef45 Mon Sep 17 00:00:00 2001
From: Ian Blenke <ian@blenke.com>
Date: Fri, 19 Jun 2026 14:38:39 -0400
Subject: [PATCH 02847/11362] [outer-loop] Kaggle build v7: fix the .so-collect
 glob (v6 compiled+linked OK; my collect crashed)

v6 proved the libcuda fix works: it found the real libcuda.so (/usr/local/cuda-12.8/compat/) and the
binary COMPILED + LINKED. It then crashed in MY collect step -- the build/**/*.so* glob matched a
node_modules DIRECTORY (lodash.sortby, a web-UI dep) and copy2'd a dir -> IsADirectoryError. Fix: skip
non-files + anything under node_modules (and make the llama-server glob is_file-robust). The build
itself is green; this is the last trivial bug before the binary lands.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 scripts/kaggle/kernel/main.py | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/scripts/kaggle/kernel/main.py b/scripts/kaggle/kernel/main.py
index b0d631e95d..522226d315 100644
--- a/scripts/kaggle/kernel/main.py
+++ b/scripts/kaggle/kernel/main.py
@@ -87,10 +87,14 @@ def main():
         # -j2 (not nproc): nvcc is memory-heavy; fewer parallel jobs avoids an OOM-kill on the builder.
         sh(f"cmake --build {SRC}/build --target llama-server -j 2")
         stage("built")
-        server = next(SRC.glob("build/**/llama-server"))
+        server = next(p for p in SRC.glob("build/**/llama-server") if p.is_file())
         shutil.copy2(server, OUT / "llama-server")
         n = 0
         for so in SRC.glob("build/**/*.so*"):
+            # the *.so* glob also matches dirs like node_modules/lodash.sortby (web-UI deps) -- skip
+            # non-files and anything under node_modules (v6 crashed here with IsADirectoryError).
+            if not so.is_file() or "node_modules" in so.parts:
+                continue
             shutil.copy2(so, OUT / so.name)
             n += 1
         # MTP self-verify: the symbol common_speculative_impl_draft_mtp MUST be present
-- 
