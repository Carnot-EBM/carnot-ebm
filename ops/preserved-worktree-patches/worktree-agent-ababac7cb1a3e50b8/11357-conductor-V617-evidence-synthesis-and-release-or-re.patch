+    (root / mod.DESIGN_PATH).write_text(_design(roadmap))
+    (root / mod.EXCLUSION_PATH).write_text("retired: []\nretired_experiments: []\nretired_extras: []\n")
+    (root / mod.SPEC_PATH).write_text("REQ-CAP-7049\n")
