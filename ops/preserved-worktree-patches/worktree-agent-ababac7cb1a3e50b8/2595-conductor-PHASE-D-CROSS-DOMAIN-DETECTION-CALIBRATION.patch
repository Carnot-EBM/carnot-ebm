+                "base_rate": result["base_rate"],
+                "selection_headroom": result["selection_headroom"],
+                "claim_scope": result.get("claim_scope"),
+            }
+            for result in domain_results
+        },
+        "pools_built": [dict(pool) for pool in pools_built],
