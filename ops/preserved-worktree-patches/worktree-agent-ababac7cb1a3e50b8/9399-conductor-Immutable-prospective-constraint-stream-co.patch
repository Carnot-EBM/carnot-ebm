+def headroom_manifest(units: Sequence[ProspectiveUnit]) -> JsonDict:
+    rows = []
+    for unit in units:
+        headroom = candidate_headroom(unit.record)
+        rows.append(
+            {
+                "row_type": "headroom",
+                "unit_id": unit.unit_id,
