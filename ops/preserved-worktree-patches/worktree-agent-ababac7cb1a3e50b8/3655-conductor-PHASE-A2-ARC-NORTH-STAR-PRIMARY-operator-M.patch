index 5a5ee5f292..cc913ecd00 100644
--- a/python/carnot/agentic/arc_frame_change_predictor.py
+++ b/python/carnot/agentic/arc_frame_change_predictor.py
@@ -760,6 +760,70 @@ def _scorer_value(frame: Any, candidate: Any, scorer: Any) -> float:
