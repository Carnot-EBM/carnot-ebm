+        ),
+        (
+            _valid_artifact()
+            | {"methods_mapped": [_valid_methods()[0] | {"failure_mode": ""}] + _valid_methods()[1:]},
+            "non-empty string",
+        ),
+        (_valid_artifact() | {"flagged_for_v384": ""}, "flagged_for_v384"),
+    ],
