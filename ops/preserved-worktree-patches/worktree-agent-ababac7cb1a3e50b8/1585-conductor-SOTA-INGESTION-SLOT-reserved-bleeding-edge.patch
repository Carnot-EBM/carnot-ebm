+)
+ARTIFACT_PATH = Path(
+    "results/experiment_4141_sota_ingestion_recursive_reasoner_verifier.json"
+)
+STUDYING_PATH = Path("research-studying.md")
+
+
+def _valid_methods() -> list[dict[str, str]]:
+    return [
+        {
+            "name": "GRAM stochastic-latent generator",
