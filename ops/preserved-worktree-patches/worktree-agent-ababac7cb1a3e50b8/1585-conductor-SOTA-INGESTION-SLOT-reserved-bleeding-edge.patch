+    bad_artifact: dict[str, object], message: str
+) -> None:
+    """SCENARIO-REPORT-4141: invalid mapping artifacts fail closed."""
+
+    with pytest.raises(ValueError, match=message):
+        mod.validate_artifact(bad_artifact)
