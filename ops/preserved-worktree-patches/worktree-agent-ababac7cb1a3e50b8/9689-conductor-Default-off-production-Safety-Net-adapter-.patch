+def enabled_decision_rows(rows: Sequence[Mapping[str, Any]]) -> list[JsonDict]:
+    return [
+        dict(row)
+        for row in rows
+        if row.get("condition")
+        in {"enabled_router", "forced_abstain", "forced_fallback", "malformed_input"}
