+def _upstream_and_freeze_hashes(
+    result_path: Path, exp6147_artifact: Mapping[str, Any], selection: Mapping[str, Any]
+) -> JsonDict:
+    sidecars = {
+        hf_id: {
+            **_file_receipt(_model_sidecar_path(hf_id)),
+            "row_count": len(load_jsonl(_model_sidecar_path(hf_id))),
