+def _expect_value_error(name: str, action: Callable[[], Any]) -> JsonDict:
+    try:
+        action()
+    except ValueError as exc:
+        return {"attack": name, "fail_closed": True, "reason": str(exc)}
+    return {"attack": name, "fail_closed": False, "reason": "attack was accepted"}
