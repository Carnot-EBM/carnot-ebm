+        "exists": (root / REGISTRY_RELATIVE_PATH).is_file(),
+        "sha256": sha256_file(root / REGISTRY_RELATIVE_PATH),
+        "registry_game_count": len(registry_levels),
+        "held_game_count": len(held_games),
+        "held_games": rows,
