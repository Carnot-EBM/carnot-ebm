+def _floor_duration(
+    *,
+    started_at: float,
+    now: Callable[[], float],
+    sleep_fn: Callable[[float], None],
+) -> float:
+    elapsed = max(0.0, float(now() - started_at))
+    if elapsed < 1.0:
+        sleep_fn(1.0 - elapsed)
+    return max(float(now()), started_at + 1.0) - started_at
