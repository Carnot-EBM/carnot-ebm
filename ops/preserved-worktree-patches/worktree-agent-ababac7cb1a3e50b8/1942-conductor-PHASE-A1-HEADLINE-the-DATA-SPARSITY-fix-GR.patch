+    with gzip.open(optional_schema_pool, "wt", encoding="utf-8") as handle:
+        json.dump({"entries": {"not": "a-list"}}, handle)
+    optional_schema_programs.write_text(json.dumps({"programs": []}), encoding="utf-8")
+
+    specs = (
