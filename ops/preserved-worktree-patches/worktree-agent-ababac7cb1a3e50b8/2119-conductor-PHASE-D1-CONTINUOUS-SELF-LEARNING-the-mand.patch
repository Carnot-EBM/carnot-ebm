+def _merge_corpora(
+    original: exp4271.FamilyAnnotatedCorpus,
+    arcgen: exp4271.FamilyAnnotatedCorpus | None,
+) -> exp4271.FamilyAnnotatedCorpus:  # pragma: no cover - live artifact loading.
+    rows = list(original.rows)
