+        "honest_verdict": f"blocked_{reason}",
+        "inference_substrate": INFERENCE_SUBSTRATE,
+        "preconditions_checked": dict(preconditions_checked),
+        "transition": _transition(preconditions_checked, complete=False),
+        "close_state_428": {},
