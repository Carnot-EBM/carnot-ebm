+    """SCENARIO-HW-5079: run_experiment writes the requested result artifact."""
+
+    root = _fixture_root(tmp_path)
+    out_path = mod.run_experiment(
+        repo_root=root,
+        command_runner=_all_reachable_runner(),
+        clock=FlatClock(),
