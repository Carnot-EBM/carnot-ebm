+        "blocked_kv260_prior_transcript_unverified_no_speedup_claim"
+    )
+    assert artifact["kv260_prior_summary"]["verified"] is False
+    assert artifact["kv260_prior_summary"]["errors"]
+    mod.validate_artifact(artifact)
+
+
