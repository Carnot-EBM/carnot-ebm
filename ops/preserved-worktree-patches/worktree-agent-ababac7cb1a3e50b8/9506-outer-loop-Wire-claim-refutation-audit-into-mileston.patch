From 5ba0e8f9dc53c2164934933cc70f2c923c676fd3 Mon Sep 17 00:00:00 2001
From: Ian Blenke <ian@blenke.com>
Date: Sat, 22 Aug 2026 12:35:04 -0400
Subject: [PATCH 09506/11362] [outer-loop] Wire claim-refutation audit into
 milestone close

Add the experiment-claim-audit block to research_step's milestone-close
path, after the artifact-convention audit. Same receipt contract as the
siblings: the caller verifies ops/experiment_claim_audit_report.md was
rewritten, never the exit code. --budget-seconds 750 sits inside the
900s kill timeout so budget exhaustion writes a PARTIAL receipt instead
of dying silently (REQ-OPS-CLAIM-REFUTATION-6650, REQ-CONDUCTOR-RECEIPT-1).

Takes effect on the conductor's next natural restart; the loop process
is long-lived and not re-exec'd per iteration.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JntPrUGLNesPcJH1pyfFYw
---
 scripts/research_conductor.py | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/scripts/research_conductor.py b/scripts/research_conductor.py
index 323e218cb9..c6ff48a326 100644
--- a/scripts/research_conductor.py
+++ b/scripts/research_conductor.py
@@ -5317,6 +5317,36 @@ def research_step(
                     timeout=900,
                 )
 
+            # Claim-refutation audit (2026-08-22, REQ-OPS-CLAIM-REFUTATION-6650). The
+            # convention audit above asks whether a claim is CHECKABLE; this one asks
+            # whether it is SUPPORTED: what would refute the headline, and was that
+            # checked? Built after four misses that passed every mechanical check --
+            # the exp6478 tautology-by-construction, an in-sample metric cited as
+            # generalization, a wrong-key read turned into a zero claim, and invalid
+            # rows averaged into a headline. Question-shaped prompt, not a pattern
+            # list; delegates degeneracy detection to adversarial_verify's own
+            # checks. --budget-seconds is INSIDE the kill timeout on purpose so the
+            # audit writes a PARTIAL receipt instead of dying silently. Never edits,
+            # never blocks; the operator decides.
+            if not dry_run:
+                _run_audit_with_receipt(
+                    "experiment-claim-audit",
+                    [
+                        sys.executable,
+                        str(PROJECT_ROOT / "scripts" / "experiment_claim_audit.py"),
+                        "--recent",
+                        "8",
+                        "--budget-seconds",
+                        "750",
+                        "--agent-type",
+                        AGENT_TYPE_AUDIT,
+                        "--model-name",
+                        AGENT_MODEL_AUDIT,
+                    ],
+                    receipt=PROJECT_ROOT / "ops" / "experiment_claim_audit_report.md",
+                    timeout=900,
+                )
+
             # Contradiction escalation (REQ-OPS-CONTRADICTION-6272). Cheap detectors for rows
             # that disagree with THEMSELVES, escalating to an adversarial reviewer when they fire.
             #
