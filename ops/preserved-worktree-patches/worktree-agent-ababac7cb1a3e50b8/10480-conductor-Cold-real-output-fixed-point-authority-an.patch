+def test_req_verify_6801_verdict_branches_are_fail_closed(
+    sources: dict, audited_rows: list[dict], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """REQ-VERIFY-6801 maps cold gates to null, positive, partial, or rejection."""
