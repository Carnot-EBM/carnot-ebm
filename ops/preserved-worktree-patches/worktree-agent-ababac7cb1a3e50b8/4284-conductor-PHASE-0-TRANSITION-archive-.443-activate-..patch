+    "field_principles",
+    "leaderboard_submission",
+    "duration_s",
+    "random_seed",
+    "reproducibility_checksum",
+)
+TERMINAL_PREFIXES = (
+    "complete:",
+    "complete_",
+    "success:",
+    "success_",
+    "passed:",
+    "passed_",
+    "shipped:",
+    "shipped_",
+)
+
