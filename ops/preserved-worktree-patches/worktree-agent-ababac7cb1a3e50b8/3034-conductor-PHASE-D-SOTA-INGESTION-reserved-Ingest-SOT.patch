+    assert NOTE_PATH.as_posix() in spec
+    assert "14,672" in spec
+    assert "5x priority" in spec
+    assert "GAP-ARCH-FRAME-CHANGE-PREDICTOR" in spec
+    assert "GAP-ARCH-VALUE-ENERGY-HEADS" in spec
