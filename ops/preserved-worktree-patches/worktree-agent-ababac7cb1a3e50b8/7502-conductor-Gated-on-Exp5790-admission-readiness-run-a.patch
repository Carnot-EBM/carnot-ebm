+def _predictions(rows: list[dict[str, Any]], wrong: set[str] | None = None) -> dict[str, str]:
+    wrong = wrong or set()
+    return {
+        row["row_id"]: (_sha(f"wrong-{row['row_id']}") if row["row_id"] in wrong else row["successor_hash"])
+        for row in rows
+    }
+
