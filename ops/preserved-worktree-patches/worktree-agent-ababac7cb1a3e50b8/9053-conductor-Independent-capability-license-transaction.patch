+        ).get("attacks")
+    )
+    exp6396_attacks = as_mapping(
+        as_mapping(
+            as_mapping(payloads.get("exp6396")).get(
+                "identity_license_order_placebo_work_stopping_and_leakage_attack_matrix"
+            )
+        ).get("attacks")
+    )
+    exp6398_results = as_mapping(
+        as_mapping(payloads.get("exp6398")).get(
