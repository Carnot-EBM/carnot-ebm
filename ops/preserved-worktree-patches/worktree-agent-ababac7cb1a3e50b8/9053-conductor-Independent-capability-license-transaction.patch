+def path_receipt(path: str | Path) -> JsonDict:
+    """Record path, presence, size, and hash."""
+
+    path = Path(path)
+    return {
+        "path": relative_or_absolute(path),
+        "present": path.is_file(),
+        "sha256": sha256_file(path),
+        "size_bytes": path.stat().st_size if path.is_file() else 0,
+    }
