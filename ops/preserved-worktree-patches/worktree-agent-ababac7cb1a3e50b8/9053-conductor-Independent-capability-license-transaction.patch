+            )
+        ).get("attacks")
+    )
+    fallback_count = sum(
+        int(row.get("fallback_model_hf_id") is not None)
+        for row in [*unlicensed, *[as_mapping(row) for row in exp6398_attacks.values()]]
+    )
+    inherited_count = sum(
+        int(as_mapping(row).get("inherited_license") is True)
+        for row in exp6398_attacks.values()
