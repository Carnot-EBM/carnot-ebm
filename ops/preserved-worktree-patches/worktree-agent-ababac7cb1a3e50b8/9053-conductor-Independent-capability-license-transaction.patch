+            "licenses are model-family scoped",
+        ),
+        "inherited_license": _attack_row(
+            "inherited_license",
+            inherited_count == 0,
+            "failed cells cannot inherit another license",
+        ),
+        "silent_fallback": _attack_row(
+            "silent_fallback",
+            fallback_count == 0,
