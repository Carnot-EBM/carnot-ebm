+    ap.add_argument("--gpu", type=int, default=1)
+    ap.add_argument("--k", type=int, default=6)
+    ap.add_argument("--n-ctx", type=int, default=81920)
+    ap.add_argument("--max-tokens", type=int, default=4096)
