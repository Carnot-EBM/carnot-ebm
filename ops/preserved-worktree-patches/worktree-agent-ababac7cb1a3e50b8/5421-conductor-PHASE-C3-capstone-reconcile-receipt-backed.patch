+def _make_repo(root: Path, *, omit: set[int] | None = None) -> None:
+    omit = omit or set()
+    payloads = _payloads()
+    for source in mod.UPSTREAM_SOURCES:
+        if source.experiment_number not in omit:
+            _write_json(root / source.relative_path, payloads[source.experiment_number])
