From 89dc0059e57c4697c241c2d12da8535ec493b35e Mon Sep 17 00:00:00 2001
From: Ian Blenke <ian@blenke.com>
Date: Thu, 18 Jun 2026 23:04:49 -0400
Subject: [PATCH 02701/11362] [outer-loop] Fix Kaggle CUDA build: point CMake
 at the driver stub (CUDA::cuda_driver not found) + EXAMPLES/TESTS off

v2 build kernel failed at cmake GENERATE: 'Target ggml-cuda links to CUDA::cuda_driver but the target was
not found' -- the classic Kaggle/Colab quirk where FindCUDAToolkit cannot locate the driver stub
libcuda.so. Fix: -DCMAKE_LIBRARY_PATH=/usr/local/cuda/lib64/stubs + -DCUDA_cuda_driver_LIBRARY=<stub>, and
-DLLAMA_BUILD_EXAMPLES=OFF -DLLAMA_BUILD_TESTS=OFF (smaller configure, skips diffusion-example targets;
llama-server is in tools/, still built). Re-pushed as v3.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 scripts/kaggle/build_verify_llamacpp_mtp.py | 9 ++++++++-
 scripts/kaggle/kernel/main.py               | 9 ++++++++-
 2 files changed, 16 insertions(+), 2 deletions(-)

diff --git a/scripts/kaggle/build_verify_llamacpp_mtp.py b/scripts/kaggle/build_verify_llamacpp_mtp.py
index 5081758835..7a07d50c0c 100644
--- a/scripts/kaggle/build_verify_llamacpp_mtp.py
+++ b/scripts/kaggle/build_verify_llamacpp_mtp.py
@@ -49,9 +49,16 @@ def build():
         sh(f"cd {SRC} && git fetch origin pull/{PR}/head && git checkout FETCH_HEAD")
     # CUDA toolkit (nvcc) + cmake are present on Kaggle GPU images; install cmake if missing.
     sh("cmake --version || pip install -q cmake", check=False)
+    # Kaggle/Colab CUDA quirk: FindCUDAToolkit cannot locate the driver stub libcuda.so, so the
+    # CUDA::cuda_driver IMPORTED target is missing and ggml-cuda fails at GENERATE. Point CMAKE_LIBRARY_PATH
+    # at the stubs dir (auto-detect the cuda root). EXAMPLES/TESTS OFF: smaller configure + skips the
+    # diffusion-example targets we do not need (llama-server lives in tools/, still built).
+    stubs = "/usr/local/cuda/lib64/stubs"
     sh(
         f"cmake -S {SRC} -B {SRC}/build -DGGML_CUDA=ON "
-        f'-DCMAKE_CUDA_ARCHITECTURES="{CUDA_ARCHS}" -DLLAMA_CURL=OFF -DCMAKE_BUILD_TYPE=Release'
+        f'-DCMAKE_CUDA_ARCHITECTURES="{CUDA_ARCHS}" -DLLAMA_CURL=OFF -DCMAKE_BUILD_TYPE=Release '
+        f"-DLLAMA_BUILD_EXAMPLES=OFF -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_SERVER=ON "
+        f'-DCMAKE_LIBRARY_PATH="{stubs}" -DCUDA_cuda_driver_LIBRARY="{stubs}/libcuda.so"'
     )
     sh(f"cmake --build {SRC}/build --target llama-server -j $(nproc)")
     # collect the binary + EVERY shared lib it needs (incl. libllama-common, where MTP lives)
diff --git a/scripts/kaggle/kernel/main.py b/scripts/kaggle/kernel/main.py
index aa975238e9..e4d856ef8f 100644
--- a/scripts/kaggle/kernel/main.py
+++ b/scripts/kaggle/kernel/main.py
@@ -51,9 +51,16 @@ def build():
         sh(f"cd {SRC} && git fetch origin pull/{PR}/head && git checkout FETCH_HEAD")
     # CUDA toolkit (nvcc) + cmake are present on Kaggle GPU images; install cmake if missing.
     sh("cmake --version || pip install -q cmake", check=False)
+    # Kaggle/Colab CUDA quirk: FindCUDAToolkit cannot locate the driver stub libcuda.so, so the
+    # CUDA::cuda_driver IMPORTED target is missing and ggml-cuda fails at GENERATE. Point CMAKE_LIBRARY_PATH
+    # at the stubs dir (auto-detect the cuda root). EXAMPLES/TESTS OFF: smaller configure + skips the
+    # diffusion-example targets we do not need (llama-server lives in tools/, still built).
+    stubs = "/usr/local/cuda/lib64/stubs"
     sh(
         f"cmake -S {SRC} -B {SRC}/build -DGGML_CUDA=ON "
-        f'-DCMAKE_CUDA_ARCHITECTURES="{CUDA_ARCHS}" -DLLAMA_CURL=OFF -DCMAKE_BUILD_TYPE=Release'
+        f'-DCMAKE_CUDA_ARCHITECTURES="{CUDA_ARCHS}" -DLLAMA_CURL=OFF -DCMAKE_BUILD_TYPE=Release '
+        f"-DLLAMA_BUILD_EXAMPLES=OFF -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_SERVER=ON "
+        f'-DCMAKE_LIBRARY_PATH="{stubs}" -DCUDA_cuda_driver_LIBRARY="{stubs}/libcuda.so"'
     )
     sh(f"cmake --build {SRC}/build --target llama-server -j $(nproc)")
     # collect the binary + EVERY shared lib it needs (incl. libllama-common, where MTP lives)
