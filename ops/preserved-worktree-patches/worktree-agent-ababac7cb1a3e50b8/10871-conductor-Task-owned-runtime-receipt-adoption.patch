+def _adoption_row_hash_valid(row: Mapping[str, Any]) -> bool:
+    """Return true when a row still matches the digest made by its task."""
+
+    payload = dict(row)
+    stored = payload.pop("receipt_hash", None)
+    return stored == sha256_json(payload)
