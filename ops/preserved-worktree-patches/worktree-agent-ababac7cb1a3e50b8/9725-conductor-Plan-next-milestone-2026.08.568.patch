+def test_attempt_archive_delta_missing_manifest_is_zero(tmp_path):
+    hs = _harness()
+    man = tmp_path / "absent" / "manifest.jsonl"
+    assert hs._manifest_line_count(man) == 0
+    assert hs._attempt_archive_delta(man, 0) == {"before": 0, "added": 0, "sha256_16": []}
