+def _harness() -> ModuleType:
+    spec = importlib.util.spec_from_file_location("lever_harness_under_test", _HARNESS)
+    mod = importlib.util.module_from_spec(spec)
+    assert spec.loader is not None
+    spec.loader.exec_module(mod)
+    return mod
