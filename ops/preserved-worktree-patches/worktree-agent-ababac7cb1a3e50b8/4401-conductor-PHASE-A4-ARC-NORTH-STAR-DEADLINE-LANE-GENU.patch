+
+    prior = tmp_path / "results" / "experiment_4844_heldout_first_win_readiness.json"
+    prior.parent.mkdir(parents=True)
+    prior.write_text(
+        json.dumps({"experiment_id": 4844, "heldout_first_win_rate": 0.08}),
+        encoding="utf-8",
+    )
+    loaded = mod.load_prior_best(tmp_path)
