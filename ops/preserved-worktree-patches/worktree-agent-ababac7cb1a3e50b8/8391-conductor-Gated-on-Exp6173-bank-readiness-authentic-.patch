+def honest_verdict(
+    status: str,
+    coverage: Mapping[str, Any],
+    model_spec: Mapping[str, Any],
+    gate: Mapping[str, Any],
+) -> str:
+    model = str(model_spec.get("hf_id", MANDATORY_MODEL_ID))
