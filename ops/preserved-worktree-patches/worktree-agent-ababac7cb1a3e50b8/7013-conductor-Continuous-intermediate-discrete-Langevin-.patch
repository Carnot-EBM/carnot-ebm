+DEFAULT_SAMPLES_PER_PAIR = 10_000
+DEFAULT_WARMUP_STEPS = exp5573.DEFAULT_WARMUP_STEPS
+DEFAULT_THINNING = exp5573.DEFAULT_THINNING
+DEFAULT_TEMPERATURE = exp5573.DEFAULT_TEMPERATURE
