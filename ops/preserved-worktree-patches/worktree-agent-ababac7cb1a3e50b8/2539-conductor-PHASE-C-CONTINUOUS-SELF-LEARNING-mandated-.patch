+    if (x - CAST_ORIGIN_X) % CAST_STEP or (y - CAST_ORIGIN_Y) % CAST_STEP:
+        return out
+    col = (x - CAST_ORIGIN_X) // CAST_STEP
+    row = (y - CAST_ORIGIN_Y) // CAST_STEP
+    if row not in range(3) or col not in range(3):
