+def _artifacts(*, s1: JsonDict | None = None) -> dict[str, JsonDict]:
+    return {
+        "S1": s1 or _s1(),
+        "LEVELUP": _levelup(),
+        "SELF_PLAY": _self_play(),
+        "HELDOUT": _heldout(),
+        "BUG_AUDIT": _audit(),
+        "PACKAGE": _package(),
+        "HARDWARE": _hardware(),
+        "SOTA": _sota(),
+    }
