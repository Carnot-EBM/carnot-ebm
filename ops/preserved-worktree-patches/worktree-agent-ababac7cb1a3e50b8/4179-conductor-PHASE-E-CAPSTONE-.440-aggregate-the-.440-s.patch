+    silent_bugs = silent_bugs if isinstance(silent_bugs, list) else []
+    reopened_ids = [
+        row.get("null_id")
+        for row in silent_bugs
+        if isinstance(row, Mapping) and row.get("verdict") == "silent_bug_must_reopen"
