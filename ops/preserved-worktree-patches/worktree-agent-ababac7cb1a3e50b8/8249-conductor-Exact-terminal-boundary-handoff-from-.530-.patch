+def _build(root: Path, rows: list[JsonDict] | None = None) -> JsonDict:
+    return mod.build_report(
+        root,
+        adversarial_receipts=_receipts(),
+        tests_run=_test_receipts() if rows is None else rows,
+        duration_s=1.5,
+    )
