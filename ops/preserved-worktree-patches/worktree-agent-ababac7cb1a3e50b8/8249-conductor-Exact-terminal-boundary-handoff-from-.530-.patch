+def _conductor_receipts(root: Path) -> JsonDict:
+    path = root / CONDUCTOR_LOG_RELATIVE_PATH
+    text = path.read_text(encoding="utf-8", errors="replace") if path.exists() else ""
+    lines = text.splitlines()
+    by_task: dict[str, JsonDict] = {}
+    for task_id, marker in CONDUCTOR_MATCH_MARKERS.items():
+        matches = [line for line in lines if marker in line or task_id in line]
+        latest = matches[-1] if matches else ""
+        by_task[task_id] = {
+            "attempt_count": len(matches),
+            "latest_line": latest,
+            "latest_status": _conductor_status_from_line(latest) if latest else "",
+        }
+    plan_530 = [line for line in lines if "Plan milestone 2026.08.530" in line]
+    activation_530 = [line for line in lines if "Milestone 2026.08.530 activated" in line]
+    plan_531 = [line for line in lines if "Plan milestone 2026.08.531" in line]
+    activation_531 = [line for line in lines if "Milestone 2026.08.531 activated" in line]
+    return {
+        "source_plan_line": plan_530[-1] if plan_530 else "",
+        "source_plan_status": _conductor_status_from_line(plan_530[-1]) if plan_530 else "",
+        "source_activation_line": activation_530[-1] if activation_530 else "",
+        "source_activation_status": _conductor_status_from_line(activation_530[-1])
+        if activation_530
+        else "",
+        "source_activated_task_count_claim": 12
+        if activation_530 and "12 tasks queued" in activation_530[-1]
+        else None,
+        "destination_plan_line": plan_531[-1] if plan_531 else "",
+        "destination_plan_status": _conductor_status_from_line(plan_531[-1]) if plan_531 else "",
+        "destination_activation_line": activation_531[-1] if activation_531 else "",
+        "destination_activation_status": _conductor_status_from_line(activation_531[-1])
+        if activation_531
+        else "",
+        "destination_activated_task_count_claim": 9
+        if activation_531 and "9 tasks queued" in activation_531[-1]
+        else None,
+        "by_task": by_task,
+    }
