+MemoryProbe = Callable[[], JsonDict]
+DiskProbe = Callable[[Path], JsonDict]
+
+REPO_ROOT = exp5869.REPO_ROOT
+RESULT_RELATIVE_PATH = Path(
+    "results/experiment_5879_hardness_headroom_taxonomy_corrigendum.json"
+)
