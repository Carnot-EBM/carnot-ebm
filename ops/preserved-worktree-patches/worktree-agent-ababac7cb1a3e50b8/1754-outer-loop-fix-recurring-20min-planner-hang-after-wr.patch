From e21cbe8cbb681693342b19910bccde5b47b8e17c Mon Sep 17 00:00:00 2001
From: Ian Blenke <ian@blenke.com>
Date: Sun, 14 Jun 2026 08:13:54 -0400
Subject: [PATCH 01754/11362] [outer-loop] fix recurring ~20min planner
 hang-after-write (operator-directed)

The Claude planner writes research-roadmap-next.yaml then its subprocess goes idle;
the conductor waited out the full ~20min wall-clock+idle timeout before killing it
(then the next iteration found+activated the already-written roadmap). Recurred every
milestone transition (.387 05:35, .388 09:40).

run_agent already has a stable-deliverable early-kill (kills the agent ~120s after the
deliverable stops changing), but it json.load'd the file to rule out bootstrap status
-> a YAML roadmap always failed that parse -> treated as not-finished -> never early-
killed. Fix: (1) make the bootstrap check YAML-aware (a .yaml deliverable that parses
to a dict with milestone+tasks is a finished roadmap -> allow early-kill); (2) pass
deliverable_path=research-roadmap-next.yaml at both planner call sites. JSON deliverables
unaffected. Applies on next conductor restart.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 scripts/research_conductor.py | 34 ++++++++++++++++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/scripts/research_conductor.py b/scripts/research_conductor.py
index 3ba9109c3d..368be50f3e 100644
--- a/scripts/research_conductor.py
+++ b/scripts/research_conductor.py
@@ -658,6 +658,28 @@ def run_agent(
                             # Mid-write race or non-JSON artifact —
                             # treat as not-yet-finished to be safe.
                             bootstrap_only = True
+                            # 2026-06-14 (outer-loop): YAML deliverables (the
+                            # planner's research-roadmap-next.yaml) are not JSON,
+                            # so json.load always fails here and the planner used
+                            # to idle-hang ~20 min after writing the roadmap until
+                            # the wall-clock+idle timeout killed it. A YAML file
+                            # that parses to a dict with milestone+tasks IS a
+                            # finished roadmap -> allow the stable-deliverable
+                            # early-kill. JSON deliverables are unaffected.
+                            if str(deliverable_file).endswith((".yaml", ".yml")):
+                                try:
+                                    with deliverable_file.open(
+                                        "r", encoding="utf-8"
+                                    ) as _yfh:
+                                        _ydoc = yaml.safe_load(_yfh)
+                                    if (
+                                        isinstance(_ydoc, dict)
+                                        and _ydoc.get("milestone")
+                                        and _ydoc.get("tasks")
+                                    ):
+                                        bootstrap_only = False
+                                except (OSError, yaml.YAMLError):
+                                    bootstrap_only = True
                         if bootstrap_only:
                             # Don't reset the stability tracker — keep
                             # tracking so we eventually fall through to
@@ -3327,6 +3349,12 @@ continuations", 2026-05-29):
         timeout=1200,
         model_override=AGENT_MODEL_PLANNER,
         agent_type_override=AGENT_TYPE_PLANNER,
+        # 2026-06-14 (outer-loop): wire the roadmap as the deliverable so the
+        # stable-deliverable early-kill fires ~2 min after the planner finishes
+        # writing it, instead of idle-hanging ~20 min until the wall-clock
+        # timeout. The YAML-aware bootstrap check (see run_agent) only early-exits
+        # once the roadmap parses with milestone+tasks and is stable 120s.
+        deliverable_path="research-roadmap-next.yaml",
     )
 
     if not success:
@@ -3981,6 +4009,12 @@ def _plan_next_milestone(push: bool = True) -> bool:
         timeout=1200,
         model_override=AGENT_MODEL_PLANNER,
         agent_type_override=AGENT_TYPE_PLANNER,
+        # 2026-06-14 (outer-loop): wire the roadmap as the deliverable so the
+        # stable-deliverable early-kill fires ~2 min after the planner finishes
+        # writing it, instead of idle-hanging ~20 min until the wall-clock
+        # timeout. The YAML-aware bootstrap check (see run_agent) only early-exits
+        # once the roadmap parses with milestone+tasks and is stable 120s.
+        deliverable_path="research-roadmap-next.yaml",
     )
 
     if not success:
