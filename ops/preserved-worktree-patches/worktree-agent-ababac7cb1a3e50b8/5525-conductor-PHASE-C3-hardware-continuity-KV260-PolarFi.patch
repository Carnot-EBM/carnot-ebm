+        mod.GATEMATE_SCAN_USB_COMMAND,
+        mod.GATEMATE_VERSION_COMMAND,
+        mod.GATEMATE_USB_ENUMERATION_COMMAND,
+        mod.GATEMATE_DMESG_COMMAND,
+        mod.GATEMATE_VERBOSE_DETECT_COMMAND,
