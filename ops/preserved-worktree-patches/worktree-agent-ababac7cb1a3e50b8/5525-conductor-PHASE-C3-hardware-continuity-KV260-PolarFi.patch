+def ising_energy(payload: JsonMap) -> int:
+    spins = [int(value) for value in payload["spins"]]
+    total = 0
+    for row, col, coupling in payload["edges"]:
+        total -= int(coupling) * spins[int(row)] * spins[int(col)]
+    return total
+
