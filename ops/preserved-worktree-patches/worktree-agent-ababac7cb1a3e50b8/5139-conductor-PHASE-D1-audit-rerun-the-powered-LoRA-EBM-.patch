+            frozen_rows=_frozen_rows(),
+            refreshed=True,
+        )
+        == []
+    )
+    rows = mod._build_eval_rows(_refreshed_rows(), frozen_rows=_frozen_rows(), refreshed=True)
+    with pytest.raises(ValueError, match="cached scorer predictions length"):
