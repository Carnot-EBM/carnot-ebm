+    }
+    total = sum(int(row["total"]) for row in per_game.values())
+    correct = sum(int(row["correct"]) for row in per_game.values())
+    return {
+        "accuracy": round(correct / total, 6) if total else 0.0,
+        "correct": correct,
+        "total": total,
+        "per_game": per_game,
+    }
