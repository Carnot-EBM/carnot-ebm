+        cwd=root,
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    payload = json.loads(proc.stdout)
+    if not isinstance(payload, dict):
+        raise ValueError("publication_gate.py --json returned a non-object payload")
+    return payload
+
