+def bundle_checksum(bundle: StreamBundle) -> str:
+    """Hash rows, splits, and outcomes without file-path metadata."""
+
+    return sha256_json({"rows": bundle.rows, "splits": bundle.splits, "outcomes": bundle.outcomes})
