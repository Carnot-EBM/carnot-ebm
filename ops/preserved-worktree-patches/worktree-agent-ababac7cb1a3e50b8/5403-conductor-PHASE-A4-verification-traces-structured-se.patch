+)
+TRACE_CONFIDENCE_THRESHOLDS = (0.0, 0.25, 0.5, 0.75, 0.9)
+SCHEMA_VALIDITY_GATE = 0.98
+MIN_TRACE_COVERAGE = 0.70
+MIN_HARMFUL_REDUCTION = 0.25
+FALSE_ABSTAIN_RATE_MAX = 0.20
