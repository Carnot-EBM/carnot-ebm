+    "extropic_tsu_execution_claimed",
+    "conductor_modified",
+    "tests_run",
+)
+REQUIRED_SCHEMA_FIELDS = (
+    *REQUIRED_ARTIFACT_FIELDS,
+    "schema",
+    "experiment",
+    "spec_refs",
+    "random_seed",
