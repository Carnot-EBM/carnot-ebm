+    "field_principles",
+    "command_transcripts",
+    "board_blockers",
+    "reproducibility_checksum",
+)
+COMMAND_TRANSCRIPT_KEYS = (
+    "kv260_ssh",
+    "kv260_workload",
+    "gatemate_openfpgaloader",
+    "gatemate_dirtyjtag_detect",
+    "gatemate_workload",
+    "polarfire_ssh",
+    "polarfire_dispatch",
+)
+WORKLOAD_HASH_KEYS = (
+    "safe_workload_manifest",
+    "exp5141_board_ready_descriptors",
+    "kv260_workload",
+    "kv260_executable",
