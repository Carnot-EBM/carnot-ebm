+def evaluate_heldout_case(
+    case: HeldoutCspCase,
+    *,
+    solver: ExactCspSolver | None = None,
+    sampler_features: Mapping[str, Any] | None = None,
+) -> JsonDict:
+    """Evaluate all policy arms while exact search owns every reported label."""
