+        "unguarded": _arm_json(active_solver, instance, unguarded, adaptation.order, exact_label),
+        "guarded": _arm_json(active_solver, instance, guarded, guarded_order, exact_label),
+        "sampler_feature": _arm_json(
+            active_solver,
