+def _check(name: str, expected: Any, observed: Any, passed: bool) -> JsonDict:
+    """Pair each decision with the values needed to reproduce it."""
+
+    return {
+        "check": name,
+        "expected": expected,
+        "observed": observed,
+        "passed": bool(passed),
+        "terminal": True,
+    }
