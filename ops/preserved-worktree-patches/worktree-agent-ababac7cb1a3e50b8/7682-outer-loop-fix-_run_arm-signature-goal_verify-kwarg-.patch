index 408c35613b..724e9244c0 100644
--- a/scripts/arc_winner_greedy_direct_ab.py
+++ b/scripts/arc_winner_greedy_direct_ab.py
@@ -47,7 +47,7 @@ def _oracle_levels() -> dict:
 
 
 def _run_arm(
