+    science = science_positive_score(payloads.get(7002, {}), payloads.get(7001, {}))
+    verdict_class = "positive" if science else "null"
+    honest_verdict = POSITIVE_VERDICT if science else NULL_VERDICT
+    self_row = classify_task(
