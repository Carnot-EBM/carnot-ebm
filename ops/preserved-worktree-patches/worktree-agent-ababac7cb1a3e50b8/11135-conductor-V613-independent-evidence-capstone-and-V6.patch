+def _finite(values: Sequence[Any]) -> list[float]:
+    """Keep finite real values and reject booleans from metric arithmetic."""
+
+    return [
+        float(value)
+        for value in values
+        if isinstance(value, (int, float)) and not isinstance(value, bool)
+    ]
