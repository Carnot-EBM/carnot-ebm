+            "command_receipt_rows": _placeholder_command_rows(),
+            "v613_capstone_complete_score": 0,
+            "v613_task_contract_conforms_score": 0,
+            "v613_science_positive_score": 0,
+            "solve_claimed": False,
+            "level_claimed": False,
