+def build_artifact(
+    *,
+    per_game_value_gap: Mapping[str, Mapping[str, Any]],
+    positive_control_game: str,
+    positive_control_row: Mapping[str, Any] | None,
+    preconditions_checked: Mapping[str, Any],
+    live_path_reachable: bool,
