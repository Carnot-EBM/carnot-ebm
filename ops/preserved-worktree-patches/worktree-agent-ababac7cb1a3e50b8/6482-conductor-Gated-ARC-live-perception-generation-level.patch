+class _NoOpProposer:  # pragma: no cover - ARC runtime boundary
+    def induce(self, *_args: Any, **_kwargs: Any) -> tuple[bool, str]:
+        return False, "disabled_exp5508_no_llm"
+
+    def world_model_candidates(self, _game: str) -> list[Any]:
+        return []
