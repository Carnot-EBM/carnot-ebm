+def test_req_capstone_4990_spec_declares_transition_contract() -> None:
+    """REQ-CAPSTONE-4990: OpenSpec declares the .459/.460 transition contract."""
+
+    spec = SPEC_PATH.read_text(encoding="utf-8")
+    section = spec[spec.index("REQ-CAPSTONE-4990") :]
+
+    assert mod._do_not_queue(["representation_5"]) == ["representation_5"]
+    for ref in mod.SPEC_REFS:
+        assert ref in section
+    assert str(mod.OUTPUT_REL_PATH) in section
+    for field in mod.REQUIRED_FIELDS:
+        assert field in section
+    for field, principle in mod.FIELD_PRINCIPLES.items():
+        assert field in section
+        assert principle["principle"] in section
+    assert "research-roadmap.yaml` first" in section
+    assert "research-roadmap-next.yaml` SHALL NOT block" in section
+    assert mod.PRETEST_COMMAND == [
+        ".venv/bin/pytest",
+        "tests/python/test_experiment_4990_archive_459_activate_460.py",
+        "-q",
+        "--no-cov",
+    ]
