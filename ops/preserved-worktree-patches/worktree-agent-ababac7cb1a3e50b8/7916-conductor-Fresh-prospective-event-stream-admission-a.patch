+REPO = Path(__file__).resolve().parents[2]
+SELF_LEARNING_SPEC = REPO / "openspec/capabilities/self-learning/spec.md"
+HARNESS_SPEC = REPO / "openspec/capabilities/research-harnesses/spec.md"
