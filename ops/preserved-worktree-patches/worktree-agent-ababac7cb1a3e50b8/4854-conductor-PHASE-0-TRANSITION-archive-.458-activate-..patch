+def _make_root(
+    root: Path,
+    *,
+    include_active: bool = True,
+    include_next: bool = False,
+    include_capstone: bool = True,
+    active_milestone: str = "2026.06.459",
+) -> None:
+    if include_active:
+        _write_text(root / "research-roadmap.yaml", f"milestone: {active_milestone}\n")
+    if include_next:
+        _write_text(root / "research-roadmap-next.yaml", "milestone: 2026.06.459\n")
+    _write_text(root / mod.REGISTRY_REL_PATH, "schema_version: 1\nreproducible_total_levels: 69\n")
+    _write_json(
+        root / mod.RETRO_REL_PATH,
+        {
+            "experiments_completed": 0,
+            "milestone": "2026.06.458",
+            "summary": "False-zero timing data; artifacts confirm exp4968 through exp4978 ran.",
+        },
+    )
+    if include_capstone:
+        _write_json(root / mod.CAPSTONE_REL_PATH, _capstone_artifact())
