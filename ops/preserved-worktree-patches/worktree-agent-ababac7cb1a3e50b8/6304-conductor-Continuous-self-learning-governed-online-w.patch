+
+    evaluation = evaluate_governed_memory_loop(root)
+    readiness = _readiness_checks(evaluation, tests_run)
+    ready = bool(readiness["all_passed"])
+    artifact: JsonDict = {
+        "schema": SCHEMA,
+        "experiment": EXPERIMENT,
