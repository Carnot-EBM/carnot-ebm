+            if isinstance(gpu_value, Mapping)
+            and isinstance(gpu_value.get("cuda_runtime"), Mapping)
+            else {},
+            "rocm_smi": dict(gpu_value.get("rocm_smi", {}))
+            if isinstance(gpu_value, Mapping)
+            and isinstance(gpu_value.get("rocm_smi"), Mapping)
