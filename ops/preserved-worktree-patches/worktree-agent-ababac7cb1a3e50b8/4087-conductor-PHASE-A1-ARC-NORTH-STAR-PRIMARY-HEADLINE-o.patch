+    for bad in bad_artifacts:
+        if bad and bad.get("reproducibility_checksum") != "sha256:bad":
+            bad["reproducibility_checksum"] = mod._checksum_payload(bad)
+        with pytest.raises(ValueError):
+            mod.validate_artifact(bad)
