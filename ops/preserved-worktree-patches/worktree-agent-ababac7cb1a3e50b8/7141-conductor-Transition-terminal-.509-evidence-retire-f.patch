+    entries = _manifest_entries(manifest)
+    applied: list[JsonDict] = []
+    debt: list[JsonDict] = []
+    for required in REQUIRED_MANIFEST_RETIREMENTS:
+        present = any(_manifest_has_required(entry, required) for entry in entries)
+        row = {
