+def _manifest_payload(include_retirements: bool = True) -> JsonDict:
+    extras: list[JsonDict] = []
+    if include_retirements:
+        extras = [dict(entry) for entry in mod.REQUIRED_MANIFEST_RETIREMENTS]
+    return {
+        "retired": [],
+        "retired_experiments": [],
+        "retired_extras": extras,
+    }
