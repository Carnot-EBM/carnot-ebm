+@dataclass(frozen=True)
+class ExperimentConfig:
+    """Runtime configuration for Exp 3885."""
+
+    repo_root: Path
+    output_path: Path | None = None
+    random_seed: int = DEFAULT_RANDOM_SEED
+    bootstrap_seed: int = DEFAULT_BOOTSTRAP_SEED
