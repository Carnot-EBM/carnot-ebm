+def test_req_learn_4342_summary_bootstraps_across_held_out_games() -> None:
+    """REQ-LEARN-4342-7: CI and gate are across held-out games."""
+
+    rows = [
+        {
+            "held_out_game": "r11l",
+            "level_index": 1,
+            "states_uniform": 30,
+            "states_guided": 10,
+            "baseline_solved": True,
+            "guided_solved": True,
+        },
+        {
