+def build_artifact(
+    *,
+    per_lane_per_game: Mapping[str, Mapping[str, Mapping[str, Any]]],
+    preconditions_checked: Mapping[str, Any],
+    live_path_reachable: bool,
+    duration_s: float,
+    partial: bool,
+    checkpoint_emitted: bool,
+    a1_artifact: Mapping[str, Any] | None = None,
