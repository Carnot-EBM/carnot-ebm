+    if not isinstance(lane_rows, Mapping):
+        return values
+    for row in lane_rows.values():
+        if not isinstance(row, Mapping):
+            continue
+        try:
+            values.append(round(float(row["delta_vs_baseline"]), 6))
+        except (KeyError, TypeError, ValueError):
