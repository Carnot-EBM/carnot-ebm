+def _git_output(repo_root: Path, args: Sequence[str]) -> str:
+    result = subprocess.run(
+        ["git", *args],
+        cwd=repo_root,
+        check=False,
+        text=True,
+        capture_output=True,
+    )
+    if result.returncode == 0:
+        return result.stdout.strip()
+    return f"git_failed:{result.stderr.strip()}"
