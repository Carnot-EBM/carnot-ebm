+
+    grid = np.zeros((3, 3), dtype=np.int16)
+    next_grid = grid.copy()
+    next_grid[1, 1] = 4
+    prior = [
+        Transition(
+            grid=grid,
+            action=1,
+            data=None,
+            next_grid=next_grid,
+            level_before=0,
+            level_after=0,
+        )
+        for _ in range(8)
