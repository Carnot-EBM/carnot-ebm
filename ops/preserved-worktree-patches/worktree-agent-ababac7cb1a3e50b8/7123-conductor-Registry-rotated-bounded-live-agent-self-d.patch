+    return v508._int(value, default)
+
+
+def _float(value: Any, default: float = 0.0) -> float:
+    try:
+        return float(value)
+    except (TypeError, ValueError):
+        return default
+
+
+def _sha256(value: Any) -> str:
+    return v508._sha256(value)
