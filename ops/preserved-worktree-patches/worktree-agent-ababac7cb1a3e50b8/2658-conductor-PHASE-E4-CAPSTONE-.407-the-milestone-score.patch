+#!/usr/bin/env python3
+"""Run Exp 4412 v407 verifier localizer scorecard capstone.
+
+Spec refs: REQ-CAPSTONE-4412, SCENARIO-CAPSTONE-4412.
+"""
+
+# ruff: noqa: E402,I001
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(REPO_ROOT / "python"))
+
+from carnot.reporting.capstone_v407_4412 import write_artifact  # noqa: E402
+
+
+if __name__ == "__main__":
+    output = write_artifact(REPO_ROOT)
+    print(output.read_text(encoding="utf-8"), end="")
