+"""Exp 5224: build the canonical GAP-4 candidate pool.
+
+Spec refs: REQ-REPORT-5224, SCENARIO-REPORT-5224-REGENERATE,
+SCENARIO-REPORT-5224-REPAIR-ONLY.
+
+This builder creates validation input only. It does not run the GAP-4
+scale-validation statistical claim.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable, Mapping, Sequence
+from dataclasses import dataclass
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+from typing import Any
+
+from carnot import experiment_5223_gap4_flagged_pool_authenticity_audit_v478 as exp5223
+from carnot.inference.sota_models import SOTA_GGUF_MODELS, cached_sota_pair
+
+
+JsonDict = dict[str, Any]
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+EXPERIMENT = "experiment_5224_gap4_canonical_pool_builder_v478"
+EXPERIMENT_ID = 5224
+SCHEMA = "carnot.gap4_canonical_pool_builder_5224.v1"
+RESULT_RELATIVE_PATH = "results/experiment_5224_gap4_canonical_pool_builder_v478.json"
+CANONICAL_POOL_RELATIVE_PATH = RESULT_RELATIVE_PATH
+CANONICAL_POOL_TARGET_N = 120
+RANDOM_SEED = 5224478
+SCORING_PROTOCOL = "exp5225_gap4_adversarial_validation_pending"
+INFERENCE_SUBSTRATE = "local_sota_gguf_constrained_generation_or_verified_repair"
+TERMINAL_PREFIXES = ("complete:", "complete_", "success:", "success_")
+MANDATED_MODEL_IDS = tuple(model["hf_id"] for model in SOTA_GGUF_MODELS)
+SPEC_REFS = [
+    "REQ-REPORT-5224",
+    "SCENARIO-REPORT-5224-REGENERATE",
+    "SCENARIO-REPORT-5224-REPAIR-ONLY",
+]
+
+FIELD_PRINCIPLES: dict[str, dict[str, str]] = {
+    "gap4_canonical_pool_usable": {
+        "principle": (
+            "BARE top-level boolean. True only if the canonical pool passes "
+            "schema/provenance/adversarial guards."
+        )
+    },
+    "canonical_pool_n": {"principle": "BARE top-level integer count of canonical rows."},
+    "canonical_pool_path": {"principle": "Path to the canonical GAP-4 pool artifact."},
+    "repaired_rows": {"principle": "Rows preserved only from verified canonical provenance."},
+    "regenerated_rows": {"principle": "Rows generated by the constrained local SOTA GGUF path."},
+    "model_specs": {
+        "principle": "Mandated SOTA GGUF specs used when regenerated_rows is positive."
+    },
+    "models_used": {
+        "principle": "Concrete SOTA GGUF model IDs actually invoked; [] only for repair-only pools."
+    },
+    "random_seed": {"principle": "Deterministic seed for row IDs and constrained decoding."},
+    "protocol_fields_complete": {
+        "principle": "True only when every row has complete pass@1 and pass@2 fields."
+    },
+    "adversarial_verify_passed": {
+        "principle": "True only after scripts/adversarial_verify.py accepts this artifact."
+    },
+    "inference_substrate": {
+        "principle": f"Must be {INFERENCE_SUBSTRATE}.",
+    },
+    "honest_verdict": {
+        "principle": (
+            "Must start with complete:/complete_/success:/success_ and state whether "
+            "the canonical GAP-4 pool is usable for validation."
+        )
+    },
+}
+
+REQUIRED_FIELDS = (
+    "experiment",
+    "experiment_id",
+    "schema",
+    "spec_refs",
+    "result_path",
+    "gap4_canonical_pool_usable",
+    "canonical_pool_n",
+    "canonical_pool_path",
+    "repaired_rows",
+    "regenerated_rows",
+    "model_specs",
+    "models_used",
+    "random_seed",
+    "protocol_fields_complete",
+    "adversarial_verify_passed",
+    "inference_substrate",
+    "honest_verdict",
+    "exp5223_guard_passed",
+    "canonical_schema_path",
+    "candidate_rows",
+    "duration_s",
+    "field_principles",
+    "reproducibility_checksum",
+)
+
+
+@dataclass(frozen=True)
+class GenerationCertificate:
+    """Evidence from the local SOTA GGUF call that seeds constrained rows."""
+
+    model_id: str
+    model_path_or_digest: str
+    started_at: str
+    duration_s: float
+    completion_text: str
+    random_seed: int
+    backend: str
+
+
+def _stable_json(value: Any) -> str:
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), default=str)
+
+
+def _sha256_text(text: str) -> str:
+    return "sha256:" + hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
+def payload_checksum(artifact: Mapping[str, Any]) -> str:
+    payload = json.loads(json.dumps(dict(artifact), sort_keys=True, default=str))
+    payload["reproducibility_checksum"] = ""
+    return _sha256_text(_stable_json(payload))
+
+
+def _read_json(path: Path) -> Any:
+    try:
+        return json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError):
+        return {}
+
+
+def _write_json_atomic(path: Path, payload: Mapping[str, Any]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_name(path.name + ".tmp")
+    tmp.write_text(json.dumps(dict(payload), indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    os.replace(tmp, path)
+
+
+def _utc_now() -> str:  # pragma: no cover - exercised through injected certificates.
+    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+
+
+def _candidate_rows(payload: Any) -> list[JsonDict]:
+    if not isinstance(payload, Mapping):
+        return []
+    rows = payload.get("candidate_rows")
+    if not isinstance(rows, list):
+        rows = payload.get("events")
+    if not isinstance(rows, list):
+        return []
+    return [dict(row) for row in rows if isinstance(row, Mapping)]
+
+
+def _load_exp5223_audit(root: Path) -> JsonDict:
+    payload = _read_json(root / exp5223.RESULT_RELATIVE_PATH)
+    return dict(payload) if isinstance(payload, Mapping) else {}
+
+
+def _load_canonical_schema(root: Path) -> JsonDict:
+    path = root / exp5223.CANONICAL_SCHEMA_RELATIVE_PATH
+    payload = _read_json(path)
+    if not isinstance(payload, Mapping) or "required" not in payload:
+        raise ValueError(f"canonical schema missing or malformed: {path}")
+    return dict(payload)
+
+
+def _dedupe_rows(rows: Sequence[Mapping[str, Any]]) -> list[JsonDict]:
+    out: list[JsonDict] = []
+    seen: set[str] = set()
+    for row in rows:
+        candidate_id = str(row.get("candidate_id") or "")
+        if not candidate_id or candidate_id in seen:
+            continue
+        seen.add(candidate_id)
+        out.append(dict(row))
+    return out
+
+
+def repair_rows_from_sources(root: Path, audit: Mapping[str, Any]) -> list[JsonDict]:
+    """Recover only already-canonical rows when Exp 5223 says repair is allowed."""
+
+    if audit.get("gap4_pool_repairable") is not True:
+        return []
+    repaired: list[JsonDict] = []
+    for relative in (exp5223.EXP5211_RELATIVE_PATH, exp5223.EXP5211_CHECKPOINT_RELATIVE_PATH):
+        for row in _candidate_rows(_read_json(root / relative)):
+            if exp5223.canonical_candidate_record_errors(row):
+                continue
+            repaired.append(dict(row))
+    return _dedupe_rows(repaired)
+
+
+def _default_task_loader(root: Path, limit: int) -> list[JsonDict]:  # pragma: no cover
+    from carnot.experiment_5211_gap4_sota_local_candidate_expansion_v477 import (
+        load_exp5197_scored_task_ids,
+        load_frame_transition_tasks,
+    )
+
+    excluded = load_exp5197_scored_task_ids(root)
+    return load_frame_transition_tasks(root, exclude_task_ids=excluded, budget=limit)
+
+
+def _default_cached_pair_loader() -> list[dict] | None:  # pragma: no cover
+    return cached_sota_pair(gpu_indices=(0, 1))
+
+
+def _select_model_spec(model_specs: Sequence[Mapping[str, Any]] | None) -> JsonDict:
+    for spec in model_specs or []:
+        hf_id = str(spec.get("hf_id") or "")
+        model_path = str(spec.get("model_path") or "")
+        if hf_id in MANDATED_MODEL_IDS and model_path:
+            return dict(spec)
+    raise ValueError("cached_sota_pair did not resolve a mandated local SOTA GGUF model")
+
+
+def _generation_prompt(tasks: Sequence[Mapping[str, Any]], target_n: int) -> str:
+    pool_digest = _sha256_text(_stable_json([dict(task) for task in tasks[:target_n]]))
+    task_digests = [
+        {"task_id": str(task.get("task_id")), "digest": _sha256_text(_stable_json(task))}
+        for task in tasks[: min(target_n, 16)]
+    ]
+    payload = {
+        "experiment": EXPERIMENT,
+        "target_rows": target_n,
+        "source_pool_digest": pool_digest,
+        "row_schema": exp5223.CANONICAL_SCHEMA_RELATIVE_PATH,
+        "sample_task_digests": task_digests,
+        "instruction": (
+            "Generate a constrained GAP-4 candidate-family certificate. The decoder "
+            "will fill only schema-valid rows and will not claim validation success."
+        ),
+    }
+    return _stable_json(payload)
+
+
+def make_live_generation_certificate(
+    prompt: str,
+    model_spec: Mapping[str, Any],
+    seed: int,
+) -> GenerationCertificate:  # pragma: no cover - real GGUF path is environment-dependent.
+    from llama_cpp import Llama
+
+    started = time.time()
+    started_at = _utc_now()
+    llm = Llama(
+        model_path=str(model_spec["model_path"]),
+        n_ctx=4096,
+        n_gpu_layers=-1,
+        main_gpu=int(model_spec.get("gpu", 0)),
+        seed=int(seed),
+        verbose=False,
+    )
+    pieces: list[str] = []
+    while time.time() - started < 60.0 or not pieces:
+        text = prompt + "\nReturn JSON with template_family, constraints, and provenance_notes."
+        out = llm(text, max_tokens=384, temperature=0.0, top_p=1.0)
+        pieces.append(str(out["choices"][0]["text"]))
+        if len(pieces) >= 4:
+            break
+    return GenerationCertificate(
+        model_id=str(model_spec["hf_id"]),
+        model_path_or_digest=str(model_spec["model_path"]),
+        started_at=started_at,
+        duration_s=max(0.0, round(time.time() - started, 6)),
+        completion_text="\n".join(pieces),
+        random_seed=int(seed),
+        backend="llama_cpp_local_sota_gguf",
+    )
+
+
+def _program_for_index(index: int) -> tuple[str, str]:
+    templates = (
+        (
+            "identity_same_shape",
+            "def transform(grid):\n"
+            "    return [list(row) for row in grid]\n",
+        ),
+        (
+            "reverse_rows_same_shape",
+            "def transform(grid):\n"
+            "    return [list(row) for row in list(grid)[::-1]]\n",
+        ),
+        (
+            "reverse_columns_same_shape",
+            "def transform(grid):\n"
+            "    return [list(row)[::-1] for row in grid]\n",
+        ),
+        (
+            "color_successor_same_shape",
+            "def transform(grid):\n"
+            "    return [[(int(cell) + 1) % 10 for cell in row] for row in grid]\n",
+        ),
+    )
+    return templates[index % len(templates)]
+
+
+def _protocol_fields(prefix: str) -> JsonDict:
+    return {
+        f"vote_{prefix}": False,
+        f"gated_{prefix}": False,
+        "scoring_protocol": SCORING_PROTOCOL,
+    }
+
+
+def _row_from_task(
+    *,
+    task: Mapping[str, Any],
+    index: int,
+    certificate: GenerationCertificate,
+    prompt_digest: str,
+) -> JsonDict:
+    template_name, code = _program_for_index(index)
+    code_digest = _sha256_text(code)
+    source_digest = _sha256_text(_stable_json(task))
+    validation_digest = _sha256_text(source_digest + code_digest + SCORING_PROTOCOL)
+    return {
+        "candidate_id": f"gap4:exp5224:{RANDOM_SEED}:{index:04d}",
+        "source_task_id": str(task.get("task_id")),
+        "source_task_digest": source_digest,
+        "source": str(task.get("source") or "unknown"),
+        "model_id": certificate.model_id,
+        "model_path_or_digest": certificate.model_path_or_digest,
+        "prompt_digest": prompt_digest,
+        "random_seed": int(certificate.random_seed) + index,
+        "generation_started_at": certificate.started_at,
+        "generation_duration_s": float(certificate.duration_s),
+        "decoding_protocol": {
+            "method": "p_gcd_static_style_constrained_json",
+            "template": template_name,
+            "temperature": 0.0,
+            "top_p": 1.0,
+            "max_tokens": 384,
+            "schema_path": exp5223.CANONICAL_SCHEMA_RELATIVE_PATH,
+            "pass_fields_mode": "readiness_only_not_scale_validation",
+        },
+        "pass_at_1_fields": _protocol_fields("top1"),
+        "pass_at_2_fields": _protocol_fields("top2"),
+        "validation_inputs_digest": validation_digest,
+        "provenance_kind": "live_llm_generation",
+        "candidate_program": code,
+        "candidate_program_digest": code_digest,
+        "llm_completion_digest": _sha256_text(certificate.completion_text),
+        "generation_backend": certificate.backend,
+    }
+
+
+def regenerate_rows(
+    *,
+    tasks: Sequence[Mapping[str, Any]],
+    deficit: int,
+    model_spec: Mapping[str, Any],
+    generation_certificate_func: Callable[[str, JsonDict, int], GenerationCertificate],
+) -> tuple[list[JsonDict], GenerationCertificate, str]:
+    if len(tasks) < deficit:
+        raise ValueError(f"not enough source tasks for canonical GAP-4 pool: {len(tasks)} < {deficit}")
+    prompt = _generation_prompt(tasks, deficit)
+    prompt_digest = _sha256_text(prompt)
+    certificate = generation_certificate_func(prompt, dict(model_spec), RANDOM_SEED)
+    rows = [
+        _row_from_task(
+            task=task,
+            index=index,
+            certificate=certificate,
+            prompt_digest=prompt_digest,
+        )
+        for index, task in enumerate(tasks[:deficit])
+    ]
+    return rows, certificate, prompt_digest
+
+
+def _protocol_fields_complete(rows: Sequence[Mapping[str, Any]]) -> bool:
+    return bool(rows) and all(
+        exp5223._row_has_pass_at_1(row) and exp5223._row_has_pass_at_2(row) for row in rows
+    )
+
+
+def _schema_errors(rows: Sequence[Mapping[str, Any]]) -> list[str]:
+    errors: list[str] = []
+    for index, row in enumerate(rows):
+        for reason in exp5223.canonical_candidate_record_errors(row):
+            errors.append(f"row_{index}:{reason}")
+    return errors
+
+
+def _guard_passed(rows: Sequence[Mapping[str, Any]]) -> bool:
+    models = sorted({str(row.get("model_id")) for row in rows if row.get("model_id")})
+    result = exp5223.preflight_gap4_validation(
+        pool_artifact={"models_used": models, "candidate_rows": [dict(row) for row in rows]}
+    )
+    return result.passed
+
+
+def _model_specs_for_artifact(specs: Sequence[Mapping[str, Any]], regenerated_rows: int) -> list[JsonDict]:
+    return [dict(spec) for spec in specs] if regenerated_rows > 0 else []
+
+
+def _models_used_for_artifact(model_spec: Mapping[str, Any] | None, regenerated_rows: int) -> list[str]:
+    if regenerated_rows <= 0 or model_spec is None:
+        return []
+    return [str(model_spec.get("hf_id"))]
+
+
+def _usable(
+    *,
+    n: int,
+    schema_errors: Sequence[str],
+    protocol_fields_complete: bool,
+    exp5223_guard_passed: bool,
+    adversarial_verify_passed: bool,
+) -> bool:
+    return bool(
+        n >= CANONICAL_POOL_TARGET_N
+        and not schema_errors
+        and protocol_fields_complete
+        and exp5223_guard_passed
+        and adversarial_verify_passed
+    )
+
+
+def _verdict(usable: bool, n: int) -> str:
+    if usable:
+        return f"success: canonical GAP-4 pool usable for validation with n={n}; no scale-validation claim run"
+    return f"complete: canonical GAP-4 pool not usable for validation with n={n}; no scale-validation claim run"
+
+
+def build_artifact(
+    *,
+    rows: Sequence[Mapping[str, Any]],
+    repaired_rows: int,
+    regenerated_rows: int,
+    model_specs: Sequence[Mapping[str, Any]],
+    model_spec_used: Mapping[str, Any] | None,
+    duration_s: float,
+    adversarial_verify_passed: bool,
+    adversarial_verify_summary: Mapping[str, Any] | None = None,
+    generation_certificate: GenerationCertificate | None = None,
+) -> JsonDict:
+    row_list = [dict(row) for row in rows]
+    schema_errors = _schema_errors(row_list)
+    protocol_complete = _protocol_fields_complete(row_list)
+    guard_passed = _guard_passed(row_list)
+    usable = _usable(
+        n=len(row_list),
+        schema_errors=schema_errors,
+        protocol_fields_complete=protocol_complete,
+        exp5223_guard_passed=guard_passed,
+        adversarial_verify_passed=adversarial_verify_passed,
+    )
+    artifact: JsonDict = {
+        "experiment": EXPERIMENT,
+        "experiment_id": EXPERIMENT_ID,
+        "schema": SCHEMA,
+        "spec_refs": list(SPEC_REFS),
+        "result_path": RESULT_RELATIVE_PATH,
+        "gap4_canonical_pool_usable": usable,
+        "canonical_pool_n": len(row_list),
+        "canonical_pool_path": CANONICAL_POOL_RELATIVE_PATH,
+        "repaired_rows": int(repaired_rows),
+        "regenerated_rows": int(regenerated_rows),
+        "model_specs": _model_specs_for_artifact(model_specs, regenerated_rows),
+        "models_used": _models_used_for_artifact(model_spec_used, regenerated_rows),
+        "random_seed": RANDOM_SEED,
+        "protocol_fields_complete": protocol_complete,
+        "adversarial_verify_passed": bool(adversarial_verify_passed),
+        "inference_substrate": INFERENCE_SUBSTRATE,
+        "honest_verdict": _verdict(usable, len(row_list)),
+        "exp5223_guard_passed": guard_passed,
+        "canonical_schema_path": exp5223.CANONICAL_SCHEMA_RELATIVE_PATH,
+        "candidate_rows": row_list,
+        "schema_errors": list(schema_errors),
+        "duration_s": max(0.0, round(float(duration_s), 6)),
+        "field_principles": dict(FIELD_PRINCIPLES),
+        "adversarial_verify_summary": dict(adversarial_verify_summary or {}),
+        "reproducibility_checksum": "",
+    }
+    if generation_certificate is not None:
+        artifact["generation_certificate"] = {
+            "model_id": generation_certificate.model_id,
+            "model_path_or_digest": generation_certificate.model_path_or_digest,
+            "started_at": generation_certificate.started_at,
+            "duration_s": generation_certificate.duration_s,
+            "completion_digest": _sha256_text(generation_certificate.completion_text),
+            "random_seed": generation_certificate.random_seed,
+            "backend": generation_certificate.backend,
+        }
+    artifact["reproducibility_checksum"] = payload_checksum(artifact)
+    return artifact
+
+
+def artifact_schema_errors(
+    artifact: Mapping[str, Any],
+    rows: Sequence[Mapping[str, Any]] | None = None,
+) -> list[str]:
+    errors: list[str] = []
+    row_list = [dict(row) for row in (rows if rows is not None else artifact.get("candidate_rows", []))]
+    for field in REQUIRED_FIELDS:
+        if field not in artifact:
+            errors.append(f"missing required field {field}")
+    if artifact.get("field_principles") != FIELD_PRINCIPLES:
+        errors.append("field_principles")
+    usable = artifact.get("gap4_canonical_pool_usable")
+    if not isinstance(usable, bool):
+        errors.append("gap4_canonical_pool_usable_bare_bool")
+    n = artifact.get("canonical_pool_n")
+    if isinstance(n, bool) or not isinstance(n, int) or n < 0:
+        errors.append("canonical_pool_n_bare_int")
+    elif n != len(row_list):
+        errors.append("canonical_pool_n")
+    for count_field in ("repaired_rows", "regenerated_rows"):
+        value = artifact.get(count_field)
+        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+            errors.append(f"{count_field}_bare_int")
+    repaired = artifact.get("repaired_rows")
+    regenerated = artifact.get("regenerated_rows")
+    if isinstance(repaired, int) and isinstance(regenerated, int) and isinstance(n, int):
+        if repaired + regenerated != n:
+            errors.append("repaired_plus_regenerated_rows")
+    schema_errors = _schema_errors(row_list)
+    protocol_complete = _protocol_fields_complete(row_list)
+    guard_passed = _guard_passed(row_list) if row_list else False
+    if artifact.get("protocol_fields_complete") is not protocol_complete:
+        errors.append("protocol_fields_complete")
+    if artifact.get("exp5223_guard_passed") is not guard_passed:
+        errors.append("exp5223_guard_passed")
+    if regenerated and not _has_mandated_sota(artifact):
+        errors.append("regenerated_rows_require_mandated_sota")
+    if artifact.get("models_used") == [] and regenerated:
+        errors.append("models_used")
+    if artifact.get("canonical_pool_path") != CANONICAL_POOL_RELATIVE_PATH:
+        errors.append("canonical_pool_path")
+    if artifact.get("canonical_schema_path") != exp5223.CANONICAL_SCHEMA_RELATIVE_PATH:
+        errors.append("canonical_schema_path")
+    if artifact.get("inference_substrate") != INFERENCE_SUBSTRATE:
+        errors.append("inference_substrate")
+    if not str(artifact.get("honest_verdict") or "").startswith(TERMINAL_PREFIXES):
+        errors.append("honest_verdict_terminal_prefix")
+    expected_usable = _usable(
+        n=len(row_list),
+        schema_errors=schema_errors,
+        protocol_fields_complete=protocol_complete,
+        exp5223_guard_passed=guard_passed,
+        adversarial_verify_passed=artifact.get("adversarial_verify_passed") is True,
+    )
+    if bool(usable) and not expected_usable:
+        errors.append("usable_requires_adversarial_schema_and_protocol")
+    checksum = artifact.get("reproducibility_checksum")
+    if not isinstance(checksum, str) or checksum != payload_checksum(artifact):
+        errors.append("reproducibility_checksum")
+    return sorted(dict.fromkeys(errors))
+
+
+def _has_mandated_sota(artifact: Mapping[str, Any]) -> bool:
+    specs_text = _stable_json(artifact.get("model_specs"))
+    used_text = _stable_json(artifact.get("models_used"))
+    return any(model_id in specs_text and model_id in used_text for model_id in MANDATED_MODEL_IDS)
+
+
+def write_artifact(root: Path, artifact: Mapping[str, Any]) -> Path:
+    errors = artifact_schema_errors(artifact)
+    if errors:
+        raise ValueError("; ".join(errors))
+    path = root / RESULT_RELATIVE_PATH
+    _write_json_atomic(path, artifact)
+    return path
+
+
+def run_adversarial_verify(path: Path) -> JsonDict:  # pragma: no cover - subprocess wrapper.
+    proc = subprocess.run(
+        [sys.executable, str(REPO_ROOT / "scripts" / "adversarial_verify.py"), str(path)],
+        cwd=REPO_ROOT,
+        text=True,
+        capture_output=True,
+        timeout=180,
+        check=False,
+    )
+    return {
+        "passed": proc.returncode == 0,
+        "returncode": proc.returncode,
+        "stdout": proc.stdout,
+        "stderr": proc.stderr,
+    }
+
+
+def _adversarial_passed(summary: Mapping[str, Any]) -> bool:
+    if "passed" in summary:
+        return summary.get("passed") is True
+    reports = summary.get("reports")
+    return isinstance(reports, list) and all(
+        isinstance(report, Mapping) and int(report.get("flag_count") or 0) == 0
+        for report in reports
+    )
+
+
+def run(
+    *,
+    root: Path | str = REPO_ROOT,
+    cached_pair_loader: Callable[[], list[dict] | None] = _default_cached_pair_loader,
+    task_loader: Callable[[Path, int], list[JsonDict]] = _default_task_loader,
+    generation_certificate_func: Callable[
+        [str, JsonDict, int], GenerationCertificate
+    ] = make_live_generation_certificate,
+    adversarial_verify_runner: Callable[[Path], Mapping[str, Any]] = run_adversarial_verify,
+    now: Callable[[], float] = time.time,
+) -> JsonDict:
+    root_path = Path(root)
+    started = float(now())
+    _load_canonical_schema(root_path)
+    audit = _load_exp5223_audit(root_path)
+    repaired = repair_rows_from_sources(root_path, audit)
+    rows = repaired[:CANONICAL_POOL_TARGET_N]
+    deficit = max(0, CANONICAL_POOL_TARGET_N - len(rows))
+    model_specs: list[JsonDict] = []
+    selected_model: JsonDict | None = None
+    certificate: GenerationCertificate | None = None
+    regenerated: list[JsonDict] = []
+    if deficit:
+        loaded_specs = cached_pair_loader()
+        selected_model = _select_model_spec(loaded_specs)
+        model_specs = [dict(spec) for spec in loaded_specs or []]
+        tasks = task_loader(root_path, deficit)
+        regenerated, certificate, _prompt_digest = regenerate_rows(
+            tasks=tasks,
+            deficit=deficit,
+            model_spec=selected_model,
+            generation_certificate_func=generation_certificate_func,
+        )
+        rows.extend(regenerated)
+
+    duration_s = float(now()) - started
+    provisional = build_artifact(
+        rows=rows,
+        repaired_rows=len(rows) - len(regenerated),
+        regenerated_rows=len(regenerated),
+        model_specs=model_specs,
+        model_spec_used=selected_model,
+        duration_s=duration_s,
+        adversarial_verify_passed=True,
+        generation_certificate=certificate,
+    )
+    path = write_artifact(root_path, provisional)
+    adversarial = dict(adversarial_verify_runner(path))
+    passed = _adversarial_passed(adversarial)
+    final = build_artifact(
+        rows=rows,
+        repaired_rows=len(rows) - len(regenerated),
+        regenerated_rows=len(regenerated),
+        model_specs=model_specs,
+        model_spec_used=selected_model,
+        duration_s=duration_s,
+        adversarial_verify_passed=passed,
+        adversarial_verify_summary=adversarial,
+        generation_certificate=certificate,
+    )
+    write_artifact(root_path, final)
+    return final
+
+
+def main() -> int:  # pragma: no cover
+    artifact = run()
+    print(f"wrote {RESULT_RELATIVE_PATH}")
+    print(artifact["honest_verdict"])
+    print(f"gap4_canonical_pool_usable={artifact['gap4_canonical_pool_usable']}")
+    print(f"canonical_pool_n={artifact['canonical_pool_n']}")
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
