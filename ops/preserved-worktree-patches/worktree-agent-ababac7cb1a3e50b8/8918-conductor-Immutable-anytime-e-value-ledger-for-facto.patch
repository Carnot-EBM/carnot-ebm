+
+def sha256_file(path: Path) -> str | None:
+    """Return a file digest, or None when the path is absent."""
+
+    if not path.exists() or not path.is_file():
+        return None
+    return "sha256:" + hashlib.sha256(path.read_bytes()).hexdigest()
