+        "task": task,
+        "demos": demos,
+        "test_input": test_input,
+        "candidates": candidates,
+    }
+
+
+def _synthetic_entries() -> list[dict[str, Any]]:
+    return [
+        _entry(
+            "recover",
+            [_demo(1, 2), _demo(3, 4)],
+            [[5]],
+            [
+                _candidate([[9]], votes=10, correct=False),
+                _candidate([[8]], votes=9, correct=False),
+                _candidate([[6]], votes=1, correct=True),
