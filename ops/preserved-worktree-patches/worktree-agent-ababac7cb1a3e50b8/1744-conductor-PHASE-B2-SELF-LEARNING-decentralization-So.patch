+def _sample(task: str, code: str, *, draw_index: int, claimed_perfect: bool = True) -> dict[str, Any]:
+    return {
+        "task": task,
+        "draw_index": draw_index,
+        "status": "graded",
+        "demo_fit": 1.0 if claimed_perfect else 0.0,
