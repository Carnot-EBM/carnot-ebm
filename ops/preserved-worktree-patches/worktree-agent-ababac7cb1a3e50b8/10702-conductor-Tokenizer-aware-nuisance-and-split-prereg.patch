+def _resolve_model_files(exp6850: Mapping[str, Any]) -> list[JsonDict]:  # pragma: no cover
+    """Call the canonical pair helper and bind all three current model files."""
+
+    pair = cached_sota_pair() or []
+    pair_rows = [dict(row) for row in pair if isinstance(row, Mapping)]
+    pair_ids = [str(row.get("hf_id")) for row in pair_rows]
+    pair_by_id = {str(row.get("hf_id")): row for row in pair_rows}
+    frozen_hashes = exp6850.get("model_artifact_hashes")
+    frozen_hashes = frozen_hashes if isinstance(frozen_hashes, Mapping) else {}
+    registry = {str(row["hf_id"]): dict(row) for row in SOTA_GGUF_MODELS}
+    rows: list[JsonDict] = []
+    for hf_id in MODEL_SPECS:
+        source = dict(pair_by_id.get(hf_id, {}))
+        path_text = str(source.get("model_path") or resolve_cached_gguf(hf_id) or "")
+        path = Path(path_text) if path_text else Path()
+        present = bool(path_text and path.is_file())
+        frozen = frozen_hashes.get(hf_id)
+        frozen = frozen if isinstance(frozen, Mapping) else {}
+        rows.append(
+            {
+                "hf_id": hf_id,
+                "family": MODEL_FAMILIES[hf_id],
+                "role": registry.get(hf_id, {}).get("role"),
+                "model_path": path_text,
+                "local_model_present": present,
+                "model_size_bytes": path.stat().st_size if present else 0,
+                "model_sha256": sha256_file(path) if present else "",
+                "cached_sota_pair_called": True,
+                "cached_sota_pair_hf_ids": pair_ids,
+                "frozen_model_receipt": dict(frozen),
+                "tokenizer_receipt": {},
+            }
+        )
+    return rows
