+def _sample_rows(
+    accepted_rows: Sequence[Mapping[str, Any]], split_manifest: Mapping[str, Any]
+) -> list[JsonDict]:
+    """Count unique accepted groups for each model and family split."""
+
+    split_ids = {
+        "calibration": set(split_manifest.get("calibration_group_ids", [])),
+        "held": set(split_manifest.get("held_group_ids", [])),
+    }
+    by_model: dict[str, set[str]] = defaultdict(set)
+    for row in accepted_rows:
+        by_model[str(row.get("model_hf_id"))].add(str(row.get("semantic_group_identity")))
+    rows: list[JsonDict] = []
+    for hf_id in MODEL_SPECS:
+        for split, group_ids in split_ids.items():
+            count = len(by_model[hf_id] & group_ids)
+            rows.append(
+                {
+                    "scope": "model",
+                    "scope_id": hf_id,
+                    "model_hf_id": hf_id,
+                    "family": MODEL_FAMILIES[hf_id],
+                    "split": split,
+                    "accepted_group_count": count,
+                    "minimum_group_count": MINIMUM_GROUP_COUNT,
+                    "floor_passed": count >= MINIMUM_GROUP_COUNT,
+                    "planned_standardized_paired_effect": 0.65,
+                    "two_sided_alpha": 0.05,
+                    "planned_power": 0.80,
+                    "power_status": "preregistered_design_target_not_observed_result",
+                }
+            )
+    family_models = {
+        family: [hf_id for hf_id in MODEL_SPECS if MODEL_FAMILIES[hf_id] == family]
+        for family in sorted(set(MODEL_FAMILIES.values()))
+    }
+    for family, model_ids in family_models.items():
+        common = set.intersection(*(by_model[hf_id] for hf_id in model_ids))
+        for split, group_ids in split_ids.items():
+            count = len(common & group_ids)
+            rows.append(
+                {
+                    "scope": "family",
+                    "scope_id": family,
+                    "family": family,
+                    "required_models": model_ids,
+                    "split": split,
+                    "accepted_group_count": count,
+                    "minimum_group_count": MINIMUM_GROUP_COUNT,
+                    "floor_passed": count >= MINIMUM_GROUP_COUNT,
+                    "planned_standardized_paired_effect": 0.65,
+                    "two_sided_alpha": 0.05,
+                    "planned_power": 0.80,
+                    "power_status": "preregistered_design_target_not_observed_result",
+                }
+            )
+    return rows
+
