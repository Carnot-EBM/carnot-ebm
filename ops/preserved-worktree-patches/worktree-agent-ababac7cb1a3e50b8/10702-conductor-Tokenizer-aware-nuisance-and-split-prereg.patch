+class NativeGgufTokenizer:  # pragma: no cover - exercised by the requested live run.
+    """Load only embedded GGUF vocabulary metadata through llama.cpp."""
+
+    def __init__(self, model_path: str) -> None:
+        from llama_cpp import Llama
+
+        self._llm = Llama(model_path=model_path, vocab_only=True, verbose=False)
+        metadata_value = getattr(self._llm, "metadata", {})
+        metadata_value = metadata_value() if callable(metadata_value) else metadata_value
+        self.metadata = dict(metadata_value) if isinstance(metadata_value, Mapping) else {}
+        chat_template = str(
+            self.metadata.get("tokenizer.chat_template")
+            or self.metadata.get("tokenizer.chat_templates")
+            or ""
+        )
+        special_tokens = {
+            str(key): _json_safe(value)
+            for key, value in self.metadata.items()
+            if any(marker in str(key).lower() for marker in ("token_id", "add_bos", "add_eos"))
+        }
+        # Exp6850 used llama.cpp's native default, which adds BOS for Gemma.
+        # Keep that exact probe setting so tokenizer hash drift is meaningful.
+        probe = self.tokenize(TOKENIZER_PROBE, add_bos=True, special=False)
+        self.receipt = tokenizer_receipt_from_metadata(
+            metadata=self.metadata,
+            probe_token_ids=probe,
+            special_tokens=special_tokens,
+            chat_template=chat_template,
+        )
+        self.receipt["tokenize_settings"] = {"add_bos": False, "special": False}
+
+    def tokenize(self, text: str, *, add_bos: bool, special: bool) -> list[int]:
+        """Return native token IDs without any evaluation call."""
+
+        return [
+            int(token)
+            for token in self._llm.tokenize(
+                text.encode("utf-8"), add_bos=add_bos, special=special
+            )
+        ]
+
+    def close(self) -> None:
+        """Release the vocabulary-only llama.cpp context."""
+
+        close = getattr(self._llm, "close", None)
+        if callable(close):
+            close()
+        del self._llm
+        gc.collect()
+
+
+def _whitespace_variants(length: int) -> list[str]:
+    """Return bounded semantic-free suffixes with one exact character length."""
+
+    if length == 0:
+        return [""]
+    patterns = (
+        " ",
+        "\n",
+        "\t",
+        " \n",
+        "\n ",
+        " \t",
+        "\t ",
+        "\n\t",
+    )
+    variants: list[str] = []
+    for pattern in patterns:
+        value = (pattern * ((length + len(pattern) - 1) // len(pattern)))[:length]
+        if value not in variants:
+            variants.append(value)
+    return variants
+
+
+def _equalized_sequences(
+    tokenizer: Any, first: str, second: str
+) -> tuple[list[str], list[list[int]], JsonDict] | None:
+    """Find equal character and token lengths using trailing whitespace only."""
+
+    base_length = max(len(first), len(second))
+    for extra in range(MAX_WHITESPACE_EXTRA + 1):
+        target = base_length + extra
+        first_options: dict[int, tuple[str, list[int]]] = {}
+        second_options: dict[int, tuple[str, list[int]]] = {}
+        for suffix in _whitespace_variants(target - len(first)):
+            sequence = first + suffix
+            tokens = tokenizer.tokenize(sequence, add_bos=False, special=False)
+            first_options.setdefault(len(tokens), (sequence, tokens))
+        for suffix in _whitespace_variants(target - len(second)):
+            sequence = second + suffix
+            tokens = tokenizer.tokenize(sequence, add_bos=False, special=False)
+            second_options.setdefault(len(tokens), (sequence, tokens))
+        common = sorted(set(first_options) & set(second_options))
+        if common:
+            count = common[0]
+            first_sequence, first_tokens = first_options[count]
+            second_sequence, second_tokens = second_options[count]
+            return (
+                [first_sequence, second_sequence],
+                [first_tokens, second_tokens],
+                {
+                    "method": "bounded_trailing_whitespace_exact_match",
+                    "target_character_count": target,
+                    "candidate_token_count": count,
+                    "extra_character_budget": extra,
+                },
+            )
+    return None
+
+
+def _render_group_cell(
+    *, tokenizer: Any, model: Mapping[str, Any], group: Mapping[str, Any]
+) -> JsonDict:
+    """Tokenize one model-specific contrast and apply exact nuisance matching."""
+
+    semantic_identity = str(group.get("semantic_identity"))
+    prompt = unicodedata.normalize(
+        "NFC", RAW_PROMPT_TEMPLATE.format(program_json=canonical_json(group.get("program")))
+    )
+    candidates = group.get("candidates")
+    candidates = candidates if isinstance(candidates, list) else []
+    candidate_rows = [candidate for candidate in candidates if isinstance(candidate, Mapping)]
+    original_sequences = [
+        unicodedata.normalize(
+            "NFC",
+            CANDIDATE_SEQUENCE_TEMPLATE.format(
+                candidate_json=canonical_json(candidate.get("content"))
+            ),
+        )
+        for candidate in candidate_rows[:2]
+    ]
+    prompt_tokens = tokenizer.tokenize(prompt, add_bos=True, special=False)
+    equalized = (
+        _equalized_sequences(tokenizer, original_sequences[0], original_sequences[1])
+        if len(original_sequences) == 2
+        else None
+    )
+    if equalized is None:
+        sequences = original_sequences
+        candidate_tokens = [
+            tokenizer.tokenize(sequence, add_bos=False, special=False)
+            for sequence in sequences
+        ]
+        padding_receipt: JsonDict = {
+            "method": "bounded_trailing_whitespace_exact_match",
+            "matched": False,
+            "maximum_extra_character_budget": MAX_WHITESPACE_EXTRA,
+        }
+    else:
+        sequences, candidate_tokens, padding_receipt = equalized
+        padding_receipt["matched"] = True
+
+    token_counts = {
+        f"slot_{index}": len(tokens) for index, tokens in enumerate(candidate_tokens)
+    }
+    character_counts = {
+        f"slot_{index}": len(sequence) for index, sequence in enumerate(sequences)
+    }
+    row: JsonDict = {
+        "cell_id": cell_identity(str(model.get("hf_id")), semantic_identity),
+        "model_hf_id": model.get("hf_id"),
+        "model_family": MODEL_FAMILIES.get(str(model.get("hf_id"))),
+        "semantic_group_identity": semantic_identity,
+        "source_group_id": group.get("group_id"),
+        "prompt_token_ids": prompt_tokens,
+        "prompt_token_count": len(prompt_tokens),
+        "prompt_character_count": len(prompt),
+        "candidate_ids": {
+            f"slot_{index}": candidate.get("candidate_id")
+            for index, candidate in enumerate(candidate_rows[:2])
+        },
+        "candidate_token_ids": {
+            f"slot_{index}": tokens for index, tokens in enumerate(candidate_tokens)
+        },
+        "candidate_token_counts": token_counts,
+        "candidate_character_counts": character_counts,
+        "original_candidate_character_counts": {
+            f"slot_{index}": len(sequence)
+            for index, sequence in enumerate(original_sequences)
+        },
+        "prompt_sequence_sha256": sha256_text(prompt),
+        "candidate_sequence_sha256": {
+            f"slot_{index}": sha256_text(sequence)
+            for index, sequence in enumerate(sequences)
+        },
+        "original_candidate_sequence_sha256": {
+            f"slot_{index}": sha256_text(sequence)
+            for index, sequence in enumerate(original_sequences)
+        },
+        "special_tokens": deepcopy(tokenizer.receipt.get("special_tokens", {})),
+        "tokenize_settings": {
+            "prompt": {"add_bos": True, "special": False},
+            "candidate": {"add_bos": False, "special": False},
+        },
+        "chat_template_identity": tokenizer.receipt.get("chat_template_identity"),
+        "tokenizer_hash": tokenizer.receipt.get("tokenizer_sha256"),
+        "paired_prompt_token_counts": {
+            "base": len(prompt_tokens),
+            "label_swap": len(prompt_tokens),
+        },
+        "label_position_contract": {"base": [0, 1], "swapped": [1, 0]},
+        "presentation_order": {
+            "base": list(range(len(candidate_rows[:2]))),
+            "label_swap": list(reversed(range(len(candidate_rows[:2])))),
+        },
+        "normalization": "NFC_and_ascii_sorted_compact_JSON",
+        "padding_receipt": padding_receipt,
+        "token_likelihood_call_count": 0,
+    }
+    reasons = cell_nuisance_errors(row)
+    row["accepted"] = not reasons
+    row["rejection_reasons"] = reasons
+    return row
+
