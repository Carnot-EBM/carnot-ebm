+def _attach_native_tokenizers(
+    model_rows: list[JsonDict], exp6850: Mapping[str, Any]
+) -> tuple[dict[str, NativeGgufTokenizer], list[JsonDict]]:  # pragma: no cover
+    """Load vocabulary-only tokenizers and attach stable receipts."""
+
+    expected_receipts = {
+        str(row.get("hf_id")): row
+        for row in exp6850.get("tokenizer_receipts", [])
+        if isinstance(row, Mapping)
+    }
+    tokenizers: dict[str, NativeGgufTokenizer] = {}
+    failures: list[JsonDict] = []
+    for model in model_rows:
+        hf_id = str(model["hf_id"])
+        try:
+            tokenizer = NativeGgufTokenizer(str(model["model_path"]))
+        except Exception as exc:
+            model["tokenizer_receipt"] = {
+                "source": "embedded_gguf_llama_cpp_vocab_only",
+                "metadata_present": False,
+                "loadable": False,
+                "tokenizer_sha256": "",
+                "error": f"{type(exc).__name__}: {exc}",
+            }
+            failures.append(
+                _gate_check(f"model.{hf_id}.native_tokenizer", True, model["tokenizer_receipt"], False)
+            )
+            continue
+        model["tokenizer_receipt"] = deepcopy(tokenizer.receipt)
+        expected_hash = str(expected_receipts.get(hf_id, {}).get("tokenizer_sha256") or "")
+        model["frozen_model_receipt"]["tokenizer_sha256"] = expected_hash
+        errors = model_binding_errors(model, model["frozen_model_receipt"])
+        if errors:
+            tokenizer.close()
+            failures.append(_gate_check(f"model.{hf_id}.binding", [], errors, False))
+        else:
+            tokenizers[hf_id] = tokenizer
+    return tokenizers, failures
