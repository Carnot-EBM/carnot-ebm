+def _read_json_bytes(path: Path) -> tuple[JsonDict, bytes]:
+    raw = path.read_bytes()
+    value = json.loads(raw)
+    if not isinstance(value, dict):
+        raise ValueError(f"artifact is not an object: {path}")
+    return value, raw
