+        str(row["hf_id"]): {
+            "path": row["model_path"],
+            "sha256": row["model_sha256"],
+            "size_bytes": row["model_size_bytes"],
+        }
+        for row in model_rows
+    }
+    if any(row["passed"] is not True for row in checks):
+        artifact["preconditions_checked"] = {"checks": checks, "passed": False}
+        artifact["gate_check_summary"] = _gate_summary(checks)
+        artifact["duration_s"] = round(time.monotonic() - started, 6)
+        return _finish_artifact(artifact)
+
+    tokenizers, tokenizer_failures = _attach_native_tokenizers(model_rows, exp6850)
+    checks.extend(tokenizer_failures)
+    checks.append(
+        _gate_check(
+            "all_three_native_tokenizers",
+            list(MODEL_SPECS),
+            sorted(tokenizers),
