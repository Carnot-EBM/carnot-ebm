+    )
+    artifact["model_specs"] = deepcopy(model_rows)
+    artifact["tokenizer_receipts"] = [
+        {"hf_id": row["hf_id"], **deepcopy(row["tokenizer_receipt"])} for row in model_rows
+    ]
+    if any(row["passed"] is not True for row in checks):
+        for tokenizer in tokenizers.values():
+            tokenizer.close()
+        artifact["preconditions_checked"] = {"checks": checks, "passed": False}
+        artifact["gate_check_summary"] = _gate_summary(checks)
+        artifact["duration_s"] = round(time.monotonic() - started, 6)
+        return _finish_artifact(artifact)
+
+    rows: list[JsonDict] = []
+    try:
+        for model in model_rows:
+            tokenizer = tokenizers[str(model["hf_id"])]
+            for group in groups:
+                rows.append(_render_group_cell(tokenizer=tokenizer, model=model, group=group))
+            tokenizer.close()
+    finally:
+        for tokenizer in tokenizers.values():
+            if hasattr(tokenizer, "_llm"):
+                tokenizer.close()
+
+    accepted_rows = [row for row in rows if row.get("accepted") is True]
+    rejected_rows = [row for row in rows if row.get("accepted") is not True]
+    split_manifest = freeze_group_splits(semantic_ids, random_seed=RANDOM_SEED)
+    split_by_group = {
+        **{group_id: "calibration" for group_id in split_manifest["calibration_group_ids"]},
+        **{group_id: "held" for group_id in split_manifest["held_group_ids"]},
+    }
+    for row in rows:
+        row["split"] = split_by_group.get(str(row["semantic_group_identity"]), "unassigned")
+    split_failures = split_errors(
+        split_manifest["calibration_group_ids"], split_manifest["held_group_ids"], rows
+    )
+
+    groups_by_identity = {str(group.get("semantic_identity")): group for group in groups}
+    accepted_models_by_group: dict[str, list[str]] = defaultdict(list)
+    for row in accepted_rows:
+        accepted_models_by_group[str(row["semantic_group_identity"])].append(
+            str(row["model_hf_id"])
+        )
+    calibration_manifest: list[JsonDict] = []
+    calibration_labels: dict[str, tuple[bool, bool]] = {}
+    for group_id in split_manifest["calibration_group_ids"]:
+        group = groups_by_identity[group_id]
+        candidates = [row for row in group.get("candidates", []) if isinstance(row, Mapping)]
+        labels = tuple(bool(row.get("expected_label")) for row in candidates[:2])
+        calibration_labels[group_id] = labels  # type: ignore[assignment]
+        calibration_manifest.append(
+            {
+                "semantic_group_identity": group_id,
+                "eligible_models": sorted(accepted_models_by_group[group_id]),
+                "candidate_ids": [row.get("candidate_id") for row in candidates[:2]],
+                "candidate_labels_by_slot": list(labels),
+                "manifest_hash": sha256_json(
+                    {"group": group_id, "models": sorted(accepted_models_by_group[group_id]), "labels": labels}
+                ),
