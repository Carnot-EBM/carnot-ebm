+class HeldLabelAccessError(RuntimeError):
+    """Raised when calibration asks for a sealed held-group label."""
+
+
+class CalibrationLabelLoader:
+    """Expose calibration labels while denying all held-group identities."""
+
+    def __init__(
+        self,
+        calibration_labels: Mapping[str, tuple[bool, bool]],
+        held_group_ids: Iterable[str],
+    ) -> None:
+        self._calibration_labels = dict(calibration_labels)
+        self._held_group_ids = set(held_group_ids)
+        self.held_label_access_count = 0
+        self.held_label_access_attempt_count = 0
+
+    def load(self, semantic_group_identity: str) -> tuple[bool, bool]:
+        """Return calibration labels or reject a held identity before access."""
+
+        if semantic_group_identity in self._held_group_ids:
+            self.held_label_access_attempt_count += 1
+            raise HeldLabelAccessError(f"held label access denied: {semantic_group_identity}")
+        return self._calibration_labels[semantic_group_identity]
+
+
+def canonical_json(value: Any) -> str:
+    """Encode stable compact JSON for every content hash and sequence."""
+
+    return json.dumps(value, ensure_ascii=True, separators=(",", ":"), sort_keys=True)
+
+
+def sha256_text(value: str) -> str:
+    """Return one prefixed SHA-256 digest for text."""
+
+    return "sha256:" + hashlib.sha256(value.encode("utf-8")).hexdigest()
+
+
+def sha256_bytes(value: bytes) -> str:
+    """Return one prefixed SHA-256 digest for bytes."""
+
+    return "sha256:" + hashlib.sha256(value).hexdigest()
+
+
+def sha256_json(value: Any) -> str:
+    """Hash canonical JSON content."""
+
+    return sha256_text(canonical_json(value))
+
+
+def sha256_file(path: str | Path) -> str:  # pragma: no cover - live file size is large.
+    """Hash a model file in bounded chunks without loading it into memory."""
+
+    digest = hashlib.sha256()
+    with Path(path).open("rb") as handle:
+        for chunk in iter(lambda: handle.read(8 * 1024 * 1024), b""):
+            digest.update(chunk)
+    return "sha256:" + digest.hexdigest()
+
+
+def cell_identity(model_hf_id: str, semantic_group_identity: str) -> str:
+    """Bind one new cell to its exact model and semantic group."""
+
+    return sha256_json(
+        {"model_hf_id": model_hf_id, "semantic_group_identity": semantic_group_identity}
+    )
+
+
+def _json_safe(value: Any) -> Any:
+    """Convert native metadata values into stable JSON-compatible values."""
+
+    if value is None or isinstance(value, (bool, int, float, str)):
+        return value
+    if isinstance(value, bytes):
+        return value.decode("utf-8", "replace")
+    if isinstance(value, Mapping):
+        return {str(key): _json_safe(item) for key, item in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_json_safe(item) for item in value]
+    return str(value)
+
+
+def tokenizer_receipt_from_metadata(
+    *,
+    metadata: Mapping[str, Any],
+    probe_token_ids: Sequence[int],
+    special_tokens: Mapping[str, Any],
+    chat_template: str,
+) -> JsonDict:
+    """Build the stable receipt used by tests and the native live path."""
+
+    tokenizer_metadata = {
+        str(key): _json_safe(value)
+        for key, value in metadata.items()
+        if "tokenizer" in str(key).lower()
+    }
+    token_ids = [int(token) for token in probe_token_ids]
+    metadata_present = bool(tokenizer_metadata)
+    loadable = metadata_present and bool(token_ids)
+    return {
+        "source": "embedded_gguf_llama_cpp_vocab_only",
+        "metadata_present": metadata_present,
+        "loadable": loadable,
+        "metadata_key_count": len(tokenizer_metadata),
+        "probe_token_ids": token_ids,
+        "probe_tokenize_settings": {"add_bos": True, "special": False},
+        "special_tokens": _json_safe(dict(special_tokens)),
+        "chat_template_identity": sha256_text(chat_template),
+        "chat_template_present": bool(chat_template),
+        "tokenizer_sha256": (
+            sha256_text(
+                canonical_json({"metadata": tokenizer_metadata, "probe_token_ids": token_ids})
+            )
+            if loadable
+            else ""
+        ),
+    }
+
+
+def model_binding_errors(
+    resolved: Mapping[str, Any], frozen: Mapping[str, Any]
+) -> list[str]:
+    """Name cache, hash, and embedded-tokenizer failures without substitution."""
+
+    errors: list[str] = []
+    if resolved.get("cached_sota_pair_called") is not True:
+        errors.append("cached_sota_pair_not_called")
+    if resolved.get("local_model_present") is not True:
+        errors.append("model_file_missing")
+    if str(resolved.get("model_path") or "") != str(frozen.get("path") or ""):
+        errors.append("cache_substitution")
+    if str(resolved.get("model_sha256") or "") != str(frozen.get("sha256") or ""):
+        errors.append("model_hash_drift")
+    tokenizer = resolved.get("tokenizer_receipt")
+    tokenizer = tokenizer if isinstance(tokenizer, Mapping) else {}
+    if tokenizer.get("metadata_present") is not True or tokenizer.get("loadable") is not True:
+        errors.append("tokenizer_metadata_missing")
+    frozen_tokenizer_hash = str(frozen.get("tokenizer_sha256") or "")
+    if frozen_tokenizer_hash and tokenizer.get("tokenizer_sha256") != frozen_tokenizer_hash:
+        errors.append("tokenizer_hash_drift")
+    return errors
+
+
+def preexisting_score_identities(
+    prior_artifact_bytes: Iterable[bytes], identities: Iterable[str]
+) -> list[str]:
+    """Find a new cell identity already present in any prior score artifact."""
+
+    corpus = b"\n".join(prior_artifact_bytes)
+    return sorted(identity for identity in set(identities) if identity.encode("utf-8") in corpus)
+
+
+def cell_nuisance_errors(cell: Mapping[str, Any]) -> list[str]:
+    """Apply the exact token, character, prompt, and label-position contract."""
+
+    errors: list[str] = []
+    token_counts = cell.get("candidate_token_counts")
+    token_counts = token_counts if isinstance(token_counts, Mapping) else {}
+    if token_counts.get("slot_0") != token_counts.get("slot_1"):
+        errors.append("unequal_candidate_token_counts")
+    character_counts = cell.get("candidate_character_counts")
+    character_counts = character_counts if isinstance(character_counts, Mapping) else {}
+    if character_counts.get("slot_0") != character_counts.get("slot_1"):
+        errors.append("unequal_candidate_character_counts")
+    prompt_counts = cell.get("paired_prompt_token_counts")
+    prompt_counts = prompt_counts if isinstance(prompt_counts, Mapping) else {}
+    if prompt_counts.get("base") != prompt_counts.get("label_swap"):
+        errors.append("paired_prompt_length_mismatch")
+    label_positions = cell.get("label_position_contract")
+    label_positions = label_positions if isinstance(label_positions, Mapping) else {}
+    if label_positions.get("base") != [0, 1] or label_positions.get("swapped") != [1, 0]:
+        errors.append("label_position_contract_failed")
+    return errors
+
+
+def freeze_group_splits(
+    semantic_group_ids: Iterable[str], *, random_seed: int
+) -> JsonDict:
+    """Assign each semantic identity once with a stable seeded hash order."""
+
+    unique = sorted(set(semantic_group_ids))
+    ordered = sorted(unique, key=lambda group_id: sha256_json([random_seed, group_id]))
+    midpoint = len(ordered) // 2
+    calibration = sorted(ordered[:midpoint])
+    held = sorted(ordered[midpoint:])
+    return {
+        "random_seed": int(random_seed),
+        "assignment_unit": "semantic_group_identity",
+        "calibration_group_ids": calibration,
+        "held_group_ids": held,
+        "calibration_group_hash": sha256_json(calibration),
+        "held_group_hash": sha256_json(held),
+    }
+
+
+def split_errors(
+    calibration_group_ids: Iterable[str],
+    held_group_ids: Iterable[str],
+    rows: Iterable[Mapping[str, Any]],
+) -> list[str]:
+    """Detect direct overlap and any row-level split leakage."""
+
+    calibration = set(calibration_group_ids)
+    held = set(held_group_ids)
+    errors = [f"split_overlap:{group_id}" for group_id in sorted(calibration & held)]
+    observed: dict[str, set[str]] = defaultdict(set)
+    for row in rows:
+        observed[str(row.get("semantic_group_identity"))].add(str(row.get("split")))
+    errors.extend(
+        f"group_leakage:{group_id}"
+        for group_id, splits in sorted(observed.items())
+        if len(splits) > 1
+    )
+    return errors
+
+
+def seal_held_groups(groups: Iterable[Mapping[str, Any]]) -> list[JsonDict]:
+    """Replace held labels with commitments over exact candidate identities."""
+
+    sealed: list[JsonDict] = []
+    for group in groups:
+        candidates = group.get("candidates")
+        candidates = candidates if isinstance(candidates, list) else []
+        label_payload = [
+            {
+                "candidate_id": candidate.get("candidate_id"),
+                "expected_label": candidate.get("expected_label"),
+            }
+            for candidate in candidates
+            if isinstance(candidate, Mapping)
+        ]
+        sealed.append(
+            {
+                "semantic_group_identity": group.get("semantic_identity"),
+                "candidate_ids": [row["candidate_id"] for row in label_payload],
+                "label_commitment": sha256_json(label_payload),
+                "label_schema": "two_boolean_labels_sealed_no_plaintext",
+            }
+        )
+    return sealed
+
+
+def readiness_score(
+    sample_size_power_rows: Iterable[Mapping[str, Any]], *, all_other_checks_pass: bool
+) -> int:
+    """Return design readiness only when every declared sample floor passes."""
+
+    rows = list(sample_size_power_rows)
+    floors_pass = bool(rows) and all(
+        int(row.get("accepted_group_count", -1)) >= int(row.get("minimum_group_count", 0))
+        for row in rows
+    )
+    return int(all_other_checks_pass and floors_pass)
+
