+
+REQUIRED_FIELDS = tuple(FIELD_PRINCIPLES) + (
+    "field_principles",
+    "rotation_selection",
+    "approach_recommendation",
+    "attempted_games",
+    "dead_ends",
+    "registry_update",
+    "retire_if_same_verdict",
