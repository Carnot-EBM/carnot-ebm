+
+def _walk(value: Any) -> list[Any]:
+    if isinstance(value, dict):
+        return list(value.keys()) + [item for sub in value.values() for item in _walk(sub)]
+    if isinstance(value, list):
+        return [item for sub in value for item in _walk(sub)]
+    return [value]
