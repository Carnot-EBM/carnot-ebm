+    payload["reproducibility_checksum"] = ""
+    return "sha256:" + hashlib.sha256(_stable_json(payload).encode("utf-8")).hexdigest()
+
+
+def _tail(text: str, limit: int = 2000) -> str:
+    return text[-limit:] if len(text) > limit else text
