+    monkeypatch.setattr(mod, "run_summarizer", lambda _path: _summary())
+    monkeypatch.setattr(mod, "run_adversarial_verify", lambda _path: _adv())
+    monkeypatch.setattr(mod, "run_arc_orphan_solver_lint", lambda _root: _lint())
