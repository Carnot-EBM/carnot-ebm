+def test_req_arc_wmte_4908_build_schema_write_and_run_paths(
+    tmp_path: Path, monkeypatch: Any
+) -> None:
+    """REQ-ARC-WMTE-4908: artifacts are checksum-stable and blocked preconditions exit."""
