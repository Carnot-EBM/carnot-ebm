+    assert resolved[0]["blocked_preconditions"] == ["model_file_missing"]
+    assert resolved[1]["status"] == "blocked_metadata_unreadable"
+    with pytest.raises(ValueError, match="truncated GGUF"):
+        mod.read_gguf_header(truncated_path)
