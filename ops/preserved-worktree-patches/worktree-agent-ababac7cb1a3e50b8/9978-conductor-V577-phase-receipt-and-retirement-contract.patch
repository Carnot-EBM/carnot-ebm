+    bad = deepcopy(roadmap["tasks"])
+    bad[1]["prior_failures"][0]["verdict"] = "null"
+    _, bad_errors = mod.reconcile_prior_failures(REPO, bad)
+    assert any(error["check"] == "prior_failure_verdict" for error in bad_errors)
