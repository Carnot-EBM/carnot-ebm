+def _attack_fixture_roadmap() -> JsonDict:
+    owner_fields = {
+        gate["upstream"]: gate["artifact_field"]
+        for gates in EXPECTED_GATES.values()
+        for gate in gates
+    }
+    tasks = []
+    for task_id, expected in EXPECTED_TASKS.items():
