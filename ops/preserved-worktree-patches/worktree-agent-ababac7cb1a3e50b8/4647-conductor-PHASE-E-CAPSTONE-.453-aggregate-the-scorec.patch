+            "deliverable": (
+                "current ~0.05 first-win agent (operator-only package) + publishable "
+                "FoVer verifier-ensemble paper"
+            ),
+            "paper_ready": True,
+            "north_star_sections": ["1", "2"],
+            "do_not_queue": "representation_5",
+            "distributional_energy_verifier_scaffold": d_lane,
