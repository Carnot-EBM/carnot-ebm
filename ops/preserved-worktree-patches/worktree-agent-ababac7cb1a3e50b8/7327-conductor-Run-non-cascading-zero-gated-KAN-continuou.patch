+    "-q --no-cov -n 0 && .venv/bin/coverage report "
+    "--include=python/carnot/experiment_5735_zero_gate_kan_continuous_self_learning.py "
+    "--fail-under=100"
+)
+FULL_TEST_COMMAND = ".venv/bin/pytest tests/python -q"
