+def _retro_timing_fallback_wiring(path: Path) -> JsonDict:
+    base: JsonDict = {"path": str(CONDUCTOR_RELATIVE_PATH), "exists": path.exists(), "import_present": False, "call_present": False}
+    if not path.exists():
