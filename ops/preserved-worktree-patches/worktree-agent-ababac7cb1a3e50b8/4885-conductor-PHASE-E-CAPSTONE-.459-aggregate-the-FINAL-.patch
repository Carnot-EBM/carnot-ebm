+def _rate_slug(heldout: Mapping[str, Any]) -> str:
+    rate = heldout.get("rate")
+    if isinstance(rate, (int, float)) and not isinstance(rate, bool):
+        text = f"{float(rate):.6f}".rstrip("0").rstrip(".")
+        return text or "0"
+    return "unknown"
