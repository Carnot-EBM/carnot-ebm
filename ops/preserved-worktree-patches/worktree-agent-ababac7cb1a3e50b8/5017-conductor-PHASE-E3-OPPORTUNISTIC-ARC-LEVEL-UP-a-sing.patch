+LEVELUP_CANDIDATES = (
+    ("sc25", "l5_to_l6", 5),
+    ("lp85", "l5_to_l6", 5),
+    ("cn04", "l3_to_l4", 3),
+)
+RECENT_ROTATION_TARGETS = (
+    "tn36",
