+
+def _preconditions(adapter_registered: bool = True) -> dict[str, object]:
+    return {
+        "AGENTS.md": True,
+        "CODEX.md": True,
+        "arc_world_model_trust_energy_spec_has_req_5026": True,
+        "registry_present": True,
