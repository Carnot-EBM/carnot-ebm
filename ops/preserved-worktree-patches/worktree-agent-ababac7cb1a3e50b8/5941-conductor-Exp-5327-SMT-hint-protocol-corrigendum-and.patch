+    ),
+    "exp5318_flag_reason": (
+        "Explains why Exp5318 was quarantined so downstream work does not inherit "
+        "the substrate/timing confusion."
+    ),
+    "valid_hint_acceptance_rate": (
+        "Bare numeric fraction of solver-validated sound hints accepted by the "
