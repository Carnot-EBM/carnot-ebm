+        "heldout_first_win_rate",
+        "first_win_baseline",
+        "prior_best_heldout_first_win_rate",
+        "heldout_first_win_delta_vs_baseline",
+        "heldout_first_win_delta_vs_prior_best",
+        "heldout_variant_attempts",
+        "positive_control_passed",
+        "parity_test_green",
+        "checkpoint_emitted",
+        "live_agent_ran",
+        "solve_provenance",
+        "inference_substrate",
+    ),
+    "B1_AUDIT": (
+        "honest_verdict",
+        "a1_genuinely_diagnostic",
+        "proposer_blind_confirmed",
+        "positive_control_confirmed",
+        "buckets_match_claim",
+        "live_path_reachable_confirmed",
+        "solve_provenance_confirmed",
+        "source_dominant_bucket",
+        "non_diagnostic_reasons",
+        "checks",
+        "inference_substrate",
