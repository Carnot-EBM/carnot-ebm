From d9b5945a5507eae2e328ce4f3d3e4a5179d75851 Mon Sep 17 00:00:00 2001
From: Ian Blenke <ian@blenke.com>
Date: Thu, 18 Jun 2026 02:41:36 -0400
Subject: [PATCH 02484/11362] [outer-loop] induction arm: isolate E3 proposer
 on port 8920 (fix silent port-collision)

Self-heal: my earlier "Qwen3.6-35B" induction test silently ran gemma-12B because LocalGGUFProposer
hardcodes port 8919 and REUSES any server already there WITHOUT checking the model -- a stale 4.5h
gemma-12B server (leaked from my prior E3 run) occupied 8919, so the Qwen proposer attached to it.
Killed the leaked server (port freed, conductor untouched) and pinned this eval's proposer to port
8920 so it (a) never collides with the conductor's E3 (8919) and (b) actually loads the requested
model. Re-launching the Qwen-35B vs gemma-12B induction test cleanly.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 scripts/arc_leaderboard_eval.py | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/scripts/arc_leaderboard_eval.py b/scripts/arc_leaderboard_eval.py
index fb3588e858..d7d6d93413 100644
--- a/scripts/arc_leaderboard_eval.py
+++ b/scripts/arc_leaderboard_eval.py
@@ -61,7 +61,11 @@ def _build_policy(kind: str, game: str):
         global _PROPOSER
         if _PROPOSER_REPO and _PROPOSER is None:
             from carnot.agentic.arc_executable_world_model import LocalGGUFProposer
-            _PROPOSER = LocalGGUFProposer(repo_substr=_PROPOSER_REPO)
+            # port 8920 (NOT the conductor's E3 default 8919): LocalGGUFProposer reuses any server on its
+            # port WITHOUT a model check, so a shared port silently runs the wrong model (a stale gemma
+            # server made an earlier "Qwen" run actually use gemma-12B). A distinct port isolates this
+            # test from the conductor's E3 work and guarantees the requested model loads.
+            _PROPOSER = LocalGGUFProposer(repo_substr=_PROPOSER_REPO, port=8920)
         return E3AgentPolicy(game, proposer=_PROPOSER)
     if kind in ("explorer_vh", "explorer_bf"):              # BRIDGE: value-head-routed explorer
         global _VALUE_HEAD
