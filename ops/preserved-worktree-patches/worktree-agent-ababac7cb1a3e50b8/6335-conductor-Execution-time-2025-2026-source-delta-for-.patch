+def test_blocked_artifact_consistency_checks_fail_closed() -> None:
+    """REQ-REPORT-5455: blocked artifacts cannot carry contradictory planner facts."""
+
+    artifact = mod.build_artifact(prior_refresh_marker_found=False)
