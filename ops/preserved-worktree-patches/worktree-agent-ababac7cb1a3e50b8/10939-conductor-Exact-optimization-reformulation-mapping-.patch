+def test_req_verify_6955_fresh_process_and_writable_failures_are_terminal(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """REQ-VERIFY-6955 exposes child-process and checkpoint-write failures."""
+
