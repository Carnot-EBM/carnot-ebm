+_VARIABLE_KEYS = {"name", "kind", "universe", "domain"}
+_DOMAIN_KEYS = {"lower", "upper"}
+_CONSTRAINT_KEYS = {"terms", "op", "rhs"}
+_OBJECTIVE_KEYS = {"direction", "expression"}
