+        "headroom_recovered": 4,
+        "vote_wins_lost": 0,
+    }
+    assert replay["arc2_rule_exec"] == {
+        "n": 31,
+        "vote_pass2": pytest.approx(0.0645),
+        "gated_pass2": pytest.approx(0.0645),
+        "headroom_recovered": 0,
+        "vote_wins_lost": 0,
+    }
+    assert replay["arc2_registered_chain"] == {
+        "gold": 19,
+        "n": 31,
+        "pass_at_1": pytest.approx(0.6129),
+    }
