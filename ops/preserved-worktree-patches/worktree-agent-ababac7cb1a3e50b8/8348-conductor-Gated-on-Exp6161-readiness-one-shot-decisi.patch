+def _file_receipt(path: Path) -> JsonDict:
+    return {
+        "path": path.as_posix(),
+        "exists": path.exists(),
+        "sha256": sha256_file(path) if path.exists() else None,
+        "size_bytes": path.stat().st_size if path.exists() else 0,
+    }
+
