+def _status_from_log(line: str | None) -> str:
+    if line is None:
+        return "MISSING"
+    for status in ("GATE_BLOCK", "FLAGGED", "FAIL", "OK", "SKIP"):
+        if f"| {status} |" in line:
+            return status
+    return "LOGGED"
