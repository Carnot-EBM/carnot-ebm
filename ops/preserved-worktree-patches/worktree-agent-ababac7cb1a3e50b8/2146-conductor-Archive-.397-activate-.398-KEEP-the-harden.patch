+        "arc_game_advanced": str(arc.get("game_advanced", "r11l-495a7899")),
+        "registry_honest_verdict": str(registry.get("honest_verdict", "")),
+        "capstone_hygiene_blocked_spuriously": str(registry.get("honest_verdict", "")).startswith(
+            "blocked_v397"
