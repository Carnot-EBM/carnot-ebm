+CachedPairProvider = Callable[..., list[JsonDict] | None]
+IndividualResolver = Callable[[str], str | None]
+EnvironmentProbe = Callable[[Path], JsonDict]
+TokenizerChecker = Callable[[str | None], tuple[bool, str]]
