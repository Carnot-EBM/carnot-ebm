+    random_seed: int = RANDOM_SEED
+    max_rows_per_model_family_error: int | None = ELIGIBLE_ROWS_PER_MODEL_FAMILY_ERROR
+
+    def start_time(self) -> float:
+        return self.clock() if self.started_at is None else self.started_at
