+            "capped per model/family/error cell"
+        ),
+        "per_model_family_error_cap": config.max_rows_per_model_family_error,
+        "error_taxonomy": ["parser", "type", "compile", "solver", "certificate", "semantic"],
+        "eligible_cells": sorted(
+            {
+                "::".join(
