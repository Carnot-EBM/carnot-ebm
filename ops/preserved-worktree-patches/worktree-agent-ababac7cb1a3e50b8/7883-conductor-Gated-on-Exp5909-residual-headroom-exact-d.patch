+@dataclass(frozen=True)
+class ExperimentConfig:
+    """Runtime paths, clocks, and the preregistered eligibility cap for Exp5910."""
+
+    repo_root: Path = REPO_ROOT
+    output_path: Path | None = None
+    raw_trace_path: Path | None = None
