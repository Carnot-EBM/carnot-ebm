+def test_scenario_6837_token_alignment_rejects_unequal_candidate_lengths(
+    tmp_path: Path,
+) -> None:
+    """SCENARIO-CONSTRAINT-6837-TOKEN-ALIGNMENT forbids unequal-token margins."""
