+def test_req_constraint_6837_main_cli_dispatches_run(
+    monkeypatch: pytest.MonkeyPatch,
+    tmp_path: Path,
+    capsys: pytest.CaptureFixture[str],
+) -> None:
+    """REQ-CONSTRAINT-6837 exposes the requested script entrypoint."""
+
+    calls: list[dict[str, Any]] = []
