+def _grid_hash(grid: Any) -> str:
+    if grid is None:
+        return ""
+    raw = json.dumps(grid, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
+    return hashlib.sha256(raw.encode("utf-8")).hexdigest()
+
