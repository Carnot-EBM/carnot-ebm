+def _read_json_object(path: Path) -> dict[str, Any]:
+    try:
+        payload = json.loads(path.read_text(encoding="utf-8"))
+    except Exception as exc:
+        raise BlockedRun(BLOCKED_UPSTREAM_VERDICT) from exc
+    if not isinstance(payload, dict):
