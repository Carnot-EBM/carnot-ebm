+import numpy as np
+
+def _find_obj(g):
+    # 12 block is top 2 rows of the 5x5 object; extend down 3 rows for the 9 part
+    ys, xs = np.where(g == 12)
+    if len(ys) == 0:
+        return None
+    y0, y1 = int(ys.min()), int(ys.max())
+    x0, x1 = int(xs.min()), int(xs.max())
+    if (y1 - y0 + 1) != 2 or (x1 - x0 + 1) != 5:
+        return None
+    # full object: rows y0..y0+4, cols x0..x1
+    fy1 = y0 + 4
+    if fy1 >= g.shape[0]:
+        return None
+    return (y0, x0, fy1, x1)
