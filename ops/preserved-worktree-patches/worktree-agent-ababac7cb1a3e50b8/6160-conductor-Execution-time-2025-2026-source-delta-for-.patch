+    assert artifact["new_references_added"][0]["url"] == "https://arxiv.org/abs/2607.05936"
+    assert "OpenAPI-to-regex" in artifact["new_references_added"][0]["carnot_hook"]
+    assert artifact["new_references_added"][1]["url"] == "https://arxiv.org/abs/2607.04569"
+    assert "MILP-oracle scheduling fixture" in artifact["new_references_added"][1]["carnot_hook"]
+    assert artifact["new_references_added"][2]["url"] == "https://arxiv.org/abs/2607.05169"
+    assert "subproblem-size controls" in artifact["new_references_added"][2]["carnot_hook"]
+    assert artifact["new_references_added"][4]["url"] == "https://arxiv.org/abs/2607.05448"
+    assert "active-tail/frozen-variable diagnostic" in artifact["new_references_added"][4]["carnot_hook"]
+    assert artifact["new_references_added"][5]["url"] == "https://arxiv.org/abs/2607.04528"
+    assert "belief-rollout" in artifact["new_references_added"][5]["carnot_hook"]
+
+    watch_text = " ".join(row["reason"] for row in artifact["watch_only_or_excluded"])
+    assert "weight-mutation" in watch_text
+    assert "external code-agent proof claims" in watch_text
+    assert "retired external generated-text scorer" in watch_text
+
