+def run_gap4_regression_guard(repo_root: Path = REPO_ROOT) -> dict[str, Any]:
+    """REQ-VERIFY-4277: compare cached replay with .394 recorded GAP-4 numbers."""
+    prior = base._load_json(repo_root / EXP4266_PATH)
