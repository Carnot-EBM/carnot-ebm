+    summaries: JsonDict = {}
+    for task_id, artifact in V552_DELIVERABLES_BY_TASK.items():
+        rel = Path(artifact)
+        summaries[task_id] = _summarize_artifact(root, rel)
+        payload, meta = read_json_mapping(root / rel)
