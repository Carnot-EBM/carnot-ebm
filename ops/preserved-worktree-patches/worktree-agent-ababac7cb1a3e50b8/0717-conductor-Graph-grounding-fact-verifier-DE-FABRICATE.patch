+            relations=(mod.RelationTriple("two FBI agents", "injured_during", "chase"),),
+        ),
+        prompt_sha256="p3",
+        completion_tokens=11,
+    )
+    return [grounded_1, grounded_2, ungrounded_1, ungrounded_2]
