+    assert artifact["random_seed"] == 3765
+    assert artifact["duration_s"] == 0.25
+    assert artifact["reproducibility_checksum"] == exp3765.payload_checksum(artifact)
+    encoded = json.dumps(artifact, sort_keys=True)
