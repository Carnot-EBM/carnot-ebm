+
+    assert exp4813.main(["--game", "re86", "--checkpoint-mtime-before-ns", str(before_ns)]) == 0
+
+    written = json.loads((tmp_path / exp4813.RESULT_RELATIVE_PATH).read_text(encoding="utf-8"))
+    assert written["experiment"] == exp4813.EXPERIMENT
+    assert written["honest_verdict"] == "success_re86_L2_checkpoint_refreshed"
+    assert written["search_state_count"] == 113
+    assert written["schema_errors"] == []
+
+
+def test_req_arc_wmte_4813_main_writes_blocked_artifact(tmp_path: Path, monkeypatch) -> None:
+    """SCENARIO-ARC-WMTE-4813-BLOCKED-PRECONDITION: main writes blocked artifacts."""
+
+    monkeypatch.setattr(exp4813, "ARTIFACT", tmp_path / exp4813.RESULT_RELATIVE_PATH)
+    monkeypatch.setattr(
+        exp4813,
+        "check_preconditions",
+        lambda game=None: {
+            "ok": False,
+            "offline_arcade": {"ok": True},
