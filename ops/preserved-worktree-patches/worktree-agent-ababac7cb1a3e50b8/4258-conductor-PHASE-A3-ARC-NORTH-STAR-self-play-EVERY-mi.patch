+++ b/tests/python/test_experiment_4813_self_play_verifier_checkpoint.py
@@ -0,0 +1,353 @@
+"""Tests for Exp 4813 ARC self-play verifier checkpoint refresh.
+
+Spec refs: REQ-ARC-WMTE-4813,
+SCENARIO-ARC-WMTE-4813-CHECKPOINT-REFRESHED,
+SCENARIO-ARC-WMTE-4813-RESIDUAL-NO-FABRICATION,
+SCENARIO-ARC-WMTE-4813-BLOCKED-PRECONDITION.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from carnot import experiment_4803_self_play_verifier_checkpoint as exp4803
+from carnot import experiment_4813_self_play_verifier_checkpoint as exp4813
+
+
+REPO = Path(__file__).resolve().parents[2]
+SPEC_PATH = REPO / "openspec" / "capabilities" / "arc-world-model-trust-energy" / "spec.md"
+
+
+def _loop_result(game: str, reached_level: int = 2, reproduced: bool = True) -> dict[str, object]:
+    return {
+        "game": game,
+        "reached_level": reached_level,
+        "offline_reproduced": reproduced,
+        "reproduced_levels": reached_level if reproduced else 0,
+        "states_expanded": 113,
+        "learned_verifier_checkpoint": f"models/arc_verifier_{game}.json",
+        "solve_provenance": "development_proxy",
+        "reproduction_gate": {
+            "game": game,
+            "claimed_level": reached_level,
+            "reached_level": reached_level,
+            "reproduced": reproduced,
+        },
+    }
+
+
+def _success_artifact(tmp_path: Path, monkeypatch) -> dict[str, object]:
+    ckpt = tmp_path / "models" / "arc_verifier_re86.json"
+    ckpt.parent.mkdir()
+    ckpt.write_text('{"ok": true}\n', encoding="utf-8")
+    before_ns = ckpt.stat().st_mtime_ns - 1
+    monkeypatch.setattr(exp4813, "REPO", tmp_path)
+
+    summary = exp4813.summarize_loop_result(
+        game="re86",
+        loop_result=_loop_result("re86"),
+        loop_result_path="results/arc_loop_solve_re86.json",
+        checkpoint_mtime_before_ns=before_ns,
+    )
+    return exp4813.build_artifact(
+        target_selection={
+            "game": "re86",
+            "prior_level": 2,
+            "banked": True,
+            "reason": "preferred_banked_target",
+        },
+        loop_summary=summary,
+        preconditions_checked={
+            "offline_arcade": {"ok": True},
+            "registry_loadable": {"ok": True},
+            "target_banked": {"ok": True, "game": "re86"},
+        },
+    )
+
+
+def test_req_arc_wmte_4813_spec_declares_contract() -> None:
+    """REQ-ARC-WMTE-4813: OpenSpec declares the 4813 artifact contract."""
+
+    spec = SPEC_PATH.read_text(encoding="utf-8")
+
+    for ref in exp4813.SPEC_REFS:
+        assert ref in spec
+    assert exp4813.RESULT_RELATIVE_PATH in spec
+    assert "checkpoint_mtime_delta_ns" in spec
+    assert "search_state_count" in spec
+    for field, principle in exp4813.FIELD_PRINCIPLES.items():
+        assert field in spec
+        assert principle in spec
+
+
+def test_scenario_arc_wmte_4813_checkpoint_refreshed_success(tmp_path: Path, monkeypatch) -> None:
+    """SCENARIO-ARC-WMTE-4813-CHECKPOINT-REFRESHED: mtime advance plus gate green succeeds."""
+
+    artifact = _success_artifact(tmp_path, monkeypatch)
+
+    assert artifact["experiment"] == exp4813.EXPERIMENT
+    assert artifact["schema"] == exp4813.SCHEMA
+    assert artifact["spec_refs"] == exp4813.SPEC_REFS
+    assert artifact["random_seed"] == exp4813.RANDOM_SEED
+    assert artifact["honest_verdict"] == "success_re86_L2_checkpoint_refreshed"
+    assert artifact["verifier_checkpoint_refreshed"] is True
+    assert artifact["inference_substrate"] == "live_llm_inference"
+    assert artifact["solve_provenance"] == "live_agent_self_discovery"
+    assert artifact["offline_reproduced"] is True
+    assert artifact["reproduced_levels"] == 2
+    assert artifact["states_expanded"] == 113
+    assert artifact["search_state_count"] == 113
+    assert artifact["self_play_residual"] == "checkpoint_refreshed_gate_passed"
+    assert int(artifact["checkpoint_mtime_after_ns"]) > int(artifact["checkpoint_mtime_before_ns"])
+    assert artifact["checkpoint_mtime_delta_ns"] > 0
+    assert artifact["schema_errors"] == []
+    assert exp4813.artifact_schema_errors(artifact) == []
+
+
+def test_scenario_arc_wmte_4813_residual_does_not_fabricate_checkpoint(
+    tmp_path: Path, monkeypatch
+) -> None:
+    """SCENARIO-ARC-WMTE-4813-RESIDUAL-NO-FABRICATION: failed gates stay residuals."""
+
+    monkeypatch.setattr(exp4813, "REPO", tmp_path)
+    failed = _loop_result("re86", reached_level=0, reproduced=False)
+    failed["learned_verifier_checkpoint"] = None
+
+    summary = exp4813.summarize_loop_result(
+        game="re86",
+        loop_result=failed,
+        loop_result_path="results/arc_loop_solve_re86.json",
+        checkpoint_mtime_before_ns=123,
+    )
+    artifact = exp4813.build_artifact(
+        target_selection={
+            "game": "re86",
+            "prior_level": 2,
+            "banked": True,
+            "reason": "preferred_banked_target",
+        },
+        loop_summary=summary,
+        preconditions_checked={"offline_arcade": {"ok": True}, "registry_loadable": {"ok": True}},
+    )
+
+    assert artifact["honest_verdict"] == "complete_re86_self_play_residual_reproduction_gate_failed"
+    assert artifact["verifier_checkpoint_refreshed"] is False
+    assert artifact["checkpoint_path"] is None
+    assert artifact["checkpoint_mtime_after_ns"] is None
+    assert artifact["checkpoint_mtime_delta_ns"] is None
+    assert artifact["search_state_count"] == 113
+    assert artifact["schema_errors"] == []
+
+
+def test_scenario_arc_wmte_4813_missing_loop_result_records_residual() -> None:
+    """SCENARIO-ARC-WMTE-4813-RESIDUAL-NO-FABRICATION: absent loop output is explicit."""
+
+    summary = exp4813.summarize_loop_result(
+        game="re86",
+        loop_result=None,
+        loop_result_path="results/arc_loop_solve_re86.json",
+        checkpoint_mtime_before_ns="bad",
+    )
+
+    assert summary["self_play_residual"] == "loop_result_missing"
+    assert summary["checkpoint_mtime_before_ns"] is None
+    assert summary["search_state_count"] == 0
+
+
+def test_scenario_arc_wmte_4813_blocked_precondition_artifact() -> None:
+    """SCENARIO-ARC-WMTE-4813-BLOCKED-PRECONDITION: blocked runs remain auditable."""
+
+    artifact = exp4813.build_blocked_artifact(
+        reason="target_not_banked",
+        preconditions_checked={
+            "offline_arcade": {"ok": True},
+            "registry_loadable": {"ok": True},
+            "target_banked": {"ok": False, "game": "sb26", "prior_level": 0},
+        },
+        target_game="sb26",
+    )
+
+    assert artifact["experiment"] == exp4813.EXPERIMENT
+    assert artifact["honest_verdict"] == "blocked_target_not_banked"
+    assert artifact["target_game"] == "sb26"
+    assert artifact["verifier_checkpoint_refreshed"] is False
+    assert artifact["self_play_residual"] == "target_not_banked"
+    assert artifact["search_state_count"] == 0
+    assert artifact["schema_errors"] == []
+
+
+def test_req_arc_wmte_4813_schema_rejects_stale_4803_metadata(tmp_path: Path, monkeypatch) -> None:
+    """REQ-ARC-WMTE-4813: schema prevents accidental reuse of the 4803 identity."""
+
+    artifact = _success_artifact(tmp_path, monkeypatch)
+
+    stale_experiment = dict(artifact)
+    stale_experiment["experiment"] = exp4803.EXPERIMENT
+    stale_experiment["reproducibility_checksum"] = exp4813.stable_checksum(stale_experiment)
+    assert "experiment_mismatch" in exp4813.artifact_schema_errors(stale_experiment)
+
+    stale_schema = dict(artifact)
+    stale_schema["schema"] = exp4803.SCHEMA
+    stale_schema["reproducibility_checksum"] = exp4813.stable_checksum(stale_schema)
+    assert "schema_mismatch" in exp4813.artifact_schema_errors(stale_schema)
+
+    stale_refs = dict(artifact)
+    stale_refs["spec_refs"] = exp4803.SPEC_REFS
+    stale_refs["reproducibility_checksum"] = exp4813.stable_checksum(stale_refs)
+    assert "spec_refs_mismatch" in exp4813.artifact_schema_errors(stale_refs)
+
+    stale_seed = dict(artifact)
+    stale_seed["random_seed"] = exp4803.RANDOM_SEED
+    stale_seed["reproducibility_checksum"] = exp4813.stable_checksum(stale_seed)
+    assert "random_seed_mismatch" in exp4813.artifact_schema_errors(stale_seed)
+
+
+def test_req_arc_wmte_4813_schema_defensive_branches(tmp_path: Path, monkeypatch) -> None:
+    """REQ-ARC-WMTE-4813: malformed terminal artifacts fail closed."""
+
+    artifact = _success_artifact(tmp_path, monkeypatch)
+
+    cases = [
+        (lambda item: item.update(field_principles={}), "missing_principle:honest_verdict"),
+        (lambda item: item.update(honest_verdict="not_terminal"), "honest_verdict_missing_terminal_prefix"),
+        (lambda item: item.update(inference_substrate="cached"), "inference_substrate_mismatch"),
+        (lambda item: item.update(solve_provenance="development_proxy"), "solve_provenance_mismatch"),
+        (
+            lambda item: item.update(verifier_checkpoint_refreshed="yes"),
+            "verifier_checkpoint_refreshed_must_be_bool",
+        ),
+        (lambda item: item.update(verifier_checkpoint_refreshed=False), "success_without_refreshed_checkpoint"),
+        (lambda item: item.update(offline_reproduced=False), "success_without_reproduction_gate"),
+        (lambda item: item.update(states_expanded=0), "success_without_search_states"),
+        (lambda item: item.update(search_state_count=0), "success_without_search_state_count"),
+        (lambda item: item.update(checkpoint_path=None), "refreshed_checkpoint_missing_path"),
+        (lambda item: item.update(checkpoint_mtime_after_ns=None), "refreshed_checkpoint_missing_mtime"),
+        (
+            lambda item: item.update(checkpoint_mtime_after_ns=item["checkpoint_mtime_before_ns"]),
+            "refreshed_checkpoint_without_mtime_advance",
+        ),
+        (lambda item: item.update(checkpoint_mtime_delta_ns="bad"), "refreshed_checkpoint_missing_mtime_delta"),
+        (lambda item: item.update(checkpoint_mtime_delta_ns=0), "refreshed_checkpoint_nonpositive_mtime_delta"),
+    ]
+    for mutate, expected in cases:
+        malformed = dict(artifact)
+        mutate(malformed)
+        malformed["reproducibility_checksum"] = exp4813.stable_checksum(malformed)
+        assert expected in exp4813.artifact_schema_errors(malformed)
+
+    missing_count = dict(artifact)
+    missing_count.pop("search_state_count")
+    missing_count["reproducibility_checksum"] = exp4813.stable_checksum(missing_count)
+    assert "missing_field:search_state_count" in exp4813.artifact_schema_errors(missing_count)
+
+    invalid_checksum = dict(artifact, reproducibility_checksum="bad")
+    assert "invalid_reproducibility_checksum" in exp4813.artifact_schema_errors(invalid_checksum)
+
+    checksum_mismatch = dict(artifact, target_game="other")
+    assert "checksum_mismatch" in exp4813.artifact_schema_errors(checksum_mismatch)
+
+
+def test_req_arc_wmte_4813_io_helpers_cover_paths(tmp_path: Path, monkeypatch) -> None:
+    """REQ-ARC-WMTE-4813: helper IO paths are deterministic and fail closed."""
+
+    monkeypatch.setattr(exp4813, "REPO", tmp_path)
+    missing = tmp_path / "missing.json"
+    present = tmp_path / "results" / "loop.json"
+    present.parent.mkdir()
+    present.write_text(json.dumps(_loop_result("re86")), encoding="utf-8")
+    list_payload = tmp_path / "results" / "list.json"
+    list_payload.write_text("[]", encoding="utf-8")
+
+    assert exp4813._read_loop_result(missing) is None  # noqa: SLF001
+    assert exp4813._read_loop_result(list_payload) is None  # noqa: SLF001
+    assert exp4813._read_loop_result(present)["game"] == "re86"  # noqa: SLF001
+    assert exp4813._relative_path(present) == "results/loop.json"  # noqa: SLF001
+    assert exp4813._relative_path(Path("/outside.json")) == "/outside.json"  # noqa: SLF001
+    assert exp4813._precondition_failure({"offline_arcade": {"ok": False}}) == "offline_arcade_missing"  # noqa: SLF001
+    assert exp4813._precondition_failure(  # noqa: SLF001
+        {"offline_arcade": {"ok": True}, "registry_loadable": {"ok": False}}
+    ) == "registry_missing"
+    assert exp4813._precondition_failure(  # noqa: SLF001
+        {
+            "offline_arcade": {"ok": True},
+            "registry_loadable": {"ok": True},
+            "target_banked": {"ok": False},
+        }
+    ) == "target_not_banked"
+    assert exp4813._precondition_failure(  # noqa: SLF001
+        {
+            "offline_arcade": {"ok": True},
+            "registry_loadable": {"ok": True},
+            "target_banked": {"ok": True},
+        }
+    ) is None
+
+
+def test_req_arc_wmte_4813_main_writes_terminal_artifact(tmp_path: Path, monkeypatch) -> None:
+    """REQ-ARC-WMTE-4813: main writes the 4813 artifact path from loop output."""
+
+    (tmp_path / "results").mkdir()
+    (tmp_path / "models").mkdir()
+    ckpt = tmp_path / "models" / "arc_verifier_re86.json"
+    ckpt.write_text("{}", encoding="utf-8")
+    before_ns = ckpt.stat().st_mtime_ns - 1
+    loop_path = tmp_path / "results" / "arc_loop_solve_re86.json"
+    loop_path.write_text(json.dumps(_loop_result("re86")), encoding="utf-8")
+
+    monkeypatch.setattr(exp4813, "REPO", tmp_path)
+    monkeypatch.setattr(exp4813, "RESULTS", tmp_path / "results")
+    monkeypatch.setattr(exp4813, "ARTIFACT", tmp_path / exp4813.RESULT_RELATIVE_PATH)
+    monkeypatch.setattr(
+        exp4813,
+        "check_preconditions",
+        lambda game=None: {
+            "ok": True,
+            "offline_arcade": {"ok": True},
+            "registry_loadable": {"ok": True},
