+def _synthetic_rows() -> list[dict[str, Any]]:
+    rows: list[dict[str, Any]] = []
+    changes_by_game = {
+        "lp85": [0, 3, 0, 2],
+        "su15": [0, 1, 0, 4],
+        "tu93": [0, 2, 0, 5],
