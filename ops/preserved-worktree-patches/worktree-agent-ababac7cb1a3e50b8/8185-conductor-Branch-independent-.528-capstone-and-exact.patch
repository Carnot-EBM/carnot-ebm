+
+def _field_provenance() -> dict[str, JsonDict]:
+    sources = [
+        ROADMAP_RELATIVE_PATH.as_posix(),
+        CONDUCTOR_LOG_RELATIVE_PATH.as_posix(),
+        EXCLUSION_MANIFEST_RELATIVE_PATH.as_posix(),
+        RESEARCH_REFERENCES_RELATIVE_PATH.as_posix(),
