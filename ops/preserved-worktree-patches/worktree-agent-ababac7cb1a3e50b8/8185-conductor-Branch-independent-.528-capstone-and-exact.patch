+def _fresh_verifier_receipts(
+    receipts: Mapping[str, JsonMap],
+    terminal: JsonMap,
+) -> JsonDict:
+    rows: list[JsonDict] = []
+    for task_id, task_row in terminal["tasks"].items():
+        if not task_row["present"]:
