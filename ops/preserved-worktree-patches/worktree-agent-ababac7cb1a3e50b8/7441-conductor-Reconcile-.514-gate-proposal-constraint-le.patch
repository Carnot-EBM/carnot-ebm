+        report["task_outcome_matrix"]["exp5760-selective-exact-feedback-search"]["blocked_gate"]
+        is True
+    )
+    assert (
+        report["task_outcome_matrix"]["exp5760-selective-exact-feedback-search"]["negative"]
+        is False
