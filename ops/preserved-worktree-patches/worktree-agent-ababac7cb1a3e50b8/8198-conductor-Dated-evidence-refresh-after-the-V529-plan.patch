+def test_req_report_6101_spec_declares_v529_source_refresh_contract() -> None:
+    """REQ-REPORT-6101: OpenSpec names the V529 source-refresh contract."""
+
+    spec = SPEC_PATH.read_text(encoding="utf-8")
+    section = spec[spec.index("### REQ-REPORT-6101") :]
+    normalized = " ".join(section.split())
+
+    for marker in (
+        "REQ-REPORT-6101",
+        "SCENARIO-REPORT-6101-ZERO-FINDING",
+        "SCENARIO-REPORT-6101-ACCEPT-BOUNDED-DELTA",
+        "SCENARIO-REPORT-6101-SOURCE-UNCERTAINTY",
+        "SCENARIO-REPORT-6101-DUPLICATE-AND-RETIRED-SCOPE",
+        "SCENARIO-REPORT-6101-SCHEMA",
+        str(mod.RESULT_RELATIVE_PATH),
+        mod.PLANNER_MARKER,
+        mod.INFERENCE_SUBSTRATE,
+        "`semantic_scholar_ebt_and_arm_ebm_receipts`",
+        "`openreview_huggingface_github_extropic_and_kona_receipts`",
+    ):
+        assert marker in section
+    for field, principle in mod.REQUIRED_FIELD_PRINCIPLES.items():
+        assert f"`{field}`" in section
+        assert " ".join(principle.split()) in normalized
