+        if str(row.get("source_family")) == "Semantic Scholar"
+    ]
+    ebt = next((row for row in direct if "ebt" in row["receipt_id"]), {})
+    arm = next((row for row in direct if "arm_ebm" in row["receipt_id"]), {})
