+            "transition_patch_count": len(patches),
+            "toggle_actions": len(toggle_path),
+            "navigation_actions": len(navigation_path),
+            "few_shot_examples": [str(row.get("game", "")) for row in few_shot_examples if isinstance(row, Mapping)],
+        },
