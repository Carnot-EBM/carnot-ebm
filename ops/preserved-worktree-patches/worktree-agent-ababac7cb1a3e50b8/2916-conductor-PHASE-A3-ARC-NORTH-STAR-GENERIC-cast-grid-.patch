+def _player_mask(arr: Any, object_digest: Mapping[str, Any]) -> Any:
+    import numpy as np
+
+    mask = np.zeros_like(arr, dtype=bool)
+    for color in object_digest.get("player_colors", ()):
+        mask |= np.asarray(arr) == int(color)
