+def _clock() -> tuple[dict[str, float], Any, Any]:
+    clock = {"t": 10.0}
+
+    def now() -> float:
+        return clock["t"]
+
+    def sleep(seconds: float) -> None:
+        clock["t"] += seconds
+
+    return clock, now, sleep
+
