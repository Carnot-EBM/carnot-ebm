+"""Experiment 4965: backfill .457 runtime stamps and confirm relaxed mtime readiness.
+
+Spec refs: REQ-REPORT-4965, SCENARIO-REPORT-4965,
+SCENARIO-REPORT-4965-MTIME-WINDOW,
+SCENARIO-REPORT-4965-BLOCKED-PRECONDITION.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Iterable, Mapping
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import sys
+import time
+from typing import Any
+
+
