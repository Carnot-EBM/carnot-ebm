+def _state_hash(state: Mapping[str, Any]) -> str:
+    return receipts.sha256_json(
+        {
+            "active_factors": state["active_factors"],
+            "quarantine": state["quarantine"],
+            "restart_epoch": state["restart_epoch"],
+            "tombstones": state["tombstones"],
