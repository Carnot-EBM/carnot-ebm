+
+JsonDict = dict[str, Any]
+
+REPO_ROOT = Path(__file__).resolve().parents[3]
+ARCHIVED_MILESTONE = "2026.06.387"
+ACTIVATED_MILESTONE = "2026.06.388"
+RANDOM_SEED = 4184
