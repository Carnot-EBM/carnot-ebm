@@ -0,0 +1,790 @@
+"""Tests for Exp5891 V524 source-delta ingestion.
+
+Spec refs: REQ-REPORT-5891, SCENARIO-REPORT-5891-ZERO-FINDING,
+SCENARIO-REPORT-5891-ACCEPT-BOUNDED-DELTA,
+SCENARIO-REPORT-5891-BLOCKED-PRECONDITION,
+SCENARIO-REPORT-5891-CLOSED-SCOPE-IMMUTABILITY,
+SCENARIO-REPORT-5891-SCHEMA.
+"""
+
+from __future__ import annotations
+
+import json
+import runpy
+from pathlib import Path
+
+import pytest
+import yaml
+
+from carnot import experiment_5891_v524_source_delta_ingestion as mod
+
+
+REPO = Path(__file__).resolve().parents[2]
+SPEC_PATH = REPO / "openspec/capabilities/research-reporting/spec.md"
+START = "2026-07-24T13:51:36Z"
+FINISH = "2026-07-24T13:54:39Z"
+
+
+def _roadmap() -> str:
+    tasks = []
+    for task_id in (
+        "exp5890-transition-v524",
+        "exp5891-v524-source-delta-ingestion",
+        *mod.ALLOCATED_TARGET_EXPERIMENTS,
+        "exp5903-v524-capstone-reconciliation",
+    ):
+        row = {
+            "id": task_id,
+            "milestone": mod.MILESTONE,
+            "title": task_id,
+            "deliverable": f"results/{task_id}.json",
+            "model": "gpt-5.5",
+        }
+        if task_id == "exp5893-grounding-shortcut-fixture":
+            row["gated_on"] = [
+                {
+                    "upstream": "exp5892-headroom-evidence-escrow",
+                    "artifact_field": "headroom_admission_ready_score",
+                    "op": "==",
+                    "value": 1.0,
+                }
+            ]
+        if task_id == "exp5897-sota-constraint-ir-repair-ab":
+            row["model"] = "qwen3.6-gemma4-gguf"
+            row["requires_gpu"] = True
+        tasks.append(row)
+    return yaml.safe_dump({"milestone": mod.MILESTONE, "tasks": tasks}, sort_keys=False)
+
+
+def _planner_references() -> str:
+    return (
+        "## V524 Planner Refresh - 20260724\n\n"
+        "- **Euclid-MCP** - arXiv:2607.21412.\n"
+        "- **AREX** - arXiv:2607.21461.\n"
+        "- **Beyond Episodic Evaluation** - arXiv:2607.21571.\n"
+        "- Retained ICLP shortcut grounding arXiv:2607.21185 and PRO-LONG "
+        "arXiv:2607.20064v2.\n"
+        "<!-- V524-PLANNER-REFRESH-20260724-END -->\n"
+    )
+
+
+def _accepted_fixture() -> mod.JsonDict:
+    return {
+        "source_id": "post_v524_fixture_2607_99998",
+        "classification": "accepted",
+        "title": "Post-V524 Fixture for Constraint IR Controls",
+        "url": "https://arxiv.org/abs/2607.99998",
+        "publication_date": "2026-07-24",
+        "source_date": "2026-07-24",
+        "search_timestamp": START,
+        "receipt_id": "arxiv_fixture_post_v524",
+        "query": 'all:"typed constraint IR"',
+        "access_outcome": "reachable_fixture",
+        "target_experiment": "exp5896-typed-constraint-ir-fixture",
+        "source_hook": "Add one invalid-IR semantic-equivalence row before repair A/B.",
+        "authority_boundary": (
+            "Adds a bounded Exp5896 control only; parser, compiler, solver, "
+            "and exact replay authority remain unchanged."
+        ),
+        "post_marker_or_newer_primary_source": True,
+        "primary_source": True,
+        "duplicate_of_v524_planner": False,
+        "reopens_retired_scope": False,
+        "method_to_task_mapping": {
+            "method": "typed_constraint_ir_negative_control",
+            "target_experiment": "exp5896-typed-constraint-ir-fixture",
+            "task_hook": "invalid IR semantic-equivalence control row",
+            "failure_boundary": "reject on parser disagreement or hidden label leakage",
+        },
+        "reason": (
+            "Fixture accepted finding stays inside Exp5896 and does not alter "
+            "IDs, gates, authority, model policy, retired scopes, hardware "
+            "claims, or headline authority."
+        ),
+    }
+
+
+def _ordered_candidates(artifact: mod.JsonDict) -> list[mod.JsonDict]:
+    classes = artifact["finding_classification"]
+    return (
+        classes["accepted"]
+        + classes["duplicate"]
+        + classes["watch_only"]
+        + classes["excluded"]
+        + classes["inaccessible"]
+    )
+
+
+def _make_repo(root: Path, references_text: str, *, with_next: bool = False) -> Path:
+    root.mkdir(parents=True, exist_ok=True)
+    (root / mod.RESEARCH_REFERENCES_RELATIVE_PATH).write_text(
+        references_text,
+        encoding="utf-8",
+    )
+    (root / mod.RESEARCH_STUDYING_RELATIVE_PATH).write_text(
+        "# Research Studying\n\nNo V524 execution ingestion yet.\n",
+        encoding="utf-8",
+    )
+    (root / mod.ROADMAP_RELATIVE_PATH).write_text(_roadmap(), encoding="utf-8")
+    if with_next:
+        (root / mod.ROADMAP_NEXT_RELATIVE_PATH).write_text(_roadmap(), encoding="utf-8")
+    (root / "openspec/change-proposals").mkdir(parents=True, exist_ok=True)
+    (root / mod.VNEXT_RELATIVE_PATH).write_text(
+        "# Research Roadmap vNEXT\n\n"
+        "**Milestone:** 2026.07.524\n\n"
+        "Exp5891 preserves V524 task identity, gates, authority, and model policy.\n",
+        encoding="utf-8",
+    )
+    (root / "openspec/capabilities/research-reporting").mkdir(
+        parents=True,
+        exist_ok=True,
+    )
+    (root / mod.SPEC_RELATIVE_PATH).write_text(
+        "\n".join(mod.SPEC_REFS) + "\n",
+        encoding="utf-8",
+    )
+    (root / "ops").mkdir(parents=True, exist_ok=True)
+    (root / mod.EXCLUSION_MANIFEST_RELATIVE_PATH).write_text(
+        (
+            "retired_extras:\n"
+            "- id: final_embeddings_closed\n"
+            "  reason: final embeddings remain closed\n"
+            "- id: phase_d_closed\n"
+            "  reason: PHASE D remains closed\n"
+            "- id: generated_answer_repair_closed\n"
+            "  reason: generated-answer repair remains closed\n"
+            "- id: kan_mutation_closed\n"
+            "  reason: KAN mutation remains closed\n"
