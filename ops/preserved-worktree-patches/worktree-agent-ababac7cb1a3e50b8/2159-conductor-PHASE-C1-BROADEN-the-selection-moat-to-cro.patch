+    manifest_path.write_text(json.dumps(manifest_payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    manifest_sha256 = _sha256_file(manifest_path)
+    return {
+        "pool_path": pool_path,
+        "pool_sha256": "sha256:" + pool_sha256,
