+        domain_id="arc",
+        rows=rows,
+        source_path=str(corpus.pool_artifact_path),
+        source_sha256="sha256:" + corpus.pool_artifact_sha256,
+        provenance={
+            "manifest_path": str(corpus.manifest_path),
+            "manifest_sha256": "sha256:" + corpus.manifest_sha256,
