+def _field_provenance(repo_root: Path) -> dict[str, JsonDict]:
+    sources = [
+        {"path": path.as_posix(), "sha256": _hash_if_file(repo_root / path)}
+        for path in UPSTREAM_RELATIVE_PATHS
