+def reproducibility_checksum(artifact: JsonMap) -> str:
+    stable = {
+        key: value
+        for key, value in artifact.items()
+        if key
+        not in {
+            "duration_s",
+            "test_exit_codes",
+            "reproducibility_checksum",
+        }
+    }
+    return stable_hash(stable).removeprefix("sha256:")
