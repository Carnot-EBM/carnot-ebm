+def field_provenance() -> JsonDict:
+    return {
+        field: {
+            "principle": FIELD_PRINCIPLES[field],
+            "source": "REQ-HW-6121 / SCENARIO-HW-6121 and local receipts",
+        }
+        for field in REQUIRED_ARTIFACT_FIELDS
+    }
