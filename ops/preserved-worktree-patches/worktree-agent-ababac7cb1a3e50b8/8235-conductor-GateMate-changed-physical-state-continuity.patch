+def cable_port_power_board_usb_and_dirtyjtag_receipts(prior: JsonMap, current: JsonMap) -> JsonDict:
+    return {
+        "prior": {
+            key: prior[key]
+            for key in ("cable", "port", "power", "board", "usb_dirtyjtag", "dirtyjtag")
+        },
