+def _task(**kwargs: Any) -> JsonDict:
+    row = {
+        "negative_transfer_candidate": False,
+        "stale_memory_candidate": False,
+        "requires_memory": False,
+    }
+    row.update(kwargs)
+    return _json_ready(row)
