+def _protected_receipt() -> dict[str, Any]:
+    return {
+        "schema": mod.SCHEMA + ".protected_files_unchanged",
+        "protected_files": [path.as_posix() for path in mod.PROTECTED_FILES],
+        "records": {},
+        "git_status_stdout": "",
+        "unchanged": True,
+    }
