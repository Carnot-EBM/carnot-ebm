+            "rows": [field],
+            "hashes": ["reproducibility_checksum"],
+            "reducer": "readiness_reducer.v6587",
+            "spec_refs": ["REQ-REPORT-6587"],
+        }
+        for field in REQUIRED_ARTIFACT_FIELDS
+    }
