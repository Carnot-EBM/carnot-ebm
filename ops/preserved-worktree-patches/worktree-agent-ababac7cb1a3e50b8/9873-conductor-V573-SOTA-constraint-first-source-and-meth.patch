+            and row.get("owner_declared") is True
+            and row.get("all_consumers_declared") is True
+            for row in gate_rows
+        )
+        and {row.get("attack_id") for row in attack_rows if isinstance(row, Mapping)}
+        == set(REQUIRED_ATTACK_IDS)
+        and all(
