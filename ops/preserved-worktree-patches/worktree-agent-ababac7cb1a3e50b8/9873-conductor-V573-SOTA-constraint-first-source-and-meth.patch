+    gate_rows = payload.get("downstream_gate_field_rows", [])
+    attack_rows = payload.get("attack_rows", [])
+    method_rows = [
+        row
+        for row in gate_rows
+        if isinstance(row, Mapping) and row.get("artifact_field") == READY_FIELD
+    ]
