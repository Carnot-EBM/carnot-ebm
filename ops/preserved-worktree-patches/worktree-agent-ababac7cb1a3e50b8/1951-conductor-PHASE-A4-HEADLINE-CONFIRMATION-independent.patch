+def test_validate_artifact_rejects_schema_drift() -> None:
+    """REQ-VERIFY-4246: artifact schema rejects non-bare or inconsistent fields."""
+
+    valid = {
+        "honest_verdict": "blocked_code_second_corpus_missing",
