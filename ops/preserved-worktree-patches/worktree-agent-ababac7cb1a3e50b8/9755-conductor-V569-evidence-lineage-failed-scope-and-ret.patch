+    check_results: Mapping[str, Mapping[str, Any]],
+    verifier_versions: Mapping[str, Any],
+) -> tuple[list[JsonDict], list[JsonDict]]:
+    rows: list[JsonDict] = []
+    live_rows: list[JsonDict] = []
+    for artifact in V568_ARTIFACTS:
+        payload = payloads.get(artifact.exp_id, {})
