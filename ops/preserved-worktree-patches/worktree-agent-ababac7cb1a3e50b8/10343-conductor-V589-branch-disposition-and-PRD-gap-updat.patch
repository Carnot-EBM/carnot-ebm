+    commits = _sum_mapping_numbers(ab.get("commits_by_arm"))
+    rejects = _sum_mapping_numbers(ab.get("rejects_by_arm"))
+    rollbacks = _sum_mapping_numbers(ab.get("rollbacks_by_arm"))
+    return {
