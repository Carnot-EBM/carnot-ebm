+def _run_command(args: Sequence[str], root: Path) -> tuple[int, str]:  # pragma: no cover
+    completed = subprocess.run(
+        list(args),
+        cwd=root,
+        check=False,
+        capture_output=True,
+        text=True,
+        timeout=300,
+    )
+    return completed.returncode, (completed.stdout + completed.stderr).strip()
+
