+def test_scenario_report_6767_complete_artifact_preserves_required_fields(
+    current_inputs: tuple[list[dict], dict[str, dict]],
+) -> None:
+    """SCENARIO-REPORT-6767-BRANCH-ISOLATION: the terminal artifact has no pooled claim."""
