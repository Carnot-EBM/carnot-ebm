+def reproducibility_checksum(payload: Mapping[str, Any]) -> str:
+    """Hash the artifact while excluding its own checksum."""
+
+    return value_hash(
+        {key: value for key, value in payload.items() if key != "reproducibility_checksum"}
+    )
