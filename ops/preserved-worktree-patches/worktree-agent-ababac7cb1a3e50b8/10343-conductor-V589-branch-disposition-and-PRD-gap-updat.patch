+    assert artifact["expected_task_ids"] == list(exp.FULL_TASK_IDS)
+    assert [row["branch"] for row in artifact["branch_rows"]] == list(exp.BRANCH_ORDER)
+    assert artifact["verdict_class"] == "partial"
