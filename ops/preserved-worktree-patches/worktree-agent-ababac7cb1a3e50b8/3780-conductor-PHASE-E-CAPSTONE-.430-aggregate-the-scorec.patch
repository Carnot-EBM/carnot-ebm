+
+def _cited_statuses(
+    statuses: Mapping[str, Mapping[str, Any]], imported_fields: Mapping[str, Sequence[str]]
+) -> dict[str, JsonDict]:
+    cited: dict[str, JsonDict] = {}
+    for name, status in statuses.items():
+        cited[name] = {
+            **dict(status),
+            "imported_fields": list(imported_fields.get(name, [])),
+        }
