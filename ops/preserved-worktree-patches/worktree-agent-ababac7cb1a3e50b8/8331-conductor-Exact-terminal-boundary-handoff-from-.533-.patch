+            if flagged
+            else []
+        ),
+    }
+    stdout_json = {"reports": [report], "flagged_count": int(flagged)}
+    return {
+        "task_id": task_id,
+        "artifact_path": rel_path.as_posix(),
+        "command": f".venv/bin/python scripts/adversarial_verify.py --json {rel_path.as_posix()}",
