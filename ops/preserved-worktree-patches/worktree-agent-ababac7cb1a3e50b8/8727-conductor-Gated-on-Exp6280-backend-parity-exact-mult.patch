+        "topology": VARIABLE_CARDINALITY_TOPOLOGY,
+        "labels": labels,
+        "typed_state_metadata": metadata,
+        "seed": int(seed),
+        "initial_label": exp6269._initial_label(receipt),  # noqa: SLF001
