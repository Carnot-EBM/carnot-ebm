+def _checkpoint(
+    path: Path | None,
+    *,
+    rows: Sequence[dict[str, Any]],
+    records: Sequence[dict[str, Any]],
+    failures: Sequence[dict[str, Any]],
+) -> None:
+    if path is None:
+        return
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(
+        json.dumps(
+            {
+                "rows": list(rows),
+                "records": list(records),
+                "failures": list(failures),
+            },
+            indent=2,
+            sort_keys=True,
+        )
+        + "\n",
+        encoding="utf-8",
+    )
