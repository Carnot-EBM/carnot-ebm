+def main(argv: Sequence[str] | None = None) -> int:  # pragma: no cover - CLI wrapper.
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--artifact", type=Path, default=ARTIFACT_PATH)
