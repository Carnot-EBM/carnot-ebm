+            | {
+                "v474_citations_spot_checked": {
+                    "value": artifact["v474_citations_spot_checked"]["value"],
+                    "principle": "wrong",
+                }
+            },
+            "declared principle",
+        ),
+        (
+            lambda artifact: artifact
+            | {
+                "map_paper_deep_read": {
