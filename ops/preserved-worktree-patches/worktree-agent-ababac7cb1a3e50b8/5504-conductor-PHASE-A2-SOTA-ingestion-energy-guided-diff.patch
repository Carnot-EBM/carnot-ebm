+            "all 25",
+        ),
+        (
+            lambda artifact: artifact
+            | {
+                "map_paper_deep_read": {
+                    "value": artifact["map_paper_deep_read"]["value"]
+                    | {
+                        "quantitative_headline_result": artifact[
+                            "map_paper_deep_read"
+                        ]["value"]["quantitative_headline_result"]
