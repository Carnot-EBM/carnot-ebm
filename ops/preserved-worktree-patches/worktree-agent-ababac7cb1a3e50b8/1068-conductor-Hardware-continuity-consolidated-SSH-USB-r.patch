+        return out
+    sep = int(sep_cols[0])
+    right_w = w - sep - 1
+
+    left = grid[:, :sep].copy()
+    out[:, :sep] = 6
+    out[:, sep + 1:] = 6
+
+    seen = np.zeros(left.shape, dtype=bool)
+
+    for sr in range(h):
+        for sc in range(sep):
+            if left[sr, sc] != 0 or seen[sr, sc]:
+                continue
+
+            stack = [(sr, sc)]
+            seen[sr, sc] = True
+            cells = []
+
+            while stack:
+                r, c = stack.pop()
+                cells.append((r, c))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = r + dr, c + dc
+                    if 0 <= nr < h and 0 <= nc < sep and not seen[nr, nc] and left[nr, nc] == 0:
