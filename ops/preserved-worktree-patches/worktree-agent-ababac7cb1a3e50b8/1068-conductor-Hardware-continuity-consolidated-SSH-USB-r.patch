+
+            rmin = min(r for r, c in cells)
+            rmax = max(r for r, c in cells)
+            cmin = min(c for r, c in cells)
+            cmax = max(c for r, c in cells)
+
+            layer_colors = {}
+            for r, c, color in clues:
+                layer = min(r - rmin, c - cmin, rmax - r, cmax - c)
+                layer_colors[layer] = color
+
+            period = max(layer_colors) + 1
+            seq = [bg] * period
+            for layer, color in layer_colors.items():
+                seq[layer] = color
+
+            for r, c in cells:
+                layer = min(r - rmin, c - cmin, rmax - r, cmax - c)
+                out[r, c] = seq[layer % period]
+
+    return out
