+```python
+def transform(grid):
+    out = grid.copy()
+    h, w = grid.shape
+
+    vals, counts = np.unique(grid, return_counts=True)
+    bg = vals[np.argmax(counts)]
+
+    sep = None
+    best = -1
+    for v, c in zip(vals, counts):
+        if v != bg and c > best:
+            sep = v
+            best = c
+
+    if sep is None:
+        return out
+
+    seen = np.zeros((h, w), dtype=bool)
+
+    for sr in range(h):
+        for sc in range(w):
+            if seen[sr, sc] or grid[sr, sc] == sep:
+                continue
+
+            stack = [(sr, sc)]
+            seen[sr, sc] = True
+            cells = []
+
+            while stack:
+                r, c = stack.pop()
+                cells.append((r, c))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = r + dr, c + dc
+                    if (
+                        0 <= nr < h and 0 <= nc < w
+                        and not seen[nr, nc]
+                        and grid[nr, nc] != sep
+                    ):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            clues = []
+            for r, c in cells:
+                if grid[r, c] != bg and grid[r, c] != sep:
+                    clues.append((r, c, grid[r, c]))
+
+            if not clues:
