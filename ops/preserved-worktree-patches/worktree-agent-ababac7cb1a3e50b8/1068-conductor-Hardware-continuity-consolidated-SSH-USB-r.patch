+        out[r0:r1 + 1, shift:sep] = np.where(shape == 0, 0, 6)
+
+        for i, row in enumerate(shape):
+            if row[-1] == 0:
+                z = np.where(row == 0)[0]
+                if len(z) > 1 and np.any(np.diff(z) > 1):
+                    out[r0 + i, sep + 1:] = 2
+
+    return out
