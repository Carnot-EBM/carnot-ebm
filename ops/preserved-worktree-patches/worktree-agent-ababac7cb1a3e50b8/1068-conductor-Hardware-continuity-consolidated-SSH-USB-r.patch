+
+        mask = np.zeros((3, 3), dtype=bool)
+        if coords:
+            rmin = min(p[0] for p in coords)
+            cmin = min(p[1] for p in coords)
+            for r, c in coords:
+                rr, cc = r - rmin, c - cmin
+                if 0 <= rr < 3 and 0 <= cc < 3:
+                    mask[rr, cc] = True
+        patterns[color] = mask
+
+    min_r = max(0, min(r for r, _, _ in large) - 1)
+    max_r = min(h - 1, max(r + 4 for r, _, _ in large) + 1)
+    min_c = max(0, min(c for _, c, _ in large) - 1)
