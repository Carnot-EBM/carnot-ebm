+            prev_zi[g] = mean(sc + [0.0] * (len(rs) - len(sc)))
+            prev_so[g] = mean(sc)
+        common = [g for g in roster if g in prev_zi]
+
+        def cmp(prev_map: dict[str, Any], key: str) -> dict[str, Any]:
+            w = losses = ties = 0
+            deltas, absd = {}, []
+            for g in common:
+                a_, b_ = prev_map[g], detail[g]["gemma31b"][key]
+                if a_ is None or b_ is None:
+                    continue
+                d = round(b_ - a_, 6)
