+            # Find non-zero cells
+            non_zero = row[row != 0]
+            # Shift left
+            new_row = np.zeros(W, dtype=int)
+            new_row[:len(non_zero)] = non_zero
+            new_grid[r, :] = new_row
+        return new_grid
