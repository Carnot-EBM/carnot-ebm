+            non_zero = row[row != 0]
+            new_row = np.zeros(W, dtype=int)
+            new_row[-len(non_zero):] = non_zero
+            new_grid[r, :] = new_row
+        return new_grid
+        
+    elif action == 3:
+        # Action 3: Move up
+        # Shift all non-background cells up
+        for c in range(W):
+            col = new_grid[:, c]
+            non_zero = col[col != 0]
+            new_col = np.zeros(H, dtype=int)
+            new_col[:len(non_zero)] = non_zero
+            new_grid[:, c] = new_col
+        return new_grid
+        
+    elif action == 4:
