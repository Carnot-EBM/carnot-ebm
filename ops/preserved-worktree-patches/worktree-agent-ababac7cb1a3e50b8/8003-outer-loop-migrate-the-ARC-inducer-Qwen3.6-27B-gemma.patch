+        for c in range(W):
+            for r in range(H - 1, 0, -1):
+                if new_grid[r, c] == 0:
+                    new_grid[r, c] = new_grid[r - 1, c]
+                    new_grid[r - 1, c] = 0
+    elif action == 2:
+        # Move Down
+        for c in range(W):
+            for r in range(H):
+                if new_grid[r, c] == 0:
+                    new_grid[r, c] = new_grid[r + 1, c]
