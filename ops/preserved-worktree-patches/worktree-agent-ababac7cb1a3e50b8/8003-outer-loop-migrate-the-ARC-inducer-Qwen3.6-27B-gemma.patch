+def parse_runs(row_str):
+    """Parse a row run-length string into a list of (value, count) tuples."""
+    if not row_str:
+        return []
+    runs = []
+    parts = row_str.split(',')
+    for part in parts:
+        if 'x' in part:
+            val_str, count_str = part.split('x')
+            runs.append((int(val_str), int(count_str)))
+    return runs
