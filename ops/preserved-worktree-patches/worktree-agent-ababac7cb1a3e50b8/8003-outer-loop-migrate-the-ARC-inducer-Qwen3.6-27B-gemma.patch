+                    new_grid[r + 1, c] = 0
+    elif action == 3:
+        # Move Left
+        for r in range(h):
+            for c in range(w - 1, 0, -1):
+                if new_grid[r, c] == 0:
+                    new_grid[r, c] = new_grid[r, c - 1]
+                    new_grid[r, c - 1] = 0
+    elif action == 4:
+        # Move Right
+        for r in range(h):
+            for c in range(w):
+                if new_grid[r, c] == 0:
+                    new_grid[r, c] = new_grid[r, c + 1]
+                    new_grid[r, c + 1] = 0
+    elif action == 5:
+        # Toggle
+        for r in range(h):
+            for c in range(w):
+                if new_grid[r, c] == 0:
+                    new_grid[r, c] = 1
+    elif action == 6:
