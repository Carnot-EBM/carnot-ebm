+        "random_seed": RANDOM_SEED,
+        "measurement_wall_s": round(sum(float(r["elapsed_s"]) for r in rows), 3),
+        "duration_s": round(duration_s, 3),
+        "model_specs": [
+            {
+                "name": "Qwen3.5-9B-MTP-GGUF",
+                "gguf_path": gguf,
+                "role": "induction_generator",
+                "server_pid": server_pid,
