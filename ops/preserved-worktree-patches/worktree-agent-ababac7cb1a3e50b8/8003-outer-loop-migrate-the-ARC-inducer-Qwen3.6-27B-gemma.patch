+                    new_grid[r, c - 1] = 0
+    elif action == 4:
+        # Move Right
+        for r in range(H):
+            for c in range(W):
+                if new_grid[r, c] == 0:
+                    new_grid[r, c] = new_grid[r, c + 1]
+                    new_grid[r, c + 1] = 0
+    elif action == 5:
+        # Rotate Left
+        new_grid = np.rot90(new_grid, k=1)
+    elif action == 6:
