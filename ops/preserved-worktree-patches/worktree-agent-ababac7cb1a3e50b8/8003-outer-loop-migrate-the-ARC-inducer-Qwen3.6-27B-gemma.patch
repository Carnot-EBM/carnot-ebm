+            col = new_grid[:, c]
+            non_zero = col[col != 0]
+            new_col = np.zeros(H, dtype=int)
+            new_col[-len(non_zero):] = non_zero
+            new_grid[:, c] = new_col
+        return new_grid
+        
+    elif action == 5:
+        # Action 5: Rotate clockwise
+        # Transpose and reverse rows
+        new_grid = np.rot90(grid, k=-1)
+        return new_grid
+        
+    elif action == 6:
+        # Action 6: Rotate counter-clockwise
+        # Transpose and reverse columns
+        new_grid = np.rot90(grid, k=1)
+        return new_grid
+        
