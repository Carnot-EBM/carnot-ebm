+    # ------------------------------------------------------------------------------------
+    def _reason_evidence() -> dict[str, Any]:
+        base = {
+            "flag_definition": (
+                "reason_engaged = any of ('<think','</think','<thinking','<reasoning') appearing "
+                "in the raw completion (experiment_5726 line 381, tags from experiment_5714)."
+            ),
+            "flag_is_constant_in_this_run": {
+                a: {
