+def test_scenario_capstone_4877_blocks_missing_packaging_without_submit_claim() -> None:
+    """SCENARIO-CAPSTONE-4877-BLOCKED-PRECONDITION: missing package assets block honestly."""
+
+    artifact = mod.build_artifact(
+        preconditions_checked=_preconditions(False, scripts_present=False),
+        package_builds=mod.blocked_package_builds_payload(),
+        agent_config_resolution={},
+        model_path_resolution={},
