+def test_scenario_capstone_4877_not_ready_verdicts_name_regression_source() -> None:
+    """SCENARIO-CAPSTONE-4877-BLOCKED-PRECONDITION: non-ready gates name the resource."""
+
+    base = {
+        "preconditions_checked": _preconditions(True),
