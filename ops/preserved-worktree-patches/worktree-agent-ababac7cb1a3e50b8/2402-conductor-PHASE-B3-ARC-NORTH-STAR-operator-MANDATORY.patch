+def test_req_phase4_084_helper_branches_cover_paths_labels_and_blocked_verdict(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """REQ-PHASE4-084: pure helpers keep edge branches deterministic."""
