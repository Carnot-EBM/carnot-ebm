+                ("TC_UNSAT_01", "S0", "x", "S2"),
+            ],
+            forbidden_transitions=[],
+            trace_specs=[
+                ("unsat_x_contradiction", ["x"]),
+            ],
+            expected_status="unsatisfiable",
+        ),
+        build_fixture_instance(
+            instance_id="fsm_ambiguous_sparse_branch",
+            states=["A", "B", "C", "D"],
+            alphabet=["go"],
+            start_state="A",
+            accepting_states=["C"],
+            error_states=["D"],
+            required_transitions=[
+                ("TC_AMB_00", "A", "go", "B"),
+                ("TC_AMB_01", "C", "go", "C"),
+                ("TC_AMB_02", "D", "go", "D"),
+            ],
+            forbidden_transitions=[
+                ("TC_AMB_03", "B", "go", "D"),
