+def attach_reference_trace_labels(machine: Mapping[str, Any]) -> JsonDict:
+    """Fill observable trace labels from the exact completion analysis."""
+
+    labeled = _json_clone(machine)
+    completions = enumerate_completions(labeled)
+    for trace in labeled["observable_traces"]:
+        trace["expected_label"] = _reference_label_for_trace(
+            labeled,
+            completions,
+            list(trace["symbols"]),
+        )
+    return labeled
+
+
+def solve_instance(machine: Mapping[str, Any]) -> JsonDict:
+    """Run exact transition, reachability, trace, and completion checks."""
+
+    diagnostics = transition_diagnostics(machine)
+    completions = enumerate_completions(machine)
+    solver_status = _solver_status(completions, diagnostics["contradictions"])
+    trace_checks = [
+        _trace_check(machine, completions, trace)
+        for trace in machine.get("observable_traces", [])
+    ]
+    expected_status = str(machine.get("expected_status", solver_status))
+    return {
+        "instance_id": str(machine.get("instance_id", "")),
+        "expected_status": expected_status,
+        "solver_status": solver_status,
+        "status_matches_expected": solver_status == expected_status,
+        "completion_count": len(completions),
+        "completion_samples": completions,
+        "transition_consistency_passed": not diagnostics["contradictions"],
+        "contradictions": diagnostics["contradictions"],
+        "unreachable_states": unreachable_states(machine, diagnostics["required_map"]),
+        "trace_checks": trace_checks,
+        "trace_checks_passed": all(row["passed"] for row in trace_checks),
+        "sat_solver_check_passed": solver_status == expected_status,
+    }
+
+
+def transition_diagnostics(machine: Mapping[str, Any]) -> JsonDict:
+    """Build required and forbidden transition maps plus contradiction messages."""
+
+    states = set(machine.get("states", []))
+    alphabet = set(machine.get("alphabet", []))
+    required: dict[tuple[str, str], str] = {}
+    forbidden: set[tuple[str, str, str]] = set()
+    seen_ids: set[str] = set()
+    contradictions: list[str] = []
+    for row in machine.get("transition_constraints", []):
+        cid = str(row.get("constraint_id", ""))
+        kind = str(row.get("kind", ""))
+        source = str(row.get("source", ""))
+        symbol = str(row.get("symbol", ""))
+        target = str(row.get("target", ""))
+        contradictions.extend(
+            error
+            for condition, error in (
+                (cid in seen_ids, f"duplicate_constraint_id:{cid}"),
+                (source not in states, f"invalid_source:{cid}:{source}"),
+                (symbol not in alphabet, f"invalid_symbol:{cid}:{symbol}"),
+                (target not in states, f"invalid_target:{cid}:{target}"),
+                (kind not in {"require", "forbid"}, f"invalid_kind:{cid}:{kind}"),
+            )
+            if condition
+        )
+        seen_ids.add(cid)
+        if source not in states or symbol not in alphabet or target not in states:
+            continue
+        if kind == "require":
+            pair = (source, symbol)
+            previous = required.get(pair)
+            if previous is not None and previous != target:
+                contradictions.append(f"deterministic_conflict:{source}/{symbol}:{previous}!={target}")
+            required[pair] = target
+        if kind == "forbid":
+            forbidden.add((source, symbol, target))
+
+    accepting_error_overlap = sorted(
+        set(machine.get("accepting_states", [])) & set(machine.get("error_states", []))
+    )
+    contradictions.extend(f"accepting_error_overlap:{state}" for state in accepting_error_overlap)
+    contradictions.extend(
+        f"require_forbid_conflict:{source}/{symbol}:{target}"
+        for (source, symbol), target in sorted(required.items())
+        if (source, symbol, target) in forbidden
+    )
+    return {
+        "required_map": required,
+        "forbidden_set": forbidden,
+        "contradictions": sorted(set(contradictions)),
+    }
+
+
+def enumerate_completions(machine: Mapping[str, Any]) -> list[Completion]:
+    """Enumerate total deterministic completions for this bounded FSM."""
+
+    diagnostics = transition_diagnostics(machine)
+    if diagnostics["contradictions"]:
+        return []
+    states = list(machine.get("states", []))
+    alphabet = list(machine.get("alphabet", []))
+    required = diagnostics["required_map"]
+    forbidden = diagnostics["forbidden_set"]
+    missing_pairs = [
+        (state, symbol)
+        for state in states
+        for symbol in alphabet
+        if (state, symbol) not in required
+    ]
+    allowed_targets = [
+        [target for target in states if (state, symbol, target) not in forbidden]
+        for state, symbol in missing_pairs
+    ]
+    if any(not targets for targets in allowed_targets):
+        return []
+    completions: list[Completion] = []
+    for choices in product(*allowed_targets):
+        flat = dict(required)
+        flat.update(
+            {
+                pair: target
+                for pair, target in zip(missing_pairs, choices, strict=True)
+            }
+        )
+        completions.append(
+            {
+                state: {
+                    symbol: flat[(state, symbol)]
+                    for symbol in alphabet
+                }
+                for state in states
+            }
+        )
+    return completions
+
+
+def trace_labels_across_completions(
+    machine: Mapping[str, Any],
+    completions: Sequence[Mapping[str, Mapping[str, str]]],
+    symbols: Sequence[str],
+) -> list[str]:
+    """Return sorted unique labels produced by the supplied completions."""
+
+    return sorted(
+        {
+            simulate_trace(machine, completion, symbols)
+            for completion in completions
+        }
+    )
+
+
+def simulate_trace(
+    machine: Mapping[str, Any],
+    completion: Mapping[str, Mapping[str, str]],
+    symbols: Sequence[str],
+) -> str:
+    """Execute one trace against one total deterministic completion."""
+
+    current = str(machine["start_state"])
+    accepting = set(machine.get("accepting_states", []))
+    errors = set(machine.get("error_states", []))
+    if current in errors:
+        return "error"
+    for symbol in symbols:
+        current = str(completion[current][str(symbol)])
+        if current in errors:
+            return "error"
+    return "accepted" if current in accepting else "rejected"
+
+
+def unreachable_states(
+    machine: Mapping[str, Any],
+    required_map: Mapping[tuple[str, str], str],
+) -> list[str]:
+    """Find states unreachable through required transitions from the start."""
+
+    states = list(machine.get("states", []))
+    seen = {str(machine.get("start_state", ""))}
+    frontier = list(seen)
+    while frontier:
+        current = frontier.pop(0)
+        for (source, _symbol), target in required_map.items():
+            if source == current and target not in seen:
+                seen.add(target)
+                frontier.append(target)
+    return sorted(state for state in states if state not in seen)
+
+
+def machine_description(machine: Mapping[str, Any]) -> JsonDict:
+    """Return the schema-shaped machine description emitted as YAML-compatible JSON."""
+
+    return {field: _json_clone(machine[field]) for field in REQUIRED_MACHINE_FIELDS}
+
+
+def machine_description_text(machine: Mapping[str, Any]) -> str:
+    """Return a YAML-compatible description using JSON, which YAML parsers accept."""
+
+    return json.dumps(machine_description(machine), indent=2, sort_keys=True, ensure_ascii=True)
+
+
+def parse_machine_description_text(text: str) -> JsonDict:
+    """Parse the emitted machine-description text back into a dictionary."""
+
+    try:
+        decoded = json.loads(text)
+    except json.JSONDecodeError as exc:
+        raise ValueError("machine_description_yaml is not parseable") from exc
+    if not isinstance(decoded, dict):
+        raise ValueError("machine_description_yaml did not decode to an object")
+    return decoded
+
+
+def validate_machine_description(machine: Mapping[str, Any]) -> list[str]:
+    """Validate the emitted schema shape without treating contradictions as schema errors."""
+
+    errors = [f"missing:{field}" for field in REQUIRED_MACHINE_FIELDS if field not in machine]
+    if errors:
+        return errors
+    states = list(machine["states"]) if isinstance(machine["states"], list) else []
+    alphabet = list(machine["alphabet"]) if isinstance(machine["alphabet"], list) else []
+    state_set = set(states)
+    alphabet_set = set(alphabet)
+    trace_labels = {
+        str(trace.get("expected_label"))
+        for trace in machine["observable_traces"]
+        if isinstance(trace, Mapping)
+    }
+    errors.extend(
+        error
+        for condition, error in (
+            (machine["schema_version"] != MACHINE_SCHEMA_VERSION, "invalid:schema_version"),
+            (machine["state_count"] != len(states), "invalid:state_count"),
+            (machine["start_state"] not in state_set, "invalid:start_state"),
+            (not set(machine["accepting_states"]).issubset(state_set), "invalid:accepting_states"),
+            (not set(machine["error_states"]).issubset(state_set), "invalid:error_states"),
+            (not 0.0 <= float(machine["transition_sparsity"]) <= 1.0, "invalid:transition_sparsity"),
+            (not set(_constraint_states(machine)).issubset(state_set), "invalid:transition_state_ref"),
+            (not set(_constraint_symbols(machine)).issubset(alphabet_set), "invalid:transition_symbol_ref"),
+            (not trace_labels.issubset(TRACE_LABELS), "invalid:trace_label"),
+            (str(machine["expected_status"]) not in SOLVER_STATUSES, "invalid:expected_status"),
+        )
+        if condition
+    )
+    return errors
+
+
+def natural_language_summary(machine: Mapping[str, Any]) -> str:
+    """Build deterministic plain-language text from the machine definition."""
+
+    constraints = list(machine["transition_constraints"])
+    require_count = sum(1 for row in constraints if row["kind"] == "require")
+    forbid_count = sum(1 for row in constraints if row["kind"] == "forbid")
+    return (
+        f"{machine['instance_id']} has {machine['state_count']} states over "
+        f"{','.join(machine['alphabet'])}; it starts at {machine['start_state']}, "
+        f"accepts {','.join(machine['accepting_states']) or 'none'}, treats "
+        f"{','.join(machine['error_states']) or 'none'} as error, carries "
+        f"{require_count} required and {forbid_count} forbidden transition constraints, "
+        f"and has {len(machine['observable_traces'])} exact trace labels generated from the FSM."
+    )
+
+
+def build_machine_descriptions(family: Sequence[Mapping[str, Any]]) -> list[JsonDict]:
+    """Build schema text, deterministic summaries, and hashes for every FSM."""
+
+    descriptions = []
+    for machine in family:
+        text = machine_description_text(machine)
+        descriptions.append(
+            {
+                "instance_id": str(machine["instance_id"]),
+                "machine_description_yaml": text,
+                "machine_description_hash": sha256_text(text),
+                "natural_language_summary": natural_language_summary(machine),
+            }
+        )
+    return descriptions
+
+
+def build_artifact(
+    *,
+    family: Sequence[Mapping[str, Any]] | None = None,
+    tests_run: Sequence[Mapping[str, Any]] = (),
+) -> JsonDict:
+    """Build the Exp5541 deterministic no-LLM result artifact."""
+
+    machines = [_json_clone(row) for row in (family or build_fixture_family())]
+    reports = [solve_instance(machine) for machine in machines]
+    descriptions = build_machine_descriptions(machines)
+    yaml_schema_valid = all(
+        validate_machine_description(parse_machine_description_text(row["machine_description_yaml"])) == []
+        for row in descriptions
+    )
+    reference_trace_checks_passed = all(row["trace_checks_passed"] for row in reports)
+    exact_transition_checks_passed = _transition_checks_match_fixture_intent(reports)
+    sat_solver_checks_passed = all(row["sat_solver_check_passed"] for row in reports)
+    counts = _status_counts(reports)
+    ready = bool(
+        yaml_schema_valid
+        and reference_trace_checks_passed
+        and exact_transition_checks_passed
+        and sat_solver_checks_passed
+        and counts["satisfiable"] >= 1
+        and counts["unsatisfiable"] >= 1
+        and counts["ambiguous"] >= 1
+    )
+    artifact: JsonDict = {
+        "schema": SCHEMA,
+        "experiment": EXPERIMENT,
+        "experiment_id": EXPERIMENT_ID,
+        "milestone": MILESTONE,
+        "run_date": RUN_DATE,
+        "duration_s": 0.0,
+        "random_seed": RANDOM_SEED,
+        "spec_refs": list(SPEC_REFS),
+        "result_path": RESULT_RELATIVE_PATH.as_posix(),
+        "fsm_instances": len(machines),
+        "state_counts": [int(machine["state_count"]) for machine in machines],
+        "transition_constraints": _transition_constraint_summaries(machines),
+        "satisfiable_instances": counts["satisfiable"],
+        "unsatisfiable_instances": counts["unsatisfiable"],
+        "ambiguous_instances": counts["ambiguous"],
+        "yaml_schema_valid": yaml_schema_valid,
+        "reference_trace_checks_passed": reference_trace_checks_passed,
+        "exact_transition_checks_passed": exact_transition_checks_passed,
+        "sat_solver_checks_passed": sat_solver_checks_passed,
+        "no_llm_invoked": True,
+        "exact_fsm_fixture_ready": ready,
+        "tests_added_or_reused": list(TESTS_ADDED_OR_REUSED),
+        "field_principles": dict(FIELD_PRINCIPLES),
+        "inference_substrate": INFERENCE_SUBSTRATE,
+        "honest_verdict": honest_verdict(ready),
+        "fsm_family": machines,
+        "machine_descriptions": descriptions,
+        "exact_check_reports": reports,
+        "research_conductor_modified": False,
+        "tests_run": [dict(row) for row in tests_run],
+        "reproducibility_checksum": "",
+    }
+    artifact["reproducibility_checksum"] = payload_checksum(artifact)
+    validate_artifact(artifact)
+    return artifact
+
+
+def run(
+    *,
+    result_path: Path | str = REPO_ROOT / RESULT_RELATIVE_PATH,
+    family: Sequence[Mapping[str, Any]] | None = None,
+    tests_run: Sequence[Mapping[str, Any]] = (),
+    write: bool = True,
+) -> JsonDict:
+    """Build and optionally write the Exp5541 deliverable JSON."""
+
+    artifact = build_artifact(family=family, tests_run=tests_run)
+    if write:
+        output = Path(result_path)
+        output.parent.mkdir(parents=True, exist_ok=True)
+        output.write_text(
+            json.dumps(artifact, indent=2, sort_keys=True, ensure_ascii=True) + "\n",
+            encoding="utf-8",
+        )
+    return artifact
+
+
+def validate_artifact(artifact: Mapping[str, Any]) -> None:
+    """Validate the terminal artifact and fail closed on hidden LLM or solver claims."""
+
+    for field in REQUIRED_ARTIFACT_FIELDS:
+        _require(field in artifact, field)
+    _require(artifact.get("inference_substrate") == INFERENCE_SUBSTRATE, "inference_substrate")
+    _require(str(artifact.get("honest_verdict", "")).startswith(("complete:", "blocked:")), "honest_verdict")
+    _require(set(REQUIRED_ARTIFACT_FIELDS).issubset(artifact.get("field_principles", {})), "field_principles")
+    _require(artifact.get("no_llm_invoked") is True, "no_llm_invoked")
+    _require("model_specs" not in artifact, "model_specs")
+    _require(artifact.get("research_conductor_modified") is False, "research_conductor_modified")
+    _require(int(artifact.get("fsm_instances", -1)) == len(artifact.get("fsm_family", [])), "fsm_instances")
+    _require(artifact.get("state_counts") == [row["state_count"] for row in artifact.get("fsm_family", [])], "state_counts")
+    _require(isinstance(artifact.get("transition_constraints"), list), "transition_constraints")
+    for field in (
+        "satisfiable_instances",
+        "unsatisfiable_instances",
+        "ambiguous_instances",
+    ):
+        _require(int(artifact.get(field, -1)) >= 1, field)
+    for field in (
+        "yaml_schema_valid",
+        "reference_trace_checks_passed",
+        "exact_transition_checks_passed",
+        "sat_solver_checks_passed",
+        "exact_fsm_fixture_ready",
+    ):
+        _require(isinstance(artifact.get(field), bool), field)
+    if artifact.get("exact_fsm_fixture_ready") is True:
+        _require(artifact.get("yaml_schema_valid") is True, "yaml_schema_valid")
+        _require(artifact.get("reference_trace_checks_passed") is True, "reference_trace_checks_passed")
+        _require(artifact.get("exact_transition_checks_passed") is True, "exact_transition_checks_passed")
+        _require(artifact.get("sat_solver_checks_passed") is True, "sat_solver_checks_passed")
+        _require(str(artifact.get("honest_verdict", "")).startswith("complete:"), "honest_verdict")
+    _require(artifact.get("tests_added_or_reused") == list(TESTS_ADDED_OR_REUSED), "tests_added_or_reused")
+    _require(artifact.get("reproducibility_checksum") == payload_checksum(artifact), "checksum")
+
+
+def honest_verdict(ready: bool) -> str:
+    """Return a terminal verdict that cannot imply a model-quality claim."""
+
+    if ready:
+        return "complete: exact_fsm_fixture_ready_sat_unsat_ambiguous_no_llm"
+    return "blocked: exact_fsm_fixture_not_ready_exact_gate_failed"
+
+
+def _transition_constraint(
+    constraint_id: str,
+    kind: str,
+    source: str,
+    symbol: str,
+    target: str,
+) -> JsonDict:
+    return {
+        "constraint_id": constraint_id,
+        "kind": kind,
+        "source": source,
+        "symbol": symbol,
+        "target": target,
+    }
+
+
+def _reference_label_for_trace(
+    machine: Mapping[str, Any],
+    completions: Sequence[Mapping[str, Mapping[str, str]]],
+    symbols: Sequence[str],
+) -> str:
+    if not completions:
+        return "contradiction"
+    labels = trace_labels_across_completions(machine, completions, symbols)
+    return labels[0] if len(labels) == 1 else "underdetermined"
+
+
+def _trace_check(
+    machine: Mapping[str, Any],
+    completions: Sequence[Mapping[str, Mapping[str, str]]],
+    trace: Mapping[str, Any],
+) -> JsonDict:
+    actual = _reference_label_for_trace(machine, completions, list(trace["symbols"]))
+    expected = str(trace.get("expected_label", actual))
+    labels = (
+        []
+        if not completions
+        else trace_labels_across_completions(machine, completions, list(trace["symbols"]))
+    )
+    return {
+        "trace_id": str(trace["trace_id"]),
+        "symbols": list(trace["symbols"]),
+        "expected_label": expected,
+        "actual_label": actual,
+        "labels_across_completions": labels,
+        "passed": actual == expected,
+    }
+
+
+def _solver_status(
+    completions: Sequence[Mapping[str, Mapping[str, str]]],
+    contradictions: Sequence[str],
+) -> str:
+    if contradictions or not completions:
+        return "unsatisfiable"
+    return "satisfiable" if len(completions) == 1 else "ambiguous"
+
+
+def _transition_checks_match_fixture_intent(reports: Sequence[Mapping[str, Any]]) -> bool:
+    return all(
+        (
+            row["transition_consistency_passed"] is True
+            and row["solver_status"] in {"satisfiable", "ambiguous"}
+        )
+        or (
+            row["transition_consistency_passed"] is False
+            and row["solver_status"] == "unsatisfiable"
+            and bool(row["contradictions"])
+        )
+        for row in reports
+    )
+
+
+def _status_counts(reports: Sequence[Mapping[str, Any]]) -> dict[str, int]:
+    return {
+        status: sum(1 for row in reports if row["solver_status"] == status)
+        for status in SOLVER_STATUSES
+    }
+
+
+def _transition_constraint_summaries(family: Sequence[Mapping[str, Any]]) -> list[JsonDict]:
+    return [
+        {
+            "instance_id": str(machine["instance_id"]),
+            "state_count": int(machine["state_count"]),
+            "transition_sparsity": float(machine["transition_sparsity"]),
+            "constraint_ids": [
+                str(row["constraint_id"])
+                for row in machine["transition_constraints"]
+            ],
+            "constraint_count": len(machine["transition_constraints"]),
+        }
+        for machine in family
+    ]
+
+
+def _constraint_states(machine: Mapping[str, Any]) -> list[str]:
+    return [
+        str(value)
+        for row in machine["transition_constraints"]
+        for value in (row.get("source"), row.get("target"))
+    ]
+
+
+def _constraint_symbols(machine: Mapping[str, Any]) -> list[str]:
+    return [str(row.get("symbol")) for row in machine["transition_constraints"]]
+
+
+def _json_clone(value: Any) -> Any:
+    return json.loads(canonical_json(value))
+
+
+def _require(condition: bool, message: str) -> None:
+    if not condition:
+        raise ValueError(message)
+
+
+def main() -> int:  # pragma: no cover
+    artifact = run()
+    print(
+        json.dumps(
+            {
+                "result": RESULT_RELATIVE_PATH.as_posix(),
+                "exact_fsm_fixture_ready": artifact["exact_fsm_fixture_ready"],
+                "honest_verdict": artifact["honest_verdict"],
+            },
+            sort_keys=True,
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
