+def canonical_json(value: Any) -> str:
+    """Serialize JSON deterministically so hashes are stable across runs."""
+
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
+
+
+def sha256_text(value: str) -> str:
+    """Return a SHA-256 hex digest for UTF-8 text."""
+
+    return hashlib.sha256(value.encode("utf-8")).hexdigest()
+
+
+def sha256_json(value: Any) -> str:
+    """Return a SHA-256 hex digest for a JSON-compatible value."""
+
+    return sha256_text(canonical_json(value))
+
+
+def payload_checksum(payload: Mapping[str, Any]) -> str:
+    """Hash an artifact while blanking the self-referential checksum field."""
+
+    stable = dict(payload)
+    stable["reproducibility_checksum"] = ""
+    return sha256_json(stable)
+
+
+def build_fixture_instance(
+    *,
+    instance_id: str,
+    states: Sequence[str],
+    alphabet: Sequence[str],
+    start_state: str,
+    accepting_states: Sequence[str],
+    error_states: Sequence[str],
+    required_transitions: Sequence[tuple[str, str, str, str]],
+    forbidden_transitions: Sequence[tuple[str, str, str, str]],
+    trace_specs: Sequence[tuple[str, Sequence[str]]],
+    expected_status: str,
+) -> JsonDict:
+    """Build one schema-shaped FSM and derive reference labels exactly."""
+
+    constraints = [
+        _transition_constraint(cid, "require", source, symbol, target)
+        for cid, source, symbol, target in required_transitions
+    ]
+    constraints.extend(
+        _transition_constraint(cid, "forbid", source, symbol, target)
+        for cid, source, symbol, target in forbidden_transitions
+    )
+    total_pairs = len(states) * len(alphabet)
+    transition_sparsity = (
+        round((total_pairs - len(required_transitions)) / total_pairs, 6)
+        if total_pairs
+        else 0.0
+    )
+    machine: JsonDict = {
+        "schema_version": MACHINE_SCHEMA_VERSION,
+        "instance_id": instance_id,
+        "state_count": len(states),
+        "states": list(states),
+        "alphabet": list(alphabet),
+        "start_state": start_state,
+        "accepting_states": list(accepting_states),
+        "error_states": list(error_states),
+        "transition_sparsity": transition_sparsity,
+        "transition_constraints": constraints,
+        "observable_traces": [
+            {
+                "trace_id": trace_id,
+                "symbols": list(symbols),
+                "reference_label_source": "generated_by_exact_fsm_completion_analysis",
+            }
+            for trace_id, symbols in trace_specs
+        ],
+        "expected_status": expected_status,
+    }
+    return attach_reference_trace_labels(machine)
+
+
+def build_fixture_family() -> list[JsonDict]:
+    """Return the compact sat, unsat, and ambiguous FSM fixture family."""
+
+    return [
+        build_fixture_instance(
+            instance_id="fsm_sat_accept_error",
+            states=["S0", "S1", "S2"],
+            alphabet=["a", "b"],
+            start_state="S0",
+            accepting_states=["S2"],
+            error_states=["S1"],
+            required_transitions=[
+                ("TC_SAT_00", "S0", "a", "S1"),
+                ("TC_SAT_01", "S0", "b", "S2"),
+                ("TC_SAT_02", "S1", "a", "S1"),
+                ("TC_SAT_03", "S1", "b", "S1"),
+                ("TC_SAT_04", "S2", "a", "S2"),
+                ("TC_SAT_05", "S2", "b", "S2"),
+            ],
+            forbidden_transitions=[],
+            trace_specs=[
+                ("sat_empty_rejects", []),
+                ("sat_b_accepts", ["b"]),
