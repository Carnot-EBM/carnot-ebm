+        mod._first_blocker(
+            summarizer_present=True,
+            registry_present=False,
+            registry_loadable=False,
+            spec_has_req=False,
+            upstream_preconditions=upstream_present,
+        )
+        == "missing_registry"
+    )
+    assert (
+        mod._first_blocker(
+            summarizer_present=True,
+            registry_present=True,
+            registry_loadable=False,
+            spec_has_req=False,
+            upstream_preconditions=upstream_present,
+        )
+        == "registry_not_yaml_loadable"
