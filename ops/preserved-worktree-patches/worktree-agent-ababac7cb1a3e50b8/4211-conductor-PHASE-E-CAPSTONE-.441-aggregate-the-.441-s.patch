+def test_defensive_branches_and_registry_yaml_error_are_recorded(tmp_path: Path) -> None:
+    """SCENARIO-CAPSTONE-4799-BLOCKED-PRECONDITION: defensive branches fail closed."""
+
+    assert mod._int(True, 7) == 7
