+
+    upstream_present = {
+        key: {"present": True, "path": spec.relative_path}
+        for key, spec in mod.UPSTREAM_SOURCES.items()
+    }
+    assert (
+        mod._first_blocker(
+            summarizer_present=False,
+            registry_present=False,
+            registry_loadable=False,
+            spec_has_req=False,
+            upstream_preconditions=upstream_present,
