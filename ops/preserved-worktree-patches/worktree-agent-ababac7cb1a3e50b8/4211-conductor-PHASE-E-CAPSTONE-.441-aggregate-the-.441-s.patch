+        {
+            **artifact,
+            "flagged_artifacts_skipped": [{"experiment_id": 4791}],
+            "cited_upstream_artifacts": [
+                {
+                    "experiment_id": 4791,
+                    "fields_imported": ["energy_minus_accuracy_delta"],
+                    "sha256": "sha256:s2",
+                }
