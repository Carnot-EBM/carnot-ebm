+    assert unvalidated["patch_recommendation"] == "iterate"
+    mod.validate_artifact(unvalidated)
+
+    success = mod.build_artifact(
+        precondition_audit=_preconditions(),
+        registry_summary=_registry(),
+        live_attempt=_attempt(
