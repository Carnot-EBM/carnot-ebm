+    assert (
+        mod._run_command(ROOT, "adversarial_verification", ["adversarial"])["outcome"]
+        == "contract_defect"
+    )
+    monkeypatch.setattr(
+        mod.subprocess,
+        "run",
+        lambda *_args, **_kwargs: subprocess.CompletedProcess(["adversarial"], 1, "not json", ""),
+    )
+    assert (
+        mod._run_command(ROOT, "adversarial_verification", ["adversarial"])["outcome"]
+        == "contract_defect"
+    )
+    monkeypatch.setattr(
+        mod.subprocess,
+        "run",
+        lambda *_args, **_kwargs: (_ for _ in ()).throw(
