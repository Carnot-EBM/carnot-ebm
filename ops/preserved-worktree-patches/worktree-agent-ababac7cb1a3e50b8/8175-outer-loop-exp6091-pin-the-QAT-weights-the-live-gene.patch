-        "snapshots/f130ba51393346288f5862e30e9586b9b021513f/gemma-4-31B-it-Q4_K_M.gguf"
-    ),
+    "repo_substr": _LIVE_REPO_SUBSTR,
+    "hf_id": _LIVE_HF_ID,
+    "gguf": _resolve_live_gguf(),
     "kv_quant": "q8_0",
     "timeout": 1800,
 }
