+- id: exp6819-arc-stepwise-strategy-accrual
+  title: Stepwise read-only strategy-supervisor accrual
+  track: agentic-harness
+  priority: critical
+  agent_type: claude
+  model: opus
+  requires_gpu: true
+  max_turns: 100
+  estimated_wall_time_min: 480
+  per_unit_rows: true
+  milestone: 2026.08.595
+  deliverable: results/experiment_6819_arc_stepwise_strategy_accrual.json
