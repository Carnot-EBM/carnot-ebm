+def _server_healthy(port: int = TERNARY_BONSAI_PORT, *, timeout_s: float = 2.0) -> bool:
+    try:
+        with urllib.request.urlopen(f"http://127.0.0.1:{port}/health", timeout=timeout_s) as r:
+            return b"ok" in r.read()
+    except Exception:
+        return False
