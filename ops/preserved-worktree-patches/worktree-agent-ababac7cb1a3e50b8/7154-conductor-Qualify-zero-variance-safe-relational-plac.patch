+def _mask(shape: tuple[int, int], coords: Sequence[tuple[int, int]]) -> list[list[bool]]:
+    mask = np.zeros(shape, dtype=bool)
+    for y, x in coords:
+        mask[int(y), int(x)] = True
+    return mask.tolist()
