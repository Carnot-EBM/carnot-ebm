+        "experiment_4247_verifier_reward_offline_harness_retire_livelora.json",
+        "experiment_4248_verifier_as_reward_offline_3arm.json",
+    ):
+        shutil.copy2(REPO_ROOT / "results" / name, tmp_path / "results" / name)
