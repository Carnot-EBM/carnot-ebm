+def _write_minimal_repo(tmp_path: Path) -> None:
+    (tmp_path / "ops").mkdir()
+    (tmp_path / "results").mkdir()
+    (tmp_path / "ops" / "verifier_registry.yaml").write_text(
+        yaml.safe_dump(_minimal_registry(), sort_keys=False),
+        encoding="utf-8",
