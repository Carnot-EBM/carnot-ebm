+    bad_local_sota = deepcopy(artifact)
+    bad_local_sota["truth_table"][1]["classification"] = "headline_ready"
+    with pytest.raises(ValueError, match="flagged local SOTA"):
+        exp.validate_artifact(bad_local_sota)
+
