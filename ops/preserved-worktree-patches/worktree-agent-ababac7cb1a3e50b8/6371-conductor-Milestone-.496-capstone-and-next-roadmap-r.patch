+JsonMap = Mapping[str, Any]
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+RESULT_RELATIVE_PATH = Path("results/experiment_5467_capstone_v496.json")
+EXPERIMENT = "experiment_5467_capstone_v496"
