+def test_scenario_phase4_4384_missing_env_continues_other_games(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """SCENARIO-PHASE4-4384: missing envs block per game without fabrication."""
+
+    for game in ("ka59", "ft09"):
