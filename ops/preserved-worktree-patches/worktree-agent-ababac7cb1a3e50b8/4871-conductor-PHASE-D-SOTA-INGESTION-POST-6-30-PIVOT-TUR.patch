+def test_req_kona_4984_spec_declares_turnkey_backlog_contract() -> None:
+    """REQ-KONA-4984: OpenSpec anchors paths, fields, papers, and guardrails."""
+
+    section = _spec_section()
+
+    for marker in (
+        "REQ-KONA-4984",
+        "SCENARIO-KONA-4984-TURNKEY-BACKLOG",
+        "SCENARIO-KONA-4984-BLOCKED",
+        "SCENARIO-KONA-4984-VALIDATION-GATE",
+        mod.RESULT_RELATIVE_PATH,
+        mod.MODULE_RELATIVE_PATH,
+        mod.ENTRYPOINT_COMMAND,
+        "research-studying.md",
+        "scripts/research_conductor.py",
+        "ops/changelog.md",
+        "ops/status.md",
+        "_bmad/traceability.md",
+        "self_consistency",
+        "decomposed_energy_verifier",
+        "oracle",
+        "pivot_turnkey",
+        "post_sprint_first_experiment_pointer",
+        "verifier_is_oracle",
+        "false",
+        "moat_proven_claimed=false",
+        mod.HONEST_VERDICT,
+        "discriminative verifier-under-budget",
+        "unify-generation-and-self-verification",
+    ):
+        assert marker in section
+    for arxiv_id in mod.ARXIV_IDS:
+        assert arxiv_id in section
+    for field, principle in mod.REQUIRED_USER_FIELD_PRINCIPLES.items():
+        assert field in section
+        assert principle["principle"] in section
