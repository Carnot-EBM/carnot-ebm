+        "kill_gate_design_documented": False,
+        "loop_does_not_seed": True,
+        "edlm_remains_operator_gated": True,
+        "operator_curated_doc_unedited": True,
+        "cited_upstream_artifacts": [],
+        "precondition_status": {
