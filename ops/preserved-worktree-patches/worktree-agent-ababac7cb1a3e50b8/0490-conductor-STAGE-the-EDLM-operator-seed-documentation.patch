+                "readiness_verdict": "go",
+                "minimal_kill_gate_sound": True,
+                "operator_seed_command": OPERATOR_SEED_COMMAND,
+                "loop_does_not_commit": True,
+                "random_seed": 3793,
+                "reproducibility_checksum": "2" * 64,
+            },
+        )
