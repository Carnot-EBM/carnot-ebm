 ops/conductor-heartbeat.json | 2 +-
 ops/conductor-state.json     | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/ops/conductor-heartbeat.json b/ops/conductor-heartbeat.json
index 63a8277143..be91d21e79 100644
--- a/ops/conductor-heartbeat.json
+++ b/ops/conductor-heartbeat.json
@@ -1 +1 @@
-{"pid": 1330, "iteration": 14, "phase": "iteration_start", "last_beat": "2026-07-24T21:21:59Z"}
\ No newline at end of file
+{"pid": 127403, "iteration": 1, "phase": "iteration_start", "last_beat": "2026-07-24T21:27:10Z"}
\ No newline at end of file
diff --git a/ops/conductor-state.json b/ops/conductor-state.json
index 0701801ce3..46b6b99a7e 100644
--- a/ops/conductor-state.json
+++ b/ops/conductor-state.json
@@ -1 +1 @@
-{"pid": 1330, "iteration": 14, "phase": "iteration_start", "started_at": "2026-07-24T21:21:59Z"}
\ No newline at end of file
+{"pid": 127403, "iteration": 1, "phase": "iteration_start", "started_at": "2026-07-24T21:27:10Z"}
\ No newline at end of file
