+def _guard_current(guard: Mapping[str, Any]) -> Mapping[str, Any]:
+    current = guard.get("current")
+    if isinstance(current, Mapping):
+        return current
+    replayed = guard.get("replayed_arc1_rule_exec")
+    if isinstance(replayed, Mapping):
+        return replayed
+    return {}
