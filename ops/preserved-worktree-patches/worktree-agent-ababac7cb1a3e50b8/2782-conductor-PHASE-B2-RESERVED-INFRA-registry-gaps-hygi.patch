+    gaps: list[dict[str, Any]] = []
+    for raw in raw_gaps:
+        if not isinstance(raw, Mapping):
+            continue
+        game = str(raw.get("game") or payload.get("target_game") or "unknown")
+        gap_id = str(raw.get("gap_id") or f"GAP-4435-FIRST-CONTACT-{_slug(game)}")
+        gaps.append(
+            _gap_entry(
