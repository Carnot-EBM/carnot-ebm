+INFERENCE_SUBSTRATE = "aggregation_from_upstream_artifacts"
+RANDOM_SEED = 5702
+LIVE_THRESHOLD = 1.0
+EXCLUDED_EXPERIMENT_SUBSTRINGS = ("5700",)  # deliberately-bypassed-threshold isolation test
+
