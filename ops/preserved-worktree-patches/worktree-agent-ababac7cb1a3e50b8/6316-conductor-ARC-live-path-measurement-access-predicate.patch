+def run_live_measurement_access_attempt(  # pragma: no cover - ARC runtime boundary
+    *,
+    root: Path,
+    selection: Mapping[str, Any],
+    budget: int = DEFAULT_BUDGET,
+) -> dict[str, Any]:
