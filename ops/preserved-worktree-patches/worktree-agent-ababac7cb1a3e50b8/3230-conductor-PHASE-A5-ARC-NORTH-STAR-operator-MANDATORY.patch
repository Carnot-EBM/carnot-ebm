+def test_req_arc_wmte_4548_success_requires_integrated_gain_and_core_preservation() -> None:
+    """REQ-ARC-WMTE-4548: submit readiness needs accepted levers and a gate lift."""
+
+    decision = exp4548.select_integrated_levers(
