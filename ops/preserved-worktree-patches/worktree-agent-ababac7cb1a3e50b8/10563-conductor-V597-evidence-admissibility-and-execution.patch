+    phase_clocks: dict[str, dict[str, object]],
+    runtime_receipts: tuple[dict[str, object], dict[str, object]],
+) -> dict[str, object]:
+    payloads, hashes = source_bundle
+    launch, accelerator = runtime_receipts
+    return exp.build_contract(
+        payloads,
+        hashes.copy(),
+        hashes.copy(),
+        run_date="20260831",
