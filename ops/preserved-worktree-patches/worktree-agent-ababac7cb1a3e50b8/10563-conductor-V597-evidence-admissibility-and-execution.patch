+) -> None:
+    """SCENARIO-CONSTRAINT-6831-HASH-STABILITY rejects changed source bytes."""
+    payloads, hashes = source_bundle
+    changed = hashes.copy()
+    changed["exp6827"] = "sha256:" + "0" * 64
+    artifact = exp.build_contract(
