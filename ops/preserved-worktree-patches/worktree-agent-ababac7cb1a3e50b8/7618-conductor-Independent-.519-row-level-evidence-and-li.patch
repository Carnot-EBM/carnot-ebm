+
+    for mutate, match in (
+        (lambda item: item.update({"historical_artifacts_mutated": True}), "historical_artifacts_mutated"),
+        (lambda item: item.update({"inference_substrate": "aggregation_from_upstream_artifacts"}), "inference_substrate"),
