+        bad = deepcopy(artifact)
+        mutate(bad)
+        with pytest.raises(ValueError, match=match):
+            mod.validate_artifact(bad)
+
+    missing = deepcopy(artifact)
+    missing.pop("status")
+    with pytest.raises(ValueError, match="missing required artifact fields"):
