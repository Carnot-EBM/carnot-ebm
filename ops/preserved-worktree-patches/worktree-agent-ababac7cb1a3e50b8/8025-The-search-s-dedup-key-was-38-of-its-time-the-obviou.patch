@@ -0,0 +1,522 @@
+{
+  "experiment": "outer_loop_arc_state_key_dedup_xgame_20260730",
+  "title": "The in-model search's duplicate-state key, replaced in NumPy: cross-game proof that the partition is unchanged, and the measured refutation of the obvious plain-bytes swap",
+  "honest_verdict": "complete_state_key_is_partition_identical_to_to_ascii_on_all_10_games_tested_by_accept_trace_hash_yes_and_1_28x_to_7_18x_faster_on_the_4_with_a_usable_timing_signal_while_the_plain_bytes_key_that_looks_like_the_obvious_swap_is_refuted_because_it_changes_the_search_on_cn04",
+  "run_date": "2026-07-30",
+  "schema": "carnot.arc_state_key_dedup_xgame.v1",
+  "requirements": [
+    "REQ-ARC-WMTE-6051"
+  ],
+  "inference_substrate": "aggregation_from_upstream_artifacts",
+  "inference_substrate_principle": "THIS FILE is a builder: it reads the persisted measurement rows and formats them. It steps no environment and loads no model, so its own duration_s is milliseconds. An earlier draft declared the MEASUREMENT's substrate (offline_arcade_live_agent_runtime_self_discovery_no_llm) here and was correctly flagged CRITICAL DURATION_TOO_SHORT by adversarial_verify -- the builder's 0.0019s is far below that substrate's 0.01s floor. That flag was the REQ-ARC-WMTE-6050 check landed hours earlier in this same session doing exactly its job, on its author. The substrate is corrected rather than the duration adjusted, and the row file that DOES carry the no-LLM-substrate measurement is committed and cited below.",
+  "rows_source": [
+    "results/arc_state_key_dedup_rows_20260730/rows_cap20000.json"
+  ],
+  "rows_source_principle": "The raw per-arm rows are committed alongside so the aggregation's every number is recomputable by a third party without re-running the 40-minute measurement, and so this file cannot silently drift from what was measured.",
+  "cited_upstream_artifacts": [
+    {
+      "path": "results/arc_state_key_dedup_rows_20260730/rows_cap20000.json",
+      "fields_imported": [
+        "games.*.arms.*.engine_calls",
+        "games.*.arms.*.unique_states",
+        "games.*.arms.*.accept_trace_sha256",
+        "games.*.arms.*.wall_clock_s",
+        "games.*.arms.*.termination_reason"
+      ],
+      "sha256": "0cc3364b2eeb67c892014fe721af22f2001aab89bc93c189a047b81a626b1428"
+    }
+  ],
+  "is_a_solve_claim": false,
+  "is_a_solve_claim_principle": "Some rows report plan_found because the search reached its induced goal predicate inside the MODEL. That is not a banked level: nothing was executed against the real env and no level was reproduced. Declaring it false keeps this out of the solve-claim ledger.",
+  "banked_levels": 0,
+  "solve_provenance": "development_proxy",
+  "solve_provenance_principle": "An outer-loop measurement over already-induced engines. It changes no live capability by itself and must not be read as evidence the live agent self-discovered anything.",
+  "verifier_is_oracle": false,
+  "read_game_source": false,
+  "used_env_source": false,
+  "question": "The dedup key is 38% of in-model search time. Does replacing it with a NumPy key preserve the search EXACTLY, on more than the one game it was tuned on -- and is the obvious plain-tobytes() version safe to ship?",
+  "FINDING_1_the_obvious_swap_is_wrong": {
+    "claim": "A plain g.tobytes() key is NOT a drop-in. to_ascii keeps only each cell's LAST DIGIT, so it MERGES colours 4/14, 5/15, 1/11 and 0/10; plain bytes separate them, giving a strictly finer partition and a different search.",
+    "measured_consequence": {
+      "games_where_plain_bytes_changes_the_search": [
+        "cn04"
+      ],
+      "cn04_engine_calls_to_ascii": 93,
+      "cn04_engine_calls_plain_bytes": 140,
+      "cn04_unique_states_to_ascii": 9,
+      "cn04_unique_states_plain_bytes": 14
+    },
+    "why_it_matters": "Shipped as 'a faster key', it would have altered which states the search explores while every count that a casual check looks at stayed plausible. The aliasing colours are present in the ROOT grids of ka59, lp85, cn04, sp80, sc25, sk48, tu93 and re86, so the exposure is corpus-wide and not a cn04 curiosity.",
+    "what_was_shipped_instead": "(g % 10) on a fast path guarded to NON-NEGATIVE 2-D integer grids, with every other input deferred to to_ascii itself, so equivalence holds by construction.",
+    "SECOND_BUG_CAUGHT_BY_ADVERSARIAL_REVIEW_BEFORE_SHIPPING": {
+      "what_was_wrong": "The first implementation took the arithmetic fast path for ANY integer grid, and this artifact, the module docstring, the spec, the ops docs and the whole test file all asserted that % 10 reproduced to_ascii 'for every integer, negatives included'. That was FALSE.",
+      "why": "to_ascii takes the last character of the DECIMAL STRING, i.e. the last digit of the ABSOLUTE value: str(-1)[-1] == '1'. But -1 % 10 == 9. The two agree only where a digit is its own complement mod 10 -- 0 and 5 -- so they DISAGREE on 12 of the 16 values in -15..-1, and -1 and 9 (distinct states under to_ascii) would have been merged into one.",
+      "why_no_test_caught_it": "Every test used non-negative colours, because every real ARC grid does. This is the 'tests test what the author thought to test' mode named in CLAUDE.md's QA-Layer Authenticity Discipline -- the same mode that produced REQ-ARC-WMTE-6050 earlier in this session.",
+      "fix": "The fast path is guarded a.min() >= 0 and negatives fall back to to_ascii itself. np.abs(a) % 10 would have matched everywhere EXCEPT at a dtype's most negative value, where abs silently overflows -- not worth taking on for input that does not occur in ARC grids.",
+      "practical_exposure": "ZERO on the measured corpus: every root grid observed is non-negative, so the fast path is taken throughout and the cross-game numbers below are unaffected. The bug was latent, not active -- which is exactly why it survived every test."
+    }
+  },
+  "FINDING_2_partition_identity_across_games": {
+    "n_games": 10,
+    "all_landed_state_key_partitions_identical": true,
+    "EVIDENCE_WEIGHT_IS_NOT_UNIFORM_read_this_before_citing_ten": "'Identical on all ten' is true but must not be read as ten equally strong observations. Only FOUR games (ka59, lp85, sc25, sk48) ran to the 20,000-call cap and explored 887-1,994 distinct states; those carry the weight. The other six exhausted their search queue after 1-148 engine calls because their CURRENT on-disk engines are near-inert, so their partition agreement, while real, is close to vacuous -- agreeing over 16 engine calls is weak evidence about a key. The substantive claim is therefore 'partition-identical on four games covering 4,750 distinct states and ~80,000 engine calls, corroborated on six more', not 'verified on ten'. Notably the ONE game where the plain-bytes key diverges (cn04) is itself a 93-call game -- so a divergence CAN surface even in the thin rows, which is why they are reported rather than dropped.",
+    "n_games_with_substantive_exploration": 4,
+    "how_proved": "Not by comparing totals -- two different partitions can coincidentally agree on engine_calls and unique_states. Each arm records an ACCEPT TRACE: one entry per engine call, in order, for what the search DECIDED (A accepted / D duplicate / S shape skip / E engine raised). That sequence is key-INDEPENDENT and is the complete record of the key's influence, so an equal SHA256 means the identical search ran."
+  },
