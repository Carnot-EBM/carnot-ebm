+#!/usr/bin/env python3
+"""Run exact candidate certification and calibration-only schedule selection.
+
+Spec ref: REQ-VERIFY-6976.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+import sys
+
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+PYTHON_ROOT = REPO_ROOT / "python"
+if str(PYTHON_ROOT) not in sys.path:
+    sys.path.insert(0, str(PYTHON_ROOT))
+
+from carnot.experiment_6976_exact_candidate_certification import main
+
+
+if __name__ == "__main__":  # pragma: no cover - this file is the required command surface.
+    raise SystemExit(main())
