+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """SCENARIO-LEARN-5894-FAIL-CLOSED: unsafe, leaky, or null evidence cannot promote."""
+
+    blocked = mod.run(
+        root=tmp_path,
+        result_path=tmp_path / mod.RESULT_RELATIVE_PATH.name,
+        duration_s=3.0,
