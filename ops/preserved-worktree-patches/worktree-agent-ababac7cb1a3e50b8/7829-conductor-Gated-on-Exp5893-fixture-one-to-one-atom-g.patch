+    assert mod.validate_artifact(blocked) is True
+
+    failed_tests = mod.run(
+        result_path=tmp_path / "failed.json",
+        preconditions_checked=_preconditions(tmp_path / "failed"),
+        duration_s=3.0,
+        test_commands=TEST_COMMANDS,
