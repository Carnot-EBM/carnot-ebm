+        for variable in active_boundary.variables
+    }
+    groups = {
+        "a_one_hot": {
+            "group_id": "a_one_hot",
+            "group_type": "one_hot_domain",
+            "variables": [
+                bit
+                for bit in active_boundary.bit_order
+                if bit.startswith("a_")
+            ],
+            "clause_indices": [],
+            "authority": "Minisat22 CDCL over original CNF",
+        },
+        "b_one_hot": {
