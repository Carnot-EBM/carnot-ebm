+def _refresh_rows(receipt: dict[str, object]) -> None:
+    rows = receipt["rows"]
+    assert isinstance(rows, list)
+    receipt["rows"] = [receipts.seal_adoption_row(row) for row in rows]
+    receipt["receipt_sha256"] = receipts.sha256_json(receipt["rows"])
+
