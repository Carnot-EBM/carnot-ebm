+    exp6325 = read_json_object(root, HISTORICAL_ARTIFACT_PATHS[2])
+    return {
+        "baseline_artifact": HISTORICAL_ARTIFACT_PATHS[2].as_posix(),
+        "baseline_run_date": exp6325.get("run_date") or EXP6325_RUN_DATE,
