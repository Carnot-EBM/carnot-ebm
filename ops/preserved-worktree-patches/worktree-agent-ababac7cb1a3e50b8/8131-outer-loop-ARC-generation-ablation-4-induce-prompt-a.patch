+    start_r = py - 1
+    start_c = px - 1
+    
+    # Bounds check
+    end_r = min(start_r + 3, new_grid.shape[0])
+    end_c = min(start_c + 3, new_grid.shape[1])
+    actual_start_r = max(0, start_r)
+    actual_start_c = max(0, start_c)
