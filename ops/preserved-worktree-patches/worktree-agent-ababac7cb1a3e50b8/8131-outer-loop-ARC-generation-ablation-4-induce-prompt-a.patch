+        if len(cells) == 0:
+            continue
+            
+        # BFS to check connectivity
+        start_node = tuple(cells[0])
+        visited = {start_node}
+        queue = [start_node]
+        
+        while queue:
+            current = queue.pop(0)
+            r, c = current
+            for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]:
+                nr, nc = (r + dr, c + dc)
+                if 0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1]:
