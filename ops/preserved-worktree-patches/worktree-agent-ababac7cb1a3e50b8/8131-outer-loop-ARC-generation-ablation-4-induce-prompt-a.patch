+    
+    r_min, c_min = coords.min(axis=0)
+    r_max, c_max = coords.max(axis=0)
+    
+    # Define movement offsets based on observed transitions
+    # Action 2: Down
+    # Action 3: Left
+    # Action 4: Right
+    dr, dc = 0, 0
+    if action == 2:
