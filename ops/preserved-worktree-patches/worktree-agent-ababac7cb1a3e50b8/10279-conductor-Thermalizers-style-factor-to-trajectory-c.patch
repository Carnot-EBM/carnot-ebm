+def test_req_hw_6751_scientific_gate_reports_each_owned_row_failure(rows: list[dict]) -> None:
+    """REQ-HW-6751-COMPLETION: Each internal gate reports observed evidence."""
+
+    changed_rows = deepcopy(rows[:-1])
