+def test_scenario_capstone_7027_solve_provenance_and_duplicates() -> None:
+    """SCENARIO-CAPSTONE-7027-ARC excludes proxies and registry duplicates."""
+
+    registry = {"games": {"g1": {"levels_reproduced": 2}}}
