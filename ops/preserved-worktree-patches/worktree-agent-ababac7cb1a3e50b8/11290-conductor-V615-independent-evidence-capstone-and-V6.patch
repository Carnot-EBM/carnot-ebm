+def test_source_loader_preserves_missing_unreadable_and_non_mapping(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """SCENARIO-CAPSTONE-7027-UPSTREAM-STATES records bad source shapes."""
