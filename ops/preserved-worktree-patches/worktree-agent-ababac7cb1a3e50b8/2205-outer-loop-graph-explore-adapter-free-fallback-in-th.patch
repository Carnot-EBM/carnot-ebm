+    }
+  ],
+  "guidance": "Start from the top-ranked solved game's solver + reuse its action-model and gotchas; only reverse-engineer the DELTA. Import arc_solver_kit; run the reproduction gate; append new mechanics/dead-ends to the registry.",
+  "instruction": "Reverse-engineer this game's win/action/state DELTA reusing the routed recipe, register a GameAdapter in arc_game_adapters.py, then re-run this loop. Per CLAUDE.md ARC Solve Reproducibility + Solver-Reuse Discipline.",
+  "mode": "standing_arc_loop_routing_only"
+}
