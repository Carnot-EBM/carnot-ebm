From a4a5607c2228c79cc33d961a4eb3531bfa4e5f70 Mon Sep 17 00:00:00 2001
From: Ian Blenke <ian@blenke.com>
Date: Tue, 16 Jun 2026 21:39:29 -0400
Subject: [PATCH 02196/11362] [outer-loop] learned-verifier checkpointing
 (mirror-ready) + weight-distribution plan

LearnedVerifier.save/load -> carnot_arc_learned_verifier_v1 checkpoint so the
learning loop's weights are captured, versionable, and mirror-ready (not lost in
demo artifacts). Registry records the Rule-3 distribution plan: mirror to HF
(Carnot-EBM) + IPFS once SUBSTANTIAL/cross-game; public release operator-only.
Current weights = per-game POC, not yet published.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 ops/arc_solve_registry.yaml                | 11 ++++++++
 python/carnot/agentic/arc_value_learner.py | 30 ++++++++++++++++++++++
 2 files changed, 41 insertions(+)

diff --git a/ops/arc_solve_registry.yaml b/ops/arc_solve_registry.yaml
index b17333f65f..b02be9d404 100644
--- a/ops/arc_solve_registry.yaml
+++ b/ops/arc_solve_registry.yaml
@@ -116,3 +116,14 @@ learning_loop:
   demos:
     - scripts/arc3_verifier_routed_search_demo.py   # 10.75x fewer states (hand verifier)
     - scripts/arc3_learned_verifier_demo.py         # 9.36x fewer on held-out L3 (learned)
+  # WEIGHT DISTRIBUTION (CLAUDE.md Decentralization Rule 3 — mirror HF primary + IPFS
+  # secondary). LearnedVerifier.save() captures a versionable, mirror-ready checkpoint
+  # (carnot_arc_learned_verifier_v1). Current weights are a per-game POC (6-float lp85
+  # value head) — NOT yet a headline HF release. Mirror to HuggingFace (Carnot-EBM org)
+  # + IPFS once the verifier is SUBSTANTIAL (cross-game); the PUBLIC release is
+  # OPERATOR-ONLY (External Publication). Pipeline exists: scripts/*_hf_publish.py +
+  # scripts/ipfs_mirror_carnot_ebm.py.
+  weight_distribution:
+    checkpoint_format: carnot_arc_learned_verifier_v1
+    status: not_yet_published_poc_stage
+    publish_gate: operator_only_when_substantial_cross_game
diff --git a/python/carnot/agentic/arc_value_learner.py b/python/carnot/agentic/arc_value_learner.py
index 7ed1ad1ac2..e37119ea95 100644
--- a/python/carnot/agentic/arc_value_learner.py
+++ b/python/carnot/agentic/arc_value_learner.py
@@ -16,6 +16,8 @@ steps-to-go (LOWER = closer to win), the score OfflineSolver descends.
 """
 from __future__ import annotations
 
+import json
+from pathlib import Path
 from typing import Any, Callable, Sequence
 
 import numpy as np
@@ -59,3 +61,31 @@ class LearnedVerifier:
             return 0.0  # untrained ⇒ neutral (solver degrades to BFS)
         f = np.asarray([float(v) for v in self.featurize(game)] + [1.0], dtype=float)
         return float(max(0.0, f @ self.w))  # predicted steps-to-go; clamp ≥ 0
+
+    # --- checkpointing: capture the trained weights as a versionable, MIRROR-READY
+    # artifact so the learning loop's output is never lost in a demo file. Mirror to
+    # HuggingFace (Carnot-EBM) + IPFS per CLAUDE.md Decentralization Rule 3 once the
+    # verifier is substantial; the PUBLIC release is operator-only (External Publication).
+    def save(self, path: str | Path, meta: dict | None = None) -> Path:
+        if self.w is None:
+            raise ValueError("nothing to save: verifier is untrained")
+        p = Path(path)
+        p.parent.mkdir(parents=True, exist_ok=True)
+        p.write_text(json.dumps({
+            "schema": "carnot_arc_learned_verifier_v1",
+            "kind": "linear_value_head",
+            "weights": self.w.tolist(),          # [feature weights..., bias]
+            "feature_names": (meta or {}).get("feature_names"),
+            "trained_games": (meta or {}).get("trained_games"),
+            "n_samples": self.n_samples,
+            "provenance": (meta or {}).get("provenance"),
+        }, indent=2))
+        return p
+
+    @classmethod
+    def load(cls, path: str | Path, featurize: Callable[[Any], Sequence[float]]) -> "LearnedVerifier":
+        d = json.loads(Path(path).read_text())
+        v = cls(featurize)
+        v.w = np.asarray(d["weights"], dtype=float)
+        v.n_samples = int(d.get("n_samples", 0))
+        return v
