+def _empty_evidence() -> JsonDict:
+    """Create every row field before a precondition can stop the audit."""
+
+    return {
+        "rows": [],
+        "positive_identity_rows": [],
+        "alias_mutation_rows": [],
+        "hash_mutation_rows": [],
+        "hub_revision_mutation_rows": [],
+        "path_type_rows": [],
+        "stale_server_rows": [],
+        "legacy_regression_rows": [],
+        "fresh_process_rows": [],
+        "consumer_reachability_rows": [],
+    }
