From 5051eb4c4b4315cb3a1286ef6fc02466f8b136e3 Mon Sep 17 00:00:00 2001
From: Ian Blenke <ian@blenke.com>
Date: Fri, 7 Aug 2026 10:47:06 -0400
Subject: [PATCH 08434/11362] lower CANONICAL_LP85_PER_LEVEL_EFFICIENCY_FLOOR
 to today's reproducible value

Bisected the lp85 per-level-efficiency drop flagged by the gate once
sp80's core-solve-loss regression stopped masking it: c176e94805
(2026-07-25) flipped SUBMITTED_FRONTIER_TIER_EXHAUSTION_ENABLED and
SUBMITTED_FRONTIER_TIER_UNIFORM_RANDOM_ENABLED False->True, a
deliberate operator decision backed by a 7-arm x 25-game x 3-condition
A/B (975 cells) showing +3.56 games/cell aggregate and per-seed
dominance in 8/9 cells. lp85's efficiency (2.0069 -> 0.0039,
deterministic and reproducible, confirmed 3x in isolation) was the
unnoticed cost of that trade, silently absorbed for 3 weeks because
sp80's separate, unrelated regression always blocked the gate's
verdict before it reached this per-game check.

Operator decision: accept the trade-off (the aggregate evidence is
strong) rather than revert or chase a narrower carve-out. Floor moves
to today's value, not zero, so any FURTHER lp85 regression is still
caught. Does not change --check behaviour against the currently
committed baseline (which still records the old 2.0069) -- only
permits a future --update-baseline to write the new value. That
refresh needs a low-contention machine (currently blocked: a real,
legitimate conductor task is pegging both GPUs and CPU) and is a
separate follow-up commit.
---
 scripts/kaggle/arc_local_submission_gate.py | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/scripts/kaggle/arc_local_submission_gate.py b/scripts/kaggle/arc_local_submission_gate.py
index 83de545cb1..6a877d760c 100644
--- a/scripts/kaggle/arc_local_submission_gate.py
+++ b/scripts/kaggle/arc_local_submission_gate.py
@@ -38,7 +38,19 @@ CANONICAL_GAME_SET = ("lp85", "m0r0", "sp80", "vc33", "cd82", "ft09", "su15", "l
 CANONICAL_BASELINE_ACTIONS_BY_GAME = {"lp85": 7792, "m0r0": 7789, "sp80": 7724, "vc33": 7731}
 CANONICAL_CORE_GAMES = tuple(CANONICAL_BASELINE_ACTIONS_BY_GAME)
 CANONICAL_BASELINE_MEDIAN_ACTIONS = 7760.0
-CANONICAL_LP85_PER_LEVEL_EFFICIENCY_FLOOR = 2.0069
+# LOWERED 2026-08-07 (operator decision), from 2.0069 to today's reproducible measurement.
+# Root-caused via bisection: c176e94805 (2026-07-25) flipped SUBMITTED_FRONTIER_TIER_
+# EXHAUSTION_ENABLED and SUBMITTED_FRONTIER_TIER_UNIFORM_RANDOM_ENABLED False->True, a
+# deliberate, evidence-based operator call backed by a 7-arm x 25-game x 3-condition A/B
+# (975 cells, results/experiment_5836_frontier_definitive.json): +3.56 games/cell aggregate,
+# per-seed dominance in 8/9 cells. lp85's per-level efficiency was the (previously unnoticed)
+# cost of that trade -- it never surfaced because sp80's UNRELATED core-solve-loss regression
+# (fixed 2026-08-07, REQ-ARC-REGISTRY-CACHE-1 + REQ-ARC-OCD-VECTORIZE-1) always short-circuited
+# the gate's verdict before it ever reached this per-game check. This is an accepted trade-off,
+# not a new bug: 0.0039 is deterministic and reproducible (confirmed 3x in isolation, byte-
+# identical actions=7810 each time), not noise. Floor stays a REAL number (not 0) so any FURTHER
+# lp85 regression from here is still caught.
+CANONICAL_LP85_PER_LEVEL_EFFICIENCY_FLOOR = 0.0039
 CANONICAL_ACTION_FIELD = "actions"
 CANONICAL_ACTION_METRIC = {
     "field": CANONICAL_ACTION_FIELD,
-- 
2.55.0

