+def _clean_lanes(artifacts: Mapping[str, JsonMap]) -> list[JsonDict]:
+    source = artifacts["source_delta"]
+    taxonomy = artifacts["sota_taxonomy"]
+    repair = artifacts["sota_repair"]
+    csl_gate = artifacts["csl_gate"]
