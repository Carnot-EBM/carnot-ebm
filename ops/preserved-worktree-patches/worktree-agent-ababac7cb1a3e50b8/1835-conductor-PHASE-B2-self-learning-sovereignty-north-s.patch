+def demo_fit(fn: Callable[[Any], np.ndarray | None], demos: list[dict[str, Any]]) -> float:
+    hits = 0
+    for pair in demos:
+        out = fn(pair["input"])
+        if out is not None and np.array_equal(out, np.asarray(pair["output"], dtype=np.int64)):
+            hits += 1
+    return hits / max(1, len(demos))
+
