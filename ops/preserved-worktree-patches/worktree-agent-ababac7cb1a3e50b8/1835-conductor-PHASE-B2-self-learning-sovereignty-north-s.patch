+def test_req_verify_4212_blocks_missing_sota_gguf(tmp_path: Path) -> None:
+    # REQ-VERIFY-4212: cached_sota_pair() is the local GGUF precondition.
+    pool_path = tmp_path / "pool.json.gz"
