+def _thesis_states() -> set[str]:
+    efficiency_parts = {
+        "deepened_stronger_class": "efficiency_moat_deepened",
+        "linear_is_settled": "linear_settled",
+        "open": "efficiency_open",
+    }
+    s3_parts = {
