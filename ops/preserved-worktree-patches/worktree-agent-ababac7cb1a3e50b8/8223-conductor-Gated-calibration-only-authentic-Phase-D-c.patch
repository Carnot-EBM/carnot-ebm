+        },
+        "prefix_chain": chain,
+        "terminal_prefix_hash": chain[-1]["prefix_hash"] if chain else "",
+        "raw_generation_preserved": all(bool(row.get("raw_generation")) for row in rows),
+        "parser_failure_is_retry_trigger": False,
+        "hidden_label_retry_count": 0,
