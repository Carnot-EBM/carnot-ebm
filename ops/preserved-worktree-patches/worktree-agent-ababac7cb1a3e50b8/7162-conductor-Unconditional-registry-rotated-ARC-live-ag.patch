+def _success_attempt() -> dict[str, Any]:
+    rows = [
+        {
+            "step": 0,
+            "kind": "RESET",
+            "action": None,
+            "data": None,
+            "level_before": None,
+            "level_after": 0,
+        },
+        {
+            "step": 1,
+            "kind": "ACTION",
+            "action": 1,
+            "data": None,
+            "label": '{"action":1,"data":null}',
+            "level_before": 1,
+            "level_after": 2,
