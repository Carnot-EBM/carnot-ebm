+            "hand_solution_used": True,
+            "registry_delta": -1,
+            "registry_count_after": 999,
+            "offline_reproduced": True,
+            "independent_reproduction_pass": False,
+            "reproduced_levels": 0,
+            "reproduction_receipts": [],
