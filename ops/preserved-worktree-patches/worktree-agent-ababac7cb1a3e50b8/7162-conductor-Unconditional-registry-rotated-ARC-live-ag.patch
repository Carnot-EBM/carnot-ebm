+    assert trajectory["visible_observations"] == attempt["observations"]
+    assert trajectory["actions"] == attempt["action_rows"]
+    assert trajectory["rewards"] == [0, 1]
+    assert trajectory["environment_actions"] == attempt["environment_actions"]
