+        artifact=artifact,
+    )
+
+    assert mod._baseline_filter_configuration()["baseline_unchanged"] is True
+    assert flags == [
+        "llm_used",
+        "game_source_read",
+        "game_adapter_used",
+        "outer_loop_bfs_used",
+        "hand_solution_used",
