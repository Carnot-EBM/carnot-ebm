+            artifact["prefix_exact_accuracy"] - artifact["heldout_exact_accuracy"]
+        )
+    artifact["paired_control_delta_rows"] = paired_control_deltas(
+        [row for row in engine_rows if str(row["transition_id"]) in heldout_ids],
