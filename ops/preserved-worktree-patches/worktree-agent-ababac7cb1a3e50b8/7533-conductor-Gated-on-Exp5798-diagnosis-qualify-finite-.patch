+"""Tests for Exp5799 matched SOTA answer-channel canary.
+
+Spec refs: REQ-VERIFY-5799, SCENARIO-VERIFY-5799,
+SCENARIO-VERIFY-5799-CONTROLS.
+"""
+
+from __future__ import annotations
+
+from copy import deepcopy
+import json
