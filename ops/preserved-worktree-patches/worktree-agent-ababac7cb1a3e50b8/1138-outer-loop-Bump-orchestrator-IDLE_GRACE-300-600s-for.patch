+def research_complete_yaml_command() -> list[str]:
+    """Return the mandated research-complete YAML poison-guard command."""
+
+    return [
+        str(PYTHON_BIN),
+        "-c",
+        "import yaml; yaml.safe_load(open('research-complete.yaml'))",
+    ]
