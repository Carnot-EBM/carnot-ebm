+def protected_hashes(root: Path = REPO_ROOT) -> dict[str, str | None]:
+    """Hash protected files before or after the run."""
+
+    return {path.as_posix(): sha256_file(root / path) for path in PROTECTED_RELATIVE_PATHS}
