+        write=True,
+    )
+    loaded = json.loads(destination.read_text(encoding="utf-8"))
+
+    assert loaded == second
+    assert first == second
+
+    called = {"run": 0}
+
+    def fake_run(**_: object) -> dict[str, object]:
+        called["run"] += 1
+        return {}
+
+    monkeypatch.setattr(mod, "run", fake_run)
+    assert mod.main(["--date", "20260821"]) is None
+    assert called["run"] == 1
