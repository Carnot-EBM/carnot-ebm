+SPEC_REFS = [
+    "REQ-ARC-WMTE-4753",
+    "SCENARIO-ARC-WMTE-4753-BLOCKED-PRECONDITION",
+    "SCENARIO-ARC-WMTE-4753-LIVE-PERSISTENCE",
+    "SCENARIO-ARC-WMTE-4753-TRANSFER-CHARACTERIZATION",
+]
