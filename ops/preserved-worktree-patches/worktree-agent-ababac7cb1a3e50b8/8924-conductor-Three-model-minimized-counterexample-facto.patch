+def arm_definitions() -> JsonDict:
+    """Define the matched proposal arms."""
+
+    return {
+        "schema": SCHEMA + ".arm_definitions",
+        "arms": {
+            "random_valid_edits": {
+                "proposal_rule": "seeded random valid edits inside bounds",
