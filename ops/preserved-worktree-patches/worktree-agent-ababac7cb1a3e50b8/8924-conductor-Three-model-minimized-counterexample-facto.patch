+        "candidate_count_per_event": CANDIDATES_PER_EVENT,
+        "forbidden_fields": [
+            "protected_outcome",
+            "protected_success",
+            "exact_label",
+            "hidden_state",
+            "source_weight_delta",
+        ],
+    }
+
