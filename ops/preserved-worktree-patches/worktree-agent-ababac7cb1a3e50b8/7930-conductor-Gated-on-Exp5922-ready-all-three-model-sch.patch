-  "spec_deviations": [
-    {
-      "spec": "budget 200",
-      "actual": "budget 2000 (default 2000)",
-      "why": "budget 200 measured 0/25 first-wins -> no arm distinguishable; measured first-win costs span 20 (lp85) to 1747 (cd82) actions"
