+    guard.observe(
+        origin_masked=node,
+        origin_unmasked=f"{node}_Ua",
+        action_key=action_key,
+        successor_masked=f"{node}_S1",
+        successor_unmasked=f"{node}_SUa",
+    )
+    return guard.observe(
+        origin_masked=node,
+        origin_unmasked=f"{node}_Ub",
+        action_key=action_key,
+        successor_masked=f"{node}_S2",
