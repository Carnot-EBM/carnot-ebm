+def test_req_report_4433_schema_rejects_fabricated_successes_and_bad_model_policy(
+    tmp_path: Path,
+) -> None:
+    """REQ-REPORT-4433: schema errors make fabrication and policy drift visible."""
+
+    _write_fixture_repo(tmp_path)
