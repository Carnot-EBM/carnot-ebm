+def _n_changed_cells(g0: np.ndarray, g1: np.ndarray) -> int:
+    a, b = np.asarray(g0), np.asarray(g1)
+    if a.shape != b.shape:
+        return int(a.size)  # a shape mismatch is a maximal, not a zero, disagreement
+    return int(np.sum(a != b))
