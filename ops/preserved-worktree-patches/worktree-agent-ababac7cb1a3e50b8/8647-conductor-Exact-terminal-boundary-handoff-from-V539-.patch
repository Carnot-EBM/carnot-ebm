+                "requires": list(task.get("requires") or [])
+                if isinstance(task.get("requires"), list)
+                else [],
+                "gated_on": list(task.get("gated_on") or [])
+                if isinstance(task.get("gated_on"), list)
+                else [],
+                "agent_type": task.get("agent_type"),
+                "model": task.get("model"),
