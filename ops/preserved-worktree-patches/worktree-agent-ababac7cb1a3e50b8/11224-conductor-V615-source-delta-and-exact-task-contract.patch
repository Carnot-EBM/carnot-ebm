+DRAFT_ROADMAP_PATH = Path("research-roadmap-next.yaml")
+V614_EVIDENCE_PATH = Path("results/experiment_7009_v614_source_contract_preflight.json")
+V613_CAPSTONE_PATH = Path("results/experiment_7008_v613_capstone.json")
+EXCLUSION_PATH = Path("ops/exclusion_manifest.yaml")
+SPEC_PATH = Path("openspec/capabilities/research-reporting/spec.md")
+PROGRAM_PATH = Path("research-program.md")
+REFERENCE_PATH = Path("research-references.md")
+DEFAULT_OUTPUT_PATH = Path("results/experiment_7016_v615_source_contract_preflight.json")
+
