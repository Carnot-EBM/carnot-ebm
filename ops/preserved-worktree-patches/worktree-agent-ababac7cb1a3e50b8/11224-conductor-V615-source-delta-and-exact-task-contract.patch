+INFERENCE_SUBSTRATE = "deterministic_source_contract_audit_no_llm"
+PROMPT_TAIL = "Do NOT push. Do NOT modify scripts/research_conductor.py."
+RANDOM_SEED = 7016
+LLM_TASK_NUMBERS = frozenset({7025, 7026})
+MANDATED_SOTA_GGUFS = (
