+        "prompt_hash": str(
+            receipt.get(
+                "prompt_hash",
+                receipt.get("prompt_sha256", receipt.get("reason_then_structure_prompt_sha256", "")),
+            )
+            or ""
+        ),
+        "gpu_offload_evidence": evidence,
+        "runtime_error": receipt.get("runtime_error"),
