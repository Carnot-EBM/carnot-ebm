+
+REQUIRED_ARTIFACT_FIELDS = tuple(FIELD_PRINCIPLES) + (
+    "experiment",
+    "schema",
+    "preconditions_checked",
+    "package_builds",
+    "agent_config_resolution",
+    "model_path_resolution",
+    "vram_breakdown",
+    "operator_checklist",
+    "submitted_to_leaderboard",
