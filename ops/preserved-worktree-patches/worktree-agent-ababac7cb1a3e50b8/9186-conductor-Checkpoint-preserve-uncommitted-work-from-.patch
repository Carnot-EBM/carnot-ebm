+      - lp85
+      - sp80
+      value: '1'
+      verdict: 'REFUSED: regressed on [''bp35'', ''cd82'', ''dc22'', ''lf52'', ''r11l'', ''s5i5'', ''su15'',
+        ''vc33'']. A flag that breaks a game it used to clear is not promoted, whatever the aggregate
+        says.'
+    last_measured: '2026-08-14'
+    measured_on_engine: scored
+    promotable: false
     state: unevaluated
   CARNOT_ARC_HAZARD_MOVE_PRUNER:
     discovered: '2026-08-14'
