+    except Exception:
+        return False
+
+    rows = list(grid) if hasattr(first, "__iter__") else [grid]
+    if not rows:
+        return False
+
+    has_one = False
+
+    for row in rows:
+        try:
+            cells = list(row)
+        except TypeError:
+            cells = [row]
+
+        seen_non_one = False
+        for value in cells:
+            if value == 1:
+                has_one = True
+                if seen_non_one:
+                    return False
+            else:
+                seen_non_one = True
+
+    return has_one
