+def _path_hashes(paths: Sequence[Path]) -> JsonDict:
+    return {
+        str(path): {
+            "present": path.exists(),
+            "sha256": sha256_file(path) if path.exists() and path.is_file() else None,
+        }
+        for path in paths
+    }
