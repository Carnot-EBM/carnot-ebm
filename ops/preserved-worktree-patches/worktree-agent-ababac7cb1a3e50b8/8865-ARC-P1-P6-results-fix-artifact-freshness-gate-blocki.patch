+            arr = _np.ascontiguousarray(value)
+            return f"ndarray:{arr.shape}:{arr.dtype}:{hashlib.sha256(arr.tobytes()).hexdigest()}"
+    except Exception:  # noqa: BLE001
+        pass
+    return repr(value)
