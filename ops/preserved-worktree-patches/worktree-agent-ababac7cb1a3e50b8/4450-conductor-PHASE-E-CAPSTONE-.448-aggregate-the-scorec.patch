+        rows.append(
+            {
+                "source": source,
+                "experiment_id": _experiment_id(source, artifact),
+                "path": UPSTREAM_SOURCES[source].relative_path,
+                "reason": reason,
+                "sha256": artifact_sha256.get(source, ""),
+            }
+        )
+    return rows
