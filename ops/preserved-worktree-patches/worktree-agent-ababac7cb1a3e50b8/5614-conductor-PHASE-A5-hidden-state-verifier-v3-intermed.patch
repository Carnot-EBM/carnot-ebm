+        by_hf[hf_id] = _model_spec_for(hf_id, resolved, by_hf.get(hf_id, {}).get("gpu", gpu % 2))
+
+    specs = [by_hf[hf_id] for hf_id in MANDATED_MODEL_IDS]
+    models_used = [str(row["hf_id"]) for row in specs if row.get("available")]
