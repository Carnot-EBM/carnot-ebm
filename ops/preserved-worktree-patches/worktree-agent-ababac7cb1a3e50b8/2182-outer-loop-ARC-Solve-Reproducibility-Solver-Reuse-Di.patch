+# ARC-AGI-3 SOLVE REGISTRY — the durable knowledge base of what we learned solving
+# each game, so future efforts REUSE prior learning and every solve is captured as
+# OFFLINE-REPRODUCIBLE (per CLAUDE.md "ARC Solve Reproducibility + Solver-Reuse
+# Discipline"). This is the complement of one-off experiment chains: a stable,
+# growing record of win-conditions + action-models + gotchas + solver modules +
+# reproduction status. Never-prune; move solved games to reproduced=true, keep the
+# trail.
+#
+# reproducibility: reproduced | provisional | unsolved
+#   reproduced  = a from-scratch / state-grounded solve re-derives the level offline
+#                 (passes arc_solver_kit.reproduce); COUNTS toward total_levels.
+#   provisional = only a live-recorded trajectory exists; does NOT reproduce offline;
+#                 does NOT count toward a reproducible total until re-solved.
+#   unsolved    = no solve yet.
+
+schema_version: 1
+updated: "2026-06-16"
+
+# ---- GENERAL GOTCHAS (apply to ANY game; encoded in arc_solver_kit) ----
+general_gotchas:
+  - id: offline_is_a_simulator
+    note: "Arcade(OFFLINE, environment_files) = deterministic sim, all 25 games, zero quota."
+  - id: level_on_frame_not_game
+    note: "level = frame.levels_completed; env._game has no levels_completed."
+  - id: deepcopy_injection_unreliable
+    note: "env._game=deepcopy(state) works for lp85, BROKEN for sc25; use replay-from-reset."
+  - id: first_step_after_reset_consumed
+    note: "first env.step after reset is a no-op (sc25); warm up after reset."
+  - id: discover_coords_never_hardcode
+    note: "live-coupled hardcoded coords miss the offline layout; discover from env."
+  - id: state_dependent_controls_and_animations
+    note: "tank-controls facing + multi-frame animations; include facing/phase in the dedup key and resolve animations before win-check."
+
+games:
+  - game: r11l
+    reproducibility: reproduced
+    levels_reproduced: 1
+    win_condition: "click-to-template: each colored piece dragged onto its gray template (+1,+1)."
+    action_model: "ACTION6 click; full reset->win trajectory in the artifact replays offline."
+    solver: "results/experiment_4296 solve_trace.actions (replays cleanly offline)."
+    gotchas: []
+
+  - game: ls20
+    reproducibility: reproduced
+    levels_reproduced: 1
+    win_condition: "first-solve L1; ACTION + kind sequence replays offline."
+    solver: "results/experiment_4285 solve_trace.actions."
+    gotchas: []
+
+  - game: wa30
+    reproducibility: reproduced
+    levels_reproduced: 1
+    win_condition: "first-solve L1; ACTION + kind sequence replays offline."
+    solver: "results/experiment_4275 solve_trace.actions."
+    gotchas: []
+
+  - game: lp85
+    reproducibility: reproduced
+    levels_reproduced: 3
+    win_condition: "align each moveable piece (bghvgbtwcb/fdgmtkfrxl) with its goal sprite at (+1,+1) via button rotations."
+    action_model: "click-only [ACTION6]; env-adaptive button discovery (discover_click_buttons)."
+    solver: "scripts/arc3_lp85_offline_solver.py — reuses plan_observed_suffix (goal-key-deduped env-cloned BFS), chained L1->L3 (29 moves)."
+    reproduce: "results/arc3_lp85_offline_resolve.json replays to L3 in the meta-harness."
+    gotchas:
+      - "deepcopy-injection WORKS for lp85 (unlike sc25)."
+      - "dedup by goal-relevant key (goal positions), not full grid hash, or the search explodes (26k states -> fails)."
+
+  - game: sc25
+    reproducibility: provisional   # live-recorded L5 does NOT reproduce offline; from-scratch solver IN PROGRESS
+    levels_reproduced: 0
+    levels_live_recorded: 5
+    win_condition: "MULTIPLE paths: (a) move player 'pluyoo' to exit 'exydhv' (abvgsmnbrj->next_level); (b) cast-grid alignment — align the 9 'clcbko' goal sprites to the 3x3 cast grid at +1,+1 (ianfrutkqg/mtfwxhxooqg). L1 is likely (b) or needs a fireball to clear a wall first."
+    action_model: "ACTION6 click to select spell (sptivk-{spell}) + toggle 3x3 cast cells at (24+5c,49+5r) [camera identity] + fire; ACTION1-4 move the player (tank-controls)."
+    solver: "scripts/arc3_sc25_offline_solver.py (v3, replay-from-reset BFS) — infra works, ~90 states explored, L1 blocked on the win-mechanic."
+    gotchas:
+      - "deepcopy-injection BROKEN -> replay-from-reset."
+      - "first step after reset consumed -> warm-up step."
+      - "tank-controls: facing (jdmucabyqar) is load-bearing -> include in state-key."
+      - "live solver's SC25_GRID_COORDS are WRONG for the offline env; correct cell (r,c) = (24+5c, 49+5r)."
+      - "spell fire clears the cast pattern; multi-frame fireball animation must resolve."
+    next: "instrument WHICH win predicate fires for L1; drive search toward cast-grid alignment and/or fireball wall-clear."
+
+  # ... 20 untouched games (ar25, bp35, cd82, cn04, dc22, ft09, g50t, ka59, lf52,
