From 4e9942caaae3a9a3a3ec8b39acd077851338c787 Mon Sep 17 00:00:00 2001
From: Ian Blenke <ian@blenke.com>
Date: Sun, 23 Aug 2026 06:16:29 -0400
Subject: [PATCH 09655/11362] [outer-loop] GPU reaper kills now leave a
 tracked-file record (case F)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The reaper logged kills to journald only; retention on this host is
under two hours, so during the supab4 signal-sender hunt (2026-08-23,
two servers signalled dead mid-generation) its innocence could neither
be proven nor disproven — the exact 'trusted and silent' ambiguity. A
non-empty kill result now also writes a GPU-REAPER WARN row to
ops/conductor-log.md naming pid/VRAM/age/name per victim. Our own
reapers must never kill without a durable actor record; that is the
buildable half of the unexplained-kill class, and this was the last of
our killers without one.

Mutation-gate marker 3ee0feb7 deleted deliberately: its two unattributed
paths are exactly this commit's own authored in-flight edits (the
conductor ran a pytest batch over the shared tree mid-edit). Nothing
reverted.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JntPrUGLNesPcJH1pyfFYw
---
 scripts/research_conductor.py                   | 14 ++++++++++++++
 tests/python/test_conductor_fix_erasure_gate.py | 11 +++++++++++
 2 files changed, 25 insertions(+)

diff --git a/scripts/research_conductor.py b/scripts/research_conductor.py
index 59227ddb30..f414d2533e 100644
--- a/scripts/research_conductor.py
+++ b/scripts/research_conductor.py
@@ -1172,6 +1172,20 @@ def preflight_gpu_reap() -> dict:
             len(result.killed),
             result.total_vram_freed_mb,
         )
+        # Durable actor line (2026-08-23, case-F attribution). journald here
+        # retains under two hours, so a kill logged only there is unprovable
+        # either way once anyone investigates — the exact ambiguity that
+        # left the 2026-08-09 and 2026-08-23 signal-sender hunts open. Our
+        # own reapers must never kill without a tracked-file record.
+        log_step(
+            "GPU-REAPER: killed stale process(es)",
+            "WARN",
+            "; ".join(
+                f"pid={e.get('pid')} {e.get('used_memory_mb', 0)}MiB "
+                f"age={e.get('age_s', 0)}s {e.get('process_name', '?')}"
+                for e in result.killed
+            ),
+        )
         for entry in result.killed:
             logger.warning(
                 "  reaped pid=%s vram=%dMiB age=%ds name=%s",
diff --git a/tests/python/test_conductor_fix_erasure_gate.py b/tests/python/test_conductor_fix_erasure_gate.py
index f1cd240d6c..fdc544c4b0 100644
--- a/tests/python/test_conductor_fix_erasure_gate.py
+++ b/tests/python/test_conductor_fix_erasure_gate.py
@@ -179,3 +179,14 @@ def test_selfedit_revert_preserves_the_diff():
     source = _code_only(inspect.getsource(rc.research_step))
     assert "SELFEDIT_RESCUE_DIR" in source
     assert "Conductor self-edit reverted" in source
+
+
+def test_gpu_reaper_kill_writes_a_durable_row():
+    """Case-F attribution (2026-08-23): a reap that kills something must
+    leave a tracked-file record, not only a journald line that evaporates
+    in under two hours. Source-level: the kill branch calls log_step."""
+    source = inspect.getsource(rc)
+    idx = source.find("Pre-flight reaper killed")
+    assert idx != -1
+    window = source[idx : idx + 1200]
+    assert "GPU-REAPER: killed stale process(es)" in window
