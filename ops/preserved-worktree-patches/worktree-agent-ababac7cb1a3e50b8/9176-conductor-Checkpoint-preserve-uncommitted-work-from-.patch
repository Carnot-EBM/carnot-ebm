 4 files changed, 24 insertions(+), 3 deletions(-)

diff --git a/ops/arc_flag_ledger.yaml b/ops/arc_flag_ledger.yaml
index dcd9463708..3a0b3a40b3 100644
--- a/ops/arc_flag_ledger.yaml
+++ b/ops/arc_flag_ledger.yaml
@@ -12,8 +12,28 @@ flags:
     evidence: []
     state: unevaluated
   CARNOT_ARC_ACTIVE_REWARD_MACHINE:
+    benchmark_reachable: true
     discovered: '2026-08-14'
-    evidence: []
+    evidence:
+    - arm_total_levels: 16
+      baseline_total_levels: 16
+      date: '2026-08-14'
+      engine: scored
+      games_compared: 25
+      identical_to_baseline: true
+      levels_improved: []
+      levels_regressed: []
+      lever_counters_moved: true
+      same_levels_cheaper: []
+      same_levels_costlier: []
+      value: '1'
+      verdict: 'UNINTERPRETABLE_FIRED_NO_EFFECT: the lever''s own counters moved, so it IS wired and running,
+        but every game returned byte-identical levels and actions. Read the row''s fire_counters to tell
+        ''fitted and found nothing to do'' from ''never fitted'' -- only the first is a reportable null
+        about the lever''s value.'
+    last_measured: '2026-08-14'
+    measured_on_engine: scored
+    promotable: false
     state: unevaluated
   CARNOT_ARC_BOUNDED_REINDUCTION:
     discovered: '2026-08-14'
