+def _action_mapping(row: Mapping[str, Any] | None) -> JsonDict:
+    """Copy only the action identity used for parity comparisons."""
+
+    value = row or {}
+    return {"action": value.get("action"), "data": deepcopy(value.get("data"))}
+
