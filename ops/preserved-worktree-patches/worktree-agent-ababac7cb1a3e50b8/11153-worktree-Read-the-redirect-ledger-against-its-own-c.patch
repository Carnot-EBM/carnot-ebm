+    assert enabled_arms() == (ARM_DROP_GOAL_BIAS, ARM_ALLOW_REINDUCTION, ARM_FORCE_DIVERSITY)
+    monkeypatch.setenv("CARNOT_ARC_SUPERVISOR_TOOL_ARM", "1")
