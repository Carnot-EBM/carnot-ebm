+def registry_level_fields_unchanged(root: Path, before: Mapping[str, Any]) -> JsonDict:
+    after = _registry_level_fingerprint(_load_yaml(root / REGISTRY_RELATIVE_PATH))
+    return {
+        "before_sha256": sha256_json(before),
