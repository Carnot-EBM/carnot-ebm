 scripts/kaggle/dryrun_kernel/main.py | 108 +++++++++++++++++----------
 1 file changed, 70 insertions(+), 38 deletions(-)

diff --git a/scripts/kaggle/dryrun_kernel/main.py b/scripts/kaggle/dryrun_kernel/main.py
index 1a1f7c2c14..e1f4a0e36c 100644
