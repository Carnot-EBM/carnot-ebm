+        "actions": actions,
+        "actions_to_first_levelup": actions_to_first if solved else None,
+        "solution_labels": labels if solved else [],
+        "reproduction_gate": gate,
+        "blocked_reason": "",
+        "policy_mode": mode,
+        "goal_candidate_guidance_diagnostics": diagnostics,
+    }
+
