+def test_ensure_ledgers_record_open_gap_and_training_role() -> None:
+    # SCENARIO-VERIFY-4103: registry and gaps carry replay, open gap, and smoke role.
+    replay = exp4103.replay_gap4_arc1(REPO_ROOT)
