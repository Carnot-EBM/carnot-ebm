+    schema = source_payload.get("structural_feature_schema", {})
+    features = schema.get("features", []) if isinstance(schema, Mapping) else []
+    return {
+        str(feature.get("name", "")).lower()
+        for feature in features
+        if isinstance(feature, Mapping)
+    }
