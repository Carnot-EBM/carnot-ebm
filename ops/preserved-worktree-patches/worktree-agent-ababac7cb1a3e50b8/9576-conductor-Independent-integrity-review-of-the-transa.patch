+def _unit_id_for(row: Mapping[str, Any]) -> str:
+    return sha256_json(
+        {
+            "checkpoint_id": row.get("checkpoint_id"),
+            "candidate_value": row.get("candidate_value"),
+            "budget": row.get("exact_budget"),
+        }
+    )
