+        "ready": False,
+        "route": None,
+        "status": None,
+        "completion_text": "",
+        "logprob_ready": False,
+        "top_logprob_ready": False,
+        "confidence_ready": False,
+        "telemetry_signal": None,
+        "evidence": {
+            "token_logprob_count": 0,
+            "top_logprob_row_count": 0,
+            "token_logprobs": [],
+            "top_logprobs": [],
+            "raw_response_keys": [],
