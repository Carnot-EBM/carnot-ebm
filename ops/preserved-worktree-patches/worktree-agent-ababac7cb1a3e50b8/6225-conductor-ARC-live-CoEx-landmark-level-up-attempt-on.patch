+def _fallback_sequence_receipt(labels: Sequence[str]) -> list[dict[str, Any]]:
+    sequence = []
+    for label in labels:
+        if label == "RESET":
+            continue
+        try:
+            sequence.append(json.loads(label))
+        except Exception:
+            continue
+    if not sequence:
+        return []
+    return [
+        {
+            "sequence": sequence,
+            "measurement_receipts": [],
+            "replayable": True,
+            "source": "executed_live_action_labels",
+        }
