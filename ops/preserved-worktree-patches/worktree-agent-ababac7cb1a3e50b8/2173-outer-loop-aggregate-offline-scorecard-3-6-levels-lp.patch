From 9e8edae09c1bb52e21d486acea5dc1a97592f909 Mon Sep 17 00:00:00 2001
From: Ian Blenke <ian@blenke.com>
Date: Tue, 16 Jun 2026 20:20:11 -0400
Subject: [PATCH 02173/11362] [outer-loop] aggregate offline scorecard 3->6
 levels: lp85 re-solve integrated (L3)

Meta-harness prefers from-scratch offline re-solves over non-reproducible live
recordings. Now reproduces r11l L1 + ls20 L1 + wa30 L1 + lp85 L3 = 6 levels
offline, zero quota. sc25 L5 remains (harder; spell-based, level-specific searchers).

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 results/arc3_replay_aggregate_scorecard.json |  8 ++++----
 scripts/arc3_replay_scorecard_metaharness.py | 11 +++++++++--
 2 files changed, 13 insertions(+), 6 deletions(-)

diff --git a/results/arc3_replay_aggregate_scorecard.json b/results/arc3_replay_aggregate_scorecard.json
index 1442fb7e0f..d17de69895 100644
--- a/results/arc3_replay_aggregate_scorecard.json
+++ b/results/arc3_replay_aggregate_scorecard.json
@@ -1,6 +1,6 @@
 {
-  "scorecard_id": "a85b44c8-480c-4111-b483-9c98383e3039",
-  "total_levels": 3,
+  "scorecard_id": "c3e24067-17a3-4864-ac29-90ce5ba1dc08",
+  "total_levels": 6,
   "per_game": [
     {
       "game": "r11l",
@@ -16,8 +16,8 @@
     },
     {
       "game": "lp85",
-      "actions_replayed": 16,
-      "levels_completed": 0,
+      "actions_replayed": 29,
+      "levels_completed": 3,
       "start": 0
     },
     {
diff --git a/scripts/arc3_replay_scorecard_metaharness.py b/scripts/arc3_replay_scorecard_metaharness.py
index 811a2756af..2478a3e218 100644
--- a/scripts/arc3_replay_scorecard_metaharness.py
+++ b/scripts/arc3_replay_scorecard_metaharness.py
@@ -30,10 +30,16 @@ GAME_ARTIFACTS = {
     "wa30": "results/experiment_4275_arc_incremental_progress_new_game.json",   # L1
 }
 
+# from-scratch OFFLINE re-solves (these replay deterministically on the offline
+# layout; take precedence over the non-reproducible live-recorded banked traces)
+RESOLVED_ARTIFACTS = {
+    "lp85": "results/arc3_lp85_offline_resolve.json",  # L3, re-derived offline
+}
+
 
 def load_actions(path: str) -> list[dict]:
     d = json.load(open(REPO / path))
-    for keys in (("solve_trace", "actions"), ("solver_trace", "actions")):
+    for keys in (("solution",), ("solve_trace", "actions"), ("solver_trace", "actions")):
         cur = d
         for k in keys:
             cur = cur.get(k) if isinstance(cur, dict) else None
@@ -82,7 +88,8 @@ def main() -> int:
 
     rows, total = [], 0
     for game, art in GAME_ARTIFACTS.items():
-        actions = load_actions(art)
+        src = RESOLVED_ARTIFACTS.get(game, art)  # prefer the offline re-solve
+        actions = load_actions(src)
         if not actions:
             print(f"  {game}: NO banked trajectory in {art}")
             continue
-- 
