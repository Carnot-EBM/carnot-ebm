+def honest_verdict(
+    marker_found: bool,
+    source_reachable: bool,
+    accepted_findings: list[JsonDict],
+    protected_change_requested: bool,
+    immutability_available: bool = True,
+) -> str:
+    """Return a terminal verdict without forcing novelty."""
+
+    if not marker_found:
+        return "blocked: V522 planner marker missing; ledgers left unchanged"
+    if not source_reachable:
+        return "blocked: source reachability unavailable; no source promoted"
+    if not immutability_available:
+        return "blocked: roadmap or exclusion-manifest immutability checks unavailable"
+    if protected_change_requested:
+        return "blocked: protected identity, gate, authority, model, hardware, headline, or closed-scope change requested"
+    if accepted_findings:
+        return (
+            f"complete: accepted {len(accepted_findings)} post-V522 bounded source "
+            "delta(s); roadmap ids, gates, authority, and model policy unchanged"
+        )
+    return "complete: no accepted post-V522 source deltas; references and studying ledgers unchanged"
+
+
+def execution_refresh_block(accepted_findings: list[JsonDict]) -> str:
+    """Format the optional references append for accepted non-duplicates."""
+
+    lines = [
+        "",
+        EXECUTION_REFRESH_HEADING,
+        "",
+        "Execution-time refresh after the V522 planner marker. Only accepted "
+        "non-duplicate controls are listed here.",
+        "",
+    ]
+    for finding in accepted_findings:
+        lines.append(
+            f"- **{finding['title']}** - {finding['url']}; "
+            f"published/source date {finding['publication_date']} / "
+            f"{finding['source_date']}. Carnot hook: "
+            f"{finding['source_hook']} Target: {finding['target_experiment']}. "
+            f"Boundary: {finding['authority_boundary']}"
+        )
+    lines.extend(["", EXECUTION_REFRESH_END_MARKER, ""])
+    return "\n".join(lines)
+
+
+def insert_after_planner_block(references_text: str, block: str) -> str:
+    """Insert a refresh block after the planner marker unless it already exists."""
+
+    if EXECUTION_REFRESH_HEADING in references_text:
+        return references_text
+    marker_index = references_text.find(PLANNER_END_MARKER)
+    if marker_index < 0:
+        return references_text.rstrip() + "\n" + block
+    insert_at = marker_index + len(PLANNER_END_MARKER)
+    return references_text[:insert_at].rstrip() + "\n" + block + references_text[insert_at:]
+
+
+def studying_execution_block(accepted_findings: list[JsonDict]) -> str:
+    """Format the studying-ledger note only for accepted mapped methods."""
+
+    lines = [
+        "",
+        "<!-- EXP5864-V522-SOURCE-DELTA-INGESTION-START -->",
+        STUDYING_EXECUTION_HEADING,
+        "",
+        f"- Honest verdict: `complete: accepted {len(accepted_findings)} post-V522 bounded source delta(s)`",
+        f"- Artifact: `{RESULT_RELATIVE_PATH.as_posix()}`",
+        "",
+        "### mapped_methods",
+    ]
+    for finding in accepted_findings:
+        mapping = finding["method_to_task_mapping"]
+        lines.append(
+            f"- {mapping['method']}: {mapping['target_experiment']} - "
+            f"{mapping['task_hook']} (fails when: {mapping['failure_boundary']})"
+        )
+    lines.extend(["", STUDYING_EXECUTION_END_MARKER, ""])
+    return "\n".join(lines)
+
+
+def insert_studying_block(studying_text: str, block: str) -> str:
+    """Append an ingestion note unless this execution note already exists."""
+
+    if STUDYING_EXECUTION_HEADING in studying_text:
+        return studying_text
+    return studying_text.rstrip() + "\n" + block
+
