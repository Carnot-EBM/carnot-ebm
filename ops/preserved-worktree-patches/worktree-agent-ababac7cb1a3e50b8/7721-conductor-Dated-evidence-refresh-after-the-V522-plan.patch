+    watch_only_findings: list[JsonDict],
+    excluded_findings: list[JsonDict],
+    inaccessible_findings: list[JsonDict],
+) -> JsonDict:
+    all_candidates = [
+        *accepted_findings,
+        *duplicate_findings,
+        *watch_only_findings,
+        *excluded_findings,
