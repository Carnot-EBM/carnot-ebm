+    kept = curated["kept_entries"]
+    quarantined = curated["quarantined_entries"]
+    evicted = curated["evicted_entries"]
+
+    assert sum(row["byte_cost"] for row in kept) <= 220
+    assert {row["keep_decision"] for row in kept} == {"KEEP"}
