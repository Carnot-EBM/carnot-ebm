+def test_unsafe_and_repeated_transaction_identifiers_are_rejected(tmp_path: Path) -> None:
+    """SCENARIO-ARC-WMTE-6993-HASH-AND-PATH-INTEGRITY: identifiers stay local and unique."""
+
+    begin = dict(
