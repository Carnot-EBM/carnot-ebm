+def _git_output(args: Sequence[str], root: Path) -> str:
+    """Run git and return stdout, or empty text outside a checkout."""
+
+    result = subprocess.run(
+        ["git", *args],
+        cwd=root,
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    return result.stdout.strip() if result.returncode == 0 else ""
+
