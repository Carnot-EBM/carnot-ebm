+"""Tests for Exp 5203 verifier-authenticity remediation options.
+
+Spec refs: REQ-VERIFY-5203, SCENARIO-VERIFY-5203.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from carnot import experiment_5203_verifier_authenticity_remediation_options_v476 as mod
+
+
+SPEC_PATH = Path("openspec/capabilities/verification/spec.md")
+
+
+AND_SOURCE = '''"""AND-Composition Verifier: k=5 ensemble."""
+
+class SOSKANEnergyV3Adapter:
+    def __init__(self):
+        self._trained = False
+
+    def score(self, text):
+        if not self._trained:
+            return 0.5
+        raw = self._v.energy(text)
+        return float(min(raw / 2.0, 1.0))
+
+class SemEnergyProbeAdapter:
+    def score(self, text):
+        return self._v.score_response_proxy(text)
+
+class ASTStructureAdapter: ...
+class SemanticConsistencyAdapter: ...
+class Z3MathAdapter: ...
+
+class AndCompositionVerifier:
+    def verify(self, question, response):
+        for adapter in self._verifiers:
+            try:
+                energy = adapter.score(response)
+            except Exception:
+                energy = 0.0
+        return energy
+
+def _make_k5_verifiers():
+    return [
+        SOSKANEnergyV3Adapter(),
+        SemEnergyProbeAdapter(),
+        ASTStructureAdapter(),
+        SemanticConsistencyAdapter(),
+        Z3MathAdapter(),
+    ]
+
+def build_default_verifier_ensemble():
+    return AndCompositionVerifier()
+'''
+
+
+ROUTER_SOURCE = '''"""Exp 1541 claim-isolation uncertainty router."""
+
+import json
+from pathlib import Path
+
+def _runtime_cases(rows, *, limit):
+    expected = None
+    uncertainty = 0.6 if expected is None else 0.0
+    return [{"uncertainty_score": uncertainty, "claim_isolated_accept": True}]
+
+def _satquest_cases(rows, *, limit):
+    deterministic_accept = True
+    parse_ok = False
+    uncertainty = 1.0 if not parse_ok else 0.75
+    return [{"uncertainty_score": uncertainty, "claim_isolated_accept": deterministic_accept}]
+
+def _product_line_cases(rows, *, limit):
+    deterministic_accept = True
+    return [{"uncertainty_score": 0.0, "claim_isolated_accept": deterministic_accept}]
+
+def _case():
+    uncertainty_score=0.0
+    claim_isolated_accept=deterministic_accept
+    return {"uncertainty_score": 0.0}
+
+def _read_json(path):
+    return json.loads(Path(path).read_text())
+
+def _read_jsonl(path):
+    return [json.loads(line) for line in Path(path).read_text().splitlines()]
+'''
+
+
+AUDIT_TEXT = """<!-- generated by scripts/verifier_authenticity_audit.py - 2026-07-01 -->
+
+# verifier_authenticity_audit_report - 2026-07-01
+
+| `AUTHENTIC` | 11 |
+| `HONEST_HEURISTIC` | 6 |
+| `DISHONEST_NAMING` | 2 |
+| `CANNOT_DETERMINE` | 1 |
+| `OUTRIGHT_FAKE` | 0 |
+
+## python/carnot/verify/and_composition_verifier.py
+**Verdict:** `DISHONEST_NAMING`
+## RECOMMENDATION
+REIMPLEMENT_PROPERLY
+
+## python/carnot/verify/claim_isolation_uncertainty_router.py
+**Verdict:** `DISHONEST_NAMING`
+## RECOMMENDATION
+RENAME_TO_REFLECT_REALITY
+"""
+
+
+CLAUDE_TEXT = """## Verifier Authenticity Discipline (MANDATORY)
+
+The audit NEVER edits any verifier - operator decides.
+
+**How to apply (operator).** When the audit report flags a verifier:
+Decide on RETIRE, RENAME_TO_REFLECT_REALITY, or REIMPLEMENT_PROPERLY.
+"""
+
+
+VERIFY_REPAIR_TEXT = """
+from carnot.verify.and_composition_verifier import build_default_verifier_ensemble
+self._and_compose_verifier = build_default_verifier_ensemble()
+result.certificate["and_compose_k5"] = {"verified": True}
+# Does NOT short-circuit or override result.verified (advisory, additive only).
+"""
+
+
+def make_repo(tmp_path: Path) -> Path:
+    root = tmp_path
+    for rel in (
+        "ops",
+        "results",
+        "python/carnot/verify",
+        "python/carnot/pipeline",
+        "openspec/capabilities/verification",
+    ):
+        (root / rel).mkdir(parents=True, exist_ok=True)
+    (root / mod.AUDIT_RELATIVE_PATH).write_text(AUDIT_TEXT, encoding="utf-8")
+    (root / mod.CLAUDE_RELATIVE_PATH).write_text(CLAUDE_TEXT, encoding="utf-8")
+    (root / mod.AND_VERIFIER_RELATIVE_PATH).write_text(AND_SOURCE, encoding="utf-8")
+    (root / mod.CLAIM_ROUTER_RELATIVE_PATH).write_text(ROUTER_SOURCE, encoding="utf-8")
+    (root / mod.VERIFY_REPAIR_RELATIVE_PATH).write_text(VERIFY_REPAIR_TEXT, encoding="utf-8")
+    (root / mod.VERIFICATION_SPEC_RELATIVE_PATH).write_text(
+        "### REQ-VERIFY-5203\n### SCENARIO-VERIFY-5203\n",
+        encoding="utf-8",
+    )
+    return root
+
+
+def test_req_verify_5203_spec_declares_remediation_contract() -> None:
+    """REQ-VERIFY-5203: OpenSpec declares the remediation-options contract."""
+
+    spec = SPEC_PATH.read_text(encoding="utf-8")
+    section = spec[spec.index("### REQ-VERIFY-5203") :]
+
+    for marker in (
+        "REQ-VERIFY-5203",
+        "SCENARIO-VERIFY-5203",
+        str(mod.RESULT_RELATIVE_PATH),
+        str(mod.DOC_RELATIVE_PATH),
+        "`and_composition_verifier_options`",
+        "`claim_isolation_uncertainty_router_options`",
+        "aggregation_from_upstream_artifacts",
+    ):
+        assert marker in section
+    for field, principle in mod.FIELD_PRINCIPLES.items():
+        assert f"`{field}`" in section
+        assert principle in section
+
+
+def test_scenario_verify_5203_builds_decision_ready_artifact_and_doc(tmp_path: Path) -> None:
+    """SCENARIO-VERIFY-5203: both flagged verifiers get three honest options."""
+
+    root = make_repo(tmp_path)
+    artifact = mod.build_artifact(
+        root=root,
+        result_path=root / mod.RESULT_RELATIVE_PATH,
+        doc_path=root / mod.DOC_RELATIVE_PATH,
+        duration_s=1.25,
+        run_date="20260703",
+        tests_run=["unit fixture"],
+    )
+
+    mod.validate_artifact(artifact)
+    assert artifact["audit_findings_independently_reconfirmed"]["value"] is True
+    assert artifact["no_verifier_modified_this_task"]["value"] is True
+    assert artifact["inference_substrate"]["value"] == "aggregation_from_upstream_artifacts"
+    assert artifact["honest_verdict"]["value"].startswith("complete:")
+    assert artifact["remediation_doc_path"]["value"] == str(mod.DOC_RELATIVE_PATH)
+
+    and_options = artifact["and_composition_verifier_options"]["value"]
+    assert and_options["recommendation"].startswith("REIMPLEMENT_PROPERLY")
+    assert "AdvisoryK5VerifierAdapterHarness" in and_options["rename"]
+    assert "VerifyRepairPipeline" in and_options["retire"]
+    assert "trained SOSKANEnergyV3" in and_options["reimplement"]
+
+    router_options = artifact["claim_isolation_uncertainty_router_options"]["value"]
+    assert router_options["recommendation"].startswith("RENAME_TO_REFLECT_REALITY")
+    assert "ClaimIsolationArtifactRoutingLedger" in router_options["rename"]
+    assert "claim_isolation_router_scale.py" in router_options["retire"]
+    assert "actual model call per claim" in router_options["reimplement"]
+
+    reconfirmation = artifact["source_reconfirmation"]
+    assert reconfirmation["and_composition_verifier"]["untrained_soskan_returns_neutral_0_5"]
+    assert reconfirmation["and_composition_verifier"]["exceptions_masked_as_pass_energy"]
+    assert reconfirmation["claim_isolation_uncertainty_router"]["no_model_substrate_imported"]
+    assert reconfirmation["claim_isolation_uncertainty_router"]["artifact_only_json_inputs"]
+
+    doc = (root / mod.DOC_RELATIVE_PATH).read_text(encoding="utf-8")
+    for marker in (
+        "RENAME_TO_REFLECT_REALITY",
+        "RETIRE",
+        "REIMPLEMENT_PROPERLY",
+        "AdvisoryK5VerifierAdapterHarness",
+        "ClaimIsolationArtifactRoutingLedger",
+        "No verifier source was modified",
+    ):
+        assert marker in doc
+    assert json.loads((root / mod.RESULT_RELATIVE_PATH).read_text(encoding="utf-8")) == artifact
+
+
+def test_scenario_verify_5203_missing_source_blocks_reconfirmation(tmp_path: Path) -> None:
+    """SCENARIO-VERIFY-5203: missing or stale source evidence blocks honestly."""
+
+    root = make_repo(tmp_path)
+    (root / mod.AND_VERIFIER_RELATIVE_PATH).write_text(
+        AND_SOURCE.replace("return 0.5", "return 0.25"),
+        encoding="utf-8",
+    )
+    (root / mod.CLAIM_ROUTER_RELATIVE_PATH).write_text(
+        ROUTER_SOURCE.replace("uncertainty = 1.0", "uncertainty = 0.9"),
+        encoding="utf-8",
+    )
+    (root / mod.VERIFICATION_SPEC_RELATIVE_PATH).write_text("missing anchor\n", encoding="utf-8")
+    (root / mod.CLAUDE_RELATIVE_PATH).write_text("missing operator contract\n", encoding="utf-8")
+
+    missing_failures: list[str] = []
+    assert mod._read_text(root, Path("missing.txt"), missing_failures) == ""
+    assert any(item.startswith("missing_or_unreadable:missing.txt") for item in missing_failures)
+
+    artifact = mod.build_artifact(
+        root=root,
+        result_path=root / mod.RESULT_RELATIVE_PATH,
+        doc_path=root / mod.DOC_RELATIVE_PATH,
+    )
+
+    mod.validate_artifact(artifact)
+    assert artifact["audit_findings_independently_reconfirmed"]["value"] is False
+    assert artifact["honest_verdict"]["value"].startswith("complete:")
+    assert "blocked" in artifact["honest_verdict"]["value"]
+    for marker in (
+        "and_composition_source_not_reconfirmed",
+        "claim_router_source_not_reconfirmed",
+        "missing_spec_anchor:REQ-VERIFY-5203",
+        "missing_claude_operator_decides_contract",
+    ):
+        assert marker in artifact["failed_preconditions"]
+
+
+def test_req_verify_5203_validate_artifact_rejects_schema_drift(tmp_path: Path) -> None:
+    """REQ-VERIFY-5203: artifact validation rejects missing fields and dishonest wrappers."""
+
+    root = make_repo(tmp_path)
+    valid = mod.build_artifact(root=root, result_path=root / mod.RESULT_RELATIVE_PATH)
+
+    def clone() -> dict[str, object]:
+        return json.loads(json.dumps(valid))
+
+    def expect_error(
+        payload: dict[str, object], message: str, *, fix_checksum: bool = True
+    ) -> None:
+        if fix_checksum:
+            payload["reproducibility_checksum"] = mod.payload_checksum(payload)
+        with pytest.raises(AssertionError, match=message):
+            mod.validate_artifact(payload)
+
+    broken = clone()
+    del broken["schema"]
+    expect_error(broken, "missing required fields", fix_checksum=False)
+
+    broken = clone()
+    broken["schema"] = "wrong"
+    expect_error(broken, "schema mismatch")
+
+    broken = clone()
+    broken["experiment_id"] = "wrong"
+    expect_error(broken, "experiment_id mismatch")
+
+    broken = clone()
+    broken["and_composition_verifier_options"] = {}
+    expect_error(broken, "must be principle-wrapped")
+
+    broken = clone()
+    broken["and_composition_verifier_options"]["principle"] = "wrong"
+    expect_error(broken, "principle mismatch")
+
+    broken = clone()
+    del broken["and_composition_verifier_options"]["value"]["rename"]
+    expect_error(broken, "missing option keys")
+
+    broken = clone()
+    broken["and_composition_verifier_options"]["value"]["recommendation"] = ""
+    expect_error(broken, "non-empty strings")
+
+    broken = clone()
+    broken["audit_findings_independently_reconfirmed"]["value"] = "true"
+    expect_error(broken, "must be bool")
+
+    broken = clone()
+    broken["no_verifier_modified_this_task"]["value"] = False
+    expect_error(broken, "verifier source modification")
+
+    broken = clone()
+    broken["inference_substrate"]["value"] = "live_model_inference"
+    expect_error(broken, "inference_substrate mismatch")
+
+    broken = clone()
+    broken["honest_verdict"]["value"] = "blocked_without_terminal_prefix"
+    expect_error(broken, "must start")
+
+    broken = clone()
+    broken["reproducibility_checksum"] = "bad"
+    expect_error(broken, "checksum mismatch", fix_checksum=False)
+
+
+def test_scenario_verify_5203_cli_writes_valid_artifact(
+    tmp_path: Path,
+    capsys: pytest.CaptureFixture[str],
+) -> None:
+    """SCENARIO-VERIFY-5203: CLI writes and prints the validated decision artifact."""
+
+    root = make_repo(tmp_path)
+    result_path = root / "custom-result.json"
+    doc_path = root / "custom-doc.md"
+
+    assert (
+        mod.main(
+            [
+                "--root",
+                str(root),
+                "--result-path",
+                str(result_path),
+                "--doc-path",
+                str(doc_path),
+                "--date",
+                "20260703",
+            ]
+        )
+        == 0
+    )
+
+    printed = json.loads(capsys.readouterr().out)
+    written = json.loads(result_path.read_text(encoding="utf-8"))
+    assert printed == written
+    assert written["remediation_doc_path"]["value"] == doc_path.as_posix()
+    assert "ClaimIsolationArtifactRoutingLedger" in doc_path.read_text(encoding="utf-8")
