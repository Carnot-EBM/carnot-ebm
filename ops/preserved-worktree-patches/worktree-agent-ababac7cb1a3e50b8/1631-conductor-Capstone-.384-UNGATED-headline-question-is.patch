+def test_req_capstone_4155_spec_anchor_exists() -> None:
+    """REQ-CAPSTONE-4155: OpenSpec declares the .384 capstone contract."""
+
+    spec = Path("openspec/capabilities/capstone/spec.md").read_text(encoding="utf-8")
