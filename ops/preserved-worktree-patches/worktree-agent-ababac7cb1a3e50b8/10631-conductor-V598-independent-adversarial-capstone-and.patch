+            "exp6844.supervisor_effect_eligible_score",
+        ),
+    )
+    tool_blocking = _blocking(
+        by_id,
+        (
+            "exp6845.tool_gap_obligations",
+            "exp6845.tool_gap_effect_eligible_score",
