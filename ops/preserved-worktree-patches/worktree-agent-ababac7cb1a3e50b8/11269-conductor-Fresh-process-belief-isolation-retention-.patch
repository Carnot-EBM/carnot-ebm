+def _durability_rows(root: Path) -> JsonDict:
+    restart = ledger_mod.BeliefLedger(root / "restart", capacity=4)
+    restart.observe(ledger_mod._fixture_event(0, mechanic="restart", outcome="stable"))
+    committed = restart.snapshot()
+    restarted = restart.restart()
+    restart_row = {
+        "committed_bytes_survived": restarted.snapshot() == committed,
+        "journal_audit_passed": restarted.audit_state()["passed"],
+        "passed": restarted.snapshot() == committed and restarted.audit_state()["passed"],
+        "terminal": True,
+    }
+
+    prepare = ledger_mod.BeliefLedger(root / "interrupt-prepare", capacity=4)
+    prepare_parent = prepare.snapshot()
+    try:
+        prepare.observe(
+            ledger_mod._fixture_event(0, mechanic="prepare", outcome="candidate"),
+            interrupt_after_prepare=True,
+        )
+    except ledger_mod.ForcedInterruption:
+        pass
+    prepare_recovered = prepare.restart()
+    prepare_phase = prepare_recovered.recovery_rows[-1]["phase"]
+    prepare_row = {
+        "boundary": "after_prepare",
+        "recovery_phase": prepare_phase,
+        "parent_bytes_preserved": prepare_recovered.snapshot() == prepare_parent,
+        "passed": prepare_phase == "abort_recovered"
+        and prepare_recovered.snapshot() == prepare_parent,
+        "terminal": True,
+    }
+
+    publish = ledger_mod.BeliefLedger(root / "interrupt-publish", capacity=4)
+    publish_parent = publish.snapshot()
+    try:
+        publish.observe(
+            ledger_mod._fixture_event(0, mechanic="publish", outcome="candidate"),
+            interrupt_after_publish=True,
+        )
+    except ledger_mod.ForcedInterruption:
+        pass
+    published_bytes = publish.snapshot()
+    publish_recovered = publish.restart()
+    publish_phase = publish_recovered.recovery_rows[-1]["phase"]
+    publish_row = {
+        "boundary": "after_publish",
+        "recovery_phase": publish_phase,
+        "candidate_bytes_preserved": publish_recovered.snapshot() == published_bytes,
+        "parent_changed": published_bytes != publish_parent,
+        "passed": publish_phase == "commit_recovered"
+        and publish_recovered.snapshot() == published_bytes
+        and published_bytes != publish_parent,
+        "terminal": True,
+    }
+
+    invalid = ledger_mod.BeliefLedger(root / "invalid-snapshot", capacity=4)
+    invalid_parent = invalid.snapshot()
+    try:
+        invalid.rollback(b"{invalid", transaction_id="invalid", reason="audit mutation")
+    except ValueError:
+        invalid_rejected = True
+    else:
+        invalid_rejected = False
+    invalid_row = {
+        "case": "invalid_snapshot",
+        "rejected": invalid_rejected,
+        "state_unchanged": invalid.snapshot() == invalid_parent,
+        "passed": invalid_rejected and invalid.snapshot() == invalid_parent,
+        "terminal": True,
+    }
+
+    rollback = ledger_mod.BeliefLedger(root / "exact-rollback", capacity=4)
+    rollback_parent = rollback.snapshot()
+    write = rollback.observe(ledger_mod._fixture_event(0, mechanic="rollback", outcome="candidate"))
+    receipt = rollback.rollback(
+        rollback_parent,
+        transaction_id=str(write["transaction_id"]),
+        reason="cold audit exact parent",
+    )
+    exact_row = {
+        "case": "exact_parent",
+        "byte_exact": rollback.snapshot() == rollback_parent,
+        "receipt_rolled_back": receipt["rolled_back"],
+        "passed": rollback.snapshot() == rollback_parent and receipt["rolled_back"],
+        "terminal": True,
+    }
+
+    tampered = ledger_mod.BeliefLedger(root / "tampered-tail", capacity=4)
+    tampered.observe(ledger_mod._fixture_event(0, mechanic="tail", outcome="clean"))
+    with tampered.journal_path.open("ab") as handle:
+        handle.write(b'{"broken":true}\n')
+    try:
+        tampered.restart()
+    except ledger_mod.JournalIntegrityError:
+        tail_rejected = True
+    else:
+        tail_rejected = False
+    tail_row = {
+        "case": "tampered_journal_tail",
+        "rejected": tail_rejected,
+        "passed": tail_rejected,
+        "terminal": True,
+    }
+
+    truncated = ledger_mod.BeliefLedger(root / "truncated-commit", capacity=4)
+    truncated.observe(ledger_mod._fixture_event(0, mechanic="tail", outcome="clean"))
+    lines = truncated.journal_path.read_text(encoding="utf-8").splitlines()
+    truncated.journal_path.write_text("\n".join(lines[:-1]) + "\n", encoding="utf-8")
+    truncated_recovered = truncated.restart()
+    truncated_phase = truncated_recovered.recovery_rows[-1]["phase"]
+    truncated_row = {
+        "case": "truncated_commit_tail",
+        "recovery_phase": truncated_phase,
+        "state_preserved": truncated_recovered.audit_state()["passed"],
+        "passed": truncated_phase == "commit_recovered"
+        and truncated_recovered.audit_state()["passed"],
+        "terminal": True,
+    }
+    return {
+        "restart_rows": [restart_row],
+        "interruption_rows": [prepare_row, publish_row],
+        "rollback_rows": [invalid_row, exact_row, tail_row, truncated_row],
+    }
+
+
+def run_audit_matrix(
+    events: Sequence[Mapping[str, Any]],
+    exp7020: Mapping[str, Any],
+    work_root: Path,
+    runtime_receipt: Mapping[str, Any],
+) -> JsonDict:
+    """Run clean replay, all mutations, and all durable safety controls."""
+
+    work_root.mkdir(parents=True, exist_ok=True)
+    with tempfile.TemporaryDirectory(prefix="matrix-", dir=work_root) as directory:
+        root = Path(directory)
+        first = ledger_mod.replay_events(events, root / "replay-first")
+        second = ledger_mod.replay_events(events, root / "replay-second")
+        first_digest = _replay_digest(first)
+        second_digest = _replay_digest(second)
+        source_digest_row = next(
+            (
+                row
+                for row in exp7020.get("snapshot_hashes", [])
+                if row.get("snapshot_index") == "fresh_process_replay"
+            ),
+            {},
+        )
+        source_digest = source_digest_row.get("current_digest")
+        fresh_pass = bool(
+            runtime_receipt.get("fresh_process") is True
+            and runtime_receipt.get("game_source_access_rejected") is True
+            and runtime_receipt.get("registry_access_rejected") is True
+            and runtime_receipt.get("source_tree_read_only") is True
+            and first_digest == second_digest == source_digest
+            and first["audit_state"]["passed"]
+            and second["audit_state"]["passed"]
+        )
+        evidence: JsonDict = {
+            "fresh_process_rows": [
+                {
+                    "fresh_process": runtime_receipt.get("fresh_process"),
+                    "game_source_access_rejected": runtime_receipt.get(
+                        "game_source_access_rejected"
+                    ),
+                    "registry_access_rejected": runtime_receipt.get("registry_access_rejected"),
+                    "source_tree_read_only": runtime_receipt.get("source_tree_read_only"),
+                    "first_replay_digest": first_digest,
+                    "second_replay_digest": second_digest,
+                    "exp7020_replay_digest": source_digest,
+                    "replay_digest_matches_exp7020": first_digest == source_digest,
+                    "deterministic_replay": first_digest == second_digest,
+                    "event_count": len(first["per_event_results"]),
+                    "passed": fresh_pass,
+                    "terminal": True,
+                }
+            ],
+            "network_isolation_rows": [
+                {
+                    "network_namespace_isolated": runtime_receipt.get("network_namespace_isolated"),
+                    "network_disabled": runtime_receipt.get("network_disabled"),
+                    "external_lookup_rejected": runtime_receipt.get("external_lookup_rejected"),
+                    "passed": bool(
+                        runtime_receipt.get("network_namespace_isolated") is True
+                        and runtime_receipt.get("network_disabled") is True
+                        and runtime_receipt.get("external_lookup_rejected") is True
+                    ),
+                    "terminal": True,
+                }
+            ],
+            "gpu_isolation_rows": [
+                {
+                    "gpu_devices_visible": deepcopy(runtime_receipt.get("gpu_devices_visible")),
+                    "cuda_visible_devices": runtime_receipt.get("cuda_visible_devices"),
+                    "passed": bool(
+                        runtime_receipt.get("gpu_devices_visible") == []
+                        and runtime_receipt.get("cuda_visible_devices") == ""
+                    ),
+                    "terminal": True,
+                }
+            ],
+        }
+        mutation_rows = [
+            audit_one_forbidden_mutation(events[0], field_name, root / "mutations" / field_name)
+            for field_name in sorted(ledger_mod.FORBIDDEN_UPDATER_KEYS)
+        ]
+        evidence["future_leakage_mutation_rows"] = [
+            row for row in mutation_rows if row["field_name"] in FUTURE_FIELDS
+        ]
+        evidence["game_identity_mutation_rows"] = [
+            row for row in mutation_rows if row["field_name"] in GAME_IDENTITY_FIELDS
+        ]
+        evidence["serialization_mutation_rows"] = _serialization_rows(
+            events[0], root / "serialization"
+        )
+        evidence["order_mutation_rows"] = _order_rows(events, root / "order")
+        evidence["authority_conflict_rows"] = [_authority_row(root / "authority")]
+        evidence["supersession_rows"] = [_supersession_row(root / "supersession")]
+        evidence["retrieval_collision_rows"] = [_retrieval_collision_row(root / "retrieval")]
+        evidence.update(_capacity_poison_retention_rows(root / "pressure"))
+        evidence.update(_durability_rows(root / "durability"))
+    return evidence
+
+
+def _all_rows_pass(artifact: Mapping[str, Any], fields: Sequence[str]) -> bool:
+    return all(
+        isinstance(artifact.get(field), list)
+        and bool(artifact[field])
+        and all(
+            isinstance(row, Mapping) and row.get("terminal") is True and row.get("passed") is True
+            for row in artifact[field]
+        )
+        for field in fields
+    )
+
+
+def reduce_terminal_decision(artifact: Mapping[str, Any]) -> JsonDict:
+    """Derive shadow safety and promotion without trusting existing score fields."""
+
+    reduced = deepcopy(dict(artifact))
+    leakage_fields = (
+        "future_leakage_mutation_rows",
+        "game_identity_mutation_rows",
+        "network_isolation_rows",
+        "gpu_isolation_rows",
+    )
+    deterministic_fields = (
+        "fresh_process_rows",
+        "serialization_mutation_rows",
+        "order_mutation_rows",
+    )
+    rollback_fields = ("restart_rows", "interruption_rows", "rollback_rows")
+    protected_fields = ("poison_rows", "retention_rows")
+    other_fields = (
+        "authority_conflict_rows",
+        "supersession_rows",
+        "retrieval_collision_rows",
+    )
+    shadow_rows = [
+        gate_check(
+            "zero_future_or_identity_leakage", True, _all_rows_pass(reduced, leakage_fields)
+        ),
+        gate_check(
+            "deterministic_clean_replay", True, _all_rows_pass(reduced, deterministic_fields)
+        ),
+        gate_check(
+            "exact_restart_interruption_and_rollback",
+            True,
+            _all_rows_pass(reduced, rollback_fields),
+        ),
+        gate_check("bounded_capacity", True, _all_rows_pass(reduced, ("capacity_rows",))),
+        gate_check("no_protected_case_harm", True, _all_rows_pass(reduced, protected_fields)),
+        gate_check("conflict_and_retrieval_controls", True, _all_rows_pass(reduced, other_fields)),
+    ]
+    shadow_safe = all(row["passed"] for row in shadow_rows)
+    recomputation_passed = _all_rows_pass(reduced, ("aggregate_recomputation_rows",))
+    promotion_rows = [deepcopy(dict(row)) for row in reduced.get("promotion_gate_rows", [])]
+    row_positive = bool(promotion_rows) and all(row.get("passed") is True for row in promotion_rows)
+    promotion_ready = shadow_safe and recomputation_passed and row_positive
+    if not shadow_safe or not recomputation_passed:
+        verdict_class = "disqualified"
+        honest_verdict = "disqualified_belief_ledger_cold_audit_leakage_or_row_drift"
+    elif promotion_ready:
+        verdict_class = "positive"
+        honest_verdict = "complete_positive_belief_ledger_safe_and_promotion_ready"
+    else:
+        verdict_class = "null"
+        honest_verdict = "complete_null_belief_ledger_shadow_safe_value_not_promotable"
+    reduced["shadow_safety_gate_rows"] = shadow_rows
+    reduced["belief_shadow_safe_score"] = int(shadow_safe)
+    reduced["belief_promotion_ready_score"] = int(promotion_ready)
+    reduced["verdict_class"] = verdict_class
+    reduced["honest_verdict"] = honest_verdict
+    reduced["rows"] = [
+        {
+            "decision": "shadow_safety",
+            "score": int(shadow_safe),
+            "passed": shadow_safe,
+            "terminal": True,
+        },
+        {
+            "decision": "value_promotion",
+            "score": int(promotion_ready),
+            "passed": promotion_ready,
+            "terminal": True,
+        },
+    ]
+    reduced["gate_check_summary"] = gate_summary(
+        [
+            *reduced.get("preconditions_checked", []),
+            *shadow_rows,
+            *promotion_rows,
+        ]
+    )
+    return reduced
+
