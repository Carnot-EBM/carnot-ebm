+            ),
+        ]
+    )
+    return {
+        "passed": all(row["passed"] is True for row in checks),
+        "checks": checks,
+        "hashes": hashes,
+        "values": values,
+    }
+
+
+def _mean(values: Sequence[float]) -> float | None:
+    if not values:
+        return None
+    return round(sum(values) / len(values), 12)
+
+
+def _cluster_interval(values_by_unit: Mapping[str, float], seed: int, resamples: int) -> JsonDict:
+    ordered = [float(values_by_unit[key]) for key in sorted(values_by_unit)]
+    if not ordered:
+        return {
+            "point_estimate": None,
+            "lower": None,
+            "upper": None,
+            "cluster_count": 0,
+            "resamples": resamples,
+            "seed": seed,
+        }
+    generator = random.Random(seed)
+    means = sorted(
+        sum(generator.choice(ordered) for _ in ordered) / len(ordered) for _ in range(resamples)
+    )
+    return {
+        "point_estimate": _mean(ordered),
+        "lower": round(means[int(0.025 * (resamples - 1))], 12),
+        "upper": round(means[int(0.975 * (resamples - 1))], 12),
+        "cluster_count": len(ordered),
+        "resamples": resamples,
+        "seed": seed,
+    }
+
+
+def _recompute_arm_rows(source: Mapping[str, Any]) -> list[JsonDict]:
+    decision_rows = list(source.get("per_decision_results", []))
+    action_rows = list(source.get("action_ranking_rows", []))
+    contradiction_rows = list(source.get("contradiction_avoidance_rows", []))
+    retention_rows = list(source.get("retention_rows", []))
+    query_rows = list(source.get("query_cost_rows", []))
+    rows = []
+    for arm in ARMS:
+        decisions = [row for row in decision_rows if row.get("arm") == arm]
+        actions = [row for row in action_rows if row.get("arm") == arm]
+        contradictions = [row for row in contradiction_rows if row.get("arm") == arm]
+        retention = [row for row in retention_rows if row.get("arm") == arm]
+        queries = [row for row in query_rows if row.get("arm") == arm]
+        final_retention = max(retention, key=lambda row: row["stream_index"], default=None)
+        rows.append(
+            {
+                "arm": arm,
+                "planned_decision_count": len(decisions),
+                "supported_decision_count": len(actions),
+                "action_ranking_accuracy": _mean([float(row["accuracy"]) for row in actions]),
+                "contradicted_action_rate": _mean(
+                    [float(bool(row["selected_contradicted"])) for row in contradictions]
+                ),
+                "useful_query_coverage": _mean(
+                    [float(bool(row["useful_query"])) for row in decisions]
+                ),
+                "final_protected_retention_rate": (
+                    final_retention["protected_retention_rate"]
+                    if final_retention is not None
+                    else None
+                ),
+                "mean_memory_bytes": _mean([float(row["memory_bytes"]) for row in queries]),
+                "mean_query_time_us": _mean([float(row["query_time_us"]) for row in queries]),
+                "terminal": True,
+            }
+        )
+    return rows
+
+
+def _recompute_paired_rows(source: Mapping[str, Any]) -> list[JsonDict]:
+    action_rows = list(source.get("action_ranking_rows", []))
+    values = {
+        arm: {
+            str(row["unit_id"]): float(row["accuracy"])
+            for row in action_rows
+            if row.get("arm") == arm
+        }
+        for arm in ARMS
+    }
+    source_rows = {str(row["comparison"]): row for row in source.get("paired_delta_rows", [])}
+    rows = []
+    for control in CONTROLS:
+        name = f"counterexample_belief_minus_{control}"
+        published = source_rows.get(name, {})
+        common = sorted(set(values["counterexample_belief"]) & set(values[control]))
+        deltas = {
+            unit_id: values["counterexample_belief"][unit_id] - values[control][unit_id]
+            for unit_id in common
+        }
+        interval = _cluster_interval(
+            deltas,
+            int(published.get("seed", 0)),
+            int(published.get("resamples", 0)),
+        )
+        rows.append(
+            {
+                "metric": "action_ranking_accuracy",
+                "comparison": name,
+                **interval,
+                "terminal": True,
+            }
+        )
+    return rows
+
+
+def _row_positive_gate(
+    arm_rows: Sequence[Mapping[str, Any]],
+    paired_rows: Sequence[Mapping[str, Any]],
+    source: Mapping[str, Any],
+) -> tuple[bool, list[JsonDict]]:
+    by_arm = {str(row["arm"]): row for row in arm_rows}
+    belief_value = by_arm["counterexample_belief"]["action_ranking_accuracy"]
+    strict = bool(
+        belief_value is not None
+        and all(
+            by_arm[control]["action_ranking_accuracy"] is not None
+            and belief_value > by_arm[control]["action_ranking_accuracy"]
+            for control in CONTROLS
+        )
+    )
+    lower_nonnegative = bool(paired_rows) and all(
+        row["lower"] is not None and float(row["lower"]) >= 0.0 for row in paired_rows
+    )
+    mechanics: dict[str, dict[str, list[float]]] = defaultdict(lambda: defaultdict(list))
+    for row in source.get("action_ranking_rows", []):
+        mechanics[str(row["mechanic_group"])][str(row["arm"])].append(float(row["accuracy"]))
+    nonnegative_groups = sum(
+        1
+        for values in mechanics.values()
+        if values.get("counterexample_belief")
+        and values.get("recency_only")
+        and _mean(values["counterexample_belief"]) >= _mean(values["recency_only"])
+    )
+    belief_retention = by_arm["counterexample_belief"]["final_protected_retention_rate"]
+    recency_retention = by_arm["recency_only"]["final_protected_retention_rate"]
+    retention_ok = bool(
+        belief_retention is not None
+        and recency_retention is not None
+        and belief_retention >= recency_retention
+    )
+    rows = [
+        gate_check("strictly_beats_both_controls", True, strict),
+        gate_check("paired_interval_lower_bounds_nonnegative", True, lower_nonnegative),
+        gate_check(
+            "nonnegative_belief_minus_recency_mechanic_groups",
+            ">=2",
+            nonnegative_groups,
+            passed=nonnegative_groups >= 2,
+        ),
+        gate_check("protected_retention_does_not_regress", True, retention_ok),
+    ]
+    return all(row["passed"] for row in rows), rows
+
+
+def _comparison_complete(source: Mapping[str, Any], arm_rows_match: bool) -> bool:
+    held = list(source.get("frozen_split", {}).get("held_stream_indices", []))
+    unit_count = len(held)
+    action_units = {row.get("unit_id") for row in source.get("action_ranking_rows", [])}
+    classified = (
+        len(source.get("unsupported_rows", []))
+        + len(source.get("no_headroom_rows", []))
+        + len(action_units)
+    )
+    return bool(
+        len(source.get("per_decision_results", [])) == unit_count * len(ARMS)
+        and len(source.get("query_cost_rows", [])) == unit_count * len(ARMS)
+        and len(source.get("retention_rows", [])) == unit_count * len(ARMS)
+        and classified == unit_count
+        and all(
+            row.get("same_capacity") is True and row.get("within_capacity") is True
+            for row in source.get("capacity_match_rows", [])
+        )
+        and all(
+            row.get("strict_chronology") is True
+            and row.get("current_outcome_used_by_policy") is False
+            for row in source.get("per_decision_results", [])
+        )
+        and all(row.get("passed") is True for row in source.get("leakage_check_rows", []))
+        and arm_rows_match
+    )
+
+
+def audit_exp7021_rows(source: Mapping[str, Any]) -> JsonDict:
+    """Independently recompute every arm headline, paired delta, and value gate."""
+
+    observed_arms = _recompute_arm_rows(source)
+    expected_arms = {str(row.get("arm")): row for row in source.get("rows", [])}
+    aggregate_rows = []
+    for observed in observed_arms:
+        expected = expected_arms.get(str(observed["arm"]))
+        aggregate_rows.append(
+            {
+                "record_type": "arm_aggregate",
+                "key": observed["arm"],
+                "expected_value": deepcopy(expected),
+                "observed_value": deepcopy(observed),
+                "passed": expected == observed,
+                "terminal": True,
+            }
+        )
+    arm_rows_match = all(row["passed"] for row in aggregate_rows)
+
+    observed_pairs = _recompute_paired_rows(source)
+    expected_pairs = {
+        str(row.get("comparison")): row for row in source.get("paired_delta_rows", [])
+    }
+    for observed in observed_pairs:
+        expected = expected_pairs.get(str(observed["comparison"]))
+        aggregate_rows.append(
+            {
+                "record_type": "paired_delta",
+                "key": observed["comparison"],
+                "expected_value": deepcopy(expected),
+                "observed_value": deepcopy(observed),
+                "passed": expected == observed,
+                "terminal": True,
+            }
+        )
+
+    producer_recompute_claim = source.get("aggregate_row_recomputation", {}).get("matches")
+    aggregate_rows.append(
+        {
+            "record_type": "producer_recomputation_claim",
+            "key": "aggregate_row_recomputation.matches",
+            "expected_value": producer_recompute_claim,
+            "observed_value": arm_rows_match,
+            "passed": producer_recompute_claim is arm_rows_match,
+            "terminal": True,
+        }
+    )
+    complete = _comparison_complete(source, arm_rows_match)
+    aggregate_rows.append(
+        {
+            "record_type": "comparison_complete_score",
+            "key": "belief_utility_comparison_complete_score",
+            "expected_value": source.get("belief_utility_comparison_complete_score"),
+            "observed_value": int(complete),
+            "passed": source.get("belief_utility_comparison_complete_score") == int(complete),
+            "terminal": True,
+        }
+    )
+    positive, promotion_rows = _row_positive_gate(observed_arms, observed_pairs, source)
+    aggregate_rows.append(
+        {
+            "record_type": "positive_score",
+            "key": "belief_future_utility_positive_score",
+            "expected_value": source.get("belief_future_utility_positive_score"),
+            "observed_value": int(complete and positive),
+            "passed": source.get("belief_future_utility_positive_score")
+            == int(complete and positive),
+            "terminal": True,
+        }
+    )
+    recomputation_passed = all(row["passed"] for row in aggregate_rows)
+    promotion_rows.insert(
+        0,
+        gate_check("headline_and_row_recomputation", True, recomputation_passed),
+    )
+    return {
+        "aggregate_recomputation_rows": aggregate_rows,
+        "promotion_gate_rows": promotion_rows,
+        "recomputation_passed": recomputation_passed,
+        "row_positive_gate_passed": bool(complete and positive),
+    }
+
