+def _supersession_row(root: Path) -> JsonDict:
+    ledger = ledger_mod.BeliefLedger(root, capacity=8, min_support=2)
+    receipts = [
+        ledger.observe(ledger_mod._fixture_event(0, mechanic="supersession", outcome="a")),
+        ledger.observe(ledger_mod._fixture_event(1, mechanic="supersession", outcome="a")),
+        ledger.observe(ledger_mod._fixture_event(2, mechanic="supersession", outcome="b")),
+        ledger.observe(ledger_mod._fixture_event(3, mechanic="supersession", outcome="a")),
+        ledger.observe(ledger_mod._fixture_event(4, mechanic="supersession", outcome="a")),
+    ]
+    supersessions = [row for receipt in receipts for row in receipt.get("supersessions", [])]
+    contradicted = [row for row in ledger.facts() if row["state"] == "contradicted"]
+    generation_increased = bool(
+        supersessions and supersessions[0]["new_generation"] > supersessions[0]["prior_generation"]
+    )
+    passed = bool(contradicted and generation_increased and ledger.audit_state()["passed"])
+    return {
+        "contradicted_fact_count": len(contradicted),
+        "supersession_count": len(supersessions),
+        "generation_increased": generation_increased,
+        "passed": passed,
+        "terminal": True,
+    }
