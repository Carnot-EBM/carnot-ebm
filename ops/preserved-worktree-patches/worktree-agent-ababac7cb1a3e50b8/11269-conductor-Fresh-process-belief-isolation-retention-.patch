+def audit_one_forbidden_mutation(
+    event: Mapping[str, Any], field_name: str, ledger_root: Path
+) -> JsonDict:
+    """Insert one denied field and prove write and query fail before publication."""
+
+    mutated = deepcopy(dict(event))
+    mutated[field_name] = {"audit_probe": field_name}
+    mutated["row_hash"] = ledger_mod.event_row_hash(mutated)
+    ledger = ledger_mod.BeliefLedger(ledger_root, capacity=4)
+    parent = ledger.snapshot()
+    receipt = ledger.observe(mutated)
+    try:
+        ledger.query(mutated)  # type: ignore[arg-type]
+    except (TypeError, ValueError):
+        query_rejected = True
+    else:
+        query_rejected = False
+    write_rejected = (
+        receipt.get("accepted") is False and receipt.get("reason") == "forbidden_updater_fields"
+    )
+    state_unchanged = ledger.snapshot() == parent
+    return {
+        "field_name": field_name,
+        "mutation": (
+            "future_label_swap" if field_name in FUTURE_FIELDS else "game_identity_or_source_swap"
+        ),
+        "category": "future" if field_name in FUTURE_FIELDS else "game_identity_or_source",
+        "write_rejected": write_rejected,
+        "query_rejected": query_rejected,
+        "state_unchanged": state_unchanged,
+        "reason": receipt.get("reason"),
+        "passed": write_rejected and query_rejected and state_unchanged,
+        "terminal": True,
+    }
+
