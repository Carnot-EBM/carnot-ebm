+def _capacity_poison_retention_rows(root: Path) -> JsonDict:
+    capacity = ledger_mod.BeliefLedger(root / "capacity", capacity=2, min_support=2)
+    capacity.observe(ledger_mod._fixture_event(0, mechanic="old", outcome="old"))
+    capacity.observe(ledger_mod._fixture_event(1, mechanic="middle", outcome="middle"))
+    receipt = capacity.observe(ledger_mod._fixture_event(2, mechanic="new", outcome="new"))
+    capacity_row = {
+        "evicted_first_stream_indices": [
+            row["last_stream_index"] for row in receipt.get("evictions", [])
+        ],
+        "fact_count": len(capacity.facts()),
+        "item_capacity": capacity.capacity,
+        "state_bytes": len(capacity.state_bytes),
+        "byte_capacity": capacity.max_state_bytes,
+        "within_item_capacity": len(capacity.facts()) <= capacity.capacity,
+        "within_byte_capacity": len(capacity.state_bytes) <= capacity.max_state_bytes,
+        "passed": bool(
+            [row["last_stream_index"] for row in receipt.get("evictions", [])] == [0]
+            and len(capacity.facts()) <= capacity.capacity
+            and len(capacity.state_bytes) <= capacity.max_state_bytes
+        ),
+        "terminal": True,
+    }
+
+    poison = ledger_mod.BeliefLedger(root / "poison", capacity=2, min_support=2)
+    poison.observe(ledger_mod._fixture_event(0, mechanic="anchor-a", outcome="a"))
+    poison.observe(ledger_mod._fixture_event(1, mechanic="anchor-a", outcome="a"))
+    poison.observe(ledger_mod._fixture_event(2, mechanic="anchor-b", outcome="b"))
+    poison.observe(ledger_mod._fixture_event(3, mechanic="anchor-b", outcome="b"))
+    parent = poison.snapshot()
+    before = {row["fact_id"]: row["support"] for row in poison.facts()}
+    receipts = [
+        poison.observe(ledger_mod._fixture_event(index, mechanic=f"poison-{index}", outcome="weak"))
+        for index in (4, 5, 6)
+    ]
+    after = {row["fact_id"]: row["support"] for row in poison.facts()}
+    admitted = sum(receipt.get("accepted") is True for receipt in receipts)
+    unchanged = poison.snapshot() == parent and before == after
+    poison_row = {
+        "attack_count": len(receipts),
+        "admitted_poison_count": admitted,
+        "all_reasons": [receipt.get("reason") for receipt in receipts],
+        "protected_state_unchanged": unchanged,
+        "passed": admitted == 0 and unchanged,
+        "terminal": True,
+    }
+    retention_row = {
+        "protected_fact_ids_before": sorted(before),
+        "protected_fact_ids_after": sorted(after),
+        "protected_case_harm_count": sum(
+            before.get(fact_id) != after.get(fact_id) for fact_id in set(before) | set(after)
+        ),
+        "passed": before == after and poison.snapshot() == parent,
+        "terminal": True,
+    }
+    return {
+        "capacity_rows": [capacity_row],
+        "poison_rows": [poison_row],
+        "retention_rows": [retention_row],
+    }
+
