+        str(os.getpid()),
+        "--setenv",
+        "CARNOT_EXP7022_PARENT_NETNS",
+        os.readlink("/proc/self/ns/net"),
+        "--",
+        str(executable),
+        str(wrapper),
+        "--fresh-child",
+        "--date",
+        run_date,
+        "--output",
+        str(output_path),
+        "--work-root",
+        str(writable_root),
+    ]
+
+
+def run_controller(
+    *,
+    repo_root: Path = REPO_ROOT,
+    result_path: Path | None = None,
+    run_date: str = RUN_DATE,
+) -> JsonDict:
+    """Run the audit in a network-disabled, GPU-hidden fresh process."""
+
+    started = time.perf_counter()
+    output = result_path or repo_root / RESULT_PATH
+    launcher = shutil.which("bwrap")
+    source_checks, before = _hash_checks(repo_root, SOURCE_PATHS, EXPECTED_SOURCE_HASHES)
+    preflight = [
+        gate_check("bubblewrap_available", True, launcher is not None),
+        gate_check(
+            "artifact_path_writable",
+            True,
+            output.parent.is_dir() and os.access(output.parent, os.W_OK),
+        ),
+        *source_checks,
+    ]
+    if any(row["passed"] is not True for row in preflight):
+        artifact = build_blocked_artifact(
+            run_date=run_date,
+            duration_s=time.perf_counter() - started,
+            checks=preflight,
+            source_hashes=before,
+        )
+        write_validated_artifact(output, artifact)
+        return artifact
+
+    with tempfile.TemporaryDirectory(prefix="carnot-exp7022-") as directory:
+        writable_root = Path(directory)
+        (writable_root / "game-source-disabled").mkdir()
+        child_output = writable_root / "child-result.json"
+        command = fresh_process_command(
+            executable=Path(sys.executable),
+            wrapper=repo_root / WRAPPER_PATH,
+            repo_root=repo_root,
+            writable_root=writable_root,
+            output_path=child_output,
+            run_date=run_date,
+        )
+        completed = subprocess.run(
+            command,
+            cwd=repo_root,
+            stdin=subprocess.DEVNULL,
+            capture_output=True,
+            text=True,
+            check=False,
+        )
+        if completed.returncode == 0 and child_output.is_file():
+            artifact = json.loads(child_output.read_text(encoding="utf-8"))
+        else:
+            checks = [
+                *preflight,
+                gate_check("fresh_process_exit_code", 0, completed.returncode),
+                gate_check("fresh_process_output", True, child_output.is_file()),
+            ]
+            artifact = build_blocked_artifact(
+                run_date=run_date,
+                duration_s=time.perf_counter() - started,
+                checks=checks,
+                source_hashes=before,
+            )
+    after = {name: sha256_path(repo_root / path) for name, path in SOURCE_PATHS.items()}
+    controller_checks = [
+        gate_check("controller_source_hashes_unchanged", before, after),
+        gate_check("fresh_process_exit_code", 0, completed.returncode),
+    ]
+    artifact["preconditions_checked"] = [
+        *artifact.get("preconditions_checked", []),
+        *controller_checks,
+    ]
+    if artifact.get("verdict_class") != "blocked":
+        artifact = reduce_terminal_decision(artifact)
+    else:
+        artifact["gate_check_summary"] = gate_summary(artifact["preconditions_checked"])
+    artifact["duration_s"] = time.perf_counter() - started
+    artifact["reproducibility_checksum"] = artifact_checksum(artifact)
+    errors = validate_artifact(artifact)
+    if errors:
+        raise RuntimeError(f"controller_artifact_validation_failed:{errors}")
+    write_validated_artifact(output, artifact)
+    return artifact
+
+
+def main(argv: Sequence[str] | None = None) -> int:  # pragma: no cover - command boundary.
+    """Run the controller or its private restricted-child mode."""
+
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--date", default=RUN_DATE)
+    parser.add_argument("--repo-root", type=Path, default=REPO_ROOT)
+    parser.add_argument("--output", type=Path)
+    parser.add_argument("--work-root", type=Path)
+    parser.add_argument("--fresh-child", action="store_true")
+    args = parser.parse_args(argv)
+    if args.fresh_child:
+        if args.output is None:
+            parser.error("--output is required with --fresh-child")
+        build_from_repo(
+            args.repo_root.resolve(),
+            run_date=args.date,
+            output_path=args.output,
+            work_root=args.work_root or args.output.parent,
+            runtime_receipt=sandbox_runtime_receipt(args.repo_root.resolve()),
+            write_output=True,
+        )
+        return 0
+    artifact = run_controller(
+        repo_root=args.repo_root.resolve(),
+        result_path=args.output,
+        run_date=args.date,
+    )
+    print(
+        f"wrote {args.output or args.repo_root.resolve() / RESULT_PATH} "
+        f"belief_shadow_safe_score={artifact['belief_shadow_safe_score']} "
+        f"belief_promotion_ready_score={artifact['belief_promotion_ready_score']}"
+    )
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover - command boundary.
+    raise SystemExit(main())
