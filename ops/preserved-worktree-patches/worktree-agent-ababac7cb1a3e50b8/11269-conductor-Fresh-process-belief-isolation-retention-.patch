+def _serialization_rows(event: Mapping[str, Any], root: Path) -> list[JsonDict]:
+    reversed_event = dict(reversed(list(deepcopy(dict(event)).items())))
+    semantic = json.loads(json.dumps(reversed_event, indent=3, ensure_ascii=False))
+    first = ledger_mod.BeliefLedger(root / "semantic-first", capacity=4)
+    second = ledger_mod.BeliefLedger(root / "semantic-second", capacity=4)
+    first_receipt = first.observe(event)
+    second_receipt = second.observe(semantic)
+    semantic_pass = bool(
+        first_receipt["accepted"]
+        and second_receipt["accepted"]
+        and first.state_hash == second.state_hash
+    )
+
+    changed = deepcopy(dict(event))
+    changed["action"]["data"]["x"] = int(changed["action"]["data"]["x"]) + 1
+    changed_ledger = ledger_mod.BeliefLedger(root / "changed-bytes", capacity=4)
+    parent = changed_ledger.snapshot()
+    changed_receipt = changed_ledger.observe(changed)
+    changed_pass = bool(
+        changed_receipt.get("reason") == "event_row_hash_invalid"
+        and changed_ledger.snapshot() == parent
+    )
+    return [
+        {
+            "mutation": "semantic_key_and_whitespace_change",
+            "state_hash_equal": first.state_hash == second.state_hash,
+            "passed": semantic_pass,
+            "terminal": True,
+        },
+        {
+            "mutation": "changed_event_bytes_without_row_hash",
+            "reason": changed_receipt.get("reason"),
+            "state_unchanged": changed_ledger.snapshot() == parent,
+            "passed": changed_pass,
+            "terminal": True,
+        },
+    ]
+
+
+def _order_rows(events: Sequence[Mapping[str, Any]], root: Path) -> list[JsonDict]:
+    root.mkdir(parents=True, exist_ok=True)
+    variants = {
+        "adjacent_event_swap": [events[1], events[0], *events[2:]],
+        "reverse_event_order": list(reversed(events)),
+    }
+    rows = []
+    for name, variant in variants.items():
+        path = root / f"{name}.jsonl"
+        path.write_text(
+            "".join(json.dumps(row, sort_keys=True) + "\n" for row in variant),
+            encoding="utf-8",
+        )
+        try:
+            ledger_mod.load_updater_events(path)
+        except ValueError as exc:
+            rejected = True
+            reason = str(exc)
+        else:
+            rejected = False
+            reason = None
+        rows.append(
+            {
+                "mutation": name,
+                "rejected": rejected,
+                "reason": reason,
+                "passed": rejected,
+                "terminal": True,
+            }
+        )
+    return rows
+
