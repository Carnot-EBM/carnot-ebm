+def _retrieval_collision_row(root: Path) -> JsonDict:
+    ledger = ledger_mod.BeliefLedger(root, capacity=4)
+    first_event = ledger_mod._fixture_event(0, mechanic="retrieval-a", outcome="same")
+    other_event = ledger_mod._fixture_event(1, mechanic="retrieval-b", outcome="same")
+    ledger.observe(first_event)
+    first_key = ledger_mod.mechanic_key_from_event(first_event)
+    other_key = ledger_mod.mechanic_key_from_event(other_event)
+    first_query = ledger.query(first_key)
+    other_query = ledger.query(other_key)
+    collision = other_query["fact_id"] == first_query["fact_id"]
+    return {
+        "keys_distinct": first_key != other_key,
+        "first_fact_present": first_query["fact_id"] is not None,
+        "cross_key_fact_retrieved": collision,
+        "passed": first_key != other_key and first_query["fact_id"] is not None and not collision,
+        "terminal": True,
+    }
