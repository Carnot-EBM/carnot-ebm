+def _authority_row(root: Path) -> JsonDict:
+    ledger = ledger_mod.BeliefLedger(root, capacity=4)
+    original = ledger_mod._fixture_event(
+        0, mechanic="authority", outcome="first", event_id="authority-event"
+    )
+    ledger.observe(original)
+    parent = ledger.snapshot()
+    changed = ledger_mod._fixture_event(
+        1, mechanic="authority", outcome="changed", event_id="authority-event"
+    )
+    receipt = ledger.observe(changed)
+    passed = bool(receipt.get("reason") == "authority_conflict" and ledger.snapshot() == parent)
+    return {
+        "reason": receipt.get("reason"),
+        "state_unchanged": ledger.snapshot() == parent,
+        "passed": passed,
+        "terminal": True,
+    }
