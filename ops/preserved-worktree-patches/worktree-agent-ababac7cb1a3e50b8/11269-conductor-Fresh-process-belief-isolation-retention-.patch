+def _base_artifact(run_date: str, duration_s: float, source_hashes: Mapping[str, Any]) -> JsonDict:
+    artifact: JsonDict = {
+        "schema": SCHEMA,
+        "experiment_id": EXPERIMENT_ID,
+        "execution_date": run_date,
+        "field_principles": deepcopy(FIELD_PRINCIPLES),
+        "preconditions_checked": [],
+        "inference_substrate": INFERENCE_SUBSTRATE,
+        "duration_s": float(duration_s),
+        "cited_upstream_artifacts": _citations(source_hashes),
+        "source_artifact_hashes": deepcopy(dict(source_hashes)),
+        "belief_shadow_safe_score": 0,
+        "belief_promotion_ready_score": 0,
+        "random_seed": RANDOM_SEED,
+        "reproducibility_checksum": "",
+        "gate_check_summary": {},
+        "verifier_is_oracle": False,
+        "verdict_class": "blocked",
+        "honest_verdict": "blocked_belief_ledger_cold_audit",
+    }
+    for field in ROW_TABLES:
+        artifact[field] = []
+    return artifact
+
+
+def build_blocked_artifact(
+    *,
+    run_date: str,
+    duration_s: float,
+    checks: Sequence[Mapping[str, Any]],
+    source_hashes: Mapping[str, Any],
+) -> JsonDict:
+    """Build one complete blocked result with its first exact failure."""
+
+    artifact = _base_artifact(run_date, duration_s, source_hashes)
+    artifact["preconditions_checked"] = [deepcopy(dict(row)) for row in checks]
+    artifact["gate_check_summary"] = gate_summary(checks)
+    artifact["reproducibility_checksum"] = artifact_checksum(artifact)
+    return artifact
+
+
+def build_from_repo(
+    repo_root: Path,
+    *,
+    run_date: str = RUN_DATE,
+    output_path: Path | None = None,
+    work_root: Path | None = None,
+    runtime_receipt: Mapping[str, Any] | None = None,
+    write_output: bool = True,
+) -> JsonDict:
+    """Build the audit after hashes and restricted-runtime gates pass."""
+
+    started = time.perf_counter()
+    output = output_path or repo_root / RESULT_PATH
+    workspace = work_root or output.parent
+    loaded = load_hashed_sources(repo_root)
+    runtime = dict(runtime_receipt or sandbox_runtime_receipt(repo_root))
+    checks = [*loaded["checks"]]
+    checks.extend(
+        [
+            gate_check("fresh_process_runtime", True, runtime.get("passed")),
+            gate_check(
+                "artifact_path_writable",
+                True,
+                output.parent.is_dir() and os.access(output.parent, os.W_OK),
+            ),
+        ]
+    )
+    if not loaded["passed"] or any(row["passed"] is not True for row in checks):
+        artifact = build_blocked_artifact(
+            run_date=run_date,
+            duration_s=time.perf_counter() - started,
+            checks=checks,
+            source_hashes=loaded["hashes"],
+        )
+        if write_output:
+            write_validated_artifact(output, artifact)
+        return artifact
+
+    values = loaded["values"]
+    evidence = run_audit_matrix(values["events"], values["exp7020"], workspace, runtime)
+    value_evidence = audit_exp7021_rows(values["exp7021"])
+    artifact = _base_artifact(run_date, 0.0, loaded["hashes"])
+    artifact["preconditions_checked"] = checks
+    artifact.update(evidence)
+    artifact["aggregate_recomputation_rows"] = value_evidence["aggregate_recomputation_rows"]
+    artifact["promotion_gate_rows"] = value_evidence["promotion_gate_rows"]
+    artifact = reduce_terminal_decision(artifact)
+    artifact["duration_s"] = time.perf_counter() - started
+    artifact["reproducibility_checksum"] = artifact_checksum(artifact)
+    errors = validate_artifact(artifact)
+    if errors:
+        raise RuntimeError(f"artifact_validation_failed:{errors}")
+    if write_output:
+        write_validated_artifact(output, artifact)
+    return artifact
+
+
+def _checksum_projection(artifact: Mapping[str, Any]) -> JsonDict:
+    projected = deepcopy(dict(artifact))
+    projected.pop("duration_s", None)
+    projected.pop("reproducibility_checksum", None)
+    return projected
+
+
+def artifact_checksum(artifact: Mapping[str, Any]) -> str:
+    """Hash stable scientific fields while excluding wall time and self-hash."""
+
+    return sha256_bytes(canonical_bytes(_checksum_projection(artifact)))
+
+
+def validate_artifact(artifact: Any) -> list[str]:
+    """Return structural and scientific decision errors without repairing them."""
+
+    if not isinstance(artifact, Mapping):
+        return ["artifact_object_required"]
+    errors: list[str] = []
+    missing = sorted(set(REQUIRED_ARTIFACT_FIELDS) - set(artifact))
+    if missing:
+        errors.append("required_fields_missing")
+    principles = artifact.get("field_principles")
+    if not isinstance(principles, Mapping) or set(principles) != set(REQUIRED_ARTIFACT_FIELDS):
+        errors.append("field_principles_mismatch")
+    preconditions = artifact.get("preconditions_checked")
+    if not isinstance(preconditions, list) or any(
+        not isinstance(row, Mapping) or row.get("terminal") is not True for row in preconditions
+    ):
+        errors.append("preconditions_invalid")
+    for field in ROW_TABLES:
+        rows = artifact.get(field)
+        if not isinstance(rows, list):
+            errors.append(f"{field}_not_list")
+        elif any(not isinstance(row, Mapping) or row.get("terminal") is not True for row in rows):
+            errors.append(f"nonterminal_row:{field}")
+    for field, marker in (
+        ("belief_shadow_safe_score", "shadow_score"),
+        ("belief_promotion_ready_score", "promotion_score"),
+    ):
+        value = artifact.get(field)
+        if type(value) is not int or value not in {0, 1}:
+            errors.append(f"{marker}_must_be_bare_integer")
+    if artifact.get("inference_substrate") != INFERENCE_SUBSTRATE:
+        errors.append("inference_substrate_mismatch")
+    if artifact.get("verifier_is_oracle") is not False:
+        errors.append("verifier_is_oracle_mismatch")
+    verdict_class = artifact.get("verdict_class")
+    prefixes = {
+        "positive": "complete_positive_",
+        "circular_positive": "complete_circular_positive_",
+        "null": "complete_null_",
+        "blocked": "blocked_",
+        "disqualified": "disqualified_",
+        "partial": "partial_",
+    }
+    if verdict_class not in VERDICT_CLASSES:
+        errors.append("verdict_class_invalid")
+    elif not str(artifact.get("honest_verdict", "")).startswith(prefixes[verdict_class]):
+        errors.append("verdict_prefix_mismatch")
+    gate = artifact.get("gate_check_summary")
+    if not isinstance(gate, Mapping) or "failed_check" not in gate:
+        errors.append("gate_check_summary_invalid")
+    if verdict_class == "blocked":
+        if artifact.get("honest_verdict") != "blocked_belief_ledger_cold_audit":
+            errors.append("blocked_verdict_mismatch")
+        if (
+            artifact.get("belief_shadow_safe_score") != 0
+            or artifact.get("belief_promotion_ready_score") != 0
+        ):
+            errors.append("blocked_score_mismatch")
+        if not isinstance(gate, Mapping) or gate.get("failed_check") is None:
+            errors.append("blocked_without_failed_gate")
+    elif verdict_class == "null":
+        if (
+            artifact.get("belief_shadow_safe_score") != 1
+            or artifact.get("belief_promotion_ready_score") != 0
+        ):
+            errors.append("null_score_mismatch")
+    elif verdict_class == "positive":
+        if (
+            artifact.get("belief_shadow_safe_score") != 1
+            or artifact.get("belief_promotion_ready_score") != 1
+        ):
+            errors.append("positive_score_mismatch")
+    elif verdict_class == "disqualified" and artifact.get("belief_promotion_ready_score") != 0:
+        errors.append("disqualified_promotion_mismatch")
+    if artifact.get("reproducibility_checksum") != artifact_checksum(artifact):
+        errors.append("reproducibility_checksum_mismatch")
+    return errors
+
+
+def write_validated_artifact(path: Path, artifact: Mapping[str, Any]) -> None:
+    """Publish one complete JSON document only after validation passes."""
+
+    errors = validate_artifact(artifact)
+    if errors:
+        raise ValueError(f"Exp7022 artifact validation failed:{errors}")
+    path.parent.mkdir(parents=True, exist_ok=True)
+    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
+    temporary = Path(temporary_name)
+    try:
+        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
+            json.dump(artifact, handle, indent=2, sort_keys=True)
+            handle.write("\n")
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.replace(temporary, path)
+    finally:
+        if temporary.exists():
+            temporary.unlink()
+
+
+def sandbox_runtime_receipt(repo_root: Path) -> JsonDict:
+    """Measure process, network, GPU, game-source, and write isolation."""
+
+    parent_pid = int(os.environ.get("CARNOT_EXP7022_PARENT_PID", str(os.getpid())))
+    parent_netns = os.environ.get("CARNOT_EXP7022_PARENT_NETNS", "")
+    child_netns = os.readlink("/proc/self/ns/net")
+    network_lines = Path("/proc/net/dev").read_text(encoding="utf-8").splitlines()[2:]
+    interfaces = sorted(line.split(":", 1)[0].strip() for line in network_lines if ":" in line)
+    route_lines = Path("/proc/net/route").read_text(encoding="utf-8").splitlines()[1:]
+    try:
+        socket.create_connection(("198.51.100.1", 9), timeout=0.05).close()
+    except OSError:
+        external_lookup_rejected = True
+    else:  # pragma: no cover - the documentation-only address cannot accept traffic.
+        external_lookup_rejected = False
+    gpu_devices = sorted(str(path) for path in Path("/dev").glob("nvidia*"))
+    probe_path = repo_root / ".exp7022-write-probe"
+    try:
+        probe_path.write_text("probe", encoding="utf-8")
+        probe_path.unlink(missing_ok=True)
+    except OSError:
+        source_tree_read_only = True
+    else:
+        source_tree_read_only = False
+    game_source = repo_root / "environment_files"
+    game_source_disabled = bool(
+        os.environ.get("CARNOT_DISABLE_GAME_SOURCE") == "1"
+        and game_source.is_dir()
+        and not any(game_source.iterdir())
+    )
+    receipt = {
+        "fresh_process": os.getpid() != parent_pid,
+        "network_namespace_isolated": bool(parent_netns and child_netns != parent_netns),
+        "network_disabled": set(interfaces) <= {"lo"} and not route_lines,
+        "external_lookup_rejected": external_lookup_rejected,
+        "gpu_devices_visible": gpu_devices,
+        "cuda_visible_devices": os.environ.get("CUDA_VISIBLE_DEVICES"),
+        "game_source_access_rejected": game_source_disabled,
+        "registry_access_rejected": os.environ.get("CARNOT_DISABLE_REGISTRY") == "1",
+        "source_tree_read_only": source_tree_read_only,
+    }
+    receipt["passed"] = bool(
+        receipt["fresh_process"]
+        and receipt["network_namespace_isolated"]
+        and receipt["network_disabled"]
+        and receipt["external_lookup_rejected"]
+        and not gpu_devices
+        and receipt["cuda_visible_devices"] == ""
+        and receipt["game_source_access_rejected"]
+        and receipt["registry_access_rejected"]
+        and receipt["source_tree_read_only"]
+    )
+    return receipt
+
+
+def fresh_process_command(
+    *,
+    executable: Path,
+    wrapper: Path,
+    repo_root: Path,
+    writable_root: Path,
+    output_path: Path,
+    run_date: str,
+) -> list[str]:
+    """Build a bubblewrap command with one writable audit directory."""
+
+    game_source_mask = writable_root / "game-source-disabled"
+    return [
+        "bwrap",
+        "--die-with-parent",
+        "--new-session",
+        "--unshare-net",
+        "--unshare-pid",
+        "--ro-bind",
+        "/",
+        "/",
+        "--dev",
