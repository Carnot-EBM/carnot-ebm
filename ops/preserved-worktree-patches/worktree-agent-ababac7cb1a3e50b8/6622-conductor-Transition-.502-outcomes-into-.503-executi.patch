+def _row(
+    lane: str,
+    classification: str,
+    source_artifacts: Sequence[Path | str],
+    evidence: Mapping[str, Any],
+    claim_boundary: str,
+) -> JsonDict:
+    return {
+        "lane": lane,
+        "classification": classification,
+        "source_artifacts": [str(item) for item in source_artifacts],
+        "evidence": dict(evidence),
+        "claim_boundary": claim_boundary,
+    }
