+    if mem_path.is_file():
+        for line in mem_path.read_text(encoding="utf-8").splitlines():
+            parts = line.split()
+            if len(parts) >= 2 and parts[1].isdigit():
+                meminfo[parts[0].rstrip(":")] = int(parts[1]) * 1024
+    return {
+        "cpu_count": os.cpu_count(),
