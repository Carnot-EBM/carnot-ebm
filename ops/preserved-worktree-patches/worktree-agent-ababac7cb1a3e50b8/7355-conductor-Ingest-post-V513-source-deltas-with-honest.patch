+
+def dedupe_corpus(root: Path) -> list[JsonDict]:
+    checked: list[JsonDict] = []
+    for path in dedupe_paths(root):
+        exists = path.exists()
+        checked.append(
+            {
+                "path": relative_path(root, path),
+                "exists": exists,
+                "sha256": path_sha256(path) if exists else None,
+            }
+        )
+    return checked
