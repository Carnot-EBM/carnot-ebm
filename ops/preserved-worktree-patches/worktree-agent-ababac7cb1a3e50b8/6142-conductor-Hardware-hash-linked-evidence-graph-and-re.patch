+def test_helpers_and_verifier_reject_tampered_graphs() -> None:
+    """REQ-HW-5398: offline verifier fails closed on graph drift and unsafe evidence."""
+
+    artifact, graph = mod.build_evidence_bundle(
+        command_runner=_runner(),
+        clock=StepClock(),
+        run_date="20260708",
