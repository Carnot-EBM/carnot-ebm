+
+    artifact_path = mod.run_experiment(
+        repo_root=tmp_path,
+        command_runner=_runner(),
+        clock=StepClock(),
+        run_date="20260708",
+        commit="abc123",
+        tests_run=_tests_run(),
+    )
+    graph_path = tmp_path / mod.EVIDENCE_GRAPH_RELATIVE_PATH
+    artifact = json.loads(artifact_path.read_text(encoding="utf-8"))
