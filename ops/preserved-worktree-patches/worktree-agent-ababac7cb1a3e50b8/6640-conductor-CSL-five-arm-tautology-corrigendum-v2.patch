+PER_QUERY_RANDOM_ARM = "per_query_random"
+NO_MEMORY_ARM = "no_memory"
+SHUFFLED_MEMORY_ARM = "shuffled_memory"
+ALIGNED_MEMORY_ARM = "aligned_memory"
