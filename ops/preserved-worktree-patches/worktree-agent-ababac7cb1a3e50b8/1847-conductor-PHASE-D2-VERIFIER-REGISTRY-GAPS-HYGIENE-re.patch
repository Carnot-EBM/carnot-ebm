+    assert exp4216._first_numeric({"bad": "x", "ok": 2}, "bad", "ok") == pytest.approx(2.0)
+    assert exp4216._first_ci95({"bad": [0.0], "ok": [0, 1]}, "bad", "ok") == [0.0, 1.0]
+    assert exp4216._round4(None) is None
