+    if "-" not in str(game_id):
+        return False
+    prefix, suffix = str(game_id).split("-", maxsplit=1)
+    root = REPO / "environment_files" / prefix / suffix
+    return root.joinpath("metadata.json").exists() and root.joinpath(f"{prefix}.py").exists()
