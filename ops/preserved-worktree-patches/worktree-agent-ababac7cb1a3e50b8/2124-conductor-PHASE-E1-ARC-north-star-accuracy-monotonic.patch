+                "n_levels": 6,
+                "win_difficulty": "medium",
+            },
+            {"game": "ls20", "is_spatial_planning": True, "n_levels": 7, "win_difficulty": "hard"},
+            {
+                "game": "wa30",
+                "is_spatial_planning": True,
+                "n_levels": 9,
+                "win_difficulty": "medium",
+            },
+            {
+                "game": "sc25",
