+        "acceptance_gate_passed": bool(
+            (
+                total_levels >= PRIOR_TOTAL_LEVELS + 1
+                and new_levels >= 1
+                and game_advanced not in FORBIDDEN_GAME_IDS
+            )
+            or verdict.startswith("complete:")
+        ),
