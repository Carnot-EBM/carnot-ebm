+def coerced_model(
+    original_agent: str | None,
+    coerced_agent: str | None,
+    task_model: str | None,
+    agent_default_model: str | None,
+) -> str | None:
+    """The model a task should use once its agent has been coerced.
+
+    THE INVARIANT: a coerced task never keeps a model belonging to the agent it was coerced
+    AWAY FROM. Returning the agent's own default (or None, letting the callee choose) is always
+    safe; carrying the old model across is never safe.
+
+    INCIDENT 2026-08-30. The coercion block rewrote `task_agent_type` in four places and never
+    touched `task_model`, which had already been read further up. A task planned as
+    `agent_type: gemini` + `model: gemini-3.1-pro-preview` was correctly flipped to codex and
+    then invoked with the Gemini model name, dying on
+
+        Codex CLI error: Model metadata for `gemini-3.1-pro-preview` not found
+
+    15 occurrences across 5 dates since 2026-07-01, always exactly 3 -- one task burning its
+    whole retry budget and retiring for a reason unrelated to its merits.
+
+    Worth stating plainly, because it argues for the fix rather than against the coercion: the
+    safety net WORKED and still caused this. Without it the task fails as gemini and is legible;
+    with it, the task fails as CODEX with an error that reads like a codex problem, which is why
+    five occurrences went untraced. A half-applied coercion is worse than none.
+
+    A model is judged foreign by NAME PREFIX rather than by a fixed table, because the table
+    would be one more list that drifts narrower than its concept -- the failure mode this
+    repository keeps rediscovering.
+    """
+
+    if not coerced_agent or coerced_agent == original_agent:
+        return task_model  # no coercion happened; leave the plan alone
+    if task_model and not _model_belongs_to(task_model, coerced_agent):
+        return agent_default_model  # foreign model: hand the new agent its own
+    return task_model
+
+
+#: Name fragments that identify which backend a model string belongs to. Prefix matching, not
+#: an exhaustive table: a new `gpt-6-*` or `claude-6-*` must not silently read as foreign.
+_MODEL_FAMILY_HINTS: dict[str, tuple[str, ...]] = {
+    "codex": ("gpt-", "o1", "o3", "o4"),
+    "claude": ("claude", "opus", "sonnet", "haiku"),
+    "gemini": ("gemini",),
+}
+
+
+def _model_belongs_to(model: str, agent: str) -> bool:
+    """Does this model string plausibly belong to `agent`'s backend?
+
+    Unknown models return True -- fail toward LEAVING THE PLAN ALONE. A wrongly-kept model
+    fails loudly at dispatch, exactly as the incident did; a wrongly-replaced one silently runs
+    the wrong model and reports a result, which is far worse.
+    """
+
+    hints = _MODEL_FAMILY_HINTS.get(agent)
+    if not hints:
+        return True
+    lowered = model.strip().lower()
+    if any(lowered.startswith(h) for h in hints):
+        return True
+    return not any(
+        lowered.startswith(h) for other, hs in _MODEL_FAMILY_HINTS.items() if other != agent
+        for h in hs
+    )
+
+
