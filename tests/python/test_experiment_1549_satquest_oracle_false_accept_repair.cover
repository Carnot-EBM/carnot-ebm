    1:     assert fake_sat["classification"] == "wrong_label"
    1:     assert proofless_unsat["classification"] == "missing_unsat_certificate"
       
       
    1: def test_scenario_bench_1549_replays_three_known_false_accept_shapes() -> None:
           """SCENARIO-BENCH-1549: Exp1536 false accepts replay to zero repaired accepts."""
       
    2:     artifact, rows = exp1549.load_false_accept_rows(
    1:         Path("results/experiment_1536_satquest_cnf_verifier_benchmark.json"),
    1:         Path("results/satquest_cnf_verifier_1536.jsonl"),
           )
    1:     replay = exp1549.replay_false_accept_rows(rows)
       
    1:     assert artifact["solver_oracle_false_accepts"] == 3
    4:     assert [row["case_id"] for row in rows] == [
               "cnf-1536-unsat-unit-clash-narrative",
               "cnf-1536-unsat-two-var-cover-narrative",
               "cnf-1536-sat-negated-path-narrative",
           ]
    1:     assert replay["false_accepts_before"] == 3
    1:     assert replay["solver_oracle_false_accepts_after"] == 0
    1:     assert replay["assignment_witnesses_checked"] >= 1
    1:     assert replay["unsat_certificates_checked"] >= 2
    4:     assert replay["failing_case_ids_rechecked"] == [row["case_id"] for row in rows]
    5:     assert {row["repaired_decision"]["classification"] for row in replay["rows"]} == {
    1:         "wrong_label",
    1:         "invalid_assignment_witness",
           }
       
       
    1: def test_scenario_bench_1549_runner_writes_required_artifact_and_manifest(tmp_path: Path) -> None:
           """SCENARIO-BENCH-1549: runner writes the zero-false-accept repair gate."""
       
    1:     output_path = tmp_path / "experiment_1549.json"
