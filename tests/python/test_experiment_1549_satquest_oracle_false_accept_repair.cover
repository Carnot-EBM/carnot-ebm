               "p cnf two 1\n1 0\n",
           ]
    6:     for text in malformed_inputs:
   10:         with pytest.raises(exp1549.CNFParseError):
    5:             exp1549.parse_dimacs_strict(text)
       
       
    1: def test_req_bench_1549_sat_success_requires_checked_assignment_witness() -> None:
           """REQ-BENCH-1549: SAT acceptance requires a full checked assignment witness."""
       
