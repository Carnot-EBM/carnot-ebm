    2:     artifact = exp1549.run_repair(
    1:         output_path=output_path,
    1:         repaired_case_manifest_path=manifest_path,
    1:         source_artifact_path=Path("results/experiment_1536_satquest_cnf_verifier_benchmark.json"),
    1:         source_manifest_path=Path("results/satquest_cnf_verifier_1536.jsonl"),
    1:         focused_tests_passed=True,
           )
    1:     persisted = json.loads(output_path.read_text(encoding="utf-8"))
   22:     rows = [json.loads(line) for line in manifest_path.read_text(encoding="utf-8").splitlines()]
       
    1:     assert artifact == persisted
    1:     assert set(exp1549.REQUIRED_ARTIFACT_FIELDS) <= set(artifact)
    1:     assert artifact["status"] == "complete"
    1:     assert artifact["milestone"] == "20260508"
    1:     assert artifact["satquest_oracle_repair_ready"] is True
    1:     assert artifact["satquest_zero_false_accepts"] is True
    1:     assert artifact["false_accepts_before"] == 3
    1:     assert artifact["solver_oracle_false_accepts_after"] == 0
    1:     assert artifact["failing_case_ids_rechecked"] == [
               "cnf-1536-unsat-unit-clash-narrative",
               "cnf-1536-unsat-two-var-cover-narrative",
               "cnf-1536-sat-negated-path-narrative",
           ]
    1:     assert artifact["exact_fallback_available"] is True
    1:     assert artifact["assignment_witnesses_checked"] > 0
    1:     assert artifact["unsat_certificates_checked"] > 0
    1:     assert artifact["perturbation_checks_passed"] is True
    1:     assert artifact["oracle_module_path"] == "python/carnot/eval/satquest_oracle_false_accept_repair.py"
    1:     assert artifact["repaired_case_manifest_path"] == str(manifest_path)
    1:     assert artifact["focused_tests_passed"] is True
    1:     assert artifact["honest_verdict"].startswith("complete:")
    1:     assert len(rows) >= 18
   23:     assert all(row["repaired_false_accept"] is False for row in rows)
       
       
