    1:     assert evidence.assignment_witness_checked is True
    1:     assert evidence.unsat_certificate_checked is False
       
    2:     accepted = exp1549.evaluate_candidate_with_evidence(
    1:         2,
    1:         clauses,
    1:         exp1536.CandidateAnswer("SAT", (True, True)),
    1:         evidence=evidence,
           )
    2:     missing = exp1549.evaluate_candidate_with_evidence(
    1:         2,
    1:         clauses,
    1:         exp1536.CandidateAnswer("SAT"),
    1:         evidence=evidence,
           )
    2:     invalid = exp1549.evaluate_candidate_with_evidence(
    1:         2,
    1:         clauses,
    1:         exp1536.CandidateAnswer("SAT", (False, False)),
    1:         evidence=evidence,
           )
    2:     witnessless_oracle = exp1549.evaluate_candidate_with_evidence(
    1:         2,
    1:         clauses,
    1:         exp1536.CandidateAnswer("SAT", (True, True)),
    1:         evidence=replace(evidence, assignment_witness=None, assignment_witness_checked=False),
           )
       
    1:     assert accepted["accepted"] is True
    1:     assert accepted["classification"] == "oracle_agreement_with_sat_witness"
    1:     assert missing["classification"] == "missing_assignment_witness"
    1:     assert invalid["classification"] == "invalid_assignment_witness"
    1:     assert witnessless_oracle["classification"] == "missing_oracle_sat_witness"
       
       
    1: def test_req_bench_1549_unsat_success_requires_exact_certificate() -> None:
           """REQ-BENCH-1549: UNSAT acceptance requires exhaustive contradiction evidence."""
       
    1:     clauses = ((1,), (-1,))
